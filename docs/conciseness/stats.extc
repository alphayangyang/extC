// 语料 T1：一维整数数组的统计（求和/最小/最大/平均的整数部分）。
use std::io
use stl::seq
use stl::string

fn main() -> i32 {
    var v = new i64[16]
    for i in 0..16 { v[i] = (i * 7 + 3) % 23 }
    let sum = seq::sum(v) ?? 0
    println(f"sum={sum} min={seq::min(v) ?? 0} max={seq::max(v) ?? 0} avg={sum / 16}")
    return 0
}
