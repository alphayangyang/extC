// 语料 T1：一维整数数组的统计（求和/最小/最大/平均的整数部分）。
use std::io

fn main() -> i32 {
    var v: mut slice<i64> = new i64[16]
    for i in 0..16 { v[i] = (i * 7 + 3) % 23 }
    var sum: i64 = 0
    var lo: i64 = v[0]
    var hi: i64 = v[0]
    for x in v {
        sum = sum + x
        if x < lo { lo = x }
        if x > hi { hi = x }
    }
    io::cout << f"sum={sum} min={lo} max={hi} avg={sum / 16}\n"
    return 0
}
