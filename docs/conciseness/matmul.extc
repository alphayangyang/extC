// 语料 T2：3x3 整数矩阵乘法，输出对角线之和。
use std::io

fn main() -> i32 {
    var a = new i64[9]
    var b = new i64[9]
    for i in 0..9 {
        a[i] = (i * 5 + 1) % 7
        b[i] = (i * 3 + 2) % 5
    }
    var c = new i64[9]
    for r in 0..3 {
        for k in 0..3 {
            var s: i64 = 0
            for j in 0..3 {
                s = s + a[r * 3 + j] * b[j * 3 + k]
            }
            c[r * 3 + k] = s
        }
    }
    io::cout << f"diag={c[0] + c[4] + c[8]}\n"
    return 0
}
