// 语料 T4：统计一段文本的行数/词数/字符数（词 = 非空白连续段）。
use std::io

fn main() -> i32 {
    let text = "the quick brown fox\njumps over the lazy dog\n\nand keeps running fast\n"
    var lines = 0
    var words = 0
    var inWord = false
    for c in text {
        if c == u8(10) { lines = lines + 1 }
        if c == u8(32) || c == u8(10) || c == u8(9) {
            if inWord { words = words + 1  inWord = false }
        } else {
            inWord = true
        }
    }
    if inWord { words = words + 1 }
    io::cout << f"lines={lines} words={words} chars={text.len}\n"
    return 0
}
