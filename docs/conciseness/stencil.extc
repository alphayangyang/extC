// 语料 T3：一维 3 点平滑迭代 10 轮，输出总和（整数除法，边界不动）。
use std::io

fn main() -> i32 {
    var a = new i64[64]
    var b = new i64[64]
    for i in 0..64 { a[i] = (i * 13 + 5) % 17 }
    for _ in 0..10 {
        for k in 1..63 { b[k] = (a[k - 1] + a[k] + a[k + 1]) / 3 }
        a, b = b, a
    }
    var s: i64 = 0
    for x in a { s = s + x }
    io::cout << f"sum={s}\n"
    return 0
}
