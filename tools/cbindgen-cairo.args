# cairo 绑定的生成参数（`tests/real-lib/run.sh` 重生成与 --check 都用这一份，不会漂）。
# 头文件路径由 run.sh 给（各机器不同）：--include cairo.h -I <cairo 头文件目录>
# 只绑这张图真正用到的函数 —— 工具不替人选函数，也不替人签字。
--name "cairo 1.18.4"
--only cairo_version_string,cairo_image_surface_create_for_data,cairo_create,cairo_destroy,cairo_surface_destroy,cairo_surface_flush,cairo_surface_write_to_png,cairo_set_source_rgb,cairo_paint,cairo_set_line_width,cairo_move_to,cairo_line_to,cairo_arc,cairo_close_path,cairo_stroke,cairo_fill,cairo_select_font_face,cairo_set_font_size,cairo_show_text
-o tests/real-lib/cairoapi.extc
