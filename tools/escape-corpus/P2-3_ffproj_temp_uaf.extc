/* 闸门⑤ 语料 · P2-3_ffproj_temp_uaf（2026-10-12，escape-fuzz task-8 E_ACCEPT_UAF + task-9 §Q3）
 * 期望：**接受 + ASan 干净**（gate-expect: run —— 这个洞 2026-10-12 的修法是「安全接受」，不是拒绝）。
 * 为什么在这里：与 P2-2 同一个洞，只差**经一个中间变量**再存进字段的字段
 *   （`var t2 = p  bx.mid.next = t2`）⇒ 字段表里连那个（名字对不上的）来源都没有，
 *   `new` 仍落在函数自己的帧 arena，返回即释放（ASan heap-use-after-free）。
 * 原探针：tests/escape-fuzz/cases/m_home_ff_temp.extc
 * 规矩：本文件被拒、或被接受但 ASan 脏 ⇒ 闸门红；修好之后**不许**把本文件改宽松。
 */
use std::io
struct node { value: i64  next: ?mut ref node }
struct inner { next: ?mut ref node }
struct outer { mid: inner }

fn build() -> ?mut ref node {
    var bx: outer = { mid: { next: null } }
    var p: mut ref node = new node
    p.value = 7
    p.next = null
    var t2: mut ref node = p
    bx.mid.next = t2
    return bx.mid.next
}

fn main() -> i32 {
    var h: ?mut ref node = build()
    var c: ?mut ref node = h
    var t: i64 = 0
    while c != null {
        t = t + (*c).value
        c = (*c).next
    }
    io::cout << t << "\n"
    return 0
}
