/* 闸门⑤ 语料 · control_m2（审计 对照）
 * 期望：**编译错误**（带源位置）。
 * 为什么在这里：**必须现在就拒绝**：P0-6(d) 的无遮蔽孪生程序
 * 原探针：/tmp/rev/repro/m2.extc
 * 规矩：本文件被接受 ⇒ 闸门红；修好之后**不许**把本文件改宽松，只许把基线里对应那行删掉。
 */
struct box { s: slice<u8> }

fn stash(b: mut ref box, s: slice<u8>, t: slice<u8>) {
    var q: slice<u8> = t
    b.s = q
}

fn main() -> i32 {
    var out: box = { s: "keep" }
    {
        var a: [16]u8
        var i: i32 = 0
        while i < 16 { a[i] = 65 + u8(i)  i = i + 1 }
        stash(ref out, "shallow", a[..])
    }
    println("out.s = ", out.s)
    return 0
}
