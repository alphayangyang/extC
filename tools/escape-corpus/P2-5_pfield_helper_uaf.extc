/* 闸门⑤ 语料 · P2-5_pfield_helper_uaf（2026-10-12，escape-fuzz task-8 E_ACCEPT_UAF）
 * 期望：**接受 + ASan 干净**（gate-expect: run —— 这个洞 2026-10-12 的修法是「安全接受」，不是拒绝）。
 * 为什么在这里：链节点经 `link3(ref *a, p)` 接上，`build` 返回 `head`。函数**有** home
 *   （`link3` 的存储推着它进 REACH_HOME），但循环里的 `new` 站点只被要求活到层 1
 *   （`anMinAt=1`）、且 `head` 的 `origin` 被展平到第一个 `new`、够不到循环里的站点 ⇒
 *   放置那一趟把 `p` 放进**函数自己的帧 arena**（`__extc_a[1]`），返回即释放
 *   （ASan heap-use-after-free）。
 * 原探针：tests/escape-fuzz/cases/m_home_pfield_direct.extc（最小复现 = tests/escape-fuzz/min/home_pfield_uaf.extc）
 * 规矩：本文件被拒、或被接受但 ASan 脏 ⇒ 闸门红；修好之后**不许**把本文件改宽松。
 */
use std::io
struct node { value: i64  next: ?mut ref node }

fn link3(out: mut ref node, q: mut ref node) {
    (*out).next = q
}

fn build() -> ?mut ref node {
    var a: mut ref node = new node
    a.value = 0
    a.next = null
    var head: ?mut ref node = a
    var i: i64 = 1
    while i <= 4 {
        var p: mut ref node = new node
        p.value = i
        p.next = null
        link3(ref *a, p)
        a = p
        i = i + 1
    }
    return head
}

fn main() -> i32 {
    var h: ?mut ref node = build()
    var c: ?mut ref node = h
    var t: i64 = 0
    while c != null {
        t = t + (*c).value
        c = (*c).next
    }
    io::cout << t << "\n"
    return 0
}
