/* 闸门⑤ 语料 · P1-4b_param_cap（审计 P1-4 / 定案：EFF_MAX_PARAMS）
 * 期望：**编译错误**（带位置）：`stash` has 65 parameters; the compiler's limit is 64
 * 为什么在这里：摘要按参数下标索引，超过位数就会静默丢掉高位 —— 与其丢掉，不如拒绝。
 * 来源：R1/R3 批次（INV-P），主人 2026-09-30 选「64 位掩码 + 超过 64 个参数编译期报错」。
 */
struct cell { r: ?ref i32 }
struct slot { c: cell }
fn stash(a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32, a6: i32, a7: i32, a8: i32, a9: i32, a10: i32, a11: i32, a12: i32, a13: i32, a14: i32, a15: i32, a16: i32, a17: i32, a18: i32, a19: i32, a20: i32, a21: i32, a22: i32, a23: i32, a24: i32, a25: i32, a26: i32, a27: i32, a28: i32, a29: i32, a30: i32, a31: i32, a32: i32, a33: i32, a34: i32, a35: i32, a36: i32, a37: i32, a38: i32, a39: i32, a40: i32, a41: i32, a42: i32, a43: i32, a44: i32, a45: i32, a46: i32, a47: i32, a48: i32, a49: i32, a50: i32, a51: i32, a52: i32, a53: i32, a54: i32, a55: i32, a56: i32, a57: i32, a58: i32, a59: i32, a60: i32, a61: i32, a62: i32 s: mut ref slot, v: cell) {
    s.c = v
}
fn main() -> i32 {
    var k: slot = slot { c: cell { r: null } }
    stash(i32(0), i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10), i32(11), i32(12), i32(13), i32(14), i32(15), i32(16), i32(17), i32(18), i32(19), i32(20), i32(21), i32(22), i32(23), i32(24), i32(25), i32(26), i32(27), i32(28), i32(29), i32(30), i32(31), i32(32), i32(33), i32(34), i32(35), i32(36), i32(37), i32(38), i32(39), i32(40), i32(41), i32(42), i32(43), i32(44), i32(45), i32(46), i32(47), i32(48), i32(49), i32(50), i32(51), i32(52), i32(53), i32(54), i32(55), i32(56), i32(57), i32(58), i32(59), i32(60), i32(61), i32(62) ref k, cell { r: null })
    return 0
}
