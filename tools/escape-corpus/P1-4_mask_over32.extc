struct cell { r: ?ref i32 }
struct slot { c: cell }
fn stash(a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32, a6: i32, a7: i32, a8: i32, a9: i32, a10: i32, a11: i32, a12: i32, a13: i32, a14: i32, a15: i32, a16: i32, a17: i32, a18: i32, a19: i32, a20: i32, a21: i32, a22: i32, a23: i32, a24: i32, a25: i32, a26: i32, a27: i32, a28: i32, a29: i32, a30: i32, s: mut ref slot, v: cell) {
    s.c = v
}
fn main() -> i32 {
    var k: slot = slot { c: cell { r: null } }
    {
        var deep: i32 = 7
        stash(i32(0), i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10), i32(11), i32(12), i32(13), i32(14), i32(15), i32(16), i32(17), i32(18), i32(19), i32(20), i32(21), i32(22), i32(23), i32(24), i32(25), i32(26), i32(27), i32(28), i32(29), i32(30), ref k, cell { r: ref deep })
    }
    println("k.c.r = ", *(k.c.r!))
    return 0
}
