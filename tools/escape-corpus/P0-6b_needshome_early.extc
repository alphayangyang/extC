var G: slice<u8> = "hi"
struct hbox { p: mut slice<u8> }

fn stash(p: slice<u8>) -> hbox {
    G = p
    var b: mut slice<u8> = new u8[4]
    return { p: b }
}

fn main() -> i32 {
    {
        var a: mut slice<u8> = new u8[64]
        var i: i32 = 0
        while i < 64 { a[i] = 65  i = i + 1 }
        let h = stash(a[..])
        println("h.p.len = ", h.p.len)
    }
    var b2: mut slice<u8> = new u8[64]
    var j: i32 = 0
    while j < 64 { b2[j] = 90  j = j + 1 }
    println("G = ", G)
    return 0
}
