/* 闸门⑤ 语料 · P0-16_outparam_a（审计 P0-16）
 * 期望：**编译错误**（带源位置）。
 * 为什么在这里：被调者经 `mut ref` 出参写入的存储不产生 publication ⇒ 目的绑定深度停在旧值，晋升走不到分配点（ASan UAF）
 * 原探针：/tmp/rev2/addr1.extc
 * 规矩：本文件被接受 ⇒ 闸门红；修好之后**不许**把本文件改宽松，只许把基线里对应那行删掉。
 */
struct node { v: i32 }
struct box { p: ?ref node }
fn stash(out: mut ref box, v: ?ref node) { out.p = v }
fn f() -> box {
    var b: box = { p: null }
    b.p = null
    var n: node = { v: 7 }
    stash(ref b, ref n)
    return b
}
fn main() -> i32 {
    var r: box = f()
    if r.p != null {
        return r.p.v
    }
    return -1
}
