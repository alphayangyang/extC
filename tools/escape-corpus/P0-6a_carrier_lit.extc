var G: slice<u8> = "hi"

fn stash(p: slice<u8>) {
    var q: slice<u8> = p
    G = q
}

fn main() -> i32 {
    {
        var a: [16]u8
        var i: i32 = 0
        while i < 16 { a[i] = 65 + u8(i)  i = i + 1 }
        stash(a[..])
    }
    {
        var c: [16]u8
        var i: i32 = 0
        while i < 16 { c[i] = 90  i = i + 1 }
        println("c = ", c)
    }
    println("G = ", G)
    return 0
}
