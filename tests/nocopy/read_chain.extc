/* 正例：读拥有元素的合法写法是**方法链** —— 接收者借的是元素本身，不复制。
   判据：能编能跑，且读出来的值正确。 */
@noCopy
struct counter {
    pos: i64
    fn valueOf(self: ref counter) -> i64 { return self.pos }
}
fn main() -> i32 {
    var arr = new counter[2]
    arr[0].pos = 7
    arr[1].pos = 9
    println("chain=", arr[0].valueOf(), " sum=", arr[1].valueOf())
    return 0
}
