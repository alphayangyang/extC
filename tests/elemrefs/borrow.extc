// `borrow v as e { … }` opens a window in which `e` is a writable view of the container and an
// element of that view is a place: `ref e[i]` hands out a reference that reads and writes the
// container's own storage. The window also shadows `v` with a read-only view, so the container
// cannot be resized from inside (resizing would move the storage under the reference); that is
// checked by `borrow_no_resize.extc`.
use std::io

fn main() -> i32 {
    var v: varArray<i64> = varArray<i64>::withCap(8)
    var k: i64 = 0
    while k < 4 {
        v.push(k * 10)
        k = k + 1
    }

    var sum: i64 = 0
    borrow v as e {
        var j: i64 = 0
        while j < 4 {
            var p: mut ref i64 = ref e[j]
            *p = *p + 1
            sum = sum + e[j]
            j = j + 1
        }
    }
    // The writes went to the container's storage, not to a copy.
    io::println(f"sum={sum} a3={v.get(3) ?? 0} size={v.size()}")
    return 0
}
// expect: sum=64 a3=31 size=4
