// churn（RSS）：反复 put+remove 同一个键 —— 峰值 RSS 必须与轮数无关（节点被回收链复用）
// 轮数从命令行拿；判据在 run.sh 里（1e5 vs 1e6 轮的峰值相当）
use std::io
use stl::map

fn toInt(s: slice<u8>, dflt: i64) -> i64 {
    if s.len == i64(0) { return dflt }
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let b = i64(s[i])
        if b < i64(48) || b > i64(57) { return dflt }
        v = v * i64(10) + (b - i64(48))
        i = i + i64(1)
    }
    return v
}

fn main(args: slice<slice<u8>>) -> i32 {
    var n: i64 = i64(100000)
    if args.len > i64(1) { n = toInt(args[1], n) }
    var m: map<i64, i32> = map<i64, i32>::withCap(i64(16))
    var i: i64 = i64(0)
    var sum: i64 = i64(0)
    while i < n {
        m.put(i64(7), i32(i % i64(100)))
        var g: i32 = m.get(i64(7)) ?? i32(-1)
        sum = sum + i64(g)
        m.remove(i64(7))
        i = i + i64(1)
    }
    io::cout << "sum=" << sum << "\n"
    return 0
}
