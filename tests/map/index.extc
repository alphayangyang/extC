// 下标语法 `m[k]`（③ 第一步：只做读）—— 有键给 some、缺键给 none、`??` 落到缺省值、长度不变
// expect: a=10 none=-1 missing=-9 len=2
use std::io
use stl::map

fn main() -> i32 {
    var m: map<i64, i32> = map<i64, i32>::withCap(i64(16))
    m.put(i64(1), i32(10))
    m.put(i64(2), i32(20))
    var a: i32 = m[i64(1)] ?? i32(-1)
    var n: i32 = m[i64(9)] ?? i32(-1)
    var miss: i32 = m[i64(7)] ?? i32(-9)
    io::cout << "a=" << i64(a) << " none=" << i64(n) << " missing=" << i64(miss) << " len=" << m.len() << "\n"
    return 0
}
