// expect: 新键吗 = false false false|len = 3 · get(2) = 22 · get(9) = -1|覆盖（本来就有）= true · 现在 get(2) = 99|删 2 = true · len = 2 · contains(2) = false · contains(3) = true
/* ⭐ 哈希表的正面判据：新键/覆盖/查/删 ✓（表位置遍历也顺带验了）*/
use stl::map

fn main() -> i32 {
    var m = mapI64<i32>::withCap(4)
    println("新键吗 = ", m.put(1, i32(11)), " ", m.put(2, i32(22)), " ", m.put(3, i32(33)))
    let g2 = m.get(2) ?? i32(-1)
    let g9 = m.get(9) ?? i32(-1)
    println("len = ", m.len(), " · get(2) = ", g2, " · get(9) = ", g9)
    let had = m.put(2, i32(99))
    let g2b = m.get(2) ?? i32(-1)
    println("覆盖（本来就有）= ", had, " · 现在 get(2) = ", g2b)
    println("删 2 = ", m.remove(2), " · len = ", m.len(), " · contains(2) = ", m.contains(2), " · contains(3) = ", m.contains(3))
    return 0
}
