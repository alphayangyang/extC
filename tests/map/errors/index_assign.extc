// 反例：类型只定义了 `[]`（读）而没有 `[]=`（写）⇒ `x[i] = v` 必须给一句能读懂的话
// expect: defines `[]` but not `[]=`
struct readOnly {
    v: i64
    fn [](self: ref readOnly, k: i64) -> ?i64 {
        if k == i64(0) { return some(self.v) }
        return none
    }
}

fn main() -> i32 {
    var r: readOnly = { v: i64(1) }
    r[i64(0)] = i64(2)
    return 0
}
