// release：map 的七块存储与两块草稿整块交还（与 buf 的预留同一本账）
// 判据：建 map 之后 arena 里多出的存活字节 == m.bytesOf()（没有隐藏副本）· release 之后回落到 0 · 出块之后仍是 0
// expect: exact=1 made=1 closed=1 out=1
use std::io
use std::data::buf
use std::data::map

fn main() -> i32 {
    let base: i64 = buf::bufLive()
    var exact: i32 = 0
    var made: i32 = 0
    var closed: i32 = 0
    {
        var m: map<i64, i32> = map<i64, i32>::withCap(16)
        var i: i64 = 0
        while i < 100 { m.put(i, i32(i))  i = i + 1 }
        let held: i64 = buf::bufLive() - base
        if held == m.bytesOf() { exact = 1 }
        if held > 0 { made = 1 }
        m.release()
        if buf::bufLive() == base { closed = 1 }
    }
    var out: i32 = 0
    if buf::bufLive() == base { out = 1 }
    io::cout << "exact=" << exact << " made=" << made << " closed=" << closed << " out=" << out << "\n"
    return 0
}