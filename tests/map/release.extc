// release：容器与它的运行期池一起诞生、一起还（与 vector / string / hashMap 同一套）
// 判据：建 map 之后 live=1 · release 之后 live=0 · 再建一个 live=1（池记录被复用）· 出块之后 live=0
// expect: live=0 made=1 closed=0 again=1 out=0
use std::io
use std::sys::pool as syspool
use stl::map

fn main() -> i32 {
    io::cout << "live=" << syspool::extc_pool_live()
    {
        var m: map<i64, i32> = map<i64, i32>::withCap(i64(16))
        m.put(i64(1), i32(10))
        io::cout << " made=" << syspool::extc_pool_live()
        m.release()
        io::cout << " closed=" << syspool::extc_pool_live()
        var q: map<i64, i32> = map<i64, i32>::withCap(i64(16))
        q.put(i64(2), i32(20))
        io::cout << " again=" << syspool::extc_pool_live()
        q.release()
    }
    io::cout << " out=" << syspool::extc_pool_live() << "\n"
    return 0
}
