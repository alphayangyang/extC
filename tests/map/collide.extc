// expect: cap = 8|全部找到 = true|删掉一半后仍全部找到 = true|重插 = true
/* ⭐ 碰撞判据：cap=8 时 0/8/16/24/32 **必然撞在同一个初始槽**（`k & 7` 都是 0 ✓）
 *   ⇒ 线性探测必须能找到每一个、删掉中间一个之后剩下的仍找得到（墓碑 + 探测链）✓ */
use stl::map

fn main() -> i32 {
    var m = mapI64<i32>::withCap(4)
    println("cap = ", m.capOf())
    var i: i64 = 0
    while i < i64(5) {
        m.put(i * i64(8), i32(i))
        i = i + i64(1)
    }
    var ok: bool = true
    i = 0
    while i < i64(5) {
        let g = m.get(i * i64(8)) ?? i32(-1)
        if g != i32(i) { ok = false }
        i = i + i64(1)
    }
    println("全部找到 = ", ok)

    m.remove(i64(16))                     /* 挖掉链条中间那个 */
    ok = true
    i = 0
    while i < i64(5) {
        if i != i64(2) {
            let g = m.get(i * i64(8)) ?? i32(-1)
            if g != i32(i) { ok = false }
        }
        i = i + i64(1)
    }
    println("删掉一半后仍全部找到 = ", ok && !m.contains(i64(16)))

    let again = m.put(i64(16), i32(2))     /* 再插回去（复用墓碑槽）*/
    let g16 = m.get(i64(16)) ?? i32(-1)
    println("重插 = ", !again && g16 == i32(2))
    return 0
}
