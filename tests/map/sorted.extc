// map<K, V>（有序表，第一步）：乱序插入后按序遍历 · 覆盖返回真 · lowerBound · 删中间键后仍有序
// expect: order=1,2,3,4,5 len=5 lb3=2 lb6=5 ow=1 v3=33 miss=-1 rm=1 order2=1,2,4,5 lb5=3
use std::io
use stl::map

fn main() -> i32 {
    var m: map<i64, i32> = map<i64, i32>::withCap(4)
    m.put(5, i32(50))
    m.put(1, i32(10))
    m.put(4, i32(40))
    m.put(2, i32(20))
    m.put(3, i32(30))
    io::cout << "order="
    var i: i64 = 0
    while i < m.len() {
        if i > 0 { io::cout << "," }
        io::cout << m.keyAt(i)
        i = i + 1
    }
    io::cout << " len=" << m.len()
    io::cout << " lb3=" << m.lowerBound(3) << " lb6=" << m.lowerBound(6)
    var ow: i64 = 0
    if m.put(3, i32(33)) { ow = 1 }
    var v3: i32 = m.get(3) ?? i32(-1)
    io::cout << " ow=" << ow << " v3=" << i64(v3)
    var miss: i32 = m.get(9) ?? i32(-1)
    io::cout << " miss=" << i64(miss)
    var rm: i64 = 0
    if m.remove(3) { rm = 1 }
    io::cout << " rm=" << rm << " order2="
    i = 0
    while i < m.len() {
        if i > 0 { io::cout << "," }
        io::cout << m.keyAt(i)
        i = i + 1
    }
    io::cout << " lb5=" << m.lowerBound(5) << "\n"
    return 0
}
