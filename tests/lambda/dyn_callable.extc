// 闭包作为 `dyn` 载荷：环境由编译器合成，用户写不出 `impl`，所以这里由编译器自己补。
// 前提是环境里没有引用/视图（那些捕获会被单独拒掉），载荷自己拥有一切可读的东西。
// 期望输出：6 7 85 12 30
use std::data::vector
use std::io

trait IntFn { fn call(self: ref Self, a: i64) -> i64 }

fn mkDyn() -> dyn IntFn {
    let base: i64 = 9
    return dyn IntFn(fn(x: i64) -> i64 { return x + base + 2 })
}

fn main() -> i32 {
    var bias: i64 = 5
    var d: dyn IntFn = dyn IntFn(fn(x: i64) -> i64 { return x + bias })

    var k: i64 = 2
    var fns: vector<dyn IntFn> = vector<dyn IntFn>::withCap(4)
    fns.push(dyn IntFn(fn(x: i64) -> i64 { return x + k }))
    fns.push(dyn IntFn(fn(x: i64) -> i64 { return x * 10 }))
    fns.push(dyn IntFn(fn(x: i64) -> i64 { return x - 1 }))
    var sum: i64 = 0
    var i: i64 = 0
    while i < i64(fns.len()) {
        sum = sum + (fns.get(i)!).call(7)
        i = i + 1
    }

    let escaped: dyn IntFn = mkDyn()

    io::cout << d.call(1) << " " << d.call(2) << " " << sum << " " << escaped.call(1) << " " << (fns.get(1)!).call(3) << "\n"
    return 0
}
