// 同一程序里两条可调用值的路并存：捕获闭包走 `dyn`（编译器补 impl），非捕获 lambda 走裸
// `fn(...)` 指针；再用泛型参数 `apply<F>` 把两者都实例化一次（闭包走合成方法，指针走间接调用）。
// 期望输出：3 4 4 20
use std::io

trait IntFn { fn call(self: ref Self, a: i64) -> i64 }

fn apply<F>(f: F, v: i64) -> i64 { return f(v) }

fn twice(f: fn(i64) -> i64, v: i64) -> i64 { return f(f(v)) }

fn main() -> i32 {
    var k: i64 = 3
    let cl = fn(x: i64) -> i64 { return x + k }
    var d: dyn IntFn = dyn IntFn(cl)
    let ptr: fn(i64) -> i64 = fn(x: i64) -> i64 { return x * 2 }
    io::cout << apply(cl, 0) << " " << apply(ptr, 2) << " " << d.call(1) << " " << twice(ptr, 5) << "\n"
    return 0
}
