// 泛型函数体里的 lambda 捕获了"类型依赖类型参数"的值：lambda 的环境只在模板上布局一次，
// 字段类型会停在 `T`，到实例里就被写成具体类型 —— 这是产物层面的类型错误，必须在检查期拒。
// expect: error: a lambda in a generic function cannot capture `k`: its type `K` depends on a type parameter
use std::io

struct key { v: i64
    fn hash(self: ref key) -> i64 { return self.v * 3 }
}

fn calc<K>(k: K) -> i64 {
    let f = fn(d: i64) -> i64 { return d + k.hash() }
    return f(1)
}

fn main() -> i32 {
    var a: key = key { v: 5 }
    io::cout << calc<key>(a) << "\n"
    return 0
}
