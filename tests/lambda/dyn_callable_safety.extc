// `dyn` 载荷的安全边界（正面）：
//   · 捕获按值拷贝的**结构体**是安全的（载荷只含自己的字节），
//   · 捕获是**快照**：建立闭包之后改外层变量，闭包看到的是旧值，
//   · 载荷里的环境不指向任何帧，所以闭包可以穿过创建它的帧。
// 期望输出：12 1 3
use std::io

trait IntFn { fn call(self: ref Self, a: i64) -> i64 }

struct pt { x: i64  y: i64 }

fn fill(p: pt) -> dyn IntFn {
    return dyn IntFn(fn(a: i64) -> i64 { return a + p.x + p.y })
}

fn snapshot() -> dyn IntFn {
    var n: i64 = 1
    let f = fn(a: i64) -> i64 { return a + n }
    n = 100
    return dyn IntFn(f)
}

fn main() -> i32 {
    var p: pt = pt { x: 3, y: 8 }
    var d: dyn IntFn = fill(p)
    var snap: dyn IntFn = snapshot()
    var k: i64 = 2
    var g: dyn IntFn = dyn IntFn(fn(a: i64) -> i64 { return a + k })
    k = 50
    io::cout << d.call(1) << " " << snap.call(0) << " " << g.call(1) << "\n"
    return 0
}
