use std::io

fn main() -> i32 {
    let zero: u64 = u64(0)
    let one: u64 = u64(1)
    let hi: u64 = 0x8000000000000000
    let x: u64 = u64(42)
    io::println(f"pop {zero.popcount()} {one.popcount()} {hi.popcount()} {x.popcount()}")
    io::println(f"ctz {zero.ctz()} {one.ctz()} {hi.ctz()} {x.ctz()}")
    io::println(f"clz {zero.clz()} {one.clz()} {hi.clz()} {x.clz()}")
    return 0
}
