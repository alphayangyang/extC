// expect: v0 = hi · v1 = yo
/* 格：**视图元素 `slice<T>` 的写**（lvalue；T 带引用）—— 单参数与双参数泛型各一次 ✓
 * 对照：完整的两参数 K→V 表形状会撞 #62 ✗ */
struct holder<V> { xs: mut slice<V>
    fn setAt(self: mut ref holder<V>, i: i64, v: V) { self.xs[i] = v }
}
struct pair2<K, V> { ks: mut slice<K>  xs: mut slice<V>
    fn setV(self: mut ref pair2<K, V>, i: i64, v: V) { self.xs[i] = v }
}
fn main() -> i32 {
    var h: holder<slice<u8>> = { xs: new slice<u8>[2] }
    var i: i64 = 0
    h.setAt(i, "hi")
    var p: pair2<i64, slice<u8>> = { ks: new i64[2], xs: new slice<u8>[2] }
    p.setV(i64(1), "yo")
    println("v0 = ", h.xs[i], " · v1 = ", p.xs[i64(1)])
    return 0
}
