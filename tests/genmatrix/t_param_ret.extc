// expect: id = 42 · twice = 84
/* 格：T 作**参数 / 返回值**（泛型自由函数 + 泛型结构体的方法）*/
fn ident<T>(x: T) -> T { return x }
fn twice<T>(x: T) -> T { return x + x }
struct box<T> { v: T
    fn get(self: ref box<T>) -> T { return self.v }
}
fn main() -> i32 {
    println("id = ", ident(i64(42)), " · twice = ", twice(i64(42)))
    var b: box<slice<u8>> = { v: "abc" }
    println("s = ", b.get())
    return 0
}
