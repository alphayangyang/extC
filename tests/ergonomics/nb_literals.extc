// 数字字面量的写法：分组下划线、二进制、八进制、十六进制、浮点。
// expect: 1000000 170 511 65535 1500 3.14159 -1000000
use std::io

fn main() -> i32 {
    let a = 1_000_000
    let b = 0b1010_1010
    let c = 0o777
    let d = 0xFF_FF
    let e = 1.5e3
    let f = 3.141_592
    let g = 0 - 1_000_000
    io::cout << a << " " << b << " " << c << " " << d << " " << e << " " << f << " " << g << "\n"
    return 0
}
