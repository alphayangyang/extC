// `impl slice<u8> { ... }` 给实例**加**方法，不能把声明体里的方法（`len`/`==`）盖掉。
// expect: eq=true len=3 trimmed=[ab]
use std::io
use std::text::string

fn main() -> i32 {
    var a: [3]u8 = [65, 66, 67]
    var b: [3]u8 = [65, 66, 67]
    let s1: slice<u8> = a[..]
    let s2: slice<u8> = b[..]
    io::cout << "eq=" << (s1 == s2) << " len=" << s1.len
    io::cout << " trimmed=[" << (" ab ".trim()) << "]" << "\n"
    return 0
}
