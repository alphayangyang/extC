// region 里的内存来自**同一只 arena**：分配、解引用写入、读回；并把它逼到换块
// 判据（run.sh）：写入能读回，且大块分配（共 1.6MB，远超一块）之后旧值仍在
use std::io
use std::sys::region

fn main() -> i32 {
    /* 层号必须就是它被创建时所在的那一层：这里是 main 的函数体 = 1
     * 先前我写 2，循环体第一次退出就把它当挂在 2 层回收了，之后 alloc 返回 NULL
     * 这正是「层号不该由调用方手写、该由生成器给」的实证 */
    let r = region::extc_region_new(i64(-1), i64(1))
    var p = region::extc_region_alloc(r, i64(16))   /* let 绑定的引用只读，写入要 var */
    *p = u8(7)
    io::cout << "ok=" << i64(*p)
    var i: i64 = 0
    var last: mut ref u8 = p
    while i < 200 {
        var q = region::extc_region_alloc(r, i64(8192))
        *q = u8(42)
        if i == 199 { last = q }
        i += 1
    }
    io::cout << " after=" << i64(*last) << " keep=" << i64(*p) << "\n"
    return 0
}
