use std::io
use std::text::string

fn addMore(s: mut ref string) { s.append("tail") }

fn main() -> i32 {
    var s: string = string::withCap(16)
    s.append("0123456789abcdef")
    var g: stringGuard = s.borrow()
    println("borrowed=", g.len())
    addMore(ref s)
    println("after=", s.len())
    return 0
}
