// The tracked-view table is no longer a fixed 16 entries: with seventeen containers the
// seventeenth borrow is checked like the first (before, it did not fit and was dropped).
// expect-reject: changes the storage that `s16` views
use std::data::vector

fn main() {
    var v0: vector<i64> = vector<i64>::withCap(4)
    v0.push(0)
    var v1: vector<i64> = vector<i64>::withCap(4)
    v1.push(1)
    var v2: vector<i64> = vector<i64>::withCap(4)
    v2.push(2)
    var v3: vector<i64> = vector<i64>::withCap(4)
    v3.push(3)
    var v4: vector<i64> = vector<i64>::withCap(4)
    v4.push(4)
    var v5: vector<i64> = vector<i64>::withCap(4)
    v5.push(5)
    var v6: vector<i64> = vector<i64>::withCap(4)
    v6.push(6)
    var v7: vector<i64> = vector<i64>::withCap(4)
    v7.push(7)
    var v8: vector<i64> = vector<i64>::withCap(4)
    v8.push(8)
    var v9: vector<i64> = vector<i64>::withCap(4)
    v9.push(9)
    var v10: vector<i64> = vector<i64>::withCap(4)
    v10.push(10)
    var v11: vector<i64> = vector<i64>::withCap(4)
    v11.push(11)
    var v12: vector<i64> = vector<i64>::withCap(4)
    v12.push(12)
    var v13: vector<i64> = vector<i64>::withCap(4)
    v13.push(13)
    var v14: vector<i64> = vector<i64>::withCap(4)
    v14.push(14)
    var v15: vector<i64> = vector<i64>::withCap(4)
    v15.push(15)
    var v16: vector<i64> = vector<i64>::withCap(4)
    v16.push(16)
    let s0: slice<i64> = v0.view()
    let s1: slice<i64> = v1.view()
    let s2: slice<i64> = v2.view()
    let s3: slice<i64> = v3.view()
    let s4: slice<i64> = v4.view()
    let s5: slice<i64> = v5.view()
    let s6: slice<i64> = v6.view()
    let s7: slice<i64> = v7.view()
    let s8: slice<i64> = v8.view()
    let s9: slice<i64> = v9.view()
    let s10: slice<i64> = v10.view()
    let s11: slice<i64> = v11.view()
    let s12: slice<i64> = v12.view()
    let s13: slice<i64> = v13.view()
    let s14: slice<i64> = v14.view()
    let s15: slice<i64> = v15.view()
    let s16: slice<i64> = v16.view()
    var i: i64 = 0
    while i < 8 { v16.push(i)  i = i + 1 }
    io::cout << f"s16={s16[0]}\n"
}
