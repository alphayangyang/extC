use std::io
use std::data::vector

struct holder { s: slice<i64> }

// 视图不一定被"直接绑定"：塞进结构体字段之后，容器增长照样把它变成悬垂指针。
// expect-reject: changes the storage that `h` views
fn main() {
    var v: vector<i64> = vector<i64>::withCap(4)
    var i: i64 = 0
    while i < 4 {
        v.push(i)
        i = i + 1
    }
    var h: holder = { s: v.view() }
    var j: i64 = 0
    while j < 20 {
        v.push(j)
        j = j + 1
    }
    io::cout << f"h0={h.s[0]}\n"
}
