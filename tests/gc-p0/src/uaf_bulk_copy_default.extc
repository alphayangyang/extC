/* G13b 默认路径 soundness 回归：同上一条（批量搬移绕过计数），但**不需要任何 env 开关**。
 * 关键差别：用 `ref s[0]` 取元素地址后经 ref 写 ref 字段，绕开判据 (iv) 对"经 view 写 ref 字段"
 * 的拒绝，于是本程序被 unitAllAcyclic 判为无环（main fn=1），**默认产物自动进事件档**
 * （EXTC_RC_NOCOUNT 0 / EXTC_RC_SWEEP_FREE 1 / EXTC_RC_TIER 1）。
 * 判据：default 与 EXTC_RC_NOCOUNT=0 两种构建，stdout 均须逐字为 "d0.v=7"，退出码 0。
 * 修复前（doc-audit 复现，HEAD 85b8871b 同）：两者均输出 "d0.v=555"（目标容器里的指针被判死，
 * 槽被随后 new 的 b 复用）。
 * 注意必须用 io::cout 而非 f-string：f-string 会拉进 stdlib String.grow/pPoison，
 * 判据 i-iii 失败 ⇒ 整个 unit 退回清扫档，本回归就观测不到。
 * 出处：Lead 2026-11-09；BUG-B 默认档可达性证明（doc-audit）。 */
use std::io

struct node { v: i64 }
struct item { r: mut ref node }

fn main() -> i32 {
    var s: mut slice<item> = new item[2]
    var q: mut ref item = ref s[0]
    q.r = new node
    q.r.v = 7
    var d: mut slice<item> = new item[2]
    copyInto<item>(d, s, 1)
    q.r = new node
    q.r.v = 8
    var b = new node
    b.v = 555
    io::cout << "d0.v=" << d[0].r.v << "\n"
    return 0
}
