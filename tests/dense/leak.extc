// expect: base=true payloads=true released=true
/* 存储必须回到基线：块的字节（`bufLive` 账本归零），以及拥有型元素的载荷（`dropRange` 跑钩子）。 */
use std::data::dense::{block}
use std::data::buf
use std::text::string

fn main() -> i32 {
    let base: i64 = buf::bufLive()
    var i: i64 = 0
    while i < 200 {
        var b: block<i64> = block<i64>::withCap(64)
        b[0] = i
        b.setLen(1)
        b.release()
        i = i + 1
    }
    let base1: bool = buf::bufLive() == base
    var s: block<string> = block<string>::withCap(40)
    var k: i64 = 0
    while k < 40 {
        var t: string = string::withCap(64)
        var j: i64 = 0
        while j < 40 { t.push(u8(65 + k % 26))  j = j + 1 }
        s[k] = t
        k = k + 1
    }
    s.setLen(40)
    let held: i64 = buf::bufLive()
    s.release()
    let after: i64 = buf::bufLive()
    let payloads: bool = held - after >= 1600
    let released: bool = after == base
    println("base=", base1, " payloads=", payloads, " released=", released)
    return 0
}
