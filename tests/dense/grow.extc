// expect: used=50 cap=64 order=true zero=true
/* 增长是**搬**不是拷：`growTo` 把元素一个个 `elemTake` 到新块、旧块当场还回竞技场。 */
use std::data::dense::{block}

fn main() -> i32 {
    var b: block<i64> = block<i64>::withCap(4)
    var i: i64 = 0
    while i < 4 { b[i] = i * i  i = i + 1 }
    b.setLen(4)
    b.growTo(64)
    while i < 50 { b[i] = i * i  i = i + 1 }
    b.setLen(50)
    var order: bool = true
    var j: i64 = 0
    while j < 50 {
        if b[j] != j * j { order = false }
        j = j + 1
    }
    let zero: bool = b[60] == 0
    println("used=", b.len(), " cap=", b.capacity(), " order=", order, " zero=", zero)
    return 0
}
