// expect: rm=true old=false new=-1 gen1=1 reuse=true n=3 at0=10 ep0=true ep1=false
/* 句柄失效的三条路：`remove` 让那个槽的世代 +1；同一个纪元里槽会被复用（`gen` 变）；
 * `clear` 翻纪元，整代句柄当场作废（连 `ent` 都不用看）。 */
use std::data::dense::{handle, slots}

fn main() -> i32 {
    var d: slots<i64> = slots<i64>::withCap(4)
    let a = d.insert(10)
    let b = d.insert(20)
    let c = d.insert(30)
    let rm: bool = d.remove(b)
    let old: bool = d.contains(b)
    let gun: i64 = i64(b.gen)
    /* 再插一个：空洞链先还 `b` 的槽，所以新句柄的 slot 与 b 相同、gen 更大。 */
    let e = d.insert(40)
    let reuse: bool = e.slot == b.slot
    let gnow: i64 = i64(e.gen)
    let nr: bool = d.contains(e)
    /* 现在活值：dense0 = 10(a)，dense1 = 40(e)；`c` 被换到了 dense1 之前？不 —— 交换删除只搬最后一个。 */
    let at0: i64 = d.atDense(0)
    let ep0: bool = d.contains(a)
    let nlive: i64 = d.len()
    d.clear()
    let ep1: bool = d.contains(a)
    println("rm=", rm, " old=", old, " new=", d.get(b) ?? -1, " gen1=", gnow - gun, " reuse=", reuse,
            " n=", nlive, " at0=", at0, " ep0=", ep0, " ep1=", ep1)
    return 0
}