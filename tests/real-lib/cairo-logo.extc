// expect: cairo=1.18.4 surface=ok png=ok green= white= edges=1111 drawn=1 center=ok
// C-ABI 第 5 步 ③：**用真的第三方库画一张画**（cairo 1.18.4，`dlopen` 进来，没有头文件、不链接它）。
//
// 这条线原来是"两个自编的玩具模块互相调"；现在换成 libcairo.so.2 —— 一个真正的、我们没参与过的
// C 库。整条路一起过：`dlopen` → `dlsym` → 把地址填进**一张带签名的表** → 画布内存在**板**里
// → 二十来个真 API 调用 → 写出 PNG。
//
// 四件只有语言这几格齐了才能做的事：
//
// ① **不能 `link` 它，只能 `dlopen` 它**：`extern!("libcairo")` 会让**链接器**去找那些符号
//    （实测：undefined reference to `cairo_select_font_face`）。`dlopen` 那条路上，函数只是
//    一个地址。
//
// ② **地址必须有签名，签名在槽上**：`dlsym` 回来的是裸地址，转换成 `fn` 值之后**没有签名**
//    ⇒ 调用按最保守算（"它可能留住每一个实参"）⇒ 连一个 `var c: ref void = cr` 这样的本帧局部
//    都会被拒（实测报 "may be kept by C forever, but it points into this frame (depth 1)"）。
//    所以把地址填进 `struct cairoApi` 的**字段**，每个字段带 `effects`：调用点经 `api.paint(c)`
//    走槽的签名（第 3 步 ② 那一格）。**表要传下去，不能把函数指针拷出来** —— 拷出来签名就丢了。
//
// ③ **画布内存在板里**：4 GiB 保留、按需 commit、`close` 即 munmap。cairo **会留着**这个指针
//    （surface 持有它），所以那个槽签的是 `Addr=1`（第 0 位 = 它存了第 0 个实参的地址）。
//    而"会留着"要求实参活得比这一帧久 ⇒ 那个指针要**内联**从板里取（`pl.view(...)!.data`）：
//    先存进局部的视图在逃逸分析眼里只有本帧的寿命（实测被拒）。
//
// ④ **C 字符串没有长度**：cairo 的字符串参数是 `const char *`（一个机器字 ⇒ 只能写 `ref u8`）。
//    字面量在 C 那边本来就是 NUL 结尾的 ⇒ 取 `.data` 直接用（`cs`）；`cairo_version_string`
//    返回的那种要数长度 ⇒ `dl::viewCStr`（第 4 步 ② 的 `extc_viewOf` 在库侧的两个出口）。
use std::io
use std::dl
use std::heap

/* cairo_text_extents_t：六个 double，就这么多。量文字要靠它（居中）。 */
@frozen struct textExtents {
    xBearing: f64
    yBearing: f64
    width:    f64
    height:   f64
    xAdvance: f64
    yAdvance: f64
}

/* cairo 的**表**：我们自己填（cairo 不参与）。每个槽带签名 —— 这是 `dlopen` 那条路上唯一能
 * 给函数指针写上"它会/不会留住你的指针"的地方。签的都是实话：
 *   · `Addr=1` 的：surface 留着像素缓冲区（第 0 个实参）、context 留着 surface；
 *   · `Addr=0` 的：调用期间用完就完（画、描、设色只碰上下文）。
 * 类型上 `cairo_t *` / `cairo_surface_t *` 都是不透明句柄 ⇒ `ref void`（看不进去，也不用看进去）。 */
struct cairoApi {
    versionString:  fn() -> ref u8 effects Addr=0 Cont=0
    surfaceForData: fn(ref u8, i32, i32, i32, i32) -> ?ref void effects Addr=1 Cont=0
    create:         fn(ref void) -> ?ref void effects Addr=1 Cont=0
    destroy:        fn(ref void) -> void effects Addr=0 Cont=0
    surfaceDestroy: fn(ref void) -> void effects Addr=0 Cont=0
    surfaceFlush:   fn(ref void) -> void effects Addr=0 Cont=0
    writePng:       fn(ref void, ref u8) -> i32 effects Addr=0 Cont=0
    setSourceRgb:   fn(ref void, f64, f64, f64) -> void effects Addr=0 Cont=0
    paint:          fn(ref void) -> void effects Addr=0 Cont=0
    setLineWidth:   fn(ref void, f64) -> void effects Addr=0 Cont=0
    moveTo:         fn(ref void, f64, f64) -> void effects Addr=0 Cont=0
    lineTo:         fn(ref void, f64, f64) -> void effects Addr=0 Cont=0
    arc:            fn(ref void, f64, f64, f64, f64, f64) -> void effects Addr=0 Cont=0
    closePath:      fn(ref void) -> void effects Addr=0 Cont=0
    stroke:         fn(ref void) -> void effects Addr=0 Cont=0
    fill:           fn(ref void) -> void effects Addr=0 Cont=0
    selectFontFace: fn(ref void, ref u8, i32, i32) -> void effects Addr=0 Cont=0
    setFontSize:    fn(ref void, f64) -> void effects Addr=0 Cont=0
    showText:       fn(ref void, ref u8) -> void effects Addr=0 Cont=0
    textExtents:    fn(ref void, ref u8, mut ref textExtents) -> void effects Addr=0 Cont=0
}

let W: i32 = 512
let H: i32 = 512
let FORMAT_ARGB32: i32 = 0
let PI: f64 = 3.14159265358979

/* 取一个符号；没有就带着名字报错退出（`dlsym` 返回可空，`!` 是"我查过了"的签字）。 */
fn need(h: ?ref void, name: slice<u8>) -> ?ref void {
    var p: ?ref void = dl::sym(h, name)
    if p == null {
        io::cout << "sym-fail=" << name << "\n"
        return null
    }
    return p
}

/* C 的字符串参数是 `const char *`（**一个机器字**，所以只能声明成 `ref u8`，不能是 `slice<u8>`）。
 * 字面量在 C 那边本来就是 NUL 结尾的 ⇒ 取 `.data` 直接用；运行期拼出来的才要 `dl::cstr`。 */
fn cs(s: slice<u8>) -> ref u8 { return s.data }

fn main() -> i32 {
    var h: ?ref void = dl::open("libcairo.so.2")
    if h == null {
        io::cout << "open=fail\n"
        return 1
    }
    /* 二十个符号，一次全取出来（每个都经 `need`，缺哪个名字会说出来）。 */
    var sv: ?ref void = need(h, "cairo_version_string")
    var ss: ?ref void = need(h, "cairo_image_surface_create_for_data")
    var sc: ?ref void = need(h, "cairo_create")
    var sd: ?ref void = need(h, "cairo_destroy")
    var ssd: ?ref void = need(h, "cairo_surface_destroy")
    var sfl: ?ref void = need(h, "cairo_surface_flush")
    var spng: ?ref void = need(h, "cairo_surface_write_to_png")
    var srgb: ?ref void = need(h, "cairo_set_source_rgb")
    var spaint: ?ref void = need(h, "cairo_paint")
    var slw: ?ref void = need(h, "cairo_set_line_width")
    var smv: ?ref void = need(h, "cairo_move_to")
    var sln: ?ref void = need(h, "cairo_line_to")
    var sarc: ?ref void = need(h, "cairo_arc")
    var scl: ?ref void = need(h, "cairo_close_path")
    var sst: ?ref void = need(h, "cairo_stroke")
    var sfill: ?ref void = need(h, "cairo_fill")
    var sfont: ?ref void = need(h, "cairo_select_font_face")
    var ssize: ?ref void = need(h, "cairo_set_font_size")
    var stxt: ?ref void = need(h, "cairo_show_text")
    var sext: ?ref void = need(h, "cairo_text_extents")
    if sv == null || ss == null || sc == null || sd == null || ssd == null || sfl == null ||
       spng == null || srgb == null || spaint == null || slw == null || smv == null ||
       sln == null || sarc == null || scl == null || sst == null || sfill == null ||
       sfont == null || ssize == null || stxt == null || sext == null {
        dl::close(h)
        return 1
    }

    /* 填表：每个槽一句显式转换 = 作者的签字（"这个地址确实是这个签名"）。 */
    var api: cairoApi = cairoApi {
        versionString:  fn() -> ref u8(sv!),
        surfaceForData: fn(ref u8, i32, i32, i32, i32) -> ?ref void(ss!),
        create:         fn(ref void) -> ?ref void(sc!),
        destroy:        fn(ref void) -> void(sd!),
        surfaceDestroy: fn(ref void) -> void(ssd!),
        surfaceFlush:   fn(ref void) -> void(sfl!),
        writePng:       fn(ref void, ref u8) -> i32(spng!),
        setSourceRgb:   fn(ref void, f64, f64, f64) -> void(srgb!),
        paint:          fn(ref void) -> void(spaint!),
        setLineWidth:   fn(ref void, f64) -> void(slw!),
        moveTo:         fn(ref void, f64, f64) -> void(smv!),
        lineTo:         fn(ref void, f64, f64) -> void(sln!),
        arc:            fn(ref void, f64, f64, f64, f64, f64) -> void(sarc!),
        closePath:      fn(ref void) -> void(scl!),
        stroke:         fn(ref void) -> void(sst!),
        fill:           fn(ref void) -> void(sfill!),
        selectFontFace: fn(ref void, ref u8, i32, i32) -> void(sfont!),
        setFontSize:    fn(ref void, f64) -> void(ssize!),
        showText:       fn(ref void, ref u8) -> void(stxt!),
        textExtents:    fn(ref void, ref u8, mut ref textExtents) -> void(sext!)
    }

    var vp: ref u8 = api.versionString()
    io::cout << "cairo=" << dl::viewCStr(vp)

    /* 画布内存：**板**里。偏移记下来（不存视图 —— 见文件头 ③）。 */
    var pl: heap::plate = heap::plate::open(heap::DEFAULT_RESERVE)!
    var pxBytes: u64 = u64(W) * u64(H) * u64(4)
    var pxOff: u64 = pl.usedBytes()
    pl.alloc(pxBytes)!

    /* 指针内联从板里取：`Addr=1` 要求它活得比这一帧久。 */
    var surf: ?ref void = api.surfaceForData(pl.view(pxOff, pxBytes)!.data,
                                             FORMAT_ARGB32, W, H, W * i32(4))
    if surf == null {
        io::cout << " surface=fail\n"
        pl.close()
        dl::close(h)
        return 1
    }
    var cr: ?ref void = api.create(surf)
    if cr == null {
        io::cout << " context=fail\n"
        api.surfaceDestroy(surf)
        pl.close()
        dl::close(h)
        return 1
    }
    io::cout << " surface=ok"
    var c: ref void = cr

    /* 画的时候**每一步都直接经槽调**（`api.paint(c)` 这种），不包 extC helper —— 这不是风格问题：
     * 包一层之后那个 helper 的 effect 总结是 **incomplete**（实测 `EXTC_DBG_REFARGS=1`：`complete=0`），
     * 于是它的调用者不能再把本帧的指针传进去（会报 "points into a deeper scope (depth 1) than the
     * arena this call may store it in"）。签名在**槽**上 ⇒ 调用就要发生在槽那里 ✓
     * （长度不变式：指针只在本帧里用 ⇒ 槽签 `Addr=0` 时本帧局部完全合法。） */

    /* 底色 */
    api.setSourceRgb(c, 0.055, 0.070, 0.100)
    api.paint(c)

    /* 一圈圆角边框（extC 的绿）：四段 1/4 圆弧 + 四条边，一条闭合路径（cairo 的标准画法）。 */
    api.setSourceRgb(c, 0.239, 0.859, 0.518)
    api.setLineWidth(c, 10.0)
    api.moveTo(c, 110.0, 26.0)
    api.lineTo(c, 402.0, 26.0)
    api.arc(c, 402.0, 110.0, 84.0, -PI / 2.0, 0.0)
    api.lineTo(c, 486.0, 402.0)
    api.arc(c, 402.0, 402.0, 84.0, 0.0, PI / 2.0)
    api.lineTo(c, 110.0, 486.0)
    api.arc(c, 110.0, 402.0, 84.0, PI / 2.0, PI)
    api.lineTo(c, 26.0, 110.0)
    api.arc(c, 110.0, 110.0, 84.0, PI, PI * 1.5)
    api.closePath(c)
    api.stroke(c)

    /* 大括号 `{ }`（cairo 的 toy 字体 API；量宽度居中：`cairo_text_extents` 写进一个 @frozen 结构体） */
    api.selectFontFace(c, cs("monospace"), 0, 1)
    api.setFontSize(c, 230.0)
    api.setSourceRgb(c, 0.239, 0.859, 0.518)
    var teL: textExtents = textExtents { xBearing: 0.0, yBearing: 0.0, width: 0.0,
                                         height: 0.0, xAdvance: 0.0, yAdvance: 0.0 }
    api.textExtents(c, cs("{"), ref teL)
    api.moveTo(c, 150.0 - teL.width / 2.0 - teL.xBearing, 330.0)
    api.showText(c, cs("{"))
    var teR: textExtents = textExtents { xBearing: 0.0, yBearing: 0.0, width: 0.0,
                                         height: 0.0, xAdvance: 0.0, yAdvance: 0.0 }
    api.textExtents(c, cs("}"), ref teR)
    api.moveTo(c, 362.0 - teR.width / 2.0 - teR.xBearing, 330.0)
    api.showText(c, cs("}"))

    /* 中间三个字母 + 一条基线 */
    api.selectFontFace(c, cs("sans"), 0, 1)
    api.setFontSize(c, 112.0)
    api.setSourceRgb(c, 0.925, 0.949, 0.976)
    var teX: textExtents = textExtents { xBearing: 0.0, yBearing: 0.0, width: 0.0,
                                         height: 0.0, xAdvance: 0.0, yAdvance: 0.0 }
    api.textExtents(c, cs("extC"), ref teX)
    api.moveTo(c, 256.0 - teX.width / 2.0 - teX.xBearing, 300.0)
    api.showText(c, cs("extC"))
    api.setSourceRgb(c, 0.239, 0.859, 0.518)
    api.setLineWidth(c, 6.0)
    api.moveTo(c, 176.0, 328.0)
    api.lineTo(c, 336.0, 328.0)
    api.stroke(c)

    /* 页脚：谁画的（版本号是 cairo 自己给的） */
    api.selectFontFace(c, cs("monospace"), 0, 0)
    api.setFontSize(c, 30.0)
    api.setSourceRgb(c, 0.58, 0.64, 0.72)
    var teF: textExtents = textExtents { xBearing: 0.0, yBearing: 0.0, width: 0.0,
                                         height: 0.0, xAdvance: 0.0, yAdvance: 0.0 }
    api.textExtents(c, cs("extC x cairo 1.18.4"), ref teF)
    api.moveTo(c, 256.0 - teF.width / 2.0 - teF.xBearing, 452.0)
    api.showText(c, cs("extC x cairo 1.18.4"))

    /* 落盘：先 flush（cairo 自己也有缓冲），再写 PNG */
    api.surfaceFlush(surf)
    var st: i32 = api.writePng(surf, cs("build/extc-logo.png"))
    if st != 0 {
        io::cout << " png=fail(" << st << ")\n"
        api.destroy(c)
        api.surfaceDestroy(surf)
        pl.close()
        dl::close(h)
        return 1
    }
    io::cout << " png=ok"

    /* **画对了吗**：不能靠眼睛（谁跑这个测试都得能判），所以按颜色与位置数。
     *
     * ARGB32 每像素 4 字节，小端序是 BB GG RR AA：
     *   · 绿（0.239, 0.859, 0.518）→ 边框 + 大括号 + 基线；
     *   · 白（0.925, 0.949, 0.976）→ 中间三个字母。
     * 位置也查：四条边（y=26 那条上沿、y=486 下沿、x=26 左沿、x=486 右沿）各有绿色，
     * 中间那条横带（y=250..300）有白色 —— 空图、纯色图、画错位置都过不了。 */
    var px: mut slice<u8> = pl.view(pxOff, pxBytes)!
    var different: i64 = 0
    var green: i64 = 0
    var white: i64 = 0
    var topEdge: i64 = 0
    var bottomEdge: i64 = 0
    var leftEdge: i64 = 0
    var rightEdge: i64 = 0
    var midBand: i64 = 0
    var i: i64 = 0
    while i < i64(W) * i64(H) {
        var o: i64 = i * i64(4)
        var b: i64 = i64(px[o])
        var g: i64 = i64(px[o + 1])
        var r: i64 = i64(px[o + 2])
        var isGreen: bool = r > i64(30) && r < i64(95) && g > i64(185) && g < i64(245) &&
                           b > i64(95) && b < i64(170)
        var isWhite: bool = r > i64(200) && g > i64(200) && b > i64(200)
        if isGreen { green = green + 1 }
        if isWhite { white = white + 1 }
        if isGreen || isWhite { different = different + 1 }
        var y: i64 = i / i64(W)
        var x: i64 = i - y * i64(W)
        if isGreen {
            if y >= i64(20) && y <= i64(32) { topEdge = topEdge + 1 }
            if y >= i64(480) && y <= i64(492) { bottomEdge = bottomEdge + 1 }
            if x >= i64(20) && x <= i64(32) { leftEdge = leftEdge + 1 }
            if x >= i64(480) && x <= i64(492) { rightEdge = rightEdge + 1 }
        }
        if isWhite && y >= i64(240) && y <= i64(310) { midBand = midBand + 1 }
        i = i + 1
    }
    io::cout << " green=" << green << " white=" << white
    /* 四条边各占一位（`i64(bool)` 不合法：显式转换只在数字之间 ⇒ 用加法把判据编成一个数）。 */
    var edges: i64 = 0
    if topEdge > i64(100) { edges = edges + 1000 }
    if bottomEdge > i64(100) { edges = edges + 100 }
    if leftEdge > i64(100) { edges = edges + 10 }
    if rightEdge > i64(100) { edges = edges + 1 }
    io::cout << " edges=" << edges
    if different > i64(1000) { io::cout << " drawn=1" } else { io::cout << " drawn=0" }
    if midBand > i64(200) { io::cout << " center=ok" } else { io::cout << " center=thin" }

    api.destroy(c)
    api.surfaceDestroy(surf)
    pl.close()
    dl::close(h)
    io::cout << "\n"
    return 0
}
