// expect: cairo=1.18.4 surface=ok png=ok green= white= edges=1111 drawn=1 center=ok
// C-ABI 第 5 步 ⑥：**用生成出来的绑定**画同一张画（`tools/cbindgen.py`，零签字）。
//
// 与手写那版（本文件的历史）比，差别就是几条命令：
//
//     tools/cbindgen.py @tools/cbindgen-cairo.args --include cairo.h -I <cairo 头文件目录>
//
// 生成物 `tests/real-lib/cairoapi.extc`：19 个函数 + 3 组枚举常量，**一条 effects 都不写**
// （槽不签 = 最坏情况 = 安全的那一侧），结构体指针一律 `?ref void`（不假装布局）。
// 于是 `use cairoapi` 之后调用就是 `c.paint(cr)` / `c.arc(cr, …)`，一个字符都不用签。
//
// 剩下**两格是人写的**，就在下面（工具不替人说话）：
//   ① `cairo_text_extents_t` 的**布局**要人写 `@frozen` 镜像（§9.8）—— 按类型撒谎没有任何检查
//      会拦，所以工具一律映射成 `?ref void`，要读字段就自己写镜像；
//   ② 它是"把**帧内**的东西就地交给 C"的那种（`te` 在栈上）⇒ 那个槽要一句 `Addr=0 Cont=0`
//      （§9.15：这是 `effects` 唯一必须存在的理由）。
use std::io
use std::dl
use std::heap
use cairoapi::*     /* 生成物：19 个函数 + 3 组枚举常量 */

let W: i32 = 512
let H: i32 = 512
let PI: f64 = 3.14159265358979

/* ① 布局镜像：`cairo_text_extents_t` 就是六个 double。 */
@frozen struct textExtents {
    xBearing: f64
    yBearing: f64
    width:    f64
    height:   f64
    xAdvance: f64
    yAdvance: f64
}

/* ② 那一个要签字的槽：帧内地址就地交给 C。 */
struct textApi {
    textExtents: fn(?ref void, ?ref u8, mut ref textExtents) -> void effects Addr=0 Cont=0
}

fn openText(h: ?ref void) -> ?textApi {
    return some(textApi {
        textExtents: fn(?ref void, ?ref u8, mut ref textExtents) -> void(
                         dl::sym(h, "cairo_text_extents")!)
    })
}

/* C 的字符串参数是 `const char *`（一个机器字）。字面量在 C 那边本来就 NUL 结尾 ⇒ 取 `.data`。 */
fn cs(s: slice<u8>) -> ref u8 { return s.data }

/* 圆角矩形：四段 1/4 圆弧 + 四条边，一条闭合路径（cairo 的标准画法）。
 *
 * 注意表是**按值**传的（`c: api`，21 个指针的副本）。理由具体：生成的槽**没签字** ⇒ 最坏情况
 * = "它可能留住每个实参" ⇒ 这个 helper 的 effect 总结是 incomplete ⇒ 它的调用者再传**本帧的**
 * 地址（`ref c`，那个表就在 main 的帧里）就会被拒。按值传就没有这件事：callee 拿到自己的一份副本，
 * 什么都不悬 ✓。想用 `ref` 也行 —— 给那几个槽签 `Addr=0 Cont=0`（§9.15 那件人写的事）。 */
fn roundedRect(c: api, cr: ref void, x: f64, y: f64, w: f64, h: f64, r: f64) {
    c.move_to(cr, x + r, y)
    c.line_to(cr, x + w - r, y)
    c.arc(cr, x + w - r, y + r, r, -PI / 2.0, 0.0)
    c.line_to(cr, x + w, y + h - r)
    c.arc(cr, x + w - r, y + h - r, r, 0.0, PI / 2.0)
    c.line_to(cr, x + r, y + h)
    c.arc(cr, x + r, y + h - r, r, PI / 2.0, PI)
    c.line_to(cr, x, y + r)
    c.arc(cr, x + r, y + r, r, PI, PI * 1.5)
    c.close_path(cr)
}

/* 一段文字**水平居中**画在 (cx, baselineY)：量宽度要走那个签过字的槽（`te` 是帧内的，所以那个
 * 槽必须签 `Addr=0 Cont=0` —— 这正是 `effects` 唯一必须存在的理由）。 */
fn centeredText(c: api, tx: textApi, cr: ref void, s: ref u8,
                cx: f64, baselineY: f64) {
    var te: textExtents = textExtents { xBearing: 0.0, yBearing: 0.0, width: 0.0,
                                        height: 0.0, xAdvance: 0.0, yAdvance: 0.0 }
    tx.textExtents(cr, s, ref te)
    c.move_to(cr, cx - te.width / 2.0 - te.xBearing, baselineY)
    c.show_text(cr, s)
}

fn main() -> i32 {
    var c: api = api::open("libcairo.so.2")!
    var tx: textApi = openText(c.handle)!
    /* 生成物里返回值一律 `?ref`（C 的头文件不说可空性）⇒ 判空一次（语言本来就有的那条规则）。 */
    var vp: ?ref u8 = c.version_string()
    if vp == null {
        io::cout << "version=fail\n"
        return 1
    }
    io::cout << "cairo=" << dl::viewCStr(vp)

    /* 画布内存：**板**里。板签了 `effects Ret=0`（§9.15）⇒ 视图存局部也行，指针交给 C 不用签字。 */
    var pl: heap::plate = heap::plate::open(heap::DEFAULT_RESERVE)!
    var pxBytes: u64 = u64(W) * u64(H) * u64(4)
    var pxOff: u64 = pl.usedBytes()
    var px: mut slice<u8> = pl.alloc(pxBytes)!

    var surf: ?ref void = c.image_surface_create_for_data(px.data, CAIRO_FORMAT_ARGB32, W, H,
                                                          W * i32(4))
    if surf == null {
        io::cout << " surface=fail\n"
        pl.close()
        return 1
    }
    var cr: ?ref void = c.create(surf)
    if cr == null {
        io::cout << " context=fail\n"
        c.surface_destroy(surf)
        pl.close()
        return 1
    }
    io::cout << " surface=ok"
    var r: ref void = cr

    /* 底色 */
    c.set_source_rgb(r, 0.055, 0.070, 0.100)
    c.paint(r)

    /* 一圈圆角边框（extC 的绿） */
    c.set_source_rgb(r, 0.239, 0.859, 0.518)
    c.set_line_width(r, 10.0)
    roundedRect(c, r, 26.0, 26.0, 460.0, 460.0, 84.0)
    c.stroke(r)

    /* 大括号 `{ }` */
    c.select_font_face(r, cs("monospace"), CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD)
    c.set_font_size(r, 230.0)
    centeredText(c, tx, r, cs("{"), 150.0, 330.0)
    centeredText(c, tx, r, cs("}"), 362.0, 330.0)

    /* 中间三个字母 + 一条基线 */
    c.select_font_face(r, cs("sans"), CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD)
    c.set_font_size(r, 112.0)
    c.set_source_rgb(r, 0.925, 0.949, 0.976)
    centeredText(c, tx, r, cs("extC"), 256.0, 300.0)
    c.set_source_rgb(r, 0.239, 0.859, 0.518)
    c.set_line_width(r, 6.0)
    c.move_to(r, 176.0, 328.0)
    c.line_to(r, 336.0, 328.0)
    c.stroke(r)

    /* 页脚：谁画的（版本号是 cairo 自己给的） */
    c.select_font_face(r, cs("monospace"), CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL)
    c.set_font_size(r, 30.0)
    c.set_source_rgb(r, 0.58, 0.64, 0.72)
    centeredText(c, tx, r, cs("extC x cairo 1.18.4"), 256.0, 452.0)

    /* 落盘 */
    c.surface_flush(surf)
    var st: i32 = c.surface_write_to_png(surf, cs("build/extc-logo.png"))
    if st != 0 {
        io::cout << " png=fail(" << st << ")\n"
        c.destroy(r)
        c.surface_destroy(surf)
        pl.close()
        return 1
    }
    io::cout << " png=ok"

    /* **画对了吗**：不能靠眼睛（谁跑这个测试都得能判），所以按颜色与位置数。
     * ARGB32 每像素 4 字节，小端序是 BB GG RR AA：绿 = 边框+大括号+基线，白 = 三个字母。 */
    var different: i64 = 0
    var green: i64 = 0
    var white: i64 = 0
    var topEdge: i64 = 0
    var bottomEdge: i64 = 0
    var leftEdge: i64 = 0
    var rightEdge: i64 = 0
    var midBand: i64 = 0
    var i: i64 = 0
    while i < i64(W) * i64(H) {
        var o: i64 = i * i64(4)
        var b: i64 = i64(px[o])
        var g: i64 = i64(px[o + 1])
        var rd: i64 = i64(px[o + 2])
        var isGreen: bool = rd > i64(30) && rd < i64(95) && g > i64(185) && g < i64(245) &&
                           b > i64(95) && b < i64(170)
        var isWhite: bool = rd > i64(200) && g > i64(200) && b > i64(200)
        if isGreen { green = green + 1 }
        if isWhite { white = white + 1 }
        if isGreen || isWhite { different = different + 1 }
        var y: i64 = i / i64(W)
        var x: i64 = i - y * i64(W)
        if isGreen {
            if y >= i64(20) && y <= i64(32) { topEdge = topEdge + 1 }
            if y >= i64(480) && y <= i64(492) { bottomEdge = bottomEdge + 1 }
            if x >= i64(20) && x <= i64(32) { leftEdge = leftEdge + 1 }
            if x >= i64(480) && x <= i64(492) { rightEdge = rightEdge + 1 }
        }
        if isWhite && y >= i64(240) && y <= i64(310) { midBand = midBand + 1 }
        i = i + 1
    }
    io::cout << " green=" << green << " white=" << white
    var edges: i64 = 0
    if topEdge > i64(100) { edges = edges + 1000 }
    if bottomEdge > i64(100) { edges = edges + 100 }
    if leftEdge > i64(100) { edges = edges + 10 }
    if rightEdge > i64(100) { edges = edges + 1 }
    io::cout << " edges=" << edges
    if different > i64(1000) { io::cout << " drawn=1" } else { io::cout << " drawn=0" }
    if midBand > i64(200) { io::cout << " center=ok" } else { io::cout << " center=thin" }

    c.destroy(r)
    c.surface_destroy(surf)
    pl.close()
    io::cout << "\n"
    return 0
}
