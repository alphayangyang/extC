// expect: total = 10094
/* **`@overwrite` + 运行时长度**的 ASan 验收（定案 65 步骤③）
 * 长度逐轮变（10 → 10000 → 10）：存储 `{ptr, cap}` 只在"比见过的都大"时**翻倍**重来 ✓
 * ⇒ 分配次数与迭代数无关（这里 4 轮只该分配 2 次）✓ 内存平坦 ✓ 指针不飞 ✓ */
struct node { value: i64  next: ?ref node }

fn main() {
    var lens: [4]i64
    lens[0] = 10
    lens[1] = 10000
    lens[2] = 10
    lens[3] = 10
    var i: i64 = 0
    var total: i64 = 0
    while i < 4 {
        var k: i64 = lens[i]
        @overwrite var buf = new u8[k]
        buf[0] = u8(7)
        buf[k - 1] = u8(9)
        total = total + i64(buf[0]) + i64(buf[k - 1]) + buf.len
        i = i + 1
    }
    println("total = ", total)
}
