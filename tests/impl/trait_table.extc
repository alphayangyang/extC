/* 静态方法表（阶段 3 起：**每 trait 一份统一签名 struct + 每 (trait,类型,方法) 一个 thunk**）。
 * 两条判据都靠这个夹具：
 *   ① **槽位顺序 = trait 声明顺序** —— 故意让声明顺序与字母序相反（zeta 在前、alpha 在后）；
 *   ② 表在**该 trait 真被 dyn 用到**时才发出（`usedDyn`），所以这里必须真的派发一次。
 * 表实例的键与槽位顺序与第一期一致：`extc_vt$Trait$Type`。 */
use std::io

trait Both {
    fn zeta(self: ref Self) -> i64
    fn alpha(self: ref Self) -> i64
}

struct box { v: i64 }

impl Both for box {
    fn zeta(self: ref box) -> i64 { return self.v }
    fn alpha(self: ref box) -> i64 { return self.v + i64(1) }
}

fn main() -> i32 {
    let b = box { v: i64(3) }
    io::cout << "zeta=" << dyn Both(b).zeta() << " alpha=" << dyn Both(b).alpha() << "\n"
    return 0
}
