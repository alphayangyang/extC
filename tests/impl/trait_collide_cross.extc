// 反例⑦：两个 trait 在同一类型上声明同名方法
// expect: has duplicate method `tag`
trait Tag  { fn tag(self: ref Self) -> i64 }
trait Mark { fn tag(self: ref Self) -> i64 }
struct box { v: i64 }
impl Tag for box  { fn tag(self: ref box) -> i64 { return self.v } }
impl Mark for box { fn tag(self: ref box) -> i64 { return self.v } }
fn main() -> i32 { return 0 }
