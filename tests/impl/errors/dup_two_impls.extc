// 反例：两个 impl 块挂同一个方法名 ⇒ coherence：全程序一个类型一个方法集。
// expect: struct `pt` has duplicate method `sum`
use std::io
struct pt { x: i64 }
impl pt { fn sum(self: ref pt) -> i64 { return self.x } }
impl pt { fn sum(self: ref pt, o: pt) -> i64 { return self.x + o.x } }
fn main() -> i32 { var p: pt = { x: i64(1) }  return i32(p.sum()) }
