// 反例：类型体内已经有一个同名方法，impl 再挂一个同名的 ⇒ 一个类型只有**一个方法集**，
// 后者不许覆盖前者，必须报错。
// expect: struct `pt` has duplicate method `sum`
use std::io
struct pt {
    x: i64
    fn sum(self: ref pt) -> i64 { return self.x }
}
impl pt {
    fn sum(self: ref pt, o: pt) -> i64 { return self.x + o.x }
}
fn main() -> i32 { var p: pt = { x: i64(1) }  return i32(p.sum()) }
