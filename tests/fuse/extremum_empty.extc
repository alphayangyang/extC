// 空输入走兜底：折进写循环之后 `found` 仍是 false，结果必须等于用户写的兜底表达式本身。
use std::io
use std::data::seq

fn run() -> i32 {
    var n: i64 = 0
    var tmpv: mut slice<f64> = new f64[n]
    for i in 0..n { tmpv[i] = f64(i) + 1.0 }
    let mx: f64 = seq::max(tmpv) ?? (0.0 - 6.0)
    io::cout << "empty=" << mx << "\n"
    return 0
}

fn main() -> i32 {
    run()
    return 0
}
