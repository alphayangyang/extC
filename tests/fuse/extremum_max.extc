// S2 家族的 `seq::max` 形状：写循环 + `let mx: i64 = seq::max(tmp) ?? <兜底>`
// 资格满足时临时视图消失、极值在写循环里顺手维护（浮点/整数同语义、逐位相同）。
use std::io
use stl::seq

fn run(n: i64) -> i32 {
    var a: [6]i64 = [-3, -9, -1, -4, -2, -7]
    var tmp: mut slice<i64> = new i64[n]
    for i in 0..n { tmp[i] = a[i] * 2 }
    let mx: i64 = seq::max(tmp) ?? -1000
    io::cout << "mx=" << mx << "\n"
    return 0
}

fn main() -> i32 {
    run(i64(6))
    return 0
}
