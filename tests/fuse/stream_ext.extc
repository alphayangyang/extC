// S3 的容器写法：两层元素链之后，用 `for v in tmp { acc = acc + v }` 做归约。
// 累加器声明紧挨归约循环；容器形式的归约循环由检查器改写成索引形式再折进写循环。
use std::io

fn main() -> i32 {
    let n: i64 = 8
    var a: mut slice<f64> = new f64[n]
    for i in 0..n { a[i] = f64(i) }
    var tv1: mut slice<f64> = new f64[n]
    for i in 0..n { tv1[i] = a[i] * 2.0 }
    var tv2: mut slice<f64> = new f64[n]
    for i in 0..n { tv2[i] = tv1[i] + 1.0 }
    var acc: f64 = 0.0
    for v in tv2 { acc = acc + v }
    io::cout << f"cs={acc}\n"
    return 0
}
