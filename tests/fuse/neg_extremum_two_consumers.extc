// 反例：临时视图有两个消费者（max 与 min）⇒ 只折一处会漏掉另一处，整体不折。
use std::io
use std::data::seq

fn run(n: i64) -> i32 {
    var a: [3]f64 = [1.0, 2.0, 3.0]
    var tmpv: mut slice<f64> = new f64[n]
    for i in 0..n { tmpv[i] = a[i] * 2.0 }
    let mx: f64 = seq::max(tmpv) ?? 0.0
    let mn: f64 = seq::min(tmpv) ?? 0.0
    io::cout << "mx=" << mx << " mn=" << mn << "\n"
    return 0
}

fn main() -> i32 {
    run(i64(3))
    return 0
}
