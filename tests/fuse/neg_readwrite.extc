// 反例：读的循环既读又写同一个视图（out[i] = out[i] + tmp[i]）⇒ 写名与读名相交，不许融合。
use std::io

fn main() -> i32 {
    let n: i64 = 4
    var a: mut slice<f64> = new f64[n]
    var out: mut slice<f64> = new f64[n]
    for i in 0..n { a[i] = f64(i); out[i] = 0.0 }
    var tmpv: mut slice<f64> = new f64[n]
    for i in 0..n { tmpv[i] = a[i] * 2.0 }
    for i in 0..n { out[i] = out[i] + tmpv[i] }
    io::cout << f"out0={out[0]:.1f} out3={out[3]:.1f}\n"
    return 0
}
