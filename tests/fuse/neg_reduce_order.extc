// 反例：累加器不在左边（`cs = tmpv[i] + cs`）⇒ 不认，临时视图仍在。
use std::io

fn main() -> i32 {
    let n: i64 = 4
    var a: mut slice<f64> = new f64[n]
    for i in 0..n { a[i] = f64(i) + 1.0 }
    var tmpv: mut slice<f64> = new f64[n]
    for i in 0..n { tmpv[i] = a[i] * 0.5 }
    var cs: f64 = 0.0
    for i in 0..n { cs = tmpv[i] + cs }
    io::cout << f"cs={cs:.3}\n"
    return 0
}
