/* tests/reclaim-gaps/shapes/ext_frame_cycle.extc —— **`ext`（spawn）帧**里的环垃圾。
 *
 * `ext task(n)` 的帧在 spawn 处当普通局部量造好、交给域驱动 ⇒ 不在 C 栈上、`rcRootsUnreliable`
 * ⇒ 一个触发都不发。垃圾在帧的函数级区域里攒到帧销毁（域跑完）。
 */
use std::sys::domain
use std::io

struct node {
    v: i64
    next: ?mut ref node
}

fn parseI64(s: slice<u8>) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        var ch: u8 = s[i]
        if ch < u8(48) { break }
        if ch > u8(57) { break }
        v = v * 10 + i64(ch) - 48
        i = i + 1
    }
    return v
}

fn task(n: i64) -> coroutine<i64> {
    var keep: mut ref node = new node
    keep.v = i64(0)
    keep.next = keep
    var i: i64 = 0
    while i < n {
        var p: mut ref node = new node
        p.v = i
        p.next = p
        keep = p
        yield i
        i = i + 1
    }
    yield n
}

fn main(args: slice<slice<u8>>) -> i32 {
    var n: i64 = parseI64(args[1])
    let d = domain::single()
    d.run {
        ext task(n)
    }
    io::cout << "n=" << n << "\n"
    return 0
}
