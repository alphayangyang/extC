/* tests/reclaim-gaps/shapes/slot_elem_known.extc —— 下标槽 `s.kids[0]`（宿主**认得出来**）。
 *
 * 形状同 `tests/reclaim-shapes/cross_region_elem.extc`，但**不读**那条边（本目录只量回收能力，
 * 不当 UAF 判据）：环垃圾 `t` 被提到函数体区域（region 1），唯一的跨区入边落在 `s.kids[0]`
 * （region 2 → region 1）。`pad = new big` 是 region 1 的触发点。
 * 期望：宿主认得出来 ⇒ 登记跨区边、来源侧撤销 ⇒ 清扫收得掉 ⇒ 峰值有界。
 */
use std::io

struct node {
    next: ?mut ref node
    val: i64
    kids: [2]?mut ref node
}

struct big {
    pad: [8]i64
}

fn parseI64(s: slice<u8>) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        var ch: u8 = s[i]
        if ch < u8(48) { break }
        if ch > u8(57) { break }
        v = v * 10 + i64(ch) - 48
        i = i + 1
    }
    return v
}

fn main(args: slice<slice<u8>>) -> i32 {
    var n: i64 = parseI64(args[1])
    var keeper: ?mut ref node = null
    var pad: ?mut ref big = null
    var i: i64 = 0
    while i < n {
        var s: mut ref node = new node
        s.val = i64(-1)
        s.next = null
        s.kids[0] = null
        s.kids[1] = null
        {
            var t: mut ref node = new node
            t.val = i
            t.next = t
            keeper = t
            s.kids[0] = keeper        /* ← 跨区入边，下标槽，宿主 = s */
        }
        keeper = null
        pad = new big                 /* region 1 的分配点：触发清扫 */
        pad = null
        i = i + 1
    }
    io::cout << "n=" << n << "\n"
    return 0
}
