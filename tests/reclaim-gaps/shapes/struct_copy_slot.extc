/* tests/reclaim-gaps/shapes/struct_copy_slot.extc —— **整值存储**携带引用叶子（宿主认得出来）。
 * `s.w = wrap { n: keeper }`：目标槽类型是结构体（不是 `ref T`），走逐叶记账（`storeRefOwned`）。
 * 期望：登记上了 ⇒ region 1 的清扫收得掉环垃圾 ⇒ 峰值有界。对照 `slot_elem_known`。
 */
use std::io

struct node {
    next: ?mut ref node
    val: i64
}

struct wrap {
    n: ?mut ref node
}

struct box {
    w: wrap
    pad: [6]i64
}

struct big {
    pad: [8]i64
}

fn parseI64(s: slice<u8>) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        var ch: u8 = s[i]
        if ch < u8(48) { break }
        if ch > u8(57) { break }
        v = v * 10 + i64(ch) - 48
        i = i + 1
    }
    return v
}

fn main(args: slice<slice<u8>>) -> i32 {
    var n: i64 = parseI64(args[1])
    var keeper: ?mut ref node = null
    var pad: ?mut ref big = null
    var i: i64 = 0
    while i < n {
        var s: mut ref box = new box
        s.w = wrap { n: null }
        {
            var t: mut ref node = new node
            t.val = i
            t.next = t
            keeper = t
            s.w = wrap { n: keeper }     /* ← 整值存储里的跨区入边 */
        }
        keeper = null
        pad = new big
        pad = null
        i = i + 1
    }
    io::cout << "n=" << n << "\n"
    return 0
}
