/* tests/reclaim-gaps/shapes/par_tls_cycle.extc —— **TLS / parallel worker 房间**里的环垃圾。
 *
 * `parallel::run(w, out, n, threads)` 的每个 worker 有自己的线程本地 arena（`extc_tls_arena`）。
 * 整条 worker 调用链共用那一只区域：入口帧（depth == 0）拥有它，在自己的触发点照常扫；内层帧
 * 只记欠收。区域本身由 `extc_par_close`（下一次 run 前）与 worker 局部 arena 收尾时
 * `extc_rc_regionDrop` 丢掉 —— 与既有「join 之后父帧还能读、下一次 run 前销毁」的寿命一致。
 * 形状：worker 的 `keep = p` 把自环节点提到 worker 帧的函数级区域 ⇒ 每轮一个死自环节。
 * 注：目录 `tests/reclaim-rootstack/RECON.md` 说语料里没有正向并行程序；本文件是**新写的**
 * 最小正向程序（`extc_tls_arena` 在生成物里出现）。
 *
 * 输出视图用 `slice<u8>`（长度仍必须 >= n，运行期会查）而不是 `slice<i64>`：后者让峰值里多
 * 出一块 8·n 字节、与回收无关的基线，N vs 4N 的比值下界被抬到 1.68×，测不出回收有没有生效。
 * 判据把它当普通形状看：开档 N vs 4N 峰值比 < 1.5 且 sweeps > 0（今天 1.13×、9 次）。
 */
use std::parallel
use std::io

struct node {
    v: i64
    next: ?mut ref node
}

fn parseI64(s: slice<u8>) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        var ch: u8 = s[i]
        if ch < u8(48) { break }
        if ch > u8(57) { break }
        v = v * 10 + i64(ch) - 48
        i = i + 1
    }
    return v
}

fn w(id: i64, lo: i64, hi: i64, out: mut slice<u8>) -> i32 {
    var keep: mut ref node = new node
    keep.v = i64(0)
    keep.next = keep
    var i: i64 = lo
    while i < hi {
        var p: mut ref node = new node
        p.v = i
        p.next = p
        keep = p
        i = i + 1
    }
    out[0] = u8(keep.v & i64(255))
    return 0
}

fn main(args: slice<slice<u8>>) -> i32 {
    var n: i64 = parseI64(args[1])
    var out: mut slice<u8> = new u8[n]
    var k: i64 = 0
    while k < n { out[k] = u8(0)  k = k + 1 }
    let rc: i32 = parallel::run(w, out, n, i64(2))
    io::cout << "n=" << n << " rc=" << rc << " out0=" << i64(out[0]) << "\n"
    return 0
}
