/* t04_bigchurn.extc --- 巨块反复分配-回收（无根，走 free 队列 + 巨块丢页）。
 * 形状：每轮 new 一个 huge（8 MiB payload，走 huge block）+ 8 个 leaf，填好后**立刻丢根**，
 *   活集恒为 0。判据：(a) 稳态 RSS 不随轮次上涨且 <= 64 MiB；
 *   (b) [histo] over1ms=0；(c) 退出码 0。argv[1]=rounds 默认 120。 */
use std::io

fn parseN(args: slice<slice<u8>>, idx: i64, dflt: i64) -> i64 {
    if args.len <= idx { return dflt }
    var s: slice<u8> = args[idx]
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        var ch: u8 = s[i]
        if ch < u8(48) { break }
        if ch > u8(57) { break }
        v = v * 10 + i64(ch) - 48
        i = i + 1
    }
    if v > 0 { return v }
    return dflt
}

struct leaf { v: i64 }
struct huge { a: [1048576]?mut ref leaf  tag: i64 }

fn touch(b: mut ref huge, r: i64) {
    var i: i64 = 0
    while i < 8 {
        var p = new leaf
        p.v = r * 8 + i
        b.a[i] = p
        i = i + 1
    }
    b.tag = r
}

fn main(args: slice<slice<u8>>) -> i32 {
    var n: i64 = parseN(args, 1, 120)
    var r: i64 = 0
    var made: i64 = 0
    while r < n {
        var b = new huge
        touch(b, r)
        made = made + 1
        r = r + 1
    }
    io::cout << "T04 n=" << n << " made=" << made << "\n"
    return 0
}