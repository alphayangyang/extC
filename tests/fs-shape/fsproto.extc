/* fsproto.extc —— **`std::fs` 的常设验收**（定案 77 命名 + 定案 79 归属）
 *
 * ⚠️ 主人 2026-09-23：「**open 不够清晰，因为我不知道打开的是读还是写**」⇒ 完全对 ✗
 * 老形状 `open(path, 64, 0)` 两个毛病：
 *   ① `64` 是 **POSIX 的数**（`O_WRONLY|O_CREAT`）—— 用户得背常量、还得自己 `|` ✗
 *   ② 就算写成 `open(path, io::O_WRONLY|io::O_CREAT|io::O_TRUNC, …)`，
 *      "**打开的是读还是写**"仍然要读到第三个实参才知道 ✗
 *
 * ================================================================ 定的规范（定案 77）
 *
 *   | 做什么 | 名字 | 返回 | 已有内容 |
 *   |---|---|---|---|
 *   | 读 | `fs::openRead(p)` | `ifstream` | 不动 ✓ |
 *   | 写（截断） | `fs::openWrite(p)` | `ofstream` | **清掉** ⚠️ |
 *   | 写（追加） | `fs::openAppend(p)` | `ofstream` | **保留**，写在后面 ✓ |
 *
 * ⭐ **读型 / 写型是两个 struct** ⇒ 误用是**编译期错误**（`run.sh` 有两条反例钉着 ✓）：
 *   `error: no method `readSome` on `ofstream``
 *   `error: argument expects `ifstream`, found `ofstream``
 *
 * ⭐ **关不关是程序的事**（定案 79）：句柄不再由块代管，`close()` 就是**可检查的提交点**；
 *    开出来却全程没人关，是**编译期错误**（"opened and never closed"）✓
 *
 * ⚠️ 平台常量关在 `std::sys::io`：调用者**永远看不见** `O_*` ✓
 */
use std::fs
use std::io

/* 只收**读型** —— `run.sh` 的反例会拿 `ofstream` 调它，看编译器报不报 ✓
 * ⚠️ 它必须**真被用到**（否则触发"没人用"的警告 ✗）⇒ 下面正例里用了一次 ✓ */
fn fdOf(f: fs::ifstream) -> i32 { return f.fd }

fn go() -> result<unit, io::ioError> {
    // ---------- 写：openWrite ⇒ 类型是 ofstream（原内容被清掉）----------
    var out = fs::openWrite("build/fsproto-out.txt")?
    out.put("hello\n")?
    out.put("世界\n")?
    out.close()?                       // ⭐ 提交点：这里能报延迟的写错误

    // ---------- 读：openRead ⇒ 类型是 ifstream ----------
    var inp = fs::openRead("build/fsproto-out.txt")?
    var buf: [64]u8
    let n = inp.readSome(buf[..])?
    println("读到 ", n, " 字节 · fd = ", fdOf(inp))
    inp.close()?

    // ---------- 追加：openAppend ⇒ 原内容**保留** ----------
    var app = fs::openAppend("build/fsproto-out.txt")?
    app.put("again\n")?
    app.close()?

    var inp2 = fs::openRead("build/fsproto-out.txt")?
    var buf2: [64]u8
    let m = inp2.readSome(buf2[..])?
    println("追加之后 = ", m, " 字节（13 + 6 = 19 ⇒ 原内容没被清掉 ✓）")
    inp2.close()?
    return success(unit {})
}

fn main() -> i32 {
    match go() {
        success(u) => { println("fs 形状原型 ✓ 跑通了")  return 0 }
        failure(e) => {
            println("fs 形状原型 ✗ 失败了")
            match e {
                readFailed(code)  => { println("  readFailed(", code, ")") }
                notATerminal(code)  => { println("  notATerminal(", code, ")") }
                writeFailed(code) => { println("  writeFailed(", code, ")") }
                lineTooLong(n)    => { println("  lineTooLong(", n, ")") }
                closed(code)      => { println("  closed(", code, ")") }
                destFull(n)       => { println("  destFull(", n, ")") }
            }
            return 1
        }
    }
}
