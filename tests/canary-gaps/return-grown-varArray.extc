/* ⚠️ tests/canary-gaps/ —— **已知缺口**，故意**不**并进 tests/ 套件（进了就会 FAIL）
 *
 * 这是 PLAN #31（soundness 洞，ASan 实锤 heap-use-after-free）的最小复现：
 * **在一个函数里让 varArray 扩容，然后把容器返回出去**。
 *
 * 跑法：  ./build/extc --run tests/canary-gaps/return-grown-varArray.extc
 * 现状：  **编过**，并且打印 `[1002, 0]`（正确值 `[42, 43]`）⇒ 静默错数据 ✗
 * 证据：  cc -fsanitize=address 报
 *           heap-use-after-free ... freed by extc_arena_release in `mk`
 *
 * 根因（两处不一致）：
 *   · 建容器时（`withCap`，走 EX_ASSOC）→ 家 arena = `__extc_home`（**活的** ✓）
 *   · 扩容时（`push`，走 EX_METHOD，实参是本地的 `v`）→ 家 arena = `&__extc_a[1]`
 *     （**函数体块**那只，`return` 时被 release ✗）⇒ 新 buffer 比容器先死
 *   · 检查器那边 `v` 的 refDepth 还停在 0（建容器那个调用的实参深度）⇒ 逃逸检查没拦住
 */
fn mk() -> varArray<i32> {
    var v: varArray<i32> = varArray<i32>::withCap(0)   // cap 0 ⇒ 第一次 push 就扩容
    v.push(42)
    v.push(43)
    return v
}

/* 把刚被释放的 arena 块踩掉（不踩的话只是"运气好看不出错"） */
fn churn() {
    var i: i32 = 0
    while i < 4 {
        var w: varArray<i32> = varArray<i32>::withCap(500)
        w.push(i + 1000)
        i = i + 1
    }
}

fn main() {
    var v: varArray<i32> = mk()
    churn()
    println("拿到的 = ", v.asSlice(), "  size = ", v.size(), "（应该是 [42, 43] size = 2）")
    println("逼出 option_i32（PLAN #27）: ", varArray<i32>::withCap(1).get(0) ?? -1)
}
