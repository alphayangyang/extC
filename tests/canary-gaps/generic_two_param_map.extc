/* #62：泛型 K→V 表（**线性**版，完全照 `mapI64<V>` 的存储形状）⇒ 生成的 C 编不过
 *
 *     error: implicit declaration of function 'slice_slice_u8_index';
 *            did you mean 'slice_u8_index'?
 *     error: invalid type argument of unary '*' (have 'int')
 *
 * ⇒ 又是"生成的 C 编不过"那一档 ✗
 * ⚠️ **最小化没做出来**：`holder<V>` 单参数读/写 ✓ · 双参数 + 变量下标 ✓ ·
 *    具体类型同一动作 ✓ —— 只有这个完整形状稳定撞到（记下来，别丢）✓
 * 为什么 stdlib 没撞到：`tests/map/` 里 `V` **清一色是 `i32`**
 * （`grep mapI64< tests/map/*.extc` ⇒ 全是 `mapI64<i32>`）⇒ "值是字符串"这条从没被走过 ✗
 * 顺带记一条今天的能力边界：`varArray<T>` **不能下标** ⇒ 想学 `mapI64` 那样
 * `some(self.vals[i])`，就得自己存 `mut slice<V>`（stdlib 正是这么写的）✓ */
struct mapKV<K, V> {
    keys: mut slice<K>
    vals: mut slice<V>
    n:    i64
    cap:  i64

    fn withCap(want: i64) -> mapKV<K, V> {
        var c: i64 = i64(8)
        while c < want { c = c * i64(2) }
        return { keys: new K[c], vals: new V[c], n: i64(0), cap: c }
    }
    fn find(self: ref mapKV<K, V>, k: K) -> i64 {
        var i: i64 = 0
        while i < self.n {
            if self.keys[i] == k { return i }
            i = i + 1
        }
        return 0 - i64(1)
    }
    fn put(self: mut ref mapKV<K, V>, k: K, v: V) -> bool {
        let at = self.find(k)
        if at >= i64(0) { self.vals[at] = v  return true }
        if self.n >= self.cap { return false }
        self.keys[self.n] = k
        self.vals[self.n] = v
        self.n = self.n + i64(1)
        return true
    }
    fn keyAt(self: ref mapKV<K, V>, k: K) -> i64 { return self.find(k) }
    fn valAt(self: ref mapKV<K, V>, i: i64) -> V { return self.vals[i] }
    fn len(self: ref mapKV<K, V>) -> i64 { return self.n }
}

fn main() -> i32 {
    var m: mapKV<i64, slice<u8>> = mapKV<i64, slice<u8>>::withCap(4)
    m.put(i64(1), "one")
    println("len = ", m.len(), " val = ", m.valAt(m.keyAt(i64(1))))
    return 0
}
