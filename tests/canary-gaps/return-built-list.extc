/* ⚠️ tests/canary-gaps/ —— **已知缺口**，故意**不**并进 tests/ 套件
 *
 * PLAN #31 的**第二个形状**（比 varArray 那个严重得多）：
 * **往本地容器里 push / 造链表，然后把容器返回出去**。
 *
 * 跑法： ./build/extc --run tests/canary-gaps/return-built-list.extc
 * 现状： 编过，打印 `拿到 = 0`（正确 `20 10 0`）⇒ 静默错数据 ✗
 *
 * 为什么：`push(ref l, …)` 那一刀的家 arena = **实参 `l` 所在的那只**
 * （callHomeDepth 取 placeDepth(l) = 它所在的块，这是 ARENA.md §1.2 的规则）
 * ⇒ `new node` 分配在 **build 的函数体块**里 ⇒ `return l` 之后块被 release ⇒ 悬垂 ✗
 *
 * 注意这**不是** varArray 的问题，是 A3 "out-param 造数据" 这条路共有的：
 * 检查器没有把"被调者往容器里塞的东西住在哪只 arena"记回容器的深度 ⇒ 逃逸检查看不见 ✓
 *
 * 对照（都是对的）：
 *   · examples/escape-promotion.extc —— 在函数里**直接用 `new`** 造，`new` 进的是
 *     这个函数的"家" arena（活的）⇒ 返回没问题 ✓
 *   · examples/out-param.extc 的 listDemo —— push 造的容器**不出这个函数** ⇒ 没问题 ✓
 */
struct node { value: i64  next: ?ref node }
struct list { head: ?ref node }

fn push(l: mut ref list, v: i64) {
    var n: mut ref node = new node
    n.value = v
    n.next = l.head
    l.head = n
}

fn build() -> list {
    var l: list = { head: null }
    var i: i64 = 0
    while i < 3 { push(ref l, i * 10)  i = i + 1 }
    return l
}

fn churn() {
    var k: i32 = 0
    while k < 8 {
        var w: varArray<i64> = varArray<i64>::withCap(500)
        w.push(i64(k) * 7)
        println("逼出 option_i64 = ", w.get(0) ?? w.size())
        k = k + 1
    }
}

fn main() {
    var l: list = build()
    churn()
    var cur: ?ref node = l.head
    print("拿到 = ")
    while cur != null { print(cur.value, " ")  cur = cur.next }
    println("（应该是 20 10 0）")
    println("逼出 option_i32: ", varArray<i32>::withCap(1).get(0) ?? -1)
}
