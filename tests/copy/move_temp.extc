/* 判据：`@value` 类型从**临时量**（函数返回值）拿到的值仍是移动，不调用 `clone`：
 * 生成 C 里那一行是 `blob t = make(..)`，不是 `blob_clone(&(..))`。 */
use std::io
use std::data::buf

@value
struct blob {
    @private b: buf<i64>
    fn clone(self: ref blob) -> blob { return blob { b: self.b.clone() } }
    fn push(self: mut ref blob, v: i64) { self.b.push(v) }
    fn len(self: ref blob) -> i64 { return self.b.len() }
    fn at(self: ref blob, i: i64) -> i64 { return self.b.view()[i] }
}

fn make(n: i64) -> blob {
    var r: blob = blob { b: buf<i64>::withCap(4) }
    r.push(n)
    return r
}

fn main() -> i32 {
    var t: blob = make(5)
    t.push(6)
    io::cout << "t=" << t.len() << "/" << t.at(0) << "\n"
    return 0
}
