// 判据：长度不符必须在调用点报"期望哪个长度、实得哪个长度"
//
// `dot(v3, v2)` 里第一个实参先定出 N = 3，第二个实参因此被当作 `[3]f64` 检查，
// 诊断必须是 `expected `[3]f64`, found `[2]f64``（不是"推断不出来"）。
fn dot<const N: i64>(a: [N]f64, b: [N]f64) -> f64 {
    var s: f64 = 0.0
    for i in 0..N { s = s + a[i] * b[i] }
    return s
}

fn main() {
    var v3: [3]f64 = [1.0, 2.0, 3.0]
    var v2: [2]f64 = [4.0, 5.0]
    println(dot(v3, v2))
}
