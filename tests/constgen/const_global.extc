// 判据：模块级 `const` 的值在程序运行前就定了，所以它能当定长数组的长度
//
// 一个 `const` 有两条承诺：①它是不可变全局（顶层 `let` 已经是这样）②它的值是解析期就能读出的
// 整数字面量，因此能写进类型 `[N]T`。第二条只认整数字面量（含负号），不折表达式：
// `const K = 1 + 2` 能当值用，不能当长度（报 "is a `const`, but not an integer literal"）。
const N: i64 = 15
const M: i64 = 3
const PI: f64 = 3.14
const MIN: i64 = -7

struct grid {
    cells: [N][N]u8,
    tag: i64,
}

fn main() {
    var g: grid
    g.cells[0][0] = 1
    g.cells[N - 1][M - 1] = 2
    g.tag = MIN
    println(g.cells[0][0])
    println(g.cells[14][2])
    println(g.tag)
    println(f"{N}x{M}")
    println(PI)
    var xs: [M]f64 = [1.0, 2.0, 3.0]
    println(xs[2])
    var total: i64 = 0
    for i in 0..N { total = total + i }
    println(total)
}
