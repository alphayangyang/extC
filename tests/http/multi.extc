/* 判据：**同时维护多条 session 连接**（对象式 API ✓）。
 * 每条 session 自带请求/接收缓冲 ⇒ 调用点不再传缓冲 ✓（`new` 出来的容器可以随对象逃逸 ✓）。
 * 用法：multi <host> <port>
 * 退出码 0 = 三条都 200、body **逐字节**正确 ✓（不用"含某子串"：错位也能假绿 ✗ 踩过）。 */
use std::io
use std::http

fn main(args: slice<slice<u8>>) -> i32 {
    var host: slice<u8> = args[1]
    var port: i64 = i64(0)
    var ps: slice<u8> = args[2]
    var k: i64 = i64(0)
    while k < ps.len { port = port * i64(10) + (i64(ps[k]) - i64(48))  k = k + i64(1) }

    var a: http::session = http::session::make(host, port, i64(5000))
    var b: http::session = http::session::make(host, port, i64(5000))
    var c: http::session = http::session::make(host, port, i64(5000))
    if !a.ok() || !b.ok() || !c.ok() { return 1 }

    /* 三条**交错**发（各自的缓冲 ✓，互不干扰 ✓）*/
    var ra: http::response = a.get(host, "/small.txt", "")
    var rb: http::response = b.get(host, "/index.html", "")
    var rc: http::response = c.get(host, "/sub/index.html", "")
    a.close(); b.close(); c.close()

    if !ra.is(200) || !rb.is(200) || !rc.is(200) {
        io::cout << "状态 " << ra.status << "/" << rb.status << "/" << rc.status << "\n"
        return 2
    }
    if ra.body.len != i64(11) || ra.body != "plain text\n" { return 3 }
    if rb.body.len != i64(58) || rb.body[..i64(9)] != "<!doctype" { return 4 }
    if rc.body.len != i64(50) || rc.body[..i64(9)] != "<!doctype" { return 5 }
    var ct: slice<u8> = ra.header("Content-Type")!
    io::cout << "三条 session 同时活着 ✓ 各自 " << ra.status << "/" << rb.status << "/" << rc.status << "，body 逐字节正确（11/58/50），ct=[" << ct << "]\n"
    return 0
}
