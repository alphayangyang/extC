// 形状：并行的两种写法都要在 `-Wall -Wextra -Werror` 下编得过 ——
//   · `par` 语句：`extc_par_run(...)` 的结果没人要，不许触发 `-Wunused-value`
//   · `parallel::run(...)` 当值用：它必须真的能出现在表达式位置
// expect: 992 140 0
use std::io
use std::parallel

fn worker(id: i64, lo: i64, hi: i64, out: mut slice<i64>) -> i32 {
    var i: i64 = lo
    while i < hi { out[i - lo] = i * i  i = i + 1 }
    return 0
}

fn main() -> i32 {
    var outs: mut slice<i64> = new i64[i64(32)]
    par t in 0..i64(32) { outs[t] = t * 2 }
    var s: i64 = 0
    var i: i64 = 0
    while i < i64(32) { s = s + outs[i]  i = i + 1 }

    var buf: [8]i64
    var out: mut slice<i64> = buf[..]
    let rc: i32 = parallel::run(worker, out, i64(8), i64(2))
    var sq: i64 = buf[0] + buf[1] + buf[2] + buf[3] + buf[4] + buf[5] + buf[6] + buf[7]

    io::cout << s << " " << sq << " " << rc << "\n"
    return 0
}
