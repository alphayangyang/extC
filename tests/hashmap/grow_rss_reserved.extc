// 同一个形状，但一开始就预留到与增量版**同一个容量** ⇒ 一次重哈希都不发生（对照组的「下界」）
// 1,058,406 是「插 1e6 条、从 19 桶逐次翻倍」会到达的那个 cap（1,245,184 = 19×2^16）的装载反算：
//   withCap 走 (want×20+16)/17 ⇒ (1,058,406×20+16)/17 = 1,245,184
// 增长策略一改，run.sh 里「cap 相等」那条会当场变红 —— 那时把这两个数一起改。
// expect: n=1000000 cap=1245184
use std::io
use std::data::hashMap

fn main() -> i32 {
    var hm = hashMapI64<i32>::withCap(1058406)
    var i: i64 = 0
    while i < 1000000 {
        hm.put(i, i32(i))
        i = i + 1
    }
    io::cout << "n=" << hm.len() << " cap=" << hm.capOf() << " bytes=" << hm.bytesOf() << "\n"
    return 0
}
