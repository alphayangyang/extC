/* tests/hashmap/handle.extc —— handle 是 map 的一等货币：一次探测拿槽，之后按槽读写。
 *
 * 判据：
 *   ① `entry` 缺失时插入默认值；`at` 读到它；`setAt` 写回去 ✓
 *   ② 同一键两次 `entry` 得到同一个槽（命中只探测一次）✓
 *   ③ slotHandle 跨**插入别的键**仍然有效（值列扩容搬数据不搬身份）✓
 *   ④ 键被 `remove` 掉之后 `at` 还 `none`，而不是读到别人的值（世代检查兜住）✓
 *   ⑤ 这些方法都能在"带 slice 形参"的函数里调用（效果摘要按实例重算）✓
 *
 * expect: sum=14 n=2 same=true stale=true keep=true sixth=true
 */
use std::io
use std::data::hashMap
use std::data::dense::{slotHandle}

struct sess { n: i64  sum: i64 }

fn run(keys: slice<i64>) -> i32 {
    var m: hashMapI64<sess> = hashMapI64<sess>::withCap(8)
    var i: i64 = 0
    while i < keys.len {
        let k: i64 = keys[i]
        let h: slotHandle = m.entry(k, sess { n: 0, sum: 0 })
        var s: sess = m.at(h) ?? sess { n: 0, sum: 0 }
        s.n = s.n + 1
        s.sum = s.sum + k
        m.setAt(h, s)
        i = i + 1
    }
    let h7: slotHandle = m.entry(i64(7), sess { n: 0, sum: 0 })
    /* ②：命中时 `entry` 回同一个槽 —— 用"再 entry 一次不该覆盖成 99"证明 */
    let _again: slotHandle = m.entry(i64(7), sess { n: 99, sum: 99 })
    var same: bool = false
    if let some(s) = m.at(h7) { same = s.sum == i64(14) && s.n == 2 }

    var sum: i64 = 0
    var n: i64 = 0
    if let some(s) = m.at(h7) { sum = s.sum  n = s.n }

    /* ③：插入 200 个别的键（值池会扩容搬数据），老 handle 仍应有效 */
    var j: i64 = 100
    while j < 300 {
        m.put(i64(j), sess { n: 1, sum: j })
        j = j + 1
    }
    var keep: bool = false
    if let some(s) = m.at(h7) { keep = s.sum == i64(14) }

    /* ④：删掉键之后旧 handle 必须还 none */
    let _gone: bool = m.remove(i64(7))
    var stale: bool = true
    if let some(_s) = m.at(h7) { stale = false }

    /* ⑤：`contains` 也能在这个带 slice 形参的函数里调用 */
    let sixth: bool = m.contains(i64(299))

    io::cout << f"sum={sum} n={n} same={same} stale={stale} keep={keep} sixth={sixth}\n"
    return 0
}

fn main() -> i32 {
    var keys: mut slice<i64> = new i64[6]
    keys[0] = 7  keys[1] = 7  keys[2] = 8  keys[3] = 8  keys[4] = 8  keys[5] = 9
    return run(keys[..])
}
