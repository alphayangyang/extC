// 增量长到 1e6（多次 rebuild）· 四列都在表自己的池板块上 ⇒ 旧列当场还，不留历代副本
// 与 grow_rss_reserved.extc 同一条目数、同一最终容量（cap=2,097,152），只有"长上去"与"一开始就预留"之别
// expect: n=1000000 cap=2097152 bytes=35651584
// `bytes` = 期末这张表在自己池里占的**精确字节**（四列 + 值池）：
//   cap×8(key) + cap×1(tag) + cap×4(slot) + cap×4(bucketOfDense) + cap×4(值池) = cap×17 = 35,651,584
// 这一版长过 17 次（16 → 2,097,152）：哪一代旧列没还，这个数就大一整代 —— 倒数第二代的
// 1,048,576×17 = 17.8 MB 跑不掉 ⇒ 判据有牙，且**不依赖 RSS**（RSS 那一版判据会随"清不清零"
// 漂移：同样的代码在 HEAD 上是 63,296 vs 69,056，在不清零那版上是 63,296 vs 51,968 —— 见 DEVLOG）。
use std::io
use stl::hashMap

fn main() -> i32 {
    var hm = hashMapI64<i32>::withCap(i64(16))
    var i: i64 = 0
    while i < i64(1000000) {
        hm.put(i, i32(i))
        i = i + i64(1)
    }
    io::cout << "n=" << hm.len() << " cap=" << hm.capOf() << " bytes=" << hm.bytesOf() << "\n"
    return 0
}
