// expect: cap = 8|同槽 = true|全部找到 = true|删掉一半后仍全部找到 = true|重插 = true
/* ⭐ 碰撞判据：找出**同一个初始桶**的 5 只键（下面当场量出来），
 *   ⇒ 线性探测必须能找到每一个、删掉链条中间一个之后剩下的仍找得到（回移 + 探测链）✓
 *
 * 键不写死：桶号依赖哈希函数与 `cap`，写死一组键会在哈希改动后**静默退化成 5 格平凡的插入**
 * （2026-09-26 与 2026-11 各发生过一次）。这里 1..512 逐只键插进空表量初始桶，挑第一组同桶的 5 只，
 * `同槽` 那一行仍是量出来的，哈希哪天再改它会当场变 false。 */
use std::io
use std::data::hashMap

/* 这一只键此刻所在的桶（-1 = 不在表里）。 */
fn bucketOf(m: ref hashMapI64<i32>, k: i64) -> i64 {
    var i: i64 = 0
    while i < m.capOf() {
        if m.liveAt(i) && m.keyAt(i) == k { return i }
        i = i + 1
    }
    return -1
}

/* 空表里插一只键 ⇒ 它一定落在自己的**初始桶**上（没有探测、没有重建）。 */
fn initialSlot(k: i64) -> i64 {
    var t = hashMapI64<i32>::withCap(4)
    t.put(k, i32(1))
    return bucketOf(ref t, k)
}

fn main() -> i32 {
    var m = hashMapI64<i32>::withCap(4)
    println("cap = ", m.capOf())

    var probe: [512]i64
    var slot: [512]i64
    var cnt: i64 = 0
    var cand: i64 = 1
    while cand <= 512 {
        probe[cnt] = cand
        slot[cnt] = initialSlot(cand)
        cnt = cnt + 1
        cand = cand + 1
    }

    /* 第一组 5 只同桶的键。 */
    var keys: [5]i64
    var found: i64 = 0
    var i: i64 = 0
    while i < cnt && found == 0 {
        var j: i64 = i
        var same: i64 = 0
        while j < cnt && same < 5 {
            if slot[j] == slot[i] { keys[same] = probe[j]  same = same + 1 }
            j = j + 1
        }
        if same == 5 { found = 1 }
        i = i + 1
    }

    var same2: bool = found == 1
    i = 1
    while i < 5 {
        if initialSlot(keys[i]) != initialSlot(keys[0]) { same2 = false }
        i = i + 1
    }
    println("同槽 = ", same2)

    i = 0
    while i < 5 {
        m.put(keys[i], i32(i))
        i = i + 1
    }
    var ok: bool = true
    i = 0
    while i < 5 {
        let g = m.get(keys[i]) ?? i32(-1)
        if g != i32(i) { ok = false }
        i = i + 1
    }
    println("全部找到 = ", ok)

    m.remove(keys[2])                     /* 挖掉链条中间那个 */
    ok = true
    i = 0
    while i < 5 {
        if i != 2 {
            let g = m.get(keys[i]) ?? i32(-1)
            if g != i32(i) { ok = false }
        }
        i = i + 1
    }
    println("删掉一半后仍全部找到 = ", ok && !m.contains(keys[2]))

    let again = m.put(keys[2], i32(2))     /* 再插回去（探测链上重新占位）*/
    let g2 = m.get(keys[2]) ?? i32(-1)
    println("重插 = ", !again && g2 == i32(2))
    return 0
}
