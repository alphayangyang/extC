// `par` 放进普通函数：输出视图是 `mut slice` 形参（trampoline 按 [lo,hi) 切段）。
use std::io

fn parFill(a: mut slice<f64>) {
    par i in 0..a.len { a[i] = f64(i) * 2.0 }
}

fn main() -> i32 {
    let n: i64 = 1000
    var a: mut slice<f64> = new f64[n]
    parFill(a)
    var s: f64 = 0.0
    for v in a { s = s + v }
    io::cout << f"sum={i64(s)}\n"
    return 0
}
