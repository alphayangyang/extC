/* `persist_nodes.extc` —— `bench/oi/persist/p3834_nodes.extc` 的**最小化版**（真实语料那一档），
 * 钉的是同一个 C 洞：**清扫的静态根表看不见调用帧里的活引用**。
 *
 * 与 `hole_c.extc` 的关系：`hole_c` 是"种子直接为空"（`nroots=0`）的最小形状；这里是**真实语料**
 * 里同一个洞的另一半 —— 触发点的根表**不是空的**，只是**不完整**。
 *
 * 形状（`update` 递归建可持久化线段树）：`update` 是递归的，每个内层帧 `new pnode` 拿到的 `n`
 * 是**本帧的活引用**，但它在**父帧的局部量** `n` 里（内层返回后父帧才 `n.l = <返回值>`），
 * 而清扫触发点的根表按**词法作用域**拼：`update` 的生成物里是
 *     maybeCollect(区域, (void *[]){ z, prev }, 2)
 * —— 自己的形参 `z`/`prev` 在表里，**调用帧的 `n` 不在**。内层帧的分配点一过 1 MiB 压力线，
 * 就用这张不完整的种子扫**外层帧拥有的区域**（家 arena 一路传下来，是同一个区域）⇒ 把父帧
 * 还建着的子树当垃圾放掉 ⇒ 返回后 `prev` 已经是悬垂指针 ⇒ rc=139（ASan 下 `SEGV`）。
 *
 * 已证明与其它回收修复无关：把原文件缩到 N=50000（这里再缩 Q 到 1000）后**纯 HEAD 编译器**
 * 同样在开档下 rc=139；关档 rc=0。
 *
 * 规模选的 N=50000 有个硬理由：根数组是 `new [50001]?ref pnode` = 400008 B ⇒ 槽取整到
 * **512 KiB**（≤ 512 KiB ⇒ 普通 slab，不是超大块），所以这一条钉的是"C 洞"本身，
 * 不掺那次"槽 > 512 KiB 不 trap"的修复。
 *
 * 判据（`run-switch.sh` ①i）：
 *   · 开档（`EXTC_RECLAIM=1`）：rc=0，输出逐字如下；
 *   · 关档（`EXTC_RECLAIM=0`）：rc=0，输出**逐字一致**（回收只换运行期，不改语义）。
 * 修之前开档 rc=139 ⇒ 这条判据红。
 *
 * 原始语料的三个常量（N=Q=V=1000000）只改规模，不改结构；`in`/`nodes`/`ans` 仍逐字可比。
 */
struct pnode {
    l: ref pnode
    r: ref pnode
    sum: i32
}

let N: i64 = 50000
let Q: i64 = 1000
let V: i64 = 50000

var A: [50001]i32
var NP: i32 = 1                     /* 1 = 哨兵算 0 号节点（跟索引式版本对齐 ✓）*/

/* ---------------- 可持久化线段树 ---------------- */
fn update(z: ref pnode, prev: ref pnode, lo: i32, hi: i32, pos: i32) -> mut ref pnode {
    var n: mut ref pnode = new pnode
    NP = NP + 1
    n.l = prev.l
    n.r = prev.r
    n.sum = prev.sum + 1
    if lo < hi {
        let mid: i32 = lo + (hi - lo) / 2
        if pos <= mid {
            n.l = update(ref *z, prev.l, lo, mid, pos)
        } else {
            n.r = update(ref *z, prev.r, mid + 1, hi, pos)
        }
    }
    return n
}

fn query(u: ref pnode, v: ref pnode, lo: i32, hi: i32, k: i32) -> i32 {
    if lo == hi { return lo }
    let mid: i32 = lo + (hi - lo) / 2
    let leftCount: i32 = v.l.sum - u.l.sum
    if k <= leftCount {
        return query(u.l, v.l, lo, mid, k)
    }
    return query(u.r, v.r, mid + 1, hi, k - leftCount)
}

fn main() -> i32 {
    var rng: pcg32 = pcg32::seeded(u64(20260922))

    /* 哨兵：全零的节点，两个儿子都指向自己 ⇒ 空子树的"叶子"就是它 ✓ */
    var z: mut ref pnode = new pnode
    (*z).l = ref *z
    (*z).r = ref *z
    (*z).sum = 0

    /* 五万个"版本根"也放 arena（零值 = null ✓）；0 号是哨兵。400008 B ⇒ 槽 512 KiB（普通块）。 */
    var root: mut ref [50001]?ref pnode = new [50001]?ref pnode
    (*root)[0] = ref *z

    var i: i64 = 1
    while i <= N {
        A[i] = i32(rng.nextBounded(u64(V))) + 1
        i = i + 1
    }

    var inSum: u64 = 0
    i = 1
    while i <= N {
        inSum = inSum * 1000003 + u64(A[i])
        i = i + 1
    }

    i = 1
    while i <= N {
        (*root)[i] = update(ref *z, (*root)[i - 1]!, 1, i32(V), A[i])
        i = i + 1
    }

    var ansSum: u64 = 0
    var j: i64 = 0
    while j < Q {
        let l: i64 = 1 + i64(rng.nextBounded(u64(N)))
        let r: i64 = l + i64(rng.nextBounded(u64(N - l + 1)))
        let k: i64 = 1 + i64(rng.nextBounded(u64(r - l + 1)))
        let ans: i32 = query((*root)[l - 1]!, (*root)[r]!, 1, i32(V), i32(k))
        ansSum = ansSum * 1000009 + u64(ans)
        j = j + 1
    }

    println("in    = ", inSum)
    println("n     = ", N)
    println("q     = ", Q)
    println("nodes = ", NP)
    println("ans   = ", ansSum)
    return 0
}
