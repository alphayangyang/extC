/* 切片 B2 判据：**spawn + 驱动**端到端可跑，两种驱动形式都验 ✓
 *
 *   `while c.next() { c.value() }`  显式驱动（协议的三个名字）
 *   `for x in c { … }`              同一个协议 —— for 会改写成
 *                                   `var __extc_s = c` / `var __extc_it = __extc_s.iter()` /
 *                                   `while __extc_it.next()` / `var x = __extc_it.value()`
 *
 * 判据（tests/coro/run.sh）：生成 C、gcc 编译、真的跑，输出与退出码都要对 ✓ */
use std::io

fn counter(n: i64) -> coroutine<i64> {
    var i: i64 = 0
    while i < n {
        yield i
        i = i + 1
    }
}

fn main() -> i32 {
    var n: i64 = 0

    let a = counter(i64(3))
    while a.next() {
        io::cout << a.value() << " "
        n = n + a.value()
    }
    io::cout << "| "

    let b = counter(i64(4))
    for x in b {
        io::cout << x << " "
        n = n + x
    }
    io::cout << "\n"
    return i32(n)
}
