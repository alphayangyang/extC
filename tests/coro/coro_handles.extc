/* 判据：**协程能进容器** ⇒ 调度器才谈得上（"统一句柄"的验收项）。
 *
 * 三个 worker 的帧放进 vector，按顺序驱动到完。今天的检查器不允许
 * `coroutine<i64>` 当存储类型（B2c），所以这条现在应当是**响亮地被拒**。
 *
 * 期望：跑出 0+1+2 + 10+11+12 + 20+21+22 = 99 ⇒ 99/9 = **11** */
use stl::vector
use std::io

fn worker(n: i64, base: i64) -> coroutine<i64> {
    var i: i64 = 0
    while i < n {
        yield base + i
        i = i + 1
    }
}

fn main() -> i32 {
    var v: vector<coroutine<i64>> = vector<coroutine<i64>>::withCap(i64(3))
    v.push(worker(i64(3), i64(0)))
    v.push(worker(i64(3), i64(10)))
    v.push(worker(i64(3), i64(20)))
    var i: i64 = 0
    var sum: i64 = 0
    while i < i64(3) {
        while v[i].next() { sum = sum + v[i].value() }
        i = i + 1
    }
    return i32(sum / i64(9))
}
