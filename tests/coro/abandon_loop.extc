use std::io
use std::sys::coroutine as co

// A coroutine whose frame is a C local cannot outlive the block that declares it. The driver only
// ends the task when the step reports "done", so a loop left early would leak the task's arena,
// its place and every reservation the coroutine created -- unboundedly. The block's release point
// ends whatever is left, so the live-task count comes back to where it started.
fn mk(n: i64) -> coroutine<i64> {
    var b: mut ref [8]i64 = new [8]i64
    (*b)[0] = 7
    for i in 0..n {
        let got: i64 = (*b)[0]
        yield got
    }
    return
}

fn main() -> i32 {
    let before: i64 = co::extc_task_live()
    for i in 0..50 {
        for v in mk(4) {
            break
        }
    }
    let after: i64 = co::extc_task_live()
    io::println(f"before={before} after={after}")
    return 0
}
