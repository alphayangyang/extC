/* 判据：`global` —— 函数里的持久存储（docs/topics/GLOBAL.md）。
 *
 * 三条一起验：
 *   ① **视图跨 `yield` 合法**：`global var buf: [8]u8` 的切片挂在协程体里跨过挂起点；
 *   ② **跨调用持久**：`calls` 在两个协程里累加（1 然后 2），说明存储活过了两次函数执行；
 *   ③ **一处声明 = 一个实例**：两个协程看到的是**同一块**存储（这是 `global` 的语义，不是 bug）。
 * 期望输出（顺序确定）：
 *     t1:A      ← 挂起前打印（两个协程都在各自挂起前自增，所以看到 1 和 2）
 *     t2:B
 *     t1:B      ← **挂起之后**再读同一份视图：存储活过了挂起点 ✓
 *     t2:B      ← 而且两份视图指向**同一块**存储（worker2 写了 'B'，worker1 也读到 'B'）✓
 * 最后两行的 B 不是 bug：`global` 一处声明一个实例，别名共享正是它的语义。 */
use std::coro::scheduler as sched
use std::sys::net as net
use std::io

fn worker(s: mut ref sched::loop, fd: i64) -> coroutine<i64> {
    global var calls: i64                 /* 零初始化（C 的静态存储期本来就清零）*/
    global var buf: [8]u8
    global let tag: slice<u8> = "t"       /* 常量初始化式：字面量 */
    calls = calls + i64(1)                /* 共享实例：两个协程都在各自挂起前自增 */
    buf[0] = u8(64) + u8(calls)           /* 'A' + (calls-1) */
    let mine: i64 = calls                 /* 记下"我这一轮"的值（挂起前）*/
    let view: slice<u8> = buf[0..1]       /* **视图跨 `yield`**：指向 global ⇒ 合法（①+② 一起验）*/
    io::cout << tag << mine << ":" << view << "\n"
    yield fd                              /* 挂起 */
    io::cout << tag << mine << ":" << view << "\n"   /* 醒来再看一眼：两块存储都得还在 */
    yield i64(-1)
}

fn main() -> i32 {
    var s: sched::loop
    if !sched::init(ref s, i64(-1)) { return i32(90) }
    var tasks: sched::tasks<i64> = { rows: sched::newRows(), runq: sched::newQ(), rqHead: i64(0), freeq: sched::newQ(), acceptq: sched::newQ() }
    /* **两个 fd**：调度器的 fd 等待目前同一 fd 只支持一个等待者（tag 会被后注册的覆盖，
     * 见 SDK 备注），所以两个协程各等各的 fd。共享的是 `global`，不是 fd。 */
    var a: [2]i64
    var b: [2]i64
    if net::extc_sock_pair(a[..].data) != i64(0) { return i32(91) }
    if net::extc_sock_pair(b[..].data) != i64(0) { return i32(91) }
    var one: [1]u8
    one[0] = u8(7)
    if net::extc_sock_write(a[1], one[..].data, i64(1)) != i64(1) { return i32(92) }
    if net::extc_sock_write(b[1], one[..].data, i64(1)) != i64(1) { return i32(92) }
    tasks.add(ref s, worker(ref s, a[0]))
    tasks.add(ref s, worker(ref s, b[0]))
    var rounds: i64 = i64(0)
    while rounds < i64(20) && s.live > i64(0) {
        var pr: i64 = tasks.pump(ref s, i64(50))
        rounds = rounds + i64(1)
    }
    if s.live > i64(0) { io::cout << "STUCK\n"  return i32(93) }
    return i32(0)
}
