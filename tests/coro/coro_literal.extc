/* 判据：**字面量切片跨 `yield`** 必须合法。
 *
 * 字符串字面量住在**静态存储**里（C 的字符串字面量就是静态存储期）⇒ 与全局同寿、深度 0。
 * 从前检查器把它当"指向别人的栈"，于是 `let k: slice<u8> = "…"` 在协程里跨 `yield` 会被拒
 * （实测为此绕过两次：只能把字面量内联传进调用）。反例（**局部数组**的视图跨 `yield` 仍须被拒）
 * 由 run.sh 编译一段来验 —— 放宽一条规则时，反例比正例重要。 */
use std::coro::scheduler as sched
use std::sys::net as net
use std::io

fn worker(fd: i64, s: mut ref sched::loop) -> coroutine<i64> {
    let greeting: slice<u8> = "hello from a literal"   /* ← 从前这一行跨 yield 就被拒 */
    var r: i64 = net::extc_epoll_new()                  /* 占位，避免"未使用" */
    yield fd                                            /* 挂起一次：字面量活着跨过去 */
    io::cout << greeting << "\n"
    yield i64(-1) - r
}

fn main() -> i32 {
    var s: sched::loop
    if !sched::init(ref s, i64(-1)) { return i32(90) }
    var tasks: sched::tasks<i64> = { rows: sched::newRows(), runq: sched::newQ(), rqHead: i64(0), freeq: sched::newQ(), acceptq: sched::newQ() }
    var sp: [2]i64
    if net::extc_sock_pair(sp[..].data) != i64(0) { return i32(91) }
    var one: [1]u8
    one[0] = u8(7)
    if net::extc_sock_write(sp[1], one[..].data, i64(1)) != i64(1) { return i32(92) }
    tasks.add(ref s, worker(sp[0], ref s))
    var rounds: i64 = i64(0)
    while rounds < i64(20) && s.live > i64(0) {
        var pr: i64 = tasks.pump(ref s, i64(50))
        rounds = rounds + i64(1)
    }
    if s.live > i64(0) { io::cout << "STUCK\n"  return i32(93) }
    io::cout << "literal ok\n"
    return i32(0)
}
