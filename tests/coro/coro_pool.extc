/* 切片 C 的验收项：**体顶层持有容器（vector）、跨挂起点继续用** ✓
 * 容器的存储是它自有的 buf 预留（超过小缓冲就在堆上），不依赖任务的 place
 * ⇒ 活过每一次挂起 ✓；协程不需要 place 时帧就在调用者的栈上，不登记任务 ✓ */
use std::io
use std::data::vector

fn g(n: i64) -> coroutine<i64> {
    var v: vector<i32> = vector<i32>::withCap(n)
    var i: i64 = 0
    while i < n {
        v.push(i32(7))
        yield i64(i)
        i = i + 1
    }
    yield v.len()
}

fn main() -> i32 {
    var c = g(3)
    var n: i64 = 0
    while c.next() { n = n + c.value() }
    return i32(n)
}
