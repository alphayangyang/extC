/* **自己 fork 出 N 个 worker** 的 echo server（`std::proc::spawn` 的示范，POSIX only）。
 *
 *   build/extc -w --no-line-map -o /tmp/esf.c tests/coro/echo_server_fork.extc
 *   gcc -std=c11 -fwrapv -O2 -o /tmp/esf /tmp/esf.c && /tmp/esf
 *   printf 'hello\n' | nc 127.0.0.1 7654
 *
 * 形状（与 nginx 的 master/worker 同一件事，只是没有 master）：父进程先 fork 出 7 个子进程，
 * 然后**自己也当 worker** —— 一共 8 个进程，每个钉一个核，每个都 `extc_tcp_listen_shared`
 * （bind 之前设 SO_REUSEPORT），内核按流哈希把新连接分给它们。
 *
 * 两条纪律，写错了很难查：
 *   · 子进程**当场 exit**（`proc::exit(serve(i))`）：fork 之后两边都从同一行继续跑，子进程要是
 *     `return` 回去，循环会再 fork 一次、再 fork 一次 —— fork 炸弹。
 *   · 每个 worker **自己钉核**（`proc::pin`）：不钉的话调度器会把你放到小核上，8 个 P 核能给的
 *     7.3x 会掉到 ~10x/16 核那种斜率。
 *
 * 实测（2026-09-28 · 8 个 P 核 · loopback · 256 连接 · ping-pong，同一个二进制、不用任何外部
 * 启动器）：1 个 worker 327,556 req/s ⇒ 8 个 worker **1,320,297 req/s（4.03x）**，RSS 15 MB，
 * 服务端 CPU 7.6 核。同期 Go 1.26 八个 goroutine 8 线程 304,764 req/s（0.93x，几乎不动）。
 *
 * 想要"崩了自动重启"就用启动器版本：`tools/extc-workers.sh 8 -- /tmp/esf`（fail-fast + 重启策略）。
 *
 * 固定端口 7654（SO_REUSEADDR 已开，见运行期）；每条连接一个协程、流式回显（部分写补齐）、
 * 对端半关就地收尾并 close。不注册进任何套件：它会一直服务到被 Ctrl-C。 */
use std::coro::scheduler as sched
use std::sys::io
use std::sys::net
use std::proc

fn conn(fd: i64) -> coroutine<i64> {
    /* **惰性缓冲**：读缓冲的尺寸事先不知道（对端可能一个字都不发），所以 1 KB 起步，某次读**读满**
     * 了才翻倍（上限 64 KB）。实测动机：急切分配 16 KB 时，1000 条**一个字节都没发**的连接要占
     * 16.4 MB（每条约 16.8 KB，其中 16 KB 就是这个缓冲）；惰性之后每条约 1.8 KB。
     * 旧块留在帧 arena 里（协程结束才回收）⇒ 峰值约为最终容量的两倍，这是标准的倍增代价。 */
    var cap: i64 = i64(1024)
    var buf: mut slice<u8> = new u8[1024]
    var full: bool = false                    /* 上一轮是否读满 ⇒ 该长了 */
    var open: bool = true
    while open {
        var ready: i64 = yield fd
        if full {
            let ncap: i64 = cap * i64(2)
            if ncap <= i64(65536) {
                buf = new u8[ncap]            /* 上一轮的内容已经回写完了 ⇒ 不必拷贝 */
                cap = ncap
            }
            full = false
        }
        var n: i64 = net::extc_sock_read(fd, buf.data, cap)
        if n > i64(0) {
            if n == cap { full = true }
            var off: i64 = i64(0)
            while off < n {
                var w: i64 = net::extc_sock_write_from(fd, buf.data, off, n - off)
                if w > i64(0) { off = off + w }
            }
        } else if n == i64(0) {
            open = false
        }
    }
    var closed: i32 = io::close(i32(fd))
    if closed != i32(0) { closed = i32(0) }
    yield i64(-1)
}

/* 一个 worker：钉核、监听（共享端口）、跑到被 Ctrl-C。 */
fn serve(core: i64) -> i32 {
    if proc::pin(core) != i32(0) { return i32(5) }
    var srv: i64 = net::extc_tcp_listen_shared(i64(7654), i64(1024))
    if srv < i64(0) { return i32(1) }
    var s: sched::loop
    if !sched::init(ref s, srv) { return i32(2) }
    var tasks: sched::tasks<i64> = { rows: sched::newRows(), runq: sched::newQ(), rqHead: i64(0), freeq: sched::newQ(), acceptq: sched::newQ() }
    while true {
        var fd: i64 = tasks.pump(ref s, i64(50))
        if fd >= i64(0) {
            if net::extc_sock_nodelay(fd) != i64(0) { return i32(4) }
            if !tasks.add(ref s, conn(fd)) { return i32(3) }
        }
    }
    return i32(0)
}

fn main() -> i32 {
    let WORKERS: i64 = 8
    var i: i64 = i64(1)
    while i < WORKERS {
        let pid: i32 = proc::spawn()
        if pid == i32(0) { proc::exit(serve(i)) }   /* 子进程：**当场 exit**，绝不回到循环里 */
        if pid < i32(0) { return i32(6) }
        i = i + i64(1)
    }
    return serve(i64(0))                            /* 父进程也是 worker，钉核 0 */
}
