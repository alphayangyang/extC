// expect: erase=ok
// 指针的**抹除方向**（C-ABI.md §9.10 第 ① 块）：`ref T` / `mut ref T` / `?ref T` 可以交给
// `ref void` / `?ref void` 参数 —— C 的 `T *` → `void *`。
//
// 为什么它不丢东西：pointee 类型不是权限。一个 `ref void` 能做的事**严格更少**（`*p`、`p[i]`、
// `p.field` 三条都被拒），所以这只是一个能力收窄。反方向（`ref void` → `ref T`）永远不发生；
// 知道真实类型的**声明**是唯一的回路。
//
// 这一格是那三个 mmap 家族原语要的：它们的参数在 C 里就是 `void *`。
use std::io

extern!("libc") fn mmap(a: ?ref void, n: u64, pr: i32, fl: i32, fd: i32, off: i64) -> ?ref void
    effects Addr=0 Cont=0
extern!("libc") fn mprotect(p: ref void, n: u64, pr: i32) -> i32
    effects Addr=0 Cont=0
extern!("libc") fn munmap(p: ref void, n: u64) -> i32
    effects Addr=0 Cont=0

/* 收 `ref void` 的 extC 函数：`ref u8`（只读）、`mut ref i64`（可写）、`ref void` 三种来源都能进。 */
fn anyOf(p: ref void) -> i64 { return i64(1) }

fn main() -> i32 {
    /* PROT_NONE 先保留，再显式给 RW（commit），最后收掉 —— 第 ③ 块那块板的三个动作。 */
    var p: ?ref void = mmap(null, u64(4096), 0, 34, -1, 0)
    if p == null {
        io::cout << "mmap=fail\n"
        return 1
    }
    if mprotect(p, u64(4096), 3) != 0 {
        io::cout << "mprotect=fail\n"
        return 1
    }

    /* 抹除方向：`ref T` / `mut ref T` 都能交给一个 `ref void` 参数。用 extC 函数演示，
     * 因为 `mprotect` 要**页对齐**的地址，栈上的数组不行（实测：返回 EINVAL）。 */
    var a: [4]u8 = [1, 2, 3, 4]
    var s: slice<u8> = a[..]
    var x: i64 = 5
    if anyOf(s.data) + anyOf(ref x) + anyOf(p) != i64(3) {
        io::cout << "erase=fail\n"
        return 1
    }

    if munmap(p, u64(4096)) != 0 {
        io::cout << "munmap=fail\n"
        return 1
    }
    io::cout << "erase=ok\n"
    return 0
}
