// expect: view-in-local=ok global-view=ok allocptr=ok
// `effects Ret=0`（C-ABI.md §9.15）：**stdlib 替用户签的那一条事实** ——
// "我返回的视图不指向调用方的任何帧"。板的四个出口签了它一次，于是用户可以：
//
//     var v: mut slice<u8> = pl.alloc(n)!      // 板内视图**存进局部**
//     c.func(v.data)                           // 交给一个**没签字**的 C 函数（最坏情况）
//
// —— 一个字都不用写。进来之前这是被拒的（"may be kept by C forever, but it points into this
// frame (depth 1)"），因为视图绑定的深度取的是"槽"，而槽在帧里。
use std::io
use std::dl
use std::heap

/* 全局内存：它的视图同样"不在任何帧里"，所以也进同一条判据（不需要签字）。 */
var mem: [64]u8

fn main() -> i32 {
    var h: ?ref void = dl::open("libcairo.so.2")!     /* 借一个真实符号当"未签字的 C 函数" */
    var raw: ?ref void = dl::sym(h, "cairo_version_string")
    if raw == null { return 1 }
    var f: fn(ref u8) -> i64 = fn(ref u8) -> i64(raw) /* 裸转换 ⇒ 没有 effects ⇒ 最坏情况 */
    var pl: heap::plate = heap::plate::open(heap::DEFAULT_RESERVE)!

    var v: mut slice<u8> = pl.alloc(u64(8))!          /* 板内视图，存局部 */
    var g: slice<u8> = mem[..]                        /* 全局视图，存局部 */
    var p: ?ref u8 = pl.allocPtr(u64(8))              /* 裸指针出口 */
    if p == null { return 1 }

    var a: i64 = f(v.data) + f(g.data) + f(p)
    io::cout << "view-in-local=ok global-view=ok allocptr=ok\n"
    pl.close()
    dl::close(h)
    return i32(a - a)
}
