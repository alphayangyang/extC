// object safety ③：返回 `Self` 的方法不能经 `dyn` 派发（静态调用仍然合法）
// expect: returns `Self` and cannot be dispatched
trait Dup { fn dup(self: ref Self) -> Self }
struct box { v: i64 }
impl Dup for box { fn dup(self: ref box) -> box { return *self } }
fn main() -> i32 {
    let b = box { v: i64(1) }
    let c = dyn Dup(b).dup()          /* 编译期就该被拒 */
    return 0
}
