/* 反例：`dyn T(x)` 直接写在循环体里交给容器 —— 池诞生在循环体这一层，块退出即归还，
   句柄随后陈旧。诊断是运行期 trap（不是静默错值），提示"stale `dyn` value"。 */
use std::io
trait Tag { fn tag(self: ref Self) -> i64 }
struct box { v: i64 }
impl Tag for box { fn tag(self: ref box) -> i64 { return self.v } }

fn main() -> i32 {
    var xs: varArray<dyn Tag> = varArray<dyn Tag>::withCap(4)
    var i: i64 = 1
    while i <= 3 {
        var b: box = box { v: i }
        xs.push(dyn Tag(b))
        i = i + 1
    }
    io::cout << f"tag={(xs.get(0)!).tag()}\n"
    return 0
}
