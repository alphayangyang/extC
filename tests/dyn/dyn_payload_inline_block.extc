/* `dyn` payload 的池在**写下这个值的地方**诞生：把 `dyn T(x)` 直接写在循环体/内层块里再交给
   容器，池随块退出被归还，句柄就陈旧了。正确写法是先赋给外层声明的变量（赋值会提升池的
   层级），再把变量交出去。这里两条路都要有：正例走正确写法，反例钉住"直接写在块里会 trap"。 */
use std::io
trait Tag { fn tag(self: ref Self) -> i64 }
struct box { v: i64 }
impl Tag for box { fn tag(self: ref box) -> i64 { return self.v } }

fn main() -> i32 {
    var xs: varArray<dyn Tag> = varArray<dyn Tag>::withCap(4)
    var slot: dyn Tag = dyn Tag(box { v: 0 })
    var i: i64 = 1
    while i <= 3 {
        var b: box = box { v: i }
        slot = dyn Tag(b)          /* 赋给外层变量：池提升到这一帧 */
        xs.push(slot)
        i = i + 1
    }
    var sum: i64 = 0
    var j: i64 = 0
    while j < i64(xs.size()) {
        sum = sum + (xs.get(j)!).tag()
        j = j + 1
    }
    io::cout << f"inline-sum={sum}\n"
    return 0
}
