// expect: 不是终端 ✓|raw 真的切过去了|还原后逐字节相同|raw 开成功
/* ⭐ **IO-2 ③：termios raw mode**（BOOTSTRAP §4.3：不包 ncurses，只要"读一个字节 + 开关 raw"）。
 *
 * 判据四条（**在 PTY 上全部都要**）：
 *   ① 不是终端时（管道 / 文件 / CI）⇒ `failure(notATerminal)` 带位置，不 trap ✓
 *   ② `raw()` 之后设置**真的变了**（不然"切过去了"是空话）✓
 *   ③ `close()` 之后设置与最初**逐字节相同** —— 这是这条资源最要紧的属性：
 *      不还原，用户回到的 shell 连输入都不回显 ✗✗
 *   ④ `close()` 幂等（第二次是 no-op）✓
 *
 * ⚠️ 这个用例**曾经是假绿**：它只检查 `close()` 返回 success，而当时的实现把
 *    `cfmakeraw` 作用在**同一个缓冲**上 ⇒ 还原回去的其实是 raw 设置 ✗ 现在比字节了 ✓
 * ⚠️ 判据③能这么比，是因为三个缓冲都是**零值起步**（语言保证），`tcgetattr` 只写它
 *    真正管理的字段 ⇒ 填充字节不会随机化，逐字节比较才有意义 ✓
 * ⚠️ 这里直接用 `std::sys::term`（特权层）读设置：**判据需要它**，用户代码不该这么做 ✓ */
use std::io
use std::term
use std::sys::term as sys

/* 两个不透明缓冲逐字节相同？（布局不归 extC 管，所以只比字节） */
fn same(a: slice<u8>, b: slice<u8>) -> bool {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if a[i] != b[i] { return false }
        i = i + i64(1)
    }
    return true
}

fn run() -> result<unit, io::ioError> {
    var before: [128]u8
    if sys::tcgetattr(io::STDIN_FD, before[0..128].data) < i32(0) {
        return failure(io::ioError.notATerminal(io::STDIN_FD))
    }

    var t = term::rawTerminal(io::STDIN_FD)?
    println("raw 开成功")

    /* ② 真的切过去了 */
    var during: [128]u8
    if sys::tcgetattr(io::STDIN_FD, during[0..128].data) < i32(0) {
        return failure(io::ioError.notATerminal(io::STDIN_FD))
    }
    if same(before[0..128], during[0..128]) {
        println("raw 没生效 ✗（设置没变）")
        return failure(io::ioError.notATerminal(io::STDIN_FD))
    }
    println("raw 真的切过去了")

    t.close()?

    /* ③ 还原：逐字节与最初相同 */
    var after: [128]u8
    if sys::tcgetattr(io::STDIN_FD, after[0..128].data) < i32(0) {
        return failure(io::ioError.notATerminal(io::STDIN_FD))
    }
    if !same(before[0..128], after[0..128]) {
        println("还原不完全 ✗（与最初不同）")
        return failure(io::ioError.notATerminal(io::STDIN_FD))
    }
    println("还原后逐字节相同")

    /* ④ 幂等：再关一次仍是成功（且不再 tcsetattr） */
    t.close()?
    return success(unit {})
}

fn main() -> i32 {
    match run() {
        success(u) => { return 0 }
        failure(e) => {
            match e {
                /* 非 tty 是**正常情况**（CI 里就是），所以它不算失败：报一声就退 0 ✓ */
                notATerminal(code) => { println("不是终端 ✓ (fd = ", code, ")"); return 0 }
                readFailed(code)   => { println("意外：readFailed(", code, ")"); return 1 }
                writeFailed(code)  => { println("意外：writeFailed(", code, ")"); return 1 }
                lineTooLong(n)     => { println("意外：lineTooLong(", n, ")"); return 1 }
                closed(code)       => { println("意外：closed(", code, ")"); return 1 }
                destFull(n)        => { println("意外：destFull(", n, ")"); return 1 }
            }
        }
    }
}
