// expect: 不是终端 ✓|raw 开成功|已还原
/* ⭐ **IO-2 ③：termios raw mode**（按 BOOTSTRAP §4.3：不包 ncurses，只要"读一个字节 + 开关 raw"）。
 *
 * 判据两条，**两条都要**：
 *   ① 不是终端时（管道 / 文件 / CI）⇒ `failure(notATerminal)` **带位置**，不 trap ✓
 *      —— 这是"终端"最容易骗人的地方：`tcgetattr` 在非 tty 上返回 -1，不检查就会
 *         静默继续，之后读键盘读到的是空 ✗
 *   ② 是终端时（`run.sh` 用 `script` 起一个 PTY 跑）⇒ raw 开得起来，`close()` 能把终端
 *      **还原** ✓ —— 还原是这条资源最要紧的属性：不还原，用户回到的 shell 连输入都不回显 ✗✗
 *         （所以 `terminal` 声明了 `close` ⇒ 忘了关会被编译器点名，定案 79 那条协议 ✓）
 *
 * ⚠️ 形状照 `tests/io/main.extc`：错误处理写在 `run()` 里（`?` 只在返回 `result` 的函数里
 *    能用 ✓），`main` 只负责把失败说出来并把退出码定下来 ✓ */
use std::io
use std::term

fn run() -> result<unit, io::ioError> {
    var t = term::rawTerminal(io::STDIN_FD)?
    println("raw 开成功")
    t.close()?
    println("已还原")
    return success(unit {})
}

fn main() -> i32 {
    match run() {
        success(u) => { return 0 }
        failure(e) => {
            match e {
                /* 非 tty 是**正常情况**（CI 里就是），所以它不算失败：报一声就退 0 ✓ */
                notATerminal(code) => { println("不是终端 ✓ (fd = ", code, ")"); return 0 }
                readFailed(code)   => { println("意外：readFailed(", code, ")"); return 1 }
                writeFailed(code)  => { println("意外：writeFailed(", code, ")"); return 1 }
                lineTooLong(n)     => { println("意外：lineTooLong(", n, ")"); return 1 }
                closed(code)       => { println("意外：closed(", code, ")"); return 1 }
                destFull(n)        => { println("意外：destFull(", n, ")"); return 1 }
            }
        }
    }
}
