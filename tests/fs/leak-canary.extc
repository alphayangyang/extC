// expect: fd 漂了（这个用例**必须失败**）
/* ⭐ **判据的反面**（canary）：同一段程序**不调 `ownFd`** ⇒ 上一轮的 fd 没关 ⇒
 * 内核一直往后发新号 ⇒ 第一轮之后就漂 ✗
 *
 * 这个用例**必须失败**（退出码 1，消息含 `fd 漂了`）——
 * 它证明 `fd-constant.extc` 那条判据**有牙**：机制坏掉时它一定会响 ✓
 * ⚠️ 没有它，"fd 恒定"也可能只是"程序没跑到"这种假绿 ✗ */
extern!("libc") fn open(path: ref u8, flags: i32, mode: i32) -> i32
    effects Addr=0 Cont=0

fn openRead(p: slice<u8>) -> i32 { return open(p.data, i32(0), i32(0)) }

fn main() -> i32 {
    var first: i32 = i32(-1)
    var i: i64 = 0
    while i < 1000 {
        {
            let fd0 = openRead("tests/fs/data.txt")
            if fd0 < i32(0) { println("open 失败"); return 1 }
            let leaked = fd0                 /* ← 故意不 ownFd：泄漏 */
            if i == 0 { first = leaked }
            if leaked != first { println("fd 漂了 = ", leaked, " 期望 ", first); return 1 }
        }
        i = i + 1
    }
    println("不该看到这一行")
    return 0
}
