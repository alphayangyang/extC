// expect: fd 漂了（这个用例**必须失败**）
/* ⭐ **判据的反面**（canary）：同一段程序**不 close** ⇒ 上一轮的 fd 没关 ⇒
 * 内核一直往后发新号 ⇒ 第一轮之后就漂 ✗
 *
 * 它证明 `fd-constant.extc` 那条判据**有牙**：机制坏掉时它一定会响 ✓
 * ⚠️ 没有它，"fd 恒定"也可能只是"程序没跑到"这种假绿 ✗
 *
 * ⚠️ 句柄**交给了别的函数**（`touch(ref f)`）⇒ 编译期的
 * "opened and never closed" 检查**按设计保持沉默**（别人可能关它，证明不了泄漏）
 * ⇒ 这一条只能靠运行时判据抓 ✓ 这个用例同时钉住两件事：
 *    ① 漂移判据会响；② 检查的边界在哪（不是万能的）✓ */
use std::fs

/* 只读一眼句柄，**不关** —— 泄漏就发生在这里 */
fn touch(f: mut ref fs::ofstream) -> i32 { return f.fd }

fn main() -> i32 {
    var first: i32 = i32(-1)
    var i: i64 = 0
    while i < 1000 {
        {
            var f = fs::openWrite("build/fs-canary.out")!
            let fd0 = touch(ref f)              /* ← 交给别人：检查沉默，fd 没关 */
            if i == 0 { first = fd0 }
            if fd0 != first { println("fd 漂了 = ", fd0, " 期望 ", first); return 1 }
        }
        i = i + 1
    }
    println("不该看到这一行")
    return 0
}
