/* 反例：`ownFd(..)` 在生成的 C 里把实参写了两次 ⇒ 实参必须是"求值两次等于一次"的
 * 表达式。传一个调用（或任何有副作用的表达式）必须**编译期**被挡，并告诉他拆两行 ✓ */
extern!("libc") fn open(path: ref u8, flags: i32, mode: i32) -> i32
    effects Addr=0 Cont=0
fn openRead(p: slice<u8>) -> i32 { return open(p.data, i32(0), i32(0)) }
fn main() -> i32 {
    ownFd(openRead("tests/fs/data.txt"))
    return 0
}
// expect-error: ownFd needs a plain value
