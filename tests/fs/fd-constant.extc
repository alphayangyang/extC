// expect: fd 恒定 = 3|号可复用
/* ⭐ 判据（定案 79）：**文件是程序的事** —— 循环里就地 open、就地 close。
 *
 * 判据取的是"fd 号恒定"：上一轮没关，内核会一直往后发新号 ⇒ 第一次之后就漂 ✗
 * （而且到 1024 就 EMFILE）。所以"号不变"等价于"真的关了"，
 * 不需要去数 /proc/self/fd ✓
 *
 * ⚠️ 用**用户层**的 `std::fs` 写，不再碰裸原语：这就是用户将来写的样子 ✓ */
use std::fs

fn main() -> i32 {
    var first: i32 = i32(-1)
    var i: i64 = 0
    while i < 1000 {
        {
            var f = fs::openWrite("build/fs-fd.out")!   /* 截断，每轮重写 */
            let fd0 = f.fd
            if i == 0 { first = fd0 }
            if fd0 != first { println("fd 漂了 = ", fd0, " 期望 ", first); return 1 }
            f.close()!                                  /* ⭐ 提交点 */
        }
        i = i + 1
    }
    println("fd 恒定 = ", first)

    /* 关掉之后号立刻能被复用 ⇒ 进一步证明"真的关了" ✓ */
    var again: i32 = i32(-1)
    {
        var g = fs::openRead("tests/fs/data.txt")!
        again = g.fd
        g.close()!
    }
    if again != first { println("复用失败 = ", again); return 1 }
    println("号可复用")
    return 0
}
