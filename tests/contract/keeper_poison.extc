// expect: contract=falsified
// 契约验证 · 反例（毒化路径，不崩）：同一个食言库，调用后把内存填成哨兵 0xAA。
// 库下次读到的不是原来那个 42 ⇒ 契约被证伪，而且是一条可断言的返回值（rc=0 + 标记）。
// 有些场合不能让它崩（比如 CI 里要收集全部结论），这条就是为那种场合准备的。
use std::io
use std::dl
use std::heap

struct api { sumKeep: fn(?ref u8, i64) -> i64 effects Addr=0 Cont=0
             readLater: fn() -> i64 }

fn main() -> i32 {
    var h: ?ref void = dl::open("build/contract-keeper.so")!
    var a: api = api { sumKeep: fn(?ref u8, i64) -> i64(dl::sym(h, "sum_keep")!),
                       readLater: fn() -> i64(dl::sym(h, "read_later")!) }
    var pl: heap::plate = heap::plate::open(heap::DEFAULT_RESERVE)!
    var v: mut slice<u8> = pl.alloc(u64(4096))!
    v[0] = u8(42)
    let s: i64 = a.sumKeep(v.data, v.len)
    if !pl.poison(v.data, u64(4096), u8(170)) {
        io::cout << "contract=setup-failed\n"
        return 1
    }
    let r: i64 = a.readLater()
    pl.close()
    dl::close(h)
    if r == i64(42) {
        io::cout << "contract=unfalsified sum=" << s << "\n"
        return 1
    }
    io::cout << "contract=falsified poison=" << r << "\n"
    return 0
}
