// `<<` 收所有比 `i64` 窄的整数与 f32：位宽窄的无损加宽，不用在调用点写 cast。
// expect: 65 7 9 -3 1.5
use std::io

fn main() -> i32 {
    let a: u8 = u8(65)
    let b: u16 = u16(7)
    let c: u32 = u32(9)
    let d: i8 = i8(-3)
    let e: f32 = f32(1.5)
    io::cout << a << " " << b << " " << c << " " << d << " " << e << "\n"
    return 0
}
