// `u64` 有自己的打印路径：加宽到 `i64` 会丢上界（`2^64-1` 变负数）。
// expect: 0 9 10 99 100 18446744073709551615
use std::io

fn main() -> i32 {
    let big: u64 = u64(9223372036854775807) + u64(9223372036854775807) + u64(1)
    io::cout << u64(0) << " " << u64(9) << " " << u64(10) << " " << u64(99) << " " << u64(100) << " " << big << "\n"
    return 0
}
