// 多名字声明（一）：一条声明 = 一个共享标注 + N 个值，按名字顺序一一对应。
// `var c, d: i32` 不写值 ⇒ 每个名字各自零初始化（跟单名字的零初始化是同一条规矩）。
// expect: 1 2 0 0|let 3 4|5.5 2.5
use std::io

fn main() -> i32 {
    var a, b: i32 = 1, 2
    var c, d: i32
    let e, f: i32 = 3, 4
    var g, h: f64 = 5.5, 2.5

    io::cout << a << " " << b << " " << c << " " << d << "\n"
    io::cout << "let " << e << " " << f << "\n"
    io::cout << g << " " << h << "\n"
    return 0
}
