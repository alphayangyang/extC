// 多名字声明（四）：类型标注是逐名字的。
// ① 什么都不写 ⇒ 每个名字从自己的值各自推断；② 只写在最后一个名字后面 ⇒ 统一所有没写标注的名字；
// ③ 每个名字自带标注 ⇒ 各是各的；④ 混写 ⇒ 自带的优先，末尾的标注填给前面没写的名字。
// 类型没有被打印出来，而是由「编得过」钉住：needI32 / needI64 / needF64 的形参不收别的类型
// （f64 → i32 是收窄，编译期就挡住），再借整数除法区分 f64 与 i32（1 / 2 是 0，1.0 / 2 是 0.5）。
// expect: 1 2.5|0.5 1.5|3 4|4 5.5|2 3|0 0
use std::io

fn needI32(x: i32) -> i32 { return x }
fn needI64(x: i64) -> i64 { return x }
fn needF64(x: f64) -> f64 { return x }

fn main() -> i32 {
    var a, b = 1, 2.5                     // ① a 推断成 i32，b 推断成 f64
    io::cout << needI32(a) << " " << needF64(b) << "\n"

    var c, d: f64 = 1, 3                  // ② 末尾一个标注管两个名字 ⇒ 都是 f64
    io::cout << c / 2 << " " << d / 2 << "\n"   // 0.5 1.5；i32 的话是 0 1

    var e: i32, f: i64 = 2, 3             // ③ 每个名字自带标注
    io::cout << needI32(e) + 1 << " " << needI64(f) + 1 << "\n"

    var g: i32, h = 4, 5.5                // ④ 混写：g 用自带标注，h 自己推断成 f64
    io::cout << needI32(g) << " " << needF64(h) << "\n"

    var i, j: i64 = 2, 3                  // 末尾标注填给前面没写标注的名字
    io::cout << needI64(i) << " " << needI64(j) << "\n"

    var m: i32, n: f64                    // 零初始化的名字照样可以各写各的标注
    io::cout << m << " " << n << "\n"
    return 0
}
