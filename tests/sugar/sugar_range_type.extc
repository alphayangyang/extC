// 区间循环的循环变量按上界放宽（检查器侧，解析期脱糖不变）。
// 一：`for i in 0..n`（n: i64）里 i 是 i64 —— `i * i` 到 46342 也不按 i32 回绕。
// 二：`hi` 装不下 `lo` 时不动 —— `for i in 2147483640..2147483647` 里 i 仍是 i32，
//     所以 `i + 2147483647` 照旧按 i32 回绕（最后一轮 i=2147483646，和为 -3）。
// expect: 2147580964|-3
use std::io

fn main() -> i32 {
    var n: i64 = 100000
    var s: i64 = 0
    for i in 0..n {
        if i > 46341 { s = i * i; break }
    }
    io::cout << s << "\n"

    var t: i64 = 0
    for i in 2147483640..2147483647 {
        t = i + 2147483647
    }
    io::cout << t << "\n"
    return 0
}
