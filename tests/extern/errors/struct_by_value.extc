/* 反例：结构体**按值**过界仍然不开 ✗（C-ABI.md §9 第 2 步只放开了**指针**）
 *
 * 理由与指针那一格不同：指针就是机器字，布局问题为零；而按值传结构体要**两边布局一致**，
 * 不一致是**静默错**（C 按错的偏移读写，不 trap 也不报错）。那一格要单独定"冻结布局"，
 * 今天先挡住。 */
struct point { x: i64  y: i64 }

extern!("libc") fn bad(p: point) -> i64

fn main() -> i32 {
    var pt: point = point { x: 1, y: 2 }
    return i32(bad(pt))
}
