/* 反例：`ref void` 是 C 的 `void *` —— 一个**看不进去**的句柄 ⇒ `*p` 编译期挡住 ✗
 *
 * 边界放行 `ref void`（`mmap` 那种不透明句柄），这一条是那笔交易的另一半：没有元素类型就没有
 * 大小，读不了。C 也会拒绝，但它拒绝在**生成物**里，错误指向一行作者没写过的代码。 */
extern!("libc") fn extc_probe_mmap(addr: ?ref void, len: u64, prot: i32, flags: i32, fd: i32, off: i64) -> ref void
    effects Addr=0 Cont=0

fn main() -> i32 {
    var p: ref void = extc_probe_mmap(null, 4096, 3, 34, -1, 0)
    var q: i64 = *p
    return i32(q)
}
