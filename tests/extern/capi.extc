/* tests/extern/capi.extc —— 跨边界**指针**（C-ABI.md §9.6 第 2 步：作者拍板"放开"）用的 libc 声明
 *
 * 三个形状各一：指向**声明类型**的指针（C 写进 extC 的结构体）· `void *` 进出一趟 ·
 * `?ref void`（C 的"可空句柄"，也是 `mmap` 的地址参数）。
 *
 * 三条都签了 `effects Addr=0 Cont=0`：C 不留下指针，也不从我们内存里读出指针留着。签字是
 * **作者**的承诺 —— 没签字的声明按最坏算，把帧内地址交给它就是编译错误（反例见 errors/）。 */
struct timeval {
    tv_sec: i64
    tv_usec: i64
}

/* `int gettimeofday(struct timeval *tv, void *tz)`：测试里 `tz` 传 null。
 * `<sys/time.h>` 没有被前言 include ⇒ 我们自己的声明不与它冲突。 */
extern!("libc") fn gettimeofday(tv: mut ref timeval, tz: ?ref void) -> i32
    effects Addr=0 Cont=0

/* `void *mmap(void *addr, size_t length, int prot, int flags, int fd, off_t offset)`。
 * 这是"不透明句柄"的那一格：extC 侧**没有任何办法**看进去（`*p` 被编译期挡住），只能传回来。 */
extern!("libc") fn mmap(addr: ?ref void, len: u64, prot: i32, flags: i32, fd: i32, off: i64) -> ref void
    effects Addr=0 Cont=0
extern!("libc") fn munmap(p: ref void, len: u64) -> i32
    effects Addr=0 Cont=0
