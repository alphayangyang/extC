/* 定案 65 步骤③ 的**内存验收**：运行时长度 + 翻倍增长 ⇒ 上界 ≤ 2×最大长度 ✓
 * 每轮都要求 1MB，但存储只有一块（第一次 1MB，之后 cap 够 ⇒ 复用）✓
 * ⇒ 在 `ulimit -v 150000` 下必须跑完（若每轮一块就是 300MB ⇒ out of arena memory ✗）*/
fn main() {
    var i: i32 = 0
    while i < 300 {
        @overwrite var buf = new u8[250000]      /* 1MB，长度"运行时"给（i32 → i64 ✓）*/
        buf[0] = u8(1)
        i = i + 1
    }
    println("跑完了（300 轮 × 1MB 运行时长度缓冲）")
}
