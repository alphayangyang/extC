// `f().x = v`：字段访问的 base 是**调用**，调用不是 place ⇒ extC 必须在编译期自己拒绝，
// 不许漏到 gcc（用户看不见生成的 C）。
//
// 判据先行（2026-10-09 红）：检查器的可写性检查只看顶层 kind（EX_FIELD）就放行，
// 生成物最后被 gcc 拒绝：`error: lvalue required as left operand of assignment`。
// expect: not a place
struct s {
    x: i64
}

fn mk() -> s {
    return s { x: 1 }
}

fn main() -> i32 {
    mk().x = i64(9)
    return 0
}
