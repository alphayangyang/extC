// 回归：`varArray<T>`/定长数组是**容器**，不是视图 —— 传给 `slice<T>` 参数要显式借出。
// 悄悄替用户造一个视图会绕过借出视图的生命周期检查，所以这里报错并指出该写什么。
// expect: lend a read-only view explicitly
use std::io
fn total(v: slice<i64>) -> i64 {
    return i64(0)
}
fn main() -> i32 {
    var va: varArray<i64> = varArray<i64>::withCap(i64(2))
    io::cout << f"t={total(va)}\n"
    return 0
}
