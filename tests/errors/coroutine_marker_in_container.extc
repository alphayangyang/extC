/* 同类规则，藏在容器类型参数里也要拒：`vector<coroutine<i64>>` 会编译成"一堆标记"，
 * 装进去的东西谁也驱动不了 —— 能过但没意义，比报错更危险。
 *
 * 检测是**递归**的（`typeContainsProto`，形状照 `typeContainsRef`）：直接写、放进泛型实参、
 * 放进视图/数组/字段，都会被抓到。 */
use stl::vector

fn main() -> i32 {
    var v: vector<coroutine<i64>> = vector<coroutine<i64>>::new()
    return 0
}
