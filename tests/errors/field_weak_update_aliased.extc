/* 档2（ARENA-FORMAL §7.4）的**另一半**：`h` **被取过地址** ⇒ 只能弱更新 ⇒ 必须拒绝 ✓
 *
 * 为什么不能强更新：`q` 可能指 h，也可能指别处（这里是 `ref h`，但分析不该靠"猜"）。
 * 一旦别名写的是**别处**，`q.p = null` 就救不了 `h.p` ⇒ 覆盖深度会漏掉危险 ✗
 * ⇒ 取过地址 ⇒ 保守（弱更新）✓ 用户想通，就把别名去掉（见 examples/field-strong-update.extc）✓
 */
struct holder { p: ?ref i32 }

fn build() -> holder {
    var x: i32 = 5
    var h: holder = { p: ref x }
    var q: mut ref holder = ref h     // ← 取地址（别名存在）
    q.p = null                        // 分析不知道 *q 是不是 h ⇒ 弱更新
    return h                          // ⇒ 拒绝 ✓
}

fn main() {
    var h: holder = build()
    println(h.p == null, varArray<i32>::withCap(1).get(0) ?? -1)
}
