struct tag {
    id: i32
}

struct wrapper<T> {
    value: T

    fn same(self: ref wrapper<T>, other: wrapper<T>) -> bool {
        return self.value == other.value
    }
}

fn main() -> i32 {
    var a: wrapper<tag> = { value: { id: 1 } }
    var b: wrapper<tag> = { value: { id: 2 } }
    println(a.same(b))
    return 0
}
