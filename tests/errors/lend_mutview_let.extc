// `let` 的容器不能作为可写视图借出去（数组：借出来的是只读视图；varArray：请求可写引用）。
// expect: cannot assign to `vb`, which is a `let`
use std::io

fn fill(dst: mut slice<i64>) {
    for i in 0..dst.len { dst[i] = i64(i + 1) }
}

fn main() -> i32 {
    let vb: varArray<i64> = varArray<i64>::withCap(2)
    fill(vb)
    io::cout << "ok\n"
    return 0
}
