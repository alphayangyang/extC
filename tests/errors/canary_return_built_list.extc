/* PLAN #31 回归（第二个形状，比 varArray 那个更基础）：
 * 往**本地容器**里 push 造链表、再把容器返回出去 ⇒ 必须被编译期挡住 ✗
 * （修之前：编过，打印 `拿到 = 0`（正确 20 10 0）—— 静默错数据 ✗）
 * 理由同上一例：`push(ref l, …)` 里 `new node` 落在 l 所在的那只 arena（函数体块）✓
 * 合法写法：在**拥有它的作用域**里建（见 examples/out-param.extc 的 listDemo），
 *           或者在函数里**直接用 `new`** 造（`new` 进的是这个函数的"家"，活得够久 ✓
 *           见 examples/escape-promotion.extc）✓ */
struct node { value: i64  next: ?ref node }
struct list { head: ?ref node }

fn push(l: mut ref list, v: i64) {
    var n: mut ref node = new node
    n.value = v
    n.next = l.head
    l.head = n
}

fn build() -> list {
    var l: list = { head: null }
    var i: i64 = 0
    while i < 3 { push(ref l, i * 10)  i = i + 1 }
    return l
}

fn main() {
    var l: list = build()
    println(l.head != null, varArray<i32>::withCap(1).get(0) ?? -1)
}
