     "\n",
+    "/* ---- 原型：运行期帧根链（每帧登记 + 标记时遍历整条链）----\n",
+    " *\n",
+    " * 静态根表只覆盖本帧的词法作用域，看不见调用栈上其他帧的活引用 —— 这就是 C 洞。\n",
+    " * 这里把\"一张表\"换成\"一条链\"：每帧在入口把自己的**引用槽地址**（不是值）登记进一个\n",
+    " * 定长数组，并把 (数组, 计数, 父帧) 组成一个帧节点；触发点的标记从**链头**出发，依次\n",
+    " * 解引用每一帧活着的槽。于是任一触发点的种子 = 整条调用栈的活引用，与\"区域归谁\"无关。\n",
+    " *\n",
+    " * bad = 这一帧的槽枚举不全（协程帧 / spawn 帧 / 枚举负载……）⇒ 整条链不可用，标记必须拒绝\n",
+    " * 执行（宁可这一轮不清扫，不可漏根误释放）。\n",
+    " */\n",
+    "typedef struct ExtcRcFrameRoot {\n",
+    "    void     **slots;\n",
+    "    size_t     n;\n",
+    "    struct ExtcRcFrameRoot *parent;\n",
+    "    int        bad;\n",
+    "} ExtcRcFrameRoot;\n",
+    "__attribute__((unused)) static _Thread_local ExtcRcFrameRoot *extc_rc_frameRoots;\n",
+    "__attribute__((unused)) static _Thread_local int64_t extc_rc_badCollected;\n",
+    "\n",
+    "__attribute__((unused)) static void extc_rc_framePush(ExtcRcFrameRoot *fr, void **slots,\n",
+    "                                                       size_t n) {\n",
+    "    fr->slots = slots; fr->n = n; fr->parent = extc_rc_frameRoots; fr->bad = 0;\n",
+    "    extc_rc_frameRoots = fr;\n",
+    "}\n",
+    "__attribute__((unused)) static void extc_rc_frameBad(ExtcRcFrameRoot *fr) { if (fr) fr->bad = 1; }\n",
+    "__attribute__((unused)) static void extc_rc_framePop(ExtcRcFrameRoot *fr) {\n",
+    "    if (fr) extc_rc_frameRoots = fr->parent;\n",
+    "}\n",
+    "/* 链上有一帧枚举不全 ⇒ 种子不完整 ⇒ 这一次清扫必须整个放弃（上界放松，不是悬垂）。 */\n",
+    "__attribute__((unused)) static int extc_rc_chainBad(void) {\n",
+    "    for (ExtcRcFrameRoot *f = extc_rc_frameRoots; f; f = f->parent)\n",
+    "        if (f->bad) { extc_rc_badCollected++; return 1; }\n",
+    "    return 0;\n",
+    "}\n",
+    "/* 现数这一帧有多少条活槽（NULL 不算）。声明点只写数组、不改状态，所以标记前数一次。 */\n",
+    "__attribute__((unused)) static void extc_rc_countslots(ExtcRcFrameRoot *fr) {\n",
+    "    size_t k = 0;\n",
+    "    for (size_t i = 0; i < 4096; i++) {\n",
+    "        if (!fr->slots[i]) break;\n",
+    "        k++;\n",
+    "    }\n",
+    "    fr->n = k;\n",
+    "}\n",
+    "/* 把整条链的活槽拼成一张根数组（值语义，与静态根表同一形态）。返回 NULL 表示链不可用。 */\n",
+    "__attribute__((unused)) static void **extc_rc_chainRoots(size_t *n) {\n",
+    "    if (extc_rc_chainBad()) { *n = 0; return (void **)0; }\n",
+    "    size_t tot = 0;\n",
+    "    for (ExtcRcFrameRoot *f = extc_rc_frameRoots; f; f = f->parent) tot += f->n;\n",
+    "    void **rs = tot ? (void **)malloc(tot * sizeof *rs) : (void **)0;\n",
+    "    if (tot && !rs) extc_rc_oops(\"root chain allocation failed\");\n",
+    "    size_t k = 0;\n",
+    "    for (ExtcRcFrameRoot *f = extc_rc_frameRoots; f; f = f->parent)\n",
+    "        for (size_t i = 0; i < f->n; i++) { void *v = f->slots[i] ? *((void **)(f->slots[i])) : (void *)0; if (v) rs[k++] = v; }\n",
+    "    *n = k;\n",
+    "    return rs;\n",
+    "}\n",
+    "\n",
     "/* ---- 来源侧记账：跨区入边的计数与撤销 ----\n",
     " *\n",
     " * `rsbit` 是\"这个目标槽有来自别区的活入边\"的**缓存**，由每槽的 `rscnt` 维护：计数 0→1\n",
