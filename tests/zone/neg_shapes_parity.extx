use std::text::string
use std::data::pool

// One question -- "may this value be stored into a place that outlives it" -- asked of three
// expression shapes that all carry the same borrowed bytes: a direct read, a read passed through a
// function that hands its argument back, and a read inside a struct literal. Each used to be
// answered by its own rule, and two of the three were wrong: the store moved a `string` handle
// whose bytes lived in a pool the loop body owned, and the read afterwards was a use-after-free
// (ASan: heap-use-after-free in `extc_cout_put`). All three must be refused.
//
// The fourth shape -- `h.s = k.atDense(0)`, a field whose storage is a place rather than a call --
// still gets through: it is a different rule (`noteFieldDepthWrite`), tracked as a gap in
// docs/design/POOL-LEVELS.md.

struct holder { s: string }

fn identity(v: string) -> string { return v }

fn main() -> i32 {
    var ks: pool<string> = pool<string>::withCap(8)
    var kh: pool<holder> = pool<holder>::withCap(8)
    for i in 0..2 {
        var k: pool<string> = pool<string>::withCap(2)
        k.insert(string::from("q"))
        ks.insert(k.atDense(0))
        ks.insert(identity(k.atDense(0)))
        kh.insert(holder { s: k.atDense(0) })
    }
    return 0
}

// expect: carries a reference into a deeper scope
