// Same rule for a fixed-size array declared inside the loop.
use std::io
use std::data::pool

fn main() -> i32 {
    var hold: pool<slice<i64>> = pool<slice<i64>>::withCap(4)
    for i in 0..3 {
        var a: [4]i64 = [1, 2, 3, 4]
        // expect: carries a reference into a deeper scope
        hold.insert(a[..])
    }
    print(hold.len())
    return 0
}
