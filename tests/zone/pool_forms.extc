// A pool value built inside a loop and stored into a pool that outlives the loop.
//
// Every shape here is the *same* question to the checker -- "is this call's pool allowed to sit at
// the destination's level" -- and each one used to be answered by its own hand-written kind list,
// so `a + b` and `f(a)` disagreed. One answer for all of them is the point of this case.
use std::io
use std::text::string
use std::data::pool

struct holder { s: string }

fn mkStr(n: i64) -> string { return string::from("s") + n }
fn optStr(n: i64) -> ?string { return some(mkStr(n)) }

fn main() -> i32 {
    let t: string = string::from("b")
    let u: string = string::from("c")
    var ks: pool<string> = pool<string>::withCap(8)
    var kh: pool<holder> = pool<holder>::withCap(8)

    for i in 0..4 {
        ks.insert(mkStr(i))                                   // call
        ks.insert(string::from("x").concatBytes(t.view()))    // method on a temporary
        ks.insert(t + u)                                      // operator, both strings
        ks.insert(t + u.view())                               // operator, view argument
        ks.insert(optStr(i) ?? string::from("z"))              // coalesce
        kh.insert(holder { s: t + u })                        // struct literal field
    }

    let s0: string = ks.atDense(0)
    let s2: string = ks.atDense(2)
    var h0: holder = kh.atDense(0)
    print(ks.len())
    print(s0.len() > 0)
    print(s2.len() > 0)
    print(h0.s.len() > 0)
    return 0
}

// expect: 20|true|true|true
