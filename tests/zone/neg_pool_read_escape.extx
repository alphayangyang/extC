// Gap G1, closed (2026-11-81): a value read out of a loop-local pool and stored into an outer
// pool used to be accepted, and reading it back was a heap-use-after-free (ASan). The read is a
// **borrow**: the bytes stay in the pool the receiver names, and a store cannot move that pool,
// so the store is now refused at check time. The positive side (`pool_forms`) still passes.
// expect: carries a reference into a deeper scope
use std::text::string
use std::data::pool

fn main() -> i32 {
    var keep: pool<string> = pool<string>::withCap(4)
    for i in 0..2 {
        var k: pool<string> = pool<string>::withCap(2)
        k.insert(string::from("a"))
        let v: string = k.atDense(0)
        keep.insert(v)
    }
    print(keep.len())
    return 0
}
