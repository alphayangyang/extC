use std::io
use std::text::string
use std::data::pool
use std::sys::pool as syspool

// Collection is about **task-owned** places (`depth == 0` in the zone table). A place on the
// block stack is released by leaving it, so collection must not touch one: this program collects
// while a loop-local pool is alive and keeps using it afterwards.

fn mk(n: i64) -> coroutine<i64> {
    for i in 0..n {
        yield i
    }
    return
}

fn main() -> i32 {
    var p: pool<string> = pool<string>::withCap(8)
    p.insert(string::from("a"))
    let freed: i64 = syspool::collect()
    p.insert(string::from("bc"))
    let a: string = p.atDense(0)
    let b: string = p.atDense(1)
    io::println(f"len={a.len() + b.len()} freed={freed}")
    return 0
}
