use std::io
use std::sys::pool as syspool

// A handle that **escapes** into storage the compiler cannot name a last owner for: ending the task
// is the program's call. `syspool::collect()` is that call -- it releases task-owned places no
// handle reaches any more (docs/design/POOL-LEVELS.md). The judgement is the number of places it
// frees: one per abandoned task, 50 here.
fn mk(n: i64) -> coroutine<i64> {
    var b: mut ref [8]i64 = new [8]i64
    (*b)[0] = 7
    for i in 0..n {
        let got: i64 = (*b)[0]
        yield got
    }
    return
}

fn main() -> i32 {
    let before: i64 = syspool::extc_pool_live()
    {
        var box: mut ref [4]coroutine<i64> = new [4]coroutine<i64>
        for k in 0..50 {
            var h: coroutine<i64> = mk(4)
            (*box)[0] = h
        }
        var hh: coroutine<i64> = (*box)[0]
        if hh.next() {
            let v: i64 = hh.value()
        }
    }
    /* The block is gone and nothing holds those handles any more: the one place that can say so
     * is the program, so collection is a call rather than a rule (see POOL-LEVELS.md). */
    let freed: i64 = syspool::collect()
    let after: i64 = syspool::extc_pool_live()
    io::println(f"before={before} after={after} freed={freed}")
    return 0
}
