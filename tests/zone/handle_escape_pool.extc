use std::io
use std::sys::pool as syspool

// A handle that **escapes** into a container: the compiler cannot name its last owner, so ending
// the task is the program's call. `syspool::collect()` is that call -- it releases task-owned
// places no handle reaches any more (docs/design/POOL-LEVELS.md). Without it `after` is 1.

fn mk(n: i64) -> coroutine<i64> {
    var b: varArray<i64> = varArray<i64>::withCap(8)
    b.push(7)
    for i in 0..n {
        let got: i64 = b.get(0) ?? 0
        yield got
    }
    return
}

fn main() -> i32 {
    let before: i64 = syspool::extc_pool_live()
    {
        var box: varArray<coroutine<i64>> = varArray<coroutine<i64>>::withCap(2)
        for k in 0..50 {
            var h: coroutine<i64> = mk(4)
            box.push(h)
        }
        var hh: coroutine<i64> = box.get(0)!
        if hh.next() {
            let v: i64 = hh.value()
        }
    }
    /* The block is gone and nothing holds those handles any more: the one place that can say so
     * is the program, so collection is a call rather than a rule (see POOL-LEVELS.md). */
    let freed: i64 = syspool::collect()
    let after: i64 = syspool::extc_pool_live()
    io::println(f"before={before} after={after} freed={freed}")
    return 0
}
