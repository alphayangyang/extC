use std::io
use std::sys::pool as syspool

// A **handle** coroutine (`coroutine<T>` annotation) keeps its frame in the task's own arena, and a
// handle can move into a longer-lived variable, so the task has to end with its last owner -- not
// with the block. The compiler does not know who that owner is, so this shape still leaks one task
// (and the pools it created) per abandoned handle. Pinned here so the fix has a red line to cross:
// the day the task is collected at whole-pool granularity, `after` becomes 0.
fn mk(n: i64) -> coroutine<i64> {
    var b: varArray<i64> = varArray<i64>::withCap(8)
    b.push(7)
    for i in 0..n {
        let got: i64 = b.get(0) ?? 0
        yield got
    }
    return
}

fn main() -> i32 {
    let before: i64 = syspool::extc_pool_live()
    for i in 0..50 {
        var h: coroutine<i64> = mk(4)
        if h.next() {
            let v: i64 = h.value()
        }
    }
    let after: i64 = syspool::extc_pool_live()
    io::println(f"before={before} after={after}")
    return 0
}
