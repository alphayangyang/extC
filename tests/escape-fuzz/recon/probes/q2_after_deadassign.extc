use std::io
struct node { value: i64  next: ?mut ref node }
fn main() -> i32 {
    var head: ?mut ref node = null
    var cur: ?mut ref node = null
    var i: i64 = 0
    while i < 3 {
        var p: mut ref node = new node
        p.value = i + 1
        p.next = null
        if i < 0 { cur = p }
        if head == null {
            head = p
        } else {
            if cur != null { (*cur).next = p }
        }
        cur = p
        i = i + 1
    }
    var c: ?mut ref node = head
    var t: i64 = 0
    while c != null {
        t = t + (*c).value
        c = (*c).next
    }
    io::cout << t << "\n"
    return 0
}
