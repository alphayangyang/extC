use std::io
struct node { value: i64  next: ?mut ref node }
fn mk(v: i64) -> mut ref node {
    var n: mut ref node = new node
    n.value = v
    n.next = null
    return n
}
fn build() -> ?mut ref node {
    var head: ?mut ref node = null
    var p: mut ref node = mk(1)
    head = p
    return head
}
