use std::io
struct node { value: i64  next: ?mut ref node }
fn mk(v: i64) -> mut ref node {
    var n: mut ref node = new node
    n.value = v
    n.next = null
    return n
}
fn build() -> i64 {
    var head: ?mut ref node = null
    head = mk(7)
    var t: i64 = 0
    if head != null { t = (*head).value }
    return t
}
fn main() -> i32 {
    io::cout << build() << "\n"
    return 0
}
