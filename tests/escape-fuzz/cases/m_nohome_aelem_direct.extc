use std::io
struct node { value: i64  next: ?mut ref node }
fn burn() -> i64 {
    var arr: [2]?mut ref node
    arr[0] = null
    arr[1] = null
    var p: mut ref node = new node
    p.value = 7
    p.next = null
    arr[0] = p
    var c: ?mut ref node = arr[0]
    var t: i64 = 0
    while c != null {
        t = t + (*c).value
        c = (*c).next
    }
    return t
}
fn main() -> i32 {
    io::cout << burn() << "\n"
    return 0
}
