use std::io
struct node { value: i64  next: ?mut ref node }
fn build() -> ?mut ref node {
    var arr: [2]?mut ref node
    arr[0] = null
    arr[1] = null
    var p: mut ref node = new node
    p.value = 7
    p.next = null
    arr[0] = p
    return arr[0]
}
fn main() -> i32 {
    var h: ?mut ref node = build()
    var c: ?mut ref node = h
    var t: i64 = 0
    while c != null {
        t = t + (*c).value
        c = (*c).next
    }
    io::cout << t << "\n"
    return 0
}
