use std::io
struct node { value: i64  next: ?mut ref node }
struct inner { next: ?mut ref node }
struct outer { mid: inner }
fn mk(v: i64) -> mut ref node {
    var n: mut ref node = new node
    n.value = v
    n.next = null
    return n
}
fn burn() -> i64 {
    var bx: outer = { mid: { next: null } }
    var p: mut ref node = mk(7)
    bx.mid.next = p
    var c: ?mut ref node = bx.mid.next
    var t: i64 = 0
    while c != null {
        t = t + (*c).value
        c = (*c).next
    }
    return t
}
fn main() -> i32 {
    io::cout << burn() << "\n"
    return 0
}
