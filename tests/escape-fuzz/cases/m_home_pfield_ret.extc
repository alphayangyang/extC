use std::io
struct node { value: i64  next: ?mut ref node }
fn mk(v: i64) -> mut ref node {
    var n: mut ref node = new node
    n.value = v
    n.next = null
    return n
}
fn link3(out: mut ref node, q: mut ref node) {
    (*out).next = q
}
fn build() -> ?mut ref node {
    var a: mut ref node = new node
    a.value = 0
    a.next = null
    var head: ?mut ref node = a
    var i: i64 = 1
    while i <= 4 {
        var p: mut ref node = mk(i)
        link3(ref *a, p)
        a = p
        i = i + 1
    }
    return head
}
fn main() -> i32 {
    var h: ?mut ref node = build()
    var c: ?mut ref node = h
    var t: i64 = 0
    while c != null {
        t = t + (*c).value
        c = (*c).next
    }
    io::cout << t << "\n"
    return 0
}
