use std::io
struct node { value: i64  next: ?mut ref node }
fn mk(v: i64) -> mut ref node {
    var n: mut ref node = new node
    n.value = v
    n.next = null
    return n
}
fn main() -> i32 {
    var q1: mut ref node = mk(1)
    var q2: mut ref node = mk(2)
    var q3: mut ref node = mk(3)
    var a: ?mut ref node = q1
    var b: ?mut ref node = q2
    var cc0: ?mut ref node = q3
    if a != null { (*a).next = b }
    if b != null { (*b).next = cc0 }
    if cc0 != null { (*cc0).next = a }
    var c: ?mut ref node = a
    var t: i64 = 0
    var s: i64 = 0
    while s < 6 {
        if c != null {
            t = t + (*c).value
            c = (*c).next
        }
        s = s + 1
    }
    io::cout << t << "\n"
    return 0
}
