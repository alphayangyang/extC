use std::io
struct node { value: i64  next: ?mut ref node }
fn mk(v: i64) -> mut ref node {
    var n: mut ref node = new node
    n.value = v
    n.next = null
    return n
}
fn build() -> ?mut ref node {
    var a: mut ref node = mk(1)
    var b: mut ref node = mk(2)
    var ca: mut ref node = mk(3)
    a.next = b
    b.next = ca
    ca.next = a
    return a
}
fn main() -> i32 {
    var h: ?mut ref node = build()
    var c: ?mut ref node = h
    var t: i64 = 0
    var s: i64 = 0
    while s < 6 {
        if c != null {
            t = t + (*c).value
            c = (*c).next
        }
        s = s + 1
    }
    io::cout << t << "\n"
    return 0
}
