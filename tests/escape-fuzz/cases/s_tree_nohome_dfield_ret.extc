use std::io
struct node { value: i64  left: ?mut ref node  right: ?mut ref node  parent: ?mut ref node }
fn mk(v: i64) -> mut ref node {
    var n: mut ref node = new node
    n.value = v
    n.left = null
    n.right = null
    n.parent = null
    return n
}
fn burn() -> i64 {
    var root0: mut ref node = new node
    var root: ?mut ref node = root0
    root0.value = 1
    root0.left = null
    root0.right = null
    root0.parent = null
    var l: mut ref node = mk(2)
    var r: mut ref node = mk(3)
    if root != null {
        (*root).left = l
        (*root).right = r
    }
    l.parent = root
    r.parent = root
    var c: ?mut ref node = root
    var t: i64 = 0
    if c != null {
        t = t + (*c).value
        if (*c).left != null { t = t + (*(*c).left!).value }
        if (*c).right != null { t = t + (*(*c).right!).value }
    }
    return t
}
fn main() -> i32 {
    io::cout << burn() << "\n"
    return 0
}
