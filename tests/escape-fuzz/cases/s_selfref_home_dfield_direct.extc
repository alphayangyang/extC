use std::io
struct node { value: i64  self: ?mut ref node }
fn build() -> ?mut ref node {
    var a0: mut ref node = new node
    var a: ?mut ref node = a0
    var b0: mut ref node = new node
    var b: ?mut ref node = b0
    a0.value = 1
    b0.value = 2
    a0.self = null
    b0.self = null
    if a != null { (*a).self = b }
    if b != null { (*b).self = a }
    return a
}
fn main() -> i32 {
    var h: ?mut ref node = build()
    var c: ?mut ref node = h
    var t: i64 = 0
    var s: i64 = 0
    while s < 4 {
        if c != null {
            t = t + (*c).value
            c = (*c).self
        }
        s = s + 1
    }
    io::cout << t << "\n"
    return 0
}
