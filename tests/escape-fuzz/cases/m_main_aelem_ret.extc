use std::io
struct node { value: i64  next: ?mut ref node }
fn mk(v: i64) -> mut ref node {
    var n: mut ref node = new node
    n.value = v
    n.next = null
    return n
}
fn main() -> i32 {
    var arr: [2]?mut ref node
    arr[0] = null
    arr[1] = null
    var p: mut ref node = mk(7)
    arr[0] = p
    var c: ?mut ref node = arr[0]
    var t: i64 = 0
    while c != null {
        t = t + (*c).value
        c = (*c).next
    }
    io::cout << t << "\n"
    return 0
}
