// expect: 1 1 7
use std::weak

fn yn(b: bool) -> i64 {
    if b { return 1 }
    return 0
}


fn peek(w: weak<i64>) -> i64 {
    var v: i64 = -1
    let q: option<ref i64> = w.upgrade()
    match q {
        some(r) => { v = *r }
        none => { v = -1 }
    }
    return v
}

fn main() -> i32 {
    var n: ?mut ref i64 = new i64
    *n! = 7
    let w: weak<i64> = weak::of(n!)
    var c: weak<i64> = w
    println(yn(w.isValid()), " ", yn(c.isValid()), " ", peek(c))
    return 0
}
