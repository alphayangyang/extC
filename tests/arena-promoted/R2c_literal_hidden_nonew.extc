// p05: callee's only allocation is reached through a call hidden inside a STRUCT LITERAL
struct node { value: i64  next: ?ref node }
struct box { r: ?ref node }

fn mknode() -> mut ref node {            // needsHome (direct)
    var n: mut ref node = new node
    n.value = 42
    return n
}

fn makeBox() -> box {                    // allocates only via mknode(), and only inside a struct literal
    var b: box = { r: mknode() }
    return b
}

fn churn() {
    var i: i64 = 0
    while i < 40 {
        var w: varArray<i64> = varArray<i64>::withCap(200)
        w.push(i * 7)
        i = i + 1
    }
}

fn main() {
    let b = makeBox()
    churn()
    println("b.r = ", b.r!.value)
}
