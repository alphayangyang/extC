/* 浮点转字符串：`string::fromF64(x, prec)`（定点、四舍五入）；整数走 `string::fromI64`。 */
use std::io
use std::text::string as str
use std::text::string as sio

fn main(args: slice<slice<u8>>) -> i32 {
    if args.len > 2 { return 1 }
    let pi = sio::fromF64(3.14159, 2)
    let neg = sio::fromF64(-0.5, 3)
    let big = sio::fromF64(1234.5, 1)
    let i = str::fromI64(-42)
    io::cout << f"pi=[{pi.snapshot()}] neg=[{neg.snapshot()}] big=[{big.snapshot()}] i=[{i.snapshot()}]\n"
    return 0
}
