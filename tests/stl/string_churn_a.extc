// string churn（小）：循环 clear + 追加 200 字节，容量策略不变 ⇒ 内存应当平
use std::io
use std::text::string

fn main() -> i32 {
    var s = string::withCap(1024)
    var i: i64 = 0
    while i < 100000 {
        s.clear()
        var k: i64 = 0
        while k < 200 { s.push(u8(97))  k = k + 1 }
        i = i + 1
    }
    io::cout << "len=" << s.len() << " cap=" << s.capacity() << "\n"
    return 0
}
