// **用户自定义池底容器：扩容是"原地长"，不是"每轮新增一份"** —— 常设判据。
//
// 这一条钉住的是内存模型的判据而不是跑分：同一个容器推到 200 万个 i64，池里只该有
// **一块** cap×8 字节的板块 —— 1.5 倍原地长之后，历代旧副本不会留在任何地方。
// 帧里手搓（`new` + 翻倍 + 拷旧）会留下几何级数的旧块，峰值是活跃量的两倍；
// 板块底的容器峰值是 O(活跃量) 本身。
//
// 判据：`n=2000000 cap=2362204 bytes=18897632 first=0 last=1999999 live_after=0`
// 其中 cap 是从 4 起按 1.5 倍一路长到的值，bytes 恰好是 cap×8（一块、无历史），
// 最后 `live_after=0` 说明释放之后池把板块还了。
// expect: n=2000000 cap=2362204 bytes=18897632 first=0 last=1999999 live_after=0
use std::io
use std::sys::pool as syspool

@place
struct grow<T> {
    pid:    i64
    pidGen: u64
    vals:   mut slice<T>
    n:      i64
    cap:    i64

    fn withCap(c: i64) -> grow<T> {
        let rp  = syspool::extc_pool_new(-1)
        let rpg = syspool::extc_pool_generation(rp)
        var cc: i64 = c
        if cc < 4 { cc = 4 }
        var g: grow<T> = { pid: rp, pidGen: rpg, vals: poolSlice<T>(rp, cc), n: 0, cap: cc }
        return g
    }

    fn push(self: mut ref grow<T>, v: T) {
        if self.n >= self.cap {
            let ncap: i64 = self.cap + self.cap / 2
            self.vals = poolResize<T>(self.pid, self.vals, ncap)
            self.cap = ncap
        }
        self.vals[self.n] = v
        self.n = self.n + 1
    }

    fn stale(self: ref grow<T>) -> bool {
        if self.pid < 0 { return false }
        return syspool::extc_pool_generation(self.pid) != self.pidGen
    }

    fn release(self: mut ref grow<T>) {
        if self.pid < 0 { return }
        if self.stale() { self.pid = -1  return }
        self.vals = poolResize<T>(self.pid, self.vals, 0)
        self.cap = 0
        syspool::extc_pool_reset(self.pid)
        syspool::extc_pool_drop(self.pid)
        self.pid = -1
    }
}

fn main() -> i32 {
    var g: grow<i64> = grow<i64>::withCap(4)
    var i: i64 = 0
    while i < 2000000 {
        g.push(i)
        i = i + 1
    }
    let bytes: i64 = syspool::extc_pool_bytes(g.pid)
    io::cout << "n=" << g.n << " cap=" << g.cap << " bytes=" << bytes
    io::cout << " first=" << g.vals[0] << " last=" << g.vals[g.n - 1]
    g.release()
    io::cout << " live_after=" << syspool::extc_pool_bytesLive() << "\n"
    return 0
}
