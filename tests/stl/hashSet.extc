// hashSetI64：无值 map（建在 hashMapI64<u8> 上，所以哈希/探测/墓碑只有一份实现）
//
// 判据：新元素 put 为真、重复 put 为假（与 map::put 语义相反）· 删掉后查不到 ·
//       墓碑 churn 十万轮后容量不涨（墓碑被复用）· 清空后 len=0
use std::io
use std::data::hashSet

fn main() -> i32 {
    var s: hashSetI64 = hashSetI64::withCap(8)
    var newN: i64 = 0
    if s.put(1) { newN = newN + 1 }
    if s.put(2) { newN = newN + 1 }
    io::cout << "new=" << newN << " len=" << s.len()
    var again: i64 = 0
    if s.put(1) { again = again + 1 }
    io::cout << " again=" << again << " len=" << s.len()
    var has2: i64 = 0
    if s.contains(2) { has2 = 1 }
    var rm: i64 = 0
    if s.remove(2) { rm = 1 }
    var gone: i64 = 0
    if s.contains(2) { gone = 1 }
    io::cout << " has2=" << has2 << " rm=" << rm << " gone=" << gone << " len=" << s.len()
    var hits: i64 = 0
    var i: i64 = 0
    while i < 100000 {
        if s.put(7) { hits = hits + 1 }
        if s.remove(7) { hits = hits + 1 }
        i = i + 1
    }
    io::cout << " hits=" << hits << " cap=" << s.capOf()
    s.clear()
    io::cout << " cleared=" << s.len() << "\n"
    return 0
}
