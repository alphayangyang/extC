// churn（小）：循环 clear + push，容量策略不变 ⇒ 内存应当平（run.sh 用 /usr/bin/time 量峰值 RSS）
use std::io
use stl::vector

fn main() -> i32 {
    var v = vector<i64>::withCap(i64(1024))
    var i: i64 = 0
    while i < i64(1000000) {
        v.clear()
        var k: i64 = 0
        while k < i64(200) { v.push(k)  k = k + i64(1) }
        i = i + i64(1)
    }
    io::cout << "len=" << v.len() << " cap=" << v.capacity() << "\n"
    return 0
}
