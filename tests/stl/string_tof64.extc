// `string::toF64`：十进制文本 -> ?f64（不合形状一律 none，调用点用 `??` 兜底）。
// expect: 3.14 -0.5 42 1000 0.015 0.25 -1 -1 -1
use std::io
use std::text::string

fn main() -> i32 {
    io::cout << (string::toF64("3.14") ?? 0.0) << " "
    io::cout << (string::toF64("-0.5") ?? 0.0) << " "
    io::cout << (string::toF64("42") ?? 0.0) << " "
    io::cout << (string::toF64("1e3") ?? 0.0) << " "
    io::cout << (string::toF64("1.5e-2") ?? 0.0) << " "
    io::cout << (string::toF64("+.25") ?? 0.0) << " "
    io::cout << (string::toF64("abc") ?? -1.0) << " "
    io::cout << (string::toF64("1..2") ?? -1.0) << " "
    io::cout << (string::toF64("") ?? -1.0) << "\n"
    return 0
}
