// vector<T> 结构操作：insert 中间插入 · removeAt 中间删除 · truncate 只留前缀 · reserve
// 判据：插入/删除的位置与顺序逐项对得上（i64 与 24 字节结构体两种元素）· 越界给 false/none 而不是 trap ·
//       truncate 钳到 [0,len] · reserve 只动容量 · 两个 vector 的内容比较走 view()（slice 的 == 是逐元素的）。
use std::io
use std::data::vector

struct pt {
    x: i64
    y: i64
}

fn main() -> i32 {
    var v = vector<i64>::withCap(2)
    var i: i64 = 0
    while i < 5 { v.push(i)  i = i + 1 }             // 0 1 2 3 4
    let a: bool = v.insert(0, i64(-1))               // -1 0 1 2 3 4
    let b: bool = v.insert(3, i64(9))                // -1 0 1 9 2 3 4
    let c: bool = v.insert(v.len(), i64(5))          // 末尾追加
    let hi: bool = v.insert(99, i64(0))              // 越界：false
    let lo: bool = v.insert(-1, i64(0))              // 越界：false
    let s: slice<i64> = v.view()
    io::cout << "ins=" << a << "," << b << "," << c << "," << hi << "," << lo
    io::cout << " n=" << v.len() << " v0=" << s[0] << " v3=" << s[3] << " last=" << s[s.len - 1]

    let r0: i64 = v.removeAt(0) ?? i64(-99)
    let r3: i64 = v.removeAt(3) ?? i64(-99)
    let rn: i64 = v.removeAt(99) ?? i64(-99)
    io::cout << " rm=" << r0 << "," << r3 << "," << rn << " n=" << v.len()

    v.truncate(4)
    v.truncate(100)
    io::cout << " tr=" << v.len() << ":" << v.view()[3]

    let before: i64 = v.relocations()
    v.reserve(100)
    io::cout << " rsv=" << v.capacity() << " mv=" << (v.relocations() - before)

    var q = vector<pt>::withCap(4)
    var k: i64 = 0
    while k < 3 {
        q.push(pt { x: k, y: k * 10 })
        k = k + 1
    }
    let ip: bool = q.insert(1, pt { x: 9, y: 90 })    // 0,9,1,2
    let rp: pt = q.removeAt(3) ?? pt { x: -1, y: -1 } // 取走 2:20
    let sv: slice<pt> = q.view()
    io::cout << " pt=" << ip << ":" << rp.x << ":" << rp.y << "=["
    var j: i64 = 0
    while j < sv.len {
        io::cout << sv[j].x << ":" << sv[j].y
        if j + 1 < sv.len { io::cout << "," }
        j = j + 1
    }
    io::cout << "]"

    var w = vector<i64>::new()
    var j2: i64 = 0
    while j2 < v.len() { w.push(v.view()[j2])  j2 = j2 + 1 }
    var u = vector<i64>::new()
    var j3: i64 = 0
    while j3 < v.len() { u.push(v.view()[j3])  j3 = j3 + 1 }
    u.push(i64(1))
    let eq2: bool = v.view() == u.view()
    let eq: bool = v.view() == w.view()
    io::cout << " eq=" << eq << "," << eq2 << "\n"
    return 0
}
// expect: ins=true,true,true,false,false n=8 v0=-1 v3=9 last=5 rm=-1,2,-99 n=6 tr=4:3 rsv=128 mv=1 pt=true:2:20=[0:0,9:90,1:10] eq=true,false
