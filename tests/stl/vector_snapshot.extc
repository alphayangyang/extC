// `vector` 的视图契约：快照用法与两条静态拒绝（本文件是 emitted-identity / idle 指纹的语料）
//
// ① 增长会使活视图失效：`var v = a.view()` 之后 `a.push(...)` 再用 `v` 是编译错
//    （"a view is only good until the container moves its storage"）。
//    要保留增长前的内容就写 `snapshot()`：它是一份拷贝，与容器此后的增长脱钩。
// ② 视图不能带出本帧：局部容器的 `return a.view()` 是编译错
//    （"whose storage this frame releases when it ends"）。
//    要带出就 `return a.snapshot()`，或者直接返回容器本身。
//    负例见 tests/features/views/err_local 与 tests/features/views/err_binding。
//
// 判据：本文件必须编过并跑出下面这一行 ——
//    snap=11,22 len=2 live=55,33 alen=3 lend=7,9 tlen=3
use std::data::vector
use std::io

/* 带出本帧的视图只能来自拷贝 */
fn lend() -> slice<i32> {
    var a: vector<i32> = vector<i32>::withCap(2)
    a.push(i32(7))
    a.push(i32(8))
    a.push(i32(9))
    return a.snapshot()
}

fn main() -> i32 {
    var a: vector<i32> = vector<i32>::withCap(4)
    a.push(i32(11))
    a.push(i32(22))
    var snap: slice<i32> = a.snapshot()   /* 拷贝：增长后仍然是 11,22 */
    a.push(i32(33))
    a.viewMut()[0] = i32(55)              /* 写的是容器当前的存储 */

    var t: slice<i32> = lend()
    var live: slice<i32> = a.view()
    io::cout << "snap=" << i64(snap[0]) << "," << i64(snap[1]) << " len=" << snap.len
    io::cout << " live=" << i64(live[0]) << "," << i64(live[2]) << " alen=" << a.len()
    io::cout << " lend=" << i64(t[0]) << "," << i64(t[2]) << " tlen=" << t.len << "\n"
    return 0
}
