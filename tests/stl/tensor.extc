/* tests/stl/tensor.extc —— 二维 strided 视图的验收：连续 / 转置 / 子矩阵 / 步长 / 逐元素写
 *
 * 预期一整行（run.sh 里逐字节比对）：
 *   g=6 w=true g2=99 s=159 ts=159 rs=1 ss=141 bsum=-1 ior=false fs=42 as=183 cs=12 st=12
 *
 * 覆盖：fromFlat 的元素读、写、求和；失败路径（装不下 / 越界写）；transpose 的零拷贝视图；
 *      subview 的起点挪动；fill；addScaled；copyFrom；fromStrided 的步长视图。
 */
use std::io
use stl::tensor

fn main() -> i32 {
    var buf: mut slice<i64> = new i64[i64(12)]
    for i in 0..i64(12) { buf[i] = i }

    var m: tensor2<i64> = tensor2<i64>::fromFlat(buf, i64(3), i64(4)) ?? tensor2<i64>::empty(buf)
    // 步长视图：元素 (r,c) = buf[r*4 + c*2]，2x2
    var st: tensor2<i64> = tensor2<i64>::fromStrided(buf, i64(0), i64(2), i64(2), i64(4), i64(2)) ?? tensor2<i64>::empty(buf)
    let stsum = st.sum() ?? i64(-1)
    // 失败路径：12 个元素装不下 3x5
    var bad: tensor2<i64> = tensor2<i64>::fromFlat(buf, i64(3), i64(5)) ?? tensor2<i64>::empty(buf)
    let bsum = bad.sum() ?? i64(-1)

    let g = m.get(i64(1), i64(2)) ?? i64(-1)
    let w = m.set(i64(1), i64(2), i64(99))
    let g2 = m.get(i64(1), i64(2)) ?? i64(-1)
    let ior = m.set(i64(3), i64(0), i64(7))
    let s = m.sum() ?? i64(-1)

    var tr = m.transpose()
    let ts = tr.sum() ?? i64(-1)
    let rs = tr.rowStride()

    var sub: tensor2<i64> = m.subview(i64(1), i64(1), i64(2), i64(3)) ?? tensor2<i64>::empty(buf)
    let ss = sub.sum() ?? i64(-1)

    var small: mut slice<i64> = new i64[i64(6)]
    var f: tensor2<i64> = tensor2<i64>::fromFlat(small, i64(2), i64(3)) ?? tensor2<i64>::empty(small)
    f.fill(i64(7))
    let fs = f.sum() ?? i64(-1)

    var onesBuf: mut slice<i64> = new i64[i64(12)]
    for i in 0..i64(12) { onesBuf[i] = i64(1) }
    var ones: tensor2<i64> = tensor2<i64>::fromFlat(onesBuf, i64(3), i64(4)) ?? tensor2<i64>::empty(onesBuf)
    let _add = m.addScaled(ones, i64(2))
    let asum = m.sum() ?? i64(-1)
    let _copy = m.copyFrom(ones)
    let csum = m.sum() ?? i64(-1)

    io::cout << "g=" << g << " w=" << w << " g2=" << g2 << " s=" << s << " ts=" << ts << " rs=" << rs << " ss=" << ss << " bsum=" << bsum << " ior=" << ior << " fs=" << fs << " as=" << asum << " cs=" << csum << " st=" << stsum << "\n"
    return 0
}
