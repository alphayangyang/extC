/* tests/stl/tensor.extc —— 二维 strided 视图的验收：连续 / 转置 / 子矩阵 / 步长 / 逐元素写
 *
 * 预期一整行（run.sh 里逐字节比对）：
 *   g=6 w=true g2=99 s=159 ts=159 rs=1 ss=141 bsum=-1 ior=false fs=42 as=183 cs=12 st=12
 *
 * 覆盖：fromFlat 的元素读、写、求和；失败路径（装不下 / 越界写）；transpose 的零拷贝视图；
 *      subview 的起点挪动；fill；addScaled；copyFrom；fromStrided 的步长视图。
 */
use std::io
use std::nd::tensor

fn main() -> i32 {
    var buf: mut slice<i64> = new i64[12]
    for i in 0..12 { buf[i] = i }

    var m: tensor2<i64> = tensor2<i64>::fromFlat(buf, 3, 4) ?? tensor2<i64>::empty(buf)
    // 步长视图：元素 (r,c) = buf[r*4 + c*2]，2x2
    var st: tensor2<i64> = tensor2<i64>::fromStrided(buf, 0, 2, 2, 4, 2) ?? tensor2<i64>::empty(buf)
    let stsum = st.sum() ?? -1
    // 失败路径：12 个元素装不下 3x5
    var bad: tensor2<i64> = tensor2<i64>::fromFlat(buf, 3, 5) ?? tensor2<i64>::empty(buf)
    let bsum = bad.sum() ?? -1

    let g = m.get(1, 2) ?? -1
    let w = m.set(1, 2, 99)
    let g2 = m.get(1, 2) ?? -1
    let ior = m.set(3, 0, 7)
    let s = m.sum() ?? -1

    var tr = m.transpose()
    let ts = tr.sum() ?? -1
    let rs = tr.rowStride()

    var sub: tensor2<i64> = m.subview(1, 1, 2, 3) ?? tensor2<i64>::empty(buf)
    let ss = sub.sum() ?? -1

    var small: mut slice<i64> = new i64[6]
    var f: tensor2<i64> = tensor2<i64>::fromFlat(small, 2, 3) ?? tensor2<i64>::empty(small)
    f.fill(7)
    let fs = f.sum() ?? -1

    var onesBuf: mut slice<i64> = new i64[12]
    for i in 0..12 { onesBuf[i] = 1 }
    var ones: tensor2<i64> = tensor2<i64>::fromFlat(onesBuf, 3, 4) ?? tensor2<i64>::empty(onesBuf)
    let _add = m.addScaled(ones, 2)
    let asum = m.sum() ?? -1
    let _copy = m.copyFrom(ones)
    let csum = m.sum() ?? -1

    io::cout << "g=" << g << " w=" << w << " g2=" << g2 << " s=" << s << " ts=" << ts << " rs=" << rs << " ss=" << ss << " bsum=" << bsum << " ior=" << ior << " fs=" << fs << " as=" << asum << " cs=" << csum << " st=" << stsum << "\n"
    return 0
}
