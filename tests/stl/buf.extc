/* 判据：`buf<T>` 是**拥有存储**的那个 —— 增长时旧板块当场还掉，离开作用域时一个字节不留，
   而 `varArray` 在 arena 上做不到这两件事（旧块只能等整个帧退出）。 */
use std::io
use std::data::buf
use std::sys::pool as syspool

fn grow() -> i64 {
    var b: buf<i64> = buf<i64>::withCap(4)
    var i: i64 = 0
    while i < 100000 { b.push(i)  i = i + 1 }
    var s: i64 = 0
    for x in b.view() { s = s + x }
    return s
}

fn main() -> i32 {
    var b: buf<i64> = buf<i64>::withCap(4)
    var i: i64 = 0
    while i < 10 { b.push(i)  i = i + 1 }
    var s: i64 = 0
    for x in b.view() { s = s + x }

    /* 复制一份独立存储：`c` 之后不受 `b` 影响 */
    let c: buf<i64> = b.clone()
    b.clear()
    b.push(100)

    /* 离开作用域交还板块：块前后字节账相等（不泄漏） */
    let before: i64 = syspool::extc_pool_bytesLive()
    {
        var t: buf<i64> = buf<i64>::withCap(256)
        t.push(1)
    }
    let after: i64 = syspool::extc_pool_bytesLive()

    /* 增长到底：10 万次 push 之后，临时那个 buf 也一个字节不留 */
    let l0: i64 = syspool::extc_pool_bytesLive()
    let gs: i64 = grow()
    let l1: i64 = syspool::extc_pool_bytesLive()

    println("len=", b.len(), " cap=", b.capacity(), " sum=", s, " c9=", c.view()[9],
            " v0=", b.view()[0], " leak=", after - before, " growsum=", gs, " gleak=", l1 - l0)
    return 0
}
