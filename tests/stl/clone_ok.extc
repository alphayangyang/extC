// 共享存储的警告 · **不该报**的形状（同 clone_warn.extc 配对）
//
// 这四种都正确：要么移交新值、要么显式 clone、要么按 ref 借，都不该有警告。
use stl::vector

/* 返回刚建好的值 ⇒ 移交，没有第二份 */
fn make() -> vector<i32> {
    var v: vector<i32> = vector<i32>::withCap(i64(4))
    v.push(i32(7))
    return v
}

fn main() -> i32 {
    var a = make()
    var b = a.clone()            /* 显式深拷贝 */
    b.push(i32(2))
    var c: vector<i32> = vector<i32>::withCap(i64(4))
    c.push(i32(3))
    var d = c.clone()            /* 带标注的绑定也不是共享 */
    d.push(i32(4))
    return i32(a.len() + b.len() + d.len())
}
