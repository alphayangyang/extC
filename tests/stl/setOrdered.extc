// set<T>：**有序**集合（建在 map<T, u8> 上）—— 乱序插入后按序遍历 · put 新元素为真 · lowerBound 排名 · 删中间元素
// expect: order=1,2,3,4,5 len=5 dup=0 has3=1 lb3=2 lb6=5 rm=1 after=1,2,4,5 lb4=2
use std::io
use std::data::map

fn main() -> i32 {
    var s: set<i64> = set<i64>::withCap(4)
    s.put(4)
    s.put(1)
    s.put(5)
    s.put(2)
    s.put(3)
    io::cout << "order="
    var i: i64 = 0
    while i < s.len() {
        if i > 0 { io::cout << "," }
        io::cout << s.at(i)
        i = i + 1
    }
    io::cout << " len=" << s.len()
    var dup: i64 = 0
    if s.put(3) { dup = 1 }
    io::cout << " dup=" << dup
    var has3: i64 = 0
    if s.contains(3) { has3 = 1 }
    io::cout << " has3=" << has3
    io::cout << " lb3=" << s.lowerBound(3) << " lb6=" << s.lowerBound(6)
    var rm: i64 = 0
    if s.remove(3) { rm = 1 }
    io::cout << " rm=" << rm << " after="
    i = 0
    while i < s.len() {
        if i > 0 { io::cout << "," }
        io::cout << s.at(i)
        i = i + 1
    }
    io::cout << " lb4=" << s.lowerBound(4) << "\n"
    return 0
}
