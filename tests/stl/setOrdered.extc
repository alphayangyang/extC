// set<T>：**有序**集合（建在 map<T, u8> 上）—— 乱序插入后按序遍历 · put 新元素为真 · lowerBound 排名 · 删中间元素
// expect: order=1,2,3,4,5 len=5 dup=0 has3=1 lb3=2 lb6=5 rm=1 after=1,2,4,5 lb4=2
use std::io
use stl::set

fn main() -> i32 {
    var s: set<i64> = set<i64>::withCap(i64(4))
    s.put(i64(4))
    s.put(i64(1))
    s.put(i64(5))
    s.put(i64(2))
    s.put(i64(3))
    io::cout << "order="
    var i: i64 = i64(0)
    while i < s.len() {
        if i > i64(0) { io::cout << "," }
        io::cout << s.at(i)
        i = i + i64(1)
    }
    io::cout << " len=" << s.len()
    var dup: i64 = i64(0)
    if s.put(i64(3)) { dup = i64(1) }
    io::cout << " dup=" << dup
    var has3: i64 = i64(0)
    if s.contains(i64(3)) { has3 = i64(1) }
    io::cout << " has3=" << has3
    io::cout << " lb3=" << s.lowerBound(i64(3)) << " lb6=" << s.lowerBound(i64(6))
    var rm: i64 = i64(0)
    if s.remove(i64(3)) { rm = i64(1) }
    io::cout << " rm=" << rm << " after="
    i = i64(0)
    while i < s.len() {
        if i > i64(0) { io::cout << "," }
        io::cout << s.at(i)
        i = i + i64(1)
    }
    io::cout << " lb4=" << s.lowerBound(i64(4)) << "\n"
    return 0
}
