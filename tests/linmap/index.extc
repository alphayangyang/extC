// expect: k=one none=? newLen=2 upd=ONE
use std::io
use stl::linmap

fn main() -> i32 {
    var m: linMap<i64, slice<u8>> = linMap<i64, slice<u8>>::withCap(i64(4))
    m.put(i64(1), "one")
    let a = m[i64(1)] ?? "?"
    let b = m[i64(9)] ?? "?"
    m[i64(2)] = "two"
    var nl: i64 = m.len()
    m[i64(1)] = "ONE"
    io::cout << "k=" << a << " none=" << b << " newLen=" << nl << " upd=" << (m[i64(1)] ?? "?") << "\n"
    return 0
}
