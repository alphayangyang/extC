// expect: k=one none=? newLen=2 upd=ONE
use std::io
use stl::linmap

fn main() -> i32 {
    var m: linMap<i64, slice<u8>> = linMap<i64, slice<u8>>::withCap(4)
    m.put(1, "one")
    let a = m[1] ?? "?"
    let b = m[9] ?? "?"
    m[2] = "two"
    var nl: i64 = m.len()
    m[1] = "ONE"
    io::cout << "k=" << a << " none=" << b << " newLen=" << nl << " upd=" << (m[1] ?? "?") << "\n"
    return 0
}
