// 池底（池自己的板块）：这张表登记自己的池 · 增长在原块上加长 · release 整棵树还回去
// expect: cap0=8 key83=83 cap=135 after=0 live=0
use std::io
use std::sys::pool as syspool
use stl::linmap

fn main() -> i32 {
    var m = linMap<i64, i32>::withCap(i64(8))
    io::cout << "cap0=" << m.capOf()
    var i: i64 = 0
    while i < i64(100) {
        m.put(i, i32(i))
        i = i + i64(1)
    }
    io::cout << " key83=" << i64(m.get(i64(83)) ?? i32(-1)) << " cap=" << m.capOf()
    m.release()
    io::cout << " after=" << m.capOf() << " live=" << syspool::extc_pool_live() << "\n"
    return 0
}
