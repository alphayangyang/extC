// 线性表：存储是自己的平坦块 · 增长搬家 · release 把块整块还回去（竞技场账本归零）
// expect: cap0=8 key83=83 cap=135 after=0 live=0
use std::io
use std::data::map
use std::data::buf

fn main() -> i32 {
    var m = linMap<i64, i32>::withCap(8)
    io::cout << "cap0=" << m.capacity()
    var i: i64 = 0
    while i < 100 {
        m.put(i, i32(i))
        i = i + 1
    }
    io::cout << " key83=" << i64(m.get(83) ?? i32(-1)) << " cap=" << m.capacity()
    m.release()
    io::cout << " after=" << m.capacity() << " live=" << buf::bufLive() << "\n"
    return 0
}
