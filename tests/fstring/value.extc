/* 值位置的 f-string：`let s: string = f"…"` 展开成 `stl::string::from(文字段) + 槽 …`
 * 的 `+` 链；带格式说明符的槽展开成 `stl::stringio::padI64/padF64/padText` 调用
 * （按槽的静态类型选，与 `<<` 右侧的说明符同一套语义）。判据见 tests/fstring/run.sh
 * 的 value-fstring 一项。 */
use std::io
use stl::string
use stl::stringio

fn tag(n: i64) -> string { return f"<{n}>" }

fn main() -> i32 {
    let n: i64 = 7
    let name: string = string::from("extC")
    let a: string = f"hi {name}, n={n}"
    let b = f"{n}"
    let c = f"expr {n * 2} flag {n > 3} float {1.5}"
    let d = f"none"
    let x: f64 = 3.14159
    let e = f"[{n:>4}][{n:<4}][{n:03}][{x:8.2f}][{x:.1f}]"
    let t: slice<u8> = "hi"
    let g = f"[{t:6}][{n:6}]"      /* 没写对齐：文本靠左、数字靠右（与 `<<` 路径同一条规定） */
    io::cout << a << "\n" << b << "\n" << c << "\n" << d << "\n" << tag(n) << "\n" << e << "\n" << g << "\n"
    return 0
}
