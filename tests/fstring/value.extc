/* 值位置的 f-string：`let s: string = f"…"` 展开成 `stl::string::from(文字段) + 槽 …`
 * 的 `+` 链（第一版不带格式说明符）。判据见 tests/fstring/run.sh 的 value-fstring 一项。 */
use std::io
use stl::string
use stl::stringio

fn tag(n: i64) -> string { return f"<{n}>" }

fn main() -> i32 {
    let n: i64 = 7
    let name: string = string::from("extC")
    let a: string = f"hi {name}, n={n}"
    let b = f"{n}"
    let c = f"expr {n * 2} flag {n > 3} float {1.5}"
    let d = f"none"
    io::cout << a << "\n" << b << "\n" << c << "\n" << d << "\n" << tag(n) << "\n"
    return 0
}
