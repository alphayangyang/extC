// 反例：`get` 把元素按值交出去 —— 元素是 `@noCopy`（拥有预留）时，这份"取出来"就是把同一片
// 存储复制成两个 owner，各析构一次。容器元素的**容器类型**是泛型实例，模板里 `T` 还不透明，
// 所以判据由延迟到实例化的那一步给出（诊断里带 instance 名）。
//
// 合法读法见 tests/pool/rt_nest_promote.extc：链式调用 `outer.view()[i].len()`；
// 想把元素搬出来用 `pop()`。
use std::data::vector
use std::io

fn main() -> i32 {
    var outer = vector<vector<i32>>::new()
    var inner = vector<i32>::new()
    inner.push(i32(7))
    outer.push(inner)
    let a = outer.get(0)!
    io::cout << "不该编过 a.len=" << a.len() << "\n"
    return 0
}
