// 守卫 · 别名那一档的另一半（迁移后）：要两份互不影响的存储，用 `clone()`。
//
// 判据：原件 `release()` 之后副本仍然能写、能读回自己的值（不是同一片板块），且两份各自独立。
//       退出码 0，输出两行 `14` 与 `0`（副本 9 + 5，原件已释放、长度 0）。
use std::data::vector

fn main() -> i32 {
    var a = vector<i32>::new()
    a.push(i32(5))
    var b = a.clone()
    a.release()
    b.push(i32(9))
    var s: i64 = 0
    var i: i64 = 0
    while i < b.len() { s = s + i64(b.get(i)!)  i = i + 1 }
    println(s)
    println(a.len())
    return 0
}