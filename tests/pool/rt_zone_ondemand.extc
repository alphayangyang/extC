// 常设判据（zone 按需发射）的**正例**：不建池的循环体不许有 zone 钩子，建池的那个块必须有
//
// 这个程序的形状是特意选的：
//   - `needPool` 为真（程序里确实建池）⇒ 门开着，钩子少发了不可能是"整块跳过"造成的；
//   - `main` 体里两条 while 循环各自是一个「地方」（块），体内只调用 `slice<i32>::get`
//     （不建池）⇒ 这两层**不许**压/弹 zone；
//   - 第三个块自己连着建两个池 ⇒ 这一层**必须**压/弹 zone，否则池登记不到 zone 上
//     （`extc_pool_new` 返回 -1 ⇒ 记录不再被回收、`extc_pool_live()` 计数错乱）。
// `tests/pool/run.sh` 把生成物里 `int64_t __extc_zm` 的出现次数钉成常量并说明来源。
use std::io
use std::sys::pool

fn main() -> i32 {
    var n: i64 = 8
    var a: mut slice<i32> = new i32[n]
    var k: i64 = 0
    while k < n {
        a[k] = i32(k + 1)
        k = k + i64(1)
    }
    /* 两条循环：体内只读元素，不建池 ⇒ 都不该有 zone 钩子 */
    var i: i64 = 0
    var s1: i64 = 0
    while i < n {
        s1 = s1 + i64(a.get(i))
        i = i + i64(1)
    }
    i = i64(0)
    var s2: i64 = 0
    while i < n {
        s2 = s2 + i64(a.get(i))
        i = i + i64(1)
    }
    var d: i64 = 0
    {
        /* 这个块自己建池 ⇒ 这一层必须有 zone 钩子 */
        let r = pool::extc_pool_new(i64(-1))
        let c = pool::extc_pool_new(r)
        d = d + pool::extc_pool_live()
        pool::extc_pool_drop(r)
    }
    io::cout << "s1=" << s1 << " s2=" << s2 << " d=" << d << " live=" << pool::extc_pool_live() << " depth=" << pool::extc_pool_zoneDepth() << "\n"
    return 0
}
