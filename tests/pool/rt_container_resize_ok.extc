/* 对照：普通池（容器板）**允许**原地搬家 —— 容器扩容照常走 `poolResizeRaw`。
 * 这个用例的存在是为了证明守卫是"按池的模式"生效，而不是把 `_raw` 一刀切禁掉。 */
use std::io
use stl::vector

fn main() -> i32 {
    var v: vector<i64> = vector<i64>::withCap(i64(2))
    var i: i64 = 0
    while i < 100 {                                     /* 触发多次扩容 ⇒ 多次 poolResizeRaw */
        v.push(i)
        i = i + i64(1)
    }
    io::cout << "len=" << v.len() << "\n"
    return 0
}
