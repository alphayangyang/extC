// **块退出把子树带走**（期 1 的钩子）：pool 挂在创建它的那一层，块一结束就没了 ✓
// 判据：块内 live=1，出块后 live=0 ✓（不需要手动 drop ✓）
use std::io
use std::sys::pool

fn main() -> i32 {
    io::cout << "before=" << pool::extc_pool_live()
    {
        let r = pool::extc_pool_new(i64(-1), i64(2))   /* 层号 = __extc_a 的下标 ✓ */
        io::cout << " in=" << pool::extc_pool_live() << " rid=" << r
    }
    io::cout << " after=" << pool::extc_pool_live()
    {
        let p = pool::extc_pool_new(i64(-1), i64(0))
        let c = pool::extc_pool_new(p, i64(0))     /* 子 pool ⇒ 父释放时一起走 ✓ */
        io::cout << " two=" << pool::extc_pool_live()
        pool::extc_pool_drop(p)
        io::cout << " gone=" << pool::extc_pool_live()
    }
    io::cout << "\n"
    return 0
}
