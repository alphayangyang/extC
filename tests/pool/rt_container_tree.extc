// hashMap 已经不在池上了：它自己**一只池都不登记**（四列与值列都在缓冲区基质上），
// 所以运行期活着的池记录是 0 —— 这条判据盯的是「容器不许把池偷带出来」。
// 池树那一半（一个容器 = 自己一只池 + 以它为父的值池）随着容器迁走而消失；
// `release` 之后仍然是 0：没有池记录可还。
// expect: live=0 len=2 v=22 after=0
use std::io
use std::sys::pool as syspool
use std::data::hashMap

fn main() -> i32 {
    var hm = hashMapI64<i32>::withCap(8)
    io::cout << "live=" << syspool::extc_pool_live()
    hm.put(1, i32(11))
    hm.put(2, i32(22))
    io::cout << " len=" << hm.len() << " v=" << i64(hm.get(2) ?? i32(-1))
    hm.release()
    io::cout << " after=" << syspool::extc_pool_live() << "\n"
    return 0
}
