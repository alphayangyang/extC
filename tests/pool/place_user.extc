// expect: n=100 cap=139 bytes>0=true gen>0=true gave=true
/* 判据：`@place` 是"我的存储住在会比我活得久的那个地方"这个标签的用户面 ——
 * 一个普通结构体标上它，用编译器内建（`poolSliceRaw`/`poolResizeRaw`）造/长自己的存储，
 * 用 `std::data::place` 查世代与占用、把块还回去。全程不需要编译器特权，也不碰 `extc_pool_*`。 */
use std::io
use std::data::place as place
use std::sys::pool as syspool

@place
struct grow {
    @private vals: mut slice<i64>
    @private n: i64
    @private cap: i64
    @private pid: i64

    fn withCap(c: i64) -> grow {
        let pid: i64 = syspool::extc_pool_new(-1)
        var cc: i64 = c
        if cc < 1 { cc = 1 }
        var g: grow = { vals: poolSliceRaw<i64>(pid, cc), n: 0, cap: cc, pid: pid }
        return g
    }
    fn push(self: mut ref grow, v: i64) {
        if self.n == self.cap {
            let nc: i64 = self.cap + self.cap / 2 + 1
            self.vals = poolResizeRaw<i64>(self.pid, self.vals, nc)
            self.cap = nc
        }
        self.vals[self.n] = v
        self.n = self.n + 1
    }
}

fn main() -> i32 {
    var g: grow = grow::withCap(2)
    var i: i64 = 0
    while i < 100 { g.push(i)  i = i + 1 }
    let bytes: i64 = place::bytes(g.pid)
    let gen: u64 = place::generation(g.pid)
    let gave: bool = place::give(g.pid, g.vals)
    io::cout << "n=" << g.n << " cap=" << g.cap << " bytes>0=" << (bytes > 0) << " gen>0=" << (gen > u64(0)) << " gave=" << gave << "\n"
    return 0
}
