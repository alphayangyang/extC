// 判据（红 → 绿）：**摘链是 O(1)，与删除顺序无关**。
//
// 形状：同一个 zone 里建 M 只池 —— 一只 parent + M 只 child（child 建在 parent 下），
// 于是两条链都被这条判据压住：
//   · zone 旁链（寿命链）：每条池记录都在上面；
//   · parent 的 firstChild 链（逻辑链，容器值池挂容器池那一档）。
// 然后逐个 drop：
//   mode=0 按**创建顺序**（最老先）—— 删除顺序与链序相反 ⇒ 修前每次都要从链头线性扫；
//   mode=1 按**链序**（最新先）—— 每次都在头部命中 ⇒ 修前也是 O(1)/池（对照组）。
//
// 只计 **drop 阶段**的单调钟纳秒数（`std::time`，建池与建表都不计），所以两个 M、两种
// 顺序的"每池纳秒"可以直接比。判据在 `tests/pool/run.sh` 里（比值有牙）：
//   ① 顺序无关：nspp(mode=0) ≤ 1.5 × nspp(mode=1)，M=1e3 与 M=1e4 各一次；
//   ② 近线性：nspp(mode=0) 从 M=1e3 到 M=1e4 的增长 ≤ 3×（二次会给出 ~10×）。
// 修前实测（M=1e3）：mode0 ≈ 1600 ns/池（zone 链 + firstChild 链各一扫），mode1 ≈ 15 ns/池。
//
// `home` 是外层地方的 zone 下标：沿用 `rt_promote.extc` 的 `zoneDepth() - 1` 惯例（zone
// 槽位就是这个下标）。池因此生在外层地方，不会随循环体那个地方退出而被整批回收。
// ids 表用 scratch 池的一块板块装 —— 与 `zt_exit_cost.extc` 同形，每只池都拿一块真板块。
use std::io
use std::sys::pool as syspool
use std::time

/* `args[i]` 当十进制数读（没给就用默认值） */
fn toInt(s: slice<u8>, dflt: i64) -> i64 {
    if s.len == i64(0) { return dflt }
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let b = i64(s[i])
        if b < i64(48) || b > i64(57) { return dflt }
        v = v * i64(10) + (b - i64(48))
        i = i + i64(1)
    }
    return v
}

fn main(args: slice<slice<u8>>) -> i32 {
    var m: i64 = i64(1000)
    if args.len > i64(1) { m = toInt(args[1], m) }
    var mode: i64 = 0
    if args.len > i64(2) { mode = toInt(args[2], mode) }

    let home = syspool::extc_pool_zoneDepth() - i64(1)   /* 外层地方（main 的帧）那个 zone */
    let scratch = syspool::extc_pool_new_at(i64(-1), home)
    if scratch < i64(0) { io::cout << "bad-home home=" << home << "\n"; return i32(1) }
    var ids: mut slice<i64> = poolSlice<i64>(scratch, m)
    let parent = syspool::extc_pool_new_at(i64(-1), home)
    if parent < i64(0) { io::cout << "bad-parent\n"; return i32(1) }

    var i: i64 = 0
    while i < m {
        let rid = syspool::extc_pool_new_at(parent, home)
        var s: mut slice<i32> = poolSlice<i32>(rid, 8)   /* 每只池一块真板块 */
        s[0] = i32(1)
        ids[i] = rid
        i = i + i64(1)
    }
    let built = syspool::extc_pool_live()
    if built != m + i64(2) { io::cout << "build-bad live=" << built << "\n"; return i32(1) }

    var t = time::start()
    if mode == i64(0) {
        var j: i64 = 0
        while j < m { syspool::extc_pool_drop(ids[j]); j = j + i64(1) }
    } else {
        var j: i64 = m - i64(1)
        while j >= i64(0) { syspool::extc_pool_drop(ids[j]); j = j - i64(1) }
    }
    let ns = t.elapsedNs()
    io::cout << "m=" << m << " mode=" << mode << " dropns=" << ns << " live=" << syspool::extc_pool_live() << "\n"
    return 0
}
