// 池的提权 · 常设判据：**循环里建内层容器、推入外层容器** ⇒ 内层池生在外层那个地方
//
// 判据的来历（每一格都对着一条真实故障）：
//   - `after=4`：outer 一个 + 三个内层各一个。**没有提权时这里是 1** —— 三个内层池随
//     循环体（= 一个地方）退出就被回收，而 outer 的板块里那三个值全指着已还给 malloc 的块
//     （ASan：heap-use-after-free；不开 ASan 时打印出来"看着完全正常"）。
//   - `innerlen=2 v=20`：出循环之后**真的能读**内层的元素。
//   - `bytes=240`：192（outer 的 4×48）+ 3×16（三个内层的缓冲区）都在账上。
// expect: after=4 innerlen=2 v=20 bytes=240
use std::io
use std::sys::pool as syspool
use stl::vector

fn main() -> i32 {
    var outer = vector<vector<i32>>::new()
    var i: i64 = 0
    while i < i64(3) {
        var inner = vector<i32>::new()
        inner.push(i32(i))
        inner.push(i32(i * i64(10)))
        outer.push(inner)
        i = i + i64(1)
    }
    let a = outer.get(i64(2))!
    io::cout << "after=" << syspool::extc_pool_live()
    io::cout << " innerlen=" << a.len() << " v=" << i64(a.get(i64(1)) ?? i32(-1))
    io::cout << " bytes=" << syspool::extc_pool_bytesLive() << "\n"
    return 0
}
