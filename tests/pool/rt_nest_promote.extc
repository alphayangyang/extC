// 嵌套容器 · 常设判据：**循环里建内层容器、推入外层容器**
//
// 判据的来历（每一格都对着一条真实故障）：
//   - 旧机制（容器存储来自池块）里，没有提权时三个内层池随循环体退出就被回收，而 outer 的板块
//     里那三个值全指着已还给 malloc 的块（ASan：heap-use-after-free；不开 ASan 时打印出来的数字
//     "看着完全正常"）。
//   - R4c 把容器存储换成 buf<T>（@noCopy，拥有预留）之后，元素存储是视图背后的平面数组：
//     `push` 写入只拷字节、不为那一份拷贝跑 @drop，所以语言要求这一步是**移动** —— 源名字交出
//     所有权、源在块尾不再跑钩子。这与池的生死无关，是同一类 use-after-free 的根。
//
// 所以这个用例的判据是：**能编能跑、内层内容完整、池一个字节都不占**（vector 的存储已不在池上）。
// 三个内层的预留各在 push 时交给外层，外层 clear/release 时逐元素跑 @drop ⇒ 最后 live 归零。
use std::io
use std::sys::pool as syspool
use std::data::vector

fn main() -> i32 {
    var outer = vector<vector<i32>>::new()
    var i: i64 = 0
    while i < 3 {
        var inner = vector<i32>::new()
        inner.push(i32(i))
        inner.push(i32(i * 10))
        outer.push(inner)
        i = i + 1
    }
    let a = outer.get(2)!
    io::cout << "after=" << syspool::extc_pool_live()
    io::cout << " innerlen=" << a.len() << " v=" << i64(a.get(1) ?? i32(-1))
    io::cout << " bytes=" << syspool::extc_pool_bytesLive() << "\n"
    return 0
}