// 池的提权 · 常设判据：**循环里建内层容器、推入外层容器**
//
// 判据的来历（每一格都对着一条真实故障）：
//   - 旧机制（容器存储来自池块）里，`after=4` 表示 outer 一个 + 三个内层各一个；**没有提权时
//     这里是 1** —— 三个内层池随循环体（= 一个地方）退出就被回收，而 outer 的板块里那三个值
//     全指着已还给 malloc 的块（ASan：heap-use-after-free；不开 ASan 时打印出来"看着完全正常"）。
//   - R4c 之后 `vector<T>` 的存储来自 `buf<T>` 自己的地址预留（`@noCopy`，owns a reservation），
//     而容器的元素存储是视图背后的平面数组：写入只拷字节、不为那一份拷贝跑 `@drop` ⇒ 元素会
//     被释放两次。语言因此**拒绝**把拥有预留的值放进视图元素 —— 这与池的生死无关，是同一类
//     use-after-free 的根，只不过这次在编译期就断掉。
//
// 所以这个用例的判据从"运行期 pool_live 数字"变成"编译期被拒且诊断指名元素类型"。
// 反例（必须仍能编过）：tests/stl/buf_ref.extc 里 `buf<mut ref node>` 装的是**引用**，不拥有存储。
use std::io
use std::sys::pool as syspool
use std::data::vector

fn main() -> i32 {
    var outer = vector<vector<i32>>::new()
    var i: i64 = 0
    while i < 3 {
        var inner = vector<i32>::new()
        inner.push(i32(i))
        inner.push(i32(i * 10))
        outer.push(inner)
        i = i + 1
    }
    let a = outer.get(2)!
    io::cout << "after=" << syspool::extc_pool_live()
    io::cout << " innerlen=" << a.len() << " v=" << i64(a.get(1) ?? i32(-1))
    io::cout << " bytes=" << syspool::extc_pool_bytesLive() << "\n"
    return 0
}
