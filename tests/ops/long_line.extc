// expect: 5000|valid
// 一行**很长**的字面量：发射器从前用 `char tmp[4096]` 格式化每一行，注释还写着"所有调用点都远低于
// 此"。可它不报错、只截断 —— 实测 5000 字节字面量会产出 4099 字节的一行，编译器**退出 0、零诊断**，
// 然后 gcc 报 `missing terminating " character`（非法 C 藏在成功退出后面）。语料里没有任何一行接近
// 4096，所以闸门看不见。这条用例就是它的常驻守卫：它跑的产物必须能编过（判据 ②）。
use std::io

fn main() -> i32 {
  var s: slice<u8> = ""
  io::cout << s.len << "|"
  if s.len == i64(5000) { io::cout << "valid" } else { io::cout << "bad" }
  io::cout << "\n"
  return 0 }
