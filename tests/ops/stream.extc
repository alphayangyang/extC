// expect: x = [i64 42]  · [i64 7] |一共调了 5 次 <<
/* 运算符按**右操作数精确类型**重载 + **值返回链式**（2026-09-24 落地）
 *
 * 这一格钉住两件事：
 *   ① 同一个类型上 `<<` 可以有多份（`i64` 一份、`slice<u8>` 一份）⇒ 生成的 C 里是**两个符号**
 *      （判据在 tests/ops/run.sh 里用 grep 钉住：`out_shl_i64` 与 `out_shl_slice_u8` 都得出现）✓
 *   ② 链式：`cout << a << b` 里第二个 `<<` 的左边是**第一个的返回值**（不是地方）
 *      ⇒ 走 `(T[]){ … }` 复合字面量那招（跟方法调用的接收者同一条规则，代码里抽成了一个函数）✓
 *
 * 为什么只给运算符开这个口子：它的签名形状是固定的（`self: ref T` + 一个操作数）
 * ⇒ 只剩"右操作数的类型"这一维可重载 ⇒ **精确匹配、无候选集、无隐式转换** ✓ */
struct out {
    n: i64
    fn <<(self: ref out, v: i64) -> out {
        print("[i64 ", v, "] ")
        return { n: self.n + i64(1) }
    }
    fn <<(self: ref out, v: slice<u8>) -> out {
        print(v)
        return { n: self.n + i64(1) }
    }
}

fn main() -> i32 {
    var cout: out = { n: i64(0) }
    var r = cout << "x = " << i64(42) << " · " << i64(7) << "\n"
    println("一共调了 ", r.n, " 次 <<")
    return 0
}
