// expect: 14 15
// 回归：`fn` 形参让"收回调的库函数"摘要在以前永远不完整 —— 调用点把**帧内的视图**
// 传给 `apply(buf, inc)` 会报 "the callee's effects could not be fully analyzed"。
// 现在：回调签名里既没有引用形参也没有引用返回值 ⇒ 间接调用不可能发布调用方的引用 ⇒
// 摘要可以完整，调用点按真实效果检查。
use std::io

fn apply(v: mut slice<i64>, f: fn(i64) -> i64) {
    for i in 0..v.len { v[i] = f(v[i]) }
}

fn inc(x: i64) -> i64 { return x + 1 }
fn double_add(x: i64) -> i64 { return x * 2 + 1 }

fn main() -> i32 {
    var buf: mut slice<i64> = new i64[4]
    for i in 0..4 { buf[i] = i64(i) }
    apply(buf, inc)
    io::cout << buf[0] << buf[3] << " "
    if true {
        var local: mut slice<i64> = new i64[3]
        for i in 0..3 { local[i] = i64(i) }
        apply(local, double_add)
        io::cout << local[0] << local[2] << "\n"
    }
    return 0
}
