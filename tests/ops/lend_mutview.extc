/* 可写视图参数（`mut slice<T>`）也自动借出：`fill(va)` 就是 `fill(va.asMutSlice())`，
 * `fill(a)` 就是 `fill(a[..])`。要求容器本身是可写的地方（`var`），借用检查照常把关。 */
// expect: s1=6 s2=6
use std::io
use stl::seq

fn fill(dst: mut slice<i64>) {
    for i in 0..dst.len { dst[i] = i64(i + 1) }
}

fn main() -> i32 {
    var va: varArray<i64> = varArray<i64>::withCap(4)
    va.push(0)
    va.push(0)
    va.push(0)
    fill(va)
    var a: [3]i64 = [0, 0, 0]
    fill(a)
    let s1: i64 = seq::sum(va) ?? 0
    let s2: i64 = seq::sum(a[..]) ?? 0
    io::cout << "s1=" << s1 << " s2=" << s2 << "\n"
    return 0
}
