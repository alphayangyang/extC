// 反例：`varArray` 的存储在**本帧的板块**上；把它的视图交给会保存的函数，等于把一个
// 随本帧死亡的视图放进更长寿的地方 —— 编译器拒绝，并指出要么先在更外层建容器，要么
// 用 `buf<T>`（P1 的拥有型缓冲）。
// expect error: whose storage moves when it grows
use std::io
struct box { v: slice<i64> }

fn put(dst: mut ref box, v: slice<i64>) { dst.v = v }

fn inner(bref: mut ref box) {
    var va: varArray<i64> = varArray<i64>::withCap(2)
    va.push(9)
    put(bref, va)
}
