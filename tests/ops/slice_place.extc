// expect: eq|ne|0
// 切片表达式**是** extC 的 place，但它的 C 形式是**函数调用**（`slice_i32_slice(...)`）——
// 所以"能不能对它取地址"必须问"生成的 C 是不是左值"，不能问"它是不是 place"。
// 混为一谈的后果实测过：生成 `&(slice_i32_slice(...))` ⇒ gcc 报 `lvalue required as unary '&'`，
// 而 extC **退出 0**（历史上 examples/slices.extc 与 euler-sieve.extc 就是这么坏的）。
use std::io

fn main() -> i32 {
  var a: [4]i32 = [i32(1), i32(2), i32(3), i32(4)]
  var s: slice<i32> = a[..]
  if s[1..3] == s[1..3] { io::cout << "eq" } else { io::cout << "bad" }
  io::cout << "|"
  if s[1..3] == s[0..2] { io::cout << "bad" } else { io::cout << "ne" }
  io::cout << "|" << s[1..3][i64(0)] - i64(2) << "\n"
  return 0 }
