// 借用：把 `varArray` 的视图存进外层 `mut ref` 字段是**安全**的 —— 它的存储是 fresh 分配，
// 编译器把那次分配提到外层需要的层（生成 C 里 `withCap` 收的是 `__extc_home`），
// 所以 `inner` 返回之后读到的仍是活的数据。借来的视图（栈上数组、方法返回的字段视图）
// 不能被搬动，见 tests/errors/view_store_deep_borrow.extc。
// expect: k=9 after=9
use std::io
struct box { v: slice<i64> }

fn put(dst: mut ref box, v: slice<i64>) { dst.v = v }

fn inner(bref: mut ref box) {
    var va: varArray<i64> = varArray<i64>::withCap(i64(2))
    va.push(9)
    put(bref, va)
}

fn main() -> i32 {
    var b: box = { v: new i64[i64(1)] }
    inner(ref b)
    io::cout << f"k={b.v[0]} after={b.v[0]}\n"
    return 0
}
