// expect: 11 -1 14 1 100
// `?` 原来是"整条语句能被重写"的四个位置专用。现在嵌套在这些语句的值位置里也能用：
// 检查器把里面每一个 `e?` 提前成一条 `var __extc_tqN = e?` 插在该语句之前（求值一次、
// 失败就 return），语句本身按普通值位置检查。判据是"提前不改变求值次数与时机"：
// `&&` / `||` 的右侧、`??` 的右侧、`while` 条件、lambda 体里仍然拒绝（见 tests/errors/try_*.extc）。
use std::io

type err = | bad | worse

fn parse(n: i64) -> result<i64, err> {
    if n < 0 { return failure(err.bad) }
    return success(n * 2)
}

fn add(a: i64, b: i64) -> i64 { return a + b }

fn viaOperand(n: i64) -> result<i64, err> { return success(parse(n)? + i64(1)) }
fn viaArgs(n: i64, m: i64) -> result<i64, err> { return success(add(parse(n)?, parse(m)?)) }
fn viaIf(n: i64) -> result<i64, err> {
    if parse(n)? > i64(0) { return success(i64(1)) }
    return success(i64(2))
}
fn viaNested(n: i64) -> result<i64, err> {
    let v: i64 = parse(n)? * i64(10)
    return success(v)
}

fn main() -> i32 {
    io::cout << (viaOperand(i64(5)) ?? i64(-1)) << " "
    io::cout << (viaOperand(i64(-5)) ?? i64(-1)) << " "
    io::cout << (viaArgs(i64(3), i64(4)) ?? i64(-1)) << " "
    io::cout << (viaIf(i64(2)) ?? i64(-1)) << " "
    io::cout << (viaNested(i64(5)) ?? i64(-1)) << "\n"
    return 0
}
