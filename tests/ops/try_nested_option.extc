// expect: 42
// 回归（第 28 轮）：`?` 原先只允许"整条语句能被重写"的四个位置，
// `option<i64>::some(option<i64>::some(n)? + 1)` 这种嵌套在实参/操作数里的用法要报错。
// 现在检查器把它提前成 `var __extc_tqN = …?` 插在语句之前 ⇒ 能写，求值次数与时机不变。
// 这条是原 `tests/errors/try_bad_position.extc` 的反向：那会儿它是反例，现在是正例。
use std::io

fn bump(n: i64) -> option<i64> {
    return option<i64>::some(option<i64>::some(n)? + i64(1))
}

fn main() -> i32 {
    io::cout << (bump(i64(41)) ?? i64(-1)) << "\n"
    return 0
}
