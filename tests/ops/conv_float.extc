// expect: i64=2 i32=3 i64n=-2 trunc=2 u8=200 big=4294967295 lit=-1
// 浮点 → 整数 + 浮点字面量的回归守卫。
//
// ① F3：修之前 `codegen.c` 的 float 分支把手抄的 if 链里 `i64` 写成 `lo = 1; hi = 0`
//    ⇒ **每一次** f64→i64 都在运行期 trap（"float does not fit in the target integer type"）；
//    `u64` 那支被 INT64_MAX 卡住。
// ② 字面量精度（独立审查没抓到，我自己量的）：从前按 `%g` 发射，只有约 6 位有效数字 ⇒
//    `4294967295.0` 会变成 `4.29497e+09`（`x - 4294967296.0` 给 0 而不是 -1），于是上面那个
//    **值本身在范围内**的转换反而 trap。现在按可往返的 `%.17g`（f32 `%.9g`）发射。
use std::io

fn main() -> i32 {
  var a: f64 = 2.5
  var b: f64 = 3.9
  var d: f64 = 0.0 - 2.5
  var e: f64 = 2.75
  var x: f64 = 4294967295.0
  io::cout << "i64=" << i64(a) << " i32=" << i32(b) << " i64n=" << i64(d)
  io::cout << " trunc=" << i64(e) << " u8=" << i64(u8(f64(200.0)))
  io::cout << " big=" << i64(u32(f64(4294967295.0))) << " lit=" << i64(x - f64(4294967296.0)) << "\n"
  return 0 }
