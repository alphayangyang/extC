// expect: i64=2 i32=3 i64n=-2 trunc=2 u8=200
// 浮点 → 整数：F3 的回归守卫。修之前 `codegen.c` 的 float 分支把范围手抄成 if 链，其中
// `i64` 写成 `lo = 1; hi = 0` ⇒ **每一次** f64→i64 都在运行期 trap
// （"float does not fit in the target integer type"）；`u64` 那支被 INT64_MAX 卡住。
//
// 这里只放**已经确认可用**的形状（64 位无符号那条还欠着，见下），字面量都挑可精确表示的：
// 发射时的浮点字面量精度另有一条 bug（`%g`，约 6 位有效数字 —— `4294967295.0` 会被印成
// `4.29497e+09`，实测 `x - 4294967296.0 == 0`），所以边界值 `u32(f64(4294967295.0))` 现在
// 还会 trap，等那条修好再加回来。
use std::io

fn main() -> i32 {
  var a: f64 = 2.5
  var b: f64 = 3.9
  var d: f64 = 0.0 - 2.5
  var e: f64 = 2.75
  /* 打印一律显式转 i64：`ostream` 只有 i64/i32/f64/bool/slice<u8> 的重载（缺 u8/u16/u32/u64）。 */
  io::cout << "i64=" << i64(a) << " i32=" << i32(b) << " i64n=" << i64(d)
  io::cout << " trunc=" << i64(e) << " u8=" << i64(u8(f64(200.0))) << "\n"
  return 0 }
