# Python
__pycache__/
*.py[cod]
.venv/
venv/

# extC 构建产物
build/
*.o
*.out
a.out

# 生成的 C 代码（由 .extc 生成，不入库）
# 注意：examples/*.c 是生成物
examples/*.generated.c

# 编辑器
.vscode/
.idea/
*.swp

# bench 的构建产物（跑 bench/run.sh / heavy / stress 就会重新生成）
#   · 生成物：`*.extc.c`（由 .extc 翻出来的 C）、以及编译出来的可执行文件
#   · **源码照旧入库**：`*.extc`、手写对照的 `*.c`、`*.js`/`*.py`、`run.sh` ✓
bench/**/*.extc.c
bench/*.extc.c
bench/**/*_extc
bench/**/*_extc_o2
bench/**/*_c
bench/**/*_c_o2
bench/**/*_chk
bench/**/*_rs
bench/**/*_cpp
