# Python
__pycache__/
*.py[cod]
.venv/
venv/

# extC 构建产物
build/
*.o
*.out
a.out

# 生成的 C 代码（由 .extc 生成，不入库）
# 注意：examples/*.c 是生成物
examples/*.generated.c

# 编辑器
.vscode/
.idea/
*.swp

# bench 的构建产物（跑 bench/run.sh / heavy / stress 就会重新生成）
#   · 生成物：`*.extc.c`（由 .extc 翻出来的 C）、以及编译出来的可执行文件
#   · **源码照旧入库**：`*.extc`、手写对照的 `*.c`、`*.js`/`*.py`、`run.sh` ✓
bench/**/*.extc.c
bench/*.extc.c
bench/**/*_extc
bench/**/*_extc_o2
bench/**/*_c
bench/**/*_c_o2
bench/**/*_chk
bench/**/*_rs
bench/**/*_cpp
!bench/string_vs_cpp/

# 读者基准的输入（36MB，由 gen.c 现场生成）
bench/gc/io/in_ints.txt
bench/gc/io/in_lines.txt

# 本地助手工具与废弃草稿（不入库）
.claude/
# DSH 认的项目级 skill 根：`.agents/skills` 是指向 `.claude/skills` 的符号链接，
# 让同一份 skill 同时被 Claude Code 与 DSH 看到（DSH 只扫 .dsh/skills 与 .agents/skills）
.agents/
prototype-python/

# prototype-heap 的产物（run.sh 会重新编）
prototype-heap/host
prototype-heap/plugin.so

# prototype-reclaim 的产物（run.sh 会重新编）
prototype-reclaim/probe_sweep
prototype-reclaim/probe_coldhot
prototype-reclaim/probe_real
# 基准数据与编译产物：**生成的**，不该进版本库（2026-10-07 从历史里剔除，224MB 的文件曾挡住 push）
bench/io/data/
bench/io/bin/

# 编译产物：Lean 目标文件、Java class、跨语言对照的二进制（都能从源码重建）
*.olean
*.class
prototype-reclaim/crosslang/bench_*
prototype-reclaim/crosslang/stress_*
prototype-reclaim/crosslang/writes_*

# 跑出来的裸转储：每次复跑都被重写，不入库（判据 `check-tree` / tools/check_tree.py）
# 文件仍留在工作区里，只是不再跟踪 —— 要看就自己跑一遍对应的 runner
tests/reclaim-gaps/out/*.on.c
tests/*/out/*.log
tests/reclaim-idle/out/*.txt
tests/escape-fuzz/recon/out/*.txt
tests/reclaim-unified/out/C-prototype-raw.txt
bench/gc/v2/pause/*/*.events
bench/gc/v2/pause/*/*.hist
