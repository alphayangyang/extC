/* stl/tensor.extc —— 二维 strided 视图：张量作为一等公民的最小形状
 *
 * **它是视图，不是容器**：一个 `tensor2<T>` 只有「一块底层存储 + 起点 + 形状 + 两个步长」，
 * 拷贝一个张量拷贝的是这五个数，不是数据。连续矩阵、转置、子矩阵、列向量都是同一个类型。
 * 每个元素的下标是 `off + r*rs + c*cs`，所以零拷贝的 view 操作（`transpose`、`subview`、
 * 行主序求和的顺序）都不需要复制。
 *
 * **布局约定**：`rs`/`cs` 以**元素**为单位、非负；`off + (rows-1)*rs + (cols-1)*cs` 必须落在
 * `data.len` 内。构造失败返回 `none`（库不 trap），调用方用 `match` / `??` 决定怎么办。
 *
 * **行主序**：`sum` 的累加顺序是 r 递增、再 c 递增（与连续布局的存储顺序一致），
 * 所以它是可复现的：同一份数据永远同一个 bit 结果。
 *
 * 只读方法在 `ref` 上、写方法在 `mut ref` 上；所有操作只碰自己的步长格，不做分配。
 *
 * @code
 * use stl::tensor
 *
 * fn main() -> i32 {
 *     var buf: mut slice<f64> = new f64[6]
 *     var m = tensor2<f64>::fromFlat(buf, 2, 3) ?? tensor2<f64>::empty(buf)
 *     m.fill(1.5)
 *     let s = m.sum() ?? f64(0.0)
 *     if s > f64(8.0) { return 0 }
 *     return 1
 * }
 * @endcode
 */

/** @brief 二维 strided 视图：底层存储 + 起点 + 形状 + 行/列步长（元素为单位）。
 */
struct tensor2<T> {
    data: mut slice<T>
    off:  i64
    rows: i64
    cols: i64
    rs:   i64
    cs:   i64

    /** @brief 把一块连续存储看成 `rows × cols` 的矩阵（行主序，步长 `cols`/`1`）。
     *  @param data 底层存储（至少 `rows*cols` 个元素）。
     *  @param rows 行数。
     *  @param cols 列数。
     *  @return 视图；形状为负或装不下时 `none`。
     */
    fn fromFlat(data: mut slice<T>, rows: i64, cols: i64) -> ?tensor2<T> {
        if rows < 0 || cols < 0 { return none }
        if rows * cols > data.len { return none }
        var t: tensor2<T> = { data: data, off: 0, rows: rows, cols: cols, rs: cols, cs: 1 }
        return some(t)
    }

    /** @brief 从任意非负步长构造视图（转置、切片、步长索引都用它）。
     *  @param data 底层存储。
     *  @param off 第一个元素的偏移（元素为单位）。
     *  @param rows 行数。
     *  @param cols 列数。
     *  @param rs 行步长（元素）。
     *  @param cs 列步长（元素）。
     *  @return 视图；步长为负、形状为负、或最远元素超出 `data.len` 时 `none`。
     */
    fn fromStrided(data: mut slice<T>, off: i64, rows: i64, cols: i64, rs: i64, cs: i64) -> ?tensor2<T> {
        if off < 0 || rows < 0 || cols < 0 { return none }
        if rs < 0 || cs < 0 { return none }
        var last: i64 = off
        if rows > 0 && cols > 0 {
            last = off + (rows - 1) * rs + (cols - 1) * cs
        }
        if last >= data.len { return none }
        var t: tensor2<T> = { data: data, off: off, rows: rows, cols: cols, rs: rs, cs: cs }
        return some(t)
    }

    /** @brief 空视图（`0 × 0`，底层存储原样带着；失败路径的兜底值）。
     *  @param data 底层存储。
     *  @return 空视图。
     */
    fn empty(data: mut slice<T>) -> tensor2<T> {
        var t: tensor2<T> = { data: data, off: 0, rows: 0, cols: 0, rs: 0, cs: 0 }
        return t
    }

    /** @brief 行数。 */
    @inline
    fn nRows(self: ref tensor2<T>) -> i64 { return self.rows }

    /** @brief 列数。 */
    @inline
    fn nCols(self: ref tensor2<T>) -> i64 { return self.cols }

    /** @brief 行步长（元素）。 */
    @inline
    fn rowStride(self: ref tensor2<T>) -> i64 { return self.rs }

    /** @brief 列步长（元素）。 */
    @inline
    fn colStride(self: ref tensor2<T>) -> i64 { return self.cs }

    /** @brief 按 `(r, c)` 读一个元素。
     *  @param r 行下标。
     *  @param c 列下标。
     *  @return 元素；越界是 `none`。
     */
    @inline
    fn get(self: ref tensor2<T>, r: i64, c: i64) -> ?T {
        if r < 0 || r >= self.rows || c < 0 || c >= self.cols { return none }
        return some(self.data[self.off + r * self.rs + c * self.cs])
    }

    /** @brief 按 `(r, c)` 写一个元素（越界不写、返回 `false`）。
     *  @param r 行下标。
     *  @param c 列下标。
     *  @param v 要写的值。
     *  @return 写了返回 `true`。
     */
    @inline
    fn set(self: mut ref tensor2<T>, r: i64, c: i64, v: T) -> bool {
        if r < 0 || r >= self.rows || c < 0 || c >= self.cols { return false }
        self.data[self.off + r * self.rs + c * self.cs] = v
        return true
    }

    /** @brief 把整张视图填成 `v`。 */
    fn fill(self: mut ref tensor2<T>, v: T) {
        var r: i64 = 0
        while r < self.rows {
            var c: i64 = 0
            while c < self.cols {
                self.data[self.off + r * self.rs + c * self.cs] = v
                c = c + 1
            }
            r = r + 1
        }
    }

    /** @brief 行主序求和（r 递增、再 c 递增；与连续布局的存储顺序一致）。
     *  @return 和；视图为空是 `none`。
     */
    fn sum(self: ref tensor2<T>) -> ?T {
        if self.rows == 0 || self.cols == 0 { return none }
        var s: T = self.data[self.off]
        var r: i64 = 0
        while r < self.rows {
            var c: i64 = 0
            while c < self.cols {
                if r > 0 || c > 0 {
                    s = s + self.data[self.off + r * self.rs + c * self.cs]
                }
                c = c + 1
            }
            r = r + 1
        }
        return some(s)
    }

    /** @brief 转置视图（零拷贝：交换形状与两个步长，底层存储不变）。
     *  @return 转置后的视图。
     */
    fn transpose(self: mut ref tensor2<T>) -> tensor2<T> {
        var t: tensor2<T> = {
            data: self.data,
            off: self.off,
            rows: self.cols,
            cols: self.rows,
            rs: self.cs,
            cs: self.rs,
        }
        return t
    }

    /** @brief 子矩阵视图（零拷贝：只挪起点、换形状）。
     *  @param r0 起始行。
     *  @param c0 起始列。
     *  @param rn 行数。
     *  @param cn 列数。
     *  @return 视图；越界或形状为负时 `none`。
     */
    fn subview(self: mut ref tensor2<T>, r0: i64, c0: i64, rn: i64, cn: i64) -> ?tensor2<T> {
        if r0 < 0 || c0 < 0 || rn < 0 || cn < 0 { return none }
        if r0 + rn > self.rows || c0 + cn > self.cols { return none }
        var t: tensor2<T> = {
            data: self.data,
            off: self.off + r0 * self.rs + c0 * self.cs,
            rows: rn,
            cols: cn,
            rs: self.rs,
            cs: self.cs,
        }
        return some(t)
    }

    /** @brief 逐元素拷贝：`self = src`（形状必须一致）。
     *  @param src 源视图。
     *  @return 形状一致、写完返回 `true`。
     */
    fn copyFrom(self: mut ref tensor2<T>, src: tensor2<T>) -> bool {
        if self.rows != src.rows || self.cols != src.cols { return false }
        var r: i64 = 0
        while r < self.rows {
            var c: i64 = 0
            while c < self.cols {
                self.data[self.off + r * self.rs + c * self.cs] = src.data[src.off + r * src.rs + c * src.cs]
                c = c + 1
            }
            r = r + 1
        }
        return true
    }

    /** @brief 逐元素 `self += k * x`（形状必须一致）。
     *  @param x 源视图。
     *  @param k 缩放系数。
     *  @return 形状一致返回 `true`。
     */
    fn addScaled(self: mut ref tensor2<T>, x: tensor2<T>, k: T) -> bool {
        if self.rows != x.rows || self.cols != x.cols { return false }
        var r: i64 = 0
        while r < self.rows {
            var c: i64 = 0
            while c < self.cols {
                self.data[self.off + r * self.rs + c * self.cs] =
                    self.data[self.off + r * self.rs + c * self.cs] + k * x.data[x.off + r * x.rs + c * x.cs]
                c = c + 1
            }
            r = r + 1
        }
        return true
    }
}
