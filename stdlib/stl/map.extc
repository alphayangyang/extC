/* stl/map.extc -- `map<K, V>`: an ORDERED map, implemented as a B+tree.
 *
 * WHY THIS SHAPE (POOLS.md §11, the author's ruling): an in-memory ordered map is bound by cache
 * misses, not by comparisons. A binary tree over 10^6 keys is ~20 pointer chases per lookup; a
 * B+tree with 16 keys per node is ~5, and every step is a binary search inside ONE contiguous
 * array. Ordered iteration is the leaf chain, so it is a linear scan of contiguous memory. Small
 * maps fall out of the same shape for free: with 16 keys per node, any map up to 16 entries IS a
 * single sorted array, which is the fastest representation at that size -- no separate fast path.
 *
 * Layout
 *   - a node holds up to `ORDER` (16) settled keys in one slice (17 slots, so an insert can
 *     land before the split), plus `ORDER + 2` child id slots when internal;
 *     ids are indices into `nodes`, never pointers, so the array can double and the whole tree
 *     stays relocatable (and, in stage 3, shrinkable);
 *   - `keys[i]` of an internal node is the SMALLEST key of subtree `kids[i + 1]`, so a child owns
 *     the half-open range [keys[i-1], keys[i]); a descent picks the first `i` with `k < keys[i]`;
 *   - leaves hold the values and are chained left to right through `next` -- that chain is what
 *     makes the ordered walk a scan;
 *   - `cnt` is the number of keys in a subtree and is maintained through every split, which is what
 *     makes `keyAt` / `valAt` / `lowerBound` rank queries O(log n) instead of a walk.
 *
 * Ordering comes from the KEY TYPE: `a < b` (a method `fn <` for a struct key, built in for the
 * numeric types). Equality is derived -- `a == b` iff `!(a < b) && !(b < a)` -- so a key type
 * supplies one operator and the ordered map works for any type that has it.
 *
 * STAGE 2b (this file today): insert (splits up to a new root), lookup, rank queries and the
 * ordered walk are complete, and `remove` rebalances -- a node under `HALF` entries borrows from a
 * sibling that can spare one, otherwise it merges, and every node a merge retires goes back on a
 * free list for the next split to reuse. Stage 3 moves the stores and the node records into pools,
 * which adds `release` / `shrink` and turns the free list into pool slots. */
use std::sys::pool as syspool    /* 运行期池：容器诞生时登记，release 时整批还 */

let ORDER: i64 = 16        /* max keys per node (the array sizes in `newNode` are these numbers) */
let HALF:  i64 = 8         /* min keys per non-root node once stage 2b rebalances */

struct bnode<K, V> {
    n:    i32                 /* keys in this node */
    cnt:  i32                 /* keys in this subtree (leaves: n; internal: sum of children) */
    leaf: bool
    keys: mut slice<K>        /* ORDER entries, ascending */
    vals: mut slice<V>        /* leaves only */
    kids: mut slice<i32>      /* internal only, ORDER + 1 entries */
    next: i32                 /* leaf chain, -1 at the end */
}

@sharesStorage        /* 按值拷贝时**两份共用同一块板块** ⇒ 编译器在这里报警告，要独立副本用 `clone()` */
@poolObject            /* 这个类型**拥有一个池**：存储住在池自己的板块上，寿命随它所在的地方 */
struct map<K, V> {
    nodes:  mut slice<bnode<K, V>>   /* per-node scalars + VIEWS into the three stores below */
    /* The three stores are flat and owned by the map: node `id` owns the 17 key slots at
     * `id * 17`, the 17 value slots at the same offset, and the 18 child slots at `id * 18`.
     * Nodes therefore never allocate -- a node is carved out of storage that already exists.
     * That is not only faster (one allocation per doubling instead of one per node): an
     * allocation inside `put`'s split loop lands in the ARENA OF THAT LOOP BODY and is freed the
     * moment the iteration ends, so a freshly split node used to dangle (the stress case caught
     * it as a heap-use-after-free under ASan). Storage that is allocated once, at the top level of
     * `withCap` / `growStores`, has the map's own lifetime. */
    keys:   mut slice<K>
    vals:   mut slice<V>
    kids:   mut slice<i32>
    nnodes: i64
    ncap:   i64               /* nodes the stores have room for */
    root:   i32
    freeHead: i32             /* chain of recycled nodes (through `next`), -1 when empty */
    pid:    i64               /* runtime pool of this container (`release` hands it back) */
    pidGen: u64               /* its generation: a stale copy must not release somebody else's */
    n:      i64               /* live entries */
    path:   mut slice<i32>    /* scratch: the descent path of `put` / `remove` */
    side:   mut slice<i32>    /* scratch: which child slot was taken at each level */
    depth:  i64

    /* ---------------------------------------------------------------- construction */
    fn withCap(want: i64) -> map<K, V> {
        var c: i64 = i64(4)
        while c < want { c = c * i64(2) }
        let rp  = syspool::extc_pool_new(i64(-1))
        let rpg = syspool::extc_pool_generation(rp)
        var m: map<K, V> = {
            /* 四处长期存储都在**这张表自己的池板块**上（不是 arena 切片）：增长/压实时旧的
             * 那几块当场还回去。之前用 `new` 时，每一代旧存储都留给 arena —— 1e6 条目下
             * 峰值 179,820 KB 对 90,604 KB，那 49% 就是它们。 */
            nodes: poolSlice<bnode<K, V>>(rp, c),
            keys:  poolSlice<K>(rp, c * i64(17)),
            vals:  poolSlice<V>(rp, c * i64(17)),
            kids:  poolSlice<i32>(rp, c * i64(18)),
            nnodes: i64(0), ncap: c, root: i32(0), freeHead: i32(-1),
            pid: rp, pidGen: rpg, n: i64(0),
            path: poolSlice<i32>(rp, i64(16)), side: poolSlice<i32>(rp, i64(16)), depth: i64(0),
        }
        m.root = m.newNode(true)
        return m
    }

    fn new() -> map<K, V> { return map<K, V>::withCap(i64(16)) }

    fn len(self: ref map<K, V>) -> i64 { return self.n }
    fn nodeCount(self: ref map<K, V>) -> i64 { return self.nnodes }
    fn height(self: ref map<K, V>) -> i64 {
        var h: i64 = i64(1)
        var id: i32 = self.root
        while !self.leafOf(id) { id = self.kd(id, i64(0))  h = h + i64(1) }
        return h
    }

    /* ---------------------------------------------------------------- node access, by id */
    fn bn(self: ref map<K, V>, id: i32) -> i64 { return i64(self.nodes[i64(id)].n) }
    fn cntOf(self: ref map<K, V>, id: i32) -> i64 { return i64(self.nodes[i64(id)].cnt) }
    fn leafOf(self: ref map<K, V>, id: i32) -> bool { return self.nodes[i64(id)].leaf }
    fn kn(self: ref map<K, V>, id: i32, i: i64) -> K { return self.nodes[i64(id)].keys[i] }
    fn vn(self: ref map<K, V>, id: i32, i: i64) -> V { return self.nodes[i64(id)].vals[i] }
    fn kd(self: ref map<K, V>, id: i32, i: i64) -> i32 { return self.nodes[i64(id)].kids[i] }
    fn nx(self: ref map<K, V>, id: i32) -> i32 { return self.nodes[i64(id)].next }

    fn setN(self: mut ref map<K, V>, id: i32, v: i64) { self.nodes[i64(id)].n = i32(v) }
    fn setCnt(self: mut ref map<K, V>, id: i32, v: i64) { self.nodes[i64(id)].cnt = i32(v) }
    fn setKey(self: mut ref map<K, V>, id: i32, i: i64, k: K) { self.nodes[i64(id)].keys[i] = k }
    fn setVal(self: mut ref map<K, V>, id: i32, i: i64, v: V) { self.nodes[i64(id)].vals[i] = v }
    fn setKid(self: mut ref map<K, V>, id: i32, i: i64, c: i32) { self.nodes[i64(id)].kids[i] = c }
    fn setNext(self: mut ref map<K, V>, id: i32, c: i32) { self.nodes[i64(id)].next = c }

    /* Double the stores and re-hang every node's views on the new arrays. The copies are element
     * by element on purpose: a view is a pointer into the old store, so it cannot be moved by
     * copying the store's bytes alone. */
    fn growStores(self: mut ref map<K, V>) {
        /* 1.5 倍，而且**一个字节的数据都不用搬**：节点 `i` 的三个存储槽位是 `keys[i*17 ..]` /
         * `vals[i*17 ..]` / `kids[i*18 ..]` —— 偏移只跟 id 有关，与容量无关。所以增长就是在
         * 原块上加长（`poolResize` 保住内容），再把每个节点的视图重新指向新基址。
         *
         * 这里曾经走"新四块 + 逐元素拷 + 旧四块丢掉"：那份拷贝不但 O(n)，还要在最长的一跳里
         * 让新旧两代同时在手（1e6 条目实测峰值 102,200 KB，其中 ~47 MB 是这一瞬间）。
         * 1.5 倍的另一个好处：末代容量从 2 的幂（262,144 节点，只用 140,623）降到 ~157,000。 */
        var want: i64 = self.ncap + self.ncap / i64(2)
        if want < i64(4) { want = i64(4) }
        self.keys  = poolResize<K>(self.pid, self.keys, want * i64(17))
        self.vals  = poolResize<V>(self.pid, self.vals, want * i64(17))
        self.kids  = poolResize<i32>(self.pid, self.kids, want * i64(18))
        self.nodes = poolResize<bnode<K, V>>(self.pid, self.nodes, want)
        /* 基址可能变了（realloc 搬家），所以视图必须重新算一遍 —— 这是 O(节点数) 次指针写，
         * 不是 O(节点数 × 17) 次拷贝。 */
        var i: i64 = i64(0)
        while i < self.nnodes {
            let kb = i * i64(17)
            let cb = i * i64(18)
            var nd: bnode<K, V> = self.nodes[i]
            nd.keys = self.keys[kb..kb + i64(17)]
            nd.vals = self.vals[kb..kb + i64(17)]
            nd.kids = self.kids[cb..cb + i64(18)]
            self.nodes[i] = nd
            i = i + i64(1)
        }
        self.ncap = want
    }

    /* Carve a fresh node out of the stores. No allocation happens here, which is what keeps a
     * node created inside `put`'s split loop alive (see the note on the stores above).
     * Stage 3 hands the slot back on delete instead of leaking it. */
    fn newNode(self: mut ref map<K, V>, leaf: bool) -> i32 {
        /* A recycled node already has its views into the stores; only the scalars are reset. */
        if self.freeHead >= i32(0) {
            let id = self.freeHead
            self.freeHead = self.nodes[i64(id)].next
            self.nodes[i64(id)].n = i32(0)
            self.nodes[i64(id)].cnt = i32(0)
            self.nodes[i64(id)].leaf = leaf
            self.nodes[i64(id)].next = i32(-1)
            return id
        }
        if self.nnodes >= self.ncap { self.growStores() }
        let id = i32(self.nnodes)
        let kb = self.nnodes * i64(17)
        let cb = self.nnodes * i64(18)
        var nd: bnode<K, V> = {
            n: i32(0), cnt: i32(0), leaf: leaf,
            keys: self.keys[kb..kb + i64(17)],
            vals: self.vals[kb..kb + i64(17)],
            kids: self.kids[cb..cb + i64(18)],
            next: i32(-1),
        }
        self.nodes[self.nnodes] = nd
        self.nnodes = self.nnodes + i64(1)
        return id
    }

    /* Sum of the key counts of children [0, upto) of an internal node. */
    fn kidsCnt(self: ref map<K, V>, id: i32, upto: i64) -> i64 {
        var s: i64 = i64(0)
        var i: i64 = i64(0)
        while i < upto {
            s = s + self.cntOf(self.kd(id, i))
            i = i + i64(1)
        }
        return s
    }

    /* The smallest key of a SUBTREE (a node id, not the map): kids[0] all the way down. Not to be
     * confused with the public `firstKey()` below, which is the smallest key of the whole map. */
    fn subMinKey(self: ref map<K, V>, id: i32) -> K {
        var cur: i32 = id
        while !self.leafOf(cur) { cur = self.kd(cur, i64(0)) }
        return self.kn(cur, i64(0))
    }

    /* ---------------------------------------------------------------- search */
    /* First index in [0, n) whose key is not less than `k` (the lower bound inside one node). */
    fn lowerIn(self: ref map<K, V>, id: i32, k: K) -> i64 {
        var lo: i64 = i64(0)
        var hi: i64 = self.bn(id)
        while lo < hi {
            let mid = lo + (hi - lo) / i64(2)
            if self.kn(id, mid) < k { lo = mid + i64(1) } else { hi = mid }
        }
        return lo
    }

    /* Child slot to descend into: the first `i` with `k < keys[i]`, else n (the last child). */
    fn childSlot(self: ref map<K, V>, id: i32, k: K) -> i64 {
        var lo: i64 = i64(0)
        var hi: i64 = self.bn(id)
        while lo < hi {
            let mid = lo + (hi - lo) / i64(2)
            if k < self.kn(id, mid) { hi = mid } else { lo = mid + i64(1) }
        }
        return lo
    }

    fn leafFor(self: ref map<K, V>, k: K) -> i32 {
        var id: i32 = self.root
        while !self.leafOf(id) { id = self.kd(id, self.childSlot(id, k)) }
        return id
    }

    fn contains(self: ref map<K, V>, k: K) -> bool {
        let id = self.leafFor(k)
        let i = self.lowerIn(id, k)
        if i >= self.bn(id) { return false }
        return !(k < self.kn(id, i))
    }

    /* `m[k]` -- the read side of the subscript syntax and nothing else. It returns `?V` exactly
     * like `get`: a missing key is `none`, NOT an inserted default (`std::map::operator[]`'s
     * surprise is not available here -- extC has no lvalue generation, and writing stays `put`).
     * `[]` and `[]=` are independent method names, so a type may offer reading without writing. */
    fn [](self: ref map<K, V>, k: K) -> ?V { return self.get(k) }

    fn get(self: ref map<K, V>, k: K) -> ?V {
        let id = self.leafFor(k)
        let i = self.lowerIn(id, k)
        if i >= self.bn(id) { return none }
        if k < self.kn(id, i) { return none }
        return some(self.vn(id, i))
    }

    /* Rank of the first key not less than `k` -- the count of keys strictly less than `k`.
     * Descending adds whole subtrees, so this is O(log n) rather than a walk. */
    fn lowerBound(self: ref map<K, V>, k: K) -> i64 {
        var rank: i64 = i64(0)
        var id: i32 = self.root
        while !self.leafOf(id) {
            let c = self.childSlot(id, k)
            rank = rank + self.kidsCnt(id, c)
            id = self.kd(id, c)
        }
        return rank + self.lowerIn(id, k)
    }

    /* The smallest / largest key, `none` on an empty map. Both are O(log n): a rank query on the
     * order-statistic side (`cnt`), not a walk. */
    fn firstKey(self: ref map<K, V>) -> ?K {
        if self.n == i64(0) { return none }
        return some(self.keyAt(i64(0)))
    }

    fn lastKey(self: ref map<K, V>) -> ?K {
        if self.n == i64(0) { return none }
        return some(self.keyAt(self.n - i64(1)))
    }

    /* The i-th smallest entry, encoded as `leafId * 16 + position` (16 = ORDER, and a leaf never
     * holds more). Passing two numbers would mean a tuple type the language does not have. */
    fn rankAt(self: ref map<K, V>, i: i64) -> i64 {
        var id: i32 = self.root
        var want: i64 = i
        while !self.leafOf(id) {
            var c: i64 = i64(0)
            var found: i64 = i64(0)
            while found == i64(0) {
                let s = self.cntOf(self.kd(id, c))
                if want < s { found = i64(1) } else { want = want - s  c = c + i64(1) }
            }
            id = self.kd(id, c)
        }
        return i64(id) * i64(16) + want
    }

    fn keyAt(self: ref map<K, V>, i: i64) -> K {
        let e = self.rankAt(i)
        return self.kn(i32(e / i64(16)), e % i64(16))
    }

    fn valAt(self: ref map<K, V>, i: i64) -> V {
        let e = self.rankAt(i)
        return self.vn(i32(e / i64(16)), e % i64(16))
    }

    /* **深拷贝：要一份独立的 map 就用它。**
     *
     * `var b = a` 不是深拷贝 —— 那是结构体逐成员拷贝，两份共用同一批节点所在的板块
     * （`vals` 是指针被抄了一份）：`b.put(...)` 会改到 `a`，`a.release()` 会让 `b` 悬垂。
     * 显式拷贝的代价可见（一次 O(n) 拷贝 + 一块新板块），新存储生在调用者所在的地方。 */
    fn clone(self: ref map<K, V>) -> map<K, V> {
        var out = map<K, V>::withCap(self.n + i64(1))
        var i: i64 = 0
        while i < self.n {
            out.put(self.keyAt(i), self.valAt(i))
            i = i + i64(1)
        }
        return out
    }

    /* `m[k] = v` -- the write side, a SEPARATE method name from `[]`, so a type may offer reading
     * without writing (and this one is only ever found on an assignment). Semantics are `put`'s: a
     * key that is absent is inserted, one that is present is overwritten, and the answer says which
     * of the two happened (true = it was already there). */
    fn []=(self: mut ref map<K, V>, k: K, v: V) -> bool { return self.put(k, v) }

    /* ---------------------------------------------------------------- insert */
    fn put(self: mut ref map<K, V>, k: K, v: V) -> bool {
        if self.pStale() { self.pPoison() }
        /* Descend to the leaf, recording the path: a split has to be pushed back up it. */
        var id: i32 = self.root
        self.depth = i64(0)
        while !self.leafOf(id) {
            let c = self.childSlot(id, k)
            self.path[self.depth] = id
            self.side[self.depth] = i32(c)
            self.depth = self.depth + i64(1)
            id = self.kd(id, c)
        }
        let at = self.lowerIn(id, k)
        if at < self.bn(id) && !(k < self.kn(id, at)) { self.setVal(id, at, v)  return true }

        var j: i64 = self.bn(id)
        while j > at {
            self.setKey(id, j, self.kn(id, j - i64(1)))
            self.setVal(id, j, self.vn(id, j - i64(1)))
            j = j - i64(1)
        }
        self.setKey(id, at, k)
        self.setVal(id, at, v)
        self.setN(id, self.bn(id) + i64(1))
        self.setCnt(id, self.cntOf(id) + i64(1))
        self.n = self.n + i64(1)

        /* one more key in every subtree on the path */
        var d: i64 = self.depth - i64(1)
        while d >= i64(0) {
            let p = self.path[d]
            self.setCnt(p, self.cntOf(p) + i64(1))
            d = d - i64(1)
        }

        /* Split upward while a node is overfull. A leaf split COPIES its first key up (the key
         * stays in the right leaf); an internal split MOVES its middle key up. */
        var child: i32 = id
        var level: i64 = self.depth
        var sep: K = k
        while self.bn(child) > ORDER {
            var right: i32 = self.newNode(self.leafOf(child))
            if self.leafOf(child) {
                var r: i64 = i64(0)
                var s: i64 = HALF
                while s < self.bn(child) {
                    self.setKey(right, r, self.kn(child, s))
                    self.setVal(right, r, self.vn(child, s))
                    r = r + i64(1)
                    s = s + i64(1)
                }
                self.setN(right, r)
                self.setCnt(right, r)
                self.setN(child, HALF)
                self.setCnt(child, HALF)
                self.setNext(right, self.nx(child))
                self.setNext(child, right)
                sep = self.kn(right, i64(0))
            } else {
                sep = self.kn(child, HALF)
                var r: i64 = i64(0)
                var s: i64 = HALF + i64(1)
                while s < self.bn(child) {
                    self.setKey(right, r, self.kn(child, s))
                    r = r + i64(1)
                    s = s + i64(1)
                }
                self.setN(right, r)
                var k2: i64 = i64(0)
                var cs: i64 = HALF + i64(1)
                while cs <= self.bn(child) {
                    self.setKid(right, k2, self.kd(child, cs))
                    k2 = k2 + i64(1)
                    cs = cs + i64(1)
                }
                self.setN(child, HALF)
                self.setCnt(right, self.kidsCnt(right, r + i64(1)))
                self.setCnt(child, self.kidsCnt(child, HALF + i64(1)))
            }
            if level == i64(0) {
                /* the root itself split: a new root above both halves, and the tree grows */
                var nr: i32 = self.newNode(false)
                self.setKey(nr, i64(0), sep)
                self.setKid(nr, i64(0), child)
                self.setKid(nr, i64(1), right)
                self.setN(nr, i64(1))
                self.setCnt(nr, self.cntOf(child) + self.cntOf(right))
                self.root = nr
                return false
            }
            let p = self.path[level - i64(1)]
            let ci = i64(self.side[level - i64(1)])
            var q: i64 = self.bn(p)
            while q > ci {
                self.setKey(p, q, self.kn(p, q - i64(1)))
                q = q - i64(1)
            }
            var qc: i64 = self.bn(p) + i64(1)
            while qc > ci + i64(1) {
                self.setKid(p, qc, self.kd(p, qc - i64(1)))
                qc = qc - i64(1)
            }
            self.setKey(p, ci, sep)
            self.setKid(p, ci + i64(1), right)
            self.setN(p, self.bn(p) + i64(1))
            child = p
            level = level - i64(1)
        }
        return false
    }

    /* ---------------------------------------------------------------- rebalancing */
    /* Hand a node back for reuse. The store slot is never returned (the stores only grow), so a
     * churn of insert/delete cycles reuses node ids instead of walking the store forward. */
    fn freeNode(self: mut ref map<K, V>, id: i32) {
        self.nodes[i64(id)].next = self.freeHead
        self.freeHead = id
    }

    /* Drop keys[ci-1] and kids[ci] from internal node `p`: the separator and the child it bounded
     * are removed together. */
    fn dropChild(self: mut ref map<K, V>, p: i32, ci: i64) {
        var j: i64 = ci - i64(1)
        while j + i64(1) < self.bn(p) {
            self.setKey(p, j, self.kn(p, j + i64(1)))
            j = j + i64(1)
        }
        var jc: i64 = ci
        while jc + i64(1) <= self.bn(p) {
            self.setKid(p, jc, self.kd(p, jc + i64(1)))
            jc = jc + i64(1)
        }
        self.setN(p, self.bn(p) - i64(1))
    }

    /* One entry moves from the left sibling into `cur` (children ci-1 and ci of `p`). */
    fn borrowLeft(self: mut ref map<K, V>, p: i32, ci: i64) {
        let cur: i32 = self.kd(p, ci)
        let left: i32 = self.kd(p, ci - i64(1))
        if self.leafOf(cur) {
            var j: i64 = self.bn(cur)
            while j > i64(0) {
                self.setKey(cur, j, self.kn(cur, j - i64(1)))
                self.setVal(cur, j, self.vn(cur, j - i64(1)))
                j = j - i64(1)
            }
            self.setKey(cur, i64(0), self.kn(left, self.bn(left) - i64(1)))
            self.setVal(cur, i64(0), self.vn(left, self.bn(left) - i64(1)))
            self.setN(cur, self.bn(cur) + i64(1))
            self.setN(left, self.bn(left) - i64(1))
            self.setCnt(cur, self.cntOf(cur) + i64(1))
            self.setCnt(left, self.cntOf(left) - i64(1))
            return
        }
        var j: i64 = self.bn(cur)
        while j > i64(0) {
            self.setKey(cur, j, self.kn(cur, j - i64(1)))
            j = j - i64(1)
        }
        var jc: i64 = self.bn(cur) + i64(1)
        while jc > i64(0) {
            self.setKid(cur, jc, self.kd(cur, jc - i64(1)))
            jc = jc - i64(1)
        }
        self.setKey(cur, i64(0), self.kn(p, ci - i64(1)))
        self.setKid(cur, i64(0), self.kd(left, self.bn(left)))
        self.setKey(p, ci - i64(1), self.kn(left, self.bn(left) - i64(1)))
        let moved: i64 = self.cntOf(self.kd(left, self.bn(left)))
        self.setN(cur, self.bn(cur) + i64(1))
        self.setN(left, self.bn(left) - i64(1))
        self.setCnt(cur, self.cntOf(cur) + moved)
        self.setCnt(left, self.cntOf(left) - moved)
    }

    /* One entry moves from the right sibling into `cur`. */
    fn borrowRight(self: mut ref map<K, V>, p: i32, ci: i64) {
        let cur: i32 = self.kd(p, ci)
        let right: i32 = self.kd(p, ci + i64(1))
        if self.leafOf(cur) {
            self.setKey(cur, self.bn(cur), self.kn(right, i64(0)))
            self.setVal(cur, self.bn(cur), self.vn(right, i64(0)))
            var j: i64 = i64(0)
            while j + i64(1) < self.bn(right) {
                self.setKey(right, j, self.kn(right, j + i64(1)))
                self.setVal(right, j, self.vn(right, j + i64(1)))
                j = j + i64(1)
            }
            self.setN(cur, self.bn(cur) + i64(1))
            self.setN(right, self.bn(right) - i64(1))
            self.setCnt(cur, self.cntOf(cur) + i64(1))
            self.setCnt(right, self.cntOf(right) - i64(1))
            self.setKey(p, ci, self.kn(right, i64(0)))
            return
        }
        self.setKey(cur, self.bn(cur), self.kn(p, ci))
        self.setKid(cur, self.bn(cur) + i64(1), self.kd(right, i64(0)))
        self.setKey(p, ci, self.kn(right, i64(0)))
        let moved: i64 = self.cntOf(self.kd(right, i64(0)))
        var j: i64 = i64(0)
        while j + i64(1) < self.bn(right) {
            self.setKey(right, j, self.kn(right, j + i64(1)))
            j = j + i64(1)
        }
        j = i64(0)
        while j + i64(1) <= self.bn(right) {
            self.setKid(right, j, self.kd(right, j + i64(1)))
            j = j + i64(1)
        }
        self.setN(cur, self.bn(cur) + i64(1))
        self.setN(right, self.bn(right) - i64(1))
        self.setCnt(cur, self.cntOf(cur) + moved)
        self.setCnt(right, self.cntOf(right) - moved)
    }

    /* Merge `cur` into its left sibling and drop the separator. In this layout an internal node's
     * key is a COPY of a subtree minimum, so nothing has to be "pulled down" twice: the separator
     * becomes left's new last key and the child counts add up unchanged. */
    fn mergeLeft(self: mut ref map<K, V>, p: i32, ci: i64) {
        let cur: i32 = self.kd(p, ci)
        let left: i32 = self.kd(p, ci - i64(1))
        if self.leafOf(cur) {
            var j: i64 = i64(0)
            while j < self.bn(cur) {
                self.setKey(left, self.bn(left) + j, self.kn(cur, j))
                self.setVal(left, self.bn(left) + j, self.vn(cur, j))
                j = j + i64(1)
            }
            self.setN(left, self.bn(left) + self.bn(cur))
            self.setCnt(left, self.cntOf(left) + self.cntOf(cur))
            self.setNext(left, self.nx(cur))
        } else {
            self.setKey(left, self.bn(left), self.kn(p, ci - i64(1)))
            var j: i64 = i64(0)
            while j < self.bn(cur) {
                self.setKey(left, self.bn(left) + i64(1) + j, self.kn(cur, j))
                j = j + i64(1)
            }
            var jc: i64 = i64(0)
            while jc <= self.bn(cur) {
                self.setKid(left, self.bn(left) + i64(1) + jc, self.kd(cur, jc))
                jc = jc + i64(1)
            }
            self.setN(left, self.bn(left) + i64(1) + self.bn(cur))
            self.setCnt(left, self.cntOf(left) + self.cntOf(cur))
        }
        self.dropChild(p, ci)
        self.freeNode(cur)
    }

    /* Merge the right sibling into `cur` and drop the separator. `cur` keeps its identity, so the
     * caller may still refresh the separator above it. */
    fn mergeRight(self: mut ref map<K, V>, p: i32, ci: i64) {
        let cur: i32 = self.kd(p, ci)
        let right: i32 = self.kd(p, ci + i64(1))
        if self.leafOf(cur) {
            var j: i64 = i64(0)
            while j < self.bn(right) {
                self.setKey(cur, self.bn(cur) + j, self.kn(right, j))
                self.setVal(cur, self.bn(cur) + j, self.vn(right, j))
                j = j + i64(1)
            }
            self.setN(cur, self.bn(cur) + self.bn(right))
            self.setCnt(cur, self.cntOf(cur) + self.cntOf(right))
            self.setNext(cur, self.nx(right))
        } else {
            self.setKey(cur, self.bn(cur), self.kn(p, ci))
            var j: i64 = i64(0)
            while j < self.bn(right) {
                self.setKey(cur, self.bn(cur) + i64(1) + j, self.kn(right, j))
                j = j + i64(1)
            }
            var jc: i64 = i64(0)
            while jc <= self.bn(right) {
                self.setKid(cur, self.bn(cur) + i64(1) + jc, self.kd(right, jc))
                jc = jc + i64(1)
            }
            self.setN(cur, self.bn(cur) + i64(1) + self.bn(right))
            self.setCnt(cur, self.cntOf(cur) + self.cntOf(right))
        }
        var k: i64 = ci
        while k + i64(1) < self.bn(p) {
            self.setKey(p, k, self.kn(p, k + i64(1)))
            k = k + i64(1)
        }
        var kc: i64 = ci + i64(1)
        while kc + i64(1) <= self.bn(p) {
            self.setKid(p, kc, self.kd(p, kc + i64(1)))
            kc = kc + i64(1)
        }
        self.setN(p, self.bn(p) - i64(1))
        self.freeNode(right)
    }

    /* ---------------------------------------------------------------- remove */
    /* Stage 2a: take the entry out and fix the counts. No rebalancing yet, so a leaf can end up
     * under HALF entries -- every query stays correct, the tree only gets sparse. */
    fn remove(self: mut ref map<K, V>, k: K) -> bool {
        var id: i32 = self.root
        self.depth = i64(0)
        while !self.leafOf(id) {
            let c = self.childSlot(id, k)
            self.path[self.depth] = id
            self.side[self.depth] = i32(c)
            self.depth = self.depth + i64(1)
            id = self.kd(id, c)
        }
        let at = self.lowerIn(id, k)
        if at >= self.bn(id) { return false }
        if k < self.kn(id, at) { return false }
        var j: i64 = at
        while j + i64(1) < self.bn(id) {
            self.setKey(id, j, self.kn(id, j + i64(1)))
            self.setVal(id, j, self.vn(id, j + i64(1)))
            j = j + i64(1)
        }
        self.setN(id, self.bn(id) - i64(1))
        self.setCnt(id, self.cntOf(id) - i64(1))
        self.n = self.n - i64(1)
        var d: i64 = self.depth - i64(1)
        while d >= i64(0) {
            let p = self.path[d]
            self.setCnt(p, self.cntOf(p) - i64(1))
            d = d - i64(1)
        }
        /* Walk up: refresh the separator that bounds this subtree (its smallest key may have
         * gone), and rebalance a node that fell under HALF entries -- borrow from a sibling that
         * can spare one, otherwise merge. A merge removes a key from the parent, so the parent is
         * rebalanced on the next turn of this loop. */
        var cur: i32 = id
        var level: i64 = self.depth
        while level > i64(0) {
            let p = self.path[level - i64(1)]
            let ci = i64(self.side[level - i64(1)])
            if self.bn(cur) < HALF {
                if ci > i64(0) && self.bn(self.kd(p, ci - i64(1))) > HALF {
                    self.borrowLeft(p, ci)
                    if ci > i64(0) { self.setKey(p, ci - i64(1), self.subMinKey(cur)) }
                } else if ci < self.bn(p) && self.bn(self.kd(p, ci + i64(1))) > HALF {
                    self.borrowRight(p, ci)
                } else if ci > i64(0) {
                    /* `cur` is freed by this: nothing to refresh above it, the separator went
                     * away with it. */
                    self.mergeLeft(p, ci)
                } else {
                    self.mergeRight(p, ci)
                }
            } else {
                if ci > i64(0) { self.setKey(p, ci - i64(1), self.subMinKey(cur)) }
            }
            cur = p
            level = level - i64(1)
        }
        /* The root may have lost its last key, or become an empty leaf's parent: the tree gets
         * shorter and the retired root goes back to the free list. */
        while !self.leafOf(self.root) && self.bn(self.root) == i64(0) {
            let old: i32 = self.root
            self.root = self.kd(old, i64(0))
            self.freeNode(old)
        }
        return true
    }

    /* Hand the container's runtime pool back (the map and its pool are born together, exactly as
     * `vector` / `string` / `hashMap` do). The check is on the birth generation, so a stale copy of
     * a released map cannot drop somebody else's pool. */
    /* **守卫**：这一份有序表值还指着它的池吗？陈旧 ⇒ 四处存储收空，下一次访问带位置地 trap。 */
    fn pStale(self: ref map<K, V>) -> bool {
        if self.pid < i64(0) { return false }
        return syspool::extc_pool_generation(self.pid) != self.pidGen
    }
    fn pPoison(self: mut ref map<K, V>) {
        self.nodes = poolSlice<bnode<K, V>>(i64(-1), i64(0))
        self.keys  = poolSlice<K>(i64(-1), i64(0))
        self.vals  = poolSlice<V>(i64(-1), i64(0))
        self.kids  = poolSlice<i32>(i64(-1), i64(0))
        self.nnodes = i64(0)
        self.ncap   = i64(0)
        self.n      = i64(0)
        self.pid    = i64(-1)
    }

    fn release(self: mut ref map<K, V>) {
        if self.pid < i64(0) { return }
        if syspool::extc_pool_generation(self.pid) != self.pidGen {
            self.pid = i64(-1)
            return
        }
        syspool::extc_pool_reset(self.pid)
        syspool::extc_pool_drop(self.pid)
        self.pid = i64(-1)
    }

    /* Lower the water mark: repack the LIVE nodes into ids 0..k-1, drop the free list and reallocate
     * the stores at exactly that size. Order, capacity and every entry stay where they were.
     *
     * 存储在自己的板块上，所以这一下**真的是 RSS**：旧四块当场还给池（arena 那条"只能整块还"
     * 的限制在这里不适用）。 Note the deviation from the plan's wording: the tree does NOT keep values behind pool
     * handles. The stores already give what those handles were for (relocatable, contiguous,
     * index-addressed storage), and a handle in every leaf would add an indirection per read for no
     * gain -- the surface exposes entries, never element identities. */
    fn shrink(self: mut ref map<K, V>) {
        var order:   mut slice<i32> = new i32[self.nnodes]   /* live nodes in DFS order = new ids */
        var old2new: mut slice<i32> = new i32[self.nnodes]
        var i: i64 = i64(0)
        while i < self.nnodes {
            old2new[i] = i32(-1)
            i = i + i64(1)
        }
        var count: i64 = i64(1)
        order[i64(0)] = self.root
        old2new[i64(self.root)] = i32(0)
        var head: i64 = i64(0)
        while head < count {
            let id = order[head]
            if !self.leafOf(id) {
                var c: i64 = i64(0)
                while c <= self.bn(id) {
                    let ch = self.kd(id, c)
                    order[count] = ch
                    old2new[i64(ch)] = i32(count)
                    count = count + i64(1)
                    c = c + i64(1)
                }
            }
            head = head + i64(1)
        }
        /* `order` / `old2new` 是这次调用的临时草稿：随方法那个块一起回收，正是 arena 的活。
         * 四处长期存储则从池拿新块、旧的还回去。 */
        var nk: mut slice<K>   = poolSlice<K>(self.pid, count * i64(17))
        var nv: mut slice<V>   = poolSlice<V>(self.pid, count * i64(17))
        var nc: mut slice<i32> = poolSlice<i32>(self.pid, count * i64(18))
        var nn: mut slice<bnode<K, V>> = poolSlice<bnode<K, V>>(self.pid, count)
        i = i64(0)
        while i < count {
            let src = i64(order[i])
            let kb  = i * i64(17)
            let cb  = i * i64(18)
            let skb = src * i64(17)
            let scb = src * i64(18)
            var j: i64 = i64(0)
            while j < i64(17) {
                nk[kb + j] = self.keys[skb + j]
                nv[kb + j] = self.vals[skb + j]
                j = j + i64(1)
            }
            j = i64(0)
            while j < i64(18) {
                var kid: i32 = self.kids[scb + j]
                if kid >= i32(0) { kid = old2new[i64(kid)] }
                nc[cb + j] = kid
                j = j + i64(1)
            }
            var nd: bnode<K, V> = self.nodes[src]
            nd.keys = nk[kb..kb + i64(17)]
            nd.vals = nv[kb..kb + i64(17)]
            nd.kids = nc[cb..cb + i64(18)]
            nn[i] = nd
            i = i + i64(1)
        }
        /* The DFS visits leaves left to right, so the chain is rebuilt in the same pass. */
        var prev: i32 = i32(-1)
        i = i64(0)
        while i < count {
            if self.leafOf(order[i]) {
                if prev >= i32(0) { nn[i64(prev)].next = i32(i) }
                prev = i32(i)
            }
            i = i + i64(1)
        }
        if prev >= i32(0) { nn[i64(prev)].next = i32(-1) }
        poolGive<bnode<K, V>>(self.pid, self.nodes)
        poolGive<K>(self.pid, self.keys)
        poolGive<V>(self.pid, self.vals)
        poolGive<i32>(self.pid, self.kids)
        self.keys   = nk
        self.vals   = nv
        self.kids   = nc
        self.nodes  = nn
        self.nnodes = count
        self.ncap   = count
        self.freeHead = i32(-1)
        self.root   = i32(0)
    }

    fn clear(self: mut ref map<K, V>) {
        self.nnodes = i64(0)
        self.n = i64(0)
        self.root = self.newNode(true)
    }
}
