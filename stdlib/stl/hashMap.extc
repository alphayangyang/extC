/* std/map.extc -- an **open-addressing hash map** from `i64` keys to any `V`.
 *
 * Why this exists (and why it is not a slot map): the measurements in
 * `docs/topics/REGIONS.md` section 10.2 say that a handle costs **three dependent random
 * loads** (handle array -> metadata -> value) while a hash lookup costs **one** after the
 * probe. Random access is the common case, so key -> value wants a hash table and stable
 * identity wants `std::pool`; neither replaces the other.
 *
 * ⚠️ The key is `i64` and the **value** is the generic parameter. extC has no traits, so a
 * generic `K` could not be hashed here: there is no way to call `k.hash()` on a type
 * parameter, and a hash "witness" struct would hit the same wall (`H::hash` on a type
 * parameter does not resolve either). Concrete keys are the honest answer today; an
 * `i64` key packs two `i32`s, a `pool` handle, or an offset in a string table, which
 * covers what a graph or an interpreter needs. A byte-view keyed map is the next family.
 *
 * Layout, and why:
 *   - **linear probing** (one cache line per probe, no pointers at all);
 *   - `cap` is a power of two, so the probe index is `hash & (cap-1)` -- no division;
 *   - the hash mixes with shifts and xors only: `*` on `i64` can overflow, and overflow is
 *     not something this language leaves undefined, so the mixing must not rely on it;
 *   - a slot is empty / live / tombstone in a separate byte array. Tombstones keep probes
 *     correct after a removal; they are cleared by a rebuild, which also happens when too
 *     many of them pile up;
 *   - the arrays are arena memory like everything else: rehashing leaves the old arrays
 *     behind (bounded, O(log n) rebuilds over a map's life) and a pool will reclaim them
 *     in phase 1+ (`docs/topics/REGIONS.md` section 8).
 */

use stl::pool
use std::sys::pool as syspool    /* 运行期池记录：本容器自己的那一只，值池以它为父 */

let EMPTY: u8 = 0
let LIVE:  u8 = 1
let TOMB:  u8 = 2

/* Mix a key into a spread-out non-negative i64, using only shifts and xors. */
fn hashI64(k: i64) -> i64 {
    var x = k & i64(9223372036854775807)          /* drop the sign bit: `>>` on a negative is not ours to define */
    x = x ^ (x >> i64(21))
    x = x ^ (x >> i64(42))
    return x
}

@sharesStorage        /* 按值拷贝时**两份共用同一块板块** ⇒ 编译器在这里报警告，要独立副本用 `clone()` */
@poolObject            /* 这个类型**拥有一个池**：存储住在池自己的板块上，寿命随它所在的地方 */
struct hashMap<K, V> {
    /* This container's OWN pool record. One non-nested container = one pool (POOLS.md 7.7);
     * `vals` is created with this as its parent, so the two records really form a tree and
     * dropping this one takes the value pool with it. */
    pid:    i64
    pidGen: u64
    keys: mut slice<K>          /* the bucket's key (live buckets only) */
    tag:  mut slice<u8>         /* EMPTY / LIVE / TOMB */
    slot: mut slice<i32>        /* bucket -> dense index inside `vals` (-1 when not live) */
    /* The reverse of `slot`, one entry per dense index. The pool's `remove` is a swap-remove:
     * the last live value moves into the hole, so the map has to fix the moved element's bucket,
     * and this column is what says which bucket that is. Without it the table would keep pointing
     * at values that moved (POOLS.md section 8). */
    bucketOfDense: mut slice<i32>
    vals: pool<V>               /* the values themselves: dense, reusable, handle-addressed */
    n:    i64                   /* live entries */
    dead: i64                   /* tombstones */
    cap:  i64                   /* always a power of two */

    /* A map with room for `want` entries before the first rebuild. */
    fn withCap(want: i64) -> hashMap<K, V> {
        var c: i64 = i64(8)
        while c < want * i64(2) { c = c * i64(2) }
        let rp  = syspool::extc_pool_new(i64(-1))
        let rpg = syspool::extc_pool_generation(rp)
        var m: hashMap<K, V> = {
            pid:    rp,
            pidGen: rpg,
            /* 四列都在**这张表自己的池板块**上（不是 arena 切片）：重建时旧的几块当场
             * 还回去，不留历代旧列。之前用 `new` 时，每一次 rebuild 都把上一代的四列
             * 留给 arena —— 同容量同条目数下峰值 90,412 KB vs 69,036 KB，那 30% 就是它们。 */
            keys: poolSlice<K>(rp, c),
            tag:  poolSlice<u8>(rp, c),
            slot: poolSlice<i32>(rp, c),
            bucketOfDense: poolSlice<i32>(rp, c),
            vals: pool<V>::withParent(rp, c),      /* 值池以这个容器自己的池为父 */
            n:    i64(0),
            dead: i64(0),
            cap:  c,
        }
        return m
    }

    fn len(self: ref hashMap<K, V>) -> i64 { return self.n }
    fn capOf(self: ref hashMap<K, V>) -> i64 { return self.cap }
    /* 本表运行期池的下标（只读读数）：容量与字节账的判据要指到**这一只**池上。 */
    fn pidOf(self: ref hashMap<K, V>) -> i64 { return self.pid }

    /* 这张表**当下**在它自己池里占的字节（四列 + 值池）。
     * 判据：`rebuild` 把旧列当场还了 ⇒ 这个数只随当前 `cap` 走，与重建过多少次无关；
     * 若旧列还留着，它会大一整代（见 tests/hashmap/run.sh）。 */
    fn bytesOf(self: ref hashMap<K, V>) -> i64 { return syspool::extc_pool_bytes(self.pid) }

    /* Find the bucket holding `k`: live bucket index, or -1 when absent. */
    fn find(self: ref hashMap<K, V>, k: K) -> i64 {
        var i = k.hash() & (self.cap - i64(1))
        var steps: i64 = 0
        while steps < self.cap {
            let t = self.tag[i]
            if t == EMPTY { return i64(-1) }
            if t == LIVE && self.keys[i] == k { return i }
            i = (i + i64(1)) & (self.cap - i64(1))
            steps = steps + i64(1)
        }
        return i64(-1)
    }

    fn contains(self: ref hashMap<K, V>, k: K) -> bool { return self.find(k) >= i64(0) }

    /* `hm[k]` -- the read side of the subscript syntax (`[]` and `[]=` are independent names, so
     * a type may offer reading without writing). Same answer as `get`: `none` when absent. */
    fn [](self: ref hashMap<K, V>, k: K) -> ?V { return self.get(k) }

    /* The value for `k`, or `none`. */
    fn get(self: ref hashMap<K, V>, k: K) -> ?V {
        let b = self.find(k)
        if b < i64(0) { return none }
        return self.vals.get(self.vals.handleAtDense(i64(self.slot[b])))
    }

    /* Insert or overwrite. Returns true when the key was already there. */
    /* `hm[k] = v` -- the write side (`[]` and `[]=` are independent names). Same semantics as
     * `put`: insert when absent, overwrite when present. */
    fn []=(self: mut ref hashMap<K, V>, k: K, v: V) -> bool { return self.put(k, v) }

    fn put(self: mut ref hashMap<K, V>, k: K, v: V) -> bool {
        if self.pStale() { self.pPoison() }
        let had = self.find(k)
        if had >= i64(0) {
            self.vals.set(self.vals.handleAtDense(i64(self.slot[had])), v)
            return true
        }
        /* Rebuild *before* inserting, while there is still a free bucket to land in. */
        if (self.n + self.dead + i64(1)) * i64(10) >= self.cap * i64(7) { self.rebuild(self.cap * i64(2)) }
        var i = k.hash() & (self.cap - i64(1))
        while self.tag[i] == LIVE {
            i = (i + i64(1)) & (self.cap - i64(1))
        }
        if self.tag[i] == TOMB { self.dead = self.dead - i64(1) }
        let h = self.vals.insert(v)
        let d = self.vals.len() - i64(1)
        self.tag[i]  = LIVE
        self.keys[i] = k
        self.slot[i] = i32(d)
        self.bucketOfDense[d] = i32(i)
        self.n = self.n + i64(1)
        return false
    }

    /* Remove `k`. Returns true when it was there. The bucket becomes a tombstone so other
     * probes still find what is behind it. */
    fn remove(self: mut ref hashMap<K, V>, k: K) -> bool {
        let b = self.find(k)
        if b < i64(0) { return false }
        let d      = i64(self.slot[b])
        let last   = self.vals.len() - i64(1)
        let bMoved = i64(self.bucketOfDense[last])
        let gone   = self.vals.remove(self.vals.handleAtDense(d))
        /* The pool filled the hole with the last live value; point that element's bucket at its
         * new dense index, or a later lookup would read somebody else's value. */
        if d != last {
            self.slot[bMoved] = i32(d)
            self.bucketOfDense[d] = i32(bMoved)
        }
        self.tag[b] = TOMB
        self.n    = self.n - i64(1)
        self.dead = self.dead + i64(1)
        return gone
    }

    /* Rehash into a table of `ncap` buckets (a power of two), dropping the tombstones. The values
     * are not touched: they stay exactly where the pool put them, which is what keeps an element's
     * dense index (and every live handle) valid across a rebuild. */
    fn rebuild(self: mut ref hashMap<K, V>, ncap: i64) {
        /* 新表从池里拿四块，旧的填完当场还（`poolGive`）—— 于是重建只在**换的那一瞬间**
         * 有两代同时在手，稳态永远只有一代。容量仍然翻倍：这是**哈希**的要求（探测用
         * `hash & (cap-1)`，必须是 2 的幂），与"旧块还不了才翻倍"那条无关。 */
        var nk: mut slice<K>   = poolSlice<K>(self.pid, ncap)
        var nt: mut slice<u8>  = poolSlice<u8>(self.pid, ncap)
        var ns: mut slice<i32> = poolSlice<i32>(self.pid, ncap)
        /* `bucketOfDense` is indexed by DENSE index, so it has to hold as many entries as there
         * are values -- and the pool's dense side grows past the old table capacity as soon as
         * the table doubles. It used to keep its original length and the first rebuild after a
         * growth wrote past its end (trapped: "index 128 out of range (length 128)"). Copy the
         * live prefix into the larger array first; the rehash below fills the rest. */
        /* `bucketOfDense` 是**稠密下标**索引的（位置与容量无关）⇒ 直接加长：内容原地保留，
         * 那趟前缀拷贝整段删掉。另外三列做不到这件事 —— 桶号 `h & (cap-1)` 随 cap 变，
         * 每个元素的位置都变，O(n) 重排是哈希扩容语义的一部分（出路见 PLAN #86：两块表 + 按簇增量）。
         * `bucketOfDense` 的长度仍要是 ncap：池的稠密侧会随表一起长过旧容量，
         * 早先留着旧长度的那版在第一次长表后写越界过（`index 128 out of range (length 128)`）。 */
        self.bucketOfDense = poolResize<i32>(self.pid, self.bucketOfDense, ncap)
        var i: i64 = 0
        while i < self.cap {
            if self.tag[i] == LIVE {
                var j = self.keys[i].hash() & (ncap - i64(1))
                while nt[j] == LIVE { j = (j + i64(1)) & (ncap - i64(1)) }
                nt[j] = LIVE
                nk[j] = self.keys[i]
                ns[j] = self.slot[i]
                self.bucketOfDense[i64(self.slot[i])] = i32(j)
            }
            i = i + i64(1)
        }
        poolGive<K>(self.pid, self.keys)
        poolGive<u8>(self.pid, self.tag)
        poolGive<i32>(self.pid, self.slot)
        self.keys = nk
        self.tag  = nt
        self.slot = ns
        self.cap  = ncap
        self.dead = i64(0)
    }

    /* Drop every entry, keeping the capacity. `clear` on the pool is O(1) (it flips the pool
     * epoch, see POOLS.md section 7), so the values cost nothing here. */
    fn clear(self: mut ref hashMap<K, V>) {
        var i: i64 = 0
        while i < self.cap { self.tag[i] = EMPTY  i = i + i64(1) }
        self.vals.clear()
        self.n    = i64(0)
        self.dead = i64(0)
    }

    /* Hand the value pool back: the container and its pool are born together. */
    /* 整棵池树还回去：先放值池（它的三块视图会被收成 0 长），再放这个容器自己的记录。
     * 父池的递归本来也会带走子池，两处都做不冲突：谁先到谁放，后到的查不到活记录就跳过。 */
    /* **守卫**：这一份哈希表值还指着它的池吗？陈旧 ⇒ 四列收空，下一次访问带位置地 trap。 */
    fn pStale(self: ref hashMap<K, V>) -> bool {
        if self.pid < i64(0) { return false }
        return syspool::extc_pool_generation(self.pid) != self.pidGen
    }
    fn pPoison(self: mut ref hashMap<K, V>) {
        self.keys = poolSlice<K>(i64(-1), i64(0))
        self.tag  = poolSlice<u8>(i64(-1), i64(0))
        self.slot = poolSlice<i32>(i64(-1), i64(0))
        self.bucketOfDense = poolSlice<i32>(i64(-1), i64(0))
        self.n    = i64(0)
        self.dead = i64(0)
        self.cap  = i64(0)
        self.pid  = i64(-1)
    }

    fn release(self: mut ref hashMap<K, V>) {
        self.vals.release()
        if self.pid < i64(0) { return }
        if syspool::extc_pool_generation(self.pid) != self.pidGen {
            self.pid = i64(-1)                             /* 陈旧拷贝：槽位已被别的池复用 */
            return
        }
        syspool::extc_pool_reset(self.pid)
        syspool::extc_pool_drop(self.pid)
        self.pid = i64(-1)
    }

    /* Scan by bucket position (the face the first version had). */
    fn keyAt(self: ref hashMap<K, V>, i: i64) -> K { return self.keys[i] }
    fn valAt(self: ref hashMap<K, V>, i: i64) -> V { return self.vals.atDense(i64(self.slot[i])) }
    fn liveAt(self: ref hashMap<K, V>, i: i64) -> bool { return self.tag[i] == LIVE }

    /* Scan the dense side: every live value once, in the pool's own order -- no probing and no
     * holes. This is the face a hot loop wants. */
    fn denseLen(self: ref hashMap<K, V>) -> i64 { return self.vals.len() }
    fn keyAtDense(self: ref hashMap<K, V>, d: i64) -> K { return self.keys[i64(self.bucketOfDense[d])] }
    fn valAtDense(self: ref hashMap<K, V>, d: i64) -> V { return self.vals.atDense(d) }

    /* **深拷贝：要一份独立的表就用它。** `var b = a` 是结构体逐成员拷贝（共用板块）⇒
     * 改 b 会改到 a、a.release() 会让 b 悬垂。这里显式拷一份（O(n) + 一块新板块）。 */
    fn clone(self: ref hashMap<K, V>) -> hashMap<K, V> {
        var out = hashMap<K, V>::withCap(self.n + i64(1))
        var d: i64 = 0
        while d < self.denseLen() {
            out.put(self.keyAtDense(d), self.valAtDense(d))
            d = d + i64(1)
        }
        return out
    }
}

/* ---------------------------------------------------------------------------
 * The integer fast path: a key wrapper, NOT a second table.
 *
 * `hashMap<K, V>` asks its key for `hash()` and `==`, so an `i64` key has to get those two
 * methods from somewhere. Methods live inside a `struct` and `i64` is built in, so there is
 * nowhere to write them -- hence the wrapper. `i64Key` carries the original `hashI64` mix and
 * `==`; `hashMapI64<V>` is a thin adapter that keeps the `i64`-keyed face this container had
 * before the key became a type parameter.
 *
 * Why not a second table for `i64` keys: hashing, linear probing, tombstones and the rebuild
 * threshold are the parts that are easy to get wrong, and two copies of them drift -- one gets
 * a fix, the other silently keeps the bug. One table, one place to fix. The wrapper costs
 * nothing: an `i64Key` is one `i64`.
 * --------------------------------------------------------------------------- */

struct i64Key {
    v: i64

    /* The mix the table used before it took a key type parameter. */
    fn hash(self: ref i64Key) -> i64 { return hashI64(self.v) }

    fn ==(self: ref i64Key, other: i64Key) -> bool { return self.v == other.v }
}

/* The `i64`-keyed face: what `hashMapI64<V>` always was, now one conversion deep. */
@sharesStorage        /* 按值拷贝时**两份共用同一块板块** ⇒ 编译器在这里报警告，要独立副本用 `clone()` */
struct hashMapI64<V> {
    m: hashMap<i64Key, V>

    fn withCap(want: i64) -> hashMapI64<V> {
        var h: hashMapI64<V> = { m: hashMap<i64Key, V>::withCap(want) }
        return h
    }

    fn len(self: ref hashMapI64<V>) -> i64 { return self.m.len() }
    fn capOf(self: ref hashMapI64<V>) -> i64 { return self.m.capOf() }
    fn bytesOf(self: ref hashMapI64<V>) -> i64 { return self.m.bytesOf() }
    fn clone(self: ref hashMapI64<V>) -> hashMapI64<V> {
        var h: hashMapI64<V> = { m: self.m.clone() }
        return h
    }
    fn pidOf(self: ref hashMapI64<V>) -> i64 { return self.m.pidOf() }

    fn [](self: ref hashMapI64<V>, k: i64) -> ?V { return self.get(k) }

    fn contains(self: ref hashMapI64<V>, k: i64) -> bool {
        return self.m.contains(i64Key { v: k })
    }

    fn get(self: ref hashMapI64<V>, k: i64) -> ?V { return self.m.get(i64Key { v: k }) }

    fn []=(self: mut ref hashMapI64<V>, k: i64, v: V) -> bool { return self.put(k, v) }

    fn put(self: mut ref hashMapI64<V>, k: i64, v: V) -> bool {
        return self.m.put(i64Key { v: k }, v)
    }

    fn remove(self: mut ref hashMapI64<V>, k: i64) -> bool { return self.m.remove(i64Key { v: k }) }

    fn clear(self: mut ref hashMapI64<V>) { self.m.clear() }

    /* 整棵池树还回去（本容器自己的池 + 值池） */
    fn release(self: mut ref hashMapI64<V>) { self.m.release() }

    /* The dense face (`hashMap`'s own face): every live value once, in insertion order, no
     * probing and no holes -- the reason the values live in a pool at all. */
    fn denseLen(self: ref hashMapI64<V>) -> i64 { return self.m.denseLen() }
    fn keyAtDense(self: ref hashMapI64<V>, d: i64) -> i64 { return self.m.keyAtDense(d).v }
    fn valAtDense(self: ref hashMapI64<V>, d: i64) -> V { return self.m.valAtDense(d) }

    fn keyAt(self: ref hashMapI64<V>, i: i64) -> i64 { return self.m.keyAt(i).v }
    fn valAt(self: ref hashMapI64<V>, i: i64) -> V { return self.m.valAt(i) }
    fn liveAt(self: ref hashMapI64<V>, i: i64) -> bool { return self.m.liveAt(i) }
}
