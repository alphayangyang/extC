/* stl/linmap.extc -- a **linear** `K -> V` map: no hashing, only `==` on the key.
 *
 * Why this exists, and how it differs from `std::map`: `hashMapI64<V>` hashes, so it needs a
 * key that is already an `i64` -- the compiler cannot call `hash()` on a type parameter
 * (there are no traits), so a hashed `map<K, V>` is not writable yet. A **linear** map
 * needs nothing but `==` on `K`, and `==` on a type parameter *is* supported: it is
 * checked once per instance, so `linMap<i64, ...>` uses the builtin and
 * `linMap<point, ...>` needs `fn ==` on `point`, with the diagnostic naming the instance.
 *
 *     use stl::linmap
 *     var m: linMap<i64, slice<u8>> = linMap<i64, slice<u8>>::withCap(4)
 *     m.put(i64(1), "one")
 *     println(m.get(i64(1)) ?? "missing")
 *
 * Cost, stated plainly: a lookup is O(n) probes with `==` each, against O(1) for the
 * hashed `hashMapI64`. Use this while keys are not integers and the table is small; switch to
 * `hashMapI64` (packing the key into an `i64`) when it is not.
 *
 * Layout and the rules it follows:
 *   - **dense and in insertion order**: entries live in the front of two parallel views,
 *     so walking the table is a linear scan over memory, not a walk over a probe table;
 *   - `remove` is a **swap-remove**: the last entry fills the hole, so the order of the
 *     remaining entries is not preserved (the same trade `std::pool` makes, and the reason
 *     `atDense` is a valid name for the accessor);
 *   - growth doubles, and the old arrays are left to the arena (`stl/linmap` cannot free;
 *     a pool will reclaim them, see `docs/topics/POOLS.md`);
 *   - indices returned by `find` are **positions**, valid only until the next `put` or
 *     `remove`; `keyAt` / `valAt` are what they are for.
 */
use std::io
use std::sys::pool as syspool    /* 运行期池记录 + 板块原语：这张表的两个视图住在自己的板块上 */

/* A `K -> V` table searched linearly. */
@sharesStorage        /* 按值拷贝时**两份共用同一块板块** ⇒ 编译器在这里报警告，要独立副本用 `clone()` */
@poolObject            /* 这个类型**拥有一个池**：存储住在池自己的板块上，寿命随它所在的地方 */
struct linMap<K, V> {
    pid:    i64            /* 这张表自己的池记录（一个非嵌套容器 = 一个池）*/
    pidGen: u64
    keys: mut slice<K>
    vals: mut slice<V>
    n:    i64              /* live entries, always the front `n` of both views */
    cap:  i64

    /* A table with room for `want` entries before the first growth. */
    fn withCap(want: i64) -> linMap<K, V> {
        var c: i64 = i64(4)
        while c < want { c = c * i64(2) }
        let rp  = syspool::extc_pool_new(i64(-1))
        let rpg = syspool::extc_pool_generation(rp)
        /* 两个视图在**这张表自己的板块**上：增长时同一块加长，旧的不会留给 arena。 */
        var lm: linMap<K, V> = {
            pid: rp, pidGen: rpg,
            keys: poolSliceRaw<K>(rp, c), vals: poolSliceRaw<V>(rp, c),
            n: i64(0), cap: c,
        }
        return lm
    }

    fn len(self: ref linMap<K, V>) -> i64 { return self.n }
    fn capOf(self: ref linMap<K, V>) -> i64 { return self.cap }

    /* Where the key sits, or -1. Linear, and that is the whole point of this container:
     * `==` on a type parameter is the only thing a key has to provide. */
    fn find(self: ref linMap<K, V>, k: K) -> i64 {
        var i: i64 = 0
        while i < self.n {
            if self.keys[i] == k { return i }
            i = i + 1
        }
        return 0 - i64(1)
    }

    fn contains(self: ref linMap<K, V>, k: K) -> bool { return self.find(k) >= i64(0) }

    /* Write the pair, overwriting a key that is already there.
     *
     * Returns false only when the table could not grow, which needs the arena to be out of
     * memory -- `new` traps before that can happen, so a `false` here is unreachable today
     * and the signature keeps the door open for a grow that can fail. */
    /* `lm[k] = v` -- the write side; same semantics as `put` (insert or overwrite). */
    fn []=(self: mut ref linMap<K, V>, k: K, v: V) -> bool { return self.put(k, v) }

        fn put(self: mut ref linMap<K, V>, k: K, v: V) -> bool {
            if self.pStale() { self.pPoison() }
        let at = self.find(k)
        if at >= i64(0) {
            self.vals[at] = v
            return true
        }
        if self.n >= self.cap { self.grow() }
        if self.n >= self.cap { return false }
        self.keys[self.n] = k
        self.vals[self.n] = v
        self.n = self.n + i64(1)
        return true
    }

    /* The value for a key, or `none`. Reading through the option is what the type
     * parameter makes possible: `?V` where `V` is itself a parameter is an ordinary
     * generic enum instance. */
    /* `lm[k]` -- read side of the subscript syntax; `none` when the key is absent. */
    fn [](self: ref linMap<K, V>, k: K) -> ?V { return self.get(k) }

    fn get(self: ref linMap<K, V>, k: K) -> ?V {
        let at = self.find(k)
        if at < i64(0) { return none }
        return some(self.vals[at])
    }

    /* Drop the entry for a key. The last entry takes its place (swap-remove). */
    fn remove(self: mut ref linMap<K, V>, k: K) -> bool {
        let at = self.find(k)
        if at < i64(0) { return false }
        let last = self.n - i64(1)
        self.keys[at] = self.keys[last]
        self.vals[at] = self.vals[last]
        self.n = last
        return true
    }

    /* Entry `i` in insertion order -- until a `remove`, which moves the last entry
     * there. These are the accessors to use with `len`. */
    fn keyAt(self: ref linMap<K, V>, i: i64) -> K { return self.keys[i] }
    fn valAt(self: ref linMap<K, V>, i: i64) -> V { return self.vals[i] }
    /* **深拷贝**（同 vector/map：`var b = a` 是结构体逐成员拷贝、两份共用板块）。 */
    fn clone(self: ref linMap<K, V>) -> linMap<K, V> {
        var out = linMap<K, V>::withCap(self.n + i64(1))
        var i: i64 = 0
        while i < self.n {
            out.put(self.keyAt(i), self.valAt(i))
            i = i + i64(1)
        }
        return out
    }

    fn clear(self: mut ref linMap<K, V>) { self.n = i64(0) }

    /* 增到 1.5 倍：**在原块上加长**（`poolResize` 保住内容）。这里连拷贝循环都不需要 ——
     * 这张表的下标就是插入序，加长不改变任何已有元素的位置。 */
    fn grow(self: mut ref linMap<K, V>) {
        let c = self.cap + self.cap / i64(2)
        self.keys = poolResizeRaw<K>(self.pid, self.keys, c)
        self.vals = poolResizeRaw<V>(self.pid, self.vals, c)
        self.cap = c
    }

    /* 把这一层还回去：两个视图先收成 0 长，再把板块还给池（之后越界是响亮 trap）。 */
    /* **守卫**：这一份线性表值还指着它的池吗？陈旧 ⇒ 两个视图收空，下一次访问带位置地 trap。 */
    @private fn pStale(self: ref linMap<K, V>) -> bool {
        if self.pid < i64(0) { return false }
        return syspool::extc_pool_generation(self.pid) != self.pidGen
    }
    @private fn pPoison(self: mut ref linMap<K, V>) {
        self.keys = poolSlice<K>(i64(-1), i64(0))
        self.vals = poolSlice<V>(i64(-1), i64(0))
        self.n    = i64(0)
        self.cap  = i64(0)
        self.pid  = i64(-1)
    }

    fn release(self: mut ref linMap<K, V>) {
        if self.pid < i64(0) { return }
        /* One staleness question, one place to ask it (`pStale`): the inline copy of this
         * compare used to live here too, and two copies of a load-bearing check drift. */
        if self.pStale() {
            self.pid = i64(-1)  /* 陈旧拷贝：槽位已被别的池复用 */
            return
        }
        self.keys = poolResize<K>(self.pid, self.keys, i64(0))
        self.vals = poolResize<V>(self.pid, self.vals, i64(0))
        self.cap  = i64(0)
        syspool::extc_pool_reset(self.pid)
        syspool::extc_pool_drop(self.pid)
        self.pid = i64(-1)
    }
}
