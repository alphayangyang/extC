/* stl/nd.extc —— N 维 strided 视图：一个 buffer + 每维 extent/stride
 *
 * **一件事**：N 维数组在内存里是「一块连续存储 + 每维的长度与步长」。把这条写成一个类型
 * （`ndview<T>`）之后，连续数组、转置、切片、行/列/面视图都是同一类型的不同描述符，所有
 * 视图操作只改描述符、不搬元素。
 *
 * **为什么不是 `slice<slice<T>>`**：嵌套切片的每一层是另一个 buffer 或指向别处的描述符，
 * 遍历时每行都要跳一次地址，预取器跟不住。这里的布局是单一 buffer + 步长，行主序时
 * 最内层步长是 1，N 维遍历在内存里仍是一条流。
 *
 * **rank 是描述符里的运行期值**（上限 8）：这样三维、四维不需要给类型系统加整数泛型；
 * 代价是跨函数边界后下标个数由运行期检查（越界仍是 trap 文案，与元素越界分开）。
 *
 * **行主序约定**：`contig` 生成的步长满足最内层为 1；归约、逐元素运算都按 idx[0] 变化最慢、
 * 最内层变化最快的顺序走，所以同一份数据永远得到同一个 bit 结果。
 *
 * **库不 trap**：形状为负、rank 越界、最远元素超出存储时返回 `none`；逐元素运算的形状不匹配
 * 返回 `false`。
 *
 * @code
 * use std::io
 * use stl::nd
 *
 * fn main() -> i32 {
 *     var a: ndarray<f64> = ndarray<f64>::zeros3(2, 3, 4) ?? ndarray<f64>::empty()
 *     var v: ndview<f64> = a.viewMut()
 *     nd::filled(v, 1.5)
 *     let s: f64 = nd::sumv(a.view()) ?? f64(0.0)
 *     if s > f64(35.0) { return 0 }
 *     return 1
 * }
 * @endcode
 */

/** @brief 拥有存储的 N 维数组：一块 arena 里的连续存储 + 每维长度（行主序，rank ≤ 8）。
 */
struct ndarray<T> {
    data: mut slice<T>
    rank: i64
    shape: [8]i64

    /** @brief 全零的 1 维数组。
     *  @param n 长度。
     *  @return 数组；`n` 为负时 `none`。
     */
    fn zeros1(n: i64) -> ?ndarray<T> {
        var sh: [8]i64
        sh[0] = n
        return ndarray<T>::allocate(1, sh)
    }

    /** @brief 全零的 2 维数组（行主序）。
     *  @param rows 行数。
     *  @param cols 列数。
     *  @return 数组；任一维为负时 `none`。
     */
    fn zeros2(rows: i64, cols: i64) -> ?ndarray<T> {
        var sh: [8]i64
        sh[0] = rows
        sh[1] = cols
        return ndarray<T>::allocate(2, sh)
    }

    /** @brief 全零的 3 维数组（行主序）。
     *  @param d0 第 0 维长度。
     *  @param d1 第 1 维长度。
     *  @param d2 第 2 维长度。
     *  @return 数组；任一维为负时 `none`。
     */
    fn zeros3(d0: i64, d1: i64, d2: i64) -> ?ndarray<T> {
        var sh: [8]i64
        sh[0] = d0
        sh[1] = d1
        sh[2] = d2
        return ndarray<T>::allocate(3, sh)
    }

    /** @brief 全零的 4 维数组（行主序）。
     *  @param d0 第 0 维长度。
     *  @param d1 第 1 维长度。
     *  @param d2 第 2 维长度。
     *  @param d3 第 3 维长度。
     *  @return 数组；任一维为负时 `none`。
     */
    fn zeros4(d0: i64, d1: i64, d2: i64, d3: i64) -> ?ndarray<T> {
        var sh: [8]i64
        sh[0] = d0
        sh[1] = d1
        sh[2] = d2
        sh[3] = d3
        return ndarray<T>::allocate(4, sh)
    }

    /** @brief 按 rank 与每维长度分配数组（长度全为 0）。
     *  @param rank 维数（1..8）。
     *  @param shape 每维长度。
     *  @return 数组；rank 越界、任一维为负、或总元素数为 0 以外的情况装不下时 `none`。
     */
    fn allocate(rank: i64, shape: [8]i64) -> ?ndarray<T> {
        if rank < 1 || rank > 8 { return none }
        var total: i64 = 1
        var k: i64 = 0
        while k < rank {
            if shape[k] < 0 { return none }
            total = total * shape[k]
            k = k + 1
        }
        var a: ndarray<T> = { data: new T[total], rank: rank, shape: shape }
        return some(a)
    }

    /** @brief 空数组（0 元素，rank 1；失败路径的兜底值）。
     *  @return 空数组。
     */
    fn empty() -> ndarray<T> {
        var sh: [8]i64
        var a: ndarray<T> = { data: new T[0], rank: 1, shape: sh }
        return a
    }

    /** @brief 行主序的只读视图（零拷贝）。
     *  @return 覆盖整块存储的视图。
     */
    fn view(self: ref ndarray<T>) -> ndview<T> {
        return ndview<T>::rowMajor(self.data, self.rank, self.shape)
    }

    /** @brief 行主序的可写视图（零拷贝）。
     *  @return 覆盖整块存储的视图。
     */
    fn viewMut(self: mut ref ndarray<T>) -> ndview<T> {
        return ndview<T>::rowMajor(self.data, self.rank, self.shape)
    }
}

/** @brief N 维 strided 视图：底层存储 + 起点 + 每维 extent 与 stride（元素为单位，rank ≤ 8）。
 */
struct ndview<T> {
    data: mut slice<T>
    off: i64
    rank: i64
    shape: [8]i64
    strides: [8]i64

    /** @brief 把一块连续存储看成行主序 N 维数组（零拷贝）。
     *  @param data 底层存储。
     *  @param rank 维数（1..8）。
     *  @param shape 每维长度。
     *  @return 视图；rank 越界、形状为负、或装不下时 `none`。
     */
    fn rowMajor(data: mut slice<T>, rank: i64, shape: [8]i64) -> ndview<T> {
        var st: [8]i64
        var acc: i64 = 1
        var k: i64 = rank - 1
        while k >= 0 {
            st[k] = acc
            acc = acc * shape[k]
            k = k - 1
        }
        var v: ndview<T> = { data: data, off: 0, rank: rank, shape: shape, strides: st }
        return v
    }

    /** @brief 从任意非负步长构造视图（转置、切片、步长索引都用它）。
     *  @param data 底层存储。
     *  @param off 第一个元素的偏移（元素为单位）。
     *  @param rank 维数（1..8）。
     *  @param shape 每维长度。
     *  @param strides 每维步长（元素为单位，非负）。
     *  @return 视图；rank 越界、形状/步长为负、或最远元素超出存储时 `none`。
     */
    fn strided(data: mut slice<T>, off: i64, rank: i64, shape: [8]i64, strides: [8]i64) -> ?ndview<T> {
        if rank < 1 || rank > 8 { return none }
        if off < 0 { return none }
        var last: i64 = off
        var any: bool = false
        var k: i64 = 0
        while k < rank {
            if shape[k] < 0 || strides[k] < 0 { return none }
            if shape[k] > 0 { any = true }
            last = last + (shape[k] - 1) * strides[k]
            k = k + 1
        }
        if any {
            if last >= data.len { return none }
        } else {
            if off > data.len { return none }
        }
        var v: ndview<T> = { data: data, off: off, rank: rank, shape: shape, strides: strides }
        return some(v)
    }

    /** @brief 元素总数（各维长度之积）；空视图为 0。
     *  @return 元素总数。
     */
    fn count(self: ref ndview<T>) -> i64 {
        var total: i64 = 1
        var k: i64 = 0
        while k < self.rank {
            total = total * self.shape[k]
            k = k + 1
        }
        return total
    }

    /** @brief 最内层步长是否连续（为 1）：连续视图可以把底层存储直接当切片用。
     *  @return 最内层步长为 1 时 `true`。
     */
    fn isContig(self: ref ndview<T>) -> bool {
        if self.rank < 1 { return false }
        return self.strides[self.rank - 1] == 1
    }
}

/** @brief 把全部元素写成 `x`。
 *  @param v 目标视图。
 *  @param x 写入的值。
 *  @return 形状非空且 rank 合法时 `true`；空视图直接 `true`。
 */
fn filled<T>(v: ndview<T>, x: T) -> bool {
    if v.rank < 1 { return false }
    var idx: [8]i64
    var o: i64 = v.off
    var k: i64 = v.rank - 1
    while k >= 0 {
        if v.shape[k] == 0 { return true }
        k = k - 1
    }
    while true {
        v.data[o] = x
        var d: i64 = v.rank - 1
        var more: bool = false
        while d >= 0 {
            idx[d] = idx[d] + 1
            o = o + v.strides[d]
            if idx[d] < v.shape[d] {
                more = true
                d = -1
            } else {
                idx[d] = 0
                o = o - v.shape[d] * v.strides[d]
                d = d - 1
            }
        }
        if more { continue }
        return true
    }
}

/** @brief 逐元素 `dst = a + b`（形状必须一致；允许原地）。
 *  @param dst 目标视图。
 *  @param a 第一个输入。
 *  @param b 第二个输入。
 *  @return 形状一致且 rank 合法时 `true`。
 */
fn addInto<T>(dst: ndview<T>, a: ndview<T>, b: ndview<T>) -> bool {
    if sameShapeAdd(dst, a) && sameShapeAdd(dst, b) { } else { return false }
    var idx: [8]i64
    var od: i64 = dst.off
    var oa: i64 = a.off
    var ob: i64 = b.off
    var d: i64 = dst.rank - 1
    while d >= 0 {
        if dst.shape[d] == 0 { return true }
        d = d - 1
    }
    while true {
        dst.data[od] = a.data[oa] + b.data[ob]
        d = dst.rank - 1
        var more: bool = false
        while d >= 0 {
            idx[d] = idx[d] + 1
            od = od + dst.strides[d]
            oa = oa + a.strides[d]
            ob = ob + b.strides[d]
            if idx[d] < dst.shape[d] {
                more = true
                d = -1
            } else {
                idx[d] = 0
                od = od - dst.shape[d] * dst.strides[d]
                oa = oa - a.shape[d] * a.strides[d]
                ob = ob - b.shape[d] * b.strides[d]
                d = d - 1
            }
        }
        if more { continue }
        return true
    }
}

/** @brief 逐元素 `dst = a - b`（形状必须一致；允许原地）。
 *  @param dst 目标视图。
 *  @param a 被减数。
 *  @param b 减数。
 *  @return 形状一致且 rank 合法时 `true`。
 */
fn subInto<T>(dst: ndview<T>, a: ndview<T>, b: ndview<T>) -> bool {
    if sameShapeAdd(dst, a) && sameShapeAdd(dst, b) { } else { return false }
    var idx: [8]i64
    var od: i64 = dst.off
    var oa: i64 = a.off
    var ob: i64 = b.off
    var d: i64 = dst.rank - 1
    while d >= 0 {
        if dst.shape[d] == 0 { return true }
        d = d - 1
    }
    while true {
        dst.data[od] = a.data[oa] - b.data[ob]
        d = dst.rank - 1
        var more: bool = false
        while d >= 0 {
            idx[d] = idx[d] + 1
            od = od + dst.strides[d]
            oa = oa + a.strides[d]
            ob = ob + b.strides[d]
            if idx[d] < dst.shape[d] {
                more = true
                d = -1
            } else {
                idx[d] = 0
                od = od - dst.shape[d] * dst.strides[d]
                oa = oa - a.shape[d] * a.strides[d]
                ob = ob - b.shape[d] * b.strides[d]
                d = d - 1
            }
        }
        if more { continue }
        return true
    }
}

/** @brief 逐元素 `dst = a * b`（形状必须一致；允许原地）。
 *  @param dst 目标视图。
 *  @param a 第一个输入。
 *  @param b 第二个输入。
 *  @return 形状一致且 rank 合法时 `true`。
 */
fn mulInto<T>(dst: ndview<T>, a: ndview<T>, b: ndview<T>) -> bool {
    if sameShapeAdd(dst, a) && sameShapeAdd(dst, b) { } else { return false }
    var idx: [8]i64
    var od: i64 = dst.off
    var oa: i64 = a.off
    var ob: i64 = b.off
    var d: i64 = dst.rank - 1
    while d >= 0 {
        if dst.shape[d] == 0 { return true }
        d = d - 1
    }
    while true {
        dst.data[od] = a.data[oa] * b.data[ob]
        d = dst.rank - 1
        var more: bool = false
        while d >= 0 {
            idx[d] = idx[d] + 1
            od = od + dst.strides[d]
            oa = oa + a.strides[d]
            ob = ob + b.strides[d]
            if idx[d] < dst.shape[d] {
                more = true
                d = -1
            } else {
                idx[d] = 0
                od = od - dst.shape[d] * dst.strides[d]
                oa = oa - a.shape[d] * a.strides[d]
                ob = ob - b.shape[d] * b.strides[d]
                d = d - 1
            }
        }
        if more { continue }
        return true
    }
}

/** @brief 逐元素 `dst = a * k`（允许原地）。
 *  @param dst 目标视图。
 *  @param a 输入。
 *  @param k 标量。
 *  @return 形状一致且 rank 合法时 `true`。
 */
fn scaleInto<T>(dst: ndview<T>, a: ndview<T>, k: T) -> bool {
    if sameShapeAdd(dst, a) { } else { return false }
    var idx: [8]i64
    var od: i64 = dst.off
    var oa: i64 = a.off
    var d: i64 = dst.rank - 1
    while d >= 0 {
        if dst.shape[d] == 0 { return true }
        d = d - 1
    }
    while true {
        dst.data[od] = a.data[oa] * k
        d = dst.rank - 1
        var more: bool = false
        while d >= 0 {
            idx[d] = idx[d] + 1
            od = od + dst.strides[d]
            oa = oa + a.strides[d]
            if idx[d] < dst.shape[d] {
                more = true
                d = -1
            } else {
                idx[d] = 0
                od = od - dst.shape[d] * dst.strides[d]
                oa = oa - a.shape[d] * a.strides[d]
                d = d - 1
            }
        }
        if more { continue }
        return true
    }
}

/** @brief 逐元素 `dst = a + k * b`（形状必须一致；允许原地）。
 *  @param dst 目标视图。
 *  @param a 第一个输入。
 *  @param b 第二个输入。
 *  @param k 标量。
 *  @return 形状一致且 rank 合法时 `true`。
 */
fn axpyInto<T>(dst: ndview<T>, a: ndview<T>, b: ndview<T>, k: T) -> bool {
    if sameShapeAdd(dst, a) && sameShapeAdd(dst, b) { } else { return false }
    var idx: [8]i64
    var od: i64 = dst.off
    var oa: i64 = a.off
    var ob: i64 = b.off
    var d: i64 = dst.rank - 1
    while d >= 0 {
        if dst.shape[d] == 0 { return true }
        d = d - 1
    }
    while true {
        dst.data[od] = a.data[oa] + k * b.data[ob]
        d = dst.rank - 1
        var more: bool = false
        while d >= 0 {
            idx[d] = idx[d] + 1
            od = od + dst.strides[d]
            oa = oa + a.strides[d]
            ob = ob + b.strides[d]
            if idx[d] < dst.shape[d] {
                more = true
                d = -1
            } else {
                idx[d] = 0
                od = od - dst.shape[d] * dst.strides[d]
                oa = oa - a.shape[d] * a.strides[d]
                ob = ob - b.shape[d] * b.strides[d]
                d = d - 1
            }
        }
        if more { continue }
        return true
    }
}

/** @brief 行主序求和（可复现：与连续布局的存储顺序一致）；空视图给 `none`。
 *  @param v 视图。
 *  @return 和；空视图 `none`。
 */
fn sumv<T>(v: ndview<T>) -> ?T {
    if v.rank < 1 { return none }
    var d: i64 = 0
    var empty: bool = false
    while d < v.rank {
        if v.shape[d] == 0 { empty = true }
        d = d + 1
    }
    if empty { return none }
    var zero: T = v.data[v.off] - v.data[v.off]
    var s: T = zero
    var idx: [8]i64
    var o: i64 = v.off
    while true {
        s = s + v.data[o]
        var k: i64 = v.rank - 1
        var more: bool = false
        while k >= 0 {
            idx[k] = idx[k] + 1
            o = o + v.strides[k]
            if idx[k] < v.shape[k] {
                more = true
                k = -1
            } else {
                idx[k] = 0
                o = o - v.shape[k] * v.strides[k]
                k = k - 1
            }
        }
        if more { continue }
        return some(s)
    }
}

/** @brief 交换两个维度（转置是 `rank == 2` 的特例）；零拷贝。
 *  @param v 视图。
 *  @param i 第一个维度。
 *  @param j 第二个维度。
 *  @return 换过维度的视图；维度越界时 `none`。
 */
fn swapDims<T>(v: ndview<T>, i: i64, j: i64) -> ?ndview<T> {
    if i < 0 || j < 0 || i >= v.rank || j >= v.rank { return none }
    var shape: [8]i64
    var strides: [8]i64
    var k: i64 = 0
    while k < v.rank {
        shape[k] = v.shape[k]
        strides[k] = v.strides[k]
        k = k + 1
    }
    shape[i] = v.shape[j]
    shape[j] = v.shape[i]
    strides[i] = v.strides[j]
    strides[j] = v.strides[i]
    return ndview<T>::strided(v.data, v.off, v.rank, shape, strides)
}

/** @brief 取第 0 维的第 `i` 个切片（降一维，零拷贝）。
 *  @param v 视图。
 *  @param i 第 0 维下标。
 *  @return 降一维的视图；越界或 rank 为 1 时 `none`。
 */
fn sub<T>(v: ndview<T>, i: i64) -> ?ndview<T> {
    if v.rank < 2 { return none }
    if i < 0 || i >= v.shape[0] { return none }
    var shape: [8]i64
    var strides: [8]i64
    var k: i64 = 1
    while k < v.rank {
        shape[k - 1] = v.shape[k]
        strides[k - 1] = v.strides[k]
        k = k + 1
    }
    return ndview<T>::strided(v.data, v.off + i * v.strides[0], v.rank - 1, shape, strides)
}


/** @brief 读二维视图的一个元素（`v[i, j]` 的下标糖直译到这里）。
 *  @param v 视图（rank 至少 2）。
 *  @param i 第 0 维下标。
 *  @param j 第 1 维下标。
 *  @return 元素值；维度不足或下标越界时 trap。
 */
fn at2<T>(v: ndview<T>, i: i64, j: i64) -> T {
    if v.rank < 2 { trap("at2: the view has fewer than 2 dimensions") }
    if i < 0 || i >= v.shape[0] { trap("at2: the first index is out of range") }
    if j < 0 || j >= v.shape[1] { trap("at2: the second index is out of range") }
    return v.data[v.off + i * v.strides[0] + j * v.strides[1]]
}

/** @brief 取二维视图的一个子矩形（`v[r0..r1, c0..c1]` 的下标糖直译到这里）；零拷贝。
 *  @param v 视图（rank 至少 2）。
 *  @param r0 第 0 维起点。
 *  @param r1 第 0 维终点（不含）。
 *  @param c0 第 1 维起点。
 *  @param c1 第 1 维终点（不含）。
 *  @return 二维子视图；rank 不足或区间为空/越界时 `none`。
 */
fn slice2<T>(v: ndview<T>, r0: i64, r1: i64, c0: i64, c1: i64) -> ?ndview<T> {
    if v.rank < 2 { return none }
    if r0 < 0 || c0 < 0 || r1 > v.shape[0] || c1 > v.shape[1] { return none }
    if r1 < r0 || c1 < c0 { return none }
    var shape: [8]i64
    var k: i64 = 0
    while k < v.rank {
        shape[k] = v.shape[k]
        k = k + 1
    }
    shape[0] = r1 - r0
    shape[1] = c1 - c0
    return ndview<T>::strided(v.data, v.off + r0 * v.strides[0] + c0 * v.strides[1], v.rank, shape, v.strides)
}

/** @brief 整体形状是否一致（逐元素运算的守卫）。
 *  @param dst 目标视图。
 *  @param src 输入视图。
 *  @return rank 与每维长度都一致时 `true`。
 */
fn sameShapeAdd<T>(dst: ndview<T>, src: ndview<T>) -> bool {
    if dst.rank < 1 || dst.rank > 8 { return false }
    if dst.rank != src.rank { return false }
    var k: i64 = 0
    while k < dst.rank {
        if dst.shape[k] != src.shape[k] { return false }
        if dst.shape[k] < 0 { return false }
        k = k + 1
    }
    return true
}
