/* std/pool.extc -- a slot map: stable handles, dense storage, slots get reused.
 *
 * This is phase 0 of the pool/ECS plan (`docs/topics/POOLS.md`): the piece that
 * makes churn cheap **without any compiler change**. It answers the first two of the
 * three problems the plan starts from:
 *
 *   1. the user cannot reclaim what a container throws away  -> `remove` returns the
 *      slot to a free list, so the next `insert` reuses it: memory is O(live), not
 *      O(total inserts) -- the shape that used to grow without bound (measurement C
 *      in the plan) is flat here;
 *   2. the user cannot reuse memory                          -> same free list;
 *   3. pointer chasing kills SIMD                            -> values live in ONE
 *      contiguous array (`vals`, dense: the first `len` entries are the live ones),
 *      and what the caller holds is an **index**, not a pointer. Iterating is
 *      `while i < p.len() { p.atDense(i) }` over contiguous memory.
 *
 * Storage: `vals` / `slots` / `ent` are all on this pool's OWN plate (`poolSlice`,
 * POOLS.md 2.1 "a pool has two faces"), not arena slices -- so `grow` extends them in
 * place (`poolResize`, not one byte copied: every column is indexed by position) and
 * `release` really returns the memory. Only the result of `toSlice` comes from the
 * arena, and that is deliberate: it is handed to the caller, so it has to outlive this
 * container (the opposite rule from storage).
 *
 * What it does not do (yet, and on purpose):
 *   - it does not trap on a stale handle: phase 0 has no way to trap with the
 *     **caller's** position (a trap inside this file would point here, not at your
 *     line). So the query style is used instead -- `get`/`set`/`contains` answer
 *     `?T` / `bool` -- and `at(h)`-style trapping accessors come when
 *     `@trackCaller` exists (plan section 3.3, option (b)).
 *
 * Handle = (slot, generation) + the pool epoch it was born in. Two layers of
 * invalidation, each in charge of one span (`docs/topics/POOLS.md` sections 7.1, 7.6):
 *
 *   - slot level (`gen`): `remove` bumps the generation, so every old handle for that
 *     slot stops matching -- `contains(h)` is false and `get(h)` is `none`, which is how
 *     "erase then misuse the old handle" is caught (the C++ iterator-invalidation
 *     footgun, turned into a checkable answer). This is the ONLY protection inside one
 *     epoch: `remove` then `insert` reusing the same slot must still reject the old
 *     handle, and an epoch compare alone would miss that (a silent read of the new
 *     element).
 *   - pool level (`epoch`): `clear()` flips the epoch instead of rewriting every slot,
 *     so every handle born before it is rejected by one compare, in O(1). See `clear`.
 *
 * DISCIPLINE: the epoch may only ever VETO, never CONFIRM. "handle epoch == pool epoch"
 * does not mean alive -- liveness authority stays `n`, the bump cursor / hole chain and
 * the slot `gen`. So the epoch check comes first and returns false on mismatch; on a
 * match the old slot check still runs unchanged. Taking the epoch as proof of life would
 * turn both garbage slots and epoch wraparound into false positives (not sound).
 */

/* Detection strength only, never correctness: how many low bits of the pool epoch a
 * handle keeps. A mismatch is always a veto; a match still goes through `gen`, so the
 * width only decides how long a stale handle keeps being caught loudly (2^BITS clears)
 * rather than silently read. Whole width of the field -- tune in this ONE place. */
let HANDLE_EPOCH_BITS: i64 = 32

/* A stable reference to one slot. It is a **value**: copying it is fine (that is the
 * point of a handle -- the container owns the memory, the handle only names it). */
use std::sys::pool as syspool    /* 运行期池：随容器创建，release 时整批还 */

struct handle {
    slot: i32
    gen:  i32
    ep:   i64                  /* the pool epoch this handle was born in (masked) */
}

/* Two handles are the same slot in the same generation of the same epoch. */
fn same(a: handle, b: handle) -> bool {
    return a.slot == b.slot && a.gen == b.gen && a.ep == b.ep
}

/* ⚠️ `@inline` 的取舍是**量出来的**，别一刀切（2026-09-24，`-O2`，3 次取最好）：
 *   · `len` / `atDense` / `handleAtDense`（极小访问器）内联：无害 ✓
 *   · `get` / `contains` 内联：**随机访问快 1.6×**（0.836s → 0.523s / 1e7 次）
 *     而 **churn 慢 1.7×**（0.87s → 1.49s / 2e8 次）✗ ⇒ 保持不内联（churn 是这套的主场）✓
 * 想要"两边都快"，就走 `atDense(i)` 逐个取（见下）—— 热点循环本来就该遍历列，而不是走容器 ✓ */
struct pool<T> {
    vals:   mut slice<T>       /* dense: vals[0..len] are the live values, in order */
    slots:  mut slice<i32>     /* dense index -> slot number (the reverse map) */
    /* ⭐ ONE metadata array instead of two (`sparse` + `gens`), packed into an i64:
     *     live slot:  (gen << 32) | (dense + 1)          low half in [1, cap]
     *     free slot:  (gen << 32) | (next + cap + 2)     low half in [cap+1, 2cap+1]
     *   Live/free is one compare against `cap`; the generation survives a slot going free.
     *   A handle access used to be **three dependent random loads** (sparse, gens, value);
     *   it is two now, and the metadata per slot went 12 -> 8 bytes. */
    ent:    mut slice<i64>
    /* 运行期池（POOLS.md）：数据住它所在的 arena，池是 arena 旁边的那条旁链；
     * 随本容器一起创建，所在的地方退出时整条链一起走。release 之后为 -1。 */
    pid:    i64                /* 运行期池的下标 */
    pidGen: u64                /* 建池时的世代：拷贝 + 槽位复用之后，防止误放别人的池 */
    /* Pool epoch: `clear` flips this one field instead of rewriting `ent` (O(1)), and a
     * handle carries the value it was born with. Kept OUT of `ent` on purpose -- it is a
     * pool-wide fact, not a per-slot one, and only a veto (see `pLive`). */
    epoch:  i64
    /* The slots of the CURRENT epoch are allocated by a bump cursor plus an explicit hole
     * chain -- not by one free list threaded through `ent`. That is what lets `clear` walk
     * away without touching a single slot (`docs/topics/POOLS.md` 7.3):
     *   INVARIANT  live slots of this epoch = [0, cursor) minus the slots on the hole chain.
     * So a slot >= cursor has never been handed out this epoch and reads as free.
     *    - `cursor`  : one past the highest slot ever used this epoch (the bump frontier).
     *    - `holeHead`: head of the chain of slots freed by `remove` (-1 = no hole). The chain
     *      reuses the old free-list encoding in the low half of `ent`: `next + cap + 2`, so
     *      `pLow(e) > cap` already means "free" and no new tag is needed. Holes come first
     *      on `insert`, so a churning workload reuses them and `cursor` stops rising. */
    cursor:   i32
    holeHead: i32
    n:      i64                /* live values, always the dense prefix */
    cap:    i64

    /* --- the packed metadata, in one place --- */
    @inline
    fn pLow(e: i64) -> i64 { return e & i64(4294967295) }
    @inline
    fn pDense(e: i64) -> i64 { return (e & i64(4294967295)) - i64(1) }
    @inline
    fn pGen(e: i64) -> i64 { return e >> i64(32) }
    @inline
    fn pPack(gen: i64, low: i64) -> i64 { return (gen << i64(32)) | low }

    /* --- the pool epoch, in one place: width lives in HANDLE_EPOCH_BITS --- */
    @inline
    fn pEpMask() -> i64 { return (i64(1) << HANDLE_EPOCH_BITS) - i64(1) }
    @inline
    fn pEp(v: i64) -> i64 { return v & pool<T>::pEpMask() }

    /* An empty pool that can hold `n` values before it has to grow. */
    fn withCap(n: i64) -> pool<T> { return pool<T>::withParent(i64(-1), n) }

    /* The same, nested: `parent` is the pool of the container that owns this one, so the two
     * records form the LOGICAL pool tree (POOLS.md 7.7) -- dropping the outer pool takes this
     * one with it. Lifetime is unaffected either way: both are on their zone's root chain, so
     * the place they were created in releases them on its own. */
    fn withParent(parent: i64, n: i64) -> pool<T> {
        let rp = syspool::extc_pool_new(parent)      /* 池随容器创建，父池 = 外层容器 */
        let rpg = syspool::extc_pool_generation(rp)
        var c: i64 = n
        if c < i64(8) { c = i64(8) }
        var p: pool<T> = {
            vals:   poolSlice<T>(rp, c),
            slots:  poolSlice<i32>(rp, c),
            ent:    poolSlice<i64>(rp, c),
            pid:    rp,
            pidGen: rpg,
            epoch:  i64(0),
            cursor: i32(0),
            holeHead: i32(-1),
            n:      i64(0),
            cap:    c,
        }
        /* First pass only: an all-free `ent` at generation 0, low half > cap. After this
         * the table is never re-initialized wholesale -- `clear` flips the epoch instead.
         * The `next` encoding matches the hole chain, which is why nothing here changes. */
        var i: i64 = 0
        while i < c {
            let nxt = i + i64(1)
            var low: i64 = nxt + c + i64(2)
            if nxt >= c { low = i64(-1) + c + i64(2) }
            p.ent[i] = pool<T>::pPack(i64(0), low)
            i = i + i64(1)
        }
        return p
    }

    /* How many values are alive. */
    @inline
    fn len(self: ref pool<T>) -> i64 { return self.n }

    /* SINGLE entry point for "is this handle still good?" -- the two layers, in order:
     *   1. epoch: the handle's birth epoch against the pool's current one. A mismatch
     *      means the whole epoch was invalidated (`clear`) => veto on the spot, without
     *      even touching `ent`.
     *   2. slot: equality of epochs does NOT mean alive; authority is the packed low half
     *      (free slots compare > cap) plus the slot generation. Unchanged, and it is what
     *      catches slot reuse (`remove` then `insert`) inside one epoch.
     * `remove`, `gather` and `handleAtDense` all read the same packed fields, so they must
     * go through here (or repeat both halves) rather than test the epoch alone. */
    fn pLive(self: ref pool<T>, h: handle) -> bool {
        if pool<T>::pEp(h.ep) != pool<T>::pEp(self.epoch) { return false }
        let s = i64(h.slot)
        if s < i64(0) || s >= self.cap { return false }
        let e = self.ent[s]
        if pool<T>::pLow(e) > self.cap { return false }        /* free slot */
        return pool<T>::pGen(e) == i64(h.gen)
    }

    /* Is this handle still the slot it names? (epoch + generation match + slot live) */
    fn contains(self: ref pool<T>, h: handle) -> bool {
        return self.pLive(h)
    }

    /* The value, or `none` when the handle is stale (freed, or from a previous era). */
    fn get(self: ref pool<T>, h: handle) -> ?T {
        if !self.contains(h) { return none }
        return some(self.vals[pool<T>::pDense(self.ent[i64(h.slot)])])
    }

    /* Write through a handle. Returns false when the handle is stale (nothing written). */
    fn set(self: mut ref pool<T>, h: handle, v: T) -> bool {
        if self.pStaleSelf() { self.pPoisonSelf() }
        if !self.contains(h) { return false }
        self.vals[pool<T>::pDense(self.ent[i64(h.slot)])] = v
        return true
    }

    /* Add a value and hand back its handle. Slot choice, in order:
     *   1. the hole chain (`remove` gave these back) -- popping it advances the head;
     *   2. otherwise the bump cursor -- a slot never used this epoch.
     * A never-used-this-epoch slot still holds LAST epoch's packed word: inherit the slot
     * generation from it and ignore everything else (the low half describes an obsolete
     * chain, and `clear` deliberately did not clean it up). Overwriting the whole word is
     * what makes that safe. */
    fn insert(self: mut ref pool<T>, v: T) -> handle {
        if self.pStaleSelf() { self.pPoisonSelf() }
        if self.holeHead < i32(0) && i64(self.cursor) >= self.cap { self.grow() }
        var s: i64 = i64(0)
        if self.holeHead >= i32(0) {
            s = i64(self.holeHead)
            self.holeHead = i32(pool<T>::pLow(self.ent[s]) - self.cap - i64(2))   /* pop the hole chain */
        } else {
            s = i64(self.cursor)
            self.cursor = self.cursor + i32(1)
        }
        let e = self.ent[s]                                       /* may be last epoch's word */
        self.ent[s] = pool<T>::pPack(pool<T>::pGen(e), self.n + i64(1))   /* live at dense n */
        self.slots[self.n] = i32(s)
        self.vals[self.n] = v
        self.n = self.n + i64(1)
        return handle { slot: i32(s), gen: i32(pool<T>::pGen(e)), ep: pool<T>::pEp(self.epoch) }
    }

    /* Free a slot **without moving any other value's dense place** by swapping the last
     * value into the hole: the live prefix stays contiguous, which is what keeps
     * iteration vectorizable. `remove` also invalidates every handle of that slot by
     * bumping its generation. Returns false when the handle was already stale. */
    fn remove(self: mut ref pool<T>, h: handle) -> bool {
        if !self.pLive(h) { return false }
        let s    = i64(h.slot)
        let e    = self.ent[s]
        let d    = pool<T>::pDense(e)            /* where it lives in the dense array */
        let last = self.n - i64(1)
        if d != last {
            self.vals[d]   = self.vals[last]     /* move the last value into the hole */
            let moved = i64(self.slots[last])
            self.slots[d] = i32(moved)
            let me = self.ent[moved]
            self.ent[moved] = pool<T>::pPack(pool<T>::pGen(me), d + i64(1))
        }
        self.n = last
        /* Generation +1 (old handles of this slot are stale, IN THIS EPOCH TOO) and onto the
         * hole chain, in one store. The bumped gen is the whole reason the epoch check alone
         * is not enough: this slot can be handed out again moments from now, same epoch. */
        self.ent[s] = pool<T>::pPack(pool<T>::pGen(e) + i64(1), i64(self.holeHead) + self.cap + i64(2))
        self.holeHead = i32(s)
        return true
    }

    /* O(1) clear: flip the pool epoch, reset the cursors, write NO slot, NO value, NO
     * reverse map -- cost is independent of `cap` (POOLS.md 7.3/7.5). Three stores:
     *   - `epoch + 1`: every handle born before this call is vetoed by one compare;
     *   - `n = 0`, `cursor = 0`, `holeHead = -1`: the allocation state of the new epoch is
     *     exactly the state of a fresh pool, so the whole `ent` table reads as free --
     *     live slots are `[0, cursor)` minus the hole chain, and that set is empty now.
     * The per-slot words (`gen` and the stale chain links) are left EXACTLY as they were:
     * the next `insert` into such a slot inherits only its `gen` and overwrites the rest.
     * Do NOT weaken this into "reuse the slot table as is without flipping the epoch" --
     * then old handles would read the new elements. */
    /* 把整批还给这一层（POOLS.md）：容器自己的簿记重置 + 运行期池重置。
     * 不叫 close —— 所在的地方退出时这棵树本来就会被自动清空，close 会被读成"你负责关"。 */
    /* **守卫**：这一份池值还指着它的运行期记录吗？陈旧 ⇒ 收成空池（三块视图归零），
     * 下一次访问带位置地 trap。 */
    fn pStaleSelf(self: ref pool<T>) -> bool {
        if self.pid < i64(0) { return false }
        return syspool::extc_pool_generation(self.pid) != self.pidGen
    }
    fn pPoisonSelf(self: mut ref pool<T>) {
        self.vals  = poolSlice<T>(i64(-1), i64(0))
        self.slots = poolSlice<i32>(i64(-1), i64(0))
        self.ent   = poolSlice<i64>(i64(-1), i64(0))
        self.n     = i64(0)
        self.cap   = i64(0)
        self.pid   = i64(-1)
    }

    fn release(self: mut ref pool<T>) {
        if self.pid < i64(0) { return }                        /* 已经放过 */
        if syspool::extc_pool_generation(self.pid) != self.pidGen { 
            self.pid = i64(-1)                                 /* 陈旧拷贝：槽位已被别的池复用，什么都不许做 */
            return
        }
        /* 三块视图先收成 0 长、容量归零，再把板块还给池：之后任何下标都是响亮越界
         * （带位置的 trap），而不是读写一块已经还掉的内存。 */
        self.vals  = poolResize<T>(self.pid, self.vals, i64(0))
        self.slots = poolResize<i32>(self.pid, self.slots, i64(0))
        self.ent   = poolResize<i64>(self.pid, self.ent, i64(0))
        self.cap   = i64(0)
        syspool::extc_pool_reset(self.pid)
        self.clear()
        syspool::extc_pool_drop(self.pid)
        self.pid = i64(-1)
    }

    /* 当前容量（`shrink` 之后小下去；`grow` 是翻倍）*/
    @inline
    fn capacity(self: ref pool<T>) -> i64 { return self.cap }

    /* 缩容：把容量降到"刚好装下活数据"（下限 8），把高水位让出去。
     *
     * 两点必须保住：
     *   - **dense 前段照旧连续**（前 n 个搬进新数组，顺序不变）
     *   - **存活槽的世代原样保留** ⇒ 已经发出去的 handle 全部继续有效
     * 空槽的世代也保留（它们的 `next` 按新 cap 重排，世代字段不动），因此
     * shrink 不引入任何 ABA：它只是把不用的槽从表里切掉。
     * 三块都是**同一块缩回去**（内容由 resize 保住）⇒ 让出去的是真的内存。 */
    fn shrink(self: mut ref pool<T>) {
        var ncap: i64 = self.n
        if ncap < i64(8) { ncap = i64(8) }
        if ncap >= self.cap { return }                  /* 没有可缩的 */
        self.vals  = poolResize<T>(self.pid, self.vals, ncap)
        self.slots = poolResize<i32>(self.pid, self.slots, ncap)
        self.ent   = poolResize<i64>(self.pid, self.ent, ncap)
        var ne: mut slice<i64> = self.ent
        var i: i64 = 0
        /* Rebuild the hole chain over the slots this epoch had actually used. `head` doubles
         * as the tail sentinel: the chain is a ring (the last link points back at the head),
         * which is how the old free list was written and what `pop` expects. Slots at or
         * above the new `cursor` are "never used this epoch" and need no chaining at all --
         * `insert` reaches them through the bump cursor, not through this chain. */
        var head: i32 = i32(-1)
        var prev: i64 = i64(-1)
        var used: i64 = i64(self.cursor)
        if used > ncap { used = ncap }
        i = used - i64(1)
        while i >= i64(0) {
            if pool<T>::pLow(ne[i]) > self.cap {
                if prev < i64(0) {
                    head = i32(i)
                } else {
                    ne[prev] = pool<T>::pPack(pool<T>::pGen(ne[prev]), i + ncap + i64(2))
                }
                prev = i
            }
            i = i - i64(1)
        }
        if prev >= i64(0) {
            ne[prev] = pool<T>::pPack(pool<T>::pGen(ne[prev]), i64(head) + ncap + i64(2))
        }
        /* Everything past `n` in the new table was either a hole (now on the chain) or never
         * used at all, so the frontier is "the first never-used slot". */
        self.holeHead = head
        self.cursor   = i32(ncap)
        self.cap   = ncap
    }

    /* O(1) clear: flip the pool epoch, reset the cursors, write no slot at all. */
    fn clear(self: mut ref pool<T>) {
        self.epoch    = self.epoch + i64(1)
        self.n        = i64(0)
        self.cursor   = i32(0)
        self.holeHead = i32(-1)
    }

    /* The dense prefix, in order: contiguous, so a loop over it is a loop over memory. */
    @inline
    fn atDense(self: ref pool<T>, i: i64) -> T { return self.vals[i] }

    /* ⭐ **Hot loops should not go through the container.** This hands out the dense prefix
     * as a `slice` **without copying**, so a loop over it compiles to exactly the same
     * thing as a loop over a bare array (measured: 1.6 ns/element versus 4.0 through
     * `atDense` -- 2.5x, which is the price of a method call and a bounds check per
     * access, not of the data structure).
     *
     * It is the ECS shape: a system iterates a **column**, not the container.
     *
     * Lifetime: the view points into the container's storage, so the escape checker gives
     * it the receiver's depth -- it cannot outlive the pool (or the block the pool lives
     * in). Letting it escape is a compile error, not a dangling view.
     * Written through the pool, the view is stale: `insert` may reuse a slot (it does not
     * move values) but `grow` copies into new arrays, so take the view again after a
     * growth, or after `clear`. */
    
    /* ⭐ **gather**: resolve a batch of handles into dense indices once, so the hot loop
     * after it is plain index access through `atDense(i)` (measured 1.09x of a bare slice,
     * against 9.1x for using handles as indices).
     *
     * `out[i]` gets the dense index of `hs[i]`, or -1 when that handle is stale; the
     * return value is how many were valid (so a caller can compact or skip).
     * `out` must be at least as long as `hs`. */
    /* The handle of the i-th dense value (the inverse of `atDense`). */
    @inline
    fn handleAtDense(self: ref pool<T>, i: i64) -> handle {
        let s = i64(self.slots[i])
        return handle { slot: i32(s), gen: i32(pool<T>::pGen(self.ent[s])), ep: pool<T>::pEp(self.epoch) }
    }

    /* ⭐ **gather**: resolve a batch of handles into dense indices once, so the hot loop
     * after it is plain index access through `atDense(i)` (measured 1.09x of a bare slice,
     * against 9.1x for using handles as indices).
     *
     * `out[i]` gets the dense index of `hs[i]`, or -1 when that handle is stale; the
     * return value is how many were valid (so a caller can compact or skip).
     * `out` must be at least as long as `hs`. */
    fn gather(self: ref pool<T>, hs: slice<handle>, out: mut slice<i64>) -> i64 {
        var k: i64 = 0
        var i: i64 = 0
        while i < hs.len {
            let h = hs[i]
            let s = i64(h.slot)
            var d: i64 = i64(-1)
            if s >= i64(0) && s < self.cap {
                let e = self.ent[s]
                if pool<T>::pLow(e) <= self.cap && pool<T>::pGen(e) == i64(h.gen) {
                    d = pool<T>::pDense(e)
                    k = k + i64(1)
                }
            }
            out[i] = d
            i = i + i64(1)
        }
        return k
    }

    /* A copy of the live values as a `slice`, allocated in the **caller's** block: the
     * escape machinery promotes it, so the view lives exactly as long as that block and
     * is reclaimed with it. One copy, and then ordinary `slice` code (print, IO, any
     * algorithm) works. */
    fn toSlice(self: ref pool<T>) -> slice<T> {
        var out: mut slice<T> = new T[self.n]
        var i: i64 = 0
        while i < self.n { out[i] = self.vals[i]  i = i + i64(1) }
        return out
    }

    /* Grow by 1.5x, in place when the allocator can: the three blocks are OURS (the pool's
     * plate), so the old ones do not linger -- that is what used to make this O(log n)
     * bounded-waste instead of free. */
    fn grow(self: mut ref pool<T>) {
        if self.pid < i64(0) { return }
        let ncap = self.cap + self.cap / i64(2)
        self.vals  = poolResize<T>(self.pid, self.vals, ncap)
        self.slots = poolResize<i32>(self.pid, self.slots, ncap)
        self.ent   = poolResize<i64>(self.pid, self.ent, ncap)
        var ne: mut slice<i64> = self.ent
        var i: i64 = self.cap
        /* The new slots are all "never used this epoch", so they need no chaining: they are
         * reached by the bump cursor, which still points at `self.cap`. `cursor` and the hole
         * chain are carried over untouched -- `grow` must not lose a hole. The `low` written
         * here is never read (`insert` overwrites the whole word when it bumps onto one), it
         * is only there so no slot of the new table is uninitialized. */
        i = self.cap
        while i < ncap { ne[i] = pool<T>::pPack(i64(0), i + ncap + i64(2))  i = i + i64(1) }
        self.cap = ncap
    }
}
