/* stl/seq.extc —— 序列归约：`sum` / `max` / `min` / `count`
 *
 * **语义按"从左到右"钉死**：`sum` 的累加顺序就是视图元素顺序，浮点也一样。
 * 这条不是实现细节 —— 它让归约**可复现**（同一份输入永远同一个 bit 结果），
 * 也让并行版必须按固定分段、按段顺序合并，而不是随手并发累加。
 *
 * **空视图不 trap**：三个归约返回 `option`，空输入是 `none`。
 * 库不替调用方决定"空的时候算多少"：没有泛型的零值可填，替它填 0 又会把
 * "没有元素"和"和是 0"混成一件事；`??` 与 `match` 两条路都在调用方手里。
 *
 * 只收缩看、不分配、不改变入参 —— 这三个函数在任何一个线程上都合法（`Thread=0`）。
 *
 * @code
 * use stl::seq
 *
 * fn main() -> i32 {
 *     var xs: mut slice<f64> = new f64[i64(3)]
 *     xs[0] = 1.0
 *     xs[1] = 2.0
 *     xs[2] = 3.5
 *     let s = seq::sum(xs) ?? f64(0.0)
 *     if s > f64(6.0) { return 0 }
 *     return 1
 * }
 * @endcode
 */

/** @brief 从左到右累加 `a` 的所有元素。
 *  @param a 参与求和的只读视图。
 *  @return 和；空视图是 `none`。
 */
fn sum<T>(a: slice<T>) -> ?T {
    if a.len == i64(0) { return none }
    var s: T = a[i64(0)]
    var i: i64 = i64(1)
    while i < a.len {
        s = s + a[i]
        i = i + i64(1)
    }
    return some(s)
}

/** @brief 找 `a` 里最大的元素（用 `>` 比较，相等时保留靠前的那个）。
 *  @param a 参与比较的只读视图。
 *  @return 最大值；空视图是 `none`。
 */
fn max<T>(a: slice<T>) -> ?T {
    if a.len == i64(0) { return none }
    var best: T = a[i64(0)]
    var i: i64 = i64(1)
    while i < a.len {
        if a[i] > best { best = a[i] }
        i = i + i64(1)
    }
    return some(best)
}

/** @brief 找 `a` 里最小的元素（用 `<` 比较，相等时保留靠前的那个）。
 *  @param a 参与比较的只读视图。
 *  @return 最小值；空视图是 `none`。
 */
fn min<T>(a: slice<T>) -> ?T {
    if a.len == i64(0) { return none }
    var best: T = a[i64(0)]
    var i: i64 = i64(1)
    while i < a.len {
        if a[i] < best { best = a[i] }
        i = i + i64(1)
    }
    return some(best)
}

/** @brief 数一数 `v` 在 `a` 里出现了多少次（用 `==` 比较）。
 *  @param a 要扫的只读视图。
 *  @param v 要找的值。
 *  @return 出现次数；空视图是 0。
 */
fn count<T>(a: slice<T>, v: T) -> i64 {
    var n: i64 = i64(0)
    for x in a {
        if x == v { n = n + i64(1) }
    }
    return n
}

// ---- 固定分块的并行归约 -------------------------------------------------------------
//
// 一维 `par` 的归约路线是两步：先把每段的局部结果写进 `parts`，再按段序串行合并。这里内置
// 的只是"结合后与串行逐位相同"的那几种归约：
//
//   - 整数加法（模算术，任意结合顺序结果相同）；
//   - `max` / `min`（取极值，与顺序无关，浮点也一样精确）。
//
// 浮点 `sum` 不在此列：分块改变了加法结合顺序，浮点加法不结合，所以并行合并的结果不能同时
// 保证"与从左到右串行逐位相同"。浮点求和仍走 `sum`（串行）或"先算进数组再 `sum`"。
//
// 前置条件：`parts.len <= a.len`（每段至少一个元素，`max`/`min` 才有初值）；不满足时返回
// `none`。段长是 `ceil(a.len / parts.len)`，固定不变 ⇒ 同一个 `parts.len` 下结果可复现。

/** @brief 固定分块的整数求和：每段之和写进 `parts[b]`，再按段序串行合并。
 *
 *  @param a     参与求和的只读视图。
 *  @param parts 每段结果的输出视图（长度 = 段数，必须 `<= a.len`）。
 *  @return 总和；`a` 或 `parts` 为空、或 `parts.len > a.len` 时是 `none`。
 */
fn sumBlocksI64(a: slice<i64>, parts: mut slice<i64>) -> ?i64 {
    if a.len == i64(0) { return none }
    if parts.len == i64(0) { return none }
    if parts.len > a.len { return none }
    let blk: i64 = (a.len + parts.len - i64(1)) / parts.len
    par b in 0..parts.len {
        let lo: i64 = b * blk
        var hi: i64 = lo + blk
        if hi > a.len { hi = a.len }
        var s: i64 = i64(0)
        var i: i64 = lo
        while i < hi {
            s = s + a[i]
            i = i + i64(1)
        }
        parts[b] = s
    }
    var t: i64 = i64(0)
    var j: i64 = i64(0)
    while j < parts.len {
        t = t + parts[j]
        j = j + i64(1)
    }
    return some(t)
}

/** @brief 固定分块的 `f64` 求最大值：每段的极值写进 `parts[b]`，再按段序合并。
 *
 *  @param a     参与比较的只读视图。
 *  @param parts 每段结果的输出视图（长度 = 段数，必须 `<= a.len`）。
 *  @return 最大值；`a` 或 `parts` 为空、或 `parts.len > a.len` 时是 `none`。
 */
fn maxBlocksF64(a: slice<f64>, parts: mut slice<f64>) -> ?f64 {
    if a.len == i64(0) { return none }
    if parts.len == i64(0) { return none }
    if parts.len > a.len { return none }
    let blk: i64 = (a.len + parts.len - i64(1)) / parts.len
    par b in 0..parts.len {
        let lo: i64 = b * blk
        var hi: i64 = lo + blk
        if hi > a.len { hi = a.len }
        var m: f64 = a[lo]
        var i: i64 = lo + i64(1)
        while i < hi {
            if a[i] > m { m = a[i] }
            i = i + i64(1)
        }
        parts[b] = m
    }
    var t: f64 = parts[i64(0)]
    var j: i64 = i64(1)
    while j < parts.len {
        if parts[j] > t { t = parts[j] }
        j = j + i64(1)
    }
    return some(t)
}

/** @brief 固定分块的 `f64` 求最小值：每段的极值写进 `parts[b]`，再按段序合并。
 *
 *  @param a     参与比较的只读视图。
 *  @param parts 每段结果的输出视图（长度 = 段数，必须 `<= a.len`）。
 *  @return 最小值；`a` 或 `parts` 为空、或 `parts.len > a.len` 时是 `none`。
 */
fn minBlocksF64(a: slice<f64>, parts: mut slice<f64>) -> ?f64 {
    if a.len == i64(0) { return none }
    if parts.len == i64(0) { return none }
    if parts.len > a.len { return none }
    let blk: i64 = (a.len + parts.len - i64(1)) / parts.len
    par b in 0..parts.len {
        let lo: i64 = b * blk
        var hi: i64 = lo + blk
        if hi > a.len { hi = a.len }
        var m: f64 = a[lo]
        var i: i64 = lo + i64(1)
        while i < hi {
            if a[i] < m { m = a[i] }
            i = i + i64(1)
        }
        parts[b] = m
    }
    var t: f64 = parts[i64(0)]
    var j: i64 = i64(1)
    while j < parts.len {
        if parts[j] < t { t = parts[j] }
        j = j + i64(1)
    }
    return some(t)
}
