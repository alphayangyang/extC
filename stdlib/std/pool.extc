/* std/pool.extc -- a slot map: stable handles, dense storage, slots get reused.
 *
 * This is phase 0 of the pool/ECS plan (`docs/topics/POOLS.md`): the piece that
 * makes churn cheap **without any compiler change**. It answers the first two of the
 * three problems the plan starts from:
 *
 *   1. the user cannot reclaim what a container throws away  -> `remove` returns the
 *      slot to a free list, so the next `insert` reuses it: memory is O(live), not
 *      O(total inserts) -- the shape that used to grow without bound (measurement C
 *      in the plan) is flat here;
 *   2. the user cannot reuse memory                          -> same free list;
 *   3. pointer chasing kills SIMD                            -> values live in ONE
 *      contiguous array (`vals`, dense: the first `len` entries are the live ones),
 *      and what the caller holds is an **index**, not a pointer. Iterating is
 *      `while i < p.len() { p.atDense(i) }` over contiguous memory.
 *
 * What it does not do (yet, and on purpose):
 *   - it does not own a pool, so it cannot give memory back to the arena. `clear()`
 *     reuses the capacity; really returning memory needs `r.reset()` (phase 1+).
 *   - it does not trap on a stale handle: phase 0 has no way to trap with the
 *     **caller's** position (a trap inside this file would point here, not at your
 *     line). So the query style is used instead -- `get`/`set`/`contains` answer
 *     `?T` / `bool` -- and `at(h)`-style trapping accessors come when
 *     `@trackCaller` exists (plan section 3.3, option (b)).
 *
 * Handle = (slot, generation). `remove` bumps the generation, so every old handle for
 * that slot stops matching: `contains(h)` is false and `get(h)` is `none`, which is how
 * "erase then misuse the old handle" is caught (the C++ iterator-invalidation footgun,
 * turned into a checkable answer).
 */

/* A stable reference to one slot. It is a **value**: copying it is fine (that is the
 * point of a handle -- the container owns the memory, the handle only names it). */
struct handle {
    slot: i32
    gen:  i32
}

/* Two handles are the same slot in the same generation. */
fn same(a: handle, b: handle) -> bool {
    return a.slot == b.slot && a.gen == b.gen
}

/* ⚠️ `@inline` 的取舍是**量出来的**，别一刀切（2026-09-24，`-O2`，3 次取最好）：
 *   · `len` / `atDense` / `handleAtDense`（极小访问器）内联：无害 ✓
 *   · `get` / `contains` 内联：**随机访问快 1.6×**（0.836s → 0.523s / 1e7 次）
 *     而 **churn 慢 1.7×**（0.87s → 1.49s / 2e8 次）✗ ⇒ 保持不内联（churn 是这套的主场）✓
 * 想要"两边都快"，就走 `denseView()`（见下）—— 热点循环本来就该遍历列，而不是走容器 ✓ */
struct pool<T> {
    vals:   mut slice<T>       /* dense: vals[0..len] are the live values, in order */
    slots:  mut slice<i32>     /* dense index -> slot number (the reverse map) */
    /* ⭐ ONE metadata array instead of two (`sparse` + `gens`), packed into an i64:
     *     live slot:  (gen << 32) | (dense + 1)          low half in [1, cap]
     *     free slot:  (gen << 32) | (next + cap + 2)     low half in [cap+1, 2cap+1]
     *   Live/free is one compare against `cap`; the generation survives a slot going free.
     *   A handle access used to be **three dependent random loads** (sparse, gens, value);
     *   it is two now, and the metadata per slot went 12 -> 8 bytes. */
    ent:    mut slice<i64>
    free:   i32                /* head of the free list (-1 = none) */
    n:      i64                /* live values, always the dense prefix */
    cap:    i64

    /* --- the packed metadata, in one place --- */
    @inline
    fn pLow(e: i64) -> i64 { return e & i64(4294967295) }
    @inline
    fn pDense(e: i64) -> i64 { return (e & i64(4294967295)) - i64(1) }
    @inline
    fn pGen(e: i64) -> i64 { return e >> i64(32) }
    @inline
    fn pPack(gen: i64, low: i64) -> i64 { return (gen << i64(32)) | low }

    /* An empty pool that can hold `n` values before it has to grow. */
    fn withCap(n: i64) -> pool<T> {
        var c: i64 = n
        if c < i64(8) { c = i64(8) }
        var p: pool<T> = {
            vals:   new T[c],
            slots:  new i32[c],
            ent:    new i64[c],
            free:   i32(-1),
            n:      i64(0),
            cap:    c,
        }
        /* Every slot starts free, generation 0, chained 0 -> 1 -> ... -> -1. */
        var i: i64 = 0
        while i < c {
            let nxt = i + i64(1)
            var low: i64 = nxt + c + i64(2)
            if nxt >= c { low = i64(-1) + c + i64(2) }
            p.ent[i] = pool<T>::pPack(i64(0), low)
            i = i + i64(1)
        }
        p.free = i32(0)
        return p
    }

    /* How many values are alive. */
    @inline
    fn len(self: ref pool<T>) -> i64 { return self.n }

    /* Is this handle still the slot it names? (generation match + slot live) */
    fn contains(self: ref pool<T>, h: handle) -> bool {
        let s = i64(h.slot)
        if s < i64(0) || s >= self.cap { return false }
        let e = self.ent[s]
        if pool<T>::pLow(e) > self.cap { return false }        /* free slot */
        return pool<T>::pGen(e) == i64(h.gen)
    }

    /* The value, or `none` when the handle is stale (freed, or from a previous era). */
    fn get(self: ref pool<T>, h: handle) -> ?T {
        if !self.contains(h) { return none }
        return some(self.vals[pool<T>::pDense(self.ent[i64(h.slot)])])
    }

    /* Write through a handle. Returns false when the handle is stale (nothing written). */
    fn set(self: mut ref pool<T>, h: handle, v: T) -> bool {
        if !self.contains(h) { return false }
        self.vals[pool<T>::pDense(self.ent[i64(h.slot)])] = v
        return true
    }

    /* Add a value and hand back its handle. Reuses a freed slot when there is one. */
    fn insert(self: mut ref pool<T>, v: T) -> handle {
        if self.free < i32(0) { self.grow() }
        let s = i64(self.free)
        let e = self.ent[s]
        self.free = i32(pool<T>::pLow(e) - self.cap - i64(2))   /* pop the free list */
        self.ent[s] = pool<T>::pPack(pool<T>::pGen(e), self.n + i64(1))   /* live at dense n */
        self.slots[self.n] = i32(s)
        self.vals[self.n] = v
        self.n = self.n + i64(1)
        return handle { slot: i32(s), gen: i32(pool<T>::pGen(e)) }
    }

    /* Free a slot **without moving any other value's dense place** by swapping the last
     * value into the hole: the live prefix stays contiguous, which is what keeps
     * iteration vectorizable. `remove` also invalidates every handle of that slot by
     * bumping its generation. Returns false when the handle was already stale. */
    fn remove(self: mut ref pool<T>, h: handle) -> bool {
        if !self.contains(h) { return false }
        let s    = i64(h.slot)
        let e    = self.ent[s]
        let d    = pool<T>::pDense(e)            /* where it lives in the dense array */
        let last = self.n - i64(1)
        if d != last {
            self.vals[d]   = self.vals[last]     /* move the last value into the hole */
            let moved = i64(self.slots[last])
            self.slots[d] = i32(moved)
            let me = self.ent[moved]
            self.ent[moved] = pool<T>::pPack(pool<T>::pGen(me), d + i64(1))
        }
        self.n = last
        /* Generation +1 (old handles are stale) and onto the free list, in one store. */
        self.ent[s] = pool<T>::pPack(pool<T>::pGen(e) + i64(1), i64(self.free) + self.cap + i64(2))
        self.free = i32(s)
        return true
    }

    /* Drop every value but **keep the capacity and the slots** (memory is reused, not
     * returned -- returning memory needs a pool: phase 1). */
    fn clear(self: mut ref pool<T>) {
        var i: i64 = 0
        while i < self.cap {
            let nxt = i + i64(1)
            var low: i64 = nxt + self.cap + i64(2)
            if nxt >= self.cap { low = i64(-1) + self.cap + i64(2) }
            self.ent[i] = pool<T>::pPack(pool<T>::pGen(self.ent[i]) + i64(1), low)
            i = i + i64(1)
        }
        self.free = i32(0)
        self.n  = i64(0)
    }

    /* The dense prefix, in order: contiguous, so a loop over it is a loop over memory. */
    @inline
    fn atDense(self: ref pool<T>, i: i64) -> T { return self.vals[i] }

    /* ⭐ **Hot loops should not go through the container.** This hands out the dense prefix
     * as a `slice` **without copying**, so a loop over it compiles to exactly the same
     * thing as a loop over a bare array (measured: 1.6 ns/element versus 4.0 through
     * `atDense` -- 2.5x, which is the price of a method call and a bounds check per
     * access, not of the data structure).
     *
     * It is the ECS shape: a system iterates a **column**, not the container.
     *
     * Lifetime: the view points into the container's storage, so the escape checker gives
     * it the receiver's depth -- it cannot outlive the pool (or the block the pool lives
     * in). Letting it escape is a compile error, not a dangling view.
     * Written through the pool, the view is stale: `insert` may reuse a slot (it does not
     * move values) but `grow` copies into new arrays, so take the view again after a
     * growth, or after `clear`. */
    fn denseView(self: ref pool<T>) -> slice<T> { return self.vals[0..self.n] }

    /* The handle of the i-th dense value (the inverse of `atDense`). */
    @inline
    fn handleAtDense(self: ref pool<T>, i: i64) -> handle {
        let s = i64(self.slots[i])
        return handle { slot: i32(s), gen: i32(pool<T>::pGen(self.ent[s])) }
    }

    /* ⭐ **gather**: resolve a batch of handles into dense indices once, so the hot loop
     * after it is plain index access into `denseView()` (measured 1.09x of a bare slice,
     * against 9.1x for using handles as indices).
     *
     * `out[i]` gets the dense index of `hs[i]`, or -1 when that handle is stale; the
     * return value is how many were valid (so a caller can compact or skip).
     * `out` must be at least as long as `hs`. */
    fn gather(self: ref pool<T>, hs: slice<handle>, out: mut slice<i64>) -> i64 {
        var k: i64 = 0
        var i: i64 = 0
        while i < hs.len {
            let h = hs[i]
            let s = i64(h.slot)
            var d: i64 = i64(-1)
            if s >= i64(0) && s < self.cap {
                let e = self.ent[s]
                if pool<T>::pLow(e) <= self.cap && pool<T>::pGen(e) == i64(h.gen) {
                    d = pool<T>::pDense(e)
                    k = k + i64(1)
                }
            }
            out[i] = d
            i = i + i64(1)
        }
        return k
    }

    /* A copy of the live values as a `slice`, allocated in the **caller's** block: the
     * escape machinery promotes it, so the view lives exactly as long as that block and
     * is reclaimed with it. One copy, and then ordinary `slice` code (print, IO, any
     * algorithm) works. */
    fn toSlice(self: ref pool<T>) -> slice<T> {
        var out: mut slice<T> = new T[self.n]
        var i: i64 = 0
        while i < self.n { out[i] = self.vals[i]  i = i + i64(1) }
        return out
    }

    /* Double the capacity. The old arrays stay in the arena (that is what a pool will
     * fix in phase 1+); because the same pool object is reused, this happens O(log n)
     * times over its life, so the waste is bounded, not linear. */
    fn grow(self: mut ref pool<T>) {
        let ncap = self.cap * i64(2)
        var nv: mut slice<T>   = new T[ncap]
        var ns: mut slice<i32> = new i32[ncap]
        var ne: mut slice<i64> = new i64[ncap]
        var i: i64 = 0
        while i < self.n {
            nv[i] = self.vals[i]
            ns[i] = self.slots[i]
            i = i + i64(1)
        }
        i = 0
        while i < self.cap { ne[i] = self.ent[i]  i = i + i64(1) }
        /* The new slots join the free list, in front of the old ones. */
        i = self.cap
        while i < ncap - i64(1) {
            ne[i] = pool<T>::pPack(i64(0), i + i64(1) + ncap + i64(2))
            i = i + i64(1)
        }
        ne[ncap - i64(1)] = pool<T>::pPack(i64(0), i64(self.free) + ncap + i64(2))
        self.free  = i32(self.cap)
        self.cap   = ncap
        self.vals  = nv
        self.slots = ns
        self.ent   = ne
    }
}
