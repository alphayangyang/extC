/* std/hash/sha1.extc —— SHA-1（FIPS 180-4）：流式、零分配、热路径无边界检查。
 *
 * 为什么还要 SHA-1：**它没死，只是不该再用它做签名**。UUID v5（RFC 4122 §4.3）就是
 * SHA-1(namespace ∥ name)，而 QQBot 的数据库主键正是 uuid5 ⇒ 要跟 Python 的 `uuid.uuid5`
 * **逐字节相同**，就必须有它（`tests/hash/` 里有对拍判据）。
 *
 * 形状与 `sha256.extc` 逐条相同（零分配、流式不中转、`@unchecked` 的核心），
 * 唯一区别是 80 轮分四组（f 与 K 每组不同）—— 分组写在代码结构里，不在热循环里判分支。
 */

@private
fn pRotl(x: u32, n: u32) -> u32 {
    return (x << n) | (x >> (u32(32) - n))
}

/* 一次算完。`out.len < 20` 返回 false。 */
@private
fn sha1Sum(data: slice<u8>, out: mut slice<u8>) -> bool {
    var c: sha1State
    c.init()
    c.update(data)
    return c.final(out)
}

/* 摘要 → 小写十六进制（与 `sha256::sha1Hex` 同一形状）。 */
@private
fn sha1Hex(digest: slice<u8>, out: mut slice<u8>) -> i64 {
    if out.len < digest.len * 2 { return -1 }
    var i: i64 = 0
    while i < digest.len {
        let b: u8 = digest[i]
        let hi: u8 = (b >> 4) & u8(0x0f)
        let lo: u8 = b & u8(0x0f)
        if hi < u8(10) { out[i * 2] = u8(48) + hi } else { out[i * 2] = u8(87) + hi }
        if lo < u8(10) { out[i * 2 + 1] = u8(48) + lo } else { out[i * 2 + 1] = u8(87) + lo }
        i = i + 1
    }
    return digest.len * 2
}

@noCopy
struct sha1State {
    h: [5]u32
    @private buf: [64]u8
    used: i64
    total: u64

    fn init(self: mut ref sha1State) -> void {
        self.h[0] = 0x67452301
        self.h[1] = 0xefcdab89
        self.h[2] = 0x98badcfe
        self.h[3] = 0x10325476
        self.h[4] = 0xc3d2e1f0
        self.used = 0
        self.total = u64(0)
    }

    /* 唯一签字处：下标全由构造保证在界内。 */
    @private
    @unchecked
    fn pBlockAt(self: mut ref sha1State, d: slice<u8>, off: i64) -> void {
        var w: [80]u32
        var i: i64 = 0
        while i < 16 {
            let o: i64 = off + i * 4
            w[i] = (u32(d[o]) << 24) | (u32(d[o + 1]) << 16) | (u32(d[o + 2]) << 8) | u32(d[o + 3])
            i = i + 1
        }
        while i < 80 {
            w[i] = pRotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], u32(1))
            i = i + 1
        }
        var a: u32 = self.h[0]
        var b: u32 = self.h[1]
        var c: u32 = self.h[2]
        var dd: u32 = self.h[3]
        var e: u32 = self.h[4]
        /* 四组各 20 轮：f 与 K 是常量，写在结构里（热循环里没有分支）。 */
        i = 0
        while i < 20 {
            let f: u32 = (b & c) | ((~b) & dd)
            let t: u32 = pRotl(a, u32(5)) + f + e + u32(0x5a827999) + w[i]
            e = dd
            dd = c
            c = pRotl(b, u32(30))
            b = a
            a = t
            i = i + 1
        }
        while i < 40 {
            let f: u32 = b ^ c ^ dd
            let t: u32 = pRotl(a, u32(5)) + f + e + u32(0x6ed9eba1) + w[i]
            e = dd
            dd = c
            c = pRotl(b, u32(30))
            b = a
            a = t
            i = i + 1
        }
        while i < 60 {
            let f: u32 = (b & c) | (b & dd) | (c & dd)
            let t: u32 = pRotl(a, u32(5)) + f + e + u32(0x8f1bbcdc) + w[i]
            e = dd
            dd = c
            c = pRotl(b, u32(30))
            b = a
            a = t
            i = i + 1
        }
        while i < 80 {
            let f: u32 = b ^ c ^ dd
            let t: u32 = pRotl(a, u32(5)) + f + e + u32(0xca62c1d6) + w[i]
            e = dd
            dd = c
            c = pRotl(b, u32(30))
            b = a
            a = t
            i = i + 1
        }
        self.h[0] = self.h[0] + a
        self.h[1] = self.h[1] + b
        self.h[2] = self.h[2] + c
        self.h[3] = self.h[3] + dd
        self.h[4] = self.h[4] + e
    }

    fn update(self: mut ref sha1State, data: slice<u8>) -> void {
        self.total = self.total + u64(data.len)
        var off: i64 = 0
        var held: bool = false
        if self.used > 0 {
            let want: i64 = 64 - self.used
            if data.len < want {
                var i: i64 = 0
                while i < data.len {
                    self.buf[self.used + i] = data[i]
                    i = i + 1
                }
                self.used = self.used + data.len
                held = true
            } else {
                var i: i64 = 0
                while i < want {
                    self.buf[self.used + i] = data[i]
                    i = i + 1
                }
                var blk: [64]u8
                var j: i64 = 0
                while j < 64 {
                    blk[j] = self.buf[j]
                    j = j + 1
                }
                self.pBlockAt(blk[..], 0)
                self.used = 0
                off = want
            }
        }
        if !held {
            while data.len - off >= 64 {
                self.pBlockAt(data, off)
                off = off + 64
            }
            var j: i64 = 0
            while off + j < data.len {
                self.buf[j] = data[off + j]
                j = j + 1
            }
            self.used = j
        }
    }

    /* 收尾。`out.len < 20` 返回 false。 */
    fn final(self: mut ref sha1State, out: mut slice<u8>) -> bool {
        if out.len < 20 { return false }
        let bits: u64 = self.total * u64(8)
        var i: i64 = self.used
        self.buf[i] = u8(0x80)
        i = i + 1
        if i > 56 {
            while i < 64 {
                self.buf[i] = u8(0)
                i = i + 1
            }
            var blk0: [64]u8
            var t0: i64 = 0
            while t0 < 64 {
                blk0[t0] = self.buf[t0]
                t0 = t0 + 1
            }
            self.pBlockAt(blk0[..], 0)
            i = 0
        }
        while i < 56 {
            self.buf[i] = u8(0)
            i = i + 1
        }
        var j: i64 = 0
        while j < 8 {
            self.buf[56 + j] = u8((bits >> u64((7 - j) * 8)) & u64(0xff))
            j = j + 1
        }
        var blk: [64]u8
        var t: i64 = 0
        while t < 64 {
            blk[t] = self.buf[t]
            t = t + 1
        }
        self.pBlockAt(blk[..], 0)
        var w: i64 = 0
        while w < 5 {
            let v: u32 = self.h[w]
            out[w * 4] = u8((v >> 24) & u32(0xff))
            out[w * 4 + 1] = u8((v >> 16) & u32(0xff))
            out[w * 4 + 2] = u8((v >> 8) & u32(0xff))
            out[w * 4 + 3] = u8(v & u32(0xff))
            w = w + 1
        }
        return true
    }
}

/* std/hash/sha256.extc —— SHA-256（FIPS 180-4）：流式、零分配、热路径无边界检查。
 *
 * 形状是为"最快 + 内存少"选的，三条都能量：
 *
 *   1. **零分配**：整个状态是 `sha256State`（8×u32 + 64B 块缓冲 + 两个计数 = 112 字节），住在调用方的
 *      栈或 arena 里。热路径上一次 `new`、一次堆操作都没有 ⇒ 哈希不产生垃圾、不碰板。
 *      （`@noCopy` 是故意的：状态有身份，复制它只会得到两个名字指着同一个位置。）
 *   2. **流式且不中转**：`update` 对满块**直接从输入视图上压缩**（`pBlockAt(d, off)`），
 *      不先拷进 64 字节缓冲。1 MiB 的输入与 1 字节的输入走同一条路。
 *   3. **`@unchecked` 的核心**：`pBlockAt` 的下标全由构造保证在界内（`i < 64`；
 *      `off + 64 <= d.len` 由调用方在进函数前判过），所以热循环里没有边界检查。
 *      这不是偷懒：`std/sys/mem.extc` 记过一次实测教训 —— 逐字节的边界检查占了
 *      **25.5 条指令/字节里的 30%**。代价是这一处**签字**：`grep -c '@unchecked'` 数得清，
 *      写错就是 UB。
 *
 * 用法：
 *     var out: [32]u8
 *     digest::sha256.sum(data, out[..])            // 一次算完
 *
 *     var c: sha256State                           // 流式（零分配）
 *     c.init()
 *     c.update(chunk1)
 *     c.update(chunk2)
 *     if !c.final(out[..]) { ... }                   // 缓冲不够返回 false，不 trap
 *
 *     digest::sha256.hex(out[..], hexbuf[..])     // 十六进制（uuid5 / 签名都用得上）
 *
 * @code
 * use std::io
 * use std::hash::digest
 *
 * fn main() -> i32 {
 *     var out: [32]u8
 *     var hexbuf: [64]u8
 *     if !digest::sha256.sum("abc", out[..]) { return 1 }        // 缓冲不足 32 字节时返回 false
 *     let n: i64 = digest::sha256.hex(out[..], hexbuf[..])       // 缓冲不足 64 字节时返回 -1
 *     io::cout << "n=" << n << " " << hexbuf[..n] << "\n"
 *     return 0
 * }
 * @endcode
 */

@private
fn pRotr(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (u32(32) - n))
}

/* 一次算完（`sha256State` 在栈上，零分配）。`out.len < 32` 返回 false。 */
@private
fn sha256Sum(data: slice<u8>, out: mut slice<u8>) -> bool {
    var c: sha256State
    c.init()
    c.update(data)
    return c.final(out)
}

/* 摘要 → 小写十六进制；返回写入的字符数（`out.len < 2*digest.len` 返回 -1）。
 * 不查表：十六进制是算术（`v < 10 ⇒ '0'+v`，否则 `'a'+v-10`），而表要一次受检索引。 */
@private
fn sha256Hex(digest: slice<u8>, out: mut slice<u8>) -> i64 {
    if out.len < digest.len * 2 { return -1 }
    var i: i64 = 0
    while i < digest.len {
        let b: u8 = digest[i]
        let hi: u8 = (b >> 4) & u8(0x0f)
        let lo: u8 = b & u8(0x0f)
        if hi < u8(10) { out[i * 2] = u8(48) + hi } else { out[i * 2] = u8(87) + hi }
        if lo < u8(10) { out[i * 2 + 1] = u8(48) + lo } else { out[i * 2 + 1] = u8(87) + lo }
        i = i + 1
    }
    return digest.len * 2
}

@noCopy
struct sha256State {
    h: [8]u32
    @private buf: [64]u8
    used: i64
    total: u64

    fn init(self: mut ref sha256State) -> void {
        self.h[0] = 0x6a09e667
        self.h[1] = 0xbb67ae85
        self.h[2] = 0x3c6ef372
        self.h[3] = 0xa54ff53a
        self.h[4] = 0x510e527f
        self.h[5] = 0x9b05688c
        self.h[6] = 0x1f83d9ab
        self.h[7] = 0x5be0cd19
        self.used = 0
        self.total = u64(0)
    }

    /* 唯一签字处：下标全由构造保证在界内（见文件头第 3 条）。 */
    @private
    @unchecked
    fn pBlockAt(self: mut ref sha256State, d: slice<u8>, off: i64) -> void {
        let k: [64]u32 = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
        ]
        var w: [64]u32
        var i: i64 = 0
        while i < 16 {
            let o: i64 = off + i * 4
            w[i] = (u32(d[o]) << 24) | (u32(d[o + 1]) << 16) | (u32(d[o + 2]) << 8) | u32(d[o + 3])
            i = i + 1
        }
        while i < 64 {
            let x: u32 = w[i - 15]
            let y: u32 = w[i - 2]
            let s0: u32 = pRotr(x, u32(7)) ^ pRotr(x, u32(18)) ^ (x >> 3)
            let s1: u32 = pRotr(y, u32(17)) ^ pRotr(y, u32(19)) ^ (y >> 10)
            w[i] = w[i - 16] + s0 + w[i - 7] + s1
            i = i + 1
        }
        var a: u32 = self.h[0]
        var b: u32 = self.h[1]
        var c: u32 = self.h[2]
        var d3: u32 = self.h[3]
        var e: u32 = self.h[4]
        var f: u32 = self.h[5]
        var g: u32 = self.h[6]
        var h8: u32 = self.h[7]
        i = 0
        while i < 64 {
            let S1: u32 = pRotr(e, u32(6)) ^ pRotr(e, u32(11)) ^ pRotr(e, u32(25))
            let ch: u32 = (e & f) ^ ((~e) & g)
            let t1: u32 = h8 + S1 + ch + k[i] + w[i]
            let S0: u32 = pRotr(a, u32(2)) ^ pRotr(a, u32(13)) ^ pRotr(a, u32(22))
            let maj: u32 = (a & b) ^ (a & c) ^ (b & c)
            let t2: u32 = S0 + maj
            h8 = g
            g = f
            f = e
            e = d3 + t1
            d3 = c
            c = b
            b = a
            a = t1 + t2
            i = i + 1
        }
        self.h[0] = self.h[0] + a
        self.h[1] = self.h[1] + b
        self.h[2] = self.h[2] + c
        self.h[3] = self.h[3] + d3
        self.h[4] = self.h[4] + e
        self.h[5] = self.h[5] + f
        self.h[6] = self.h[6] + g
        self.h[7] = self.h[7] + h8
    }

    /* 喂一段数据（任意长度；可喂任意多次）。 */
    fn update(self: mut ref sha256State, data: slice<u8>) -> void {
        self.total = self.total + u64(data.len)
        var off: i64 = 0
        var held: bool = false          /* 这次 update 全进了缓冲（没有满块可压） */
        if self.used > 0 {
            let want: i64 = 64 - self.used
            if data.len < want {
                var i: i64 = 0
                while i < data.len {
                    self.buf[self.used + i] = data[i]
                    i = i + 1
                }
                self.used = self.used + data.len
                held = true
            } else {
                var i: i64 = 0
                while i < want {
                    self.buf[self.used + i] = data[i]
                    i = i + 1
                }
                var blk: [64]u8
                var j: i64 = 0
                while j < 64 {
                    blk[j] = self.buf[j]
                    j = j + 1
                }
                self.pBlockAt(blk[..], 0)
                self.used = 0
                off = want
            }
        }
        if !held {
            /* 满块直接从**输入视图**上压缩：不中转、不拷贝。 */
            while data.len - off >= 64 {
                self.pBlockAt(data, off)
                off = off + 64
            }
            var j: i64 = 0
            while off + j < data.len {
                self.buf[j] = data[off + j]
                j = j + 1
            }
            self.used = j
        }
    }

    /* 收尾（填充 + 64 位大端长度）。`out.len < 32` 返回 false（不 trap）。 */
    fn final(self: mut ref sha256State, out: mut slice<u8>) -> bool {
        if out.len < 32 { return false }
        let bits: u64 = self.total * u64(8)
        var i: i64 = self.used
        self.buf[i] = u8(0x80)
        i = i + 1
        if i > 56 {
            while i < 64 {
                self.buf[i] = u8(0)
                i = i + 1
            }
            var blk: [64]u8
            var t: i64 = 0
            while t < 64 {
                blk[t] = self.buf[t]
                t = t + 1
            }
            self.pBlockAt(blk[..], 0)
            i = 0
        }
        while i < 56 {
            self.buf[i] = u8(0)
            i = i + 1
        }
        var j: i64 = 0
        while j < 8 {
            self.buf[56 + j] = u8((bits >> u64((7 - j) * 8)) & u64(0xff))
            j = j + 1
        }
        var blk: [64]u8
        var t: i64 = 0
        while t < 64 {
            blk[t] = self.buf[t]
            t = t + 1
        }
        self.pBlockAt(blk[..], 0)
        var w: i64 = 0
        while w < 8 {
            let v: u32 = self.h[w]
            out[w * 4] = u8((v >> 24) & u32(0xff))
            out[w * 4 + 1] = u8((v >> 16) & u32(0xff))
            out[w * 4 + 2] = u8((v >> 8) & u32(0xff))
            out[w * 4 + 3] = u8(v & u32(0xff))
            w = w + 1
        }
        return true
    }
}

/* std/hash/hmac.extc —— HMAC（RFC 2104）套在 SHA-256 / SHA-1 上。
 *
 * 零分配：两个 hash `state`（各 112 / 84 字节）+ 一个 64 字节块，都在栈上。
 * 键长 > 64 时按 RFC 先散列一次（这一步也不需要堆：摘要固定 32/20 字节）。
 *
 *     var mac: [32]u8
 *     if !hmacSha256(key, msg, mac[..]) { ... }
 *
 * 要截断（比如 HMAC-SHA256-128）就传一个更长的缓冲，取前 n 字节即可 —— 判据里有一条
 * 与 Python `hmac.new(...).digest()[:16]` 对拍。
 */

/* HMAC-SHA256。`out.len < 32` 返回 false。 */
@private
fn hmacSha256(key: slice<u8>, msg: slice<u8>, out: mut slice<u8>) -> bool {
    if out.len < 32 { return false }
    var kblk: [64]u8
    var i: i64 = 0
    while i < 64 {
        kblk[i] = u8(0)
        i = i + 1
    }
    if key.len > 64 {
        var kh: [32]u8
        if !sha256Sum(key, kh[..]) { return false }
        i = 0
        while i < 32 {
            kblk[i] = kh[i]
            i = i + 1
        }
    } else {
        i = 0
        while i < key.len {
            kblk[i] = key[i]
            i = i + 1
        }
    }
    var blk: [64]u8
    var inner: sha256State
    inner.init()
    i = 0
    while i < 64 {
        blk[i] = kblk[i] ^ u8(0x36)
        i = i + 1
    }
    inner.update(blk[..])
    inner.update(msg)
    var ih: [32]u8
    if !inner.final(ih[..]) { return false }
    var outer: sha256State
    outer.init()
    i = 0
    while i < 64 {
        blk[i] = kblk[i] ^ u8(0x5c)
        i = i + 1
    }
    outer.update(blk[..])
    outer.update(ih[..])
    return outer.final(out)
}

/* HMAC-SHA1。`out.len < 20` 返回 false。 */
@private
fn hmacSha1(key: slice<u8>, msg: slice<u8>, out: mut slice<u8>) -> bool {
    if out.len < 20 { return false }
    var kblk: [64]u8
    var i: i64 = 0
    while i < 64 {
        kblk[i] = u8(0)
        i = i + 1
    }
    if key.len > 64 {
        var kh: [20]u8
        if !sha1Sum(key, kh[..]) { return false }
        i = 0
        while i < 20 {
            kblk[i] = kh[i]
            i = i + 1
        }
    } else {
        i = 0
        while i < key.len {
            kblk[i] = key[i]
            i = i + 1
        }
    }
    var blk: [64]u8
    var inner: sha1State
    inner.init()
    i = 0
    while i < 64 {
        blk[i] = kblk[i] ^ u8(0x36)
        i = i + 1
    }
    inner.update(blk[..])
    inner.update(msg)
    var ih: [20]u8
    if !inner.final(ih[..]) { return false }
    var outer: sha1State
    outer.init()
    i = 0
    while i < 64 {
        blk[i] = kblk[i] ^ u8(0x5c)
        i = i + 1
    }
    outer.update(blk[..])
    outer.update(ih[..])
    return outer.final(out)
}

/* ---------------------------------------------------------------- 占位接收者：读作 `sha1.sum(...)`
 *
 * 空结构体 + 一个零大小全局实例，方法只是把调用转给上面的实现函数。没有运行时开销
 * （`self` 是一个零大小对象的地址，`-O2` 下整条链会被内联），但调用点读起来像一个命名空间。
 * 用 `var` 而不是 `let`：全局 `let` 的初值必须是编译期常量，而结构体字面量不算。这个对象
 * 从不被写入 —— 它只是个接收者占位符。 */
struct sha1Ops {
    fn sum(self: ref sha1Ops, data: slice<u8>, out: mut slice<u8>) -> bool { return sha1Sum(data, out) }
    fn hex(self: ref sha1Ops, digest: slice<u8>, out: mut slice<u8>) -> i64 { return sha1Hex(digest, out) }
}

struct sha256Ops {
    fn sum(self: ref sha256Ops, data: slice<u8>, out: mut slice<u8>) -> bool { return sha256Sum(data, out) }
    fn hex(self: ref sha256Ops, digest: slice<u8>, out: mut slice<u8>) -> i64 { return sha256Hex(digest, out) }
}

struct hmacOps {
    fn sha256(self: ref hmacOps, key: slice<u8>, msg: slice<u8>, out: mut slice<u8>) -> bool { return hmacSha256(key, msg, out) }
    fn sha1(self: ref hmacOps, key: slice<u8>, msg: slice<u8>, out: mut slice<u8>) -> bool { return hmacSha1(key, msg, out) }
}

var sha1: sha1Ops = sha1Ops { }
var sha256: sha256Ops = sha256Ops { }
var hmac: hmacOps = hmacOps { }
