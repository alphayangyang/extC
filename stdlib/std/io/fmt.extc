module std::io::fmt

use std::sys::io as sysio

/* std/io/fmt.extc -- 把"数字/浮点怎么变成字节"从流里拆出来。
 *
 * 只依赖两个内建（`extc_cout_put` / `extc_cout_flush`），和 fd、缓冲、流对象都不相干
 * ⇒ 拆出来以后 `io.extc` 只剩流本体，`std::io` 用门面把这里的名字再导出。
 * `FMT` 是"刚格式化好的那个数"的暂存处（只有这一份：格式化与取用必须看同一块缓冲）。
 */
/* ================================================================ 格式化（一处实现）
 *
 * `i64` → 十进制，写进 `out`，返回长度 ✓ 三个流共用这一份（内建 `print` 写死 stdout，
 * 文件流/stderr 流用它不了它 ✗ 所以格式化必须在库里，而且只能一份 ✓）
 *
 * **两位一查表**（`DIGITS` 是 "00" "01" … "99" 拼起来的常量 ✓ 每次除 100 出两位 ✓）：
 * 这是 `strconv.AppendInt` 那一招 —— 除法次数减半，而除法正是这条路上最贵的一步 ✓
 */
let DIGITS: slice<u8> = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

/* ── 热路径版：**全程只碰定长数组** ──────────────────────────────────────────
 *
 * 为什么另立一份（而不是把上面那个改快）：上面那个的 `out` 是 `slice<u8>`，
 * 而**视图下标在生成的 C 里是一次函数调用**（`slice_u8_index(..., 文件, 行号)` ✗）。
 * 一行输出 4 个操作数、每个数字要十几次下标 ⇒ 上亿次调用，实测就是它把这条路拖到
 * 224 ms（同为 1000 MB/s 量级但比 C 慢一档 ✗）。定长数组的下标是**内联的小检查** ✓
 * ⇒ 热路径写进一个**全局定长数组**（单线程，够用 ✓ 可重入性写在下面 ⚠️）。
 *
 * ⚠️ 因此 `FMT` 是"刚刚格式化好的那个数"的暂存处 ⇒ **别在格式化与取用之间再格式化** ✓
 *    （`<<` 里是连续的"格式化 + 立刻取出"，所以安全 ✓）
 */
var FMT: [24]u8
var PAIRS: [200]u8
var PAIRS_READY: bool = false

@inline
fn pairsReady() {
    if PAIRS_READY { return }
    var d: i64 = 0
    var i: i64 = 0
    while i < 200 {
        PAIRS[i] = DIGITS[i]
        i = i + 1
    }
    PAIRS_READY = true
}

/* 把 `v` 写进 `FMT` 的**尾部往前**，返回**起点**（长度 = 24 - 起点 ✓）
 *
 * ⚠️ 必须**从后往前**填：两位一组的表给的是"高位在前"的一对，若按低位在前追加、
 * 最后整体反转，**对内的顺序也会被翻** ⇒ `40` 会印成 `04` ✗（这个 bug 真发生过）。
 * 从后往前填出来就是正序，**不需要反转** ✓ 这也是 `strconv.AppendInt` 的做法 ✓ */
@inline
fn fmtI64Fast(v: i64) -> i64 {
    var end: i64 = 24
    var neg: bool = v < 0
    /* 取位**从负数一侧**做，绝不先取绝对值：`0 - v` 在 `v` 是 `i64` 最小值时溢出
     * （实测：打印它会 `trap: value does not fit in the target type` —— 因为带检查的算术把它
     * 抓住了；换成 C 会安静地打出错的数）。负数取余 `v % 100 ∈ (-100, 0]` ⇒ `0 - (v % 100)`
     * 永远落在 `[0, 100)`，安全；`v / 100` 向零截断，循环照旧收敛。 */
    while v >= 100 || v <= -100 {
        var m: i64 = v % 100
        if m < 0 { m = 0 - m }    /* m ∈ (-100, 100) ⇒ 这一步永远安全 */
        v = v / 100                    /* 向零截断 ⇒ 循环收敛，符号不影响 */
        end = end - 2
        FMT[end]     = PAIRS[m * 2]
        FMT[end + 1] = PAIRS[m * 2 + 1]
    }
    var r: i64 = v
    if r < 0 { r = 0 - r }        /* |v| < 100 ⇒ 安全；`2^63` 那种大小从不出现 */
    if r >= 10 {
        end = end - 2
        FMT[end]     = PAIRS[r * 2]
        FMT[end + 1] = PAIRS[r * 2 + 1]
    } else {
        end = end - 1
        FMT[end] = u8(48 + r)
    }
    if neg {
        end = end - 1
        FMT[end] = u8(45)
    }
    return end
}

@inline
/* ---------------------------------------------------------------- 格式化输出（f"…" v2 的展开目标）
 *
 * `f"{s:>8}"` / `f"{n:04}"` / `f"{x:.2f}"` 将来展开到下面这些原语。**宽度按字节算**，不按显示列
 * （中文按字节计数）—— 列宽需要显示宽度表，v2 不做，如实记账。
 * 零填充（`{:04}`）等价于 `padInt(v, w, u8(48), RIGHT)`，但**符号在前**：`-5` 宽 4 ⇒ `-005`。 */
let LEFT: i64 = 0
let RIGHT: i64 = 1
let CENTER: i64 = 2

@inline
fn pFillBytes(n: i64, fill: u8) -> void {
    var pad: [64]u8
    var i: i64 = 0
    while i < 64 { pad[i] = fill  i = i + 1 }
    var left: i64 = n
    while left > 0 {
        var k: i64 = left
        if k > 64 { k = 64 }
        sysio::extc_cout_put(pad[0..k].data, k)
        left = left - k
    }
}

/* 已经格式化好的文本按 宽度/填充/对齐 写出去。 */
@inline
fn pPadText(t: slice<u8>, width: i64, fill: u8, align: i64) -> void {
    var n: i64 = width - t.len
    if n <= 0 {
        sysio::extc_cout_put(t.data, t.len)
    } else if align == CENTER {
        let l: i64 = n / 2
        pFillBytes(l, fill)
        sysio::extc_cout_put(t.data, t.len)
        pFillBytes(n - l, fill)
    } else if align == LEFT {
        sysio::extc_cout_put(t.data, t.len)
        pFillBytes(n, fill)
    } else {
        pFillBytes(n, fill)
        sysio::extc_cout_put(t.data, t.len)
    }
}

/* 定点格式化 `v` 到 `out`（`prec` 位小数，四舍五入，负号在前）。返回长度。
 * 边界：`|v| >= 1e15` 直接 **trap**（改用 `<<`）—— 与其安静地打出错的数，不如响亮。
 * 注意范围检查用 **float 字面量**：`f64(1000000000000000)` 里那个整数字面量会先按默认整型走
 * ⇒ 溢出绕回，判断就失真了（实测：`1.5` 也被判成超范围 ✗）。 */
@inline
fn pFmtF(v: f64, prec: i64, out: mut slice<u8>) -> i64 {
    if v >= 1.0e15 || v <= -1.0e15 {
        trap("io::pFmtF: |value| >= 1e15 is out of range for the fixed-point formatter")
    }
    var o: i64 = 0
    var x: f64 = v
    if x < f64(0) { out[o] = u8(45)  o = o + 1  x = f64(0) - x }
    var scale: f64 = f64(1)
    var i: i64 = 0
    while i < prec { scale = scale * f64(10)  i = i + 1 }
    x = x * scale + f64(0.5)
    let ip: i64 = i64(x / scale)
    var fp: i64 = i64(x - f64(ip) * scale)
    var digits: [24]u8
    var nd: i64 = 0
    var q: i64 = ip
    if q == 0 { digits[0] = u8(48)  nd = 1 }
    while q > 0 { digits[nd] = u8(48) + u8(q % 10)  q = q / 10  nd = nd + 1 }
    var k: i64 = nd
    while k > 0 { k = k - 1  out[o] = digits[k]  o = o + 1 }
    if prec > 0 {
        out[o] = u8(46)  o = o + 1
        var fd: [12]u8
        var j: i64 = 0
        while j < prec { fd[j] = u8(48) + u8(fp % 10)  fp = fp / 10  j = j + 1 }
        var m: i64 = prec
        while m > 0 { m = m - 1  out[o] = fd[m]  o = o + 1 }
    }
    return o
}

/* 无符号版：`u64` 的上界 `18446744073709551615` 有 20 位，24 字节缓冲够用。
 * 与 `fmtI64Fast` 同形（尾部往前填、两位一组），只是**没有符号**、余数不为负，
 * 所以不需要"从负数一侧取位"那一招。与 `FMT` 同一个约定：格式化完立刻取用。 */
@inline
fn fmtU64Fast(v: u64) -> i64 {
    var end: i64 = 24
    while v >= u64(100) {
        let m: u64 = v % u64(100)
        v = v / u64(100)
        end = end - 2
        FMT[end]     = PAIRS[i64(m) * 2]
        FMT[end + 1] = PAIRS[i64(m) * 2 + 1]
    }
    let r: i64 = i64(v)
    if r >= 10 {
        end = end - 2
        FMT[end]     = PAIRS[r * 2]
        FMT[end + 1] = PAIRS[r * 2 + 1]
    } else {
        end = end - 1
        FMT[end] = u8(48 + r)
    }
    return end
}

fn fmtI64(v: i64, out: mut slice<u8>) -> i64 {
    if v == 0 { out[0] = u8(48)  return 1 }
    var u: i64 = v
    var neg: bool = v < 0
    if neg { u = 0 - u }
    var tmp: [24]u8
    var n: i64 = 0
    while u >= 100 {
        let r = u % 100
        u = u / 100
        tmp[n]     = DIGITS[r * 2]
        tmp[n + 1] = DIGITS[r * 2 + 1]
        n = n + 2
    }
    if u >= 10 {
        tmp[n]     = DIGITS[u * 2]
        tmp[n + 1] = DIGITS[u * 2 + 1]
        n = n + 2
    } else if u > 0 {
        tmp[n] = u8(48 + u)
        n = n + 1
    }
    if neg { tmp[n] = u8(45)  n = n + 1 }
    var k: i64 = 0
    while k < n && k < out.len {
        out[k] = tmp[n - 1 - k]
        k = k + 1
    }
    return k
}

/* 控制台输出：**先塞进运行期的缓冲**，满了它自己写出去；尾巴由 `main` 返回前冲刷 ✓
 * （`println` 已弃置 ⇒ 不再有"与 stdio 抢顺序"的问题 ✓ 只剩"退出前别丢"一条 ✓）*/
fn flushCout() { sysio::extc_cout_flush() }

/* ================================================================ print / println
 *
 * 不用链式写法的一行输出：`io::println(s)` 就是 `io::cout << s << "\n"` 的薄包装。
 * 走**同一个缓冲**（`extc_cout_put`）⇒ 与 `io::cout` 混用也不会有顺序问题 ✓
 * 与 prelude 里弃置的全局 `println` 不同命名空间（这里显式写 `io::`）。
 */
fn print(s: slice<u8>) {
    if s.len > 0 { sysio::extc_cout_put(s.data, s.len) }
}

fn println(s: slice<u8>) {
    print(s)
    sysio::extc_cout_put("\n".data, 1)
}
