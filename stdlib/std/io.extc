/* std/io.extc -- a plain library, written in extC, with no privileged access.
 *
 * This is the thin wrapper over the bare primitives that `docs/topics/IO.md`
 * describes, turning them into shapes that are pleasant to use: `slice<u8>` is
 * two arguments on the C side, so `s.data` and `s.len` are passed down
 * separately here.
 *
 * ================================================================ two input styles
 *
 * Everyone needs "read a line" and "read an integer", but the two use cases do
 * not want the same shape, so both live here:
 *
 *   | style | use | why |
 *   |---|---|---|
 *   | **contest**: space separated numbers | `nextInt` / `nextToken` | no line to split first |
 *   | **protocol**: one command per line | `nextLine` | the line is the unit of the protocol |
 *
 * Both are built on the same `reader`, so they can be mixed: `nextInt` skips
 * leading whitespace, which consumes the end of the line as well.
 *
 * ================================================================ why `reader` exists
 *
 * NOTE: **reading a byte at a time is a trap** (the old `readLine` did exactly
 * that). Measured on 19MB / 500,000 lines it took **2.30 s**, against
 * **0.012 s** for block reads, a factor of **190x**. The reason is not that
 * reading is slow: it is that **every single byte enters the kernel**.
 *
 * So `reader` is where the work happens. One `read(2)` brings back 64KB, and the
 * splitting then happens in memory. That is the sentence from
 * `docs/topics/IO.md` section 0: **reading = read whole blocks + split in memory**.
 *
 * The buffer is **not** supplied by the caller (`readerOf(fd)` is enough): that
 * 64KB comes from `new`, so it lives in the arena of the block that contains the
 * call site, and it has the same lifetime as the `reader` itself.
 * (The cost: a `reader` may not outlive the block that created it. The escape
 * checker enforces this, so going past that block is a **compile error**, not a
 * dangling pointer.)
 *
 * ================================================================ three failures, kept apart
 *
 * Three failures with three different causes should not be squeezed into one
 * return value: what the compiler cannot prove must stay visible in the syntax.
 *
 *   | case | return |
 *   |---|---|
 *   | **hit EOF** | `success(0)` -- not an error |
 *   | **line longer than `out`** | `failure(lineTooLong)` -- data not read in full |
 *   | **`read(2)` failed** | `failure(readFailed)` -- the previous read may be bad |
 *
 * The old `readLine` treated the last two **both as EOF**
 * (`if got <= 0 { return n }`), so a read error looked like "the file ended",
 * and an over-long line was **silently split into two "lines"**. Data corruption
 * that cannot be seen is exactly what these three results are there to prevent.
 */
/* ⚠️ The privileged layer is imported under a name that **cannot collide**: this file's
 * own module is `std::io`, whose short name is `io` too. Spelling a call `sysio::exit(..)`
 * inside `std::io` made the qualifier resolve to *this* file, and the generated C had
 * `io$exit` calling `io$exit` -- unbounded recursion with no diagnostic (measured: a
 * runtime trap, not a compile error). `sysio` is what `std::fs` uses for the same
 * reason. */
use std::sys::io as sysio

/* A read failed, and **why** it failed: an enum, not a magic value.
 * NOTE: the payload is what lets an error message say how many bytes were read
 * (`lineTooLong(i64)`) or which fd failed (`readFailed(i32)`); a message like
 * `failed(5)` tells the user nothing. */
type ioError = | readFailed(i32) | lineTooLong(i64) | writeFailed(i32) | notATerminal(i32)
               | closed(i32)        /* 用了一个已经关掉的句柄 —— 那是程序 bug，但**看得见** ✓ */
               | destFull(i64)      /* `readAll`：目标缓冲满了，而文件还有数据 ⇒ 不静默截断 ✗ */

/* Block size: **64KB**, one of the sizes that measured fastest.
 * Measured on a 291MB file: 64B 0.62s/469MB/s (4.7 million syscalls) - 4KB
 * 0.05s/5820MB/s - **16KB and 64KB both 0.04s/7275MB/s** - 1MB 0.05s.
 * -> everything from 16KB up is flat, so 64KB it is, which also saves syscalls
 *    in protocol code that reads a few lines at a time.
 * -> this is why the 4KB in `docs/topics/IO.md` section 9 became 64KB. */
let BLK: i64 = 65536

/* The largest `i64`, used by the overflow check in `nextInt`.
 * NOTE: it is written out by hand because there is **no built-in** for it;
 * `9223372036854775807` = 2^63 - 1. */
let I64_MAX: i64 = 9223372036854775807

/* The fds for standard input and output. `std::sys::io` declares them too; they
 * are exported again here so that **`use std::io` alone is enough** for a user. */
let STDIN_FD: i32  = 0
let STDOUT_FD: i32 = 1

/* Flush the `println` side. This is **required** when mixing it with the direct
 * fd writes below, or the output comes out in the wrong order -- the most
 * annoying failure in an interactive program. */
fn flushOut() { flush() }



/* Write a whole block of bytes to **stdout** (`println` prints values, this
 * writes bytes).
 *
 * **`flush()` must come first.** This is the fix for a real defect: `println`
 * goes through C `printf` (**buffered**), while this is a **direct** `write(2)`.
 * Mixing the two streams puts the bytes in the wrong order, so a prompt is still
 * sitting in the printf buffer while the bytes written here have already
 * arrived.
 * (The old contract was that the caller had to remember `flushOut()`, which is
 * the most annoying thing to get wrong in an interactive program.)
 * `flush()` is a compiler built-in and flushes exactly the stdio side, so one
 * line covers it.
 *
 * NOTE: the thorough fix would be to make `println` write into the same
 * `writer`, but that means changing codegen and was not done here. What is here
 * turns a mistake you cannot see into a mistake you cannot make. */
fn writeBytes(buf: slice<u8>) -> i64 {
    /* 走同一个缓冲：控制台输出只有一个出口，顺序才不需要人操心 ✓ */
    if buf.len > i64(0) { extc_cout_put(buf.data, buf.len) }
    return buf.len
}
fn writeBytesRaw(buf: slice<u8>) -> i64 {
    flush()
    return sysio::write(sysio::STDOUT, buf.data, buf.len)
}

/* ================================================================ writer */

/* A buffered writer, symmetric with `reader`:
 * one `write(2)` emits a whole block instead of entering the kernel once per
 * piece of text.
 *
 * The buffer has to be a **visible field** (`buf` / `len` / `cap`), which is the
 * point `docs/topics/IO.md` keeps making about the `cin` black box: `FILE*` hides
 * its buffer inside, so you cannot see it when something goes wrong. Here you can
 * read `w.len` whenever you like, flush on your own, and decide when bytes leave.
 *
 * NOTE: when the fd is STDOUT, the `println` side must be flushed **before every
 * flush**, or the two streams interleave out of order again (the same trap as
 * `writeBytes` above). */
@noCopy
struct writer {
    fd:  i32
    buf: mut slice<u8>
    len: i64

    fn cap(self: ref writer) -> i64 { return self.buf.len }

    /* Emit what is buffered, including the `println` side, which is what keeps
     * the order right. Returns the number of bytes written (0 = it was empty). */
    fn flush(self: mut ref writer) -> result<i64, ioError> {
        if self.fd == sysio::STDOUT || self.fd == sysio::STDERR { flush() }
        if self.len == i64(0) { return success(i64(0)) }
        let n = sysio::write(self.fd, self.buf.data, self.len)
        if n < i64(0) { return failure(ioError.writeFailed(self.fd)) }
        self.len = 0
        return success(n)
    }

    /* Write a run of bytes. If it does not fit, flush first: bytes are never
     * dropped and the buffer never grows. */
    fn write(self: mut ref writer, data: slice<u8>) -> result<i64, ioError> {
        var done: i64 = 0
        while done < data.len {
            if self.len >= self.buf.len { self.flush()? }
            /* Copy as much as fits. */
            var room: i64 = self.buf.len - self.len
            var left: i64 = data.len - done
            if left < room { room = left }
            var k: i64 = 0
            while k < room {
                self.buf[self.len + k] = data[done + k]
                k = k + 1
            }
            self.len = self.len + room
            done = done + room
        }
        return success(done)
    }
}

/* Build a writer: an `fd` plus an **implicit 64KB buffer**, symmetric with
 * `readerOf`. The 64KB comes from `new`, so it lands in the arena of the **call
 * site** and has the same lifetime as the writer itself. */
fn writerOf(fd: i32) -> writer {
    var b: mut slice<u8> = new u8[BLK]
    return { fd: fd, buf: b, len: 0 }
}

/* One read from an fd; returns the number of bytes read (0 = EOF, negative =
 * error).
 * NOTE: this is the bare primitive layer, so the caller inspects the return
 * value; use `reader` for a shape that is easier to use. */
fn readSome(fd: i32, buf: mut slice<u8>) -> i64 {
    return sysio::read(fd, buf.data, buf.len)
}

/* ================================================================ reader */

@noCopy
/* ── 解析的「显式状态」版：一处实现，`reader` 与两个流共用 ────────────────────
 *
 * 为什么要有它：`reader` 把状态挂在结构体上，而两个流的缓冲在**模块全局**
 * （含引用的 `mut slice<u8>` 不能当全局 ✗）⇒ 每读一个数都得搭一次桥
 * （建 reader + 读完写回 len/pos ✗ 实测 20M 次约 100ms ✓）
 * ⇒ 把状态**显式**传进来：`fd + buf + len + pos`（都是 `mut ref` ✓）于是流直接把自己的
 * 全局传进来，**没有桥** ✓ 而 `reader::nextInt` 也调它 ⇒ 只有一份解析实现 ✓
 *
 * `got` 是"到底读到数字没有"的回执 ⇒ 流不必再问 `eof()` 去消"`0` 与 EOF 同形"的歧义 ✓
 */
@inline
fn fillState(fd: i32, buf: mut slice<u8>, len: mut ref i64, pos: mut ref i64) -> result<i64, ioError> {
    let n = sysio::read(fd, buf.data, buf.len)
    if n < i64(0) { return failure(ioError.readFailed(fd)) }
    *len = n
    *pos = 0
    return success(n)
}

/* 收一位数字。返回 false = 溢出（调用方报 `lineTooLong` ✓）
 * 溢出检查**只从第 19 位起**才做（前 18 位里 `v*10+d` 数学上不可能溢出 ✓ 10^18 < 2^63 ✓）
 * —— 语义与"每一位都检查"完全相同 ✓ 但热路径上省掉一次除法 ✓ */
@inline
fn accDigit(v: mut ref i64, nd: mut ref i64, d: i64) -> bool {
    if *nd < i64(18) {
        *v = *v * i64(10) + d
    } else {
        if *v > (I64_MAX - d) / i64(10) { return false }
        *v = *v * i64(10) + d
    }
    *nd = *nd + i64(1)
    return true
}

@inline
fn nextI64State(fd: i32, buf: mut slice<u8>, len: mut ref i64, pos: mut ref i64,
                got: mut ref bool) -> result<i64, ioError> {
    var neg: bool = false
    var v: i64 = 0
    var nd: i64 = 0                 /* 已收的位数（前 18 位不可能溢出 ⇒ 那次检查可以省 ✓）*/
    var saw: bool = false           /* 见过数字 */
    var seen: bool = false          /* 见过非空白字节 */
    var pushed: i64 = i64(0)
    var bad: bool = false
    var b: i64 = i64(0)

    while true {
        if pushed == i64(-2) { pushed = i64(0)  b = i64(-1) }
        else if pushed > i64(0) { b = pushed  pushed = i64(0) }
        else {
            if *pos >= *len {
                let n = fillState(fd, buf, len, pos)?
                if n == i64(0) { b = i64(-1) }
                else {
                    b = i64(buf[*pos])
                    *pos = *pos + i64(1)
                }
            } else {
                b = i64(buf[*pos])
                *pos = *pos + i64(1)
            }
        }

        if !seen {
            if b < i64(0) { break }
            if !isSpaceByte(b) {
                seen = true
                if b == i64(45) { neg = true }
                else { pushed = b }
            }
            continue
        }
        if bad {
            if b < i64(0) { pushed = i64(-2) }
            else { *pos = *pos - i64(1) }
            break
        }
        if b < i64(0) { break }
        if b >= i64(48) && b <= i64(57) {
            saw = true
            if !accDigit(ref v, ref nd, b - i64(48)) { return failure(ioError.lineTooLong(v)) }
            /* ⚡ **紧内层：只认数字**（每字节 1 个分支 ✓ 而不是绕一圈状态机的 ~7 个 ✗）
             * 为什么能这么改而不动语义：内层**只看不取**（`pos` 只在确认是数字时才前进 ✓）
             * ⇒ 一旦不是数字就退回外层，**终止符仍走原来那套**（换行吃掉 / CRLF / 推回 ✓）
             * 全部一字不改 ✓ 这就是 cachegrind 量出来的真因：分支 2.7× ✗（指令只 1.29× ✓
             * 预测失败还一样 ✓ ⇒ 差值在**每字节的分支数**上 ✓）*/
            while *pos < *len {
                let nb = i64(buf[*pos])
                if nb < i64(48) || nb > i64(57) { break }
                *pos = *pos + i64(1)
                if !accDigit(ref v, ref nd, nb - i64(48)) { return failure(ioError.lineTooLong(v)) }
            }
            continue
        }
        if !saw { continue }

        if b == i64(10) { break }
        if b == i64(13) {
            if *pos < *len {
                if i64(buf[*pos]) == i64(10) { *pos = *pos + i64(1) }
            }
            break
        }
        bad = true
    }

    *got = saw
    if !saw { return success(i64(0)) }
    /* 同一个坑：`v` 是"大小"，可能正好是 `2^63` ⇒ `i64(0) - v` 溢出。先减一落回可表示范围，
     * 再取负减一（对 1 也成立：`0 - 0 - 1 = -1`）。 */
    if neg { return success(i64(0) - (v - i64(1)) - i64(1)) }
    return success(v)
}

struct reader {
    fd:    i32
    chunk: mut slice<u8>
    len:   i64              /* valid bytes in chunk */
    pos:   i64              /* how far the reader has consumed */

    /* Bytes not consumed yet. */
    fn avail(self: ref reader) -> i64 { return self.len - self.pos }

    /* Are bytes still buffered? (Does not touch the fd.) */
    fn buffered(self: ref reader) -> bool { return self.pos < self.len }

    /* Refill: one `read(2)` fills a whole block. Returns the bytes read, **0 =
     * EOF**.
     * NOTE: this enters the kernel once to get a whole block rather than once
     * per byte, which is where the speed comes from. */
    fn fill(self: mut ref reader) -> result<i64, ioError> {
        let n = sysio::read(self.fd, self.chunk.data, self.chunk.len)
        if n < i64(0) { return failure(ioError.readFailed(self.fd)) }
        self.len = n
        self.pos = 0
        return success(n)
    }

    /* The next byte. A return value **< 0 means EOF**, which is not an error:
     * errors take the `failure` path. */
    fn nextByte(self: mut ref reader) -> result<i64, ioError> {
        if self.pos >= self.len {
            let n = self.fill()?
            if n == i64(0) { return success(i64(-1)) }
        }
        let b = i64(self.chunk[self.pos])
        self.pos = self.pos + 1
        return success(b)
    }

    /* Is the input finished? The buffered bytes are drained before the fd is
     * consulted, so the answer is always exact.
     * NOTE: the only valid test is "the fd really has no more data"; looking at
     * `avail() == 0` alone is not enough, because an empty buffer does not mean
     * the file ended -- which is half of why the old `readLine` turned one
     * over-long line into two. */
    fn eof(self: mut ref reader) -> result<bool, ioError> {
        if self.pos < self.len { return success(false) }
        if self.chunk.len == i64(0) { return success(true) }
        let n = self.fill()?
        return success(n == i64(0))
    }

    /* ---------------------------------------------------------------- lines */

    /* Read one line into `out` and return its length, **without** its line ending.
     * **0 = EOF at the very first byte.**
     *
     * "Line ending" here means `\n` **or `\r\n`**: a trailing carriage return is
     * dropped too. That is what every line-reading API in wide use does, and it is what
     * a name like `nextLine` is read as:
     *   - Go `bufio.Scanner` + `ScanLines`: "stripped of any trailing end-of-line
     *     marker" (`dropCR` in its source; it also drops a `\r` at EOF);
     *   - Rust `str::lines()` / `BufRead::lines()`: "split at line endings that are
     *     either newlines (`\n`) or sequences of a carriage return followed by a line
     *     feed (`\r\n`)";
     *   - Java `BufferedReader.readLine` and C# `StreamReader.ReadLine`: a line ends at
     *     `\n`, `\r`, or `\r\n`;
     *   - Ruby `String#chomp`: removes all three.
     * Python and Perl solve the same problem on the other side of the call, by
     * translating `\r\n` to `\n` while reading (PEP 278 universal newlines, the
     * `:crlf` PerlIO layer); nothing is translated here, the byte is simply dropped.
     *
     * This used to keep the `\r`, so every reader of a CRLF file -- a file edited on
     * Windows, which is the normal case under WSL -- saw a stray byte at the end of
     * every line and a length one too high. Use `nextLineRaw` for the exact bytes.
     *
     * NOTE: a **lone** `\r` is not a line ending; every `\r` here is followed by a
     * `\n` or is the last byte of the file. A file whose lines end with `\r` alone
     * (classic MacOS) is therefore one long line, which is the Go and Rust behaviour as
     * well -- and it leaves `\r` available as content.
     *
     * NOTE: a line longer than `out` gives `failure(lineTooLong)` -- never the old
     * **silent half line**, which made a caller treat one line as two. */
    fn nextLine(self: mut ref reader, out: mut slice<u8>) -> result<i64, ioError> {
        var n = self.nextLineRaw(out)?
        /* The `\r` of a CRLF is in `out` already: `nextLineRaw` copies everything up to
         * the `\n`, so the byte before the end is where it would be. */
        if n > i64(0) && out[n - i64(1)] == u8(13) { n = n - i64(1) }
        return success(n)
    }

    /* Read one line into `out` **exactly as it is on disk**, carriage return included.
     *
     * This is the raw half of the pair; `nextLine` is the one to reach for normally, and
     * the pair follows what the ecosystems converged on -- a name for each semantics
     * rather than one name with two meanings (Go: `ReadString` vs `Scanner`; Rust:
     * `read_line` vs `lines`; Ruby: `gets` vs `chomp`).
     *
     * It exists for the cases where a `\r` is content: a progress bar drawn with
     * `\r`, a protocol that uses it, or a tool that must not change a single byte.
     *
     * NOTE: this loop is written out by hand for the same reason as `nextInt`:
     * `nextByte` returns a `result` struct, so GCC refuses to inline it, and
     * every byte read then costs a method call. Here a byte that is already in
     * the buffer costs an index and an increment, and only an exhausted buffer
     * calls `fill` (once per 64KB). The semantics match the byte-at-a-time
     * version character for character: EOF ends the line (a final line with no
     * newline still counts), the newline is **not** copied into `out`, and an
     * over-long line fails immediately (a half-read line never counts as
     * success). */
    fn nextLineRaw(self: mut ref reader, out: mut slice<u8>) -> result<i64, ioError> {
        var n: i64 = 0
        while true {
            if self.pos >= self.len {
                let got = self.fill()?
                if got == i64(0) { return success(n) }       /* EOF: last line, newline or not */
            }
            while self.pos < self.len {
                let b = i64(self.chunk[self.pos])
                self.pos = self.pos + i64(1)
                if b == i64(10) { return success(n) }        /* '\n' -> end of line */
                if n >= out.len { return failure(ioError.lineTooLong(n + i64(1))) }
                out[n] = u8(b)
                n = n + 1
            }
        }
        return success(n)
    }

    /* ---------------------------------------------------------------- whitespace and words */

    /* Skip whitespace (space, tab, CR, LF, VT, FF); returns how many bytes were
     * skipped.
     * NOTE: hand-written loop, as in `nextInt`: a non-whitespace byte is **not**
     * consumed. The old version read the byte and then decremented `pos` to put
     * it back; here the position simply does not advance, which is the same
     * thing in one step less. */
    fn skipSpace(self: mut ref reader) -> result<i64, ioError> {
        var n: i64 = 0
        while true {
            if self.pos >= self.len {
                let got = self.fill()?
                if got == i64(0) { return success(n) }
            }
            while self.pos < self.len {
                if !isSpaceByte(i64(self.chunk[self.pos])) { return success(n) }
                self.pos = self.pos + i64(1)
                n = n + 1
            }
        }
        return success(n)
    }

    /* Read one word (**a run of non-whitespace**) into `out`; returns its
     * length, 0 = EOF came first.
     * Leading whitespace is skipped, so calls can be chained back to back.
     * NOTE: hand-written loop, as in `nextInt`: the leading whitespace is eaten
     * in this loop instead of by calling `skipSpace`, and the whitespace that
     * ends the word is **not** consumed (the old version pushed it back with
     * `pos - 1`). */
    fn nextToken(self: mut ref reader, out: mut slice<u8>) -> result<i64, ioError> {
        var n: i64 = 0
        var started: bool = false
        while true {
            if self.pos >= self.len {
                let got = self.fill()?
                if got == i64(0) { return success(n) }
            }
            while self.pos < self.len {
                let b = i64(self.chunk[self.pos])
                if !started {
                    if isSpaceByte(b) { self.pos = self.pos + i64(1)  continue }
                    started = true
                }
                if isSpaceByte(b) { return success(n) }          /* word ends: space unconsumed */
                if n >= out.len { return failure(ioError.lineTooLong(n + i64(1))) }
                out[n] = u8(b)
                n = n + 1
                self.pos = self.pos + i64(1)
            }
        }
        return success(n)
    }

    /* ---------------------------------------------------------------- integers */

    /* Read one integer, the type-driven shape of `docs/topics/IO.md` section 4.4.
     *   - leading whitespace is skipped, so back-to-back calls read the stream
     *     of numbers that contest input consists of
     *   - `-` is accepted; `+` is **not**, because contest data does not use it
     *     and accepting it would only hide corrupt input
     *   - a non-digit ends the number and is pushed back, so reading `12,34`
     *     twice gives 12 and then 34
     * NOTE: **overflow is checked explicitly** -- signed overflow on `i64` is
     * undefined behaviour, so it is rejected here rather than left unguarded.
     * The rejection is reported as `lineTooLong`: reusing an error kind is the
     * lesser evil when there are too few kinds, but **silent truncation** is not
     * an option, because a truncated number computes a wrong answer and still
     * exits normally. */
    fn nextInt(self: mut ref reader) -> result<i64, ioError> {
        /* 一份实现：解析在 `nextI64State`（显式状态版 ✓），这里只是把 reader 的字段递过去 ✓ */
        var g: bool = false
        return nextI64State(self.fd, self.chunk, ref self.len, ref self.pos, ref g)
    }

    /* Is this byte a newline that should be eaten (LF, or CR followed by LF)?
     * Character for character the same as the byte-at-a-time version: only a
     * newline is eaten, every other whitespace byte is pushed back. */
    fn newlineAfter(self: mut ref reader, b: i64) -> bool {
        if b == i64(10) { return true }
        if b == i64(13) {
            if self.pos < self.len {
                if i64(self.chunk[self.pos]) == i64(10) { self.pos = self.pos + i64(1) }
            }
            return true
        }
        return false
    }
}

/* Build a reader: an `fd` plus an **implicit 64KB buffer**.
 * The 64KB comes from this function's `new`, so it lands in the arena of the
 * **call site** (the allocation is owned by the caller's frame), which gives it
 * the same lifetime as the `reader` itself: the caller manages nothing.
 * NOTE: the buffer therefore lives exactly as long as the block the `reader`
 * lives in, and passing the `reader` out of that block is caught by the escape
 * checker. */
fn readerOf(fd: i32) -> reader {
    var c: mut slice<u8> = new u8[BLK]
    return { fd: fd, chunk: c, len: 0, pos: 0 }
}

/* ================================================================ helpers */

/* Is this a whitespace byte? The set is **lexical**, not the locale-dependent
 * one `isspace` uses. */
/* ⚠️ 它在**解析热循环里逐字节**被调用 ⇒ 必须内联（不标就是一次函数调用 ✗
 * 实测：20M 个数 × 2~3 次 = 上千万次调用，正是输入那条路剩下的主要成本 ✓）*/
@inline
fn isSpaceByte(b: i64) -> bool {
    if b == i64(32) { return true }      /* space */
    if b == i64(9)  { return true }      /* \t    */
    if b == i64(10) { return true }      /* \n    */
    if b == i64(13) { return true }      /* \r    */
    if b == i64(11) { return true }      /* \v    */
    if b == i64(12) { return true }      /* \f    */
    return false
}

/* ================================================================ console streams
 *
 * `cout << x` / `cin >> x`: what `print` and `nextInt` do, in a shape that **chains**,
 * which is the whole reason the operators are there.
 *
 * Why not variadic: `print(a, b, c)` takes an unbounded argument list, and extC has
 * neither variadics nor an overload set wide enough to express one. `<<` looks at **one**
 * operand at a time, so it needs neither -- one overload per type is all it takes, which
 * is what overloading by the right operand's exact type buys (docs/DECISIONS.md 82).
 *
 * The shape of a stream handle:
 *   - It carries an `fd` and nothing else, so an `<<` can return a **new** handle
 *     (`{ fd: self.fd }`) instead of `self`: in `-> out` the `self` is a reference, and a
 *     reference is not a value, so it cannot be returned by value. A handle this thin
 *     makes the copy harmless, and `cout << a << b` chains because every step hands the
 *     next one an equivalent handle.
 *   - Buffering is C's stdio (`flush()` is `fflush(NULL)`), so what is buffered leaves at
 *     exit by itself and keeps its order with `println`. A buffer of our own would need
 *     "flush before the program ends" to be remembered -- the classic way output goes
 *     missing.
 *
 * NOTE: what `<<` writes today is the console, formatted by the same builtin printing
 * `println` uses, so the two agree character for character. A formatting layer of our own
 * is the next step, and it is also what the builtins' retirement waits for; the `fd` is
 * already in the handle so that a stream over any fd can be spelled then.
 *
 * NOTE: the `fd` is written as a bare `1` rather than as `STDOUT_FD`, because a global's
 * initializer cannot name **another global**: C does not treat `const int` as a constant
 * expression, so a static initializer may not refer to it (`pt { x: BOARD_SIZE }` is
 * refused for the same reason). `1` is what `STDOUT_FD` holds.
 */
struct ostream { fd: i32
    /* 全都走**同一个缓冲**（`extc_cout_put` 是 `static inline` ⇒ 没有调用开销 ✓）
     * 不再借内建 `print`：那是一条操作数一次 `printf`，实测比这条路慢 **11 倍** ✗ */
    @inline
    /* 打印 `i64` 的最小值曾经会 trap（2026-09-28 修）：`fmtI64Fast` 里的 `i64(0) - v` 在
     * `2^63` 上溢出，而带检查的算术当场抓住它（换 C 会安静地打出错的数）。现在那个函数从
     * **负数一侧**取位，永不取绝对值 —— 与 `stl::string::fromI64` 同一招。 */
    fn <<(self: ref ostream, v: i64) -> ostream {
        pairsReady()
        let st = fmtI64Fast(v)
        let n = i64(24) - st
        extc_cout_put(FMT[st..i64(24)].data, n)
        return { fd: self.fd }
    }
    @inline
    /* `i32`：没有隐式转换，所以 `io::cout << 7` 这种字面量必须有自己的重载
     * （从前它报 "does not define `<<`" —— 数字字面量默认是 i32）。 */
    fn <<(self: ref ostream, v: i32) -> ostream {
      return self << i64(v)
    }
    fn <<(self: ref ostream, v: f64) -> ostream {
        /* 走**同一个缓冲**，和 i64 那条路一样：格式化由运行期的 `extc_cout_f64` 做
         * （两行 `snprintf("%g")`，与内建 `print` 同一个格式 ⇒ 输出逐字节不变 ✓）。
         * 以前这里借内建 `print`（它写 stdio ✗），得先 `flushCout()` 才不会两边打架 ——
         * 现在只有一个缓冲，那个顺序陷阱连同这次搬家一起没了 ✓ */
        extc_cout_f64(v)
        return { fd: self.fd }
    }
    @inline
    fn <<(self: ref ostream, v: bool) -> ostream {
        if v { extc_cout_put("true".data, i64(4)) } else { extc_cout_put("false".data, i64(5)) }
        return { fd: self.fd }
    }
    @inline
    fn <<(self: ref ostream, v: slice<u8>) -> ostream {
        if v.len > i64(0) { extc_cout_put(v.data, v.len) }
        return { fd: self.fd }
    }
    /* 同 `fs::outStream`：可变视图与只读视图是两种类型 ⇒ 两份 ✓ */
    @inline
    fn <<(self: ref ostream, v: mut slice<u8>) -> ostream {
        if v.len > i64(0) { extc_cout_put(v.data, v.len) }
        return { fd: self.fd }
    }
}

let cout: ostream = ostream { fd: 1 }

/* A newline as a value: `cout << x << endl`. A string literal does the same
 * (`cout << x << "\n"`); this name reads better at the end of a chain and cannot be
 * mistyped as an escape. */
let endl: slice<u8> = "\n"

/* ================================================================ console input
 *
 * The input side cannot be a thin handle: a token may end in the middle of a block that
 * was read, so the reader's position has to outlive one `>>`. It lives in the globals
 * below, and `in` itself stays as thin as `out` so that chaining works -- `cin >> x >> y`
 * hands an equivalent handle to the second `>>`, and both steps touch the same buffer.
 *
 * NOTE: the buffer is a **fixed-size global array**, not `new u8[BLK]`. A global is
 * initialized at compile time, and a `mut slice<u8>` contains a reference, so no global
 * of that type can exist at all ("nothing to borrow from"). An array has no reference in
 * it, and `IN_BUF[..]` produces the view when the reader is built.
 *
 * NOTE: the length is written out as `65536` rather than as `BLK`, because a fixed
 * array's length must be an **integer literal** (a compile-time constant declaration
 * would be needed to name it, and there is no `const` yet). `BLK` is 65536.
 */
var IN_BUF: [65536]u8
var IN_LEN: i64 = 0
var IN_POS: i64 = 0
var IN_BAD: bool = false

/* The reader over the console buffer, carrying the state in and back out. Saving it
 * after every operation is what lets a local `reader` be enough -- the parsing itself is
 * `reader`'s, not a second copy of it. */
fn inSync() -> reader { return { fd: 0, chunk: IN_BUF[..], len: IN_LEN, pos: IN_POS } }
fn inSave(r: ref reader) { IN_LEN = r.len  IN_POS = r.pos }

struct istream { fd: i32
    /* 热路径：**每个数只调一次 `nextInt`** ✓（旧版还先 `skipSpace` 再 `eof` ⇒ 三次调用 ✗）
     * `0` 与"啥也没读到"在 `nextInt` 的返回里**同形**（EOF 用 `success(0)` 说 ✓）⇒
     * **只有结果为 0 时**才回头看 `eof()` 把歧义消掉 ✓ 常见数据里永远不走那一支 ✓ */
    @inline
    fn >>(self: ref istream, v: mut ref i64) -> istream {
        var g: bool = false
        match nextI64State(i32(0), IN_BUF[..], ref IN_LEN, ref IN_POS, ref g) {   /* 0 = stdin ✓ */
            success(n) => { if g { *v = n } else { IN_BAD = true } }
            failure(e) => { IN_BAD = true }
        }
        return { fd: self.fd }
    }

    /* 一行 / 一个字节不跳空白（空行与那个 `\n` 都是真内容 ✓）⇒ 仍要先问 `eof` ✓ */
    @inline
    fn >>(self: ref istream, v: mut slice<u8>) -> istream {
        var r: reader = inSync()
        match r.eof() {
            success(atEnd) => {
                if atEnd { IN_BAD = true }
                else {
                    match r.nextLine(v) {
                        success(n) => { }
                        failure(e) => { IN_BAD = true }
                    }
                }
            }
            failure(e) => { IN_BAD = true }
        }
        inSave(ref r)
        return { fd: self.fd }
    }

    @inline
    fn >>(self: ref istream, v: mut ref u8) -> istream {
        var r: reader = inSync()
        match r.eof() {
            success(atEnd) => {
                if atEnd { IN_BAD = true }
                else {
                    match r.nextByte() {
                        success(b) => { *v = u8(b) }
                        failure(e) => { IN_BAD = true }
                    }
                }
            }
            failure(e) => { IN_BAD = true }
        }
        inSave(ref r)
        return { fd: self.fd }
    }

    fn bad(self: ref istream) -> bool { return IN_BAD }
    fn clear(self: ref istream) { IN_BAD = false }
}

/* 失败标志的**自由函数**形式：限定名的全局上调方法还不支持（PLAN #66）⇒
 * `io::cin.bad()` 今天不行，这两个能 ✓ 它们是同一个标志 ✓ */
/* 每读一行都会问一次 ⇒ 内联（不标就是每行一次函数调用 ✗）*/
@inline
fn inBad() -> bool { return IN_BAD }
@inline
fn inClear() { IN_BAD = false }

let cin: istream = istream { fd: 0 }

/* ================================================================ 格式化（一处实现）
 *
 * `i64` → 十进制，写进 `out`，返回长度 ✓ 三个流共用这一份（内建 `print` 写死 stdout，
 * 文件流/stderr 流用它不了它 ✗ 所以格式化必须在库里，而且只能一份 ✓）
 *
 * **两位一查表**（`DIGITS` 是 "00" "01" … "99" 拼起来的常量 ✓ 每次除 100 出两位 ✓）：
 * 这是 `strconv.AppendInt` 那一招 —— 除法次数减半，而除法正是这条路上最贵的一步 ✓
 */
let DIGITS: slice<u8> = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

/* ── 热路径版：**全程只碰定长数组** ──────────────────────────────────────────
 *
 * 为什么另立一份（而不是把上面那个改快）：上面那个的 `out` 是 `slice<u8>`，
 * 而**视图下标在生成的 C 里是一次函数调用**（`slice_u8_index(..., 文件, 行号)` ✗）。
 * 一行输出 4 个操作数、每个数字要十几次下标 ⇒ 上亿次调用，实测就是它把这条路拖到
 * 224 ms（同为 1000 MB/s 量级但比 C 慢一档 ✗）。定长数组的下标是**内联的小检查** ✓
 * ⇒ 热路径写进一个**全局定长数组**（单线程，够用 ✓ 可重入性写在下面 ⚠️）。
 *
 * ⚠️ 因此 `FMT` 是"刚刚格式化好的那个数"的暂存处 ⇒ **别在格式化与取用之间再格式化** ✓
 *    （`<<` 里是连续的"格式化 + 立刻取出"，所以安全 ✓）
 */
var FMT: [24]u8
var PAIRS: [200]u8
var PAIRS_READY: bool = false

@inline
fn pairsReady() {
    if PAIRS_READY { return }
    var d: i64 = 0
    var i: i64 = 0
    while i < i64(200) {
        PAIRS[i] = DIGITS[i]
        i = i + 1
    }
    PAIRS_READY = true
}

/* 把 `v` 写进 `FMT` 的**尾部往前**，返回**起点**（长度 = 24 - 起点 ✓）
 *
 * ⚠️ 必须**从后往前**填：两位一组的表给的是"高位在前"的一对，若按低位在前追加、
 * 最后整体反转，**对内的顺序也会被翻** ⇒ `40` 会印成 `04` ✗（这个 bug 真发生过）。
 * 从后往前填出来就是正序，**不需要反转** ✓ 这也是 `strconv.AppendInt` 的做法 ✓ */
@inline
fn fmtI64Fast(v: i64) -> i64 {
    var end: i64 = i64(24)
    var neg: bool = v < i64(0)
    /* 取位**从负数一侧**做，绝不先取绝对值：`i64(0) - v` 在 `v` 是 `i64` 最小值时溢出
     * （实测：打印它会 `trap: value does not fit in the target type` —— 因为带检查的算术把它
     * 抓住了；换成 C 会安静地打出错的数）。负数取余 `v % 100 ∈ (-100, 0]` ⇒ `0 - (v % 100)`
     * 永远落在 `[0, 100)`，安全；`v / 100` 向零截断，循环照旧收敛。 */
    while v >= i64(100) || v <= i64(-100) {
        var m: i64 = v % i64(100)
        if m < i64(0) { m = i64(0) - m }    /* m ∈ (-100, 100) ⇒ 这一步永远安全 */
        v = v / i64(100)                    /* 向零截断 ⇒ 循环收敛，符号不影响 */
        end = end - i64(2)
        FMT[end]     = PAIRS[m * i64(2)]
        FMT[end + 1] = PAIRS[m * i64(2) + i64(1)]
    }
    var r: i64 = v
    if r < i64(0) { r = i64(0) - r }        /* |v| < 100 ⇒ 安全；`2^63` 那种大小从不出现 */
    if r >= i64(10) {
        end = end - i64(2)
        FMT[end]     = PAIRS[r * i64(2)]
        FMT[end + 1] = PAIRS[r * i64(2) + i64(1)]
    } else {
        end = end - i64(1)
        FMT[end] = u8(48 + r)
    }
    if neg {
        end = end - i64(1)
        FMT[end] = u8(45)
    }
    return end
}

@inline
fn fmtI64(v: i64, out: mut slice<u8>) -> i64 {
    if v == i64(0) { out[0] = u8(48)  return i64(1) }
    var u: i64 = v
    var neg: bool = v < i64(0)
    if neg { u = i64(0) - u }
    var tmp: [24]u8
    var n: i64 = 0
    while u >= i64(100) {
        let r = u % i64(100)
        u = u / i64(100)
        tmp[n]     = DIGITS[r * i64(2)]
        tmp[n + 1] = DIGITS[r * i64(2) + i64(1)]
        n = n + 2
    }
    if u >= i64(10) {
        tmp[n]     = DIGITS[u * i64(2)]
        tmp[n + 1] = DIGITS[u * i64(2) + i64(1)]
        n = n + 2
    } else if u > i64(0) {
        tmp[n] = u8(48 + u)
        n = n + 1
    }
    if neg { tmp[n] = u8(45)  n = n + 1 }
    var k: i64 = 0
    while k < n && k < out.len {
        out[k] = tmp[n - i64(1) - k]
        k = k + 1
    }
    return k
}

/* 控制台输出：**先塞进运行期的缓冲**，满了它自己写出去；尾巴由 `main` 返回前冲刷 ✓
 * （`println` 已弃置 ⇒ 不再有"与 stdio 抢顺序"的问题 ✓ 只剩"退出前别丢"一条 ✓）*/
fn flushCout() { extc_cout_flush() }

/* ================================================================ stderr 流
 *
 * `cerr << ...` —— 诊断走 stderr，而 `print`/`println` 走 **stdout** ✓
 * （量过：`println` 的输出在 `>/dev/null` 时消失、在 `2>/dev/null` 时还在 ✓）
 * 这个区分是必要的：`prog > out.txt` 要能拿到**程序的正常输出**，而错误/日志不该混进去 ✓
 *
 * 与 `cout` 同一形状（薄句柄、`<<` 按值返回）⇒ 拷贝无害、链式成立 ✓
 * ⚠️ 每次写之前先 `flush()`：stdout 是带缓冲的，不冲就会**插队**（顺序错乱是这类程序
 *    最难查的毛病 ✓ 与 `io::writer` 对 STDOUT/STDERR 的处理同一条规矩 ✓）
 */
struct errStream {
    fn <<(self: ref errStream, v: slice<u8>) -> errStream { errWrite(v)  return { } }
    fn <<(self: ref errStream, v: mut slice<u8>) -> errStream { errWrite(v)  return { } }
    fn <<(self: ref errStream, v: i64) -> errStream {
        pairsReady()
        let st = fmtI64Fast(v)
        errWrite(FMT[st..i64(24)])
        return { }
    }
    fn <<(self: ref errStream, v: bool) -> errStream {
        if v { errWrite("true") } else { errWrite("false") }
        return { }
    }
}

let cerr: errStream = errStream { }

fn errWrite(s: slice<u8>) {
    if s.len == i64(0) { return }
    flushCout()                                /* 先放 stdout 缓冲，见上面的 ⚠️ */
    flush()
    /* 返回值丢弃：stderr 写失败也没有别的地方可报（这正是"诊断通道"的处境 ✓）*/
    sysio::write(i32(2), s.data, s.len)
}
