/* std/io.extc -- a plain library, written in extC, with no privileged access.
 *
 * This is the thin wrapper over the bare primitives that `docs/topics/IO.md`
 * describes, turning them into shapes that are pleasant to use: `slice<u8>` is
 * two arguments on the C side, so `s.data` and `s.len` are passed down
 * separately here.
 *
 * ================================================================ two input styles
 *
 * Everyone needs "read a line" and "read an integer", but the two use cases do
 * not want the same shape, so both live here:
 *
 *   | style | use | why |
 *   |---|---|---|
 *   | **contest**: space separated numbers | `nextInt` / `nextToken` | no line to split first |
 *   | **protocol**: one command per line | `nextLine` | the line is the unit of the protocol |
 *
 * Both are built on the same `reader`, so they can be mixed: `nextInt` skips
 * leading whitespace, which consumes the end of the line as well.
 *
 * ================================================================ why `reader` exists
 *
 * NOTE: **reading a byte at a time is a trap** (the old `readLine` did exactly
 * that). Measured on 19MB / 500,000 lines it took **2.30 s**, against
 * **0.012 s** for block reads, a factor of **190x**. The reason is not that
 * reading is slow: it is that **every single byte enters the kernel**.
 *
 * So `reader` is where the work happens. One `read(2)` brings back 64KB, and the
 * splitting then happens in memory. That is the sentence from
 * `docs/topics/IO.md` section 0: **reading = read whole blocks + split in memory**.
 *
 * The buffer is **not** supplied by the caller (`readerOf(fd)` is enough): that
 * 64KB comes from `new`, so it lives in the arena of the block that contains the
 * call site, and it has the same lifetime as the `reader` itself.
 * (The cost: a `reader` may not outlive the block that created it. The escape
 * checker enforces this, so going past that block is a **compile error**, not a
 * dangling pointer.)
 *
 * ================================================================ three failures, kept apart
 *
 * Three failures with three different causes should not be squeezed into one
 * return value: what the compiler cannot prove must stay visible in the syntax.
 *
 *   | case | return |
 *   |---|---|
 *   | **hit EOF** | `success(0)` -- not an error |
 *   | **line longer than `out`** | `failure(lineTooLong)` -- data not read in full |
 *   | **`read(2)` failed** | `failure(readFailed)` -- the previous read may be bad |
 *
 * The old `readLine` treated the last two **both as EOF**
 * (`if got <= 0 { return n }`), so a read error looked like "the file ended",
 * and an over-long line was **silently split into two "lines"**. Data corruption
 * that cannot be seen is exactly what these three results are there to prevent.
 */
use std::sys::io

/* A read failed, and **why** it failed: an enum, not a magic value.
 * NOTE: the payload is what lets an error message say how many bytes were read
 * (`lineTooLong(i64)`) or which fd failed (`readFailed(i32)`); a message like
 * `failed(5)` tells the user nothing. */
type ioError = | readFailed(i32) | lineTooLong(i64) | writeFailed(i32)

/* Block size: **64KB**, one of the sizes that measured fastest.
 * Measured on a 291MB file: 64B 0.62s/469MB/s (4.7 million syscalls) - 4KB
 * 0.05s/5820MB/s - **16KB and 64KB both 0.04s/7275MB/s** - 1MB 0.05s.
 * -> everything from 16KB up is flat, so 64KB it is, which also saves syscalls
 *    in protocol code that reads a few lines at a time.
 * -> this is why the 4KB in `docs/topics/IO.md` section 9 became 64KB. */
let BLK: i64 = 65536

/* The largest `i64`, used by the overflow check in `nextInt`.
 * NOTE: it is written out by hand because there is **no built-in** for it;
 * `9223372036854775807` = 2^63 - 1. */
let I64_MAX: i64 = 9223372036854775807

/* The fds for standard input and output. `std::sys::io` declares them too; they
 * are exported again here so that **`use std::io` alone is enough** for a user. */
let STDIN_FD: i32  = 0
let STDOUT_FD: i32 = 1

/* Flush the `println` side. This is **required** when mixing it with the direct
 * fd writes below, or the output comes out in the wrong order -- the most
 * annoying failure in an interactive program. */
fn flushOut() { flush() }

/* Write a whole block of bytes to **stdout** (`println` prints values, this
 * writes bytes).
 *
 * **`flush()` must come first.** This is the fix for a real defect: `println`
 * goes through C `printf` (**buffered**), while this is a **direct** `write(2)`.
 * Mixing the two streams puts the bytes in the wrong order, so a prompt is still
 * sitting in the printf buffer while the bytes written here have already
 * arrived.
 * (The old contract was that the caller had to remember `flushOut()`, which is
 * the most annoying thing to get wrong in an interactive program.)
 * `flush()` is a compiler built-in and flushes exactly the stdio side, so one
 * line covers it.
 *
 * NOTE: the thorough fix would be to make `println` write into the same
 * `writer`, but that means changing codegen and was not done here. What is here
 * turns a mistake you cannot see into a mistake you cannot make. */
fn writeBytes(buf: slice<u8>) -> i64 {
    flush()
    return io::write(io::STDOUT, buf.data, buf.len)
}

/* ================================================================ writer */

/* A buffered writer, symmetric with `reader`:
 * one `write(2)` emits a whole block instead of entering the kernel once per
 * piece of text.
 *
 * The buffer has to be a **visible field** (`buf` / `len` / `cap`), which is the
 * point `docs/topics/IO.md` keeps making about the `cin` black box: `FILE*` hides
 * its buffer inside, so you cannot see it when something goes wrong. Here you can
 * read `w.len` whenever you like, flush on your own, and decide when bytes leave.
 *
 * NOTE: when the fd is STDOUT, the `println` side must be flushed **before every
 * flush**, or the two streams interleave out of order again (the same trap as
 * `writeBytes` above). */
struct writer {
    fd:  i32
    buf: mut slice<u8>
    len: i64

    fn cap(self: ref writer) -> i64 { return self.buf.len }

    /* Emit what is buffered, including the `println` side, which is what keeps
     * the order right. Returns the number of bytes written (0 = it was empty). */
    fn flush(self: mut ref writer) -> result<i64, ioError> {
        if self.fd == io::STDOUT || self.fd == io::STDERR { flush() }
        if self.len == i64(0) { return success(i64(0)) }
        let n = io::write(self.fd, self.buf.data, self.len)
        if n < i64(0) { return failure(ioError.writeFailed(self.fd)) }
        self.len = 0
        return success(n)
    }

    /* Write a run of bytes. If it does not fit, flush first: bytes are never
     * dropped and the buffer never grows. */
    fn write(self: mut ref writer, data: slice<u8>) -> result<i64, ioError> {
        var done: i64 = 0
        while done < data.len {
            if self.len >= self.buf.len { self.flush()? }
            /* Copy as much as fits. */
            var room: i64 = self.buf.len - self.len
            var left: i64 = data.len - done
            if left < room { room = left }
            var k: i64 = 0
            while k < room {
                self.buf[self.len + k] = data[done + k]
                k = k + 1
            }
            self.len = self.len + room
            done = done + room
        }
        return success(done)
    }
}

/* Build a writer: an `fd` plus an **implicit 64KB buffer**, symmetric with
 * `readerOf`. The 64KB comes from `new`, so it lands in the arena of the **call
 * site** and has the same lifetime as the writer itself. */
fn writerOf(fd: i32) -> writer {
    var b: mut slice<u8> = new u8[BLK]
    return { fd: fd, buf: b, len: 0 }
}

/* One read from an fd; returns the number of bytes read (0 = EOF, negative =
 * error).
 * NOTE: this is the bare primitive layer, so the caller inspects the return
 * value; use `reader` for a shape that is easier to use. */
fn readSome(fd: i32, buf: mut slice<u8>) -> i64 {
    return io::read(fd, buf.data, buf.len)
}

/* ================================================================ reader */

struct reader {
    fd:    i32
    chunk: mut slice<u8>
    len:   i64              /* valid bytes in chunk */
    pos:   i64              /* how far the reader has consumed */

    /* Bytes not consumed yet. */
    fn avail(self: ref reader) -> i64 { return self.len - self.pos }

    /* Are bytes still buffered? (Does not touch the fd.) */
    fn buffered(self: ref reader) -> bool { return self.pos < self.len }

    /* Refill: one `read(2)` fills a whole block. Returns the bytes read, **0 =
     * EOF**.
     * NOTE: this enters the kernel once to get a whole block rather than once
     * per byte, which is where the speed comes from. */
    fn fill(self: mut ref reader) -> result<i64, ioError> {
        let n = io::read(self.fd, self.chunk.data, self.chunk.len)
        if n < i64(0) { return failure(ioError.readFailed(self.fd)) }
        self.len = n
        self.pos = 0
        return success(n)
    }

    /* The next byte. A return value **< 0 means EOF**, which is not an error:
     * errors take the `failure` path. */
    fn nextByte(self: mut ref reader) -> result<i64, ioError> {
        if self.pos >= self.len {
            let n = self.fill()?
            if n == i64(0) { return success(i64(-1)) }
        }
        let b = i64(self.chunk[self.pos])
        self.pos = self.pos + 1
        return success(b)
    }

    /* Is the input finished? The buffered bytes are drained before the fd is
     * consulted, so the answer is always exact.
     * NOTE: the only valid test is "the fd really has no more data"; looking at
     * `avail() == 0` alone is not enough, because an empty buffer does not mean
     * the file ended -- which is half of why the old `readLine` turned one
     * over-long line into two. */
    fn eof(self: mut ref reader) -> result<bool, ioError> {
        if self.pos < self.len { return success(false) }
        if self.chunk.len == i64(0) { return success(true) }
        let n = self.fill()?
        return success(n == i64(0))
    }

    /* ---------------------------------------------------------------- lines */

    /* Read one line into `out`; the newline is **not** included.
     * Returns the number of bytes read; **0 = EOF at the very first byte**.
     * NOTE: a line longer than `out` gives `failure(lineTooLong)` -- never the
     * old **silent half line**, which made a caller treat one line as two.
     *
     * NOTE: this loop is written out by hand for the same reason as `nextInt`:
     * `nextByte` returns a `result` struct, so GCC refuses to inline it, and
     * every byte read then costs a method call. Here a byte that is already in
     * the buffer costs an index and an increment, and only an exhausted buffer
     * calls `fill` (once per 64KB). The semantics match the byte-at-a-time
     * version character for character: EOF ends the line (a final line with no
     * newline still counts), the newline is **not** copied into `out`, and an
     * over-long line fails immediately (a half-read line never counts as
     * success). */
    fn nextLine(self: mut ref reader, out: mut slice<u8>) -> result<i64, ioError> {
        var n: i64 = 0
        while true {
            if self.pos >= self.len {
                let got = self.fill()?
                if got == i64(0) { return success(n) }       /* EOF: last line, newline or not */
            }
            while self.pos < self.len {
                let b = i64(self.chunk[self.pos])
                self.pos = self.pos + i64(1)
                if b == i64(10) { return success(n) }        /* '\n' -> end of line */
                if n >= out.len { return failure(ioError.lineTooLong(n + i64(1))) }
                out[n] = u8(b)
                n = n + 1
            }
        }
        return success(n)
    }

    /* ---------------------------------------------------------------- whitespace and words */

    /* Skip whitespace (space, tab, CR, LF, VT, FF); returns how many bytes were
     * skipped.
     * NOTE: hand-written loop, as in `nextInt`: a non-whitespace byte is **not**
     * consumed. The old version read the byte and then decremented `pos` to put
     * it back; here the position simply does not advance, which is the same
     * thing in one step less. */
    fn skipSpace(self: mut ref reader) -> result<i64, ioError> {
        var n: i64 = 0
        while true {
            if self.pos >= self.len {
                let got = self.fill()?
                if got == i64(0) { return success(n) }
            }
            while self.pos < self.len {
                if !isSpaceByte(i64(self.chunk[self.pos])) { return success(n) }
                self.pos = self.pos + i64(1)
                n = n + 1
            }
        }
        return success(n)
    }

    /* Read one word (**a run of non-whitespace**) into `out`; returns its
     * length, 0 = EOF came first.
     * Leading whitespace is skipped, so calls can be chained back to back.
     * NOTE: hand-written loop, as in `nextInt`: the leading whitespace is eaten
     * in this loop instead of by calling `skipSpace`, and the whitespace that
     * ends the word is **not** consumed (the old version pushed it back with
     * `pos - 1`). */
    fn nextToken(self: mut ref reader, out: mut slice<u8>) -> result<i64, ioError> {
        var n: i64 = 0
        var started: bool = false
        while true {
            if self.pos >= self.len {
                let got = self.fill()?
                if got == i64(0) { return success(n) }
            }
            while self.pos < self.len {
                let b = i64(self.chunk[self.pos])
                if !started {
                    if isSpaceByte(b) { self.pos = self.pos + i64(1)  continue }
                    started = true
                }
                if isSpaceByte(b) { return success(n) }          /* word ends: space unconsumed */
                if n >= out.len { return failure(ioError.lineTooLong(n + i64(1))) }
                out[n] = u8(b)
                n = n + 1
                self.pos = self.pos + i64(1)
            }
        }
        return success(n)
    }

    /* ---------------------------------------------------------------- integers */

    /* Read one integer, the type-driven shape of `docs/topics/IO.md` section 4.4.
     *   - leading whitespace is skipped, so back-to-back calls read the stream
     *     of numbers that contest input consists of
     *   - `-` is accepted; `+` is **not**, because contest data does not use it
     *     and accepting it would only hide corrupt input
     *   - a non-digit ends the number and is pushed back, so reading `12,34`
     *     twice gives 12 and then 34
     * NOTE: **overflow is checked explicitly** -- signed overflow on `i64` is
     * undefined behaviour, so it is rejected here rather than left unguarded.
     * The rejection is reported as `lineTooLong`: reusing an error kind is the
     * lesser evil when there are too few kinds, but **silent truncation** is not
     * an option, because a truncated number computes a wrong answer and still
     * exits normally. */
    fn nextInt(self: mut ref reader) -> result<i64, ioError> {
        /* The byte-at-a-time version is `skipSpace` plus `nextByte`, both of them
         * method calls, and one number goes through several bytes: together those
         * two functions measured **51%** of all instructions (callgrind:
         * `reader_nextByte` 50.8%, `reader_nextInt` 43.9%). They are `static` in
         * the generated C, but they return a `result` struct, so GCC refuses to
         * inline them.
         *
         * So the buffered hot loop is written out here instead: while `pos < len`
         * it is just an index and an increment, with no method call at all, and
         * only an exhausted buffer calls `fill` (once per 64KB). The semantics
         * match the byte-at-a-time version character for character, including the
         * two rules for pushing back the byte after a number and for eating a
         * newline or CRLF.
         *
         * `nextByte` and `skipSpace` remain for callers; they are simply no
         * longer on the hot path.
         *
         * Pushing back remembers the byte in `pushed` instead of decrementing
         * `pos`: decrementing `pos` would step behind the buffer when `fill` has
         * just replaced it, which measured as `index -1 out of range`. */
        var neg: bool = false
        var v: i64 = 0
        var got: bool = false
        var seen: bool = false          /* a non-whitespace byte was seen */
        var pushed: i64 = i64(0)        /* > 0 = byte to read again; -2 = EOF to read again */
        var bad: bool = false           /* an unknown byte was seen (push it back) */
        var b: i64 = i64(0)

        while true {
            /* ---- fetch one byte (hot path: no method call) ---- */
            if pushed == i64(-2) { pushed = i64(0)  b = i64(-1) }
            else if pushed > i64(0) { b = pushed  pushed = i64(0) }
            else {
                if self.pos >= self.len {
                    let n = self.fill()?
                    if n == i64(0) { b = i64(-1) }
                    else { b = i64(self.chunk[self.pos])  self.pos = self.pos + i64(1) }
                } else {
                    b = i64(self.chunk[self.pos])
                    self.pos = self.pos + i64(1)
                }
            }

            if !seen {
                if b < i64(0) { break }                 /* EOF: no digits -> 0 */
                if !isSpaceByte(b) {
                    seen = true
                    if b == i64(45) { neg = true }
                    else { pushed = b }
                }
                continue
            }
            if bad {
                if b < i64(0) { pushed = i64(-2) }
                else { self.pos = self.pos - i64(1) }
                break
            }
            if b < i64(0) { break }                     /* EOF: the number ends here */
            if b >= i64(48) && b <= i64(57) {
                got = true
                let d = b - i64(48)
                if v > (I64_MAX - d) / i64(10) { return failure(ioError.lineTooLong(v)) }
                v = v * i64(10) + d
                continue
            }
            if !got { continue }                        /* eat a leading separator */

            /* The byte after the number: a newline (CRLF included) is eaten,
             * anything else is pushed back. */
            if b == i64(10) { break }
            if b == i64(13) {
                if self.pos < self.len {
                    if i64(self.chunk[self.pos]) == i64(10) { self.pos = self.pos + i64(1) }
                }
                break
            }
            bad = true                                  /* push it back next round */
        }

        if !got { return success(i64(0)) }
        if neg { return success(i64(0) - v) }
        return success(v)
    }

    /* Is this byte a newline that should be eaten (LF, or CR followed by LF)?
     * Character for character the same as the byte-at-a-time version: only a
     * newline is eaten, every other whitespace byte is pushed back. */
    fn newlineAfter(self: mut ref reader, b: i64) -> bool {
        if b == i64(10) { return true }
        if b == i64(13) {
            if self.pos < self.len {
                if i64(self.chunk[self.pos]) == i64(10) { self.pos = self.pos + i64(1) }
            }
            return true
        }
        return false
    }
}

/* Build a reader: an `fd` plus an **implicit 64KB buffer**.
 * The 64KB comes from this function's `new`, so it lands in the arena of the
 * **call site** (the allocation is owned by the caller's frame), which gives it
 * the same lifetime as the `reader` itself: the caller manages nothing.
 * NOTE: the buffer therefore lives exactly as long as the block the `reader`
 * lives in, and passing the `reader` out of that block is caught by the escape
 * checker. */
fn readerOf(fd: i32) -> reader {
    var c: mut slice<u8> = new u8[BLK]
    return { fd: fd, chunk: c, len: 0, pos: 0 }
}

/* ================================================================ helpers */

/* Is this a whitespace byte? The set is **lexical**, not the locale-dependent
 * one `isspace` uses. */
fn isSpaceByte(b: i64) -> bool {
    if b == i64(32) { return true }      /* space */
    if b == i64(9)  { return true }      /* \t    */
    if b == i64(10) { return true }      /* \n    */
    if b == i64(13) { return true }      /* \r    */
    if b == i64(11) { return true }      /* \v    */
    if b == i64(12) { return true }      /* \f    */
    return false
}
