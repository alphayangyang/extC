/* std/io.extc —— **普通库**（用 extC 写，没有任何特权 ✓）
 *
 * ⭐ 这就是 `docs/topics/IO.md` 说的"档 2 wrapper"：把它底下那层裸原语包成好用的形状 ✓
 *    `slice<u8>` 在 C 那边是两个参数 ⇒ 这里把 `s.data` / `s.len` 分下去 ✓
 *
 * ================================================================ 两种输入风格
 *
 * 谁都需要"读一行"/"读一个整数"，但**两种场景的形状不一样**，所以这里并存：
 *
 *   | 场景 | 用什么 | 为什么 |
 *   |---|---|---|
 *   | **OI / 竞赛**（空格分词、一坨数字） | `nextInt` / `nextToken` | 不用先读成行再切，省一次拷贝 ✓ |
 *   | **协议 / 交互**（一行一个命令） | `nextLine` | 行是协议的单位 ✓ |
 *
 * 两个都建在同一个 `reader` 上 ⇒ 可以混着用（`nextInt` 会跳过空白，正好吃掉行尾 ✓）
 *
 * ================================================================ 为什么有 `reader`
 *
 * ⚠️ **逐字节读是个坑**（原来那个 `readLine` 就是这么写的）：实测 19MB / 50 万行
 *    **2.30 s**，而按块读 **0.012 s** —— **190×** ✗
 *    原因不是"读得慢"，是**每读一个字节都进一次内核**。
 *
 * 所以真正干活的是 `reader`：它一次 `read(2)` 拿回 64KB，然后在内存里切 ✓
 * 这就是 `docs/topics/IO.md` §0 那句话：**读 = 整块读 + 内存里切**。
 *
 * ⚠️ 缓冲**不用调用者给**（`readerOf(fd)` 就够）：那 64KB 是 `new` 出来的，
 *    住在**调用点所在那个块的 arena** 里 ⇒ 跟 `reader` 自己同寿 ✓
 *    （代价：`reader` 不能比创建它的块活得久 —— 这条由逃逸检查管着，
 *      越界是**编译错误**，不是悬垂 ✓）
 *
 * ================================================================ 三条路必须分得开
 *
 * 失败的**原因**不一样，就不该挤成一个返回值（P′：不能证明的，语法上必须看得见）：
 *
 *   | 情况 | 返回 |
 *   |---|---|
 *   | **读到 EOF** | `success(0)` —— 这不是错误 ✓ |
 *   | **行比 `out` 长** | `failure(lineTooLong)` —— 数据**没读全** ✗ |
 *   | **read(2) 出错** | `failure(readFailed)` —— 上次读的结果可能已经坏了 ✗ |
 *
 * ⚠️ 原 `readLine` 把后两条**都当成 EOF**（`if got <= 0 { return n }`）⇒
 *    读错误看起来就是"文件结束了"，而超长行会被**静默切成两"行"** ✗✗
 *    这种"看不出来的数据损坏"正是 P′ 要挡的东西 ✓
 */
use std::sys::io

/* 读失败了、**为什么**失败 —— 枚举而不是魔法值 ✓
 * ⚠️ 为什么带上 `i64`：报错时要能说清"读了多少" / "是哪个 fd" ——
 *    `failed(5)` 这种消息对用户毫无用处 ✗ */
type ioError = | readFailed(i32) | lineTooLong(i64) | writeFailed(i32)

/* 块大小：**64KB**（实测量出来的最优档之一）✓
 * 实测（291MB 文件）：64B 0.62s/469MB/s（470 万次 syscall）· 4KB 0.05s/5820MB/s ·
 *   **16KB 与 64KB 都是 0.04s/7275MB/s** · 1MB 0.05s
 * ⇒ 16KB 以上就平了；取 64KB（对"一次读几行"的协议场景更省 syscall）✓
 * ⇒ `docs/topics/IO.md` §9 原来写的 4KB 因此改成 64KB ✓ */
let BLK: i64 = 65536

/* `i64` 的最大值 —— `nextInt` 的溢出检测要用 ✓
 * ⚠️ 为什么手写这个数而不是用内建：**没有内建**（实测 `grep I64_MAX` 全仓为空）✗
 *    `9223372036854775807` = 2^63 - 1 ✓ */
let I64_MAX: i64 = 9223372036854775807

/* 标准输入 / 输出的 fd ✓（`std::sys::io` 里也有，这里再导出一次是为了
 * **用户只 `use std::io` 就够** ✓）*/
let STDIN_FD: i32  = 0
let STDOUT_FD: i32 = 1

/* 把 `println` 那边的缓冲刷出去 ✓（跟下面的 fd 直写混用时**必须**刷，
 *  不然顺序会乱 —— 交互式程序最难忍那条 ✗）*/
fn flushOut() { flush() }

/* 把一整块字节写到 **stdout**（`println` 管"打印值"，这里管"写字节" ✓）
 *
 * ⚠️⚠️ **必须先 `flush()`** —— 这是一个**真缺陷的修法**（定案 75）✗
 * `println` 走 C 的 `printf`（**有缓冲**），而这里是 `write(2)` **直写** ⇒
 * 两支队混着用**顺序会乱**：提示语还没从 printf 的缓冲里出来，直写的字节已经到了 ✗✗
 * （以前靠调用者自己记得写 `flushOut()` —— 交互式程序里最难忍的就是这个 ✓）
 * `flush()` 是编译器内建，正好刷的就是 stdio 那一支 ⇒ 一行就解决 ✓
 *
 * ⚠️ 更彻底的做法是让 `println` 也写进同一支 `writer`（那要动 codegen ✗），
 *    本次没做 —— 现在这条是"看不见的错"变成"不可能错" ✓ */
fn writeBytes(buf: slice<u8>) -> i64 {
    flush()
    return io::write(io::STDOUT, buf.data, buf.len)
}

/* ================================================================ writer */

/* ⭐ **有缓冲的写**（`docs/topics/IO.md` §4.5）—— 跟 `reader` 对称：
 *   一次 `write(2)` 吐一整块，而不是每段文本进一次内核 ✓
 *
 * ⚠️ **缓冲必须是可见的字段**（`buf` / `len` / `cap`）—— 这就是 `docs/topics/IO.md` 反复讲的
 *    "不要 `cin` 那个黑盒"：`FILE*` 把缓冲藏在里面，出问题时你看不见 ✗
 *    这里你能随时看 `w.len`、能自己 `flush`、能自己决定什么时候吐 ✓
 *
 * ⚠️ 写 fd = STDOUT 时，**每次 flush 之前都要先刷 `println` 那一支** ——
 *    否则两支队又乱序了（跟上面 `writeBytes` 同一个坑 ✓）*/
struct writer {
    fd:  i32
    buf: mut slice<u8>
    len: i64

    fn cap(self: ref writer) -> i64 { return self.buf.len }

    /* 把缓冲里的吐出去（**带上 `println` 那一支**，顺序才对 ✓）
     * 返回写出去的字节数（0 = 本来就空）✓ */
    fn flush(self: mut ref writer) -> result<i64, ioError> {
        if self.fd == io::STDOUT || self.fd == io::STDERR { flush() }
        if self.len == i64(0) { return success(i64(0)) }
        let n = io::write(self.fd, self.buf.data, self.len)
        if n < i64(0) { return failure(ioError.writeFailed(self.fd)) }
        self.len = 0
        return success(n)
    }

    /* 写一段字节。**装不下就先 flush**（不是丢弃、也不是扩容 ✓） */
    fn write(self: mut ref writer, data: slice<u8>) -> result<i64, ioError> {
        var done: i64 = 0
        while done < data.len {
            if self.len >= self.buf.len { self.flush()? }
            /* 能塞多少塞多少 ✓ */
            var room: i64 = self.buf.len - self.len
            var left: i64 = data.len - done
            if left < room { room = left }
            var k: i64 = 0
            while k < room {
                self.buf[self.len + k] = data[done + k]
                k = k + 1
            }
            self.len = self.len + room
            done = done + room
        }
        return success(done)
    }
}

/* 建一支 writer：`fd` + **隐式 64KB 缓冲**（跟 `readerOf` 对称 ✓）
 * 那 64KB 是 `new` 出来的 ⇒ 落进**调用点**的 arena ⇒ 跟 writer 自己同寿 ✓ */
fn writerOf(fd: i32) -> writer {
    var b: mut slice<u8> = new u8[BLK]
    return { fd: fd, buf: b, len: 0 }
}

/* 从 fd 读一次，返回**读到的字节数**（0 = EOF ✓；负数 = 出错）
 * ⚠️ 这是**裸原语那一层**，调用者自己看返回值；要好用的形状就用 `reader` ✓ */
fn readSome(fd: i32, buf: mut slice<u8>) -> i64 {
    return io::read(fd, buf.data, buf.len)
}

/* ================================================================ reader */

struct reader {
    fd:    i32
    chunk: mut slice<u8>
    len:   i64              /* chunk 里有多少有效字节 */
    pos:   i64              /* 已经消费到哪儿 */

    /* 还剩几个没消费的字节 ✓ */
    fn avail(self: ref reader) -> i64 { return self.len - self.pos }

    /* 还缓冲着字节吗（**不碰 fd** ✓） */
    fn buffered(self: ref reader) -> bool { return self.pos < self.len }

    /* 补货：一次 `read(2)` 读满一块 ✓ 返回读到的字节数，**0 = EOF** ✓
     * ⚠️ 这条是"一次进内核拿一整块"，不是"读一个字节" —— 快慢全在这儿 ✗ */
    fn fill(self: mut ref reader) -> result<i64, ioError> {
        let n = io::read(self.fd, self.chunk.data, self.chunk.len)
        if n < i64(0) { return failure(ioError.readFailed(self.fd)) }
        self.len = n
        self.pos = 0
        return success(n)
    }

    /* 下一个字节。返回值 **< 0 = EOF**（不是错误 ✓ 错误走 failure 那条路 ✓） */
    fn nextByte(self: mut ref reader) -> result<i64, ioError> {
        if self.pos >= self.len {
            let n = self.fill()?
            if n == i64(0) { return success(i64(-1)) }
        }
        let b = i64(self.chunk[self.pos])
        self.pos = self.pos + 1
        return success(b)
    }

    /* 结束了吗？（**会把缓冲耗完再看 fd**，所以答案一定准 ✓）
     * ⚠️ 判据只能是"fd 上真没数据了"，不能只看 `avail() == 0` ——
     *    缓冲空了不等于文件结束 ✗（那正是原来 `readLine` 把超长行切成两行的一半原因）*/
    fn eof(self: mut ref reader) -> result<bool, ioError> {
        if self.pos < self.len { return success(false) }
        if self.chunk.len == i64(0) { return success(true) }
        let n = self.fill()?
        return success(n == i64(0))
    }

    /* ---------------------------------------------------------------- 行 */

    /* 读一行到 `out`（**不含换行**）✓
     * 返回值：读到的字节数；**0 = 一开始就 EOF** ✓
     * ⚠️ 行比 `out` 长 ⇒ `failure(lineTooLong)` ——
     *    绝不像以前那样**静默切一半**，那会让调用者把一行当成两行 ✗✗ */
    fn nextLine(self: mut ref reader, out: mut slice<u8>) -> result<i64, ioError> {
        var n: i64 = 0
        while true {
            let b = self.nextByte()?
            if b < i64(0) { return success(n) }              /* EOF 收尾（最后一行没换行也算一行 ✓）*/
            if b == i64(10) { return success(n) }            /* '\n' ⇒ 行结束 ✓ */
            if n >= out.len { return failure(ioError.lineTooLong(n + i64(1))) }
            out[n] = u8(b)
            n = n + 1
        }
        return success(n)
    }

    /* ---------------------------------------------------------------- 空白与词 */

    /* 跳过空白（空格/制表/CR/LF/VT/FF）✓ 返回跳掉了几字节 */
    fn skipSpace(self: mut ref reader) -> result<i64, ioError> {
        var n: i64 = 0
        while true {
            let b = self.nextByte()?
            if b < i64(0) { return success(n) }
            if !isSpaceByte(b) { self.pos = self.pos - i64(1)  return success(n) }
            n = n + 1
        }
        return success(n)
    }

    /* 读一个词（**连续的非空白**）到 `out` ✓ 返回长度；0 = 先遇到 EOF ✓
     * 前导空白会跳过 ⇒ 可以直接连着调 ✓ */
    fn nextToken(self: mut ref reader, out: mut slice<u8>) -> result<i64, ioError> {
        self.skipSpace()?
        var n: i64 = 0
        while true {
            let b = self.nextByte()?
            if b < i64(0) { return success(n) }
            if isSpaceByte(b) { self.pos = self.pos - i64(1)  return success(n) }
            if n >= out.len { return failure(ioError.lineTooLong(n + i64(1))) }
            out[n] = u8(b)
            n = n + 1
        }
        return success(n)
    }

    /* ---------------------------------------------------------------- 整数 */

    /* 读一个整数（`docs/topics/IO.md` §4.4 的 A 档）✓
     *   · 前导空白跳过 ⇒ 连着调就是 OI 那种"一坨数字"的读法 ✓
     *   · 支持 `-`；**不收 `+`**（OI 数据里没有，收了反而会掩盖坏数据 ✗）
     *   · 数字后面**不是数字就停**，那个字节推回去 ⇒ `12,34` 连读两次得到 12 和 34 ✓
     * ⚠️ **溢出检测**：`i64` 上溢是 UB ⇒ 这里显式挡（不然就是"能证明却没证明" ✗）
     *    挡下来用 `lineTooLong` 报 —— 错误种类不够时宁可复用，
     *    也不要**静默截断**（截断会算出错答案还正常退出 ✗✗）*/
    fn nextInt(self: mut ref reader) -> result<i64, ioError> {
        /* 逐字节的版本是 `skipSpace` + `nextByte`，两个都是**方法调用**，每个数字要过
         * 好几个字节 ⇒ 实测这两个函数占掉全部指令的 **51%**（callgrind：
         * `reader_nextByte` 50.8%、`reader_nextInt` 43.9%）。它们在生成 C 里是 `static`，
         * 但返回 `result` 结构体 ⇒ GCC 不肯内联 ✗
         *
         * 所以这里把**缓冲热循环直接写进来**：`pos < len` 时只做下标 + 自增，不调任何方法；
         * 缓冲耗尽才调一次 `fill`（每 64KB 一次 ✓）。语义与逐字节版**逐字符一致**
         * （含"数字后的空白推回、换行/CRLF 吃掉"两条规则 ✓）。
         *
         * `nextByte` / `skipSpace` 保留给调用者，只是不再进热路径 ✓
         *
         * 推回用 `pushed` 记住那个字节，而不是把 `pos` 往回减 —— 减 `pos` 会在
         * "刚好补完缓冲"时退到缓冲之前 ⇒ 实测 `index -1 out of range` ✗ */
        var neg: bool = false
        var v: i64 = 0
        var got: bool = false
        var seen: bool = false          /* 已经读到过非空白 */
        var pushed: i64 = i64(0)        /* > 0 = 待重新消费的字节；-2 = 待重新消费的 EOF */
        var bad: bool = false           /* 看到过不认识的字节（推回它） */
        var b: i64 = i64(0)

        while true {
            /* ---- 取一个字节（热路径：不调方法）---- */
            if pushed == i64(-2) { pushed = i64(0)  b = i64(-1) }
            else if pushed > i64(0) { b = pushed  pushed = i64(0) }
            else {
                if self.pos >= self.len {
                    let n = self.fill()?
                    if n == i64(0) { b = i64(-1) }
                    else { b = i64(self.chunk[self.pos])  self.pos = self.pos + i64(1) }
                } else {
                    b = i64(self.chunk[self.pos])
                    self.pos = self.pos + i64(1)
                }
            }

            if !seen {
                if b < i64(0) { break }                 /* EOF：没有数字 ⇒ 0 ✓ */
                if !isSpaceByte(b) {
                    seen = true
                    if b == i64(45) { neg = true }
                    else { pushed = b }
                }
                continue
            }
            if bad {
                if b < i64(0) { pushed = i64(-2) }
                else { self.pos = self.pos - i64(1) }
                break
            }
            if b < i64(0) { break }                     /* EOF：数字到此为止 ✓ */
            if b >= i64(48) && b <= i64(57) {
                got = true
                let d = b - i64(48)
                if v > (I64_MAX - d) / i64(10) { return failure(ioError.lineTooLong(v)) }
                v = v * i64(10) + d
                continue
            }
            if !got { continue }                        /* 前导分隔符吃掉 ✓ */

            /* 数字后面的这个字节：换行（含 CRLF）吃掉，别的推回 ✓ */
            if b == i64(10) { break }
            if b == i64(13) {
                if self.pos < self.len {
                    if i64(self.chunk[self.pos]) == i64(10) { self.pos = self.pos + i64(1) }
                }
                break
            }
            bad = true                                  /* 下一轮把它推回 ✓ */
        }

        if !got { return success(i64(0)) }
        if neg { return success(i64(0) - v) }
        return success(v)
    }

    /* 那个字节是不是"该吃掉"的换行（LF，或 CR 后面跟 LF）✓
     * 与逐字节版逐字一致：只有换行被吃掉，其它空白一律推回 ✓ */
    fn newlineAfter(self: mut ref reader, b: i64) -> bool {
        if b == i64(10) { return true }
        if b == i64(13) {
            if self.pos < self.len {
                if i64(self.chunk[self.pos]) == i64(10) { self.pos = self.pos + i64(1) }
            }
            return true
        }
        return false
    }
}

/* ⭐ **建一个 reader**：`fd` + **隐式 64KB 缓冲** ✓
 * 那 64KB 是本函数的 `new` ⇒ 落到**调用点**那只 arena（"有家函数"那条路 ✓）⇒
 * 它跟 `reader` 自己**同寿**，调用者什么都不用管 ✓
 * ⚠️ 也就是说 `reader` 活在**哪个块**，缓冲就活到哪个块 —— 往块外传会被逃逸检查挡住 ✓ */
fn readerOf(fd: i32) -> reader {
    var c: mut slice<u8> = new u8[BLK]
    return { fd: fd, chunk: c, len: 0, pos: 0 }
}

/* ================================================================ 小工具 */

/* 是不是空白字节（**词法上的**，不是 `isspace` 那套 locale 相关的东西 ✓） */
fn isSpaceByte(b: i64) -> bool {
    if b == i64(32) { return true }      /* 空格 */
    if b == i64(9)  { return true }      /* \t   */
    if b == i64(10) { return true }      /* \n   */
    if b == i64(13) { return true }      /* \r   */
    if b == i64(11) { return true }      /* \v   */
    if b == i64(12) { return true }      /* \f   */
    return false
}
