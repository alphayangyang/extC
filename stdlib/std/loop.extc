use std::sys::net as sysnet
use std::sys::time

/* std/loop.extc —— 事件循环的**策略层**：定时（deadline 表）与"下一次该等多久"。
 *
 * 这一层**没有任何系统调用、没有 C**：它是一张按 deadline 排好序的表 + 三个纯函数。
 * 为什么这样切：循环里唯一需要"现在几点"的地方就是超时计算，把它抽出来以后，
 * **定时语义可以完全离线判据**（喂假时钟，不需要 I/O、不需要 epoll）。
 *
 * 形状（比"timerfd + 堆"少一套机制）：
 *
 *     let w = timers::timeoutMs(now, CAP)   // 下一个 deadline 之前该等多久（毫秒）
 *     n = epoll_wait(ep, buf, w)            // **唯一一个阻塞点**，超时就是定时器的唤醒
 *     let fired = t.popDue(now2, out[..])   // 到期的 tag（每个恰好一次）
 *
 * 也就是说：**时间不引入第二个事件源** —— `epoll_wait` 的超时参数本身就是定时器。
 * （毫秒分辨率对心跳 30s、每日播报 21:00 这种负载绰绰有余；真要高频高精度再加 timerfd，
 * 那时它是有理由的，而不是默认。）
 *
 * 约定：deadline 是**单调时钟的纳秒**（`loop::now()`），tag 是调用方自己的标识
 * （循环里通常是"哪个协程/哪条 fd"）。表满了 `add` 返回 -1（**响亮失败**，不静默丢）。
 */

/* 表的容量。**表太小会变成忙等**：64 项时，200 个同时在睡的任务里超出部分走 `add` 失败
 * 的兜底（"立刻重推"）⇒ 整批耗时涨到几百毫秒。1024 项 = 16 KB/循环，
 * 覆盖现实负载；真修法是把这张表搬进 `tasks<T>`（像 `runq`/`freeq` 那样）让它会长 ——
 * 那需要容器（引用）⇒ `loop` 会失去零值，不是这一轮的事。 */
let CAPACITY: i64 = 1024

@noCopy
struct timers {
    at: [1024]i64      /* deadline（纳秒，按序）—— 与 CAPACITY 同宽 */
    tag: [1024]i64     /* 调用方的标识 */
    @private n: i64

    /* 只把计数清零。数组里的旧值无所谓（`n` 之外的位置不会被读到）。 */
    fn init(self: mut ref timers) -> void { self.n = 0 }

    /* 登记一个 deadline。表满返回 -1。相同 deadline 按**登记顺序**保持稳定。 */
    fn add(self: mut ref timers, deadline: i64, tag: i64) -> i64 {
        if self.n >= CAPACITY { return -1 }
        var i: i64 = self.n
        /* 从后往前挪，稳定插入（`>` 而不是 `>=`：等值的排在新来的前面） */
        while i > 0 && self.at[i - 1] > deadline {
            self.at[i] = self.at[i - 1]
            self.tag[i] = self.tag[i - 1]
            i = i - 1
        }
        self.at[i] = deadline
        self.tag[i] = tag
        self.n = self.n + 1
        return i
    }

    fn count(self: ref timers) -> i64 { return self.n }

    /* 最近的 deadline；空表返回 -1。 */
    fn next(self: ref timers) -> i64 {
        if self.n == 0 { return -1 }
        return self.at[0]
    }

    /* `epoll_wait` 该等多久（毫秒）：空表给 `cap`；已到期给 0；其余按剩余时间，**上限 cap**。
     * 这一个函数就是"时间"与"就绪"的接缝 —— 也因此它是本模块最该被钉住的判据。 */
    fn timeoutMs(self: ref timers, at0: i64, cap: i64) -> i64 {
        if self.n == 0 { return cap }
        let left: i64 = self.at[0] - at0
        if left <= 0 { return 0 }
        let ms: i64 = (left + 999999) / 1000000     /* 向上取整：绝不早于 deadline 醒 */
        if ms > cap { return cap }
        return ms
    }

    /* 把 `now` 之前（含）到期的 tag 写进 `out`，返回个数。**每个 deadline 恰好取出一次。 */
    fn popDue(self: mut ref timers, at0: i64, out: mut slice<i64>) -> i64 {
        var k: i64 = 0
        /* **`out` 满了就停手**：从前是"继续弹、只是不写"，于是超出缓冲的那些定时器被
         * 悄悄丢掉 ⇒ 等它的任务永远不醒（这类调度器最脏的一种 bug）。剩下的留到下一轮。 */
        while self.n > 0 && self.at[0] <= at0 && k < out.len {
            out[k] = self.tag[0]
            k = k + 1
            var i: i64 = 0
            while i + 1 < self.n {
                self.at[i] = self.at[i + 1]
                self.tag[i] = self.tag[i + 1]
                i = i + 1
            }
            self.n = self.n - 1
        }
        return k
    }

    /* 取消一个还没到期的 tag：命中返回 true，并把后面的元素前移。 */
    fn cancel(self: mut ref timers, tag: i64) -> bool {
        var i: i64 = 0
        while i < self.n {
            if self.tag[i] == tag {
                var j: i64 = i
                while j + 1 < self.n {
                    self.at[j] = self.at[j + 1]
                    self.tag[j] = self.tag[j + 1]
                    j = j + 1
                }
                self.n = self.n - 1
                return true
            }
            i = i + 1
        }
        return false
    }
}

/* 一轮：算超时 → 等就绪。`tags` 由调用方拥有（多实例、可重入；容量自己定）。
 * 返回就绪事件数：0 = 超时，<0 = 出错。到期的定时器用 `timers.popDue` 另取 ——
 * 因为**时间就是 epoll_wait 的超时参数**，这里不需要第二个事件源。 */
fn runOnce(ep: i64, t: mut ref timers, tags: mut slice<i64>, at0: i64, capMs: i64) -> i64 {
    let w: i64 = t.timeoutMs(at0, capMs)
    return sysnet::extc_epoll_wait_into(ep, tags.data, tags.len, w)
}

/* std/time.extc —— **时间**（用户面）。
 *
 * 两个钟，问的是两个不同的问题，别混：
 *   - `now()`  单调钟：**不会倒退**，测"这段代码花了多久"用它 ✓
 *   - `real()` 墙钟：问"现在几点"用它；它会跳（NTP/时区/改表），拿它测时长是经典 bug ✗
 * 两个都是 **i64 纳秒**。为什么是整数纳秒：跨边界只走标量（见 `std::sys::time` 的说明），
 * 而整数纳秒既没有精度损失，也不会把"精度是多少"藏进浮点里。
 *
 * 为什么没有 `time::perf(fn)` 这种：闭包**还不能当参数**（lambda 的类型不可命名），所以计时
 * 只能是显式的 —— 起一个 `Timer`，跑你的代码，问它过了多久：
 *
 *   var t = time::start()
 *   …要测的代码…
 *   io::cout << t.elapsedMs() << " ms\n"
 */

/* 单调纳秒。测时长用这个。 */
fn now() -> i64 { return time::extc_time_mono_ns() }

/* 墙钟纳秒（Unix epoch 起算）。问"现在几点"用这个。 */
fn real() -> i64 { return time::extc_time_real_ns() }

fn sleepNs(ns: i64) -> void { time::extc_time_sleep_ns(ns) }
fn sleepUs(us: i64) -> void { time::extc_time_sleep_ns(us * 1000) }
fn sleepMs(ms: i64) -> void { time::extc_time_sleep_ns(ms * 1000000) }

/* 一个秒表：`time::start()` 起，之后随便问它过了多久。（类型名小写：extC 把大写留给类型参数 `T`。） */
struct timer {
  /* `@private`：起点是**实现细节** —— 秒表对外只有那几个 `elapsed*` 问题，别人不该改起点
   * （能改就等于能把计时改坏，而且公开面清单会把它算进"对外承诺"）。 */
  @private
  t0: i64

  fn elapsedNs(self: ref timer) -> i64 { return now() - self.t0 }
  fn elapsedUs(self: ref timer) -> i64 { return self.elapsedNs() / 1000 }
  fn elapsedMs(self: ref timer) -> i64 { return self.elapsedNs() / 1000000 }
  /* 秒，带小数：`f64` 在这里是合适的（人看的数，不是要精确累加的数）。 */
  fn elapsedSecs(self: ref timer) -> f64 { return f64(self.elapsedNs()) / f64(1000000000) }
}

/* 起表。 */
fn start() -> timer { return timer { t0: now() } }
