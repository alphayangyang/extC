/* std/sys/proc.extc -- the privileged layer for the process family
 *.
 *
 * One file per family: `std::sys::thread`, `std::sys::time`, `std::sys::net`,
 * `std::sys::proc`. `sys::` marks only "this is the extern! layer"; the short name is
 * the last path segment, so a reference reads `sysproc::exit`.
 *
 * ⚠️ This file is `proc` and the user-facing one is `std::proc`: the stdlib's layering
 * pattern is `std::X` over `std::sys::X`, so the two share a last segment -- a shape in
 * which a qualified reference can resolve to **itself** (unbounded recursion, no
 * diagnostic:, `#56`). This pair is the standard library's own
 * regression test for it: `std::proc::exit` wraps `std::sys::proc::exit` and declares the
 * same name, so if the loader ever binds the qualified call back to this module,
 * `proc::exit(7)` recurses instead of exiting and `tests/io/exit-code.extc` fails loudly ✓
 */
extern!("libc") fn exit(code: i32) -> void
    effects Addr=0 Cont=0

/* Duplicate this process. The parent gets the child's id (> 0), the child gets 0, a failure
 * gets -1 -- exactly as POSIX `fork` reports it. POSIX only (Linux/macOS); a Windows layer
 * would be its own file and its own decision.
 *
 * This is the primitive behind "one command, N workers": every child calls
 * `net::extc_tcp_listen_shared` (SO_REUSEPORT) and serves on its own core, so nothing is
 * shared between them and no sendability rule is involved -- which is why the multi-process
 * shape needs no compiler work at all. */
extern!("libc") fn fork() -> i32
    effects Addr=0 Cont=0

/* Reap one child: its raw status lands in `status`, the return value is the child's id
 * (> 0), 0 when `options` asked not to wait and none was ready, -1 on error. */
extern!("libc") fn waitpid(pid: i32, status: ref i32, options: i32) -> i32
    effects Addr=0 Cont=0

/* This process's id. */
extern!("libc") fn getpid() -> i32
    effects Addr=0 Cont=0

/* Pin a process (`pid` 0 = this one) to a set of cores: `mask` is a CPU bitmask, 8 bytes
 * little-endian on a 64-bit host -- the first 8 bytes of `cpu_set_t`, which is all
 * `std::proc::pin` hands over. POSIX; on Linux this is `sched_setaffinity`. */
extern!("libc") fn sched_setaffinity(pid: i32, cpusetsize: i64, mask: ref u8) -> i32
    effects Addr=0 Cont=0
