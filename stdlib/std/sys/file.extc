/* std/sys/file.extc —— **文件层**的运行期 shim：最小 HTTP 服务器要的那几个。
 *
 * 为什么单开一个模块（而不是塞进 `sys::io`/`sys::net`）：运行期的发射触发点是
 * **"这个 extern 声明在不在"**，而模块是整包导入的 ⇒ 声明混在 `sys::net` 里就会让每个
 * 用网络的程序都拖上文件层（实测：6 个协程产物因此变了字节 ✗）。一层一个模块，各拉各的 ✓。
 *
 * 为什么这些 shim 在 C 侧而不在 extC 侧：`struct stat` / `off_t` / 路径的 NUL 终止都留在 C 里，
 * extC 只拿标量。一条实测教训：把 `struct rusage` 镜像成前 5 个字段就让 `getrusage` 越界写栈
 * ⇒ SIGSEGV ✗ —— `struct stat` 更大更平台相关，不该让作者去声明布局。 */
use std::io

extern!("extc-runtime") fn extc_file_open(path: ref u8, len: i64, outSize: ref i64,
                                         outMtime: ref i64, outIsDir: ref i64) -> i64
    effects Addr=0 Cont=0      /* 拷进自己的缓冲就扔：不留路径，也不留那几个出参的地址 */
/* Flags-and-mode open: `std::fs` builds on it. The variant that also reports `struct stat`
 * is the one above; this one exists so the extC side never declares `open` itself -- glibc
 * declares it `open(const char *, int, ...)`, which a fixed-arity prototype contradicts
 * (`conflicting types for 'open'`) as soon as the product includes <fcntl.h>. */
extern!("extc-runtime") fn extc_file_open_at(path: ref u8, len: i64, flags: i64, mode: i64) -> i64
    effects Addr=0 Cont=0      /* copies the path into its own buffer: keeps no pointer */

/* `strlen` stays on the C side; extC only sees the fd. */
extern!("extc-runtime") fn extc_file_open_cstr(path: ref u8, flags: i64, mode: i64) -> i64
    effects Addr=0 Cont=0

/* `open(path, len, flags, mode)` -- what `std::fs` calls, with the length it already knows. */
fn openAt(path: ref u8, len: i64, flags: i32, mode: i32) -> i32 {
    return i32(extc_file_open_at(path, len, i64(flags), i64(mode)))
}

/* `open(path, flags, mode)` for a NUL-terminated path -- the C shape, kept for callers that
 * hand over `slice.data` of a NUL-terminated buffer. */
fn open(path: ref u8, flags: i32, mode: i32) -> i32 {
    return i32(extc_file_open_cstr(path, i64(flags), i64(mode)))
}

extern!("extc-runtime") fn extc_file_close(fd: i64) -> i64
/* 非阻塞 socket 上的 `sendfile`：返回**这次**送出去多少（可能少于 n ⇒ 调用方补）。 */
extern!("extc-runtime") fn extc_sendfile(outFd: i64, inFd: i64, off: i64, n: i64) -> i64
    effects Addr=0 Cont=0
/* HTTP 日期：正确性交给 libc（`strftime`/`strptime` 打过仗），extC 只拿长度与秒数。 */
    effects Addr=0 Cont=0
    effects Addr=0 Cont=0
