/* std/sys/io.extc -- the privileged layer for the io family (`docs/topics/IO.md`,
 * "tier 1 primitives"; `docs/topics/LIBS.md` section 5).
 *
 * Only the part that genuinely needs compiler or system privilege lives here: the C
 * function declarations plus their trust declarations. Other modules stand on this
 * one; user code should not use it directly. (v1 does not yet enforce that only
 * `std::sys::*` may declare primitives.)
 *
 * NOTE -- why `std::sys::io` rather than one flat `std::sys`:
 *   `sys` is not *one* module, it is *a boundary* written into a file path. What
 *   comes later each has its own family -- `std::sys::thread`, `std::sys::time`,
 *   `std::sys::net`, `std::sys::proc` -- and putting them all into a single
 *   `sys.extc` would turn that file into a dumping ground.
 *   => one file per family; `sys::` marks only "this is the extern! layer".
 *   => the short name is then exactly `io` (the last path segment), so a reference
 *      reads `io::read`. That it collides with `std::io` is not an accident: one is
 *      the io the *user* sees, the other the privileged primitives underneath it --
 *      two layers of the same family.
 *      (Cost: a single file cannot `use std::io` and `use std::sys::io` at the same
 *       time, because the short names collide. That is exactly right: whoever writes
 *       the library and whoever uses it belong in different files anyway.)
 *
 * NOTE -- why the trust declaration is required: `extern!` is a black box, so without
 *   a declaration the compiler has to assume the worst ("it may store your pointer
 *   beyond this frame"), which turns passing the address of a local into a compile
 *   error. See `docs/DECISIONS.md`.
 */

extern!("libc") fn read(fd: i32, buf: ref u8, n: i64) -> i64
    effects Addr=0 Cont=0
extern!("libc") fn write(fd: i32, buf: ref u8, n: i64) -> i64
    effects Addr=0 Cont=0

/* open / close -- the layer `std::fs` is built on.
 * NOTE: C wants the first argument of `open` to be a NUL-terminated path. An extC
 * string literal already has that shape in C (a static array followed by NUL), so
 * passing a literal works as is; a slice assembled at run time has to guarantee the
 * terminator itself. */
extern!("libc") fn open(path: ref u8, flags: i32, mode: i32) -> i32
    effects Addr=0 Cont=0
extern!("libc") fn close(fd: i32) -> i32
    effects Addr=0 Cont=0

/* `open` flags -- the POSIX numbers (on Linux O_CREAT=64, O_TRUNC=512).
 * NOTE: this is what the privileged layer is for -- keep platform-specific constants
 * down here, so the `std::fs` above only ever writes names like `io::O_CREAT`. */
let O_RDONLY: i32 = 0
let O_WRONLY: i32 = 1
let O_RDWR: i32   = 2
let O_CREAT: i32  = 64
let O_TRUNC: i32  = 512
let O_APPEND: i32 = 1024

let STDIN: i32  = 0
let STDOUT: i32 = 1
let STDERR: i32 = 2
