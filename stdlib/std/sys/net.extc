/* std/sys/net.extc —— 事件与 socket 的**特权层**（CONCURRENCY.md §4.4 阶段三）
 *
 * 与 `std::sys::pool`、`std::sys::coroutine` 同一形状：这一层只把生成器提供的运行期原语声明成
 * extC 能调的东西，实现是 `src/coroutine.c` 的事件块，**按需发射**。
 *
 * 跨边界只有**标量**（和一个指针）：`epoll_event` 的缓冲区留在运行期里，extC 侧永远看不到结构体 ——
 * 这样调度器不必知道任何平台结构体的布局。缓冲区的写法与 `std::sys::io` 一致：传 `slice` 的 `.data`。
 *
 * 读写走 `recv`/`send`（socket 系）而**不是** `read`/`write`：后者已经被 `std::sys::io` 用另一套
 * 签名占了名字，而两者会落在同一个编译单元里。
 *
 * 谁用它：`std::coro::scheduler` 的真事件源 `runEpoll`。 */

/* 建一个 epoll 实例，返回它的 fd。 */
extern!("extc-runtime") fn extc_epoll_new() -> i64
    effects Addr=0 Cont=0
/* 把 fd 加进 epoll 等它可读（`readable` 为 0 表示等可写）。返回 0 成功。 */
extern!("extc-runtime") fn extc_epoll_add(ep: i64, fd: i64, readable: i64) -> i64
    effects Addr=0 Cont=0
/* 等事件：返回**一个**就绪的 fd（内部留着一个待处理队列 ⇒ 事件循环零分配），
 * -1 = 超时/没有事件。 */
extern!("extc-runtime") fn extc_epoll_wait(ep: i64, timeout_ms: i64) -> i64
    effects Addr=0 Cont=0
/* 一对已连接的 AF_UNIX socket：fd 写进 `out[0]` 与 `out[1]`。返回 0 成功。 */
extern!("extc-runtime") fn extc_sock_pair(out: ref i64) -> i64
    effects Addr=0 Cont=0
/* 读一次：返回字节数，0 是对方关了，负数出错。 */
extern!("extc-runtime") fn extc_sock_read(fd: i64, buf: ref u8, n: i64) -> i64
    effects Addr=0 Cont=0
/* 写一次：返回写了几个字节。 */
extern!("extc-runtime") fn extc_sock_write(fd: i64, buf: ref u8, n: i64) -> i64
    effects Addr=0 Cont=0

/* AF_UNIX 监听。路径首字节是 NUL 就是**抽象命名空间**：不落盘、不用清理、随进程消失 —— 判据正合用。 */
extern!("extc-runtime") fn extc_unix_listen(path: ref u8, len: i64, backlog: i64) -> i64
    effects Addr=0 Cont=0
/* 连上去（同一个抽象名字）⇒ 返回 fd。 */
extern!("extc-runtime") fn extc_unix_connect(path: ref u8, len: i64) -> i64
    effects Addr=0 Cont=0
/* 非阻塞 accept：backlog 空的时候返回负数（EAGAIN）。 */
extern!("extc-runtime") fn extc_sock_accept(listener: i64) -> i64
    effects Addr=0 Cont=0
/* 把 fd 设成非阻塞。 */
extern!("extc-runtime") fn extc_sock_nonblock(fd: i64) -> i64
    effects Addr=0 Cont=0
/* 关掉 Nagle。小批量、多轮写的时候，Nagle 与对端的 delayed ACK 会凑出经典的 ~40ms 停滞
 *（实测：pipeline 形态、1024 字节回显，extC 侧设上它之后从 363 req/s 变成百万级）。 */
extern!("extc-runtime") fn extc_sock_nodelay(fd: i64) -> i64
    effects Addr=0 Cont=0

/* loopback 上的 TCP 监听。端口传 0 表示让内核挑（用 `extc_sock_local_port` 读回来）。
 * `sockaddr_in` 与字节序都在运行期里 —— extC 侧只收标量，和 AF_UNIX 那边同形。 */
extern!("extc-runtime") fn extc_tcp_listen(port: i64, backlog: i64) -> i64
    effects Addr=0 Cont=0
/* 连到 loopback 上的某个端口。 */
extern!("extc-runtime") fn extc_tcp_connect(port: i64) -> i64
    effects Addr=0 Cont=0
/* 这个 fd 绑在哪个端口上（配合 `port = 0` 用）。 */
extern!("extc-runtime") fn extc_sock_local_port(fd: i64) -> i64
    effects Addr=0 Cont=0
/* 从偏移处写（部分写要接着写 ✓ extC 没有指针运算 ⇒ 偏移由运行期加）。 */
extern!("extc-runtime") fn extc_sock_write_from(fd: i64, buf: ref u8, from: i64, n: i64) -> i64
    effects Addr=0 Cont=0
/* 半关写端：对端看到 EOF，这一侧还能把回声读回来。 */
extern!("extc-runtime") fn extc_sock_shutdown_wr(fd: i64) -> i64
    effects Addr=0 Cont=0

/* 和 `extc_tcp_listen` 同形，但设上 `SO_REUSEPORT`（在 bind **之前**）⇒ **N 个独立进程**可以绑
 * 同一个端口，内核按流哈希把连接分给它们。这就是多进程的全部：不共享内存、不加锁、不改语言 ——
 * `extc_pool_*` 与 `extc_task_*` 天然各进程一份，某个 worker 崩了也只带走自己的连接。
 *
 * 启动用 `tools/extc-workers.sh N <程序>`：一条命令起 N 个进程、各绑一个核、崩了自动重启。
 *
 * 实测（2026-09-28 · 8 个 P 核 · loopback · 256 连接 · HTTP keep-alive · 同一个 50 行响应器）：
 * 8 个单线程进程 **1,317,455 req/s / 15 MB RSS**；nginx 1.28.3 八个 worker（调优到牙齿）
 * 1,064,775 req/s / 249 MB。 */
extern!("extc-runtime") fn extc_tcp_listen_shared(port: i64, backlog: i64) -> i64
    effects Addr=0 Cont=0
