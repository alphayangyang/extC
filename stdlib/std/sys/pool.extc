/* std/sys/pool.extc —— 区域注册表的**特权层**（POOLS.md 期 1）
 *
 * 这一层只做一件事：把生成器提供的运行期原语声明成 extC 能调的东西（与 `std::sys::io`
 * 声明 `extc_cout_put` 同一形状）。**用户不写这个模块**：`std::stl` 那一类容器用它，
 * 普通程序连 pool 这个词都不该出现
 *
 * 管理面：建 / 释放 / 重置 / 世代 / 存活数。**带类型的内存分配**不走 `extern!`：
 * `extern!` 不许返回 `slice<T>`（会变成两个 C 参数），extC 也没有指针转换 ⇒
 * 那一扇门由生成器发的内建提供（`poolSlice<T>(rid, n)`，POOLS.md §2.1「池有两副面」）
 *
 * 池的寿命挂在"地方"上：zone 是一条独立旁链，地方退出时按标记回退、整批回收
 * （`extc_pool_zoneLeaveTo`）；池树的两条链（寿命链 / 父池子链）见 POOLS.md §7.7 */
extern!("extc-runtime") fn extc_pool_new(parent: i64) -> i64
    effects Addr=0 Cont=0
extern!("extc-runtime") fn extc_pool_drop(rid: i64) -> void
    effects Addr=0 Cont=0
extern!("extc-runtime") fn extc_pool_reset(rid: i64) -> void
    effects Addr=0 Cont=0
extern!("extc-runtime") fn extc_pool_generation(rid: i64) -> u64
    effects Addr=0 Cont=0
extern!("extc-runtime") fn extc_pool_live() -> i64
    effects Addr=0 Cont=0
/* 槽位表的容量：**只涨到"同时活着的 pool 数"的高水位**，与创建过多少次无关 ——
 * churn 判据（`tests/pool/churn.extc`）用它证明"反复建/放不涨内存" ✓ */
extern!("extc-runtime") fn extc_pool_capacity() -> i64
    effects Addr=0 Cont=0
extern!("extc-runtime") fn extc_pool_zoneDepth() -> i64
    effects Addr=0 Cont=0

/* 容器数据用的内存：**池自己的板块**，不是 arena 里的切片（POOLS.md §2 作者口径
 * 「pool 的内存是独立的一个板块，只是生命周期给 arena 一起管理」）。容量不够时由池再要一块，
 * 旧块能当场还回去 —— 这正是 `vector` / `string` 扩容之后不留旧副本的依据（§2.1 裁决一）。
 * 字节面留给运行期自己用；库侧只走类型化内建。清零与失败行为跟别的分配一样。 */
extern!("extc-runtime") fn extc_pool_alloc(rid: i64, bytes: i64) -> mut ref u8
    effects Addr=0 Cont=0
