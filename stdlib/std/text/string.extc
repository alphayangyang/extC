/* stl/string.extc —— SSO 字节串（内联 16 字节，超过了才进池；STL 第二个池底容器）
 *
 * 口径：**序列化面保持连续** —— 下游全吃 `slice<u8>`
 * （print · IO · 哈希 · `extern!` 边界），所以这里绝不分块；**拿到内容只有 `snapshot()` 一条路
 * （拷一份），池里不放视图出去**。
 *
 * 两态存储，判据**只有一个**：`cap == 0` ⟺ 内联（内容在 `small[16]u8` 里）。
 *   · **零值 = 内联空串**：合法、可用、零分配 —— `var s: string` 直接写，`isEmpty()` 为真、
 *     `capacity()` 为 0（没有池）。所以这个类型可以零初始化（字段里没有裸的引用，
 *     `big` 的零值是 `none`）；
 *   · **第一次写到第 17 个字节才升级**：建池 → 拿一块 32 字节的板块 → 把 16 个内联字节拷过去
 *     → 填 `cap`/`pid`/`pidGen`/`big`。之后就是普通池底容器：`grow` 按 1.5 倍原地长
 *     （旧块当场还回去，不留历代旧副本）、`shrink` 降高水位、`release` 校验世代后整批还。
 *
 * **`pid == 0` 绝不是"没有池"的哨兵**：第一个池的 rid 恰好就是 0（`{index,generation}` 打包）。
 * 内联还是池，只问 `cap == 0`；`pStale` / `pPoison` / `release` / `grow` / `push` / `append` /
 * `removeFront` / `shrink` / `at` / `snapshot` / `subView` 各问一次，问的都是同一个字段。
 *
 * 内联态没有池记录（`pid` 只是零值 0），所以**不花池、不分配**：100 万次"构造 + 写一字节 + 读回"
 * 实测 eager 9.35 ms · 零值惰性 14.59 ms · **SSO 0.39 ms**。`pid`/`pidGen` 只在升级时才有意义。
 *
 * 内联态的容量：字段 `cap` 是 0（`capacity()` 因此对零值/短串如实回答"没有池"），但**物理上**
 * 还能再装 16 个字节 —— 写入路径 `push` / `append` 先看 `n < 16` 就地写，装不下才升级。
 *
 * @code
 * use std::io
 * use std::text::string
 *
 * fn main() -> i32 {
 *     var s: string = string::withCap(8)
 *     s.append("hello")
 *     io::cout << s.snapshot() << " len=" << s.len() << "\n"
 *     return 0
 * }
 * @endcode
 */
use std::io
use std::sys::pool as syspool
use std::mem as sysmem

@sharesStorage        /* **升级到池之后**按值拷贝 ⇒ 两份共用同一块板块，编译器在这里报警告；
                       * 要独立副本用 `clone()`（内联态其实各拿各的 16 字节，但检查器一律保守） */
@poolObject            /* 这个类型**可能拥有一个池**：升级之后存储住在池自己的板块上，寿命随它所在的地方 */
struct string {
    @private small:  [16]u8          /* 内联缓冲：零值 = 内联空串（零分配的合法状态） */
    @private n:      i64
    @private cap:    i64             /* 0 = 内联；!= 0 = 池里，且 cap 就是池块容量（>= 16） */
    @private big:    ?mut slice<u8>  /* 只有升级到池之后才 some —— 存一次、之后复用（每次 poolSliceRaw 都是新分配） */
    @private pid:    i64
    @private pidGen: u64

    /* 构造器（`withCap` 的落点）。非泛型类型上 `string::new(...)` 会被读成
     * "模块 string 的函数 new"（模块名与类型名同名），所以这里叫 `create`；
     * `new` / `empty` 两个名字留给**模块级**函数（文件末尾），从模块外写才对得上。
     *
     * 语义与老的 `new` 一字不差：**要了容量就建池**（`c` 下限 16 ⇒ `capacity()` 立刻 >= 16），
     * 因为"预分配 n 字节"这句承诺不能靠内联的 16 字节兑现。SSO 省下的是**零值**与短串的默认构造，
     * 不是显式的 `withCap`。 */
    fn create(c: i64) -> string {
        let rp = syspool::extc_pool_new(-1)
        let rpg = syspool::extc_pool_generation(rp)
        var cc: i64 = c
        if cc < 16 { cc = 16 }
        var s: string = {
            n:      0,
            cap:    cc,
            big:    some(poolSliceRaw<u8>(rp, cc)),
            pid:    rp,
            pidGen: rpg,
        }
        return s
    }

    @inline
    fn len(self: ref string) -> i64 { return self.n }

    @inline
    fn capacity(self: ref string) -> i64 { return self.cap }

    @inline
    fn isEmpty(self: ref string) -> bool { return self.n == 0 }

    /* **拿到内容只有这一条路：`snapshot()` —— 拷一份到调用者所在的地方。**
     *
     * 为什么没有"零拷贝视图"：那等于把**池里的东西**交出去（作者口径，：
     * 「Pool 里的东西永远不能被外面引用」），而且它本来也守不住 —— `push` 一次（可能 `grow`
     * 搬家）、`clear`（翻纪元）、`shrink`、`release` 任何一个动作都能让它失效。
     * 作者的原话最直白：「你并没有办法安全地长期持有 C++ `std::string` 的一个视图，
     * 因为我插入一下扩容一下你就完蛋了」。`snapshot` 这个名字也不容易读错（`as*` 那种
     * 命名看起来就像"给了里面的一个视图"）。
     *
     * 内联态**也照拷**：`string` 是值，`small` 就在这个结构体里 —— 交一个指向自己的视图出去，
     * 调用者一拷贝/一移动就悬垂。所以这里两条路都是"新分配 + 搬字节"，
     * 实现上 `new u8[n]` 写在方法体里，但逃逸分析会把这次分配提到**调用者**选的地方
     *（arena 的 home 机制）⇒ 它活得比这一次调用长，可以存、可以返回。 */
    
/** 借出一个只读字节视图（**不拷贝**）：`string` 因此能直接出现在收 `slice<u8>` 的参数上
     *  （自动借出看的就是这个名字与签名）。要一份独立的拷贝用 `snapshot`。 */
    fn view(self: ref string) -> slice<u8> { return self.subView(0, self.n) }

    fn snapshot(self: ref string) -> slice<u8> {
        var out: mut slice<u8> = new u8[self.n]
        copyInto<u8>(out, self.subView(0, self.n), self.n)
        return out
    }

    /* **深拷贝：要一份独立的字符串就用它。**
     *
     * `var b = a` 不是深拷贝 —— 那是结构体逐成员拷贝：内联态倒是各拿各的 16 个字节，
     * 可**升级到池之后**两份共用同一块板块（`big` 是指针被抄了一份），`b.push(...)` 会改到
     * `a` 的内容、`a.release()` 会让 `b` 悬垂。显式拷贝的代价可见（一次 O(n) 拷贝 + 最多一块新板块），
     * 新缓冲区生在调用者所在的地方。短串从这里出去仍是**内联**的：`append` 会自己按需升级。 */
    fn clone(self: ref string) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        return out
    }
    
    /* ---------------------------------------------------------------- 比较与哈希
     *
     * `==` / `<` are defined per RIGHT-OPERAND type (that is how every overloadable operator in
     * extC is matched), so a string can be compared with another string and with a raw `slice<u8>`
     * alike -- the second is what makes `s == "abc"` work, since a literal is a byte slice.
     * `!=` needs no method: the operator lookup falls back to `==`. There is no implicit
     * conversion between `string` and `slice<u8>`, hence the two spellings instead of one.
     *
     * Both sides go through `subView(0, n)`: a read-only view of this value, consumed by the
     * comparison before anything can change. */
    fn ==(self: ref string, other: string) -> bool {
        return string::bytesEq(self.subView(0, self.n), other.subView(0, other.n))
    }

    fn ==(self: ref string, other: slice<u8>) -> bool { return string::bytesEq(self.subView(0, self.n), other) }

    fn <(self: ref string, other: string) -> bool {
        return string::bytesLt(self.subView(0, self.n), other.subView(0, other.n))
    }

    fn <(self: ref string, other: slice<u8>) -> bool { return string::bytesLt(self.subView(0, self.n), other) }

    /* 逐字节比较的两条循环都**跳过边界检查**（`@unchecked`，手册 12.5）。
     *
     * 范围由哪一行保证，一个用点一行 —— 这正是这个注解的规矩：指不出那一行就不许标。
     *   · `bytesEq`：上一句 `if a.len != b.len { return false }` 之后 `a.len == b.len`，
     *     循环条件又是 `i < a.len` ⇒ 两个下标同时在范围内；
     *   · `bytesLt`：循环条件自己就是 `i < a.len && i < b.len`，一人管一半。
     * 代价写在手册里：越界从此是未定义行为，不再有带位置的 trap。所以只对"长度已经对上"的
     * 字节循环成立；它们是 `string` 的 `==` / `<` 的内层，每次比较都要走一遍。 */
    @unchecked
    fn bytesEq(a: slice<u8>, b: slice<u8>) -> bool {
        if a.len != b.len { return false }
        var i: i64 = 0
        while i < a.len {
            if a[i] != b[i] { return false }
            i = i + 1
        }
        return true
    }

    @unchecked
    fn bytesLt(a: slice<u8>, b: slice<u8>) -> bool {
        var i: i64 = 0
        while i < a.len && i < b.len {
            if a[i] != b[i] { return a[i] < b[i] }
            i = i + 1
        }
        return a.len < b.len
    }

    /* FNV-1a over the bytes, folded to a non-negative i64 -- good enough for a hash table and
     * cheap: `hashMap<string, V>` needs exactly this plus `==`. */
    /* `@unchecked`：范围由循环条件 `i < v.len` 那一行保证（`v` 是本函数自己取的视图，之后不再变）。 */
    @unchecked
    fn hash(self: ref string) -> i64 {
        let v = self.subView(0, self.n)
        var h: i64 = 1469598103934665603
        var i: i64 = 0
        while i < v.len {
            h = h ^ i64(v[i])
            h = h * 1099511628211
            i = i + 1
        }
        return h & 9223372036854775807
    }

    /* ---------------------------------------------------------------- 拼接
     *
     * THREE SPELLINGS, one meaning each:
     *   - `s.append(t)` grows the receiver in place (the usual way to build a string);
     *   - `s.concat(t)` / `s.concatBytes(t)` return a NEW string, leaving the receiver alone;
     *   - `s + t` is the operator spelling of the same thing (see the two `fn +` overloads
     *     below). It allocates through the same zone the concat methods use, so the operator
     *     call site needs no arena argument beyond the zone the operator path already passes.
     *
     * The result starts as a **zero value** (inline, no pool) and reaches for the pool only if the
     * concatenation does not fit in the 16 inline bytes -- a short join allocates nothing at all. */
    fn concat(self: ref string, other: string) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        out.append(other.subView(0, other.n))
        return out
    }

    fn concatBytes(self: ref string, other: slice<u8>) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        out.append(other)
        return out
    }

    /* `s + t`：拼接的运算符写法。返回**新值**、不写接收者（`+=` 不在可重载集合里）；
     * 右操作数按类型分三份重载 —— `slice<u8>`（字面量与视图）、`string`、单字节。分配落在
     * 调用点给的 arena 上（运算符调用点现在与方法调用点走同一套 home/zone 记账）。 */
    fn +(self: ref string, other: slice<u8>) -> string { return self.concatBytes(other) }

    fn +(self: ref string, other: string) -> string { return self.concat(other) }

    /* 数字与布尔值的运算符重载：`"a=" + n` 直接得到字符串（值形式的 f-string 就靠这一组
     * 脱糖）。走的是"复制接收者 + 追加"的朴素路径，与 `appendI64` 一样不为数字多写一层
     * 临时视图。整数按位宽各一份 —— 运算符重载按右操作数的静态类型精确选，没有隐式加宽。 */
    fn +(self: ref string, other: i64) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: i32) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: i16) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: i8) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: u32) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: u16) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: u8) -> string { return self.pNumeric(i64(other)) }

    fn +(self: ref string, other: bool) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        if other { out.append("true") } else { out.append("false") }
        return out
    }

    /* 复制接收者再追加一个十进制数字：`+` 的数字重载共用这一条。 */
    fn pNumeric(self: ref string, v: i64) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        out.appendI64(v)
        return out
    }

    /* ---------------------------------------------------------------- 取字节与视图 */
    /* One byte, or `none` when out of range (no trap: reading past the end is a condition). */
    fn at(self: ref string, i: i64) -> ?u8 {
        if i < 0 || i >= self.n { return none }
        if self.cap == 0 { return some(self.small[i]) }
        return some(self.big![i])
    }

    /* A zero-copy view of [lo, hi). Bounds are clamped, so a bad range gives an empty view rather
     * than reading past the buffer. */
    /* A substring: **a copy**.
     *
     * A zero-copy view into the pool plate cannot be defended: `push` / `append` grow the
     * string by replacing the block (the old one goes back to the pool), so the view dangles
     * the moment the string changes, and the checker cannot see it. It is the same shape
     * `snapshot` above already documents, and states the rule: a view into a pool
     * plate has nothing to lean on.
     *
     * The copy lands where the **caller** chose (`new` plus the escape analysis's home arena),
     * so the result may be stored and returned like any other value.
     *
     * Need zero copy? `subView` below, and sign for it. */
    fn sub(self: ref string, lo: i64, hi: i64) -> slice<u8> {
        var a: i64 = lo
        var b: i64 = hi
        if a < 0 { a = 0 }
        if b > self.n { b = self.n }
        if b < a { b = a }
        var out: mut slice<u8> = new u8[b - a]
        copyInto<u8>(out, self.subView(a, b), b - a)
        return out
    }

    /* A zero-copy view -- valid **only while the string is not changed**.
     *
     * Growing the string (`push` / `append`) replaces the block, and the view dangles at once;
     * the checker cannot see that, because it is not a lifetime question but a "the block was
     * replaced" one. This is the same category as `!` and `extern!`: you sign, you own it.
     * Use `sub` unless a profile says otherwise.
     *
     * SSO adds one wrinkle to that contract for the INLINE case: the view then points into the
     * string value itself (`small`), so it is also invalidated by **copying / moving the string**
     * -- the escape checker does catch the lifetime half (a view of a local cannot escape its
     * block), but the "the value was copied" half is still a signature. In the pool case nothing
     * changed: the view points at the plate. */
    fn subView(self: ref string, lo: i64, hi: i64) -> slice<u8> {
        var a: i64 = lo
        var b: i64 = hi
        if a < 0 { a = 0 }
        if b > self.n { b = self.n }
        if b < a { b = a }
        if self.cap == 0 { return self.small[a..b] }
        return self.big![a..b]
    }

    /* ---------------------------------------------------------------- 子串查找：交给运行期
     *
     * WHY NOT Two-Way IN extC (it was here, and it was correct -- `tests/stl/stringFind.extc`
     * exhaustive cross-check is what proved it): the algorithm was fine, the *cost model* was not.
     * Every byte of the haystack went through `hay[i]`, and every subscript paid the boundary
     * check the language promises. callgrind on a reduced probe: **25.5 instructions per byte**,
     * 30% of them concentrated in the single line
     * `if (i < 0 || i >= v.len) extc_trap(file, line, ...)`.
     *
     * The measurement, from `bench/string_vs_cpp/` (10,000 patterns of 4..15 bytes, half of them
     * absent, on a 1 MB string): `find` took 3172.7 ms against libstdc++'s 138.8 ms, and the two
     * things libstdc++ has that a byte-at-a-time extC loop does not are `memchr`/`memcmp` being
     * vectorised and the absence of a per-byte check. So the search is handed to libc's `memmem`
     * (two-way inside glibc, with a `memchr` first-byte scan), through `std::mem` -- the
     * same door `read`/`write` go through, integers only, on the byte-search runtime
     * (`src/memfind.c`, emitted on demand).
     *
     * THE CONTRACT IS UNCHANGED, and `tests/stl/stringFind.extc` still checks it exhaustively:
     * first (leftmost) match, `none` when absent, `some(0)` for the empty pattern, `none` when
     * the pattern is longer than the string, and a self-overlapping pattern (`aa` in `aaaa`)
     * still answers 0. `memmem` returns the leftmost match, which is exactly the promise. */
    fn find(self: ref string, needle: slice<u8>) -> ?i64 {
        let m = self.n
        let n = needle.len
        if n == 0 { return some(0) }
        if n > m { return none }
        let hay = self.subView(0, m)
        /* `hay.data` is the first byte, `needle.data` the first pattern byte; `m` is the whole
         * string and `n <= m` holds from the line above, so the runtime sees a range it can use. */
        let r = std::mem::extc_memFind(hay.data, m, needle.data, n)
        if r < 0 { return none }
        return some(r)
    }

    fn contains(self: ref string, needle: slice<u8>) -> bool {
        let at = self.find(needle) ?? -1      /* a found offset is never negative */
        return at >= 0
    }

    /* `startsWith` / `endsWith` are one `memcmp` (through the runtime's integer door --
     * `memcmp` itself cannot be declared in extC: its `const void *` / `size_t` parameters
     * cannot be spelled here, so a hand-written declaration cannot agree with `<string.h>`,
     * which the generated C includes).
     *
     * Both take a prefix/suffix view first, so the lengths on the two sides of the compare are
     * equal by construction: `subView(0, p.len)` clamps to `self.n`, and the `p.len > self.n`
     * guard above means no clamping happens. The empty pattern compares nothing and is true. */
    fn startsWith(self: ref string, p: slice<u8>) -> bool {
        if p.len > self.n { return false }
        if p.len == 0 { return true }
        let v = self.subView(0, p.len)
        return std::mem::extc_memEq(v.data, p.data, p.len) == 1
    }

    fn endsWith(self: ref string, p: slice<u8>) -> bool {
        if p.len > self.n { return false }
        if p.len == 0 { return true }
        let off = self.n - p.len
        let v = self.subView(off, self.n)
        return std::mem::extc_memEq(v.data, p.data, p.len) == 1
    }

    /* 扩到 1.5 倍：在原块上长（装不下时才由分配器搬家），字节由 resize 保住。
     * 连续性与「不留历代旧副本」同时成立。
     *
     * SSO：`cap == 0` 时这一步是**升级**，不是扩容 —— 建池、拿第一块 32 字节的板块、
     * 把 16 个内联字节拷进去。之后才走 1.5 倍那条老路。两条路的纪律是同一条：
     * 换块时旧块（这里是"没有块"）当场还回去，不留历代旧副本。 */
    fn grow(self: mut ref string) {
        if self.cap == 0 {
            let rp = syspool::extc_pool_new(-1)
            let rpg = syspool::extc_pool_generation(rp)
            var blk: mut slice<u8> = poolSliceRaw<u8>(rp, 32)
            copyInto<u8>(blk, self.small[0..16], 16)
            self.big = some(blk)
            self.cap = 32
            self.pid = rp
            self.pidGen = rpg
            return
        }
        if self.pid < 0 { return }
        let ncap = self.cap + self.cap / 2
        self.big = some(poolResizeRaw<u8>(self.pid, self.big!, ncap))
        self.cap = ncap
    }

    fn push(self: mut ref string, b: u8) {
        if self.pStale() { self.pPoison() }
        if self.cap == 0 && self.n < 16 {
            self.small[self.n] = b
            self.n = self.n + 1
            return
        }
        if self.n >= self.cap { self.grow() }
        /* 走到这里 `cap != 0` ⇒ 池态。逐字节的热路径直接取载荷（`!` 是"调用者签字"，
         * 不生成标签检查）：`match` 每字节都要拷一次切片值，实测 10M 次 push 慢 2–3×
         * （bench/stl/string.extc）。不变式由本文件维持 —— 五个改动点
         * （`create` / `grow` / `pPoison` / `release` / 这里的 `grow`）都同时设 `cap` 与 `big`；
         * 若有人手工拼一个 `{ cap: 8 }`（`big` 为零值 `none`），载荷是零值切片
         * ⇒ 下标写带位置 trap，而不是野指针。 */
        self.big![self.n] = b
        self.n = self.n + 1
    }

    /* 追加一段字节（"序列化面"最常见的一步）。
     *
     * **一次 `copyInto`，不是逐字节 `push`**：`push` 每来一个字节都要做一次陈旧池守卫
     * （`pStale()` = 池世代的加载+比较，实测约 1 cycle/字节）与一次容量检查。批量做就只付一次
     * —— 这正是 `bench/app` 场景 C 里那 28% 的来源（DEVLOG 第十一段续八）。
     *
     * SSO：装得下 16 个内联字节就地写（**一个池都不建**）；装不下先 `grow` 升级再搬。 */
    fn append(self: mut ref string, s: slice<u8>) {
        if self.pStale() { self.pPoison() }
        if s.len <= 0 { return }
        let need: i64 = self.n + s.len
        if self.cap == 0 && need <= 16 {
            copyInto<u8>(self.small[self.n..need], s, s.len)
            self.n = need
            return
        }
        while self.cap < need { self.grow() }
        match self.big {
            some(bk) => {
                var w: mut slice<u8> = bk
                copyInto<u8>(w[self.n..need], s, s.len)
            }
            none => { }
        }
        self.n = need
    }

    /* 丢掉最前面的 `n` 个字节（有界缓冲「丢掉最老的一半」就是这个）。
     * 一次 `memmove`（区间重叠，所以必须是 move 不是 copy）。 */
    fn removeFront(self: mut ref string, n: i64) {
        if self.pStale() { self.pPoison() }
        if n <= 0 { return }
        var k: i64 = n
        if k > self.n { k = self.n }
        let keep: i64 = self.n - k
        if self.cap == 0 {
            copyInto<u8>(self.small[0..keep], self.small[k..self.n], keep)
            self.n = keep
            return
        }
        match self.big {
            some(bk) => {
                var w: mut slice<u8> = bk
                copyInto<u8>(w[0..keep], w[k..self.n], keep)
            }
            none => { }
        }
        self.n = keep
    }

    fn appendByte(self: mut ref string, b: u8) { self.push(b) }

    /* 十进制整数的追加：`s.appendI64(n)`。与 `s.append(str::fromI64(n).snapshot())` 的区别是
     * 中间那个临时 `string` 不出现 —— 拼日志/报表时不必为"数字"多写一层转换，
     * 也不会踩到"切临时值的视图"的借用规则。负数带 `-`，`i64` 最小值按无符号处理不会溢出。 */
    fn appendI64(self: mut ref string, v: i64) {
        var t: string = fromI64(v)
        self.append(t.subView(0, t.n))
    }

    /* 缩容到刚好装下（下限 16）；连续性与字节不变。
     *
     * 内联态（`cap == 0`）没有可缩的：它本来就只占 16 字节，而且"下限 16"这条承诺
     * 与内联缓冲等大 —— 池态缩到 16 之后仍是池态，不往回退（退回内联会让 `capacity()`
     * 从 16 掉到 0，那是另一个语义）。 */
    fn shrink(self: mut ref string) {
        if self.cap == 0 { return }
        var ncap: i64 = self.n
        if ncap < 16 { ncap = 16 }
        if ncap >= self.cap { return }
        self.big = some(poolResizeRaw<u8>(self.pid, self.big!, ncap))
        self.cap = ncap
    }

    fn clear(self: mut ref string) { self.n = 0 }

    /* **守卫**：这一份容器值还指着它的池吗？（池被 release 掉 / 槽位被别的池复用时世代对不上）
     * 陈旧 ⇒ 把这一份收成空容器，让下一次下标访问带位置地 trap，而不是写已还给 malloc 的内存。
     *
     * 内联态（`cap == 0`）没有池，谈不上陈旧 —— 这一条**必须问在 `pid` 之前**：
     * 零值的 `pid` 就是 0，而 0 是一个合法的池 rid（第一个池）。 */
    fn pStale(self: ref string) -> bool {
        if self.cap == 0 { return false }
        if self.pid < 0 { return false }
        return syspool::extc_pool_generation(self.pid) != self.pidGen
    }
    /* 收成**零值**（内联空串）：这是 SSO 之后唯一的"空且合法"状态 ——
     * 陈旧拷贝从此不再指向任何池块，所以既不会写已还给 malloc 的内存，
     * 也不会像旧实现那样把 0 长视图留在身上（那要求每个访问点都记得自己会 trap）。 */
    fn pPoison(self: mut ref string) {
        self.n   = 0
        self.cap = 0
        self.big = none
        self.pid = -1
    }

    fn release(self: mut ref string) {
        /* 内联：没有池可还（`pid` 可能是 0 —— 第一个池的 rid —— 所以这里**不能**看 pid）。 */
        if self.cap == 0 { return }
        /* One staleness question, one place to ask it (`pStale`): the comparison lives in
         * exactly one place, and two copies of a load-bearing check would drift. */
        if self.pStale() {
            self.pPoison()      /* 陈旧拷贝：槽位已被别的池复用，什么都不许做 */
            return
        }
        let rp = self.pid
        /* 先把视图收成 0 长，再把板块还给池：之后任何下标都是响亮越界
         * （带位置的 trap），而不是写进一块已经还掉的内存。还完收成零值（内联空串）：
         * 释放过的字符串就是空串 —— 读它不再需要"记得它会 trap"。 */
        self.big = some(poolResize<u8>(rp, self.big!, 0))
        self.cap = 0
        self.big = none
        self.n   = 0
        syspool::extc_pool_reset(rp)
        syspool::extc_pool_drop(rp)
        self.pid = -1
    }
}

/* 模块级构造器。
 *
 * 为什么需要它们：模块名与类型名同名（`stl/string.extc` 里的 `string`）时，
 * `string::new(c)` 会被读成"模块 string 的函数 new"，`string(c)` 也解析不到类型
 * （两条路都要消歧）。泛型容器没这个问题 —— `vector<i32>::new()` 的 `<>` 就消歧了。
 * 这里用"模块级函数"这条路：`string::withCap(n)` 明确是模块导出的函数。
 *
 * 所以：**要容量用 `withCap(n)`；要空串用 `new()` / `empty()`；零值 `var s: string` 也对**。
 * `new()` / `empty()` 与零值完全等价（内联、零分配、`capacity() == 0`）——
 * 它们存在只是为了让手册里那句 `string::new()` 真的能用（此前只有类型上的 `new(c)`，
 * 从模块外写 `string::new()` 根本不存在）。 */
fn withCap(c: i64) -> string { return string::create(c) }
fn new() -> string { var s: string  return s }
fn empty() -> string { var s: string  return s }

/**
 * @brief 把十进制文本解析成 `f64`：`[+-]digits[.digits][(e|E)[+-]digits]`。
 *
 * 与 `toI64` 同一条路：先在这里判定形状，不合形状一律 `none`（调用者用 `??` 兜底）。
 * 不做 `inf`/`nan`/十六进制浮点，也不接受单独的小数点开头（`.5`）—— 要那样写就补个 `0`。
 * 尾数逐位累进 `f64`，指数逐次乘/除 10（不调 `pow`）：常见输入上与 printf 解析一致，
 * 极端位数会有末位差别，文档里写明。
 *
 * @param b  待解析的字节视图。
 * @return   `some(v)`；形状不对或溢出时 `none`。
 */
fn toF64(b: slice<u8>) -> ?f64 {
  if b.len == 0 { return none }
  var i: i64 = 0
  var neg: bool = false
  if b[0] == u8(45) || b[0] == u8(43) {
    neg = b[0] == u8(45)
    i = 1
    if i == b.len { return none }
  }
  var mant: f64 = 0.0
  var scale: f64 = 1.0
  var digits: i64 = 0
  var seenDot: bool = false
  while i < b.len {
    let c: u8 = b[i]
    if c == u8(46) {
      if seenDot { return none }
      seenDot = true
      i = i + 1
      continue
    }
    if c < u8(48) || c > u8(57) { break }
    digits = digits + 1
    if seenDot { scale = scale * 10.0 }
    mant = mant * 10.0 + f64(c - u8(48))
    i = i + 1
  }
  if digits == 0 { return none }
  if scale != 1.0 { mant = mant / scale }
  var exp: i64 = 0
  if i < b.len && (b[i] == u8(101) || b[i] == u8(69)) {
    i = i + 1
    var eneg: bool = false
    if i < b.len && (b[i] == u8(45) || b[i] == u8(43)) {
      eneg = b[i] == u8(45)
      i = i + 1
    }
    var ed: i64 = 0
    var edigits: i64 = 0
    while i < b.len {
      let c: u8 = b[i]
      if c < u8(48) || c > u8(57) { return none }
      ed = ed * 10 + i64(c - u8(48))
      if ed > 400 { return none }
      edigits = edigits + 1
      i = i + 1
    }
    if edigits == 0 { return none }
    exp = ed
    if eneg { exp = 0 - ed }
  }
  if i != b.len { return none }
  var v: f64 = mant
  if exp != 0 {
    var e: i64 = exp
    if e < 0 { e = 0 - e }
    var k: i64 = 0
    var p: f64 = 1.0
    while k < e {
      p = p * 10.0
      k = k + 1
    }
    if exp < 0 { v = v / p } else { v = v * p }
  }
  if neg { v = 0.0 - v }
  return some(v)
}

/* 从一段字节**拷贝**出一个 `string`：`string::from("abc")`。
 *
 * 为什么需要它（实测）：字符串字面量的类型是 `slice<u8>`，而 extC **不做隐式转换** ——
 * 没有这一步，`var s: string = "abc"` 根本写不出来（`initializer expects string::string,
 * found slice<u8>`），起步就得 `withCap` + `append` 两行。
 *
 * 名字与语义都向 Rust 的 `String::from` 学：**显式构造**。作者口径：只加 `from`，不开特殊权限
 * （字面量不偷偷采纳上下文类型）—— 一旦开了，"哪里会发生什么"就要靠背了。
 */
fn from(b: slice<u8>) -> string {
  var r: string = withCap(i64(b.len) + 1)   /* +1：结尾那个 0 */
  r.append(b)
  return r
}

/* 从 `i64` 造一个 `string`：`string::fromI64(n)`。
 *
 * 手写数字，不碰运行期：**从负数一侧取位**（`v % 10 ≤ 0`，取反最多到 9）—— 这样 `i64` 的最小值
 * 也不会在"取绝对值"那一步溢出。位数上限 20 + 符号 + 结尾，24 字节足够。
 */
fn fromI64(n: i64) -> string {
  var tmp: [24]u8
  var i: i64 = 24
  var v: i64 = n
  if v == 0 { i = i - 1  tmp[i] = u8(48) }
  while v != 0 {
    var d: i64 = v % 10
    if d < 0 { d = 0 - d }
    i = i - 1
    tmp[i] = u8(d) + u8(48)
    v = v / 10
  }
  if n < 0 { i = i - 1  tmp[i] = u8(45) }
  /* 逐字节 push，而不是 `from(tmp[i..])`：对**局部数组**取视图再交给 `from`，逃逸分析会（保守地）
   * 以为返回值攥着那个视图 —— 实测报 "this return value would hold a reference to a local variable
   * that dies first"。`from` 其实只拷贝，但它没有声明 `effects Addr=0 Cont=0`，所以编译器必须假设最坏。
   * 走 `push` 就没有视图，问题自然不存在。 */
  var r: string = withCap(24 - i)
  var k: i64 = i
  while k < 24 { r.push(tmp[k])  k = k + 1 }
  return r
}

/* 按分隔符切分：每一段都是 `s` 的**零拷贝视图**，存放它们的数组由调用者的 arena 拥有。
 * 空分隔符没有可切的边界 ⇒ 返回空数组（不把每个字节切出来）。
 * 末尾那一段总是入列（可以为空视图）⇒ 段数 = 出现次数 + 1，`"a,b,"` 切出 3 段。
 *
 * 比较走 `string::bytesEq`：字节比较是它的专长（长度对上后循环跳过边界检查）；
 * `slice<T>::==` 现在按实例发射，写 `==` 也不会牵连别的 `T`，这里留在 bytesEq 只是为了少一层调用。 */
fn split(s: slice<u8>, sep: slice<u8>) -> varArray<slice<u8>> {
    var out: varArray<slice<u8>> = varArray<slice<u8>>::withCap(4)
    if sep.len == 0 { return out }
    var start: i64 = 0
    var i: i64 = 0
    while i + sep.len <= s.len {
        if string::bytesEq(s[i..i + sep.len], sep) {
            out.push(s[start..i])
            i = i + sep.len
            start = i
        } else {
            i = i + 1
        }
    }
    out.push(s[start..s.len])
    return out
}

/* 反过来：解析十进制 `i64`。空串、只有符号、非数字、溢出 ⇒ `none`。
 * 先按 `u64` 累加并挡住 u64 溢出，最后再按符号比边界 —— 比"边算边比 i64 边界"少一半特例。 */
fn toI64(b: slice<u8>) -> ?i64 {
  if b.len == 0 { return none }
  var i: i64 = 0
  var neg: bool = false
  if b[0] == u8(45) || b[0] == u8(43) {
    neg = b[0] == u8(45)
    i = 1
    if b.len == 1 { return none }
  }
  var acc: u64 = u64(0)
  while i < b.len {
    var c: u8 = b[i]
    if c < u8(48) || c > u8(57) { return none }
    if acc > u64(1844674407370955161) { return none }   /* acc*10 会超过 u64 */
    acc = acc * u64(10) + u64(c - u8(48))
    i = i + 1
  }
  var lim: u64 = u64(9223372036854775807)              /* 2^63-1 */
  if neg { lim = lim + u64(1) }                        /* 负数能多装一个：2^63 */
  if acc > lim { return none }
  if neg {
    /* **别写 `i64(u64(0) - acc)`**：extC 的显式转换是带检查的，`acc` 到 `2^63` 时那个转换会
     * 当场 trap（实测：`trap: value does not fit in the target type`）—— 而 `2^63` 正是
     * `i64` 最小值，是**必须**能解析的那一个。绕开它：先把 `acc-1` 落进 `i64`（≤ 2^63-1 ✓），
     * 再取负减一。 */
    /* `acc` 到 `2^63` 时直接给常量：那个值正是 `i64` 的最小值。这里不需要绕开什么（有单测覆盖
     * `i64(u64(2^63))` 不 trap）—— 只是"不碰边界"比"赌边界行为"省事，而且 `2^63` 这个值在
     * **打印**路径上确实有个 bug（见 `std::io` 里那段注释：`io::cout << i64 最小值` 会 trap）。 */
    if acc == u64(9223372036854775807) + u64(1) { return some(i64(-9223372036854775807 - 1)) }
    return some(0 - i64(acc))
  }
  return some(i64(acc))
}

/* ---------------------------------------------------------------- 裁剪与拼接
 *
 * 这两件事每天都要写：`trim` 把协议行两端的空白去掉，`join` 把 `split` 的段拼回去。它们放
 * 在这里而不是让调用者手写，是因为手写版本每次都有人写错边界（`s.len - 1`、空串、全空白）。
 *
 * `trim` 系列返回的是**原缓冲的视图**（零拷贝）：裁剪只挪起点和长度，不复制字节。
 */

/* ASCII 空白：空格、`\t`、`\n`、`\r`、`\v`、`\f`。非 ASCII 一律不算空白 —— 不猜编码。
 * 判定写在两个函数体里而不是抽成公开助手：这是库的**公开面**，一个只服务两行代码的谓词没有
 * 独立存在的价值（公开面每多一个名字都要在手册里写清语义）。 */
/* 去掉开头的空白。 */
fn trimStart(s: slice<u8>) -> slice<u8> {
    var lo: i64 = 0
    while lo < s.len && (s[lo] == u8(32) || s[lo] == u8(9) || s[lo] == u8(10) || s[lo] == u8(13) || s[lo] == u8(11) || s[lo] == u8(12)) { lo = lo + 1 }
    return s[lo..s.len]
}

/* 去掉结尾的空白。 */
fn trimEnd(s: slice<u8>) -> slice<u8> {
    var hi: i64 = s.len
    while hi > 0 && (s[hi - 1] == u8(32) || s[hi - 1] == u8(9) || s[hi - 1] == u8(10) || s[hi - 1] == u8(13) || s[hi - 1] == u8(11) || s[hi - 1] == u8(12)) { hi = hi - 1 }
    return s[0..hi]
}

/* 去掉两端的空白，返回视图。 */
fn trim(s: slice<u8>) -> slice<u8> {
    let lo = trimStart(s)
    return trimEnd(lo)
}

/* 把 `parts` 用 `sep` 连起来。空数组给空串；`sep` 可以是空视图（纯拼接）。
 *
 * 先算总长一次分配：`append` 自己会增长，但一次给够省掉中间几次搬家（`withCap(total)` 之后
 * 的 append 不再扩容）。 */
fn join(parts: slice<slice<u8>>, sep: slice<u8>) -> string {
    var total: i64 = 0
    var i: i64 = 0
    while i < parts.len {
        total = total + parts[i].len
        if i + 1 < parts.len { total = total + sep.len }
        i = i + 1
    }
    var out: string = withCap(total)
    i = 0
    while i < parts.len {
        if i > 0 { out.append(sep) }
        out.append(parts[i])
        i = i + 1
    }
    return out
}

/* `io::cout << s`：把 `string` 直接交给输出流，打印它的字节。挂在 `string` 自己这里，所以
 * `use std::text::string` 就够了，不用再 import `std::text::stringio`；`std::io` 不 import `stl`，
 * 依赖方向是 `std::text::string → std::io`，不成环。 */
@ext
impl io::ostream {
    fn <<(self: ref ostream, v: string) -> ostream { return self << v.snapshot() }
}
