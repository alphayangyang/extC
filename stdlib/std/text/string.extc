/* std/text/string.extc —— SSO 字节串（内联 16 字节，超过了才向 buf 基质要存储）
 *
 * 口径：**序列化面保持连续** —— 下游全吃 `slice<u8>`（print · IO · 哈希 · `extern!` 边界），
 * 所以这里绝不分块；**拿到内容只有 `snapshot()` 一条路（拷一份），视图不交出去**。
 *
 * 两态存储，判据**只有一个**：`cap == 0` ⟺ 内联（内容在 `small[16]u8` 里）。
 *   · **零值 = 内联空串**：合法、可用、零分配 —— `var s: string` 直接写，`isEmpty()` 为真、
 *     `capacity()` 为 0。所以这个类型可以零初始化（字段里没有裸的引用，`big` 的零值是 `none`）；
 *   · **第一次写到第 17 个字节才升级**：向 buf 基质要一片 32 字节的密排槽，把 16 个内联字节拷过去，
 *     填 `cap` / `big`。之后 `grow` 按 1.5 倍换一片更大的（旧的当场还回去，不留历代旧副本），
 *     `shrink` 换一片刚好装下的，`release`（`@drop` 钩子）把整片还回去并收成内联空串。
 *
 * **存储基质是 bufrt，不是 `buf<u8>` 字段**：≤ 64 KiB 的载荷从 16 B..64 KiB 的 13 个尺寸类里
 * 拿一个密排槽（槽与邻居共页），更大的从 2 MiB 量子的地址预留里切；归还都走同一个
 * `extc_buf_release`（按地址查类）。**为什么不直接放一个 `buf<u8>` 字段**：`buf` 内部持有
 * 非空引用（`mem: mut slice<u8>`），含引用的结构体不能零初始化，而零值 = 内联空串是全仓依赖的
 * 不变量；所以这里只借基质的四个入口（`slotReserve` / `reserve` / `span` / `release`），
 * 策略（何时长、长多少、何时还）全在本文件。
 *
 * **值语义**：`@value` + `@drop`。拷贝一律走 `clone`（深拷贝），所以两份**不共享**存储，
 * 也就没有世代这回事 —— `pStale` 恒 `false`，`pPoison` 只是防御性地收成空串。
 *
 * 内联态**不花存储、不分配**：100 万次构造 + 写一字节 + 读回
 * 实测 eager 9.35 ms · 零值惰性 14.59 ms · **SSO 0.39 ms**。
 *
 * 内联态 `capacity()` 如实回答 0（没有要过存储），但**物理上**还能再装 16 个字节 ——
 * 写入路径 `push` / `append` 先看 `n < 16` 就地写，装不下才升级。
 *
 * @code
 * use std::io
 * use std::text::string
 *
 * fn main() -> i32 {
 *     var s: string = string::withCap(8)
 *     s.append("hello")
 * }
 * @endcode
 */
use std::data::vector
use std::io
use std::sys::heap as sysheap
use std::sys::bufrt as bufrt
use std::mem as sysmem

/* 16 B..64 KiB 的尺寸类：与 buf 基质同一套（向上取到 2 的幂，下限 16）。 */
@private fn classBytes(want: i64) -> i64 {
    var c: i64 = 16
    while c < want { c = c + c }
    return c
}




@value               /* 拥有存储的值：拷贝一律深拷贝（`clone`），释放走 `@drop`。
                       * 不共享存储 ⇒ 拷贝不共用板块，也就不需要世代号：只有共享一块
                       * 存储的容器才要靠 pid/pidGen 判陈旧，值语义的 string 不在此列。 */
struct string {
    @private small:  [16]u8          /* 内联缓冲：零值 = 内联空串（零分配的合法状态） */
    @private n:      i64
    @private cap:    i64             /* 0 = 内联；!= 0 = 基质给的认领字节（槽的类字节或预留的 span） */
    @private big:    ?mut slice<u8>  /* 只有升级之后才 some —— 存一次，换片时整片还回去 */
    @private pins:   i64             /* 活着的 `borrow()` 守卫个数：> 0 时存储被冻结 */


    /* 向基质要一片存储并把 `big` / `cap` 设好。
     *
     * 两个数分得清：`cap` 是**答应给调用者的容量**（`capacity()` 就返回它，等于请求的字节数），
     * `big.len` 是基质实际给的片长（尺寸类或 2 MiB 量子的粒度，总是 >= `cap`）。归还按 `big.len`
     * 整片还，抬容量时只要还装得下就一个字节都不搬 —— 这就是尺寸类白送的原地增长。 */
    @private fn alloc(self: mut ref string, want: i64) {
        var bytes: i64 = want
        if bytes < 16 { bytes = 16 }
        if bytes <= 65536 {
            /* 小载荷走尺寸类槽：类字节就是基质实际给的片长。 */
            let cb = classBytes(bytes)
            let raw = bufrt::extc_buf_slotReserve(u64(cb))
            if raw == null { trap("string: cannot reserve storage") }
            self.big = some(sysheap::extc_viewOf(raw!, cb))
        } else {
            /* 大载荷走 2 MiB 量子的预留：片长要问基质（`span`），容量仍旧按请求报。 */
            let raw = bufrt::extc_buf_reserve(u64(bytes))
            if raw == null { trap("string: cannot reserve storage") }
            let sp = bufrt::extc_buf_span(raw!)
            var got: i64 = bytes
            if sp >= bytes { got = sp }
            self.big = some(sysheap::extc_viewOf(raw!, got))
        }
        self.cap = bytes
    }

    /* 把存储还给基质并收成内联空串。幂等（`cap` 归零之后不再动基质），所以显式
     * `s.release()` 之后编译器再跑一次 `@drop` 也没有第二次归还。 */
    @inline
    @private fn freeStorage(self: mut ref string) {
        match self.big {
            some(bk) => {
                var m: mut slice<u8> = bk
                if m.len > 0 {
                    let _r: i32 = bufrt::extc_buf_release(m.data, u64(m.len))
                }
            }
            none => { }
        }
        self.big = none
        self.cap = 0
        self.n   = 0
    }

    /* 构造器（`withCap` 的落点）。非泛型类型上 `string::new(...)` 会被读成
     * "模块 string 的函数 new"（模块名与类型名同名），所以这里叫 `create`；
     * `new` / `empty` 两个名字留给**模块级**函数（文件末尾），从模块外写才对得上。
     *
     * 语义：**要了容量就真要一片存储**（`c` 下限 16 ⇒ `capacity()` 立刻 >= 16），
     * 因为"预分配 n 字节"这句承诺不能靠内联的 16 字节兑现。SSO 省下的是**零值**与短串的
     * 默认构造，不是显式的 `withCap`。 */
    fn withCapacity(c: i64) -> string {
        var s: string
        var cc: i64 = c
        if cc < 16 { cc = 16 }
        s.alloc(cc)
        return s
    }

    @inline
    fn len(self: ref string) -> i64 { return self.n }

    @inline
    fn capacity(self: ref string) -> i64 { return self.cap }

    @inline
    fn isEmpty(self: ref string) -> bool { return self.n == 0 }

    /* **拿到内容只有这一条路：`snapshot()` —— 拷一份到调用者所在的地方。**
     *
     * 为什么没有"零拷贝视图"：那等于把**池里的东西**交出去（作者口径，：
     * 「Pool 里的东西永远不能被外面引用」），而且它本来也守不住 —— `push` 一次（可能 `grow`
     * 搬家）、`clear`（翻纪元）、`shrink`、`release` 任何一个动作都能让它失效。
     * 作者的原话最直白：「你并没有办法安全地长期持有 C++ `std::string` 的一个视图，
     * 因为我插入一下扩容一下你就完蛋了」。`snapshot` 这个名字也不容易读错（`as*` 那种
     * 命名看起来就像"给了里面的一个视图"）。
     *
     * 内联态**也照拷**：`string` 是值，`small` 就在这个结构体里 —— 交一个指向自己的视图出去，
     * 调用者一拷贝/一移动就悬垂。所以这里两条路都是"新分配 + 搬字节"，
     * 实现上 `new u8[n]` 写在方法体里，但逃逸分析会把这次分配提到**调用者**选的地方
     *（arena 的 home 机制）⇒ 它活得比这一次调用长，可以存、可以返回。 */
    
/** 借出一个只读字节视图（**不拷贝**）：`string` 因此能直接出现在收 `slice<u8>` 的参数上
     *  （自动借出看的就是这个名字与签名）。要一份独立的拷贝用 `snapshot`。 */
    fn view(self: ref string) -> slice<u8> { return self.subView(0, self.n) }

    fn snapshot(self: ref string) -> slice<u8> {
        var out: mut slice<u8> = new u8[self.n]
        copyInto<u8>(out, self.subView(0, self.n), self.n)
        return out
    }

    /* **深拷贝：要一份独立的字符串就用它。**
     *
     * `var b = a` 不是深拷贝 —— 那是结构体逐成员拷贝：内联态倒是各拿各的 16 个字节，
     * 可**升级到池之后**两份共用同一块板块（`big` 是指针被抄了一份），`b.push(...)` 会改到
     * `a` 的内容、`a.release()` 会让 `b` 悬垂。显式拷贝的代价可见（一次 O(n) 拷贝 + 最多一块新板块），
     * 新缓冲区生在调用者所在的地方。短串从这里出去仍是**内联**的：`append` 会自己按需升级。 */
    fn clone(self: ref string) -> string {
        /* 拷贝**知道自己要多大**，所以一次性要到刚好装下的容量：不经过 1.5 倍的逐级扩容。
         * 逐级扩容对拷贝是纯损失 —— 多搬 O(n) 字节，而且搬家时新旧两代同时在场的峰值
         * 会从「两份」涨到「三代」（`bench/containers/s3` 的 RSS 就是这一格的量具）。 */
        var out: string
        if self.n > 16 {
            out.alloc(self.n)
            var dst: mut slice<u8> = out.big!
            copyInto<u8>(dst[0..self.n], self.subView(0, self.n), self.n)
            out.n = self.n
            return out
        }
        out.append(self.subView(0, self.n))
        return out
    }
    
    /* ---------------------------------------------------------------- 比较与哈希
     *
     * `==` / `<` are defined per RIGHT-OPERAND type (that is how every overloadable operator in
     * extC is matched), so a string can be compared with another string and with a raw `slice<u8>`
     * alike -- the second is what makes `s == "abc"` work, since a literal is a byte slice.
     * `!=` needs no method: the operator lookup falls back to `==`. There is no implicit
     * conversion between `string` and `slice<u8>`, hence the two spellings instead of one.
     *
     * Both sides go through `subView(0, n)`: a read-only view of this value, consumed by the
     * comparison before anything can change. */
    fn ==(self: ref string, other: ref string) -> bool {
        return string::bytesEq(self.subView(0, self.n), other.subView(0, other.n))
    }

    fn ==(self: ref string, other: slice<u8>) -> bool { return string::bytesEq(self.subView(0, self.n), other) }

    fn <(self: ref string, other: ref string) -> bool {
        return string::bytesLt(self.subView(0, self.n), other.subView(0, other.n))
    }

    fn <(self: ref string, other: slice<u8>) -> bool { return string::bytesLt(self.subView(0, self.n), other) }

    /* 逐字节比较的两条循环都**跳过边界检查**（`@unchecked`，手册 12.5）。
     *
     * 范围由哪一行保证，一个用点一行 —— 这正是这个注解的规矩：指不出那一行就不许标。
     *   · `bytesEq`：上一句 `if a.len != b.len { return false }` 之后 `a.len == b.len`，
     *     循环条件又是 `i < a.len` ⇒ 两个下标同时在范围内；
     *   · `bytesLt`：循环条件自己就是 `i < a.len && i < b.len`，一人管一半。
     * 代价写在手册里：越界从此是未定义行为，不再有带位置的 trap。所以只对"长度已经对上"的
     * 字节循环成立；它们是 `string` 的 `==` / `<` 的内层，每次比较都要走一遍。 */
    @unchecked
    fn bytesEq(a: slice<u8>, b: slice<u8>) -> bool {
        if a.len != b.len { return false }
        var i: i64 = 0
        while i < a.len {
            if a[i] != b[i] { return false }
            i = i + 1
        }
        return true
    }

    @unchecked
    fn bytesLt(a: slice<u8>, b: slice<u8>) -> bool {
        var i: i64 = 0
        while i < a.len && i < b.len {
            if a[i] != b[i] { return a[i] < b[i] }
            i = i + 1
        }
        return a.len < b.len
    }

    /* FNV-1a over the bytes, folded to a non-negative i64 -- good enough for a hash table and
     * cheap: `hashMap<string, V>` needs exactly this plus `==`. */
    /* `@unchecked`：范围由循环条件 `i < v.len` 那一行保证（`v` 是本函数自己取的视图，之后不再变）。 */
    @unchecked
    fn hash(self: ref string) -> i64 {
        let v = self.subView(0, self.n)
        var h: i64 = 1469598103934665603
        var i: i64 = 0
        while i < v.len {
            h = h ^ i64(v[i])
            h = h * 1099511628211
            i = i + 1
        }
        return h & 9223372036854775807
    }

    /* ---------------------------------------------------------------- 拼接
     *
     * THREE SPELLINGS, one meaning each:
     *   - `s.append(t)` grows the receiver in place (the usual way to build a string);
     *   - `s.concat(t)` returns a NEW string, leaving the receiver alone (take any byte view,
     *     so a `string` argument is borrowed, never copied);
     *   - `s + t` is the operator spelling of the same thing (see the two `fn +` overloads
     *     below). It allocates through the same zone the concat methods use, so the operator
     *     call site needs no arena argument beyond the zone the operator path already passes.
     *
     * The result starts as a **zero value** (inline, no pool) and reaches for the pool only if the
     * concatenation does not fit in the 16 inline bytes -- a short join allocates nothing at all. */
    fn concat(self: ref string, other: slice<u8>) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        out.append(other)
        return out
    }

    /* `s + t`：拼接的运算符写法。返回**新值**、不写接收者（`+=` 不在可重载集合里）；
     * 右操作数按类型重载 —— `slice<u8>`（字面量与视图）、`ref string`（**借**，不拷接收者）、
     * 数字与布尔。分配落在
     * 调用点给的 arena 上（运算符调用点现在与方法调用点走同一套 home/zone 记账）。 */
    fn +(self: ref string, other: slice<u8>) -> string { return self.concat(other) }

    fn +(self: ref string, other: ref string) -> string { return self.concat(other.view()) }

    /* 数字与布尔值的运算符重载：`"a=" + n` 直接得到字符串（值形式的 f-string 就靠这一组
     * 脱糖）。走的是"复制接收者 + 追加"的朴素路径，与 `appendI64` 一样不为数字多写一层
     * 临时视图。整数按位宽各一份 —— 运算符重载按右操作数的静态类型精确选，没有隐式加宽。 */
    fn +(self: ref string, other: i64) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: i32) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: i16) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: i8) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: u32) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: u16) -> string { return self.pNumeric(i64(other)) }
    fn +(self: ref string, other: u8) -> string { return self.pNumeric(i64(other)) }
    /* `u64` gets its own path: its upper half has no `i64` value, so widening to `i64`
     * would print the wrong number. `appendU64` prints the unsigned decimal. */
    fn +(self: ref string, other: u64) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        out.appendU64(other)
        return out
    }

    fn +(self: ref string, other: bool) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        if other { out.append("true") } else { out.append("false") }
        return out
    }

    /* 复制接收者再追加一个十进制数字：`+` 的数字重载共用这一条。 */
    fn pNumeric(self: ref string, v: i64) -> string {
        var out: string
        out.append(self.subView(0, self.n))
        out.appendI64(v)
        return out
    }

    /* ---------------------------------------------------------------- 取字节与视图 */
    /* One byte, or `none` when out of range (no trap: reading past the end is a condition). */
    fn at(self: ref string, i: i64) -> ?u8 {
        if i < 0 || i >= self.n { return none }
        if self.cap == 0 { return some(self.small[i]) }
        return some(self.big![i])
    }

    /* A zero-copy view of [lo, hi). Bounds are clamped, so a bad range gives an empty view rather
     * than reading past the buffer. */
    /* A substring: **a copy**.
     *
     * A zero-copy view into the pool plate cannot be defended: `push` / `append` grow the
     * string by replacing the block (the old one goes back to the pool), so the view dangles
     * the moment the string changes, and the checker cannot see it. It is the same shape
     * `snapshot` above already documents, and states the rule: a view into a pool
     * plate has nothing to lean on.
     *
     * The copy lands where the **caller** chose (`new` plus the escape analysis's home arena),
     * so the result may be stored and returned like any other value.
     *
     * Need zero copy? `subView` below, and sign for it. */
    fn sub(self: ref string, lo: i64, hi: i64) -> slice<u8> {
        var a: i64 = lo
        var b: i64 = hi
        if a < 0 { a = 0 }
        if b > self.n { b = self.n }
        if b < a { b = a }
        var out: mut slice<u8> = new u8[b - a]
        copyInto<u8>(out, self.subView(a, b), b - a)
        return out
    }

    /* A zero-copy view -- valid **only while the string is not changed**.
     *
     * Growing the string (`push` / `append`) replaces the block, and the view dangles at once;
     * the checker cannot see that, because it is not a lifetime question but a "the block was
     * replaced" one. This is the same category as `!` and `extern!`: you sign, you own it.
     * Use `sub` unless a profile says otherwise.
     *
     * SSO adds one wrinkle to that contract for the INLINE case: the view then points into the
     * string value itself (`small`), so it is also invalidated by **copying / moving the string**
     * -- the escape checker does catch the lifetime half (a view of a local cannot escape its
     * block), but the "the value was copied" half is still a signature. In the pool case nothing
     * changed: the view points at the plate. */
    fn subView(self: ref string, lo: i64, hi: i64) -> slice<u8> {
        var a: i64 = lo
        var b: i64 = hi
        if a < 0 { a = 0 }
        if b > self.n { b = self.n }
        if b < a { b = a }
        if self.cap == 0 { return self.small[a..b] }
        return self.big![a..b]
    }

    /* 文本视图方法的接收者版本：`string` 上 `s.trim()` 与 `s[..].trim()` 等价。
     * 实现仍只有一份（`trim`/`trimStart`/`trimEnd`/`split` 自由函数），这里只转走视图。 */
    fn trim(self: ref string) -> slice<u8> { return self.subView(0, self.n).trim() }

    fn trimStart(self: ref string) -> slice<u8> { return self.subView(0, self.n).trimStart() }

    fn trimEnd(self: ref string) -> slice<u8> { return self.subView(0, self.n).trimEnd() }

    fn split(self: ref string, sep: slice<u8>) -> vector<slice<u8>> {
        return split(self.subView(0, self.n), sep)
    }

    /* ---------------------------------------------------------------- 子串查找：交给运行期
     *
     * WHY NOT Two-Way IN extC (it was here, and it was correct -- `tests/stl/stringFind.extc`
     * exhaustive cross-check is what proved it): the algorithm was fine, the *cost model* was not.
     * Every byte of the haystack went through `hay[i]`, and every subscript paid the boundary
     * check the language promises. callgrind on a reduced probe: **25.5 instructions per byte**,
     * 30% of them concentrated in the single line
     * `if (i < 0 || i >= v.len) extc_trap(file, line, ...)`.
     *
     * The measurement, from `bench/string_vs_cpp/` (10,000 patterns of 4..15 bytes, half of them
     * absent, on a 1 MB string): `find` took 3172.7 ms against libstdc++'s 138.8 ms, and the two
     * things libstdc++ has that a byte-at-a-time extC loop does not are `memchr`/`memcmp` being
     * vectorised and the absence of a per-byte check. So the search is handed to libc's `memmem`
     * (two-way inside glibc, with a `memchr` first-byte scan), through `std::mem` -- the
     * same door `read`/`write` go through, integers only, on the byte-search runtime
     * (`src/back/memfind.c`, emitted on demand).
     *
     * THE CONTRACT IS UNCHANGED, and `tests/stl/stringFind.extc` still checks it exhaustively:
     * first (leftmost) match, `none` when absent, `some(0)` for the empty pattern, `none` when
     * the pattern is longer than the string, and a self-overlapping pattern (`aa` in `aaaa`)
     * still answers 0. `memmem` returns the leftmost match, which is exactly the promise. */
    fn find(self: ref string, needle: slice<u8>) -> ?i64 {
        let m = self.n
        let n = needle.len
        if n == 0 { return some(0) }
        if n > m { return none }
        let hay = self.subView(0, m)
        /* `hay.data` is the first byte, `needle.data` the first pattern byte; `m` is the whole
         * string and `n <= m` holds from the line above, so the runtime sees a range it can use. */
        let r = std::mem::extc_memFind(hay.data, m, needle.data, n)
        if r < 0 { return none }
        return some(r)
    }

    fn contains(self: ref string, needle: slice<u8>) -> bool {
        let at = self.find(needle) ?? -1      /* a found offset is never negative */
        return at >= 0
    }

    /* `startsWith` / `endsWith` are one `memcmp` (through the runtime's integer door --
     * `memcmp` itself cannot be declared in extC: its `const void *` / `size_t` parameters
     * cannot be spelled here, so a hand-written declaration cannot agree with `<string.h>`,
     * which the generated C includes).
     *
     * Both take a prefix/suffix view first, so the lengths on the two sides of the compare are
     * equal by construction: `subView(0, p.len)` clamps to `self.n`, and the `p.len > self.n`
     * guard above means no clamping happens. The empty pattern compares nothing and is true. */
    fn startsWith(self: ref string, p: slice<u8>) -> bool {
        if p.len > self.n { return false }
        if p.len == 0 { return true }
        let v = self.subView(0, p.len)
        return std::mem::extc_memEq(v.data, p.data, p.len) == 1
    }

    fn endsWith(self: ref string, p: slice<u8>) -> bool {
        if p.len > self.n { return false }
        if p.len == 0 { return true }
        let off = self.n - p.len
        let v = self.subView(off, self.n)
        return std::mem::extc_memEq(v.data, p.data, p.len) == 1
    }

    /* 冻结位：有活着的借用时改存储身份是**确定性错误**，不是未定义行为。 */
    @private
    fn frozen(self: ref string) {
        trap("this string is frozen by a live borrow")
    }

    /* 借出守卫：活着的时候字符串不许换块/释放（跨函数借出时静态检查看不见增长）。 */
    fn borrow(self: mut ref string) -> stringGuard {
        self.pins = self.pins + 1
        return { s: self, p: ref self.pins }
    }

    /* 换一片更大的：新旧同时在场，拷完就把旧的还回去 —— 所以瞬时内存是"一份 + 一块"，
     * 不是"历代旧副本"。增长按 1.5 倍（连续性与摊还同时成立）。
     *
     * SSO：`cap == 0` 时这一步是**升级**，不是扩容 —— 要一片 32 字节的密排槽、把 16 个内联
     * 字节拷进去。之后才走 1.5 倍那条路。两条路的纪律是同一条：换片时旧片当场还回去。 */
    fn grow(self: mut ref string) {
        if self.pins > 0 { self.frozen() }
        if self.cap == 0 {
            self.alloc(32)
            var dst: mut slice<u8> = self.big!
            copyInto<u8>(dst[0..16], self.small[0..16], 16)
            return
        }
        var want: i64 = self.cap + self.cap / 2
        if want <= self.cap { want = self.cap + 16 }
        /* 片长通常比 `cap` 大（尺寸类）：装得下就只抬 `cap`，一个字节都不搬。 */
        var have: i64 = 0
        match self.big {
            some(bk) => {
                var m: mut slice<u8> = bk
                have = m.len
            }
            none => { }
        }
        if want <= have {
            self.cap = want
            return
        }
        let keep: i64 = self.n
        var oldSlice: mut slice<u8> = self.big!
        let old: i64 = oldSlice.len
        self.big = none
        self.cap = 0
        self.alloc(want)
        if keep > 0 {
            let k = keep
            var dst: mut slice<u8> = self.big!
            copyInto<u8>(dst[0..k], oldSlice[0..k], k)
        }
        let _r: i32 = bufrt::extc_buf_release(oldSlice.data, u64(old))
    }

    fn push(self: mut ref string, b: u8) {
        if self.pStale() { self.pPoison() }
        if self.cap == 0 && self.n < 16 {
            self.small[self.n] = b
            self.n = self.n + 1
            return
        }
        if self.n >= self.cap { self.grow() }
        /* 走到这里 `cap != 0` ⇒ 池态。逐字节的热路径直接取载荷（`!` 是"调用者签字"，
         * 不生成标签检查）：`match` 每字节都要拷一次切片值，实测 10M 次 push 慢 2–3×
         * （bench/stl/string.extc）。不变式由本文件维持 —— 五个改动点
         * （`create` / `grow` / `pPoison` / `release` / 这里的 `grow`）都同时设 `cap` 与 `big`；
         * 若有人手工拼一个 `{ cap: 8 }`（`big` 为零值 `none`），载荷是零值切片
         * ⇒ 下标写带位置 trap，而不是野指针。 */
        self.big![self.n] = b
        self.n = self.n + 1
    }

    /* 追加一段字节（"序列化面"最常见的一步）。
     *
     * **一次 `copyInto`，不是逐字节 `push`**：`push` 每来一个字节都要做一次陈旧池守卫
     * （`pStale()` = 池世代的加载+比较，实测约 1 cycle/字节）与一次容量检查。批量做就只付一次
     * —— 这正是 `bench/app` 场景 C 里那 28% 的来源（DEVLOG 第十一段续八）。
     *
     * SSO：装得下 16 个内联字节就地写（**一个池都不建**）；装不下先 `grow` 升级再搬。 */
    /* 复合赋值的语句级钩子：`s += x` 就地追加，不建中间值。`+` 必须造一个新字符串（它是值），
     * 所以 `s = s + x` 每轮都会留下上一份存储；用 `+=` 就是摊还 O(|x|)、零垃圾。语义与默认脱
     * 糖（`s = s + x`）相同，只是不经过临时量。右操作数按类型各一份，与 `+` 的重载集对齐。 */
    fn +=(self: mut ref string, other: slice<u8>) { self.append(other) }
    fn +=(self: mut ref string, other: ref string) { self.append(other.view()) }
    fn +=(self: mut ref string, other: i64) { self.appendI64(other) }
    fn +=(self: mut ref string, other: u64) { self.appendU64(other) }
    fn +=(self: mut ref string, other: f64) { self.appendF64(other, 6) }
    fn append(self: mut ref string, s: slice<u8>) {
        if self.pStale() { self.pPoison() }
        if s.len <= 0 { return }
        let need: i64 = self.n + s.len
        if self.cap == 0 && need <= 16 {
            copyInto<u8>(self.small[self.n..need], s, s.len)
            self.n = need
            return
        }
        while self.cap < need { self.grow() }
        match self.big {
            some(bk) => {
                var w: mut slice<u8> = bk
                copyInto<u8>(w[self.n..need], s, s.len)
            }
            none => { }
        }
        self.n = need
    }

    /* 丢掉最前面的 `n` 个字节（有界缓冲「丢掉最老的一半」就是这个）。
     * 一次 `memmove`（区间重叠，所以必须是 move 不是 copy）。 */
    fn removeFront(self: mut ref string, n: i64) {
        if self.pStale() { self.pPoison() }
        if n <= 0 { return }
        var k: i64 = n
        if k > self.n { k = self.n }
        let keep: i64 = self.n - k
        if self.cap == 0 {
            copyInto<u8>(self.small[0..keep], self.small[k..self.n], keep)
            self.n = keep
            return
        }
        match self.big {
            some(bk) => {
                var w: mut slice<u8> = bk
                copyInto<u8>(w[0..keep], w[k..self.n], keep)
            }
            none => { }
        }
        self.n = keep
    }

    /* 把 `[lo, hi)` 这一段删掉（后面的字节往前挪）。越界夹到边界，不 trap：删除是缩小操作，
     * 夹边界不会产生悬垂。返回删掉的字节数。 */
    fn erase(self: mut ref string, lo: i64, hi: i64) -> i64 {
        if self.pStale() { self.pPoison() }
        var a: i64 = lo
        var b: i64 = hi
        if a < 0 { a = 0 }
        if b > self.n { b = self.n }
        if a >= b { return 0 }
        let gone: i64 = b - a
        let keep: i64 = self.n - b
        if self.cap == 0 {
            copyInto<u8>(self.small[a..a + keep], self.small[b..self.n], keep)
            self.n = a + keep
            return gone
        }
        match self.big {
            some(bk) => {
                var w: mut slice<u8> = bk
                copyInto<u8>(w[a..a + keep], w[b..self.n], keep)
            }
            none => { }
        }
        self.n = a + keep
        return gone
    }

    /* 在 `at` 处插入一段字节（`at` 夹到 `[0, n]`；插在末尾等价于 append）。 */
    fn insert(self: mut ref string, at: i64, s: slice<u8>) {
        if self.pStale() { self.pPoison() }
        var p: i64 = at
        if p < 0 { p = 0 }
        if p > self.n { p = self.n }
        let add: i64 = s.len
        if add == 0 { return }
        let need: i64 = self.n + add
        if self.cap == 0 && need <= 16 {
            var j: i64 = self.n - 1
            while j >= p {
                self.small[j + add] = self.small[j]
                j = j - 1
            }
            var k: i64 = 0
            while k < add {
                self.small[p + k] = s[k]
                k = k + 1
            }
            self.n = need
            return
        }
        while self.cap < need { self.grow() }
        match self.big {
            some(bk) => {
                var w: mut slice<u8> = bk
                var j: i64 = self.n - 1
                while j >= p {
                    w[j + add] = w[j]
                    j = j - 1
                }
                var k: i64 = 0
                while k < add {
                    w[p + k] = s[k]
                    k = k + 1
                }
                self.n = need
            }
            none => { }
        }
    }

    /* 把所有出现的 `needle` 换成 `with`，返回替换次数。
     *
     * 长度不变时原地改写（不分配）；长度变了就在一份新串里重建再整体搬回来 —— 原地做的话每次
     * 替换都要挪尾巴，总代价 O(n·次数)。空模式返回 0（否则"每个位置插一次"没有明确语义）。 */
    fn replace(self: mut ref string, needle: slice<u8>, with: slice<u8>) -> i64 {
        let nl: i64 = needle.len
        if nl == 0 { return 0 }
        var count: i64 = 0
        var start: i64 = 0
        if nl == with.len {
            while start <= self.n - nl {
                match self.findFrom(start, needle) {
                    some(at) => {
                        var k: i64 = 0
                        while k < nl { self.sSet(at + k, with[k])  k = k + 1 }
                        count = count + 1
                        start = at + nl
                    }
                    none => { break }
                }
            }
            return count
        }
        var out: string = string::withCapacity(self.n)
        start = 0
        while true {
            match self.findFrom(start, needle) {
                some(at) => {
                    out.append(self.subView(start, at))
                    out.append(with)
                    count = count + 1
                    start = at + nl
                }
                none => {
                    out.append(self.subView(start, self.n))
                    break
                }
            }
        }
        self.clear()
        self.append(out.view())
        return count
    }

    /* 只换第一处；找不到返回 false。 */
    fn replaceFirst(self: mut ref string, needle: slice<u8>, with: slice<u8>) -> bool {
        let nl: i64 = needle.len
        if nl == 0 { return false }
        match self.find(needle) {
            some(at) => {
                self.erase(at, at + nl)
                self.insert(at, with)
                return true
            }
            none => { return false }
        }
    }

    /* 从 `start` 开始找（`find` 的定位版）。`start` 夹到 `[0, n]`。 */
    fn findFrom(self: ref string, start: i64, needle: slice<u8>) -> ?i64 {
        var f: i64 = start
        if f < 0 { f = 0 }
        if f > self.n { return none }
        let n: i64 = needle.len
        if n == 0 { return some(f) }
        let hay = self.subView(f, self.n)
        if n > hay.len { return none }
        let r = std::mem::extc_memFind(hay.data, hay.len, needle.data, n)
        if r < 0 { return none }
        return some(f + r)
    }

    /* 最后一次出现的位置。朴素地从右往左滑（字节串没有反向跳表）。 */
    fn rfind(self: ref string, needle: slice<u8>) -> ?i64 {
        let nl: i64 = needle.len
        if nl == 0 { return some(self.n) }
        if nl > self.n { return none }
        var i: i64 = self.n - nl
        while i >= 0 {
            if std::mem::extc_memEq(self.subView(i, i + nl).data, needle.data, nl) == 1 {
                return some(i)
            }
            i = i - 1
        }
        return none
    }

    /* `needle` 不重叠出现的次数。 */
    fn count(self: ref string, needle: slice<u8>) -> i64 {
        let nl: i64 = needle.len
        if nl == 0 { return 0 }
        var found: i64 = 0
        var start: i64 = 0
        while true {
            match self.findFrom(start, needle) {
                some(at) => {
                    found = found + 1
                    start = at + nl
                }
                none => { break }
            }
        }
        return found
    }

    /* ASCII 大小写（原地）：只动 `a`–`z` / `A`–`Z`。`string` 是字节串，Unicode 折叠需要表，
     * 那是别的模块的事。 */
    fn toUpper(self: mut ref string) {
        if self.pStale() { self.pPoison() }
        var i: i64 = 0
        while i < self.n {
            let b = self.sByte(i)
            if b >= u8(97) && b <= u8(122) { self.sSet(i, u8(i64(b) - 32)) }
            i = i + 1
        }
    }

    fn toLower(self: mut ref string) {
        if self.pStale() { self.pPoison() }
        var i: i64 = 0
        while i < self.n {
            let b = self.sByte(i)
            if b >= u8(65) && b <= u8(90) { self.sSet(i, u8(i64(b) + 32)) }
            i = i + 1
        }
    }

    /* 写下标一个字节（`at` 的写版）；越界返回 `false`，和"读越界是条件"对称。 */
    fn setAt(self: mut ref string, i: i64, b: u8) -> bool {
        if self.pStale() { self.pPoison() }
        if i < 0 || i >= self.n { return false }
        self.sSet(i, b)
        return true
    }

    /* 内部：读/写一个字节，调用方已确认 `i` 在 `[0, n)`。 */
    @private fn sByte(self: ref string, i: i64) -> u8 {
        if self.cap == 0 { return self.small[i] }
        return self.big![i]
    }

    @private fn sSet(self: mut ref string, i: i64, b: u8) {
        if self.cap == 0 { self.small[i] = b  return }
        self.big![i] = b
    }

    fn appendByte(self: mut ref string, b: u8) { self.push(b) }

    /* 十进制整数的追加：`s.appendI64(n)`。与 `s.append(str::fromI64(n).snapshot())` 的区别是
     * 中间那个临时 `string` 不出现 —— 拼日志/报表时不必为"数字"多写一层转换，
     * 也不会踩到"切临时值的视图"的借用规则。负数带 `-`，`i64` 最小值按无符号处理不会溢出。 */
    fn appendI64(self: mut ref string, v: i64) {
        /* Digits are produced into a stack buffer and appended in one go: going through
         * `fromI64` would build a throwaway `string` per number (one object, one length
         * computation, one borrow-checked view) and that is the whole cost when a program is
         * appending ids in a loop. 20 bytes is the widest `i64` plus a sign. */
        var buf: [21]u8
        var neg: bool = false
        var x: u64 = u64(v)
        if v < 0 {
            neg = true
            x = u64(0) - u64(v)
        }
        var k: i64 = 0
        if x == u64(0) {
            buf[k] = u8(48)
            k = k + 1
        } else {
            while x > u64(0) {
                buf[k] = u8(48 + i64(x % u64(10)))
                x = x / u64(10)
                k = k + 1
            }
        }
        var out: [21]u8
        var at: i64 = 0
        if neg {
            out[at] = u8(45)
            at = at + 1
        }
        var j: i64 = k - 1
        while j >= 0 {
            out[at] = buf[j]
            at = at + 1
            j = j - 1
        }
        self.append(out[0..at])
    }

    /* 十进制无符号整数的追加：`s.appendU64(n)`。`i64` 的重载够不到 `u64` 的上半
     * 段（> 2^63-1），所以这里按无符号除法取位；`+` 与 `+=` 的 `u64` 重载共用这一条。 */
    fn appendU64(self: mut ref string, v: u64) {
        var buf: [20]u8
        var x: u64 = v
        var k: i64 = 0
        if x == u64(0) {
            buf[k] = u8(48)
            k = k + 1
        } else {
            while x > u64(0) {
                buf[k] = u8(48 + i64(x % u64(10)))
                x = x / u64(10)
                k = k + 1
            }
        }
        var out: [20]u8
        var j: i64 = k - 1
        var at: i64 = 0
        while j >= 0 {
            out[at] = buf[j]
            at = at + 1
            j = j - 1
        }
        self.append(out[0..at])
    }

    /* 换一片刚好装下的（下限 16）；连续性与字节不变。
     *
     * 内联态（`cap == 0`）没有可缩的：它本来就只占 16 字节，而且"下限 16"这条承诺
     * 与内联缓冲等大 —— 有存储的缩到 16 之后仍然有存储，不往回退（退回内联会让 `capacity()`
     * 从 16 掉到 0，那是另一个语义）。 */
    fn shrinkToFit(self: mut ref string) {
        if self.cap == 0 { return }
        var want: i64 = self.n
        if want < 16 { want = 16 }
        if want >= self.cap { return }
        var have: i64 = 0
        match self.big {
            some(bk) => {
                var m: mut slice<u8> = bk
                have = m.len
            }
            none => { }
        }
        /* 只有片比需要的容量大一倍以上才真搬家还内存：跨一个尺寸类边界就搬一次的话，
         * `shrink()` 每调用一次都要付一次拷贝，而换回来的常常是零字节。 */
        if have <= want * 2 {
            self.cap = want
            return
        }
        let keep: i64 = self.n
        var oldSlice: mut slice<u8> = self.big!
        let old: i64 = oldSlice.len
        self.big = none
        self.cap = 0
        self.alloc(want)
        if keep > 0 {
            var dst: mut slice<u8> = self.big!
            copyInto<u8>(dst[0..keep], oldSlice[0..keep], keep)
        }
        let _r: i32 = bufrt::extc_buf_release(oldSlice.data, u64(old))
    }

    fn clear(self: mut ref string) { self.n = 0 }

    /* **守卫**：这一份容器值还指着它的存储吗？
     *
     * 值语义之后没有"共享一块存储"这件事：拷贝都是深拷贝（`clone`），释放只影响自己，
     * 所以答案恒为 `false`。名字与调用点留着（每个 mutator 都问一次），这样"陈旧"这个概念
     * 从实现里彻底消失时，调用点不需要跟着改一遍。 */
    fn pStale(self: ref string) -> bool { return false }

    /* 收成**零值**（内联空串）：把存储还给基质。陈旧不再出现，这里是防御性入口 ——
     * 万一将来又出现共享，走这一条至少不会写已归还的内存。 */
    fn pPoison(self: mut ref string) { self.freeStorage() }

    /* 释放存储并收成内联空串；`@drop` 钩子（离开作用域、以及每份拷贝各自结束时）走这里。
     * 显式调用也合法：之后这个字符串就是空串，读它不再需要"记得它会 trap"。 */
    @drop
    fn release(self: mut ref string) {
        if self.pins > 0 { self.frozen() }
        self.freeStorage()
    }

}

/* 模块级构造器。
 *
 * 为什么需要它们：模块名与类型名同名（`stl/string.extc` 里的 `string`）时，
 * `string::new(c)` 会被读成"模块 string 的函数 new"，`string(c)` 也解析不到类型
 * （两条路都要消歧）。泛型容器没这个问题 —— `vector<i32>::new()` 的 `<>` 就消歧了。
 * 这里用"模块级函数"这条路：`withCap(n)` 明确是模块导出的函数。
 *
 * 所以：**要容量用 `withCap(n)`；要空串用 `new()` / `empty()`；零值 `var s: string` 也对**。
 * `new()` / `empty()` 与零值完全等价（内联、零分配、`capacity() == 0`）——
 * 它们存在只是为了让手册里那句 `new()` 真的能用（此前只有类型上的 `new(c)`，
 * 从模块外写 `new()` 根本不存在）。 */
fn withCap(c: i64) -> string { return string::withCapacity(c) }
fn new() -> string { var s: string  return s }
fn empty() -> string { var s: string  return s }

/**
 * @brief 把十进制文本解析成 `f64`：`[+-]digits[.digits][(e|E)[+-]digits]`。
 *
 * 与 `toI64` 同一条路：先在这里判定形状，不合形状一律 `none`（调用者用 `??` 兜底）。
 * 不做 `inf`/`nan`/十六进制浮点，也不接受单独的小数点开头（`.5`）—— 要那样写就补个 `0`。
 * 尾数逐位累进 `f64`，指数逐次乘/除 10（不调 `pow`）：常见输入上与 printf 解析一致，
 * 极端位数会有末位差别，文档里写明。
 *
 * @param b  待解析的字节视图。
 * @return   `some(v)`；形状不对或溢出时 `none`。
 */
fn toF64(b: slice<u8>) -> ?f64 {
  if b.len == 0 { return none }
  var i: i64 = 0
  var neg: bool = false
  if b[0] == u8(45) || b[0] == u8(43) {
    neg = b[0] == u8(45)
    i = 1
    if i == b.len { return none }
  }
  var mant: f64 = 0.0
  var scale: f64 = 1.0
  var digits: i64 = 0
  var seenDot: bool = false
  while i < b.len {
    let c: u8 = b[i]
    if c == u8(46) {
      if seenDot { return none }
      seenDot = true
      i = i + 1
      continue
    }
    if c < u8(48) || c > u8(57) { break }
    digits = digits + 1
    if seenDot { scale = scale * 10.0 }
    mant = mant * 10.0 + f64(c - u8(48))
    i = i + 1
  }
  if digits == 0 { return none }
  if scale != 1.0 { mant = mant / scale }
  var exp: i64 = 0
  if i < b.len && (b[i] == u8(101) || b[i] == u8(69)) {
    i = i + 1
    var eneg: bool = false
    if i < b.len && (b[i] == u8(45) || b[i] == u8(43)) {
      eneg = b[i] == u8(45)
      i = i + 1
    }
    var ed: i64 = 0
    var edigits: i64 = 0
    while i < b.len {
      let c: u8 = b[i]
      if c < u8(48) || c > u8(57) { return none }
      ed = ed * 10 + i64(c - u8(48))
      if ed > 400 { return none }
      edigits = edigits + 1
      i = i + 1
    }
    if edigits == 0 { return none }
    exp = ed
    if eneg { exp = 0 - ed }
  }
  if i != b.len { return none }
  var v: f64 = mant
  if exp != 0 {
    var e: i64 = exp
    if e < 0 { e = 0 - e }
    var k: i64 = 0
    var p: f64 = 1.0
    while k < e {
      p = p * 10.0
      k = k + 1
    }
    if exp < 0 { v = v / p } else { v = v * p }
  }
  if neg { v = 0.0 - v }
  return some(v)
}

/* 从一段字节**拷贝**出一个 `string`：`from("abc")`。
 *
 * 为什么需要它（实测）：字符串字面量的类型是 `slice<u8>`，而 extC **不做隐式转换** ——
 * 没有这一步，`var s: string = "abc"` 根本写不出来（`initializer expects string::string,
 * found slice<u8>`），起步就得 `withCap` + `append` 两行。
 *
 * 名字与语义都向 Rust 的 `String::from` 学：**显式构造**。作者口径：只加 `from`，不开特殊权限
 * （字面量不偷偷采纳上下文类型）—— 一旦开了，"哪里会发生什么"就要靠背了。
 */
fn from(b: slice<u8>) -> string {
  var r: string = withCap(i64(b.len) + 1)   /* +1：结尾那个 0 */
  r.append(b)
  return r
}

/* 从 `i64` 造一个 `string`：`fromI64(n)`。
 *
 * 手写数字，不碰运行期：**从负数一侧取位**（`v % 10 ≤ 0`，取反最多到 9）—— 这样 `i64` 的最小值
 * 也不会在"取绝对值"那一步溢出。位数上限 20 + 符号 + 结尾，24 字节足够。
 */
fn fromI64(n: i64) -> string {
  var tmp: [24]u8
  var i: i64 = 24
  var v: i64 = n
  if v == 0 { i = i - 1  tmp[i] = u8(48) }
  while v != 0 {
    var d: i64 = v % 10
    if d < 0 { d = 0 - d }
    i = i - 1
    tmp[i] = u8(d) + u8(48)
    v = v / 10
  }
  if n < 0 { i = i - 1  tmp[i] = u8(45) }
  /* 逐字节 push，而不是 `from(tmp[i..])`：对**局部数组**取视图再交给 `from`，逃逸分析会（保守地）
   * 以为返回值攥着那个视图 —— 实测报 "this return value would hold a reference to a local variable
   * that dies first"。`from` 其实只拷贝，但它没有声明 `effects Addr=0 Cont=0`，所以编译器必须假设最坏。
   * 走 `push` 就没有视图，问题自然不存在。 */
  var r: string = withCap(24 - i)
  var k: i64 = i
  while k < 24 { r.push(tmp[k])  k = k + 1 }
  return r
}

/* 从 `u64` 造一个 `string`：`fromU64(n)`。与 `fromI64` 成对，覆盖无符号的上半段
 * （> 2^63-1）—— 那里的值没有 `i64` 表示，不能借道有符号版本。 */
fn fromU64(n: u64) -> string {
  var r: string = withCap(20)
  r.appendU64(n)
  return r
}

/* 按分隔符切分：每一段都是 `s` 的**零拷贝视图**，存放它们的数组由调用者的 arena 拥有。
 * 空分隔符没有可切的边界 ⇒ 返回空数组（不把每个字节切出来）。
 * 末尾那一段总是入列（可以为空视图）⇒ 段数 = 出现次数 + 1，`"a,b,"` 切出 3 段。
 *
 * 比较走 `string::bytesEq`：字节比较是它的专长（长度对上后循环跳过边界检查）；
 * `slice<T>::==` 现在按实例发射，写 `==` 也不会牵连别的 `T`，这里留在 bytesEq 只是为了少一层调用。 */
fn split(s: slice<u8>, sep: slice<u8>) -> vector<slice<u8>> {
    var out: vector<slice<u8>> = vector<slice<u8>>::withCap(4)
    if sep.len == 0 { return out }
    var start: i64 = 0
    var i: i64 = 0
    while i + sep.len <= s.len {
        if string::bytesEq(s[i..i + sep.len], sep) {
            out.push(s[start..i])
            i = i + sep.len
            start = i
        } else {
            i = i + 1
        }
    }
    out.push(s[start..s.len])
    return out
}

/* 反过来：解析十进制 `i64`。空串、只有符号、非数字、溢出 ⇒ `none`。
 * 先按 `u64` 累加并挡住 u64 溢出，最后再按符号比边界 —— 比"边算边比 i64 边界"少一半特例。 */
fn toI64(b: slice<u8>) -> ?i64 {
  if b.len == 0 { return none }
  var i: i64 = 0
  var neg: bool = false
  if b[0] == u8(45) || b[0] == u8(43) {
    neg = b[0] == u8(45)
    i = 1
    if b.len == 1 { return none }
  }
  var acc: u64 = u64(0)
  while i < b.len {
    var c: u8 = b[i]
    if c < u8(48) || c > u8(57) { return none }
    if acc > u64(1844674407370955161) { return none }   /* acc*10 会超过 u64 */
    acc = acc * u64(10) + u64(c - u8(48))
    i = i + 1
  }
  var lim: u64 = u64(9223372036854775807)              /* 2^63-1 */
  if neg { lim = lim + u64(1) }                        /* 负数能多装一个：2^63 */
  if acc > lim { return none }
  if neg {
    /* **别写 `i64(u64(0) - acc)`**：extC 的显式转换是带检查的，`acc` 到 `2^63` 时那个转换会
     * 当场 trap（实测：`trap: value does not fit in the target type`）—— 而 `2^63` 正是
     * `i64` 最小值，是**必须**能解析的那一个。绕开它：先把 `acc-1` 落进 `i64`（≤ 2^63-1 ✓），
     * 再取负减一。 */
    /* `acc` 到 `2^63` 时直接给常量：那个值正是 `i64` 的最小值。这里不需要绕开什么（有单测覆盖
     * `i64(u64(2^63))` 不 trap）—— 只是"不碰边界"比"赌边界行为"省事，而且 `2^63` 这个值在
     * **打印**路径上确实有个 bug（见 `std::io` 里那段注释：`io::cout << i64 最小值` 会 trap）。 */
    if acc == u64(9223372036854775807) + u64(1) { return some(i64(-9223372036854775807 - 1)) }
    return some(0 - i64(acc))
  }
  return some(i64(acc))
}

/* ---------------------------------------------------------------- 裁剪与拼接
 *
 * 这两件事每天都要写：`trim` 把协议行两端的空白去掉，`join` 把 `split` 的段拼回去。它们放
 * 在这里而不是让调用者手写，是因为手写版本每次都有人写错边界（`s.len - 1`、空串、全空白）。
 *
 * `trim` 系列返回的是**原缓冲的视图**（零拷贝）：裁剪只挪起点和长度，不复制字节。
 */

/* ASCII 空白：空格、`\t`、`\n`、`\r`、`\v`、`\f`。非 ASCII 一律不算空白 —— 不猜编码。
 * 判定写在两个函数体里而不是抽成公开助手：这是库的**公开面**，一个只服务两行代码的谓词没有
 * 独立存在的价值（公开面每多一个名字都要在手册里写清语义）。 */
/* 去掉开头的空白。 */
fn trimStart(s: slice<u8>) -> slice<u8> {
    var lo: i64 = 0
    while lo < s.len && (s[lo] == u8(32) || s[lo] == u8(9) || s[lo] == u8(10) || s[lo] == u8(13) || s[lo] == u8(11) || s[lo] == u8(12)) { lo = lo + 1 }
    return s[lo..s.len]
}

/* 去掉结尾的空白。 */
fn trimEnd(s: slice<u8>) -> slice<u8> {
    var hi: i64 = s.len
    while hi > 0 && (s[hi - 1] == u8(32) || s[hi - 1] == u8(9) || s[hi - 1] == u8(10) || s[hi - 1] == u8(13) || s[hi - 1] == u8(11) || s[hi - 1] == u8(12)) { hi = hi - 1 }
    return s[0..hi]
}

/* 去掉两端的空白，返回视图。 */
fn trim(s: slice<u8>) -> slice<u8> {
    let lo = trimStart(s)
    return trimEnd(lo)
}

/* 把 `parts` 用 `sep` 连起来。空数组给空串；`sep` 可以是空视图（纯拼接）。
 *
 * 先算总长一次分配：`append` 自己会增长，但一次给够省掉中间几次搬家（`withCap(total)` 之后
 * 的 append 不再扩容）。 */
fn join(parts: slice<slice<u8>>, sep: slice<u8>) -> string {
    var total: i64 = 0
    var i: i64 = 0
    while i < parts.len {
        total = total + parts[i].len
        if i + 1 < parts.len { total = total + sep.len }
        i = i + 1
    }
    var out: string = withCap(total)
    i = 0
    while i < parts.len {
        if i > 0 { out.append(sep) }
        out.append(parts[i])
        i = i + 1
    }
    return out
}

/* `io::cout << s`：把 `string` 直接交给输出流，打印它的字节。挂在 `string` 自己这里，所以
 * `use std::text::string` 就够了，不用再 import `std::text::stringio`；`std::io` 不 import `stl`，
 * 依赖方向是 `std::text::string → std::io`，不成环。 */
@ext
impl io::ostream {
    fn <<(self: ref ostream, v: ref string) -> ostream { return self << v.view() }
}

/* stl/stringio.extc -- streaming I/O for `string`, attached with an `impl` block.
 *
 * Why a separate module: `string` is a container and knows nothing about file descriptors or
 * buffered readers. Streaming belongs to the I/O layer, and an `impl` block is exactly the tool
 * for adding behaviour to a type from outside its own body -- here, from outside its own file.
 *
 * What "streaming" means on both sides:
 *   in  -- `readLineFrom` pulls one byte at a time through the reader's buffer (the reader fills
 *          a whole block per read(2), so this is not a syscall per byte); `readAllFrom` moves a
 *          whole buffered chunk per append instead of a byte at a time.
 *   out -- `writeTo` / `writeLineTo` hand the string's bytes to a writer, which buffers and
 *          flushes on its own schedule.
 *
 * The methods grow the string as needed, so the caller never sizes it up front. */
use std::io
use std::fs

impl string {
    /* Read one line and append it -- **the line as `>>` defines it**: the trailing '\n' is not
     * part of it, and neither is the '\r' of a CRLF (`io::reader::nextLine` settled that
     * convention, and this follows it rather than inventing a second meaning for the same
     * word). Returns the number of bytes appended; 0 means EOF and nothing was read. */
    fn readLineFrom(self: mut ref string, r: mut ref io::reader) -> result<i64, io::ioError> {
        var n: i64 = 0
        var heldCR: bool = false
        while true {
            let b = r.nextByte()?
            if b < 0 {
                /* EOF: a '\r' that never got its '\n' was content, not a line ending. */
                if heldCR { self.push(u8(13))  n = n + 1 }
                break
            }
            if b == 10 { break }              /* the '\n' is not part of the line */
            if heldCR { self.push(u8(13))  n = n + 1 }
            if b == 13 { heldCR = true } else { self.push(u8(b))  n = n + 1  heldCR = false }
        }
        return success(n)
    }

    /* Read everything that is left, one buffered chunk per append. */
    fn readAllFrom(self: mut ref string, r: mut ref io::reader) -> result<i64, io::ioError> {
        var n: i64 = 0
        while true {
            let have = r.avail()
            if have > 0 {
                self.append(r.chunk[r.pos..r.pos + have])
                r.pos = r.len
                n = n + have
                continue
            }
            let got = r.fill()?
            if got == 0 { break }
        }
        return success(n)
    }

    /* Write the whole string out. */
    fn writeTo(self: ref string, w: mut ref io::writer) -> result<i64, io::ioError> {
        /* Straight at the storage, no intermediate copy: `w.write` copies the bytes into the
         * writer's own buffer anyway, so a `snapshot()` here would copy them twice. The view is
         * consumed by the call and dies with it. */
        let n = w.write(self.subView(0, self.len()))?
        return success(n)
    }

    /* Write the whole string, then a newline.
     *
     * The newline is a **string literal**, not a view of a local array: a literal's storage is
     * static (depth 0), while `nl[..]` hands an unanalyzable callee a reference into the
     * callee's own frame -- the escape checker refuses that, and rightly so. */
    fn writeLineTo(self: ref string, w: mut ref io::writer) -> result<i64, io::ioError> {
        let n = w.write(self.subView(0, self.len()))?   /* see `writeTo`: no intermediate copy */
        let m = w.write("\n")?
        return success(n + m)
    }

    /* 定点浮点数的追加：`s.appendF64(x, 2)`。与 `string::appendI64` 同一个目的 —— 拼一行
     * 日志少一次临时 `string`。`prec` 上限 20，与 `fromF64` 同一条口径。 */
    fn appendF64(self: mut ref string, x: f64, prec: i64) {
        var buf: [64]u8
        let n = io::fmtF(x, prec, buf[..])
        self.append(buf[0..n])
    }

    /* 浮点数的运算符重载：`s + 1.5` 得到新字符串（默认 6 位小数，与 `appendF64` 的常用
     * 精度一致；要别的精度写 `s.appendF64(x, prec)`）。放在这里而不是 `stl/string.extc`，
     * 是因为十进制格式化（`io::fmtF`）属于 I/O 层。 */
    fn +(self: ref string, other: f64) -> string {
        var out: string
        out.append(self.subView(0, self.len()))
        out.appendF64(other, 6)
        return out
    }

    fn +(self: ref string, other: f32) -> string { return (*self) + f64(other) }
}

/* `>>` into a `string`: the operator overloads the I/O layer already has (`mut ref i64`,
 * `mut slice<u8>`, `mut ref u8`) live in `std::io` / `std::fs`, and a `string` overload has to
 * live where **both** sides are importable -- `std` cannot import `stl` (that would be an import
 * cycle), so this is the module for it. An `impl` block attaches it to a type from another
 * module, which is exactly what `impl` was added for.
 *
 * Semantics match `>> slice<u8>`: one line, newline stripped, destination **replaced**. */
@ext
impl io::istream {
    fn >>(self: ref istream, v: mut ref string) -> istream {
        v.clear()
        var r: io::reader = io::inSync()
        match r.eof() {
            success(atEnd) => {
                if atEnd { io::inFailed = true }
                else {
                    match v.readLineFrom(ref r) {
                        success(n) => { }
                        failure(e) => { io::inFailed = true }
                    }
                }
            }
            failure(e) => { io::inFailed = true }
        }
        r.save()
        return { fd: self.fd }
    }
}

/* The same for a file stream, so "read a save file" and "read player input" stay one shape.
 *
 * This shell looks like the one above because it has to: what differs is only where the reader
 * comes from (`inSync`/`inSave` for the console, `self.r` for a file) and which "we hit the end"
 * flag to raise (`io::inFailed` vs `self.failed`). Both of those are module-private state, and
 * without traits there is nothing to abstract them with -- the part that is worth sharing (the
 * line rule: strip '\n', handle CRLF, grow the string) has exactly one home:
 * `string::readLineFrom`. `std::fs` already writes its three built-in `>>` overloads out twice
 * for the same reason (`ifstream` and `inStream`), so this follows the established shape rather
 * than inventing a second one. */
@ext
impl fs::ifstream {
    fn >>(self: mut ref ifstream, v: mut ref string) -> mut ref ifstream {
        v.clear()
        match self.r.eof() {
            success(atEnd) => {
                if atEnd { self.failed = true }
                else {
                    match v.readLineFrom(ref self.r) {
                        success(n) => { }
                        failure(e) => { self.failed = true }
                    }
                }
            }
            failure(e) => { self.failed = true }
        }
        return self
    }
}

/* `io::cout << s` 的形状 = `impl ostream { fn <<(self: ref ostream, v: string) -> ostream }`：
 * 现在挂在 `std::text::string` 里（`use std::text::string` 就够），`impl` 方法需要的 home 实参由运算符/
 * 方法的 home 记账补齐。回归：`tests/stl/string_print.extc`（只 import `std::text::string`，
 * `io::cout << s` 逐字节正确）。
 */

/* 浮点数转 `string`：`fromF64(x, prec)`（定点 `prec` 位小数，四舍五入）。
 *
 * 为什么放这里：格式化浮点的实现（`io::fmtF`）属于 I/O 层，而 `string` 是容器 —— 容器不
 * 该认识"小数点后几位"这种显示决策。这一层同时认识两边，所以转换放这一层。
 *
 * 与 `io::cout << x` 的区别：那条路走 `%g`（最短可回读形式），这里走固定小数位（报表/日志的
 * 形状）。`prec` 上限 20 —— 超过 `f64` 的有效位数只是噪音。
 */
fn fromF64(x: f64, prec: i64) -> string {
    var buf: [64]u8
    let n = io::fmtF(x, prec, buf[..])
    var out: string = withCap(n)
    out.append(buf[0..n])
    return out
}

/* ---------------------------------------------------------------- 值 f-string 的填充原语
 *
 * `let s: string = f"{x:>8}"` 里带说明符的槽要一个**返回 string** 的填充函数：流上的
 * `padInt`/`padF`/`padText` 是写到 fd 的，值位置不能借用。语义与流上的那三个逐条对齐
 * （宽度按字节、`^` 左右各一半且左少右多、`0` 填充时符号在前）。
 */

/* 把 `v` 按宽度 `width`（字节）、填充字节 `fill`、对齐 `align` 排成一个新 string。
 * `align` 用 `std::io` 的 `LEFT`/`RIGHT`/`CENTER`；宽度不够时不截断，原样拷一份。 */
fn padText(v: slice<u8>, width: i64, fill: u8, align: i64) -> string {
    let n: i64 = width - v.len
    if n <= 0 { return from(v) }
    var out: string = withCap(width)
    if align == io::CENTER {
        let l: i64 = n / 2
        var i: i64 = 0
        while i < l { out.push(fill)  i = i + 1 }
        out.append(v)
        i = 0
        while i < n - l { out.push(fill)  i = i + 1 }
    } else if align == io::LEFT {
        out.append(v)
        var i: i64 = 0
        while i < n { out.push(fill)  i = i + 1 }
    } else {
        var i: i64 = 0
        while i < n { out.push(fill)  i = i + 1 }
        out.append(v)
    }
    return out
}

/* 整数：`{x:>4}` 走这个。零填充与流上 `padInt` 同一条特殊路径 —— `-5` 宽 4 得 `-005`，
 * 不是 `0-5`。 */
fn padI64(v: i64, width: i64, fill: u8, align: i64) -> string {
    let t: string = fromI64(v)
    let digits: i64 = t.len()
    if fill == u8(48) && align == io::RIGHT && width > digits {
        let bytes = t.snapshot()
        var out: string = withCap(width)
        if bytes[0] == u8(45) {
            out.push(u8(45))
            var i: i64 = 0
            while i < width - digits { out.push(fill)  i = i + 1 }
            out.append(bytes[1..digits])
        } else {
            var i: i64 = 0
            while i < width - digits { out.push(fill)  i = i + 1 }
            out.append(bytes)
        }
        return out
    }
    return padText(t.snapshot(), width, fill, align)
}

/* 无符号整数：`{x:>4}` 走这个。没有符号位，零填充就是纯前导 0，直接借 `padText`。 */
fn padU64(v: u64, width: i64, fill: u8, align: i64) -> string {
    let t: string = fromU64(v)
    return padText(t.snapshot(), width, fill, align)
}

/* 浮点：`{x:8.2f}` 走这个。先按 `prec` 位小数定型，再按宽度排 —— 与流上 `padF` 同一顺序。 */
fn padF64(x: f64, width: i64, prec: i64, fill: u8, align: i64) -> string {
    let t: string = fromF64(x, prec)
    return padText(t.snapshot(), width, fill, align)
}

/* ---------------------------------------------------------------- 从 stdin 读整块文本
 *
 * 用 `impl` 块里的 `readLineFrom` / `readAllFrom` 能做到，但每个调用点都要
 * `io::inSync()` + `r.save()` 两行样板：控制台读取的状态住在 `std::io` 的模块级缓冲里
 * （`inPos` 等），不 save 回去，下一次 `inSync()` 就会重读同一段。这两个函数把"同步取还"
 * 收进来，调用点只剩一句。
 *
 * 返回 `none` 只表示 **EOF 且什么都没读到**（空行是 `some("")`，与 EOF 区分开）；读取错误也
 * 用 `none` 表示（控制台读失败基本只意味着 fd 坏了，不值得为它加一条分支）。
 */

/* 读一行，行尾的 `\n` / `\r\n` 不算内容（与 `io::reader::nextLine` 的口径一致）。 */
fn readLine() -> ?string {
    var r: io::reader = io::inSync()
    var s: string = withCap(16)
    var any: bool = false
    var eof: bool = false
    var heldCR: bool = false
    while true {
        let got = r.nextByte()
        match got {
            failure(_) => { r.save()  return none }
            success(b) => {
                if b < 0 { eof = true  break }
                /* `\n` 收尾：扣着的 `\r` 是 CRLF 的前半，不是内容。 */
                if b == 10 { heldCR = false  break }
                /* `\r` 先扣着：后面跟 `\n` 就是行尾，否则它是内容。 */
                if heldCR { s.push(u8(13))  any = true  heldCR = false }
                if b == 13 { heldCR = true } else { s.push(u8(b))  any = true }
            }
        }
    }
    /* EOF 之前那个没等到 `\n` 的 `\r` 是内容，不是行尾。 */
    if heldCR { s.push(u8(13))  any = true }
    r.save()
    if !any && eof { return none }
    return some(s)
}

/* 读剩下的全部输入。 */
fn readAll() -> ?string {
    var r: io::reader = io::inSync()
    var s: string = withCap(16)
    while true {
        let got = r.fill()
        match got {
            failure(_) => { r.save()  return none }
            success(n) => {
                if n == 0 { break }
                s.append(r.chunk[0..n])
            }
        }
    }
    r.save()
    return some(s)
}

/* ---------------------------------------------------------------- 读一个「词」 */

/* 读一段非空白字节，跳过前导空白；什么都没读到（EOF 先到）返回 none。
 * 词尾的那个空白**不消费**：把它退回去（pos - 1），下一次读取仍然看得见 —— 这是
 * 「按词切」与「按行切」能混用的前提（nextInt 之后紧接 nextLine 读到的正是数字之后那一行）。 */
fn readToken() -> ?string {
    var r: io::reader = io::inSync()
    match r.skipSpace() {
        failure(e) => { r.save()  return none }
        success(k) => { }
    }
    var s: string = withCap(16)
    var any: bool = false
    while true {
        let got = r.nextByte()
        match got {
            failure(e) => { r.save()  return none }
            success(b) => {
                if b < 0 { break }
                if b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12 {
                    r.pos = r.pos - 1
                    break
                }
                s.push(u8(b))
                any = true
            }
        }
    }
    r.save()
    if !any { return none }
    return some(s)
}

/* ---------------------------------------------------------------- 控制台对象上的同名方法
 *
 * 与自由函数 readLine() / readAll() / readToken() 是同一份实现，只是换了「对对象说话」的形状：
 *   var line = stdin.readLine()!
 * 参数是零字段的流对象（std::io 的 stdin），不需要也不改变任何状态。 */
@ext
impl io::stdinStream {
    fn readLine(self: ref io::stdinStream) -> ?string { return readLine() }
    fn readAll(self: ref io::stdinStream) -> ?string { return readAll() }
    fn readToken(self: ref io::stdinStream) -> ?string { return readToken() }
}

/* std/b64.extc —— Base64（RFC 4648 §4 标准表 / §5 URL 安全表）。
 *
 * 手写而不是 vendor：它没有 ABI 面、没有"库"可言，而且我们要的是**零分配**的
 * "调用方给缓冲"形状 —— 与 `std::json` 的 `strInto` 同一惯用法（跨界只传值 + 缓冲）。
 *
 * @code
 * use std::io
 * use std::text::string
 *
 * fn main() -> i32 {
 *     var src: [8]u8
 *     src[0] = u8(102)                 // f
 *     src[1] = u8(111)                 // o
 *     src[2] = u8(111)                 // o
 *     var out: [16]u8
 *     let n: i64 = string::encode(src[0..3], out[..])   // 返回写入长度；缓冲不够 -1
 *     io::cout << "n=" << n << " " << out[0..n] << "\n"
 *     return 0
 * }
 * @endcode
 *
 * 用在哪：WebSocket 握手的 `Sec-WebSocket-Accept = base64(SHA1(key + wsGuid))`、HTTP Basic、
 * 以后 QQ 富媒体的分片上传。**不做流式**：这些负载都是几十字节，缓冲直接给够最省事。
 *
 * 分工：标准表给 `encode`/`decode`，URL 安全表（`-` `_`）给 `encodeUrl`/`decodeUrl` ——
 * 不让调用方自己换字符（换了之后 `decode` 会把 `-` 当非法输入，错得静默）。
 * 两种都**带 `=` 填充**（RFC 4648 §5 的 URL 安全表也是带填充的；"无填充"是 JWT 自己的约定，
 * 要它就在调用方 `trimEnd('=')`）。
 */

const PAD: u8 = 61            /* '=' */

/* 6 bit → 输出字符 */
@private
fn pEnc6(v: i64, url: bool) -> u8 {
    if v < 26 { return u8(i32(65) + i32(v)) }
    if v < 52 { return u8(i32(97) + i32(v) - i32(26)) }
    if v < 62 { return u8(i32(48) + i32(v) - i32(52)) }
    if v == 62 {
        if url { return u8(45) }
        return u8(43)
    }
    if url { return u8(95) }
    return u8(47)
}

/* 输入字符 → 6 bit；非法给 -1（`=` 由调用方在分组层处理，不进这里） */
@private
fn pDec6(c: u8, url: bool) -> i64 {
    if c >= u8(65) && c <= u8(90) { return i64(i32(c) - i32(65)) }
    if c >= u8(97) && c <= u8(122) { return i64(i32(c) - i32(97) + i32(26)) }
    if c >= u8(48) && c <= u8(57) { return i64(i32(c) - i32(48) + i32(52)) }
    if url {
        if c == u8(45) { return 62 }
        if c == u8(95) { return 63 }
        return -1
    }
    if c == u8(43) { return 62 }
    if c == u8(47) { return 63 }
    return -1
}

/* `n` 字节编码后要多长（含填充）。调用方用它算缓冲大小。 */
fn encodedLen(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return ((n + 2) / 3) * 4
}

/* `n` 个 base64 字符最多解出多少字节（上界，用来算缓冲大小）。 */
fn decodedMax(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return (n / 4) * 3
}

@private
fn pEnc(src: slice<u8>, out: mut slice<u8>, url: bool) -> i64 {
    let need: i64 = encodedLen(src.len)
    if out.len < need { return -1 }
    var i: i64 = 0
    var o: i64 = 0
    while i + 3 <= src.len {
        let n: i64 = i64(src[i]) * 65536 + i64(src[i + 1]) * 256 + i64(src[i + 2])
        out[o] = pEnc6(n / 262144, url)
        out[o + 1] = pEnc6((n / 4096) % 64, url)
        out[o + 2] = pEnc6((n / 64) % 64, url)
        out[o + 3] = pEnc6(n % 64, url)
        i = i + 3
        o = o + 4
    }
    let rem: i64 = src.len - i
    if rem == 1 {
        let n: i64 = i64(src[i]) * 65536
        out[o] = pEnc6(n / 262144, url)
        out[o + 1] = pEnc6((n / 4096) % 64, url)
        out[o + 2] = PAD
        out[o + 3] = PAD
    } else if rem == 2 {
        let n: i64 = i64(src[i]) * 65536 + i64(src[i + 1]) * 256
        out[o] = pEnc6(n / 262144, url)
        out[o + 1] = pEnc6((n / 4096) % 64, url)
        out[o + 2] = pEnc6((n / 64) % 64, url)
        out[o + 3] = PAD
    }
    return need
}

@private
fn pDec(src: slice<u8>, out: mut slice<u8>, url: bool) -> i64 {
    let n: i64 = src.len
    if n == 0 { return 0 }
    if n % 4 != 0 { return -1 }        /* 长度必须是 4 的倍数 */
    var pad: i64 = 0
    if n >= 1 && src[n - 1] == PAD { pad = pad + 1 }
    if n >= 2 && src[n - 2] == PAD { pad = pad + 1 }
    if pad > 2 { return -1 }
    let total: i64 = (n / 4) * 3 - pad
    if out.len < total { return -1 }
    var o: i64 = 0
    var g: i64 = 0
    while g < n {
        let last: bool = g + 4 >= n
        let c0: i64 = pDec6(src[g], url)
        let c1: i64 = pDec6(src[g + 1], url)
        if c0 < 0 || c1 < 0 { return -1 }
        var c2: i64 = 0
        var c3: i64 = 0
        if src[g + 2] == PAD {
            if !last || src[g + 3] != PAD { return -1 }   /* 填充只能出现在最后一组，且连用 */
        } else if src[g + 3] == PAD {
            if !last { return -1 }
            c2 = pDec6(src[g + 2], url)
            if c2 < 0 { return -1 }
        } else {
            c2 = pDec6(src[g + 2], url)
            c3 = pDec6(src[g + 3], url)
            if c2 < 0 || c3 < 0 { return -1 }
        }
        let v: i64 = c0 * 262144 + c1 * 4096 + c2 * 64 + c3
        if o < total { out[o] = u8((v / 65536) % 256)  o = o + 1 }
        if o < total { out[o] = u8((v / 256) % 256)  o = o + 1 }
        if o < total { out[o] = u8(v % 256)  o = o + 1 }
        g = g + 4
    }
    return total
}

fn encode(src: slice<u8>, out: mut slice<u8>) -> i64 { return pEnc(src, out, false) }
fn decode(src: slice<u8>, out: mut slice<u8>) -> i64 { return pDec(src, out, false) }
fn encodeUrl(src: slice<u8>, out: mut slice<u8>) -> i64 { return pEnc(src, out, true) }
fn decodeUrl(src: slice<u8>, out: mut slice<u8>) -> i64 { return pDec(src, out, true) }

/** @brief `string::borrow()` 的守卫：活着的时候存储被冻结（增长/释放都会 trap）。
 *
 * 它不拥有存储、也不决定寿命：只把"改变存储身份"从"读回收掉的字节"变成一条带位置的 `trap`。
 */
@noCopy
struct stringGuard {
    @private s: ref string
    @private p: mut ref i64

    @private
    @drop
    fn release(self: mut ref stringGuard) { *self.p = *self.p - 1 }

    /** @brief 只读视图：与 `string::view()` 相同，但受守卫保护。 */
    fn view(self: ref stringGuard) -> slice<u8> { return self.s.view() }

    /** @brief 字节数。 */
    fn len(self: ref stringGuard) -> i64 { return self.s.len() }
}

/* ================================================================ 视图上的文本方法
 *
 * 字符串字面量的静态类型是 `slice<u8>`（视图），不是 `string`。所以 `"  a b  ".trim()`、
 * `"a,b".split(",")` 这类写法只有在 `slice<u8>` 上放方法才成立；自由函数留着当实现，
 * 方法只做转发（同一份代码、同一份语义、零拷贝）。
 *
 * 只给 `slice<u8>`：`slice<f64>`、`slice<i64>` 上的 `trim` 没有意义，把方法收在字节视图上
 * 正好也是"文本"这个概念的最小面。
 *
 * `len()` 是**只读**的：视图的 `data`/`len` 由编译器构造，用户代码不能写（`s.len = 1` 是
 * 编译错误），要更短的视图就切一刀 `s[lo..hi]`。
 */
impl slice<u8> {
    fn len(self: ref slice<u8>) -> i64 { return self.len }

    fn isEmpty(self: ref slice<u8>) -> bool { return self.len == 0 }

    fn trim(self: ref slice<u8>) -> slice<u8> { return trim(self[..]) }

    fn trimStart(self: ref slice<u8>) -> slice<u8> { return trimStart(self[..]) }

    fn trimEnd(self: ref slice<u8>) -> slice<u8> { return trimEnd(self[..]) }

    fn split(self: ref slice<u8>, sep: slice<u8>) -> vector<slice<u8>> {
        return split(self[..], sep)
    }

    fn toI64(self: ref slice<u8>) -> ?i64 { return toI64(self[..]) }

    fn toF64(self: ref slice<u8>) -> ?f64 { return toF64(self[..]) }

    fn find(self: ref slice<u8>, needle: slice<u8>) -> ?i64 {
        let m = self.len
        let n = needle.len
        if n == 0 { return some(0) }
        if n > m { return none }
        let hay = self[..]
        let r = std::mem::extc_memFind(hay.data, m, needle.data, n)
        if r < 0 { return none }
        return some(r)
    }

    fn contains(self: ref slice<u8>, needle: slice<u8>) -> bool {
        return (self.find(needle) ?? -1) >= 0
    }

    fn startsWith(self: ref slice<u8>, p: slice<u8>) -> bool {
        let s = self[..]
        if p.len > s.len { return false }
        var i: i64 = 0
        while i < p.len {
            if s[i] != p[i] { return false }
            i = i + 1
        }
        return true
    }

    fn endsWith(self: ref slice<u8>, p: slice<u8>) -> bool {
        let s = self[..]
        if p.len > s.len { return false }
        let off = s.len - p.len
        var i: i64 = 0
        while i < p.len {
            if s[off + i] != p[i] { return false }
            i = i + 1
        }
        return true
    }
}
