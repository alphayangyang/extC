/* std/coro/scheduler.extc —— 协程调度器（CONCURRENCY.md §4.4 阶段三）
 *
 * 一个 `while` 循环 + 一个事件源。挂起约定：协程 `yield` 一个等待请求（这里是它想等的 fd；
 * **负数 = 别等，立刻再推我**），恢复后**重试**它自己的操作；要把结果送回去就用 `send`。
 *
 * **任务表是调用者自己的容器**（`tasks<T>` 包着 `vector<row>`）⇒ **会长，没有容量上限**；
 * 跑完的行由 `add` 就地改写复用，长跑服务器不会把表撑大。句柄是 24 字节的普通值，容器内部是
 * `mut slice` ⇒ 元素是可写位置，可以直接 `rows.vals[i].h.next()`。
 *
 * 为什么表做成**泛型**结构体：往容器里存一个句柄这一步，只有在**容器自己的方法**里（实例化于调用者
 * 上下文）才不受参数生命周期规则的限制。这条限制以前更凶（连库函数 `stash(ref v, h)` 都拒），
 * 精度修正之后普通函数也能过，但泛型容器是最稳的形状，也正好让表长起来。
 *
 * **派发是 O(1) 的**（2026-09-29 重写）：epoll 事件的 user-data 里放**任务行号**（listener 用 -1
 * 这个哨兵）⇒ 一个事件 = 一次数组定位，**不扫任务表** ✓。要立刻推进的行（新任务 / `yield 负数`）
 * 进 `runq`，跑完的行进 `freeq` 复用座位 ⇒ `add` 也不用找空行 ✓。
 * 为什么要改：从前 `pump` 每轮扫全表、派发时再「全表 × 就绪」扫一遍 ⇒ **挂 10k 条空闲连接就把
 * 吞吐砍半**（实测 198,787 → 99,442 req/s ✗）。
 *   ① vector 的存储是池的板块，生命周期挂在**建它的那个 place** 上 ⇒ 表和调度器都要在驱动它的那个
 *      作用域里建（`main`）。
 *   ② `push` 扩容会换掉内部视图 ⇒ 不要跨 `add` 长期持有 `rows` 的视图；方法内部每次现取。
 *   ③ `pump` 返回：`>= 0` = listener 上 accept 出来的新 fd（用哪种协程接它由调用者决定）；
 *      `-1` = 处理了事件但没有新连接；`-2` = 超时。 */

use std::sys::net
use stl::vector

/* 一行任务：句柄 + 两个标记 + **它当前注册在 epoll 里的 fd**（-2 = 没注册）。 */
struct row {
    h: coroutine<i64>
    done: bool
    started: bool
    fd: i64
}

/* 调度器状态：**只有标量** —— 这不是风格，是语言规则：含引用的结构体没有零值，
 * `var s: sched::loop` 就写不出来了 ✗（实测）。队列因此住在 `tasks<T>` 里（调用者自己的容器 ✓）。 */
struct loop {
    ep: i64                 /* epoll 实例 */
    listener: i64           /* -1 = 没有 listener */
    live: i64               /* 还没跑完的任务数 */
}

struct tasks<T> {
    rows: vector<row>
    /* 两个队列（放这儿而不是 `loop`：容器让 `loop` 失去零值 ✗）：
     *   · `runq`   立刻要推进的行号（新任务、`yield 负数`），`rqHead` 是读游标（不搬数据）
     *   · `freeq`  跑完的行号 ⇒ `add` 复用座位是 O(1) ✓ */
    runq: vector<i64>
    rqHead: i64
    freeq: vector<i64>
    /* 本轮多 accept 出来的连接（`pump` 先还这一个队列，调用方的循环一个字都不用改 ✓）*/
    acceptq: vector<i64>

    /* 加一个任务：座位从 `freeq` 里 O(1) 拿（没有就长一行），并进 `runq` 等第一次推进。 */
    fn add(self: mut ref tasks<T>, s: mut ref loop, h: coroutine<i64>) -> bool {
        var i: i64 = i64(-1)
        if self.freeq.len() > i64(0) {
            var oi: option<i64> = self.freeq.pop()
            i = oi!                       /* 刚查过 len > 0 ✓ */
        }
        if i >= i64(0) {
            self.rows.vals[i] = { h: h, done: false, started: false, fd: i64(-2) }
        } else {
            self.rows.push({ h: h, done: false, started: false, fd: i64(-2) })
            i = self.rows.len() - i64(1)
        }
        self.runq.push(i)
        s.live = s.live + i64(1)
        return true
    }

    fn count(self: ref tasks<T>) -> i64 { return self.rows.len() }

    /* 推进一个任务一步（脚本化驱动用）：返回它是否还活着。 */
    fn step(self: mut ref tasks<T>, s: mut ref loop, i: i64) -> bool {
        if self.rows.vals[i].done { return false }     /* 结束过的句柄过期，再驱动会 trap（规则②）*/
        if !self.rows.vals[i].started {
            self.rows.vals[i].started = true
            if !self.rows.vals[i].h.next() { self.finish(s, i)  return false }
            return true
        }
        var req: i64 = self.rows.vals[i].h.value()     /* 挂起时留下的请求（**读在 send 之前**）*/
        if !self.rows.vals[i].h.send(req) { self.finish(s, i)  return false }
        return true
    }

    /* 推进一行，直到它**挂起在一个正请求上**（= 注册进 epoll 等事件）或结束。
     * `ready = true` 表示"这个 fd 刚就绪" ⇒ 先把挂起的请求 `send` 回去再继续；否则是
     * "新任务 / `yield 负数` 要立刻推进"。
     *
     * **负请求（"别等，立刻再推我"）只在这一处处理** —— 从前两条路各写一遍，就绪那条漏了 ⇒
     * 恢复后又 `yield -1` 的任务再也没人推 ✗（实测：coro_echo / coro_epoll 两个判据当场挂）。 */
    fn resumeRow(self: mut ref tasks<T>, s: mut ref loop, i: i64, ready: bool) {
        if self.rows.vals[i].done { return }
        if ready {
            if !self.rows.vals[i].h.send(self.rows.vals[i].h.value()) { self.finish(s, i)  return }
        }
        while true {
            if !self.rows.vals[i].started {
                self.rows.vals[i].started = true
                if !self.rows.vals[i].h.next() { self.finish(s, i)  return }
                continue
            }
            var req: i64 = self.rows.vals[i].h.value()
            if req >= i64(0) {
                /* 等这个 fd 可读；**行号就是 epoll 的 tag** ⇒ 回来时不用查任何表 ✓ */
                if self.rows.vals[i].fd != req {
                    net::extc_epoll_add(s.ep, req, i64(1), i)
                    self.rows.vals[i].fd = req
                }
                return
            }
            if !self.rows.vals[i].h.send(req) { self.finish(s, i)  return }
        }
    }

    /* 收尾一行：标记 + 计数 + 把座位还给 `freeq`。**不缩表**（`pop` 会换掉内部视图，而索引是
     * 外面对表的唯一把手）。**幂等**：重复收尾会把同一个座位还两次 ⇒ 以后两个任务坐同一行 ✗。 */
    fn finish(self: mut ref tasks<T>, s: mut ref loop, i: i64) {
        if self.rows.vals[i].done { return }
        self.rows.vals[i].done = true
        self.rows.vals[i].fd = i64(-2)
        self.freeq.push(i)
        s.live = s.live - i64(1)
    }

    /* 脚本化的"事件源"：按 order 里的下标依次推进；返回还剩几个活任务。 */
    fn runScripted(self: mut ref tasks<T>, s: mut ref loop, order: slice<i64>) -> i64 {
        var k: i64 = 0
        while k < order.len {
            var i: i64 = order[k]
            if i >= i64(0) && i < self.rows.len() { self.step(s, i) }
            k = k + 1
        }
        return s.live
    }

    /* 一轮事件循环：**先推进 runq 里的行**（新任务 / `yield 负数`）⇒ 等事件 ⇒ 就绪的按标签
     * O(1) 派发。全程不扫任务表 ✓（这是 10k 空闲连接不再砍半的原因）。 */
    fn pump(self: mut ref tasks<T>, s: mut ref loop, timeout_ms: i64) -> i64 {
        /* **先还上一次批量 accept 攒下的连接**（不花系统调用 ✓）*/
        if self.acceptq.len() > i64(0) {
            var oq: option<i64> = self.acceptq.pop()
            return oq!
        }
        var waitMs: i64 = timeout_ms
        if waitMs < i64(0) { waitMs = i64(0) }          /* 负超时 = 不阻塞 */
        if s.ep < i64(0) { return i64(-2) }

        /* ① runq：要立刻推进的行。一个行可能连着推进多次（`yield 负数` = 别等，再来一轮）*/
        while self.rqHead < self.runq.len() {
            var i: i64 = self.runq.vals[self.rqHead]
            self.rqHead = self.rqHead + i64(1)
            self.resumeRow(s, i, false)
        }
        if self.rqHead >= self.runq.len() && self.runq.len() > i64(0) {
            self.runq.clear()                              /* 整轮读完了 ⇒ 从头开始，别让它长 ✗ */
            self.rqHead = i64(0)
        }

        /* ② 等一个事件（listener 在 `init` 里注册过一次，tag = -1）*/
        var tag: i64 = net::extc_epoll_wait(s.ep, waitMs)
        if tag == i64(-100) { return i64(-2) }          /* 队列空：超时 */
        var accepted: i64 = i64(-1)
        var draining: bool = true
        while draining {
            if tag == i64(-1) {
                /* **一次 accept 一批**（上限 64，别把别的事件饿死 ✓）。从前是"一轮只 accept 一个" ✗
                 * —— 建连风暴时 accept 速率被"每轮 ~20µs"卡在 ~50k/s：实测 10k 忙连接的 p50 就有
                 * 1.05s ✗，50k 直接排队到测量窗口之外（0 响应 ✗）。多出来的先入队，由 `pump` 开头
                 * 依次还回去 ⇒ 调用方的 `while { fd = pump(); if fd >= 0 add(fd) }` 一个字不改 ✓。 */
                var k: i64 = 0
                while s.listener >= i64(0) && k < i64(64) {
                    var cfd: i64 = net::extc_sock_accept(s.listener)
                    if cfd < i64(0) { break }
                    if accepted < i64(0) { accepted = cfd } else { self.acceptq.push(cfd) }
                    k = k + i64(1)
                }
                draining = false
            } else if tag >= i64(0) && tag < self.rows.len() {
                self.resumeRow(s, tag, true)        /* 就绪恢复 ⇒ 之后可能是负请求/结束，都归它管 ✓ */
            }
            tag = net::extc_epoll_wait(s.ep, i64(0))
            if tag == i64(-100) { draining = false }
        }
        return accepted
    }

    /* 一直跑到所有任务结束（没有 listener 的用法）。 */
    fn runEpoll(self: mut ref tasks<T>, s: mut ref loop, timeout_ms: i64) -> i64 {
        while s.live > i64(0) {
            var r: i64 = self.pump(s, timeout_ms)
            if r == i64(-2) { break }                   /* 超时：不再空转 */
        }
        return s.live
    }
}

/* 表的存储：库只给一个**裸容器**（容器类型的存储生在调用者所在的地方 ⇒ 返回它没问题 ✓）。
 * 组装在调用点写一行字面量（**必须写在驱动它的那个作用域里**：池的板块跟着那个 place 走 ✓）：
 *
 *     var tasks: sched::tasks<i64> = { rows: sched::newRows(), runq: sched::newQ(),
 *                                     rqHead: i64(0), freeq: sched::newQ(), acceptq: sched::newQ() }
 *
 * 不能提供 `newTasks() -> tasks<i64>`：**包装结构体不算容器** ⇒ 从函数里返回它会被
 * "return value would hold a reference to a local variable that dies first" 拒 ✓（实测 ✓）。 */
fn newRows() -> vector<row> { return vector<row>::new() }
/* i64 队列（`runq`/`freeq`）：库给**裸容器**，组装放在调用点的字面量里 ✓ */
fn newQ() -> vector<i64> { return vector<i64>::new() }

/* `listener` 传 -1 就是"只驱动任务，不 accept"。 */
fn init(s: mut ref loop, listener: i64) -> bool {
    s.listener = listener
    s.live = i64(0)
    s.ep = net::extc_epoll_new()
    if s.ep < i64(0) { return false }
    /* listener **只注册一次**（从前每轮都 `epoll_ctl(ADD)` 一次 = 每轮一个白费的系统调用 ✗）*/
    if listener >= i64(0) { net::extc_epoll_add(s.ep, listener, i64(1), i64(-1)) }
    return true
}
