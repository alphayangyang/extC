/* std/data/vector.extc —— 预留底动态数组：`buf<T>` 之上的一层下标视图
 *
 * **一个对象、一个不变量**：`vector<T>` 持有一个 `buf<T>`，元素 `i` 的地址永远是
 * `base + i*sizeof(T)`；长度就是 `buf` 的长度。于是
 *   - 增长只在预留内推进长度（不拷贝、不搬家），撞到预留上限才搬一次家（`buf` 负责）；
 *   - `shrink()` 把尾部的页还给操作系统，地址不变；
 *   - `release()`（以及 `@drop`）把整片预留还给分配器 —— 旧代不会留在堆上。
 *
 * **所有权**：`vector` 是 `@noCopy`（它拥有存储）。`var b = a` 是**转移**，不是拷贝：
 * 转移之后旧名字什么都没有（编译期就报错），所以「两份值共用一个板块、一份 release 后
 * 另一份悬垂」这一整类事故**在语言里写不出来**。要一份能自己改的副本用 `clone()`。
 *
 * @code
 * use std::io
 * use std::data::vector
 *
 * fn main() -> i32 {
 *     var v = vector<i32>::new()
 *     v.push(i32(7))
 *     v.push(i32(9))
 *     let first: i32 = v.get(0) ?? i32(-1)
 *     io::cout << "len=" << v.len() << " cap=" << v.capacity() << " v[0]=" << first << "\n"
 *     return 0
 * }
 * @endcode
 */
use std::data::buf

@noCopy
struct vector<T> {
    @private b: buf<T>

    /** @brief 建一个容量为 `c` 的数组（下限 1；`buf` 再按 2 MiB 地址空间起留）。 */
    fn withCap(c: i64) -> vector<T> {
        var cc: i64 = c
        if cc < 4 { cc = 4 }
        var v: vector<T> = { b: buf<T>::withCap(cc) }
        return v
    }

    /** @brief 建一个空数组（容量下限 4）。 */
    fn new() -> vector<T> { return vector<T>::withCap(4) }

    /** @brief 元素个数。 */
    @inline
    fn len(self: ref vector<T>) -> i64 { return self.b.len() }

    /** @brief 当前承诺的容量（预留内可以原地长到这个数，不搬家）。 */
    @inline
    fn capacity(self: ref vector<T>) -> i64 { return self.b.capacity() }

    /** @brief 这片预留最多装几个元素。 */
    @inline
    fn maxCapacity(self: ref vector<T>) -> i64 { return self.b.maxCapacity() }

    /** @brief 存储搬过几次家（增长代价的可观测计数）。 */
    @inline
    fn relocations(self: ref vector<T>) -> i64 { return self.b.relocations() }

    /** @brief 没有元素。 */
    @inline
    fn isEmpty(self: ref vector<T>) -> bool { return self.b.len() == 0 }

    /** @brief 下标读：越界给 `none`（条件用值，不 trap）。 */
    fn get(self: ref vector<T>, i: i64) -> option<T> {
        if i < 0 || i >= self.b.len() { return option<T>::none }
        return option<T>::some(self.b.view()[i])
    }

    /** @brief 下标写：越界就什么都不做（调用者用 `get` 先问）。 */
    fn set(self: mut ref vector<T>, i: i64, v: T) -> bool {
        if i < 0 || i >= self.b.len() { return false }
        self.b.viewMut()[i] = v
        return true
    }

    /** @brief 下标读 `v[i]`：越界 trap（要 `none` 用 `get`）。 */
    @inline
    fn [](self: ref vector<T>, i: i64) -> T { return self.b.view()[i] }

    /** @brief 下标写 `v[i] = x`：越界 trap（由视图写入检查报出），旧元素照常跑 `@drop`。 */
    fn []=(self: mut ref vector<T>, i: i64, v: T) -> bool {
        self.b.viewMut()[i] = v
        return true
    }

    /** @brief 只读视图 `[0, len)`（不拷贝）。改容量的调用之后失效；要独立拷贝用 `snapshot`。 */
    fn view(self: ref vector<T>) -> slice<T> { return self.b.view() }

    /** @brief 可写视图 `[0, len)`（不拷贝）。与 `view` 同一道闸：改容量的调用之后失效。 */
    fn viewMut(self: mut ref vector<T>) -> mut slice<T> { return self.b.viewMut() }

    /** @brief 拷一份到调用者所在的地方（`snapshot` 是拷贝，不是视图）。 */
    fn snapshot(self: ref vector<T>) -> slice<T> {
        var out: mut slice<T> = new T[self.b.len()]
        copyInto<T>(out, self.b.view(), self.b.len())
        return out
    }

    /** @brief 深拷贝：要一份独立存储的新数组用它（`var b = a` 是转移，不是拷贝）。 */
    fn clone(self: ref vector<T>) -> vector<T> {
        var out = vector<T>::withCap(self.b.len())
        var i: i64 = 0
        while i < self.b.len() { out.push(self.b.view()[i])  i = i + 1 }
        return out
    }

    /** @brief 追加一个元素；容量不够时在预留内原地长，撞到预留上限才搬一次家。 */
    @inline
    fn push(self: mut ref vector<T>, v: T) { self.b.push(v) }

    /** @brief 弹出最后一个元素；空的时候返 `none`。 */
    @inline
    fn pop(self: mut ref vector<T>) -> option<T> {
        if self.b.len() == 0 { return option<T>::none }
        return self.b.pop()
    }

    /** @brief 在 `i` 处插入 `v`；`i` 可以等于 `len()`（等价于追加）。越界返 `false`。 */
    fn insert(self: mut ref vector<T>, i: i64, v: T) -> bool { return self.b.insertAt(i, v) }

    /** @brief 删掉 `i` 处的元素并返回它；越界返 `none`。 */
    fn removeAt(self: mut ref vector<T>, i: i64) -> option<T> { return self.b.removeAt(i) }

    /** @brief 只留前 `k` 个元素（`k` 钳到 `[0, len()]`）；容量保留，只丢尾部元素。 */
    fn truncate(self: mut ref vector<T>, k: i64) { self.b.truncate(k) }

    /** @brief 保证还能再放 `more` 个元素（长度不变）；预留内原地长，撞上限才搬家。 */
    fn reserve(self: mut ref vector<T>, more: i64) { self.b.reserve(more) }

    /** @brief 缩到刚好装下 `len()` 个元素（下限 4），尾部页还给操作系统。 */
    fn shrink(self: mut ref vector<T>) {
        var ncap: i64 = self.b.len()
        if ncap < 4 { ncap = 4 }
        if ncap >= self.b.capacity() { return }
        self.b.shrink(ncap)
    }

    /** @brief 清空但保留容量（下一次填回来不用重新提交页）。 */
    @inline
    fn clear(self: mut ref vector<T>) { self.b.clear() }

    /** @brief 现在就把整片预留还给分配器（之后 `@drop` 再发一次也是空操作）。 */
    fn release(self: mut ref vector<T>) { self.b.release() }

    /** @brief 借出：守卫活着的时候数组不许搬家。 */
    fn borrow(self: mut ref vector<T>) -> vectorGuard<T> {
        var g: vectorGuard<T> = { g: self.b.borrow() }
        return g
    }
}

/** @brief 从一段视图**拷贝**出一个 `vector`（`T` 靠推断）。 */
fn from<T>(a: slice<T>) -> vector<T> {
  var v = vector<T>::withCap(i64(a.len))
  var i: i64 = 0
  while i < a.len { v.push(a[i])  i = i + 1 }
  return v
}
/** @brief `vector::borrow()` 的守卫：活着的时候存储被冻结（搬家会 trap）。 */
@noCopy
struct vectorGuard<T> {
    @private g: borrowGuard<T>

    /** @brief 只读视图：与 `vector::view()` 相同，但受守卫保护。 */
    fn view(self: ref vectorGuard<T>) -> slice<T> { return self.g.view() }

    /** @brief 元素个数。 */
    fn len(self: ref vectorGuard<T>) -> i64 { return self.g.len() }
}
