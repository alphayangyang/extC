/* stl/seq.extc —— 序列归约：`sum` / `max` / `min` / `count`
 *
 * **语义按"从左到右"钉死**：`sum` 的累加顺序就是视图元素顺序，浮点也一样。
 * 这条不是实现细节 —— 它让归约**可复现**（同一份输入永远同一个 bit 结果），
 * 也让并行版必须按固定分段、按段顺序合并，而不是随手并发累加。
 *
 * **空视图不 trap**：三个归约返回 `option`，空输入是 `none`。
 * 库不替调用方决定"空的时候算多少"：没有泛型的零值可填，替它填 0 又会把
 * "没有元素"和"和是 0"混成一件事；`??` 与 `match` 两条路都在调用方手里。
 *
 * 只收缩看、不分配、不改变入参 —— 这三个函数在任何一个线程上都合法（`Thread=0`）。
 *
 * @code
 * use std::data::seq
 *
 * fn main() -> i32 {
 *     var xs: mut slice<f64> = new f64[3]
 *     xs[0] = 1.0
 *     xs[1] = 2.0
 *     xs[2] = 3.5
 *     let s = seq::sum(xs) ?? f64(0.0)
 *     if s > f64(6.0) { return 0 }
 *     return 1
 * }
 * @endcode
 */

/** @brief 从左到右累加 `a` 的所有元素。
 *  @param a 参与求和的只读视图。
 *  @return 和；空视图是 `none`。
 */
fn sum<T>(a: slice<T>) -> ?T {
    if a.len == 0 { return none }
    var s: T = a[0]
    var i: i64 = 1
    while i < a.len {
        s = s + a[i]
        i = i + 1
    }
    return some(s)
}

/** @brief 找 `a` 里最大的元素（用 `>` 比较，相等时保留靠前的那个）。
 *  @param a 参与比较的只读视图。
 *  @return 最大值；空视图是 `none`。
 */
fn max<T>(a: slice<T>) -> ?T {
    if a.len == 0 { return none }
    var best: T = a[0]
    var i: i64 = 1
    while i < a.len {
        if a[i] > best { best = a[i] }
        i = i + 1
    }
    return some(best)
}

/** @brief 找 `a` 里最小的元素（用 `<` 比较，相等时保留靠前的那个）。
 *  @param a 参与比较的只读视图。
 *  @return 最小值；空视图是 `none`。
 */
fn min<T>(a: slice<T>) -> ?T {
    if a.len == 0 { return none }
    var best: T = a[0]
    var i: i64 = 1
    while i < a.len {
        if a[i] < best { best = a[i] }
        i = i + 1
    }
    return some(best)
}

/** @brief 数一数 `v` 在 `a` 里出现了多少次（用 `==` 比较）。
 *  @param a 要扫的只读视图。
 *  @param v 要找的值。
 *  @return 出现次数；空视图是 0。
 */
fn count<T>(a: slice<T>, v: T) -> i64 {
    var n: i64 = 0
    for x in a {
        if x == v { n = n + 1 }
    }
    return n
}

// ---- 固定分块的并行归约 -------------------------------------------------------------
//
// 一维 `par` 的归约路线是两步：先把每段的局部结果写进 `parts`，再按段序串行合并。这里内置
// 的只是"结合后与串行逐位相同"的那几种归约：
//
//   - 整数加法（模算术，任意结合顺序结果相同）；
//   - `max` / `min`（取极值，与顺序无关，浮点也一样精确）。
//
// 浮点 `sum` 不在此列：分块改变了加法结合顺序，浮点加法不结合，所以并行合并的结果不能同时
// 保证"与从左到右串行逐位相同"。浮点求和仍走 `sum`（串行）或"先算进数组再 `sum`"。
//
// 前置条件：`parts.len <= a.len`（每段至少一个元素，`max`/`min` 才有初值）；不满足时返回
// `none`。段长是 `ceil(a.len / parts.len)`，固定不变 ⇒ 同一个 `parts.len` 下结果可复现。

/** @brief 固定分块的整数求和：每段之和写进 `parts[b]`，再按段序串行合并。
 *
 *  @param a     参与求和的只读视图。
 *  @param parts 每段结果的输出视图（长度 = 段数，必须 `<= a.len`）。
 *  @return 总和；`a` 或 `parts` 为空、或 `parts.len > a.len` 时是 `none`。
 */
fn sumBlocksI64(a: slice<i64>, parts: mut slice<i64>) -> ?i64 {
    if a.len == 0 { return none }
    if parts.len == 0 { return none }
    if parts.len > a.len { return none }
    let blk: i64 = (a.len + parts.len - 1) / parts.len
    par b in 0..parts.len {
        let lo: i64 = b * blk
        var hi: i64 = lo + blk
        if hi > a.len { hi = a.len }
        var s: i64 = 0
        var i: i64 = lo
        while i < hi {
            s = s + a[i]
            i = i + 1
        }
        parts[b] = s
    }
    var t: i64 = 0
    var j: i64 = 0
    while j < parts.len {
        t = t + parts[j]
        j = j + 1
    }
    return some(t)
}

/** @brief 固定分块的 `f64` 求最大值：每段的极值写进 `parts[b]`，再按段序合并。
 *
 *  @param a     参与比较的只读视图。
 *  @param parts 每段结果的输出视图（长度 = 段数，必须 `<= a.len`）。
 *  @return 最大值；`a` 或 `parts` 为空、或 `parts.len > a.len` 时是 `none`。
 */
fn maxBlocksF64(a: slice<f64>, parts: mut slice<f64>) -> ?f64 {
    if a.len == 0 { return none }
    if parts.len == 0 { return none }
    if parts.len > a.len { return none }
    let blk: i64 = (a.len + parts.len - 1) / parts.len
    par b in 0..parts.len {
        let lo: i64 = b * blk
        var hi: i64 = lo + blk
        if hi > a.len { hi = a.len }
        var m: f64 = a[lo]
        var i: i64 = lo + 1
        while i < hi {
            if a[i] > m { m = a[i] }
            i = i + 1
        }
        parts[b] = m
    }
    var t: f64 = parts[0]
    var j: i64 = 1
    while j < parts.len {
        if parts[j] > t { t = parts[j] }
        j = j + 1
    }
    return some(t)
}

/** @brief 固定分块的 `f64` 求最小值：每段的极值写进 `parts[b]`，再按段序合并。
 *
 *  @param a     参与比较的只读视图。
 *  @param parts 每段结果的输出视图（长度 = 段数，必须 `<= a.len`）。
 *  @return 最小值；`a` 或 `parts` 为空、或 `parts.len > a.len` 时是 `none`。
 */
fn minBlocksF64(a: slice<f64>, parts: mut slice<f64>) -> ?f64 {
    if a.len == 0 { return none }
    if parts.len == 0 { return none }
    if parts.len > a.len { return none }
    let blk: i64 = (a.len + parts.len - 1) / parts.len
    par b in 0..parts.len {
        let lo: i64 = b * blk
        var hi: i64 = lo + blk
        if hi > a.len { hi = a.len }
        var m: f64 = a[lo]
        var i: i64 = lo + 1
        while i < hi {
            if a[i] < m { m = a[i] }
            i = i + 1
        }
        parts[b] = m
    }
    var t: f64 = parts[0]
    var j: i64 = 1
    while j < parts.len {
        if parts[j] < t { t = parts[j] }
        j = j + 1
    }
    return some(t)
}

/* stdlib/stl/sort.extc —— `sort<T>`：原地比较排序（introsort，显式栈版）
 *
 * **为什么是 introsort**：快排的平均常数最好，但纯快排遇到"每次都取到极端枢轴"会退化成
 * O(n²)；这里用 median-of-three 把常见的有序/逆序输入压平，再用**递归深度上限**（2·log2 n）
 * 兜底：一旦超限就把那一段交给 heapsort（原地、最坏 O(n log n)）。这条兜底是**承诺**而不是
 * 优化 —— 没有它，排序就是一个能被人用输入打挂的接口。小区间（≤ 12）走插入排序：那个规模上
 * 快排的递归与分支都不划算，而插入排序对"几乎有序"的尾段尤其快。
 *
 * **为什么整段写在一个函数里**：划分、下沉、插入排序共享同一份比较协议与显式栈，拆成
 * 几个泛型辅助函数只是形态上的拆分；等另一处也要同一份 helper 时再抽（泛型函数之间可以
 * 互调，`tests/generics/deferred_op_through_call.extc` 守着这条）。这里用**显式栈**而不是
 * 递归：栈是 64 项定长数组，无堆分配。
 *
 * **不承诺稳定**：稳定排序要么额外缓冲（归并），要么额外搬运（旋转）—— 与"原地、无分配"
 * 冲突。要稳定就带上序号当第二键，或用保持插入顺序的容器。
 *
 * 比较用键上的 `<`（与 `map` 同一协议：类型参数上的运算符检查推迟到实例化）。
 * 复杂度：时间 O(n log n) 最坏 / O(n log n) 平均；无堆分配（栈是 64 项定长数组，
 * 由"大的一半入栈、小的一半继续"保证深度 ≤ log2 n + 1）。
 */

const SMALL: i64 = 12          /* 这个规模以下走插入排序 */

/* 把整条 `a` 排成非降序。 */
fn sort<T>(a: mut slice<T>) {
    let n = a.len
    if n < 2 { return }

    /* 深度上限 ≈ 2·log2(n)：超限的那一段改用 heapsort 收尾。 */
    var dmax: i64 = 2
    var m: i64 = n
    while m > 1 { dmax = dmax + 2  m = m / 2 }

    var loS: [64]i64
    var hiS: [64]i64
    var dS: [64]i64
    var sp: i64 = 1
    loS[0] = 0
    hiS[0] = n
    dS[0] = dmax

    while sp > 0 {
        sp = sp - 1
        var lo: i64 = loS[sp]
        var hi: i64 = hiS[sp]
        var d: i64 = dS[sp]

        /* 大区间：划分/下沉都在这个循环里内联（见文件头"为什么写在一个函数里"）。 */
        while hi - lo > SMALL {
            if d == 0 {
                /* ---- heapsort [lo, hi)：O(n log n) 最坏，原地 ---- */
                let cnt: i64 = hi - lo
                var k: i64 = cnt / 2
                while k > 0 {
                    k = k - 1
                    var r: i64 = k
                    while r * 2 + 1 < cnt {
                        var c: i64 = r * 2 + 1
                        if c + 1 < cnt && a[lo + c] < a[lo + c + 1] { c = c + 1 }
                        if a[lo + r] < a[lo + c] {
                            let t = a[lo + r]  a[lo + r] = a[lo + c]  a[lo + c] = t
                            r = c
                        } else {
                            r = cnt
                        }
                    }
                }
                var e: i64 = cnt - 1
                while e > 0 {
                    let t = a[lo]  a[lo] = a[lo + e]  a[lo + e] = t
                    var r: i64 = 0
                    while r * 2 + 1 < e {
                        var c: i64 = r * 2 + 1
                        if c + 1 < e && a[lo + c] < a[lo + c + 1] { c = c + 1 }
                        if a[lo + r] < a[lo + c] {
                            let u = a[lo + r]  a[lo + r] = a[lo + c]  a[lo + c] = u
                            r = c
                        } else {
                            r = e
                        }
                    }
                    e = e - 1
                }
                lo = hi
            } else {
                d = d - 1
                /* ---- median-of-three：把中位数换到 `lo`，另外两个排好 ---- */
                let mid: i64 = lo + (hi - lo) / 2
                if a[mid] < a[lo] { let t = a[mid]  a[mid] = a[lo]  a[lo] = t }
                if a[hi - 1] < a[mid] {
                    let t = a[hi - 1]  a[hi - 1] = a[mid]  a[mid] = t
                    if a[mid] < a[lo] { let u = a[mid]  a[mid] = a[lo]  a[lo] = u }
                }
                let t0 = a[lo]  a[lo] = a[mid]  a[mid] = t0
                let pivot = a[lo]
                /* ---- Hoare 划分（哨兵式）：**每轮先走一步再扫**。
                 *
                 * ⚠️ 这里踩过一次：原来的写法是"先扫再交换、条件不满足就原地不动"
                 * （`while i <= j && …`），遇到**全相等**的输入会 `i == j` 且两侧扫描都不动 ⇒
                 * 外层循环死转（`n=50` 就挂住，`--run` 超时）。经典 Hoare 必须保证每轮至少前进
                 * 一步；而"至少前进一步"的扫描不会跑出边界，是因为 median-of-three 已经保证了
                 * `a[lo] <= pivot <= a[hi-1]`（两侧天然有哨兵）。 */
                var i: i64 = lo
                var j: i64 = hi
                var running: bool = true
                while running {
                    i = i + 1
                    while a[i] < pivot { i = i + 1 }
                    j = j - 1
                    while pivot < a[j] { j = j - 1 }
                    if i >= j {
                        running = false
                    } else {
                        let t = a[i]  a[i] = a[j]  a[j] = t
                    }
                }
                let t1 = a[lo]  a[lo] = a[j]  a[j] = t1
                /* ---- 大的一半入栈、小的一半继续循环 ⇒ 栈深 O(log n) ---- */
                if j - lo < hi - (j + 1) {
                    loS[sp] = j + 1  hiS[sp] = hi  dS[sp] = d  sp = sp + 1
                    hi = j
                } else {
                    loS[sp] = lo  hiS[sp] = j  dS[sp] = d  sp = sp + 1
                    lo = j + 1
                }
            }
        }

        /* 小区间：插入排序。元素**拷贝**出来（T 可能是结构体，拿引用会在搬移中失效）。 */
        var i: i64 = lo + 1
        while i < hi {
            let x = a[i]
            var j: i64 = i
            while j > lo && x < a[j - 1] {
                a[j] = a[j - 1]
                j = j - 1
            }
            a[j] = x
            i = i + 1
        }
    }
}

/* 判据用的读数：整条已经非降序吗（一趟 O(n)）。 */
fn isSorted<T>(a: slice<T>) -> bool {
    var i: i64 = 1
    while i < a.len {
        if a[i] < a[i - 1] { return false }
        i = i + 1
    }
    return true
}
