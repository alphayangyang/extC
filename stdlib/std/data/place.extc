/* std/data/place.extc —— `@place` 的公共面：查、还、核对寿命
 *
 * 一个标了 `@place` 的类型说："我的存储住在**一个地方**（今天是一个池），那个地方比我活得久"。
 * 地方由运行期注册表管；这个模块把它的**非视图**部分包装成普通函数，用户容器不必知道
 * `std::sys::pool` 那一层的 `extc_pool_*` 名字。
 *
 * **建池不在这个模块里**，这是有原因的：函数体会为池分配开一层自己的地方，池于是随它返回而死。
 * 建池必须发生在"调用者的地方"里，也就是**你自己的 `@place` 类型自己的构造函数里**（关联函数
 * 不另开地方）；`@inline` 不改变这一点（内联的是代码，不是寿命）。所以创建走
 * `std::sys::pool` 的两三条原语，读/还/核对走这里。
 *
 * 同理，**返回视图**的原语（`poolSlice<T>` / `poolSliceRaw<T>` / `poolResize<T>` /
 * `poolResizeRaw<T>` / `poolGive<T>`）是编译器内建而不是库函数：C 里声明不出"返回
 * `slice<T>`"，而包一层普通函数会丢掉"这个视图是这个类型自己那个地方的"这条知识，赋给字段时
 * 会被逃逸检查拒绝。在方法体里按名字直接调用它们即可。
 *
 * @code
 * use std::io
 * use std::data::place as place
 * use std::sys::pool as syspool
 *
 * @place
 * struct grow {
 *     @private vals: mut slice<i64>
 *     @private n:    i64
 *     @private cap:  i64
 *     @private pid:  i64
 *     fn withCap(c: i64) -> grow {
 *         let pid: i64 = syspool::extc_pool_new(-1)
 *         var g: grow = { vals: poolSliceRaw<i64>(pid, c), n: 0, cap: c, pid: pid }
 *         return g
 *     }
 *     fn push(self: mut ref grow, v: i64) {
 *         if self.n == self.cap {
 *             let nc: i64 = self.cap + self.cap / 2 + 1
 *             self.vals = poolResizeRaw<i64>(self.pid, self.vals, nc)
 *             self.cap = nc
 *         }
 *         self.vals[self.n] = v
 *         self.n = self.n + 1
 *     }
 * }
 *
 * fn main() -> i32 {
 *     var g: grow = grow::withCap(2)
 *     var i: i64 = 0
 *     while i < 100 { g.push(i)  i = i + 1 }
 *     io::cout << "n=" << g.n << " bytes=" << place::bytes(g.pid) << "\n"
 *     return 0
 * }
 * @endcode
 */

use std::sys::pool as syspool

/* 地方的世代：每次重置 +1。容器把它与 id 一起存下来，"陈旧拷贝不许误放"的判据就是它。
 * 还回去之前比对世代，就是库级容器里那条 `if gen == self.pidGen`。 */
fn generation(pid: i64) -> u64 {
    return syspool::extc_pool_generation(pid)
}

/* 一个地方当前占着的字节数。判"容器在长、但不再留旧的"就看它：增长后它应当只按新容量涨，
 * 而不是按"历次容量之和"涨。 */
fn bytes(pid: i64) -> i64 {
    return syspool::extc_pool_bytes(pid)
}

/* 运行期所有地方占着的字节数。判"容器退出后有没有漏"就比它进出两次。 */
fn liveBytes() -> i64 {
    return syspool::extc_pool_bytesLive()
}

/* 把一块借自地方的字节还给地方（`poolGive<T>` 内建的薄包装：参数与返回都是标量形状）。 */
fn give<T>(pid: i64, s: mut slice<T>) -> bool {
    return poolGive<T>(pid, s)
}

/* 当场还掉一个地方（连同它的板块）。只给自己建的、且确定不再用的地方用；正常路径靠所在域退出
 * 整批收回，不需要它。 */
fn free(pid: i64) {
    syspool::extc_pool_drop(pid)
}
