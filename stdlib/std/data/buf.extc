/* std/data/buf.extc —— 拥有存储的可增长缓冲区（`buf<T>`）
 *
 * **一个不变量**：每个 `buf` 恰好持有一片**地址预留**，元素 `i` 的地址永远是 `base + i*sizeof(T)`。
 * 预留是地址空间，不是内存：没有写过的页不驻留。于是
 *   - 在预留内增长（`push` 超过容量）**不拷贝**，只把长度往前推，页由第一次写触发提交；
 *   - 只有长度撞到预留上限（`max`）时才搬一次家：新预留按 16 倍长，拷 `len` 个元素，旧的当场还掉；
 *   - `shrink(k)` 把 `[k, cap)` 的页还给操作系统（`madvise(DONTNEED)`），地址不变，再次写会重新提交；
 *   - `@drop release` 把整片预留还给分配器 —— 这是「旧代不会留在堆上」的兑现点。
 *
 * 与 `vector<T>` 的区别只在两件事：所有权（`@noCopy`，值位置出现是转移）与容量语义（预留 + 原地长）。
 * `vector` 的存储来自池块，只能靠 `poolResize` 原块加长；`buf` 的存储来自自己的预留，
 * 增长不需要分配器参与，所以「增长」与「换一块」被分开了。
 *
 * `borrow()` 是**冻结位**的库级形式：借出期间要改变存储身份（搬家）会在运行期 `trap`，
 * 而不是让旧视图静默读到已经被分配器收回的字节。同块内「借出后增长」在编译期就被拒，
 * 跨函数/跨块的情形由这个守卫兜住 —— 编译器一条都没参与。
 *
 * 三个 C 入口（`extc_buf_reserve` / `extc_buf_release` / `extc_buf_discard`）来自编译器，
 * 因为它们要指针算术与整数转指针（2 MiB 对齐、`madvise`、把内部地址折回页首），语言故意不开这两样；
 * **策略**（留多少、何时长、何时搬、长度多少）全在这个结构体里，C 侧不认识任何策略。
 *
 * @code
 * use std::io
 * use std::data::buf
 *
 * fn main() -> i32 {
 *     var b: buf<i64> = buf<i64>::withCap(4)
 *     var i: i64 = 0
 *     while i < 10 { b.push(i)  i = i + 1 }
 *     println("len=", b.len(), " cap=", b.capacity(), " last=", b.view()[9],
 *             " moves=", b.relocations(), " live=", buf::bufLive())
 *     return 0
 * }
 * @endcode
 */

use std::sys::heap as sysheap

/* 三个 C 入口 + 一格账本。**都声明在这个模块里**，不在 `std::sys::heap`：预留要把区间对齐到
 * 2 MiB 并 `madvise(MADV_HUGEPAGE)`，丢页要把「偏离页首」的地址折回页首 —— 两者都需要指针
 * 算术与整数转指针，而语言故意不开这两样，所以这三格只能由编译器给（`src/back/bufrt.c`）。
 * 声明的位置就是触发器：只有真用了 `buf` 的程序才会把它们扫到，才发射那块 C 代码
 * （`src/back/cg/190-lambda-envs.inc` 按 `externLib == "extc-buf"` 点亮 `needBuf`）。
 * 策略（留多少、何时长、何时搬、长度多少）全在这个文件里，C 侧不知道任何策略。 */
extern!("extc-buf") fn extc_buf_reserve(bytes: u64) -> ?ref u8 effects Addr=0 Cont=0
/* 密排槽：小载荷（<= 64 KiB）从 16 B..64 KiB 的 13 个尺寸类里拿一个槽。槽与邻居共页，
 * 所以一个 32 字节的缓冲值占 32 字节，而不是一个 2 MiB 量子。归还走同一个 `extc_buf_release`：
 * C 侧按地址查类，命中就走尺寸类链，否则走 buddy。 */
extern!("extc-buf") fn extc_buf_slotReserve(bytes: u64) -> ?ref u8 effects Addr=0 Cont=0
extern!("extc-buf") fn extc_buf_release(at: ref u8, bytes: u64) -> i32 effects Addr=0 Cont=0
extern!("extc-buf") fn extc_buf_discard(at: ref u8, bytes: u64) -> i32 effects Addr=0 Cont=0
/* 一片预留**实际**拿到多少字节（按 2 MiB 量子取整后的块大小）；不是 arena 块时返回 0。 */
extern!("extc-buf") fn extc_buf_span(at: ref u8) -> i64 effects Addr=0 Cont=0
/* 活着的缓冲区一共预留了多少**地址空间**（不是驻留内存）：给泄漏判据用的一格。 */
extern!("extc-buf") fn extc_buf_live() -> i64 effects Addr=0 Cont=0
/* 结构动作（丢元素 / 交还预留 / 搬家）撤销 `[from, to)` 这些元素里引用域的外部边登记：
 * 含引用的 `T` 每个引用槽在回收运行期里有一条登记，元素被丢掉时必须跟着撤，否则那块存储
 * 会把已经丢掉的值一直当成标记根（被复用的缓冲区就成了无界根集）。不含引用的 `T` 没有登记，
 * 这一次调用只是一次空表检查。 */
extern!("extc-buf") fn extc_buf_releaseRefs(at: ref u8, esz: i64, from: i64, to: i64) -> i32 effects Addr=0 Cont=0

/* 预留策略的常数。写成字面量而不是 `i64(2097152)`：带检查的转换会让静态初始化器不是常量
 * （与 `std/mem.extc` 的 PAGE/CHUNK 同一条理由）。 */
let BUF_FLOOR_BYTES: i64 = 2097152      /* 小缓冲区也至少留 2 MiB 地址空间（大页的量子） */
let BUF_MAX_BYTES: i64 = 1073741824     /* 一次预留不超过 1 GiB 字节 */
let BUF_HEADROOM: i64 = 16              /* 搬家时按 16 倍长留，够装下「终值远大于当前」的情形 */
let BUF_MOVE_BYTES: i64 = 2097152       /* 搬家每拷这么多字节就丢掉源的一段页（峰值 = 一份 + 一块） */
let BUF_SLOT_BYTES: i64 = 65536         /* 载荷不超过这么多字节时走密排槽，超过就走 2 MiB 量子的预留 */

/* 尺寸类：16 B 起、每次翻倍，13 类到 64 KiB。返回值 >= want（want >= 1）。 */
@private
fn bufClassBytes(want: i64) -> i64 {
    var c: i64 = 16
    while c < want { c = c * 2 }
    return c
}

@noCopy
@buffer
struct buf<T> {
    @private mem:      mut slice<u8>   /* 整片预留（len = reserved 字节）；视图不碰内存，所以 PROT_NONE 也拿得住 */
    @private vals:     mut slice<T>    /* 预留的类型化视图，len = cap */
    @private reserved: u64             /* 预留字节数（已按页取整） */
    @private moves:    i64             /* 存储搬过几次家：可观测的「增长代价」计数 */
    @private n:        i64             /* 已用长度 */
    @private cap:      i64             /* 预留内已承诺的容量（页由写触发提交） */
    @private max:      i64             /* 预留最多装几个元素：撞到就搬家 */
    @private pins:     i64             /* 活着的 `borrow()` 守卫个数：> 0 时不许换存储 */
    /* 撤销 `[from, to)` 这些元素的引用域登记（见 `extc_buf_releaseRefs`）。`to <= from` 时空转：
     * `pop` 不撤（取出的元素由调用方持有），那一条登记在该槽下一次被写时改正。 */
    @private
    fn dropRefs(self: ref buf<T>, from: i64, to: i64) {
        if to <= from { return }
        let esz: i64 = extc_sizeOf<T>()
        let _r: i32 = extc_buf_releaseRefs(self.mem.data, esz, from, to)
    }

    /** @brief 交还整片预留。离开作用域、被覆盖、或函数中途返回时由编译器发出；也可以现在就调。
     *
     * 对本对象的第二次调用是空操作（`reserved` 已经是 0），所以 `release()` 之后即使
     * `@drop` 再发一次也不会重复归还。这是「提前还」的公开入口：想在块中途把大预留还给
     * 分配器（而不是等作用域结束）时用它。 */
    @drop
    fn release(self: mut ref buf<T>) {
        if self.reserved > u64(0) {
            self.dropRefs(0, self.n)
            elemDrop<T>(self.vals, 0, self.n)
            if extc_buf_release(self.mem.data, self.reserved) != 0 {
                trap("buf: cannot give the reservation back")
            }
        }
        self.reserved = u64(0)
        self.cap = 0
        self.n = 0
    }

    /** @brief 建一个容量为 `c` 的缓冲区（至少 1），并一次留够 16 倍 `c` 的地址空间。 */
    fn withCap(c: i64) -> buf<T> {
        let esz: i64 = extc_sizeOf<T>()
        var cc: i64 = c
        if cc < 1 { cc = 1 }
        /* 小载荷走密排槽：一次拿一个够装 cc 个元素的类（16 B..64 KiB），没有 2 MiB 量子的底。
         * 容量上限就是这个类的容量，之后的增长按「下一类」翻倍搬家；同类的槽密排在同一个量子里。 */
        let wantBytes: i64 = cc * esz
        if wantBytes <= BUF_SLOT_BYTES {
            var cb: i64 = bufClassBytes(wantBytes)
            var raw0: ?ref u8 = extc_buf_slotReserve(u64(cb))
            if raw0 == null { trap("buf: cannot reserve storage") }
            var sp0: i64 = cb
            if raw0 != null {
                let got0: i64 = extc_buf_span(raw0)
                if got0 > sp0 { sp0 = got0 }
            }
            var mem0: mut slice<u8> = sysheap::extc_viewOf(raw0, sp0)
            var vals0: mut slice<T> = extc_viewOfT<T>(mem0.data, cc)
            var b0: buf<T> = {
                mem:      mem0,
                vals:     vals0,
                reserved: u64(sp0),
                moves:    0,
                n:        0,
                cap:      cc,
                max:      sp0 / esz,
                pins:     0,
            }
            return b0
        }
        /* 预留上限（元素数）：至少装得下 cc，按 1 GiB 字节封顶，小量按 2 MiB 字节起。 */
        var floorElems: i64 = BUF_FLOOR_BYTES / esz
        if floorElems < 1 { floorElems = 1 }
        var limElems: i64 = BUF_MAX_BYTES / esz
        if limElems < cc { limElems = cc }
        var mx: i64 = cc * BUF_HEADROOM
        if mx < floorElems { mx = floorElems }
        if mx > limElems { mx = limElems }
        let bytes: u64 = u64(mx * esz)
        var raw: ?ref u8 = extc_buf_reserve(bytes)
        if raw == null { trap("buf: cannot reserve address space") }
        /* 账本记的是**实际**拿到的块（量子取整），所以容量上限也按它算：一个 512 字节的 buf
         * 实际握着 2 MiB 地址空间，`maxCapacity()` 必须说 2 MiB，不能说 512 字节。 */
        var span: i64 = i64(bytes)
        if raw != null {
            let got: i64 = extc_buf_span(raw)
            if got > span { span = got }
        }
        var realMax: i64 = span / esz
        var mem: mut slice<u8> = sysheap::extc_viewOf(raw, span)
        var vals: mut slice<T> = extc_viewOfT<T>(mem.data, cc)
        var b: buf<T> = {
            mem:      mem,
            vals:     vals,
            reserved: u64(span),
            moves:    0,
            n:        0,
            cap:      cc,
            max:      realMax,
            pins:     0,
        }
        return b
    }

    /** @brief 元素个数。 */
    @inline
    fn len(self: ref buf<T>) -> i64 { return self.n }

    /** @brief 当前承诺的容量（不含搬家）。 */
    @inline
    fn capacity(self: ref buf<T>) -> i64 { return self.cap }

    /** @brief 这片预留最多装几个元素：超过它就要搬一次家。 */
    @inline
    fn maxCapacity(self: ref buf<T>) -> i64 { return self.max }

    /** @brief 存储搬过几次家（每次搬家拷一次当时的长；这是「增长代价」的可观测计数）。 */
    @inline
    fn relocations(self: ref buf<T>) -> i64 { return self.moves }

    /** @brief 整片预留的地址空间字节数（不是驻留内存）。 */
    @inline
    fn reservedBytes(self: ref buf<T>) -> u64 { return self.reserved }

    /** @brief 只读视图：`[0, len)`。它在视野里的期间改容量是编译错误。 */
    @inline
    fn view(self: ref buf<T>) -> slice<T> { return self.vals[0..self.n] }

    /** @brief 可写视图：`[0, len)`。 */
    @inline
    fn viewMut(self: mut ref buf<T>) -> mut slice<T> { return self.vals[0..self.n] }

    /** @brief 追加一个元素；容量不够时在预留内原地长（不拷贝），撞到预留上限才搬一次家。 */
    @inline
    fn push(self: mut ref buf<T>, v: T) {
        if self.n == self.cap { self.reserve(1) }
        self.vals[self.n] = v
        self.n = self.n + 1
    }

    /** @brief 弹出最后一个元素；空的时候返 `none`。 */
    @inline
    fn pop(self: mut ref buf<T>) -> ?T {
        if self.n == 0 { return none }
        self.n = self.n - 1
        self.dropRefs(self.n, self.n + 1)
        /* Move the element out and leave a **zero** behind: the slot belongs to the container
         * again, and a zero value runs no hook when it is later overwritten or cleared. */
        return some(elemTake<T>(self.vals, self.n))
    }

    /** @brief 保证还能再放 `more` 个元素（长度不变）。预留内原地长，撞上限才搬家。 */
    fn reserve(self: mut ref buf<T>, more: i64) {
        let want: i64 = self.n + more
        if want <= self.cap { return }
        if self.pins > 0 { trap("this buffer is frozen by a live borrow") }
        if want <= self.max {
            /* 预留内长：地址不动，只把承诺的容量往前推。页由第一次写触发提交，
             * 所以这里一次分配、一次拷贝都没有（`relocations()` 不动）。 */
            var ncap: i64 = self.cap + self.cap / 2
            if ncap < 4 { ncap = 4 }
            if ncap < want { ncap = want }
            if ncap > self.max { ncap = self.max }
            self.cap = ncap
            self.vals = extc_viewOfT<T>(self.mem.data, self.cap)
            return
        }
        self.moveTo(want)
    }

    /** @brief 搬到更大的预留：新预留按 16 倍长（封顶 1 GiB 字节），拷 `len` 个元素，旧的当场还掉。 */
    @private
    fn moveTo(self: mut ref buf<T>, want: i64) {
        let esz: i64 = extc_sizeOf<T>()
        let wantBytes: i64 = want * esz
        /* 小载荷在类之间搬家：新类至少装得下 want，且至少是当前字节的两倍（几何增长，
         * 于是「按类翻倍」与 C++ 的 2 倍增长同价）；大载荷照旧按 16 倍预留一次留够。 */
        let slotMove: bool = wantBytes <= BUF_SLOT_BYTES
        var bytes: u64 = u64(0)
        if slotMove {
            var target: i64 = wantBytes
            if self.reserved > u64(0) {
                let dbl: i64 = i64(self.reserved) * 2
                if dbl > target { target = dbl }
            }
            var cb: i64 = bufClassBytes(target)
            if cb > BUF_SLOT_BYTES { cb = BUF_SLOT_BYTES }
            bytes = u64(cb)
        } else {
            var limElems: i64 = BUF_MAX_BYTES / esz
            if limElems < want { limElems = want }
            var nmax: i64 = self.max * BUF_HEADROOM
            if nmax > limElems { nmax = limElems }
            if nmax < want { nmax = want }
            if nmax < self.max { nmax = self.max }
            bytes = u64(nmax * esz)
        }
        var raw: ?ref u8 = null
        if slotMove { raw = extc_buf_slotReserve(bytes) } else { raw = extc_buf_reserve(bytes) }
        if raw == null { trap("buf: cannot reserve address space") }
        var span: i64 = i64(bytes)
        if raw != null {
            let got: i64 = extc_buf_span(raw)
            if got > span { span = got }
        }
        var realMax: i64 = span / esz
        var nmem: mut slice<u8> = sysheap::extc_viewOf(raw, span)
        var nvals: mut slice<T> = extc_viewOfT<T>(nmem.data, realMax)
        /* 拷一段、丢一段：**已拷过的源页当场还给操作系统**。于是搬家的瞬时峰值是
         * 「一份 + 一块」，而不是「旧代 + 新代」—— 这正是容量界 M <= live + O(1) 的来源。 */
        var chunk: i64 = BUF_MOVE_BYTES / esz
        if chunk < 1 { chunk = 1 }
        var done: i64 = 0
        while done < self.n {
            var cn: i64 = self.n - done
            if cn > chunk { cn = chunk }
            copyInto<T>(nvals[done .. done + cn], self.vals[done .. done + cn], cn)
            var srcHere: mut slice<u8> = self.mem[done * esz .. self.n * esz]
            let dropBytes: u64 = u64(((cn * esz) / 4096) * 4096)
            if dropBytes > u64(0) { extc_buf_discard(srcHere.data, dropBytes) }
            done = done + cn
        }
        self.dropRefs(0, self.n)
        let oldAt: ref u8 = self.mem.data
        let oldBytes: u64 = self.reserved
        self.mem = nmem
        self.vals = nvals
        self.reserved = u64(span)
        self.max = realMax
        self.cap = realMax
        self.moves = self.moves + 1
        if extc_buf_release(oldAt, oldBytes) != 0 {
            trap("buf: cannot give the old reservation back")
        }
    }

    /** @brief 长度改成 `k`（不超过当前长度），并把 `[k, cap)` 的页还给操作系统。
     *
     * 地址不变、容量变成 `k`：之后在预留内再 push 会重新提交那些页（内容为零），
     * 所以「借出去的视图」看到的地址仍是同一个 —— 但它看到过的字节不再有效。 */
    fn shrink(self: mut ref buf<T>, k: i64) {
        if k < 0 { trap("buf: shrink needs a length >= 0") }
        var kk: i64 = k
        if kk > self.n { kk = self.n }
        self.dropRefs(kk, self.n)
        elemDrop<T>(self.vals, kk, self.n)
        if kk < self.cap {
            let esz: i64 = extc_sizeOf<T>()
            var tail: mut slice<u8> = self.mem[kk * esz .. self.cap * esz]
            let drop: u64 = u64((self.cap - kk) * esz)
            if extc_buf_discard(tail.data, drop) != 0 {
                trap("buf: cannot give pages back")
            }
            self.cap = kk
            self.vals = extc_viewOfT<T>(self.mem.data, kk)
        }
        self.n = kk
    }

    /** @brief 清空长度，预留与页都留着（下一次 `push` 直接复用）。要还页用 `shrink(0)`。 */
    @inline
    fn clear(self: mut ref buf<T>) {
        self.dropRefs(0, self.n)
        elemDrop<T>(self.vals, 0, self.n)
        self.n = 0
    }

    /** @brief 借出：返回一个守卫，它在作用域里期间这块存储不许搬家。 */
    fn borrow(self: mut ref buf<T>) -> borrowGuard<T> {
        self.pins = self.pins + 1
        return { b: self, p: ref self.pins }
    }

    /** @brief 复制一份独立存储（另一个 `buf`，两者之后互不影响）。
     *
     * 逐槽写入，而不是 `out.push(self.vals[i])`：push 的形参是一次**移动**，把元素从
     * `self` 的存储里搬走；而 clone 只是要一份拷贝。写成视图元素赋值之后，模板在实例化时
     * 会检查"这次写入是不是移动"—— 源是另一个视图的元素（不是名字，不能移动）⇒ 元素类型
     * 自己拥有预留时，`clone` 在编译期被拒，而不是拷出一份共享所有权的值。 */
    fn clone(self: ref buf<T>) -> buf<T> {
        var out: buf<T> = buf<T>::withCap(self.n)
        var i: i64 = 0
        while i < self.n { out.vals[i] = self.vals[i]  i = i + 1 }
        out.n = self.n
        return out
    }
}

/** @brief 进程当前为所有活着的 `buf` 预留了多少**地址空间**（不是驻留内存）。
 *
 * 一个数就够写泄漏判据：块前块后相等，说明 `@drop` 把预留全还了。 */
fn bufLive() -> i64 { return extc_buf_live() }

/** @brief `buf::borrow()` 的守卫：活着的时候缓冲区的存储被冻结。 */
@noCopy
struct borrowGuard<T> {
    @private b: ref buf<T>
    @private p: mut ref i64

    @private
    @drop
    fn release(self: mut ref borrowGuard<T>) { *self.p = *self.p - 1 }

    /** @brief 只读视图：与 `buf::view()` 相同，但受守卫保护。 */
    fn view(self: ref borrowGuard<T>) -> slice<T> { return self.b.vals[0..self.b.n] }

    /** @brief 元素个数。 */
    fn len(self: ref borrowGuard<T>) -> i64 { return self.b.n }
}