/* stl/map.extc -- `map<K, V>`: an ORDERED map, implemented as a B+tree.
 *
 * WHY THIS SHAPE: an in-memory ordered map is bound by cache
 * misses, not by comparisons. A binary tree over 10^6 keys is ~20 pointer chases per lookup; a
 * B+tree with 16 keys per node is ~5, and every step is a binary search inside ONE contiguous
 * array. Ordered iteration is the leaf chain, so it is a linear scan of contiguous memory. Small
 * maps fall out of the same shape for free: with 16 keys per node, any map up to 16 entries IS a
 * single sorted array, which is the fastest representation at that size -- no separate fast path.
 *
 * Layout
 *   - a node holds up to `ORDER` (16) settled keys in one slice (17 slots, so an insert can
 *     land before the split), plus `ORDER + 2` child id slots when internal;
 *     ids are indices into `nodes`, never pointers, so the array can double and the whole tree
 *     stays relocatable (and, in stage 3, shrinkable);
 *   - `keys[i]` of an internal node is the SMALLEST key of subtree `kids[i + 1]`, so a child owns
 *     the half-open range [keys[i-1], keys[i]); a descent picks the first `i` with `k < keys[i]`;
 *   - leaves hold the values and are chained left to right through `next` -- that chain is what
 *     makes the ordered walk a scan;
 *   - `cnt` is the number of keys in a subtree and is maintained through every split, which is what
 *     makes `keyAt` / `valAt` / `lowerBound` rank queries O(log n) instead of a walk.
 *
 * Ordering comes from the KEY TYPE: `a < b` (a method `fn <` for a struct key, built in for the
 * numeric types). Equality is derived -- `a == b` iff `!(a < b) && !(b < a)` -- so a key type
 * supplies one operator and the ordered map works for any type that has it.
 *
 * Insert (splits up to a new root), lookup, rank queries and the ordered walk are complete, and
 * `remove` rebalances -- a node under `HALF` entries borrows from a sibling that can spare one,
 * otherwise it merges, and every node a merge retires goes back on a free list for the next split
 * to reuse. The stores and the node records live in one set of owned flat blocks (`release` /
 * `shrink` hand them back), so the free list holds ids, not storage. *
 * @code
 * use std::io
 * use std::data::map
 *
 * fn main() -> i32 {
 *     var m: map<i64, i32> = map<i64, i32>::withCap(4)
 *     m.put(30, i32(300))
 *     m.put(10, i32(100))
 *     let v: i32 = m.get(10) ?? i32(-1)
 *     io::cout << "v=" << v << " len=" << m.len() << " rank10=" << m.lowerBound(10) << "\n"
 *     return 0
 * }
 * @endcode
 */
use std::data::dense::{block}    /* 容器的平坦列：拥有的类型化块（见 `std::data::dense`） */

const ORDER: i64 = 16        /* max keys per node (the array sizes in `newNode` are these numbers) */
const HALF:  i64 = 8         /* min keys per non-root node once stage 2b rebalances */
const SCRATCH: i64 = 32      /* 下降路径与子槽选择的草稿长度：树高上限之上的常数，够用不增长 */

@noCopy
struct map<K, V> {
    /* 七块**拥有的**平坦存储，容量固定、整块归还（`dense::block<T>`）：键列、值列、子列，
     * 加上节点的四个标量列（键数 / 子树键数 / 是否叶子 / 后继）。节点 `id` 的 17 个键槽是
     * `keys[id * 17 ..]`、18 个子槽是 `kids[id * 18 ..]`；偏移只跟 id 有关、与容量无关，所以
     * 存储增长时没有任何节点视图需要重挂，`put` 的分裂循环里也没有任何分配。
     * 块内存是复用的脏内存 ⇒ 写一律走 `elemPut`（不给旧字节跑钩子），读只读 `[0, used)`。 */
    @private keys: block<K>
    vals: block<V>
    @private kids: block<i32>
    @private kn_:  block<i32>          /* 每个节点的键数 */
    @private kc:   block<i32>          /* 每个节点子树的键数 */
    @private kl:   block<u8>           /* 每个节点是不是叶子（0/1） */
    @private kx:   block<i32>          /* 叶链 / 空闲链的后继，-1 结尾 */
    @private nnodes: i64
    @private ncap:   i64               /* nodes the stores have room for */
    @private root:   i32
    @private freeHead: i32             /* chain of recycled nodes (through `kx`), -1 when empty */
    @private n:      i64               /* live entries */
    @private path:   block<i32>        /* scratch: the descent path of `put` / `remove` */
    @private side:   block<i32>        /* scratch: which child slot was taken at each level */
    depth:  i64

    /* ---------------------------------------------------------------- construction */
    fn withCap(want: i64) -> map<K, V> {
        var c: i64 = 4
        while c < want { c = c * 2 }
        var m: map<K, V> = {
            keys: block<K>::withCap(c * 17),
            vals: block<V>::withCap(c * 17),
            kids: block<i32>::withCap(c * 18),
            kn_: block<i32>::withCap(c),
            kc:  block<i32>::withCap(c),
            kl:  block<u8>::withCap(c),
            kx:  block<i32>::withCap(c),
            nnodes: 0, ncap: c, root: i32(0), freeHead: i32(-1), n: 0,
            path: block<i32>::withCap(SCRATCH), side: block<i32>::withCap(SCRATCH), depth: 0,
        }
        m.root = m.newNode(true)
        return m
    }

    fn new() -> map<K, V> { return map<K, V>::withCap(16) }

    fn len(self: ref map<K, V>) -> i64 { return self.n }
    fn nodeCount(self: ref map<K, V>) -> i64 { return self.nnodes }
    fn capacity(self: ref map<K, V>) -> i64 { return self.ncap }
    /* 这张表**当下**在它自己池里占的字节（四处存储 + 两块草稿）。
     * 判据：`growStores` 把旧块当场还了 ⇒ 这个数只随当前 `ncap` 走，与长过多少次无关；
     * 旧块若还留着，它会**大一整代**（见 tests/map/run.sh 的精确字节账）。 */
    /* 这张表当下握着的字节：七块平坦存储 + 两块草稿，按块的 size class 报（不是请求字节）。 */
    /* 判据：`growStores` / `shrink` 把旧块当场还了 ⇒ 这个数只随当前 `ncap` 走。 */
    fn bytesOf(self: ref map<K, V>) -> i64 {
        return self.keys.bytesOf() + self.vals.bytesOf() + self.kids.bytesOf() + self.kn_.bytesOf() + self.kc.bytesOf() + self.kl.bytesOf() + self.kx.bytesOf() + self.path.bytesOf() + self.side.bytesOf()
    }
    fn height(self: ref map<K, V>) -> i64 {
        var h: i64 = 1
        var id: i32 = self.root
        while !self.leafOf(id) { id = self.kd(id, 0)  h = h + 1 }
        return h
    }

    /* ---------------------------------------------------------------- node access, by id
     *
     * 这一族（连同下面两个二分 `childSlot` / `lowerIn`）都标了 `@inline`：它们只有一条访存，
     * 却在下降/分裂/合并的每一步都被调到。**不标的话 GCC 不肯内联** —— 每个内联点都会带进一份
     * 边界检查和一个带 `file:line` 常量的 `extc_trap` 调用，内联器按体积算不划算 ⇒ 这些访问器
     * 全变成独立函数，`bench/stl` 的 map 因此慢 10.5%（实测，DEVLOG 第十一段续七）。
     * 强制内联之后它们从 profile 里消失，GCC 也能跨过它们优化。
     * 注意：不是所有小函数都值得 —— `hashMap` 那 6 个小访问器加了只值 ~1%（噪声），别加。 */
@inline
    @private fn bn(self: ref map<K, V>, id: i32) -> i64 { return i64(self.kn_[i64(id)]) }
@inline
    @private fn cntOf(self: ref map<K, V>, id: i32) -> i64 { return i64(self.kc[i64(id)]) }
@inline
    @private fn leafOf(self: ref map<K, V>, id: i32) -> bool { return self.kl[i64(id)] != u8(0) }
@inline
    @private fn kn(self: ref map<K, V>, id: i32, i: i64) -> K { return self.keys[i64(id) * 17 + i] }
@inline
    @private fn vn(self: ref map<K, V>, id: i32, i: i64) -> V { return self.vals[i64(id) * 17 + i] }
@inline
    @private fn kd(self: ref map<K, V>, id: i32, i: i64) -> i32 { return self.kids[i64(id) * 18 + i] }
@inline
    @private fn nx(self: ref map<K, V>, id: i32) -> i32 { return self.kx[i64(id)] }

@inline
    @private fn setN(self: mut ref map<K, V>, id: i32, v: i64) { self.kn_[i64(id)] = i32(v) }
@inline
    @private fn setCnt(self: mut ref map<K, V>, id: i32, v: i64) { self.kc[i64(id)] = i32(v) }
@inline
    @private fn setLeaf(self: mut ref map<K, V>, id: i32, v: bool) {
        if v { self.kl[i64(id)] = u8(1) } else { self.kl[i64(id)] = u8(0) }
    }
@inline
    @private fn setKey(self: mut ref map<K, V>, id: i32, i: i64, k: K) { self.keys[i64(id) * 17 + i] = k }
@inline
    @private fn setVal(self: mut ref map<K, V>, id: i32, i: i64, v: V) { self.vals[i64(id) * 17 + i] = v }
@inline
    @private fn setKid(self: mut ref map<K, V>, id: i32, i: i64, c: i32) { self.kids[i64(id) * 18 + i] = c }
@inline
    @private fn setNext(self: mut ref map<K, V>, id: i32, c: i32) { self.kx[i64(id)] = c }

    /* Grow the seven flat stores to 1.5x. Every element is MOVED into the new block
     * (`block::growTo`) and the old block goes back at once, so a growth step holds one
     * generation of storage rather than two. Node `i` addresses the same offsets after the move:
     * they depend on the id, never on capacity, which is why no node has a view to re-hang.
     *
     * 1.5x rather than 2x: the last generation of 1e6 entries holds ~157,000 nodes instead of
     * 262,144, and the step stays O(used) either way. */
    fn growStores(self: mut ref map<K, V>) {
        var want: i64 = self.ncap + self.ncap / 2
        if want < 4 { want = 4 }
        /* 先报「用到的元素数」：块的搬移与钩子只走 `[0, used)`，尾巴是块上一个使用者留下的
         * 脏内存。 */
        self.keys.setLen(self.nnodes * 17)
        self.vals.setLen(self.nnodes * 17)
        self.kids.setLen(self.nnodes * 18)
        self.kn_.setLen(self.nnodes)
        self.kc.setLen(self.nnodes)
        self.kl.setLen(self.nnodes)
        self.kx.setLen(self.nnodes)
        self.keys.growTo(want * 17)
        self.vals.growTo(want * 17)
        self.kids.growTo(want * 18)
        self.kn_.growTo(want)
        self.kc.growTo(want)
        self.kl.growTo(want)
        self.kx.growTo(want)
        self.ncap = want
    }

    /* Carve a fresh node out of the stores. No allocation happens here, which is what keeps a
     * node created inside `put`'s split loop alive (see the note on the stores above).
     * A recycled node only has its scalars reset. */
    fn newNode(self: mut ref map<K, V>, leaf: bool) -> i32 {
        if self.freeHead >= i32(0) {
            let id = self.freeHead
            self.freeHead = self.nx(id)
            self.setN(id, 0)
            self.setCnt(id, 0)
            self.setLeaf(id, leaf)
            self.setNext(id, i32(-1))
            return id
        }
        if self.nnodes >= self.ncap { self.growStores() }
        let id = i32(self.nnodes)
        self.setN(id, 0)
        self.setCnt(id, 0)
        self.setLeaf(id, leaf)
        self.setNext(id, i32(-1))
        self.nnodes = self.nnodes + 1
        return id
    }

    /* Sum of the key counts of children [0, upto) of an internal node. */
    fn kidsCnt(self: ref map<K, V>, id: i32, upto: i64) -> i64 {
        var s: i64 = 0
        var i: i64 = 0
        while i < upto {
            s = s + self.cntOf(self.kd(id, i))
            i = i + 1
        }
        return s
    }

    /* The smallest key of a SUBTREE (a node id, not the map): kids[0] all the way down. Not to be
     * confused with the public `firstKey()` below, which is the smallest key of the whole map. */
    fn subMinKey(self: ref map<K, V>, id: i32) -> K {
        var cur: i32 = id
        while !self.leafOf(cur) { cur = self.kd(cur, 0) }
        return self.kn(cur, 0)
    }

    /* ---------------------------------------------------------------- search */
    /* First index in [0, n) whose key is not less than `k` (the lower bound inside one node). */
@inline
    fn lowerIn(self: ref map<K, V>, id: i32, k: K) -> i64 {
        var lo: i64 = 0
        var hi: i64 = self.bn(id)
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            if self.kn(id, mid) < k { lo = mid + 1 } else { hi = mid }
        }
        return lo
    }

    /* Child slot to descend into: the first `i` with `k < keys[i]`, else n (the last child). */
@inline
    fn childSlot(self: ref map<K, V>, id: i32, k: K) -> i64 {
        var lo: i64 = 0
        var hi: i64 = self.bn(id)
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            if k < self.kn(id, mid) { hi = mid } else { lo = mid + 1 }
        }
        return lo
    }

    fn leafFor(self: ref map<K, V>, k: K) -> i32 {
        var id: i32 = self.root
        while !self.leafOf(id) { id = self.kd(id, self.childSlot(id, k)) }
        return id
    }

    fn contains(self: ref map<K, V>, k: K) -> bool {
        let id = self.leafFor(k)
        let i = self.lowerIn(id, k)
        if i >= self.bn(id) { return false }
        return !(k < self.kn(id, i))
    }

    /* `m[k]` -- the read side of the subscript syntax and nothing else. It returns `?V` exactly
     * like `get`: a missing key is `none`, NOT an inserted default (`std::map::operator[]`'s
     * surprise is not available here -- extC has no lvalue generation, and writing stays `put`).
     * `[]` and `[]=` are independent method names, so a type may offer reading without writing. */
    fn [](self: ref map<K, V>, k: K) -> ?V { return self.get(k) }

    fn get(self: ref map<K, V>, k: K) -> ?V {
        let id = self.leafFor(k)
        let i = self.lowerIn(id, k)
        if i >= self.bn(id) { return none }
        if k < self.kn(id, i) { return none }
        return some(self.vn(id, i))
    }

    /* Rank of the first key not less than `k` -- the count of keys strictly less than `k`.
     * Descending adds whole subtrees, so this is O(log n) rather than a walk. */
    fn lowerBound(self: ref map<K, V>, k: K) -> i64 {
        var rank: i64 = 0
        var id: i32 = self.root
        while !self.leafOf(id) {
            let c = self.childSlot(id, k)
            rank = rank + self.kidsCnt(id, c)
            id = self.kd(id, c)
        }
        return rank + self.lowerIn(id, k)
    }

    /* The smallest / largest key, `none` on an empty map. Both are O(log n): a rank query on the
     * order-statistic side (`cnt`), not a walk. */
    fn firstKey(self: ref map<K, V>) -> ?K {
        if self.n == 0 { return none }
        return some(self.keyAt(0))
    }

    fn lastKey(self: ref map<K, V>) -> ?K {
        if self.n == 0 { return none }
        return some(self.keyAt(self.n - 1))
    }

    /* The i-th smallest entry, encoded as `leafId * 16 + position` (16 = ORDER, and a leaf never
     * holds more). Passing two numbers would mean a tuple type the language does not have. */
    fn rankAt(self: ref map<K, V>, i: i64) -> i64 {
        var id: i32 = self.root
        var want: i64 = i
        while !self.leafOf(id) {
            var c: i64 = 0
            var found: i64 = 0
            while found == 0 {
                let s = self.cntOf(self.kd(id, c))
                if want < s { found = 1 } else { want = want - s  c = c + 1 }
            }
            id = self.kd(id, c)
        }
        return i64(id) * 16 + want
    }

    fn keyAt(self: ref map<K, V>, i: i64) -> K {
        let e = self.rankAt(i)
        return self.kn(i32(e / 16), e % 16)
    }

    fn valAt(self: ref map<K, V>, i: i64) -> V {
        let e = self.rankAt(i)
        return self.vn(i32(e / 16), e % 16)
    }

    /* **深拷贝：要一份独立的 map 就用它。**
     *
     * `var b = a` 不是深拷贝 —— 那是结构体逐成员拷贝，两份共用同一批节点所在的板块
     * （`vals` 是指针被抄了一份）：`b.put(...)` 会改到 `a`，`a.release()` 会让 `b` 悬垂。
     * 显式拷贝的代价可见（一次 O(n) 拷贝 + 一块新板块），新存储生在调用者所在的地方。 */
    fn clone(self: ref map<K, V>) -> map<K, V> {
        var out = map<K, V>::withCap(self.n + 1)
        var i: i64 = 0
        while i < self.n {
            out.put(self.keyAt(i), self.valAt(i))
            i = i + 1
        }
        return out
    }

    /* `m[k] = v` -- the write side, a SEPARATE method name from `[]`, so a type may offer reading
     * without writing (and this one is only ever found on an assignment). Semantics are `put`'s: a
     * key that is absent is inserted, one that is present is overwritten, and the answer says which
     * of the two happened (true = it was already there). */
    fn []=(self: mut ref map<K, V>, k: K, v: V) -> bool { return self.put(k, v) }

    /* ---------------------------------------------------------------- insert */
    fn put(self: mut ref map<K, V>, k: K, v: V) -> bool {
        /* Descend to the leaf, recording the path: a split has to be pushed back up it. */
        var id: i32 = self.root
        self.depth = 0
        while !self.leafOf(id) {
            let c = self.childSlot(id, k)
            self.path[self.depth] = id
            self.side[self.depth] = i32(c)
            self.depth = self.depth + 1
            id = self.kd(id, c)
        }
        let at = self.lowerIn(id, k)
        if at < self.bn(id) && !(k < self.kn(id, at)) { self.setVal(id, at, v)  return true }

        var j: i64 = self.bn(id)
        while j > at {
            self.setKey(id, j, self.kn(id, j - 1))
            self.setVal(id, j, self.vn(id, j - 1))
            j = j - 1
        }
        self.setKey(id, at, k)
        self.setVal(id, at, v)
        self.setN(id, self.bn(id) + 1)
        self.setCnt(id, self.cntOf(id) + 1)
        self.n = self.n + 1

        /* one more key in every subtree on the path */
        var d: i64 = self.depth - 1
        while d >= 0 {
            let p = self.path[d]
            self.setCnt(p, self.cntOf(p) + 1)
            d = d - 1
        }

        /* Split upward while a node is overfull. A leaf split COPIES its first key up (the key
         * stays in the right leaf); an internal split MOVES its middle key up. */
        var child: i32 = id
        var level: i64 = self.depth
        var sep: K = k
        while self.bn(child) > ORDER {
            var right: i32 = self.newNode(self.leafOf(child))
            if self.leafOf(child) {
                var r: i64 = 0
                var s: i64 = HALF
                while s < self.bn(child) {
                    self.setKey(right, r, self.kn(child, s))
                    self.setVal(right, r, self.vn(child, s))
                    r = r + 1
                    s = s + 1
                }
                self.setN(right, r)
                self.setCnt(right, r)
                self.setN(child, HALF)
                self.setCnt(child, HALF)
                self.setNext(right, self.nx(child))
                self.setNext(child, right)
                sep = self.kn(right, 0)
            } else {
                sep = self.kn(child, HALF)
                var r: i64 = 0
                var s: i64 = HALF + 1
                while s < self.bn(child) {
                    self.setKey(right, r, self.kn(child, s))
                    r = r + 1
                    s = s + 1
                }
                self.setN(right, r)
                var k2: i64 = 0
                var cs: i64 = HALF + 1
                while cs <= self.bn(child) {
                    self.setKid(right, k2, self.kd(child, cs))
                    k2 = k2 + 1
                    cs = cs + 1
                }
                self.setN(child, HALF)
                self.setCnt(right, self.kidsCnt(right, r + 1))
                self.setCnt(child, self.kidsCnt(child, HALF + 1))
            }
            if level == 0 {
                /* the root itself split: a new root above both halves, and the tree grows */
                var nr: i32 = self.newNode(false)
                self.setKey(nr, 0, sep)
                self.setKid(nr, 0, child)
                self.setKid(nr, 1, right)
                self.setN(nr, 1)
                self.setCnt(nr, self.cntOf(child) + self.cntOf(right))
                self.root = nr
                return false
            }
            let p = self.path[level - 1]
            let ci = i64(self.side[level - 1])
            var q: i64 = self.bn(p)
            while q > ci {
                self.setKey(p, q, self.kn(p, q - 1))
                q = q - 1
            }
            var qc: i64 = self.bn(p) + 1
            while qc > ci + 1 {
                self.setKid(p, qc, self.kd(p, qc - 1))
                qc = qc - 1
            }
            self.setKey(p, ci, sep)
            self.setKid(p, ci + 1, right)
            self.setN(p, self.bn(p) + 1)
            child = p
            level = level - 1
        }
        return false
    }

    /* ---------------------------------------------------------------- rebalancing */
    /* Hand a node back for reuse. The store slot is never returned (the stores only grow), so a
     * churn of insert/delete cycles reuses node ids instead of walking the store forward. */
    fn freeNode(self: mut ref map<K, V>, id: i32) {
        self.setNext(id, self.freeHead)
        self.freeHead = id
    }

    /* Drop keys[ci-1] and kids[ci] from internal node `p`: the separator and the child it bounded
     * are removed together. */
    fn dropChild(self: mut ref map<K, V>, p: i32, ci: i64) {
        var j: i64 = ci - 1
        while j + 1 < self.bn(p) {
            self.setKey(p, j, self.kn(p, j + 1))
            j = j + 1
        }
        var jc: i64 = ci
        while jc + 1 <= self.bn(p) {
            self.setKid(p, jc, self.kd(p, jc + 1))
            jc = jc + 1
        }
        self.setN(p, self.bn(p) - 1)
    }

    /* One entry moves from the left sibling into `cur` (children ci-1 and ci of `p`). */
    fn borrowLeft(self: mut ref map<K, V>, p: i32, ci: i64) {
        let cur: i32 = self.kd(p, ci)
        let left: i32 = self.kd(p, ci - 1)
        if self.leafOf(cur) {
            var j: i64 = self.bn(cur)
            while j > 0 {
                self.setKey(cur, j, self.kn(cur, j - 1))
                self.setVal(cur, j, self.vn(cur, j - 1))
                j = j - 1
            }
            self.setKey(cur, 0, self.kn(left, self.bn(left) - 1))
            self.setVal(cur, 0, self.vn(left, self.bn(left) - 1))
            self.setN(cur, self.bn(cur) + 1)
            self.setN(left, self.bn(left) - 1)
            self.setCnt(cur, self.cntOf(cur) + 1)
            self.setCnt(left, self.cntOf(left) - 1)
            return
        }
        var j: i64 = self.bn(cur)
        while j > 0 {
            self.setKey(cur, j, self.kn(cur, j - 1))
            j = j - 1
        }
        var jc: i64 = self.bn(cur) + 1
        while jc > 0 {
            self.setKid(cur, jc, self.kd(cur, jc - 1))
            jc = jc - 1
        }
        self.setKey(cur, 0, self.kn(p, ci - 1))
        self.setKid(cur, 0, self.kd(left, self.bn(left)))
        self.setKey(p, ci - 1, self.kn(left, self.bn(left) - 1))
        let moved: i64 = self.cntOf(self.kd(left, self.bn(left)))
        self.setN(cur, self.bn(cur) + 1)
        self.setN(left, self.bn(left) - 1)
        self.setCnt(cur, self.cntOf(cur) + moved)
        self.setCnt(left, self.cntOf(left) - moved)
    }

    /* One entry moves from the right sibling into `cur`. */
    fn borrowRight(self: mut ref map<K, V>, p: i32, ci: i64) {
        let cur: i32 = self.kd(p, ci)
        let right: i32 = self.kd(p, ci + 1)
        if self.leafOf(cur) {
            self.setKey(cur, self.bn(cur), self.kn(right, 0))
            self.setVal(cur, self.bn(cur), self.vn(right, 0))
            var j: i64 = 0
            while j + 1 < self.bn(right) {
                self.setKey(right, j, self.kn(right, j + 1))
                self.setVal(right, j, self.vn(right, j + 1))
                j = j + 1
            }
            self.setN(cur, self.bn(cur) + 1)
            self.setN(right, self.bn(right) - 1)
            self.setCnt(cur, self.cntOf(cur) + 1)
            self.setCnt(right, self.cntOf(right) - 1)
            self.setKey(p, ci, self.kn(right, 0))
            return
        }
        self.setKey(cur, self.bn(cur), self.kn(p, ci))
        self.setKid(cur, self.bn(cur) + 1, self.kd(right, 0))
        self.setKey(p, ci, self.kn(right, 0))
        let moved: i64 = self.cntOf(self.kd(right, 0))
        var j: i64 = 0
        while j + 1 < self.bn(right) {
            self.setKey(right, j, self.kn(right, j + 1))
            j = j + 1
        }
        j = 0
        while j + 1 <= self.bn(right) {
            self.setKid(right, j, self.kd(right, j + 1))
            j = j + 1
        }
        self.setN(cur, self.bn(cur) + 1)
        self.setN(right, self.bn(right) - 1)
        self.setCnt(cur, self.cntOf(cur) + moved)
        self.setCnt(right, self.cntOf(right) - moved)
    }

    /* Merge `cur` into its left sibling and drop the separator. In this layout an internal node's
     * key is a COPY of a subtree minimum, so nothing has to be "pulled down" twice: the separator
     * becomes left's new last key and the child counts add up unchanged. */
    fn mergeLeft(self: mut ref map<K, V>, p: i32, ci: i64) {
        let cur: i32 = self.kd(p, ci)
        let left: i32 = self.kd(p, ci - 1)
        if self.leafOf(cur) {
            var j: i64 = 0
            while j < self.bn(cur) {
                self.setKey(left, self.bn(left) + j, self.kn(cur, j))
                self.setVal(left, self.bn(left) + j, self.vn(cur, j))
                j = j + 1
            }
            self.setN(left, self.bn(left) + self.bn(cur))
            self.setCnt(left, self.cntOf(left) + self.cntOf(cur))
            self.setNext(left, self.nx(cur))
        } else {
            self.setKey(left, self.bn(left), self.kn(p, ci - 1))
            var j: i64 = 0
            while j < self.bn(cur) {
                self.setKey(left, self.bn(left) + 1 + j, self.kn(cur, j))
                j = j + 1
            }
            var jc: i64 = 0
            while jc <= self.bn(cur) {
                self.setKid(left, self.bn(left) + 1 + jc, self.kd(cur, jc))
                jc = jc + 1
            }
            self.setN(left, self.bn(left) + 1 + self.bn(cur))
            self.setCnt(left, self.cntOf(left) + self.cntOf(cur))
        }
        self.dropChild(p, ci)
        self.freeNode(cur)
    }

    /* Merge the right sibling into `cur` and drop the separator. `cur` keeps its identity, so the
     * caller may still refresh the separator above it. */
    fn mergeRight(self: mut ref map<K, V>, p: i32, ci: i64) {
        let cur: i32 = self.kd(p, ci)
        let right: i32 = self.kd(p, ci + 1)
        if self.leafOf(cur) {
            var j: i64 = 0
            while j < self.bn(right) {
                self.setKey(cur, self.bn(cur) + j, self.kn(right, j))
                self.setVal(cur, self.bn(cur) + j, self.vn(right, j))
                j = j + 1
            }
            self.setN(cur, self.bn(cur) + self.bn(right))
            self.setCnt(cur, self.cntOf(cur) + self.cntOf(right))
            self.setNext(cur, self.nx(right))
        } else {
            self.setKey(cur, self.bn(cur), self.kn(p, ci))
            var j: i64 = 0
            while j < self.bn(right) {
                self.setKey(cur, self.bn(cur) + 1 + j, self.kn(right, j))
                j = j + 1
            }
            var jc: i64 = 0
            while jc <= self.bn(right) {
                self.setKid(cur, self.bn(cur) + 1 + jc, self.kd(right, jc))
                jc = jc + 1
            }
            self.setN(cur, self.bn(cur) + 1 + self.bn(right))
            self.setCnt(cur, self.cntOf(cur) + self.cntOf(right))
        }
        var k: i64 = ci
        while k + 1 < self.bn(p) {
            self.setKey(p, k, self.kn(p, k + 1))
            k = k + 1
        }
        var kc: i64 = ci + 1
        while kc + 1 <= self.bn(p) {
            self.setKid(p, kc, self.kd(p, kc + 1))
            kc = kc + 1
        }
        self.setN(p, self.bn(p) - 1)
        self.freeNode(right)
    }

    /* ---------------------------------------------------------------- remove */
    /* Stage 2a: take the entry out and fix the counts. No rebalancing yet, so a leaf can end up
     * under HALF entries -- every query stays correct, the tree only gets sparse. */
    fn remove(self: mut ref map<K, V>, k: K) -> bool {
        var id: i32 = self.root
        self.depth = 0
        while !self.leafOf(id) {
            let c = self.childSlot(id, k)
            self.path[self.depth] = id
            self.side[self.depth] = i32(c)
            self.depth = self.depth + 1
            id = self.kd(id, c)
        }
        let at = self.lowerIn(id, k)
        if at >= self.bn(id) { return false }
        if k < self.kn(id, at) { return false }
        var j: i64 = at
        while j + 1 < self.bn(id) {
            self.setKey(id, j, self.kn(id, j + 1))
            self.setVal(id, j, self.vn(id, j + 1))
            j = j + 1
        }
        self.setN(id, self.bn(id) - 1)
        self.setCnt(id, self.cntOf(id) - 1)
        self.n = self.n - 1
        var d: i64 = self.depth - 1
        while d >= 0 {
            let p = self.path[d]
            self.setCnt(p, self.cntOf(p) - 1)
            d = d - 1
        }
        /* Walk up: refresh the separator that bounds this subtree (its smallest key may have
         * gone), and rebalance a node that fell under HALF entries -- borrow from a sibling that
         * can spare one, otherwise merge. A merge removes a key from the parent, so the parent is
         * rebalanced on the next turn of this loop. */
        var cur: i32 = id
        var level: i64 = self.depth
        while level > 0 {
            let p = self.path[level - 1]
            let ci = i64(self.side[level - 1])
            if self.bn(cur) < HALF {
                if ci > 0 && self.bn(self.kd(p, ci - 1)) > HALF {
                    self.borrowLeft(p, ci)
                    if ci > 0 { self.setKey(p, ci - 1, self.subMinKey(cur)) }
                } else if ci < self.bn(p) && self.bn(self.kd(p, ci + 1)) > HALF {
                    self.borrowRight(p, ci)
                } else if ci > 0 {
                    /* `cur` is freed by this: nothing to refresh above it, the separator went
                     * away with it. */
                    self.mergeLeft(p, ci)
                } else {
                    self.mergeRight(p, ci)
                }
            } else {
                if ci > 0 { self.setKey(p, ci - 1, self.subMinKey(cur)) }
            }
            cur = p
            level = level - 1
        }
        /* The root may have lost its last key, or become an empty leaf's parent: the tree gets
         * shorter and the retired root goes back to the free list. */
        while !self.leafOf(self.root) && self.bn(self.root) == 0 {
            let old: i32 = self.root
            self.root = self.kd(old, 0)
            self.freeNode(old)
        }
        return true
    }

    /* 把七块平坦存储与两块草稿整块交还（`block::release` 幂等，所以字段的自动 drop 不会重复
     * 归还）。旧元素若含引用域，`setLen` 报出的 `[0, used)` 就是撤引用边与跑钩子的范围。 */
    fn release(self: mut ref map<K, V>) {
        self.keys.setLen(self.nnodes * 17)
        self.vals.setLen(self.nnodes * 17)
        self.kids.setLen(self.nnodes * 18)
        self.kn_.setLen(self.nnodes)
        self.kc.setLen(self.nnodes)
        self.kl.setLen(self.nnodes)
        self.kx.setLen(self.nnodes)
        self.keys.release()
        self.vals.release()
        self.kids.release()
        self.kn_.release()
        self.kc.release()
        self.kl.release()
        self.kx.release()
        self.path.release()
        self.side.release()
        self.nnodes = 0
        self.ncap = 0
        self.n = 0
        self.root = i32(-1)
        self.freeHead = i32(-1)
    }

    /* Lower the water mark: repack the LIVE nodes into ids 0..k-1, drop the free list and shrink
     * the seven stores to exactly that size. Order, capacity and every entry stay where they were.
     * 新旧两代只在 move 的那一行同时在手（一块一块 `adopt`），所以这一下真的是 RSS。 */
    fn shrinkToFit(self: mut ref map<K, V>) {
        var order:   mut slice<i32> = new i32[self.nnodes]   /* live nodes in DFS order = new ids */
        var old2new: mut slice<i32> = new i32[self.nnodes]
        var i: i64 = 0
        while i < self.nnodes {
            old2new[i] = i32(-1)
            i = i + 1
        }
        var count: i64 = 1
        order[0] = self.root
        old2new[i64(self.root)] = i32(0)
        var head: i64 = 0
        while head < count {
            let id = order[head]
            if !self.leafOf(id) {
                var c: i64 = 0
                while c <= self.bn(id) {
                    let ch = self.kd(id, c)
                    order[count] = ch
                    old2new[i64(ch)] = i32(count)
                    count = count + 1
                    c = c + 1
                }
            }
            head = head + 1
        }
        /* `order` / `old2new` 是这次调用的临时草稿：随方法那个块一起回收，正是 arena 的活。
         * 七块长期存储换成按 `count` 精确大小的新块，旧块在 `adopt` 里当场交还。 */
        var nk:  block<K>     = block<K>::withCap(count * 17)
        var nv:  block<V>     = block<V>::withCap(count * 17)
        var nc:  block<i32>   = block<i32>::withCap(count * 18)
        var nbn: block<i32>   = block<i32>::withCap(count)
        var nbc: block<i32>   = block<i32>::withCap(count)
        var nbl: block<u8>    = block<u8>::withCap(count)
        var nbx: block<i32>   = block<i32>::withCap(count)
        i = 0
        while i < count {
            let src = i64(order[i])
            let kb  = i * 17
            let cb  = i * 18
            let skb = src * 17
            let scb = src * 18
            /* ⚠️ 只拷**用到的前缀**：键/值是 `bn` 个、子是 `bn + 1` 个。骨架上没写过的槽
             * 是脏内存，无条件拷满会让 `old2new[kid]` 拿垃圾去索引 ⇒ 越界 trap。 */
            let sn: i64 = self.bn(i32(src))
            var j: i64 = 0
            if self.leafOf(i32(src)) {
                while j < sn {
                    nk[kb + j] = self.keys[skb + j]
                    nv[kb + j] = self.vals[skb + j]
                    j = j + 1
                }
            } else {
                while j < sn {
                    nk[kb + j] = self.keys[skb + j]
                    j = j + 1
                }
            }
            if !self.leafOf(i32(src)) {
                j = 0
                while j < sn + 1 {
                    var kid: i32 = self.kids[scb + j]
                    if kid >= i32(0) { kid = old2new[i64(kid)] }
                    nc[cb + j] = kid
                    j = j + 1
                }
            }
            nbn[i] = self.kn_[src]
            nbc[i] = self.kc[src]
            nbl[i] = self.kl[src]
            nbx[i] = self.kx[src]
            i = i + 1
        }
        /* The DFS visits leaves left to right, so the chain is rebuilt in the same pass. */
        var prev: i32 = i32(-1)
        i = 0
        while i < count {
            if nbl[i] != u8(0) {
                if prev >= i32(0) { nbx[i64(prev)] = i32(i) }
                prev = i32(i)
            }
            i = i + 1
        }
        if prev >= i32(0) { nbx[i64(prev)] = i32(-1) }
        nk.setLen(count * 17)
        nv.setLen(count * 17)
        nc.setLen(count * 18)
        nbn.setLen(count)
        nbc.setLen(count)
        nbl.setLen(count)
        nbx.setLen(count)
        /* 旧块的 used 先报出来，`adopt` 交还它时才知道该给哪些元素跑钩子/撤边。 */
        self.keys.setLen(self.nnodes * 17)
        self.vals.setLen(self.nnodes * 17)
        self.kids.setLen(self.nnodes * 18)
        self.kn_.setLen(self.nnodes)
        self.kc.setLen(self.nnodes)
        self.kl.setLen(self.nnodes)
        self.kx.setLen(self.nnodes)
        self.keys.adopt(ref nk)
        self.vals.adopt(ref nv)
        self.kids.adopt(ref nc)
        self.kn_.adopt(ref nbn)
        self.kc.adopt(ref nbc)
        self.kl.adopt(ref nbl)
        self.kx.adopt(ref nbx)
        self.nnodes = count
        self.ncap   = count
        self.freeHead = i32(-1)
        self.root   = i32(0)
    }

    fn clear(self: mut ref map<K, V>) {
        self.nnodes = 0
        self.n = 0
        self.root = self.newNode(true)
    }
}

/* stl/set.extc -- `set<T>`: an ORDERED set. Membership, rank and the ordered walk come from the
 * same B+tree `stl/map.extc` uses, with the values dropped -- so ordering, splitting and
 * rebalancing live in ONE place and cannot drift: a set IS a map whose value is a placeholder
 * byte.
 *
 * Compare `stl/hashSet.extc`: the same "no second implementation" trade, for hash-ordered
 * membership. The naming rule is that the bare names belong to the ORDERED
 * implementations: `map` / `set` are ordered, `hashMap` / `hashSet` are hashed.
 *
 * Ordered iteration is `at(i)` for i in [0, len) -- the i-th smallest element. `lowerBound(k)` is
 * the rank of the first element not less than k, which is what a range query starts from. */

@noCopy
struct set<T> {
    m: map<T, u8>

    fn withCap(want: i64) -> set<T> {
        var s: set<T> = { m: map<T, u8>::withCap(want) }
        return s
    }

    fn new() -> set<T> { return set<T>::withCap(16) }

    fn len(self: ref set<T>) -> i64 { return self.m.len() }
    /* **深拷贝**：集合拥有自己的 map，赋值是转移；要副本写 `clone()`。 */
    fn clone(self: ref set<T>) -> set<T> {
        var s: set<T> = { m: self.m.clone() }
        return s
    }

    fn contains(self: ref set<T>, k: T) -> bool { return self.m.contains(k) }

    /* True when the element is NEW -- the map answers the opposite question ("was it already
     * there?"), so this is the one place the two surfaces differ, and it is flipped explicitly. */
    fn put(self: mut ref set<T>, k: T) -> bool {
        if self.m.put(k, u8(0)) { return false }
        return true
    }

    fn remove(self: mut ref set<T>, k: T) -> bool { return self.m.remove(k) }

    fn clear(self: mut ref set<T>) { self.m.clear() }
    fn shrinkToFit(self: mut ref set<T>) { self.m.shrinkToFit() }
    fn release(self: mut ref set<T>) { self.m.release() }

    /* Rank of the first element not less than `k` (the count of elements smaller than `k`). */
    fn lowerBound(self: ref set<T>, k: T) -> i64 { return self.m.lowerBound(k) }

    /* The smallest / largest element, `none` on an empty set. */
    fn first(self: ref set<T>) -> ?T {
        if self.m.len() == 0 { return none }
        return some(self.m.keyAt(0))
    }

    fn last(self: ref set<T>) -> ?T {
        if self.m.len() == 0 { return none }
        return some(self.m.keyAt(self.m.len() - 1))
    }

    /* The i-th smallest element, i in [0, len). Walking `i` from 0 to len-1 is the ordered walk. */
    fn at(self: ref set<T>, i: i64) -> T { return self.m.keyAt(i) }
}

/* ---------------------------------------------------------------------------------------
 * Linear maps (`linMap` / `linSet`): no hashing, only `==` on the key.
 *
 * Why this lives here rather than in its own module: it is a **fallback** for the two cases the
 * ordered map and the hashed table do not cover -- a struct key with only `fn ==`, or a table small
 * enough that a linear scan is faster than hashing. Three modules for "a map" was one answer per
 * shape with no rule about which to pick; `std::data::map` now owns all three, and the choice is
 * documented in one place (the standard library chapter of the manual).
 *
 *     use std::data::map
 *     var m: linMap<i64, slice<u8>> = linMap<i64, slice<u8>>::withCap(4)
 *     m.put(1, "one")
 *     println(m.get(1) ?? "missing")
 *
 * Cost, stated plainly: a lookup is O(n) probes with `==` each, against O(1) for the hashed
 * `hashMapI64`. Use it while keys are not integers and the table is small.
 * -------------------------------------------------------------------------------------- */
/* A `K -> V` table searched linearly. */
@noCopy
struct linMap<K, V> {
    @private keys: block<K>
    @private vals: block<V>
    @private n:    i64
    @private cap:  i64

    /* A table with room for `want` entries before the first growth. */
    fn withCap(want: i64) -> linMap<K, V> {
        var c: i64 = 4
        while c < want { c = c * 2 }
        var kb: block<K> = block<K>::withCap(c)
        var vb: block<V> = block<V>::withCap(c)
        kb.setLen(0)
        vb.setLen(0)
        var lm: linMap<K, V> = { keys: kb, vals: vb, n: 0, cap: c }
        return lm
    }

    fn len(self: ref linMap<K, V>) -> i64 { return self.n }
    fn capacity(self: ref linMap<K, V>) -> i64 { return self.cap }

    /* Where the key sits, or -1. Linear, and that is the whole point of this container:
     * `==` on a type parameter is the only thing a key has to provide.
     * The slot number is the container's bookkeeping, not a value. */
    @private
    fn findSlot(self: ref linMap<K, V>, k: K) -> i64 {
        var i: i64 = 0
        while i < self.n {
            if self.keys[i] == k { return i }
            i = i + 1
        }
        return 0 - 1
    }

    fn contains(self: ref linMap<K, V>, k: K) -> bool { return self.findSlot(k) >= 0 }

    /* `lm[k] = v` -- the write side; same semantics as `put` (insert or overwrite). */
    fn []=(self: mut ref linMap<K, V>, k: K, v: V) -> bool { return self.put(k, v) }

    /* Write the pair, overwriting a key that is already there.
     *
     * The reserve is the block's, not the arena's: growth replaces the block with a bigger one
     * and moves the live prefix into it (the old block goes back at once), so the table never
     * holds two generations.
     *
     * Returns false only when the table could not grow; `block` traps when storage cannot be
     * reserved, so a `false` here is unreachable today and the signature keeps the door open for
     * a grow that can fail. */
    fn put(self: mut ref linMap<K, V>, k: K, v: V) -> bool {
        let at = self.findSlot(k)
        if at >= 0 {
            self.vals.dropAt(at)          /* 被覆盖的值：先跑钩子，再写新值 */
            self.vals[at] = v
            return true
        }
        if self.n >= self.cap { self.grow() }
        if self.n >= self.cap { return false }
        self.keys[self.n] = k
        self.vals[self.n] = v
        self.n = self.n + 1
        self.keys.setLen(self.n)
        self.vals.setLen(self.n)
        return true
    }

    /* `lm[k]` -- read side of the subscript syntax; `none` when the key is absent. */
    fn [](self: ref linMap<K, V>, k: K) -> ?V { return self.get(k) }

    fn get(self: ref linMap<K, V>, k: K) -> ?V {
        let at = self.findSlot(k)
        if at < 0 { return none }
        return some(self.vals[at])
    }

    /* Drop the entry for a key. The last entry takes its place (swap-remove); the removed pair
     * runs its hooks, and the last pair is **moved** (not copied) so an owning key has exactly
     * one owner. */
    fn remove(self: mut ref linMap<K, V>, k: K) -> bool {
        let at = self.findSlot(k)
        if at < 0 { return false }
        let last = self.n - 1
        if at != last {
            let kk: K = self.keys.take(last)
            let vv: V = self.vals.take(last)
            self.keys.dropAt(at)
            self.vals.dropAt(at)
            self.keys[at] = kk
            self.vals[at] = vv
        } else {
            self.keys.dropAt(at)
            self.vals.dropAt(at)
        }
        self.n = last
        self.keys.setLen(last)
        self.vals.setLen(last)
        return true
    }

    /* Entry `i` in insertion order -- until a `remove`, which moves the last entry
     * there. These are the accessors to use with `len`. */
    fn keyAt(self: ref linMap<K, V>, i: i64) -> K { return self.keys[i] }
    fn valAt(self: ref linMap<K, V>, i: i64) -> V { return self.vals[i] }
    /* **深拷贝**（同 vector/map：要独立副本就显式拷一份，`var b = a` 是转移）。 */
    fn clone(self: ref linMap<K, V>) -> linMap<K, V> {
        var out = linMap<K, V>::withCap(self.n + 1)
        var i: i64 = 0
        while i < self.n {
            out.put(self.keyAt(i), self.valAt(i))
            i = i + 1
        }
        return out
    }

    /* 清空：每个元素跑钩子，块留着当容量（`used` 归零后，块再也不会把它们当元素）。 */
    fn clear(self: mut ref linMap<K, V>) {
        var i: i64 = 0
        while i < self.n {
            self.keys.dropAt(i)
            self.vals.dropAt(i)
            i = i + 1
        }
        self.n = 0
        self.keys.setLen(0)
        self.vals.setLen(0)
    }

    /* 增到 1.5 倍：**换块**（`block::growTo` 把活前缀搬进新块，旧块当场还）。这张表的下标
     * 就是插入序，搬家不改变任何已有元素的位置。 */
    fn grow(self: mut ref linMap<K, V>) {
        let c = self.cap + self.cap / 2
        self.keys.growTo(c)
        self.vals.growTo(c)
        self.cap = c
    }

    /* 把存储还回去：先让元素跑钩子，再整块交还（两次调用是空操作，所以字段的自动 `@drop`
     * 不会重复归还）。 */
    fn release(self: mut ref linMap<K, V>) {
        self.clear()
        self.keys.release()
        self.vals.release()
        self.cap = 0
    }
}

/* stl/linset.extc -- a **linear** set: membership by `==`, no hashing.
 *
 * The same trade as `stl/linmap`, and the same reason: a hashed `set<T>` needs `hash()` on
 * a type parameter, which the compiler cannot do yet (no traits). `==` on a parameter *is*
 * supported -- checked per instance, with the diagnostic naming the instance.
 *
 *     use std::data::linset
 *     var s: linSet<i64> = linSet<i64>::withCap(4)
 *     s.add(7)
 *     println(s.contains(7))
 *
 * It is a thin wrapper over `linMap<T, unit>` rather than a second array: the table and
 * the set differ only in the value half, and one implementation means one place for the
 * growth, the swap-remove and the `==` requirement.
 */
/* 与 `linMap` 同一条路：存储跟着值走，`var b = a` 是转移。 */
@noCopy
struct linSet<T> {
    m: linMap<T, unit>

    fn withCap(want: i64) -> linSet<T> {
        return { m: linMap<T, unit>::withCap(want) }
    }

    /* Add a member. Returns false when it was already there -- a set, not a bag. */
    fn add(self: mut ref linSet<T>, v: T) -> bool {
        if self.m.contains(v) { return false }
        let ok = self.m.put(v, unit {})
        return ok
    }

    fn contains(self: ref linSet<T>, v: T) -> bool { return self.m.contains(v) }

    fn remove(self: mut ref linSet<T>, v: T) -> bool { return self.m.remove(v) }

    fn len(self: ref linSet<T>) -> i64 { return self.m.len() }
    /* **深拷贝**（同 set：逐成员拷贝会共用底层容器的板块）。 */
    fn clone(self: ref linSet<T>) -> linSet<T> {
        var s: linSet<T> = { m: self.m.clone() }
        return s
    }

    fn clear(self: mut ref linSet<T>) { self.m.clear() }

    /* 整棵池树还回去（本集合自己的池）*/
    fn release(self: mut ref linSet<T>) { self.m.release() }

    /* Member `i` in insertion order -- until a `remove`, which moves the last member
     * there (swap-remove, as in `linMap`). This is what a caller walks with `len`. */
    fn at(self: ref linSet<T>, i: i64) -> T { return self.m.keyAt(i) }
}
