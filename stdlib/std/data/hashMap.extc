/* std/data/hashMap.extc -- 开放寻址哈希表：键值内联在三列里，控制字节做探测的预筛。
 *
 * 形态（设计见 HASHMAP 设计稿）：
 *   - 三列：`keys`（键）、`vals`（值）、`tag`（控制字节）。一个桶 1 + sizeof(K) + sizeof(V) 字节；
 *     没有值列、没有反向列、没有槽元数据、没有句柄、没有世代。
 *   - `tag` 把 8 个桶的控制字节打包进一个 64 位字：空桶是 0，占用桶的最高位恒为 1、低 7 位是哈希分量。
 *     探测一次读一个字、用一次掩码拿位置（`(~x) & 0x80..80` 给空桶，零字节检测给 tag 候选），
 *     只有 tag 对上才碰键列 —— 键可能是 string，比较比一个字节贵得多。
 *   - 容量不是 2 的幂：桶号是「乘取高位」`((h >> 32) * cap) >> 32`，任何 cap 都均匀，
 *     所以装载率可以做到 0.85 而不被 2 的幂浪费（按 2 的幂取低位做桶号时装载只有 0.35-0.5）。
 *   - 线性探测；删除走 Knuth 的回移（不留墓碑）。没有墓碑就没有「墓碑密度」这条触发线，
 *     也没有清理墓碑的重建。
 *   - 增长是**全量重哈希**：新三列、把活元素逐个搬过去、旧列当场还掉。这是 hashbrown
 *     （Rust 的 std::HashMap）与 C++ unordered_map 的同一档做法：单步 O(n)，摊还 O(1)。
 *     要避免它就在构造时给足容量（`withCap`），此后增长到装载线才再触发重哈希。
 *   - 迭代是按桶位：`keyAt(i)` / `valAt(i)` / `liveAt(i)`，i 走 [0, capacity())。桶位会随重哈希变，
 *     但值不会（值就是桶里的字节）；要一份独立的表用 `clone()`。
 *
 * @code
 * use std::io
 * use std::data::hashMap
 *
 * fn main() -> i32 {
 *     var m = hashMapI64<i32>::withCap(4)
 *     let isNew: bool = m.put(1, i32(11))        // false = 新键；true = 键本来就在
 *     let v: i32 = m.get(1) ?? i32(-1)
 *     io::cout << "new=" << isNew << " v=" << v << " len=" << m.len() << "\n"
 *     return 0
 * }
 * @endcode
 */

use std::data::dense::{block}

/* 空桶标记。占用的 tag 最高位恒为 1（0x80..0xFF），所以 0 只能留给「没有元素」。 */
const EMPTY: u8 = 0

/* 装载率的分子分母：0.85 = 17/20。增长线是「插入后会超过它」。 */
const LOAD_NUM: i64 = 17
const LOAD_DEN: i64 = 20

/* Mix a key into a spread-out non-negative i64.
 *
 * ⚠️ 混合体走**无符号**（`u64`）—— 这不是风格，是正确性：有符号 `*` 溢出在 C 里是 UB。
 * extC 的算术溢出靠 `-fwrapv` 兜成绕回（MANUAL §8），可那是**编译器驱动**给的旗子；
 * 生成的 C 一旦被别人用别的旗子编，GCC 在 `-O2` 下按「乘法不会溢出」优化 ⇒ 桶分布退化成一条长簇：
 * 实测 1e6 次 `put` 从 0.08 s 变成**挂死不返回**。哈希函数绝不能
 * 依赖「编译器替我定义 UB」。无符号 `*` 溢出在 C 里是**有定义**的（模 2^64），与旗子无关。
 *
 * 为什么要乘法：只做右移-xor 时，**小于 2^21 的键是不动的** ⇒ 连续的小整数键映射到连续的桶，
 * 65536 个连续键连成一整条簇，端到端从 10.5 ns/op 变成 5104 ns/op（486 倍）。
 * 乘一个奇数（与 2^64 互质 ⇒ 是置换）把低位的信息搬上去，右移再把它混回低位。 */
fn hashI64(k: i64) -> i64 {
    var x = k & 9223372036854775807          /* drop the sign bit: the i64 -> u64 conversion must not be lossy */
    var u = u64(x)
    u = u * u64(6364136223846793005)              /* Knuth 的 LCG 乘数：奇数 ⇒ 与 2^64 互质 */
    u = u ^ (u >> u64(21))
    u = u ^ (u >> u64(42))
    u = u & u64(9223372036854775807)              /* 清掉最高位 ⇒ 转回 i64 无损（收窄检查不生成代码） */
    return i64(u)
}

/* The `hash` of an `i64` key: the step that makes `hashMap<i64, V>` work directly.
 *
 * The attachment point is an `impl` block, which is needed because methods may only be declared
 * inside a `struct` body and `i64` is a compiler builtin with no body to write one in. */
impl i64 {
    fn hash(self: ref i64) -> i64 { return hashI64(*self) }
}

/* 桶号：乘取高位。`h` 是非负的（`hashI64` 清过符号位）所以 `h < 2^63`、`h >> 31 < 2^32`；
 * 乘 `cap` 之后右移 32 位落到 [0, cap) —— 均匀性来自高 32 位，乘只负责按 `cap` 缩放。
 * 细节：右移 31 位而不是 32 位。`h < 2^63` 时 `h >> 32` 只有 31 位，用它做被乘数只能覆盖
 * 一半的桶（实测 200k 条键只落进前半张表 ⇒ 有效装载翻倍、探测长度 4 万步、插入 20 µs/条）。 */
@inline
@private
fn bucketOf(h: i64, cap: i64) -> i64 { return ((h >> 31) * cap) >> 32 }

/* 控制字节：最高位恒为 1（表示占用），低 7 位是哈希分量。空桶是 0，所以空桶检测是一次掩码。 */
@inline
@private
fn ctrlOf(h: i64) -> u8 { return u8(128) + u8((h >> 20) & 127) }

/* 从打包字里取第 j 个字节（j 走 0..7）。 */
@inline
@private
fn byteAt(w: u64, j: i64) -> u8 { return u8((w >> u64(j * 8)) & u64(255)) }

/* 把第 j 个字节换成 t，其余字节不动。 */
@inline
@private
fn byteSet(w: u64, j: i64, t: u8) -> u64 {
    let sh: u64 = u64(j * 8)
    let ones: u64 = u64(0) - u64(1)
    let keep: u64 = ones - (u64(255) << sh)
    return (w & keep) | (u64(t) << sh)
}

/* 零字节检测：x 的每个字节若为 0，结果里对应字节的最高位被置上（其余位无意义）。 */
@inline
@private
fn zeroBytes(x: u64) -> u64 {
    let ones: u64 = u64(0) - u64(1)
    let low: u64 = ones / u64(255)
    return (x - low) & (x ^ ones) & (low * u64(128))
}

/* 最低置位的位置；x 必须非零。 */
@inline
@private
fn ctz64(x: u64) -> i64 {
    var v: u64 = x
    var n: i64 = 0
    if (v & u64(4294967295)) == u64(0) {
        n = n + 32
        v = v >> u64(32)
    }
    if (v & u64(65535)) == u64(0) {
        n = n + 16
        v = v >> u64(16)
    }
    if (v & u64(255)) == u64(0) {
        n = n + 8
        v = v >> u64(8)
    }
    if (v & u64(15)) == u64(0) {
        n = n + 4
        v = v >> u64(4)
    }
    if (v & u64(3)) == u64(0) {
        n = n + 2
        v = v >> u64(2)
    }
    if (v & u64(1)) == u64(0) {
        n = n + 1
    }
    return n
}

/* 三列同长的一张表：键、值、控制字节。`var b = a` 是转移（@noCopy）；要独立副本用 `clone()`。 */
@noCopy
struct hashMap<K, V> {
    @private keys: block<K>          /* 活桶的键 */
    @private vals: block<V>          /* 活桶的值，与键同下标 */
    @private tag:  block<u64>        /* 每字节一个桶的 tag：0 = 空桶，否则是 h2 + 1 */
    @private n:    i64               /* 活元素个数 */
    @private cap:  i64               /* 桶数（不是 2 的幂） */

    /* 一张能装下 `want` 个元素、装到 85% 之前不重哈希的表。 */
    fn withCap(want: i64) -> hashMap<K, V> {
        var w: i64 = want
        if w < 1 { w = 1 }
        /* cap = ceil(want / 0.85)：最后一个是 want 时装载恰好 0.85，再插一个才重哈希。 */
        var c: i64 = (w * LOAD_DEN + (LOAD_NUM - 1)) / LOAD_NUM
        if c < 8 { c = 8 }
        var m: hashMap<K, V> = {
            keys: block<K>::withCap(c),
            vals: block<V>::withCap(c),
            tag:  block<u64>::withCap((c + 7) / 8),
            n:    0,
            cap:  c,
        }
        /* 块内存是复用的脏内存，而 tag 的 0 有含义（空桶）⇒ 这一列必须显式清零。 */
        let nw: i64 = (c + 7) / 8
        var i: i64 = 0
        while i < nw {
            m.tag[i] = u64(0)
            i = i + 1
        }
        return m
    }

    fn len(self: ref hashMap<K, V>) -> i64 { return self.n }

    /* 桶数。迭代 `keyAt/valAt/liveAt` 的上界就是它。 */
    fn capacity(self: ref hashMap<K, V>) -> i64 { return self.cap }

    /* 三列实际握着多少字节（账本口径，不是请求字节）。 */
    fn bytesOf(self: ref hashMap<K, V>) -> i64 {
        return self.keys.bytesOf() + self.vals.bytesOf() + self.tag.bytesOf()
    }

    /* 找到 `k` 的桶：命中返回桶号，没有返回 -1。
     *
     * 探测每一步只读 `tag`（一列 1 字节的稠密数组，一次探测跨过的桶挤在同一两行 cache 里），
     * 只有控制字节对上才去读键列。下标由 `bucketOf` 与 `cap` 夹住，循环最多走 cap 步。 */
    /* 在 [lo, hi) 这段环形区间里探测：命中返回桶号，撞到空桶返回 -1，走完没撞到空桶返回 -2。
     * 控制字节按机器字打包 8 个桶，最高位恒为 1（占用），空桶是 0：
     *   - 空桶位置只要一次 `(~x) & 0x80..80`，再 `ctz >> 3` 就是桶号（不需要除法）；
     *   - tag 候选用一次零字节检测；未命中的整字两个掩码都是 0，一次循环只有几条指令。
     * 区间头尾用位移掩码裁掉不属于 [lo, hi) 的字节，不切回逐桶路径 —— 逐桶路径每个字节都要
     * `i / 8`（有符号除法）跟一次数组索引，比整字扫描贵得多。 */
    @inline
    @private
    @unchecked
    fn probeRange(self: ref hashMap<K, V>, k: ref K, bc: u64, lo: i64, hi: i64) -> i64 {
        let ones: u64 = u64(0) - u64(1)
        let high: u64 = (ones / u64(255)) * u64(128)
        var i: i64 = lo
        while i < hi {
            let off: i64 = i & 7
            let base: i64 = i - off
            let x: u64 = self.tag[base >> 3]
            var m: u64 = ones
            if off != 0 { m = ones << u64(off * 8) }
            if base + 8 > hi { m = m & (ones >> u64((8 - (hi - base)) * 8)) }
            let emp: u64 = ((x ^ ones) & high) & m
            let cand: u64 = zeroBytes(x ^ bc) & m
            var ep: i64 = -1
            if emp != u64(0) { ep = ctz64(emp) >> 3 }
            var cp: i64 = -1
            if cand != u64(0) { cp = ctz64(cand) >> 3 }
            if ep >= 0 && (cp < 0 || ep < cp) { return -1 }
            if cp >= 0 && (ep < 0 || cp < ep) {
                let b: i64 = base + cp
                if self.keys[b] == *k { return b }
                i = b + 1
            } else {
                i = base + 8
            }
        }
        return -2
    }
@private
    @unchecked
    @inline
    fn findSlotH(self: ref hashMap<K, V>, k: ref K, h: i64) -> i64 {
        if self.cap == 0 { return -1 }
        let t: u8 = ctrlOf(h)
        let bc: u64 = u64(t) * ((u64(0) - u64(1)) / u64(255))
        let start: i64 = bucketOf(h, self.cap)
        var r: i64 = self.probeRange(k, bc, start, self.cap)
        if r == -2 { r = self.probeRange(k, bc, 0, start) }
        if r == -2 { return -1 }
        return r
    }

    /* 找到 k 的桶：命中返回桶号，没有返回 -1。槽位号是容器内部记账，不是值。 */
    @private
    @inline
    fn findSlot(self: ref hashMap<K, V>, k: ref K) -> i64 { return self.findSlotH(k, k.hash()) }

    fn contains(self: ref hashMap<K, V>, k: K) -> bool { return self.findSlot(ref k) >= 0 }

    /* `hm[k]` -- the read side. Same answer as `get`: `none` when absent. */
    fn [](self: ref hashMap<K, V>, k: K) -> ?V { return self.get(k) }

    /* The value for `k`, or `none`. */
    fn get(self: ref hashMap<K, V>, k: K) -> ?V {
        let b: i64 = self.findSlot(ref k)
        if b < 0 { return none }
        return some(self.vals[b])
    }

    /* Insert or overwrite. Returns true when the key was already there. */
    fn []=(self: mut ref hashMap<K, V>, k: K, v: V) -> bool { return self.put(k, v) }

    /* 插入或覆盖。覆盖要先跑旧键旧值的钩子（它们可能是 string），再写新值。
     *
     * 增长在**插入之前**判：`(n + 1) / cap` 会超过 0.85 就先把表翻倍、再重新定位空桶。
     * 翻倍之后装载掉到 0.42 左右，所以下一次重哈希要再插 0.85 倍的量 —— 几何增长，摊还 O(1)。 */
    fn put(self: mut ref hashMap<K, V>, k: K, v: V) -> bool {
        let h: i64 = k.hash()
        let b: i64 = self.findSlotH(ref k, h)
        if b >= 0 {
            self.keys.dropAt(b)
            self.vals.dropAt(b)
            self.keys[b] = k
            self.vals[b] = v
            return true
        }
        if (self.n + 1) * LOAD_DEN > self.cap * LOAD_NUM {
            self.grow(self.cap * 2)
        }
        let i: i64 = self.slotFor(h)
        self.keys[i] = k
        self.vals[i] = v
        self.tag[i / 8] = byteSet(self.tag[i / 8], i - (i / 8) * 8, ctrlOf(h))
        self.n = self.n + 1
        return false
    }

    /* [lo, hi) 里第一个空桶；没有返回 -1。整字一次 `(~x) & 0x80..80`，头尾用位移掩码裁字节。 */
    @inline
    @private
    @unchecked
    fn slotRange(self: ref hashMap<K, V>, lo: i64, hi: i64) -> i64 {
        let ones: u64 = u64(0) - u64(1)
        let high: u64 = (ones / u64(255)) * u64(128)
        var i: i64 = lo
        while i < hi {
            let off: i64 = i & 7
            let base: i64 = i - off
            let x: u64 = self.tag[base >> 3]
            var m: u64 = ones
            if off != 0 { m = ones << u64(off * 8) }
            if base + 8 > hi { m = m & (ones >> u64((8 - (hi - base)) * 8)) }
            let emp: u64 = ((x ^ ones) & high) & m
            if emp != u64(0) { return base + (ctz64(emp) >> 3) }
            i = base + 8
        }
        return -1
    }
    /* 从 h 的起点往后找第一个空桶（调用前必须保证至少有一个空桶）。 */
    @private
    @unchecked
    @inline
    fn slotFor(self: ref hashMap<K, V>, h: i64) -> i64 {
        let start: i64 = bucketOf(h, self.cap)
        var i: i64 = self.slotRange(start, self.cap)
        if i < 0 { i = self.slotRange(0, start) }
        return i
    }

    /* 移除 `k`。返回「本来就在」。 */
    fn remove(self: mut ref hashMap<K, V>, k: K) -> bool {
        let b: i64 = self.findSlot(ref k)
        if b < 0 { return false }
        self.removeAt(b)
        return true
    }

    /* 移除 `k` 并把它的值交出来（键和值各自跑钩子，值给你之前先拷一份）。 */
    fn take(self: mut ref hashMap<K, V>, k: K) -> ?V {
        let b: i64 = self.findSlot(ref k)
        if b < 0 { return none }
        let out: V = self.vals[b]
        self.removeAt(b)
        return some(out)
    }

    /* 清掉第 `b` 个桶，然后按 Knuth 的回移（TAOCP vol. 3, 6.4 algorithm R）把簇补上。
     *
     * 回移而不是留墓碑：墓碑会永远占着桶、让别人的探测链变长（实测 26 ns 对 15 ns，
     * 单调整数键上更糟），而墓碑密度还得再来一条触发线去清理它。回移让探测只会在空桶停下。 */
    @private
    @unchecked
    fn removeAt(self: mut ref hashMap<K, V>, b: i64) {
        self.keys.dropAt(b)
        self.vals.dropAt(b)
        self.tag[b / 8] = byteSet(self.tag[b / 8], b - (b / 8) * 8, u8(0))
        self.n = self.n - 1
        var hole: i64 = b
        var j: i64 = b + 1
        if j == self.cap { j = 0 }
        var steps: i64 = 0
        while steps < self.cap {
            let c: u8 = byteAt(self.tag[j / 8], j - (j / 8) * 8)
            if c == EMPTY { break }
            let home: i64 = bucketOf(self.keys[j].hash(), self.cap)
            var dj: i64 = j - home
            if dj < 0 { dj = dj + self.cap }
            var dh: i64 = j - hole
            if dh < 0 { dh = dh + self.cap }
            if dj >= dh {
                self.keys[hole] = self.keys.take(j)
                self.vals[hole] = self.vals.take(j)
                self.tag[hole / 8] = byteSet(self.tag[hole / 8], hole - (hole / 8) * 8, c)
                self.tag[j / 8] = byteSet(self.tag[j / 8], j - (j / 8) * 8, u8(0))
                hole = j
            }
            j = j + 1
            if j == self.cap { j = 0 }
            steps = steps + 1
        }
    }

    /* 重哈希到 `ncap` 个桶：新三列、活元素逐个搬过去、旧三列当场还掉。
     *
     * 这是全量重哈希（单步 O(n)）。值不搬第二次 —— 它就是 `vals` 里那个桶的字节，
     * 只跟着键一起走。搬完旧列里已经没有活元素（`take` 清零），所以旧列归还时不会跑钩子、
     * 也不会把搬走的存储再释放一次。 */
    fn grow(self: mut ref hashMap<K, V>, ncap: i64) {
        var nk: block<K>   = block<K>::withCap(ncap)
        var nv: block<V>   = block<V>::withCap(ncap)
        let nw: i64 = (ncap + 7) / 8
        var nt: block<u64> = block<u64>::withCap(nw)
        var z: i64 = 0
        while z < nw {
            nt[z] = u64(0)
            z = z + 1
        }
        var i: i64 = 0
        while i < self.cap {
            let c: u8 = byteAt(self.tag[i / 8], i - (i / 8) * 8)
            if c != EMPTY {
                let h: i64 = self.keys[i].hash()
                var j: i64 = bucketOf(h, ncap)
                while byteAt(nt[j / 8], j - (j / 8) * 8) != EMPTY {
                    j = j + 1
                    if j == ncap { j = 0 }
                }
                nt[j / 8] = byteSet(nt[j / 8], j - (j / 8) * 8, c)
                nk[j] = self.keys.take(i)
                nv[j] = self.vals.take(i)
            }
            i = i + 1
        }
        self.keys.adopt(ref nk)
        self.vals.adopt(ref nv)
        self.tag.adopt(ref nt)
        self.cap = ncap
    }

    /* 缩到刚好装得下的容量（`n` 掉下来之后把桶还回去）。没有活元素时缩到 8。
     * 与增长是同一条路径（一次全量重哈希），所以它的停顿上界也一样是 O(n)。 */
    fn compact(self: mut ref hashMap<K, V>) {
        var want: i64 = self.n
        if want < 1 { want = 1 }
        var c: i64 = (want * LOAD_DEN + (LOAD_NUM - 1)) / LOAD_NUM
        if c < 8 { c = 8 }
        if c < self.cap { self.grow(c) }
    }

    /* Drop every entry, keeping the capacity. */
    fn clear(self: mut ref hashMap<K, V>) {
        var i: i64 = 0
        while i < self.cap {
            if byteAt(self.tag[i / 8], i - (i / 8) * 8) != EMPTY {
                self.keys.dropAt(i)
                self.vals.dropAt(i)
            }
            i = i + 1
        }
        let nw: i64 = (self.cap + 7) / 8
        var zw: i64 = 0
        while zw < nw {
            self.tag[zw] = u64(0)
            zw = zw + 1
        }
        self.n = 0
    }

    /* 三列都还回去：release 幂等，字段的自动 @drop 再发一次是空操作。 */
    fn release(self: mut ref hashMap<K, V>) {
        var i: i64 = 0
        while i < self.cap {
            if byteAt(self.tag[i / 8], i - (i / 8) * 8) != EMPTY {
                self.keys.dropAt(i)
                self.vals.dropAt(i)
            }
            i = i + 1
        }
        self.keys.release()
        self.vals.release()
        self.tag.release()
        self.n   = 0
        self.cap = 0
    }

    /* 遍历的入口：`for k in m.iterKeys()` / `for v in m.iterValues()`。方法不叫 `keys`
     * （那是字段名），也不给表本身加 `iter`：`for k in m` 会先把 @noCopy 的表移进隐藏绑定。
     * 迭代器持有对表的只读引用，所以表要活过循环；**遍历期间别改表**（put/remove/增长会搬槽）。 */
    fn iterKeys(self: ref hashMap<K, V>) -> hashMapKeyIter<K, V> {
        return { m: self, i: -1 }
    }
    fn iterValues(self: ref hashMap<K, V>) -> hashMapValueIter<K, V> {
        return { m: self, i: -1 }
    }

    /* 按桶位扫描：`i` 走 [0, capacity())。 */
    fn keyAt(self: ref hashMap<K, V>, i: i64) -> K { return self.keys[i] }
    fn valAt(self: ref hashMap<K, V>, i: i64) -> V { return self.vals[i] }
    fn liveAt(self: ref hashMap<K, V>, i: i64) -> bool { return byteAt(self.tag[i / 8], i - (i / 8) * 8) != EMPTY }

    /* **深拷贝：要一份独立的表就用它。** `var b = a` 是转移（`@noCopy`）⇒ 要副本得显式拷。 */
    fn clone(self: ref hashMap<K, V>) -> hashMap<K, V> {
        var out: hashMap<K, V> = hashMap<K, V>::withCap(self.n + 1)
        var i: i64 = 0
        while i < self.cap {
            if byteAt(self.tag[i / 8], i - (i / 8) * 8) != EMPTY { out.put(self.keys[i], self.vals[i]) }
            i = i + 1
        }
        return out
    }

}

/* 遍历器：迭代协议就是 `iter` / `next` / `value` 三个方法（手册 11.3），所以
 * `for k in m.iterKeys()` 直接可用；手写 while 也一样。游标停在**活槽**上，跳过空槽。
 * 名字不叫 `keys` / `values`：那是表的存储字段名，字段与方法不能同名。 */
struct hashMapKeyIter<K, V> {
    m: ref hashMap<K, V>,
    i: i64

    fn iter(self: ref hashMapKeyIter<K, V>) -> hashMapKeyIter<K, V> {
        return { m: self.m, i: -1 }
    }
    fn next(self: mut ref hashMapKeyIter<K, V>) -> bool {
        self.i += 1
        while self.i < self.m.capacity() && !self.m.liveAt(self.i) { self.i += 1 }
        return self.i < self.m.capacity()
    }
    fn value(self: ref hashMapKeyIter<K, V>) -> K { return self.m.keyAt(self.i) }
}

struct hashMapValueIter<K, V> {
    m: ref hashMap<K, V>,
    i: i64

    fn iter(self: ref hashMapValueIter<K, V>) -> hashMapValueIter<K, V> {
        return { m: self.m, i: -1 }
    }
    fn next(self: mut ref hashMapValueIter<K, V>) -> bool {
        self.i += 1
        while self.i < self.m.capacity() && !self.m.liveAt(self.i) { self.i += 1 }
        return self.i < self.m.capacity()
    }
    fn value(self: ref hashMapValueIter<K, V>) -> V { return self.m.valAt(self.i) }
}

/* ---------------------------------------------------------------------------
 * The integer fast path: a key wrapper, NOT a second table.
 *
 * `hashMap<K, V>` asks its key for `hash()` and `==`, so an `i64` key has to get those two
 * methods from somewhere. Methods live inside a `struct` and `i64` is built in, so there is
 * nowhere to write them -- hence the wrapper. `hashMapI64<V>` is a thin adapter that keeps the
 * `i64`-keyed face this container had before the key became a type parameter.
 * --------------------------------------------------------------------------- */

struct i64Key {
    v: i64

    fn hash(self: ref i64Key) -> i64 { return hashI64(self.v) }

    fn ==(self: ref i64Key, other: i64Key) -> bool { return self.v == other.v }
}

/* The `i64`-keyed face: what `hashMapI64<V>` always was, now one conversion deep. */
@noCopy
struct hashMapI64<V> {
    m: hashMap<i64Key, V>

    fn withCap(want: i64) -> hashMapI64<V> {
        var h: hashMapI64<V> = { m: hashMap<i64Key, V>::withCap(want) }
        return h
    }

    fn len(self: ref hashMapI64<V>) -> i64 { return self.m.len() }
    fn capacity(self: ref hashMapI64<V>) -> i64 { return self.m.capacity() }
    fn bytesOf(self: ref hashMapI64<V>) -> i64 { return self.m.bytesOf() }
    fn clone(self: ref hashMapI64<V>) -> hashMapI64<V> {
        var h: hashMapI64<V> = { m: self.m.clone() }
        return h
    }

    fn [](self: ref hashMapI64<V>, k: i64) -> ?V { return self.get(k) }
    fn contains(self: ref hashMapI64<V>, k: i64) -> bool { return self.m.contains(i64Key { v: k }) }
    fn get(self: ref hashMapI64<V>, k: i64) -> ?V { return self.m.get(i64Key { v: k }) }
    fn []=(self: mut ref hashMapI64<V>, k: i64, v: V) -> bool { return self.put(k, v) }
    fn put(self: mut ref hashMapI64<V>, k: i64, v: V) -> bool { return self.m.put(i64Key { v: k }, v) }
    fn remove(self: mut ref hashMapI64<V>, k: i64) -> bool { return self.m.remove(i64Key { v: k }) }
    fn take(self: mut ref hashMapI64<V>, k: i64) -> ?V { return self.m.take(i64Key { v: k }) }
    fn clear(self: mut ref hashMapI64<V>) { self.m.clear() }
    fn compact(self: mut ref hashMapI64<V>) { self.m.compact() }
    fn release(self: mut ref hashMapI64<V>) { self.m.release() }

    fn keyAt(self: ref hashMapI64<V>, i: i64) -> i64 { return self.m.keyAt(i).v }
    fn valAt(self: ref hashMapI64<V>, i: i64) -> V { return self.m.valAt(i) }
    fn liveAt(self: ref hashMapI64<V>, i: i64) -> bool { return self.m.liveAt(i) }

    fn iterKeys(self: ref hashMapI64<V>) -> hashMapI64KeyIter<V> {
        return { m: self, i: -1 }
    }
    fn iterValues(self: ref hashMapI64<V>) -> hashMapI64ValueIter<V> {
        return { m: self, i: -1 }
    }
}

/* `hashMapI64` 的遍历器：键按 `i64` 给出（泛型表的遍历器给的是 `i64Key`，多一层 `.v`）。 */
struct hashMapI64KeyIter<V> {
    m: ref hashMapI64<V>,
    i: i64

    fn iter(self: ref hashMapI64KeyIter<V>) -> hashMapI64KeyIter<V> {
        return { m: self.m, i: -1 }
    }
    fn next(self: mut ref hashMapI64KeyIter<V>) -> bool {
        self.i += 1
        while self.i < self.m.capacity() && !self.m.liveAt(self.i) { self.i += 1 }
        return self.i < self.m.capacity()
    }
    fn value(self: ref hashMapI64KeyIter<V>) -> i64 { return self.m.keyAt(self.i) }
}

struct hashMapI64ValueIter<V> {
    m: ref hashMapI64<V>,
    i: i64

    fn iter(self: ref hashMapI64ValueIter<V>) -> hashMapI64ValueIter<V> {
        return { m: self.m, i: -1 }
    }
    fn next(self: mut ref hashMapI64ValueIter<V>) -> bool {
        self.i += 1
        while self.i < self.m.capacity() && !self.m.liveAt(self.i) { self.i += 1 }
        return self.i < self.m.capacity()
    }
    fn value(self: ref hashMapI64ValueIter<V>) -> V { return self.m.valAt(self.i) }
}

/* `hashSetI64`: a value-less map, built on top of the table above.
 *
 * WHY NOT ITS OWN TABLE: hashing, probing, the shift-back delete and the growth threshold are the
 * parts of a hash container that are easy to get wrong, and a second copy of them means map and
 * set drift apart -- one of them gets a fix, the other silently keeps the bug. So a set IS a map
 * whose value is a placeholder byte: one implementation, one place to fix.
 *
 * The cost is stated honestly: one `u8` per element. Paying a byte to delete a whole class of
 * divergence is the trade this file makes.
 *
 * The face mirrors the map (`withCap` / `len` / `contains` / `put` / `remove` / `clear` plus the
 * table-position scan `keyAt` / `liveAt` / `capacity`), with ONE difference: `put` returns true when
 * the element is NEW, while the map's `put` returns true when it was already there. */
@noCopy
struct hashSetI64 {
    m: hashMapI64<u8>

    fn withCap(want: i64) -> hashSetI64 {
        var s: hashSetI64 = { m: hashMapI64<u8>::withCap(want) }
        return s
    }

    fn len(self: ref hashSetI64) -> i64 { return self.m.len() }
    fn clone(self: ref hashSetI64) -> hashSetI64 {
        var s: hashSetI64 = { m: self.m.clone() }
        return s
    }

    fn contains(self: ref hashSetI64, k: i64) -> bool { return self.m.contains(k) }

    /* Insert one element. True when it was new (the map says the opposite, so flip it). */
    fn put(self: mut ref hashSetI64, k: i64) -> bool {
        if self.m.put(k, u8(0)) { return false }
        return true
    }

    fn remove(self: mut ref hashSetI64, k: i64) -> bool { return self.m.remove(k) }
    fn clear(self: mut ref hashSetI64) { self.m.clear() }
    fn compact(self: mut ref hashSetI64) { self.m.compact() }
    fn release(self: mut ref hashSetI64) { self.m.release() }

    fn keyAt(self: ref hashSetI64, i: i64) -> i64 { return self.m.keyAt(i) }
    fn liveAt(self: ref hashSetI64, i: i64) -> bool { return self.m.liveAt(i) }
    fn capacity(self: ref hashSetI64) -> i64 { return self.m.capacity() }
}