/* std/map.extc -- an **open-addressing hash map** from `i64` keys to any `V`.
 *
 * Why this exists (and why it is not a slot map): a handle costs **three dependent random
 * loads** (handle array -> metadata -> value) while a hash lookup costs **one** after the
 * probe. Random access is the common case, so key -> value wants a hash table and stable
 * identity wants `std::pool`; neither replaces the other.
 *
 * @code
 * use std::io
 * use std::data::hashMap
 *
 * fn main() -> i32 {
 *     var m = hashMapI64<i32>::withCap(4)
 *     let isNew: bool = m.put(1, i32(11))        // false = 新键；true = 键本来就在
 *     let v: i32 = m.get(1) ?? i32(-1)
 *     io::cout << "new=" << isNew << " v=" << v << " len=" << m.len() << "\n"
 *     return 0
 * }
 * @endcode
 *
 * ⚠️ The key is `i64` and the **value** is the generic parameter. extC has no traits, so a
 * generic `K` could not be hashed here: there is no way to call `k.hash()` on a type
 * parameter, and a hash "witness" struct would hit the same wall (`H::hash` on a type
 * parameter does not resolve either). Concrete keys are the honest answer today; an
 * `i64` key packs two `i32`s, a `pool` handle, or an offset in a string table, which
 * covers what a graph or an interpreter needs. A byte-view keyed map is the next family.
 *
 * Layout, and why:
 *   - **linear probing** (one cache line per probe, no pointers at all);
 *   - `cap` is a power of two, so the probe index is `hash & (cap-1)` -- no division;
 *   - the hash mixes with shifts, xors and one multiply, and every step of it is overflow-free:
 *     the multiply is done in `u64`, where overflow is defined (mod 2^64) in C, so the mixing
 *     does not lean on `-fwrapv` and cannot be broken by a stricter optimisation level;
 *   - a slot is empty / live / tombstone in a separate byte array. Tombstones keep probes
 *     correct after a removal; they are cleared by a rebuild, which also happens when too
 *     many of them pile up;
 *   - the arrays are arena memory like everything else: rehashing leaves the old arrays
 *     behind (bounded, O(log n) rebuilds over a map's life) and a pool will reclaim them
 *     in phase 1+.
 */

use std::data::pool
use std::sys::pool as syspool    /* 运行期池记录：本容器自己的那一只，值池以它为父 */

let EMPTY: u8 = 0
let LIVE:  u8 = 1
let TOMB:  u8 = 2

/* Mix a key into a spread-out non-negative i64.
 *
 * ⚠️ 混合体走**无符号**（`u64`）—— 这不是风格，是正确性：有符号 `*` 溢出在 C 里是 UB。
 * extC 的算术溢出靠 `-fwrapv` 兜成绕回（MANUAL §8），可那是**编译器驱动**给的旗子；
 * 生成的 C 一旦被别人用别的旗子编（本仓库就有好几处测试脚本直接 `cc -O1` 编生成的 C，
 * 不带 `-fwrapv`），GCC 在 `-O2` 下按"乘法不会溢出"优化 ⇒ 桶分布退化成一条长簇：
 * 实测 1e6 次 `put` 从 0.08 s 变成**挂死不返回**（99.7% CPU 空转，RSS 一路涨到十几 GB）。
 * 哈希函数绝不能
 * 依赖"编译器替我定义 UB"。无符号 `*` 溢出在 C 里是**有定义**的（模 2^64），与旗子无关；
 * 两次转换都在可证明无损的范围内 ⇒ 生成 C 里不带任何检查。
 *
 * 为什么要乘法：只做右移-xor 时，**小于 2^21 的键是不动的**（`x ^ (x>>21) ^ (x>>42)` 对
 * x < 2^21 恒等于 x）⇒ 连续的小整数键映射到**连续的桶**。实测（bench/app/session.extc）：
 *     hashI64(0..8) = 0,1,2,3,4,5,6,7,8（相邻键的桶差恒为 1），
 *     65536 个连续键于是在表里连成**一整条 65536 长的簇**；
 *     而一旦有删除（墓碑不终止探测），一次 miss 查询平均要走 16371 步、最长 65536 步
 *     ⇒ 端到端 10.5 ns/op → 5104 ns/op（**486 倍**）。
 * 连续整数键不是刁钻输入 —— 自增的连接 id / 会话号 / 数组下标都是这样。
 * 乘一个奇数（与 2^64 互质 ⇒ 是置换）把低位的信息搬上去，右移再把它混回低位。 */
fn hashI64(k: i64) -> i64 {
    var x = k & 9223372036854775807          /* drop the sign bit: the i64 -> u64 conversion must not be lossy */
    var u = u64(x)
    u = u * u64(6364136223846793005)              /* Knuth 的 LCG 乘数：奇数 ⇒ 与 2^64 互质 */
    u = u ^ (u >> u64(21))
    u = u ^ (u >> u64(42))
    u = u & u64(9223372036854775807)              /* 清掉最高位 ⇒ 转回 i64 无损（收窄检查不生成代码） */
    return i64(u)
}

/* The `hash` of an `i64` key: the step that makes `hashMap<i64, V>` work directly.
 *
 * The attachment point is an `impl` block, which is needed because methods may only be declared
 * inside a `struct` body and `i64` is a compiler builtin with no body to write one in. Methods
 * added by an `impl` block are indistinguishable from methods written in the body (same one
 * method set, same per-instance checks), so `hashMap<i64, V>` needs no wrapper at all.
 *
 * `==` is not attached: equality on a builtin is native to the language (the compiler emits it
 * directly). Only named methods need an impl. */
impl i64 {
    fn hash(self: ref i64) -> i64 { return hashI64(*self) }
}

@sharesStorage        /* 按值拷贝时**两份共用同一块板块** ⇒ 编译器在这里报警告，要独立副本用 `clone()` */
@place                 /* 这个类型**拥有一个地方**：存储住在那个地方的板块上，寿命随它所在的域 */
struct hashMap<K, V> {
    /* This container's OWN pool record. One non-nested container = one pool;
     * `vals` is created with this as its parent, so the two records really form a tree and
     * dropping this one takes the value pool with it. */
    @private pid:    i64
    @private pidGen: u64
    @private keys: mut slice<K>          /* the bucket's key (live buckets only) */
    tag:  mut slice<u8>         /* EMPTY / LIVE / TOMB */
    slot: mut slice<i32>        /* bucket -> dense index inside `vals` (-1 when not live) */
    /* The reverse of `slot`, one entry per dense index. The pool's `remove` is a swap-remove:
     * the last live value moves into the hole, so the map has to fix the moved element's bucket,
     * and this column is what says which bucket that is. Without it the table would keep pointing
     * at values that moved. */
    @private bucketOfDense: mut slice<i32>
    vals: pool<V>               /* the values themselves: dense, reusable, handle-addressed */
    @private n:    i64                   /* live entries */
    @private dead: i64                   /* tombstones */
    @private cap:  i64                   /* always a power of two */

    /* A map with room for `want` entries before the first rebuild. */
    fn withCap(want: i64) -> hashMap<K, V> {
        var c: i64 = 8
        while c < want * 2 { c = c * 2 }
        let rp  = syspool::extc_pool_new(-1)
        let rpg = syspool::extc_pool_generation(rp)
        var m: hashMap<K, V> = {
            pid:    rp,
            pidGen: rpg,
            /* 四列都在**这张表自己的池板块**上（不是 arena 切片）：重建时旧的几块当场
             * 还回去，不留历代旧列。之前用 `new` 时，每一次 rebuild 都把上一代的四列
             * 留给 arena —— 同容量同条目数下峰值 90,412 KB vs 69,036 KB，那 30% 就是它们。 */
            keys: poolSliceRaw<K>(rp, c),
            tag:  poolSlice<u8>(rp, c),          /* ⚠️ tag 必须清零：EMPTY == 0 是探测的终止符 */
            slot: poolSliceRaw<i32>(rp, c),
            bucketOfDense: poolSliceRaw<i32>(rp, c),
            vals: pool<V>::withParent(rp, c),      /* 值池以这个容器自己的池为父 */
            n:    0,
            dead: 0,
            cap:  c,
        }
        return m
    }

    fn len(self: ref hashMap<K, V>) -> i64 { return self.n }
    fn capOf(self: ref hashMap<K, V>) -> i64 { return self.cap }
    /* 本表运行期池的下标（只读读数）：容量与字节账的判据要指到**这一只**池上。 */
    @private fn pidOf(self: ref hashMap<K, V>) -> i64 { return self.pid }
    /* 墓碑与活跃数的读数（只读）：探测链变长的诊断用它。 */
    @private fn deadOf(self: ref hashMap<K, V>) -> i64 { return self.dead }
    /* 诊断读数：桶的三种状态各有多少（EMPTY 是探测链的终止符，它的数量决定 miss 的代价）。 */
    fn tagCensus(self: ref hashMap<K, V>, which: i64) -> i64 {
        var c: i64 = 0
        var i: i64 = 0
        while i < self.cap {
            if i64(self.tag[i]) == which { c = c + 1 }
            i = i + 1
        }
        return c
    }

    /* 这张表**当下**在它自己池里占的字节（四列 + 值池）。
     * 判据：`rebuild` 把旧列当场还了 ⇒ 这个数只随当前 `cap` 走，与重建过多少次无关；
     * 若旧列还留着，它会大一整代（见 tests/hashmap/run.sh）。 */
    fn bytesOf(self: ref hashMap<K, V>) -> i64 { return syspool::extc_pool_bytes(self.pid) }

    /* Find the bucket holding `k`: live bucket index, or -1 when absent.
     *
     * The two indexings below are unchecked: `i` is always masked by `cap - 1` before it is used, and
     * the loop runs at most `cap` steps, so both stay inside the three columns by construction. This
     * is the probe loop of every lookup, so the per-step bounds checks are what the decoration buys
     * (the signature that goes with it is the same one `sha256` and `string::eq` use). */
    @unchecked
    fn find(self: ref hashMap<K, V>, k: K) -> i64 {
        var i = k.hash() & (self.cap - 1)
        var steps: i64 = 0
        while steps < self.cap {
            let t = self.tag[i]
            if t == EMPTY { return -1 }
            if t == LIVE && self.keys[i] == k { return i }
            i = (i + 1) & (self.cap - 1)
            steps = steps + 1
        }
        return -1
    }

    fn contains(self: ref hashMap<K, V>, k: K) -> bool { return self.find(k) >= 0 }

    /* `hm[k]` -- the read side of the subscript syntax (`[]` and `[]=` are independent names, so
     * a type may offer reading without writing). Same answer as `get`: `none` when absent. */
    fn [](self: ref hashMap<K, V>, k: K) -> ?V { return self.get(k) }

    /* The value for `k`, or `none`. */
    fn get(self: ref hashMap<K, V>, k: K) -> ?V {
        let b = self.find(k)
        if b < 0 { return none }
        /* Read the dense prefix, not a handle: `slot[b]` already resolved the storage, so
         * going through `handleAtDense` + `vals.get` would re-derive the same dense index
         * and re-check a generation that this call cannot have missed. */
        return some(self.vals.atDense(i64(self.slot[b])))
    }

    /* `k` 的值槽：一次探测拿 handle，之后 `at`/`setAt` 不再探测。读-改-写一个已有键因此只要
     * 一次探测（`get` + `put` 要两次），这是"取出来改一下写回去"该有的形状。
     * handle 是池的**值**，不是指针：值池扩容/搬动不会让它悬垂，过期了 `at` 会还 `none`。 */
    fn slotOf(self: ref hashMap<K, V>, k: K) -> ?handle {
        let b = self.find(k)
        if b < 0 { return none }
        return some(self.vals.handleAtDense(i64(self.slot[b])))
    }

    /* handle 指向的值；handle 过期（被 remove 搬走、或池清了）时 `none`。 */
    fn at(self: ref hashMap<K, V>, h: handle) -> ?V { return self.vals.get(h) }

    /* 用 handle 就地写回：一次池访问，不探测。 */
    fn setAt(self: mut ref hashMap<K, V>, h: handle, v: V) -> bool { return self.vals.set(h, v) }

    /* `k` 的 handle，缺失时插入 `dflt`。命中只探测一次；新键多一次（`put` 内部再探），
     * 所以"每记录一次哈希探测"的循环就写这一句。 */
    fn entry(self: mut ref hashMap<K, V>, k: K, dflt: V) -> handle {
        if self.pStale() { self.pPoison() }
        let had = self.find(k)
        if had >= 0 { return self.vals.handleAtDense(i64(self.slot[had])) }
        self.put(k, dflt)
        let b = self.find(k)
        return self.vals.handleAtDense(i64(self.slot[b]))
    }

    /* Insert or overwrite. Returns true when the key was already there. */
    /* `hm[k] = v` -- the write side (`[]` and `[]=` are independent names). Same semantics as
     * `put`: insert when absent, overwrite when present. */
    fn []=(self: mut ref hashMap<K, V>, k: K, v: V) -> bool { return self.put(k, v) }

    fn put(self: mut ref hashMap<K, V>, k: K, v: V) -> bool {
        if self.pStale() { self.pPoison() }
        let had = self.find(k)
        if had >= 0 {
            /* The overwrite path is the hot one for a read-modify-write loop, so it writes
             * the dense prefix directly: `slot[had]` is the storage index already, and this
             * probe is the liveness check (the bucket is LIVE). */
            self.vals.setAtDense(i64(self.slot[had]), v)
            return true
        }
        /* Rebuild *before* inserting, while there is still a free bucket to land in.
         *
         * **两条触发线**，缺一条就会退化（实测 2026-09-26，bench/app/session.extc）：
         *   ① 满度：`n + dead` 到容量的 70% —— 原来的那条，管"放不下"。
         *   ② 墓碑密度：`dead` 到容量的 25% —— 新加的，管"探测链被墓碑拖长"。
         * 只有①时，一个活跃集小而删除频繁的负载（会话表就是这样）会把 dead 堆到 40% 的
         * 容量：此时 `find` 每一步都要跨过墓碑，实测 **25 ns/op → 584 ns/op（23 倍）**，
         * 而 `n` 一直很小、容量一直够 —— 第①条永远不触发。
         * ②的上界取 25%：探测链的期望长度随 1/(1-墓碑比例) 走，25% 时约 1.33 倍，
         * 再高就开始看得见（40% 时 1.67 倍，而实测的差距远不止这个比例 —— 它还会
         * 把 probe 跨过的桶都拉进 cache）。 */
        if (self.n + self.dead + 1) * 10 >= self.cap * 7 { self.rebuild(self.cap * 2) }
        var i = k.hash() & (self.cap - 1)
        while self.tag[i] == LIVE {
            i = (i + 1) & (self.cap - 1)
        }
        if self.tag[i] == TOMB { self.dead = self.dead - 1 }
        let h = self.vals.insert(v)
        let d = self.vals.len() - 1
        self.tag[i]  = LIVE
        self.keys[i] = k
        self.slot[i] = i32(d)
        self.bucketOfDense[d] = i32(i)
        self.n = self.n + 1
        return false
    }

    /* Remove `k`. Returns true when it was there.
     *
     * **Deletion shifts the cluster back instead of leaving a tombstone** (Knuth, TAOCP vol. 3,
     * 6.4 algorithm R). A tombstone would keep the probe sequence of someone else's key alive,
     * so it has to stay occupied forever -- and every miss that walks over one pays for it.
     * Measured on a 1M-key table after 500k removals: 26 ns/lookup with tombstones against
     * 15 ns for the same table untouched, and an identity hash (the natural choice for
     * monotonic integer keys) takes 116 s because the tombstones turn one long contiguous
     * cluster into one long failed walk. Shifting back keeps the table tombstone-free, so a
     * probe only ever stops at an EMPTY bucket and the hash function is free to be cheap.
     *
     * The element that moves into the hole keeps its own key, tag, dense index and reverse
     * index; only its bucket number changes. The walk continues with the vacated bucket as
     * the new hole, so a whole run of entries that hash behind it follows in one pass. */
    fn remove(self: mut ref hashMap<K, V>, k: K) -> bool {
        let b = self.find(k)
        if b < 0 { return false }
        let d      = i64(self.slot[b])
        let last   = self.vals.len() - 1
        let bMoved = i64(self.bucketOfDense[last])
        let gone   = self.vals.remove(self.vals.handleAtDense(d))
        /* The pool filled the hole with the last live value; point that element's bucket at its
         * new dense index, or a later lookup would read somebody else's value. */
        if d != last {
            self.slot[bMoved] = i32(d)
            self.bucketOfDense[d] = i32(bMoved)
        }
        self.n = self.n - 1
        self.tag[b] = EMPTY
        let mask = self.cap - 1
        var hole = b
        var j    = (b + 1) & mask
        while self.tag[j] == LIVE {
            let home = self.keys[j].hash() & mask
            /* The entry at `j` may fill the hole only when its own probe sequence reaches
             * `j` without first crossing the hole -- otherwise moving it would hide it from
             * its own lookup. Distances are taken modulo the capacity. */
            if ((j - home) & mask) >= ((j - hole) & mask) {
                self.keys[hole] = self.keys[j]
                self.tag[hole]  = LIVE
                self.slot[hole] = self.slot[j]
                self.bucketOfDense[i64(self.slot[hole])] = i32(hole)
                self.tag[j] = EMPTY
                hole = j
            }
            j = (j + 1) & mask
        }
        return gone
    }

    /* Rehash into a table of `ncap` buckets (a power of two), dropping the tombstones. The values
     * are not touched: they stay exactly where the pool put them, which is what keeps an element's
     * dense index (and every live handle) valid across a rebuild. */
    fn rebuild(self: mut ref hashMap<K, V>, ncap: i64) {
        /* 新表从池里拿四块，旧的填完当场还（`poolGive`）—— 于是重建只在**换的那一瞬间**
         * 有两代同时在手，稳态永远只有一代。容量仍然翻倍：这是**哈希**的要求（探测用
         * `hash & (cap-1)`，必须是 2 的幂），与"旧块还不了才翻倍"那条无关。 */
        var nk: mut slice<K>   = poolSliceRaw<K>(self.pid, ncap)
        var nt: mut slice<u8>  = poolSlice<u8>(self.pid, ncap)   /* ⚠️ 同上：新 tag 必须全 EMPTY */
        var ns: mut slice<i32> = poolSliceRaw<i32>(self.pid, ncap)
        /* `bucketOfDense` is indexed by DENSE index, so it has to hold as many entries as there
         * are values -- and the pool's dense side grows past the old table capacity as soon as
         * the table doubles. `poolResizeRaw` extends it in place, keeping the live prefix; the
         * rehash below fills the rest. */
        /* `bucketOfDense` 是**稠密下标**索引的（位置与容量无关）⇒ 直接加长：内容原地保留，
         * 那趟前缀拷贝整段删掉。另外三列做不到这件事 —— 桶号 `h & (cap-1)` 随 cap 变，
         * 每个元素的位置都变，O(n) 重排是哈希扩容语义的一部分。
         * `bucketOfDense` 的长度仍要是 ncap：池的稠密侧会随表一起长过旧容量，
         * 早先留着旧长度的那版在第一次长表后写越界过（`index 128 out of range (length 128)`）。 */
        self.bucketOfDense = poolResizeRaw<i32>(self.pid, self.bucketOfDense, ncap)
        var i: i64 = 0
        while i < self.cap {
            if self.tag[i] == LIVE {
                var j = self.keys[i].hash() & (ncap - 1)
                while nt[j] == LIVE { j = (j + 1) & (ncap - 1) }
                nt[j] = LIVE
                nk[j] = self.keys[i]
                ns[j] = self.slot[i]
                self.bucketOfDense[i64(self.slot[i])] = i32(j)
            }
            i = i + 1
        }
        poolGive<K>(self.pid, self.keys)
        poolGive<u8>(self.pid, self.tag)
        poolGive<i32>(self.pid, self.slot)
        self.keys = nk
        self.tag  = nt
        self.slot = ns
        self.cap  = ncap
        self.dead = 0
    }

    /* Drop every entry, keeping the capacity. `clear` on the pool is O(1) (it flips the pool
     * epoch, */
    fn clear(self: mut ref hashMap<K, V>) {
        var i: i64 = 0
        while i < self.cap { self.tag[i] = EMPTY  i = i + 1 }
        self.vals.clear()
        self.n    = 0
        self.dead = 0
    }

    /* Hand the value pool back: the container and its pool are born together. */
    /* 整棵池树还回去：先放值池（它的三块视图会被收成 0 长），再放这个容器自己的记录。
     * 父池的递归本来也会带走子池，两处都做不冲突：谁先到谁放，后到的查不到活记录就跳过。 */
    /* **守卫**：这一份哈希表值还指着它的池吗？陈旧 ⇒ 四列收空，下一次访问带位置地 trap。 */
    fn pStale(self: ref hashMap<K, V>) -> bool {
        if self.pid < 0 { return false }
        return syspool::extc_pool_generation(self.pid) != self.pidGen
    }
    fn pPoison(self: mut ref hashMap<K, V>) {
        self.keys = poolSlice<K>(-1, 0)
        self.tag  = poolSlice<u8>(-1, 0)
        self.slot = poolSlice<i32>(-1, 0)
        self.bucketOfDense = poolSlice<i32>(-1, 0)
        self.n    = 0
        self.dead = 0
        self.cap  = 0
        self.pid  = -1
    }

    fn release(self: mut ref hashMap<K, V>) {
        self.vals.release()
        if self.pid < 0 { return }
        /* One staleness question, one place to ask it (`pStale`): the comparison lives in
         * exactly one place, and two copies of a load-bearing check would drift. */
        if self.pStale() {
            self.pid = -1  /* 陈旧拷贝：槽位已被别的池复用 */
            return
        }
        syspool::extc_pool_reset(self.pid)
        syspool::extc_pool_drop(self.pid)
        self.pid = -1
    }

    /* Scan by bucket position (the face the first version had). */
    fn keyAt(self: ref hashMap<K, V>, i: i64) -> K { return self.keys[i] }
    fn valAt(self: ref hashMap<K, V>, i: i64) -> V { return self.vals.atDense(i64(self.slot[i])) }
    fn liveAt(self: ref hashMap<K, V>, i: i64) -> bool { return self.tag[i] == LIVE }

    /* Scan the dense side: every live value once, in the pool's own order -- no probing and no
     * holes. This is the face a hot loop wants. */
    fn denseLen(self: ref hashMap<K, V>) -> i64 { return self.vals.len() }
    fn keyAtDense(self: ref hashMap<K, V>, d: i64) -> K { return self.keys[i64(self.bucketOfDense[d])] }
    fn valAtDense(self: ref hashMap<K, V>, d: i64) -> V { return self.vals.atDense(d) }

    /* **深拷贝：要一份独立的表就用它。** `var b = a` 是结构体逐成员拷贝（共用板块）⇒
     * 改 b 会改到 a、a.release() 会让 b 悬垂。这里显式拷一份（O(n) + 一块新板块）。 */
    fn clone(self: ref hashMap<K, V>) -> hashMap<K, V> {
        var out = hashMap<K, V>::withCap(self.n + 1)
        var d: i64 = 0
        while d < self.denseLen() {
            out.put(self.keyAtDense(d), self.valAtDense(d))
            d = d + 1
        }
        return out
    }
}

/* ---------------------------------------------------------------------------
 * The integer fast path: a key wrapper, NOT a second table.
 *
 * `hashMap<K, V>` asks its key for `hash()` and `==`, so an `i64` key has to get those two
 * methods from somewhere. Methods live inside a `struct` and `i64` is built in, so there is
 * nowhere to write them -- hence the wrapper. `i64Key` carries the original `hashI64` mix and
 * `==`; `hashMapI64<V>` is a thin adapter that keeps the `i64`-keyed face this container had
 * before the key became a type parameter.
 *
 * Why not a second table for `i64` keys: hashing, linear probing, tombstones and the rebuild
 * threshold are the parts that are easy to get wrong, and two copies of them drift -- one gets
 * a fix, the other silently keeps the bug. One table, one place to fix. The wrapper costs
 * nothing: an `i64Key` is one `i64`.
 * --------------------------------------------------------------------------- */

struct i64Key {
    v: i64

    /* The mix the table used before it took a key type parameter. */
    fn hash(self: ref i64Key) -> i64 { return hashI64(self.v) }

    fn ==(self: ref i64Key, other: i64Key) -> bool { return self.v == other.v }
}

/* The `i64`-keyed face: what `hashMapI64<V>` always was, now one conversion deep. */
@sharesStorage        /* 按值拷贝时**两份共用同一块板块** ⇒ 编译器在这里报警告，要独立副本用 `clone()` */
struct hashMapI64<V> {
    m: hashMap<i64Key, V>

    fn withCap(want: i64) -> hashMapI64<V> {
        var h: hashMapI64<V> = { m: hashMap<i64Key, V>::withCap(want) }
        return h
    }

    fn len(self: ref hashMapI64<V>) -> i64 { return self.m.len() }
    fn capOf(self: ref hashMapI64<V>) -> i64 { return self.m.capOf() }
    fn bytesOf(self: ref hashMapI64<V>) -> i64 { return self.m.bytesOf() }
    fn clone(self: ref hashMapI64<V>) -> hashMapI64<V> {
        var h: hashMapI64<V> = { m: self.m.clone() }
        return h
    }
    @private fn pidOf(self: ref hashMapI64<V>) -> i64 { return self.m.pidOf() }
    @private fn deadOf(self: ref hashMapI64<V>) -> i64 { return self.m.deadOf() }
    @private fn tagCensus(self: ref hashMapI64<V>, which: i64) -> i64 { return self.m.tagCensus(which) }

    fn [](self: ref hashMapI64<V>, k: i64) -> ?V { return self.get(k) }

    fn contains(self: ref hashMapI64<V>, k: i64) -> bool {
        return self.m.contains(i64Key { v: k })
    }

    fn get(self: ref hashMapI64<V>, k: i64) -> ?V { return self.m.get(i64Key { v: k }) }

    fn []=(self: mut ref hashMapI64<V>, k: i64, v: V) -> bool { return self.put(k, v) }

    fn put(self: mut ref hashMapI64<V>, k: i64, v: V) -> bool {
        return self.m.put(i64Key { v: k }, v)
    }

    fn remove(self: mut ref hashMapI64<V>, k: i64) -> bool { return self.m.remove(i64Key { v: k }) }

    /* handle 走的是值池里的稳定槽位，不是指针：值池扩容搬动数据时不会悬垂。 */
    fn slotOf(self: ref hashMapI64<V>, k: i64) -> ?handle { return self.m.slotOf(i64Key { v: k }) }
    fn at(self: ref hashMapI64<V>, h: handle) -> ?V { return self.m.at(h) }
    fn setAt(self: mut ref hashMapI64<V>, h: handle, v: V) -> bool { return self.m.setAt(h, v) }
    fn entry(self: mut ref hashMapI64<V>, k: i64, dflt: V) -> handle {
        return self.m.entry(i64Key { v: k }, dflt)
    }

    fn clear(self: mut ref hashMapI64<V>) { self.m.clear() }

    /* 整棵池树还回去（本容器自己的池 + 值池） */
    fn release(self: mut ref hashMapI64<V>) { self.m.release() }

    /* The dense face (`hashMap`'s own face): every live value once, in insertion order, no
     * probing and no holes -- the reason the values live in a pool at all. */
    fn denseLen(self: ref hashMapI64<V>) -> i64 { return self.m.denseLen() }
    fn keyAtDense(self: ref hashMapI64<V>, d: i64) -> i64 { return self.m.keyAtDense(d).v }
    fn valAtDense(self: ref hashMapI64<V>, d: i64) -> V { return self.m.valAtDense(d) }

    fn keyAt(self: ref hashMapI64<V>, i: i64) -> i64 { return self.m.keyAt(i).v }
    fn valAt(self: ref hashMapI64<V>, i: i64) -> V { return self.m.valAt(i) }
    fn liveAt(self: ref hashMapI64<V>, i: i64) -> bool { return self.m.liveAt(i) }
}

/* stl/hashSet.extc -- `hashSetI64`: a value-less map, built on top of `stl/map`.
 *
 * WHY NOT ITS OWN TABLE: hashing, linear probing, tombstones and the rebuild threshold are the
 * parts of a hash container that are easy to get wrong, and a second copy of them means `map`
 * and `set` drift apart -- one of them gets a fix, the other silently keeps the bug. So a set
 * IS a map whose value is a placeholder byte: one implementation, one place to fix.
 *
 * The cost is stated honestly: one `u8` per element. Paying a byte to delete a whole class of
 * divergence is the trade this file makes.
 *
 * The face mirrors `map` exactly (`withCap` / `len` / `contains` / `put` / `remove` / `clear`
 * plus the table-position scan `keyAt` / `liveAt` / `capOf`), with ONE difference: `put` returns
 * true when the element is NEW, while `map::put` returns true when it was already there. */

@sharesStorage        /* 按值拷贝时**两份共用同一块板块** ⇒ 编译器在这里报警告，要独立副本用 `clone()` */
struct hashSetI64 {
    m: hashMapI64<u8>

    fn withCap(want: i64) -> hashSetI64 {
        var s: hashSetI64 = { m: hashMapI64<u8>::withCap(want) }
        return s
    }

    fn len(self: ref hashSetI64) -> i64 { return self.m.len() }
    /* **深拷贝**（同 set：逐成员拷贝会共用底层表的板块）。 */
    fn clone(self: ref hashSetI64) -> hashSetI64 {
        var s: hashSetI64 = { m: self.m.clone() }
        return s
    }

    fn contains(self: ref hashSetI64, k: i64) -> bool { return self.m.contains(k) }

    /* Insert one element. True when it was new (the map says the opposite, so flip it). */
    fn put(self: mut ref hashSetI64, k: i64) -> bool {
        if self.m.put(k, u8(0)) { return false }
        return true
    }

    /* Remove one element. True when it was there. */
    fn remove(self: mut ref hashSetI64, k: i64) -> bool { return self.m.remove(k) }

    fn clear(self: mut ref hashSetI64) { self.m.clear() }

    /* 整棵池树还回去 */
    fn release(self: mut ref hashSetI64) { self.m.release() }

    /* Scan by table position (the dense face arrives with the pool-backed map). */
    fn keyAt(self: ref hashSetI64, i: i64) -> i64 { return self.m.keyAt(i) }
    fn liveAt(self: ref hashSetI64, i: i64) -> bool { return self.m.liveAt(i) }
    fn capOf(self: ref hashSetI64) -> i64 { return self.m.capOf() }
}
