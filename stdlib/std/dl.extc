/* std/dl.extc —— `dlopen` / `dlsym` / `dlclose` 的 extC 面（C-ABI.md §9.9 第 ③ 块）
 *
 * 这一层薄得很，因为它该薄：三个 libc 符号 + 一件 extC 侧必须自己做的事 ——
 *
 * **`str` 不是 NUL 结尾的**。extC 的字符串是 `{data, len}`（切片），而 C 的名字参数要一个
 * 以 0 结尾的缓冲区。这不是"缺一个转换"，而是两边的表示本来就不同：切片的长度在值里，C 的长度
 * 在终止符里。所以这里造一个（`cstr`），并把它记成这一层存在的第二个理由。
 *
 * 第三个理由在**调用方**那边，不在这个文件里：`dlsym` 回来的是 `ref void`，要当成 `fn` 用得写一次
 * **显式转换**（`fn(i64) -> i64(raw)`）—— 那句话就是作者的签字，与 `effects` 同一类。
 *
 * 谁能声明这些原语：与 `std::sys::*` 同一档（`LIBS.md` §5；v1 尚未强制只有特权模块能声明）。 */
/* `void *dlopen(const char *file, int flags)`；`void *dlsym(void *h, const char *name)`；
 * `int dlclose(void *h)`；`char *dlerror(void)`。
 * 三条都签 `Addr=0 Cont=0`：glibc 不会留下我们给的缓冲区（名字是当场拷走的）。 */
extern!("libc") fn dlopen(path: ref u8, flags: i32) -> ?ref void
    effects Addr=0 Cont=0
extern!("libc") fn dlsym(h: ?ref void, name: ref u8) -> ?ref void
    effects Addr=0 Cont=0
extern!("libc") fn dlclose(h: ?ref void) -> i32
    effects Addr=0 Cont=0
extern!("libc") fn dlerror() -> ?ref u8
    effects Addr=0 Cont=0

let RTLD_LAZY: i32 = 1
let RTLD_NOW: i32 = 2
let RTLD_GLOBAL: i32 = 256

/* `slice<u8>` 不保证 NUL 结尾，而 C 的名字参数要一个 0 结尾的缓冲区 —— 这不是"缺一个转换"，
 * 而是两边的表示本来就不同：切片的长度在值里，C 的长度在终止符里。
 *
 * 所以规矩与 `std::fs` **完全一样**（它的文件头也写着同一句话）：**调用方保证终止符**。
 *   · 字符串**字面量**在 C 那边本来就是 0 结尾的 ⇒ `dl::open("libfoo.so")` 直接可用；
 *   · 运行期拼出来的名字用 `cstr` 拷一份并补 0（`new` 分配在**本函数的家 arena** 里，
 *     所以返回它合法，寿命跟着调用方的块走）。
 *
 * 为什么不把这件事吞进 `open` 里：那样 `open` 会返回一个"由帧内缓冲区派生"的指针，
 * 而逃逸检查（正确地）拒绝"返回值指向本帧" —— dlopen 的句柄其实不指向那个缓冲区，但
 * **编译器看不出来**，而它是按能证明的东西说话的。让调用方给一个活得够久的缓冲区，
 * 这件事就不需要证明。 */
fn cstr(s: slice<u8>) -> mut slice<u8> {
    var n: i64 = s.len
    var b: mut slice<u8> = new u8[n + i64(1)]
    var i: i64 = 0
    while i < n {
        b[i] = s[i]
        i = i + 1
    }
    b[n] = u8(0)
    return b
}

/* 打开一个共享对象（`path` 必须 NUL 结尾：字面量直接传，运行期拼的先用 `cstr`）。
 * 失败返回 `null`（要问为什么就 `dlerror()`）。 */
fn open(path: slice<u8>) -> ?ref void { return dlopen(path.data, RTLD_NOW) }

/* 取一个符号。**给的是地址，不是类型** —— 把它变成可调用的值要调用方写一次显式转换：
 *     var f: fn(i64) -> i64 = fn(i64) -> i64(raw!)
 * 这就是作者的签字：C 的 `dlsym` 回来的是 `void *`，谁也不知道它到底是什么。 */
fn sym(h: ?ref void, name: slice<u8>) -> ?ref void { return dlsym(h, name.data) }

fn close(h: ?ref void) -> i32 { return dlclose(h) }
