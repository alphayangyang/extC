// The extC prelude: a piece of extC source processed before the user file on every compile.
//
// Why it exists: anything that can be written in extC should be written in extC.
// Without it, slice<T> would be hard-coded in codegen.c: the library inside the compiler.
//
// Types written here are available without an import.
//
// NOTE: `slice` is a reserved definition: a user cannot redefine it (a duplicate name is an
//    error), and extC has no impl blocks: methods live inside the struct body, so there is no
//    way to add a method to an existing type -- which is exactly what prevents confusion.
//
// NOTE: the compiler only knows the protocol of this type -- `data` + `len` -- because `s[i]`
//    is syntax. Field names cannot change; methods are free.

// ---------------------------------------------------------------------------
// The empty payload: the "succeeded, but there is no value for you" case of `result<unit, E>`
//
// C has no empty struct: the compiler adds a placeholder byte for it (unitBody in codegen.c).
// A real type instead of a special case for `result<void, E>`: uniform syntax, no exceptions.
// ---------------------------------------------------------------------------

struct unit {
}

// ---------------------------------------------------------------------------
// option<T> -- "there may be a value, or there may not be"
//
// It is a plain enum (as of 2026-09-20): `| none | some(T)`
//
//   - the zero value is tag 0 = `none` (no payload) => `var o: option<i64>` means "nothing" -- OK.
//     No coincidence: zero-initialization. Variant order matters, so `| some(T) | none` would
//     make `var o: option<i64>` mean "present, but zero" -- WRONG.
//   - `T` may be a ref or a view, so `option<slice<u8>>` is legal -- OK. A struct cannot be
//     the representation: `none`'s `value` field has nothing to fill it with, and "a ref is never
//     null" is a promise extC makes, so a struct shape could report only
//     `__extc_reference_has_no_zero_value__` -- WRONG. Tag 0 = none means no payload, so the hole
//     is closed -- OK.
//   - there are only two ways to get the value out: `match` (exhaustive), or `?` to pass the
//     failure up. There is deliberately no `unwrap()`: that needs a trap primitive, and a
//     library that traps does not fit extC's character -- if you want a trap, write it at the
//     call site. `valueOr` is absent too: enum methods do not exist yet, and `match` is clearer.
// ---------------------------------------------------------------------------

/* 协程的**接口标记**：函数返回类型写 `coroutine<T>` 就表示"这是个协程、会 yield T"。
 * 真实表示由编译器按**每个协程函数**合成的帧结构体——
 * 所以这个声明本身不承载数据，只是让名字可解析 ✓ 用户不要直接拿它当变量类型用。 */
struct coroutine<A, B> { unit: bool }   /* A = `send` 进去的（请求），B = `yield` 出来的（应答）；`coroutine<T>` 是同型两遍的简写 */

type option<T> = | none | some(T)

/* `x ?? break` / `x ?? continue` 的检查器展开用：只问"有没有值"，不取值。
 * 这是给编译器展开用的（用户写 `x ?? break` 即可）；名字避开 `__` 前缀，语言保留那个前缀。 */
fn preludeIsNone<T>(o: option<T>) -> bool {
    match o {
        some(_) => { return false }
        none    => { return true  }
    }
}

// ---------------------------------------------------------------------------
// result<T, E> -- "either it succeeds and gives you a value, or it fails with an error"
//
// It is a plain enum too: `| failure(E) | success(T)`. The zero value is tag 0 = `failure`
//    (the zero value of `E`) => the failure side is still the zero side, as before -- OK.
//
// The constructors are named success / failure, not ok / err: those two words are reserved for
//    reading, and the place that reads is the variant name in `match` -- OK.
// ---------------------------------------------------------------------------

type result<T, E> = | failure(E) | success(T)

// ---------------------------------------------------------------------------
// pcg32 -- a random number engine (small, fast, state held explicitly, no globals)
//
//     var rng: pcg32 = pcg32::seeded(42)
//     println(rng.nextBounded(100))
//
// Why not `rand()` or a global engine: that is hidden state -- you cannot see who moved it or
//    when, or why a hundred runs differ. extC's shape is "you hold a value":
//     - all of it on the stack (16 bytes), zero allocation -- OK
//     - the same seed => the same sequence (all platforms and builds) => a failure reproduces -- OK
//     - a second, independent sequence is another `stream` (e.g. one per Zobrist column) -- OK
//
// Why pcg32 and not mt19937: 16 bytes of state vs 2.5KB, about 20 lines vs about 60, and the
//    statistical quality is top-tier either way (passes the whole TestU01 BigCrush suite) -- OK
//
// NOTE: every value is `u64` (in 0 .. 2^32-1). extC widens automatically, narrowing needs an
//    explicit conversion that does not exist yet -- so no i64/f64 interface here -- OK.
// ---------------------------------------------------------------------------

struct pcg32 {
    state: u64
    @private inc: u64

    // The official PCG32 XSH-RR output function: it mixes the state into a 32-bit output.
    fn next(self: mut ref pcg32) -> u64 {
        var old: u64 = self.state
        self.state = old * 6364136223846793005 + self.inc
        var x: u64 = (((old >> 18) ^ old) >> 27) & 4294967295
        var rot: u64 = old >> 59
        return ((x >> rot) | (x << ((32 - rot) & 31))) & 4294967295
    }

    // Seeding with a stream (the official pcg32_srandom_r way): step twice to stir the state.
    fn withStream(seed: u64, stream: u64) -> pcg32 {
        var r: pcg32 = { state: 0, inc: (stream << 1) | 1 }
        var skip: u64 = r.next()
        r.state = r.state + seed
        skip = r.next()
        return r
    }

    // The usual shape: stream 54, the PCG examples' default; matches the reference -- OK.
    fn seeded(seed: u64) -> pcg32 {
        return pcg32::withStream(seed, 54)
    }

    // 0 .. bound-1, no modulo bias (rejection sampling drops the prefix that would skew it).
    fn nextBounded(self: mut ref pcg32, bound: u64) -> u64 {
        if bound == 0 { return 0 }
        var threshold: u64 = (0 - bound) % bound
        var x: u64 = self.next()
        while x < threshold {
            x = self.next()
        }
        return x % bound
    }

    // 0.0 .. 1.0 (the top 53 bits; enough for a double) -- an explicit conversion exists now -- OK
    fn nextFloat(self: mut ref pcg32) -> f64 {
        var hi: u64 = self.next()
        var lo: u64 = self.next()
        var x: u64 = ((hi << 32) | lo) >> 11          // 53 bits
        return f64(x) * (1.0 / 9007199254740992.0)    // / 2^53
    }

    // Fisher-Yates in place: shuffling a view is something the generator does. The element type is
    // fixed at `i32` because a method cannot declare type parameters of its own yet (a type-level
    // one would have to come from the owner), and the name does not encode the element type.
    fn shuffle(self: mut ref pcg32, a: mut slice<i32>) {
        var i: i64 = a.len - 1
        while i > 0 {
            var j: i64 = i64(self.nextBounded(u64(i + 1)))
            var t: i32 = a[i]
            a[i] = a[j]
            a[j] = t
            i = i - 1
        }
    }
}


// NOTE: `nextFloat` and `shuffle` are **methods** on the generator (`r.nextFloat()`), not free
// functions taking it -- the generator is the receiver, and the shape reads that way.

struct slice<T> {
    data: ref T
    len: i64

    fn isEmpty(self: ref slice<T>) -> bool {
        return self.len == 0
    }

    fn hasAt(self: ref slice<T>, i: i64) -> bool {
        return i >= 0 && i < self.len
    }

    // Read element i. An out-of-range index traps, with a source position; to handle that
    // gracefully, check hasAt first. The library has no pointer arithmetic and no hand-written
    // bounds check: the `self[i]` syntax makes the compiler emit a checked indexing primitive.
    fn get(self: ref slice<T>, i: i64) -> T {
        return self[i]
    }

    // Compare by content. `!=` is its negation (the language derives it).
    // Whether elements can be compared is checked at instantiation -- the price of no traits.
    fn ==(self: ref slice<T>, other: slice<T>) -> bool {
        if self.len != other.len {
            return false
        }
        var i: i64 = 0
        while i < self.len {
            if self[i] != other[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    // Find a sub-slice. `none` when there is no match; the lexer's core is this function.
    fn find(self: ref slice<T>, needle: slice<T>) -> ?i64 {
        if needle.len > self.len {
            return none
        }
        var i: i64 = 0
        while i + needle.len <= self.len {
            var j: i64 = 0
            var same: bool = true
            while j < needle.len {
                if self[i + j] != needle[j] {
                    same = false
                    break
                }
                j = j + 1
            }
            if same {
                return some(i)
            }
            i = i + 1
        }
        return none
    }

    fn startsWith(self: ref slice<T>, prefix: slice<T>) -> bool {
        if prefix.len > self.len {
            return false
        }
        var i: i64 = 0
        while i < prefix.len {
            if self[i] != prefix[i] {
                return false
            }
            i = i + 1
        }
        return true
    }
}

/* 域的**接口标记**：与 `coroutine<A, B>`（第 46 行）同级 —— 语言级特殊对象，形状在这里、
 * 方法由编译器合成。库侧在 `std/sys/domain.extc`。
 *
 * 为什么特殊对象而不是注解或按名字特判：`ext` 只能交给一个域，"谁是域"必须由**类型**说了算 ——
 * 注解无法验证（谁都能自称域 ⇒ 信任漏洞），按名字特判则会随改名悄悄失效。
 *
 * 它是**新增声明**，所以每个产物都会变（产物里带一份由 prelude 派生的痕迹）：这是一次有意
 * 的全量重打基线，不是意外。 */
struct domain { unit: bool }

// ---------------------------------------------------------------------------
// assert / unreachable
//
// Both are library code, not keywords: `trap(expr)` already says "stop the program with this
// message", and the runtime stamps the file and line of the **trap**, which is the line the user
// wrote `assert` on. `@inline` keeps the check free of a call in the C.
// ---------------------------------------------------------------------------

@inline
fn assert(cond: bool) {
    if !cond { trap("assertion failed") }
}

@inline
fn assertMsg(cond: bool, msg: slice<u8>) {
    if !cond { trap(msg) }
}

fn unreachable() {
    trap("unreachable code was reached")
}

// ---------------------------------------------------------------------------
// Numbers have methods too
//
// `x.abs()`, `n.clamp(lo, hi)`, `f.max(0.0)` are the shapes every other language in this family
// spells; without them every call site is a free-function hunt. Nothing here is a primitive: each
// body is the comparison written out, so `-O2` removes the call and the branch it implies.
// ---------------------------------------------------------------------------

impl i64 {
    fn abs(self: ref i64) -> i64 {
        let v = *self
        if v < 0 { return 0 - v }
        return v
    }
    fn min(self: ref i64, other: i64) -> i64 {
        let v = *self
        if v < other { return v }
        return other
    }
    fn max(self: ref i64, other: i64) -> i64 {
        let v = *self
        if v > other { return v }
        return other
    }
    fn clamp(self: ref i64, lo: i64, hi: i64) -> i64 {
        let v = *self
        if v < lo { return lo }
        if v > hi { return hi }
        return v
    }
    fn toF64(self: ref i64) -> f64 { return f64(*self) }
    fn toI32(self: ref i64) -> i32 { return i32(*self) }
}

impl i32 {
    fn abs(self: ref i32) -> i32 {
        let v = *self
        if v < 0 { return 0 - v }
        return v
    }
    fn min(self: ref i32, other: i32) -> i32 {
        let v = *self
        if v < other { return v }
        return other
    }
    fn max(self: ref i32, other: i32) -> i32 {
        let v = *self
        if v > other { return v }
        return other
    }
    fn clamp(self: ref i32, lo: i32, hi: i32) -> i32 {
        let v = *self
        if v < lo { return lo }
        if v > hi { return hi }
        return v
    }
    fn toI64(self: ref i32) -> i64 { return i64(*self) }
}

impl u64 {
    fn min(self: ref u64, other: u64) -> u64 {
        let v = *self
        if v < other { return v }
        return other
    }
    fn max(self: ref u64, other: u64) -> u64 {
        let v = *self
        if v > other { return v }
        return other
    }
    fn popcount(self: ref u64) -> i64 {
        var x = *self
        x = x - ((x >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return i64((x * 0x0101010101010101) >> 56)
    }
    fn clz(self: ref u64) -> i64 {
        var x = *self
        var n = i64(0)
        if x == 0 { return 64 }
        if (x & 0xFFFFFFFF00000000) == 0 { n = n + 32  x = x << 32 }
        if (x & 0xFFFF000000000000) == 0 { n = n + 16  x = x << 16 }
        if (x & 0xFF00000000000000) == 0 { n = n + 8  x = x << 8 }
        if (x & 0xF000000000000000) == 0 { n = n + 4  x = x << 4 }
        if (x & 0xC000000000000000) == 0 { n = n + 2  x = x << 2 }
        if (x & 0x8000000000000000) == 0 { n = n + 1 }
        return n
    }
    fn ctz(self: ref u64) -> i64 {
        var x = *self
        var n = i64(0)
        if x == 0 { return 64 }
        if (x & 0xFFFFFFFF) == 0 { n = n + 32  x = x >> 32 }
        if (x & 0xFFFF) == 0 { n = n + 16  x = x >> 16 }
        if (x & 0xFF) == 0 { n = n + 8  x = x >> 8 }
        if (x & 0xF) == 0 { n = n + 4  x = x >> 4 }
        if (x & 0x3) == 0 { n = n + 2  x = x >> 2 }
        if (x & 0x1) == 0 { n = n + 1 }
        return n
    }
}

impl f64 {
    fn abs(self: ref f64) -> f64 {
        let v = *self
        if v < f64(0) { return f64(0) - v }
        return v
    }
    fn min(self: ref f64, other: f64) -> f64 {
        let v = *self
        if v < other { return v }
        return other
    }
    fn max(self: ref f64, other: f64) -> f64 {
        let v = *self
        if v > other { return v }
        return other
    }
    fn clamp(self: ref f64, lo: f64, hi: f64) -> f64 {
        let v = *self
        if v < lo { return lo }
        if v > hi { return hi }
        return v
    }
}
