// extC 的 prelude —— 每次编译都**先于用户文件**被处理的一段 extC 源码。
//
// 它存在的理由：**能在 extC 里写的东西，就在 extC 里写。**
// 没有它，slice<T> 只能在 codegen.c 里硬编码 —— 那就成了「把库塞进编译器」。
//
// 写在这里的类型，用户不用 import 就能用。
//
// ⚠️ `slice` 是**保留定义**：用户不能重定义它（重名即报错），
//    而且 extC 没有 impl 块、方法必须写在 struct 体内 ——
//    所以**「给已有类型加方法」在语法上不可达**。这正好防住了混乱。
//
// ⚠️ 编译器只认这个类型的**协议**：`data` + `len`（因为 `s[i]` 是一条语法）。
//    字段名不能改；方法随便加。分界线见 ARRAYS.md。

struct slice<T> {
    data: ref T
    len: i64

    fn isEmpty(self: ref slice<T>) -> bool {
        return self.len == 0
    }

    fn hasAt(self: ref slice<T>, i: i64) -> bool {
        return i >= 0 && i < self.len
    }

    // 读第 i 个。越界会 **trap**（带位置）—— 想优雅处理就先查 hasAt。
    // 注意库里**没有一行指针算术，也没有一行手工边界检查**：`self[i]` 那一条语法
    // 会让编译器生成带检查的索引原语。
    fn get(self: ref slice<T>, i: i64) -> T {
        return self[i]
    }

    // 按内容比较。`!=` 是它的取反（语言自动派生）。
    // 元素能不能比，**推迟到实例化**才检查 —— 这是「不引入 trait」的代价。
    fn ==(self: ref slice<T>, other: slice<T>) -> bool {
        if self.len != other.len {
            return false
        }
        var i: i64 = 0
        while i < self.len {
            if self[i] != other[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    // 找子串。找不到返回 -1（等 `option` 到位会改成 `option<i64>`）。
    // 词法分析器的核心就是它。
    fn find(self: ref slice<T>, needle: slice<T>) -> i64 {
        if needle.len > self.len {
            return -1
        }
        var i: i64 = 0
        while i + needle.len <= self.len {
            var j: i64 = 0
            var same: bool = true
            while j < needle.len {
                if self[i + j] != needle[j] {
                    same = false
                    break
                }
                j = j + 1
            }
            if same {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn startsWith(self: ref slice<T>, prefix: slice<T>) -> bool {
        if prefix.len > self.len {
            return false
        }
        var i: i64 = 0
        while i < prefix.len {
            if self[i] != prefix[i] {
                return false
            }
            i = i + 1
        }
        return true
    }
}
