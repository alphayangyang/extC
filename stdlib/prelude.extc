// The extC prelude: a piece of extC source processed before the user file on every compile.
//
// Why it exists: anything that can be written in extC should be written in extC.
// Without it, slice<T> would be hard-coded in codegen.c: the library inside the compiler.
//
// Types written here are available without an import.
//
// NOTE: `slice` is a reserved definition: a user cannot redefine it (a duplicate name is an
//    error), and extC has no impl blocks: methods live inside the struct body, so there is no
//    way to add a method to an existing type -- which is exactly what prevents confusion.
//
// NOTE: the compiler only knows the protocol of this type -- `data` + `len` -- because `s[i]`
//    is syntax. Field names cannot change; methods are free. See docs/topics/ARRAYS.md.

// ---------------------------------------------------------------------------
// The empty payload: the "succeeded, but there is no value for you" case of `result<unit, E>`
//
// C has no empty struct: the compiler adds a placeholder byte for it (unitBody in codegen.c).
// A real type instead of a special case for `result<void, E>`: uniform syntax, no exceptions.
// ---------------------------------------------------------------------------

struct unit {
}

// ---------------------------------------------------------------------------
// option<T> -- "there may be a value, or there may not be"
//
// It is a plain enum (as of 2026-09-20): `| none | some(T)`
//
//   - the zero value is tag 0 = `none` (no payload) => `var o: option<i64>` means "nothing" -- OK.
//     No coincidence: zero-initialization. Variant order matters, so `| some(T) | none` would
//     make `var o: option<i64>` mean "present, but zero" -- WRONG.
//   - `T` may now be a ref or a view, so `option<slice<u8>>` is legal -- OK. It used to be a
//     struct: `none`'s `value` field had nothing to fill it with, and "a ref is never null" is
//     a promise extC makes, so that shape could report only `__extc_reference_has_no_zero_value__`
//     -- WRONG. Tag 0 = none means no payload, so the hole is closed -- OK. See docs/topics/IO.md.
//   - there are only two ways to get the value out: `match` (exhaustive), or `?` to pass the
//     failure up. There is deliberately no `unwrap()`: that needs a trap primitive, and a
//     library that traps does not fit extC's character -- if you want a trap, write it at the
//     call site. `valueOr` is absent too: enum methods do not exist yet, and `match` is clearer.
// ---------------------------------------------------------------------------

type option<T> = | none | some(T)

// ---------------------------------------------------------------------------
// result<T, E> -- "either it succeeds and gives you a value, or it fails with an error"
//
// It is a plain enum too: `| failure(E) | success(T)`. The zero value is tag 0 = `failure`
//    (the zero value of `E`) => the failure side is still the zero side, as before -- OK.
//
// The constructors are named success / failure, not ok / err: those two words are reserved for
//    reading, and the place that reads is the variant name in `match` -- OK.
// ---------------------------------------------------------------------------

type result<T, E> = | failure(E) | success(T)

// ---------------------------------------------------------------------------
// pcg32 -- a random number engine (small, fast, state held explicitly, no globals)
//
//     var rng: pcg32 = pcg32::seeded(42)
//     println(rng.nextBounded(100))
//
// Why not `rand()` or a global engine: that is hidden state -- you cannot see who moved it or
//    when, or why a hundred runs differ. extC's shape is "you hold a value":
//     - all of it on the stack (16 bytes), zero allocation -- OK
//     - the same seed => the same sequence (all platforms and builds) => a failure reproduces -- OK
//     - a second, independent sequence is another `stream` (e.g. one per Zobrist column) -- OK
//
// Why pcg32 and not mt19937: 16 bytes of state vs 2.5KB, about 20 lines vs about 60, and the
//    statistical quality is top-tier either way (passes the whole TestU01 BigCrush suite) -- OK
//
// NOTE: every value is `u64` (in 0 .. 2^32-1). extC widens automatically, narrowing needs an
//    explicit conversion that does not exist yet -- so no i64/f64 interface here -- OK.
// ---------------------------------------------------------------------------

struct pcg32 {
    state: u64
    inc: u64

    // The official PCG32 XSH-RR output function: it mixes the state into a 32-bit output.
    fn next(self: mut ref pcg32) -> u64 {
        var old: u64 = self.state
        self.state = old * 6364136223846793005 + self.inc
        var x: u64 = (((old >> 18) ^ old) >> 27) & 4294967295
        var rot: u64 = old >> 59
        return ((x >> rot) | (x << ((32 - rot) & 31))) & 4294967295
    }

    // Seeding with a stream (the official pcg32_srandom_r way): step twice to stir the state.
    fn withStream(seed: u64, stream: u64) -> pcg32 {
        var r: pcg32 = { state: 0, inc: (stream << 1) | 1 }
        var skip: u64 = r.next()
        r.state = r.state + seed
        skip = r.next()
        return r
    }

    // The usual shape: stream 54, the PCG examples' default; matches the reference -- OK.
    fn seeded(seed: u64) -> pcg32 {
        return pcg32::withStream(seed, 54)
    }

    // 0 .. bound-1, no modulo bias (rejection sampling drops the prefix that would skew it).
    fn nextBounded(self: mut ref pcg32, bound: u64) -> u64 {
        if bound == 0 { return 0 }
        var threshold: u64 = (0 - bound) % bound
        var x: u64 = self.next()
        while x < threshold {
            x = self.next()
        }
        return x % bound
    }
}

// 0.0 .. 1.0 (the top 53 bits; enough for a double) -- an explicit conversion exists now -- OK
fn nextFloat(r: mut ref pcg32) -> f64 {
    var hi: u64 = r.next()
    var lo: u64 = r.next()
    var x: u64 = ((hi << 32) | lo) >> 11          // 53 bits
    return f64(x) * (1.0 / 9007199254740992.0)    // / 2^53
}

// Fisher-Yates: shuffle an i32 view (handy for shuffling gomoku candidate points) -- OK.
fn shuffleI32(r: mut ref pcg32, a: mut slice<i32>) {
    var i: i64 = a.len - 1
    while i > 0 {
        var j: i64 = i64(r.nextBounded(u64(i + 1)))
        var t: i32 = a[i]
        a[i] = a[j]
        a[j] = t
        i = i - 1
    }
}

// ---------------------------------------------------------------------------
// varArray<T> -- a growable array (the basic part of what `std::vector` does -- OK)
//
//     var v: varArray<i32> = varArray<i32>::withCap(4)
//     v.push(7)                       // grows itself when full (by doubling)
//     println(v.size(), " ", v.get(0) ?? -1)
//
// Three design decisions, stitched into extC's memory model:
//   - no arena of its own: on growth, `new T[cap*2]` allocates in the arena that owns `self`
//     -- so storage lives exactly as long as the container, with no `Alloc` as in C++ -- OK
//   - no free -- `clear()` only sets `len` to zero and leaves the memory alone, and there is
//     no `shrink_to_fit`: memory cannot be returned, so pretending it can would be a lie -- OK
//   - reads give `?T` (may be absent); an out-of-range index traps with a source position -- OK
//
// NOTE: known limitations (as in `std::vector`, no mitigation here): growth invalidates element
//   references -- after `var p: mut ref i32 = ref v[0]`, a `v.push(..)` swaps in a new buffer
//   and `p` still points at the old one (the old memory survives, so no crash, but a write via `p`
//   is silently lost -- WRONG) => do not hold element references; write via `set(i, v)` -- OK.
// NOTE: `set(i, v)` traps only when `i` is past cap; an `i` in [len, cap) writes into the
//   unused region (the same as C++'s `operator[]`) => read safely with `get(i)` -- OK.
// ---------------------------------------------------------------------------

struct varArray<T> {
    buf: mut slice<T>
    len: i64
    cap: i64

    fn withCap(cap: i64) -> varArray<T> {
        if cap < 0 { cap = 0 }
        var v: varArray<T> = { buf: new T[cap], len: 0, cap: cap }
        return v
    }

    fn size(self: ref varArray<T>) -> i64 { return self.len }
    fn isEmpty(self: ref varArray<T>) -> bool { return self.len == 0 }

    // Doubles on growth (0 => start at 4); the new buffer goes to the arena that owns `self` -- OK
    fn grow(self: mut ref varArray<T>) {
        var ncap: i64 = self.cap * 2
        if ncap < 4 { ncap = 4 }
        var nb: mut slice<T> = new T[ncap]
        var i: i64 = 0
        while i < self.len {
            nb[i] = self.buf[i]
            i = i + 1
        }
        self.buf = nb
        self.cap = ncap
    }

    fn push(self: mut ref varArray<T>, v: T) {
        if self.len == self.cap { self.grow() }
        self.buf[self.len] = v
        self.len = self.len + 1
    }

    // Empty => none (no trap: the caller uses `??` or `match` -- OK)
    fn pop(self: mut ref varArray<T>) -> ?T {
        if self.len == 0 { return none }
        self.len = self.len - 1
        return some(self.buf[self.len])
    }

    fn get(self: ref varArray<T>, i: i64) -> ?T {
        if i < 0 || i >= self.len { return none }
        return some(self.buf[i])
    }

    fn set(self: mut ref varArray<T>, i: i64, v: T) {
        self.buf[i] = v
    }

    // Resets the length only; the memory is not touched, because an arena cannot free -- OK
    fn clear(self: mut ref varArray<T>) { self.len = 0 }

    // NOTE: this is what contiguity buys -- the storage is lent out as a view. Sorting,
    // searching, println, and C functions behind `extern!` all take `slice<T>`; without these
    // two methods the container would be unusable -- OK. A lent-out view must not be used
    // after growth, nor escape a scope the storage cannot outlive -- the compiler rejects that.
    fn asSlice(self: ref varArray<T>) -> slice<T> { return self.buf[0..self.len] }

    // Compare by content (as `slice` does: whether elements can be compared is checked only
    // at instantiation -- OK). This must exist because the signature of `asSlice()` mentions
    // `slice<T>`: instantiating `varArray<X>` also instantiates `slice<X>`, and `slice<X>::==`
    // requires `X: ==` -- WRONG. So `varArray<varArray<i32>>` was unwritable (found 2026-09-22).
    fn ==(self: ref varArray<T>, other: varArray<T>) -> bool {
        if self.len != other.len {
            return false
        }
        var i: i64 = 0
        while i < self.len {
            if self.buf[i] != other.buf[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    // A writable view: the first len elements only (`cap` is unused space, not to be exposed) -- OK
    fn asMutSlice(self: mut ref varArray<T>) -> mut slice<T> {
        return self.buf[0..self.len]
    }
}

struct slice<T> {
    data: ref T
    len: i64

    fn isEmpty(self: ref slice<T>) -> bool {
        return self.len == 0
    }

    fn hasAt(self: ref slice<T>, i: i64) -> bool {
        return i >= 0 && i < self.len
    }

    // Read element i. An out-of-range index traps, with a source position; to handle that
    // gracefully, check hasAt first. The library has no pointer arithmetic and no hand-written
    // bounds check: the `self[i]` syntax makes the compiler emit a checked indexing primitive.
    fn get(self: ref slice<T>, i: i64) -> T {
        return self[i]
    }

    // Compare by content. `!=` is its negation (the language derives it).
    // Whether elements can be compared is checked at instantiation -- the price of no traits.
    fn ==(self: ref slice<T>, other: slice<T>) -> bool {
        if self.len != other.len {
            return false
        }
        var i: i64 = 0
        while i < self.len {
            if self[i] != other[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    // Find a sub-slice. Returns -1 when there is no match (to be changed to `option<i64>`).
    // The lexer's core is this function.
    fn find(self: ref slice<T>, needle: slice<T>) -> i64 {
        if needle.len > self.len {
            return -1
        }
        var i: i64 = 0
        while i + needle.len <= self.len {
            var j: i64 = 0
            var same: bool = true
            while j < needle.len {
                if self[i + j] != needle[j] {
                    same = false
                    break
                }
                j = j + 1
            }
            if same {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn startsWith(self: ref slice<T>, prefix: slice<T>) -> bool {
        if prefix.len > self.len {
            return false
        }
        var i: i64 = 0
        while i < prefix.len {
            if self[i] != prefix[i] {
                return false
            }
            i = i + 1
        }
        return true
    }
}
