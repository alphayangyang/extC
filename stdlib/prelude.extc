// extC 的 prelude —— 每次编译都**先于用户文件**被处理的一段 extC 源码。
//
// 它存在的理由：**能在 extC 里写的东西，就在 extC 里写。**
// 没有它，slice<T> 只能在 codegen.c 里硬编码 —— 那就成了「把库塞进编译器」。
//
// 写在这里的类型，用户不用 import 就能用。
//
// ⚠️ `slice` 是**保留定义**：用户不能重定义它（重名即报错），
//    而且 extC 没有 impl 块、方法必须写在 struct 体内 ——
//    所以**「给已有类型加方法」在语法上不可达**。这正好防住了混乱。
//
// ⚠️ 编译器只认这个类型的**协议**：`data` + `len`（因为 `s[i]` 是一条语法）。
//    字段名不能改；方法随便加。分界线见 ARRAYS.md。

// ---------------------------------------------------------------------------
// 空载荷 —— `result<unit, E>` 的「成功了但没有值给你」
//
// C 不允许空 struct，编译器会给它补一个占位字节（codegen 的 unitBody）。
// 用真实的类型而不是给 `result<void, E>` 开特例 —— 语法一致，没有例外。
// ---------------------------------------------------------------------------

struct unit {
}

// ---------------------------------------------------------------------------
// option<T> —— 「可能有值，也可能没有」
//
// **零值就是 none。** 这不是巧合，是定案 8（默认零初始化）的直接结果：
// `var o: option<i64>` 里 has 就是 false，那本来就叫「没有」。
// 所以 `none()` 只是返回零值，不需要任何特殊机制。
//
// 为什么要有它：`find` 返回 -1 那种魔法数字分不清「没找到」和「下标 -1」。
// 把「可能没有」写进类型，调用点就必须处理两种情况（P′：不能证明的语法上看得见）。
//
// ⚠️ 两个已知限制（都写在 DECISIONS 里）：
//   ① T 里**不能含 ref**（`option<slice<u8>>` 不行）—— None 的那个 value
//      字段没有合法的值可填，而「ref 不可为空」是 extC 的承诺。等 week-4。
//   ② 这里**故意不定义 `==`**：泛型的 `==` 是「一实例化就检查」的，
//      给了它就意味着任何 `option<point>` 都强迫 point 定义 `==`。
//      暂时用 `o.has` / `o.value` 自己比。
// ---------------------------------------------------------------------------

struct option<T> {
    has: bool
    value: T

    // 关联函数：写在 struct 体内但没有 `self`，调用写全类型 `option<i64>::some(3)`
    fn some(v: T) -> option<T> {
        return { has: true, value: v }
    }

    fn none() -> option<T> {
        return {}                          // 零值 ⇒ has = false
    }

    // 有值就给值，没有就给 fallback（不 trap、不隐藏）
    fn valueOr(self: ref option<T>, fallback: T) -> T {
        if self.has {
            return self.value
        }
        return fallback
    }
}

// ---------------------------------------------------------------------------
// result<T, E> —— 「要么成功给你值，要么失败给你一个错误」
//
// 跟 option 一样，零值是**失败**那一侧（ok = false），所以构造成功必须显式写。
// `valueOr` 之外没有 `unwrap()` —— 那需要一条 trap 原语，
// 而「不 trap 的库」比「会 trap 的库」更符合 extC 的性格（要 trap 就让调用者说）。
// ---------------------------------------------------------------------------

struct result<T, E> {
    ok: bool
    value: T
    err: E

    // 构造器名字不能叫 `ok` —— 标签字段已经叫 ok 了，而**字段和方法不许同名**
    // （编译器会把这种撞名当场报出来）。所以用一对能读的：success / failure。
    fn success(v: T) -> result<T, E> {
        return { ok: true, value: v }
    }

    fn failure(e: E) -> result<T, E> {
        return { ok: false, err: e }
    }

    fn valueOr(self: ref result<T, E>, fallback: T) -> T {
        if self.ok {
            return self.value
        }
        return fallback
    }
}

struct slice<T> {
    data: ref T
    len: i64

    fn isEmpty(self: ref slice<T>) -> bool {
        return self.len == 0
    }

    fn hasAt(self: ref slice<T>, i: i64) -> bool {
        return i >= 0 && i < self.len
    }

    // 读第 i 个。越界会 **trap**（带位置）—— 想优雅处理就先查 hasAt。
    // 注意库里**没有一行指针算术，也没有一行手工边界检查**：`self[i]` 那一条语法
    // 会让编译器生成带检查的索引原语。
    fn get(self: ref slice<T>, i: i64) -> T {
        return self[i]
    }

    // 按内容比较。`!=` 是它的取反（语言自动派生）。
    // 元素能不能比，**推迟到实例化**才检查 —— 这是「不引入 trait」的代价。
    fn ==(self: ref slice<T>, other: slice<T>) -> bool {
        if self.len != other.len {
            return false
        }
        var i: i64 = 0
        while i < self.len {
            if self[i] != other[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    // 找子串。找不到返回 -1（等 `option` 到位会改成 `option<i64>`）。
    // 词法分析器的核心就是它。
    fn find(self: ref slice<T>, needle: slice<T>) -> i64 {
        if needle.len > self.len {
            return -1
        }
        var i: i64 = 0
        while i + needle.len <= self.len {
            var j: i64 = 0
            var same: bool = true
            while j < needle.len {
                if self[i + j] != needle[j] {
                    same = false
                    break
                }
                j = j + 1
            }
            if same {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn startsWith(self: ref slice<T>, prefix: slice<T>) -> bool {
        if prefix.len > self.len {
            return false
        }
        var i: i64 = 0
        while i < prefix.len {
            if self[i] != prefix[i] {
                return false
            }
            i = i + 1
        }
        return true
    }
}
