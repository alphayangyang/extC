// extC 的 prelude —— 每次编译都**先于用户文件**被处理的一段 extC 源码。
//
// 它存在的理由：**能在 extC 里写的东西，就在 extC 里写。**
// 没有它，slice<T> 只能在 codegen.c 里硬编码 —— 那就成了「把库塞进编译器」。
//
// 写在这里的类型，用户不用 import 就能用。
//
// ⚠️ `slice` 是**保留定义**：用户不能重定义它（重名即报错），
//    而且 extC 没有 impl 块、方法必须写在 struct 体内 ——
//    所以**「给已有类型加方法」在语法上不可达**。这正好防住了混乱。
//
// ⚠️ 编译器只认这个类型的**协议**：`data` + `len`（因为 `s[i]` 是一条语法）。
//    字段名不能改；方法随便加。分界线见 ARRAYS.md。

// ---------------------------------------------------------------------------
// 空载荷 —— `result<unit, E>` 的「成功了但没有值给你」
//
// C 不允许空 struct，编译器会给它补一个占位字节（codegen 的 unitBody）。
// 用真实的类型而不是给 `result<void, E>` 开特例 —— 语法一致，没有例外。
// ---------------------------------------------------------------------------

struct unit {
}

// ---------------------------------------------------------------------------
// option<T> —— 「可能有值，也可能没有」
//
// **它就是普通枚举**（第三刀，2026-09-20）：`| none | some(T)`
//
//   · 零值 = tag 0 = `none`（**不带载荷**）⇒ `var o: option<i64>` 就是「没有」✓
//     这不是巧合，是定案 8（默认零初始化）的直接结果。**变体顺序有意义**：
//     `| some(T) | none` 会让 `var o: option<i64>` 变成「有值但值是零」✗
//   · `T` 里**可以有 ref / 视图**了 ⇒ `option<slice<u8>>` 合法 ✓
//     （以前是 struct，`none` 那个 `value` 字段没东西可填，而「ref 不可为空」
//      是 extC 的承诺 ⇒ 只能报 `__extc_reference_has_no_zero_value__` ✗
//      现在是「tag 0 = none，载荷根本不存在」⇒ 洞封上了 ✓ 见 IO.md）
//   · 拿值只有两条路：**`match`**（穷尽检查），或者 **`?` 顺着往上抛**。
//     **故意没有 `unwrap()`** —— 那需要一条 trap 原语，而「会 trap 的库」不符合
//      extC 的性格：要 trap 就让调用者自己写。也**故意没有** `valueOr` 之类的方法：
//      枚举加方法还没做（PLAN #16），而且 `match` 更显式 ✓
// ---------------------------------------------------------------------------

type option<T> = | none | some(T)

// ---------------------------------------------------------------------------
// result<T, E> —— 「要么成功给你值，要么失败给你一个错误」
//
// 同样**就是普通枚举**：`| failure(E) | success(T)`
// 零值 = tag 0 = `failure`（`E` 的零值）⇒ 跟以前「零值就是失败侧」一致 ✓
//
// 构造器名字是 success / failure（不叫 ok / err —— 那两个词要留给读的地方，
// 现在读的地方是 `match` 的变体名 ✓）
// ---------------------------------------------------------------------------

type result<T, E> = | failure(E) | success(T)

// ---------------------------------------------------------------------------
// pcg32 —— 随机数引擎（小而快，**显式持有状态，没有全局**）
//
//     var rng: pcg32 = pcg32::seeded(42)
//     println(rng.nextBounded(100))
//
// 为什么不用 `rand()` / 全局引擎：那是**隐藏状态** —— 谁什么时候动了它看不见，
// 跑一百遍为什么不一样也查不出来。extC 的形状是"你持有一个值"：
//     · 全部在栈上（16 字节），**零分配** ✓
//     · 同一个种子 ⇒ 同一个序列（跨平台、跨优化级别都一样）⇒ 失败可复现 ✓
//     · 想要"另一条独立序列"就换 `stream`（比如 Zobrist 表一列一条流）✓
//
// 为什么是 pcg32 而不是 mt19937：状态 16 字节 vs **2.5KB**、代码 ~20 行 vs ~60 行，
// 统计质量同样是第一梯队（TestU01 BigCrush 全过）✓
//
// ⚠️ 值全部是 `u64`（都在 0 .. 2^32-1 里）：extC **只自动做无损失的拓宽**，
//    收窄要显式转换 —— 而那个语法还没做（PLAN #23），所以这版先不给 i64/f64 接口 ✓
// ---------------------------------------------------------------------------

struct pcg32 {
    state: u64
    inc: u64

    // 官方 PCG32 的 XSH-RR 输出函数（把 32 位状态搅成一个 32 位输出）
    fn next(self: mut ref pcg32) -> u64 {
        var old: u64 = self.state
        self.state = old * 6364136223846793005 + self.inc
        var x: u64 = (((old >> 18) ^ old) >> 27) & 4294967295
        var rot: u64 = old >> 59
        return ((x >> rot) | (x << ((32 - rot) & 31))) & 4294967295
    }

    // 带流的播种（官方 pcg32_srandom_r 那套：先走两步把状态搅开）
    fn withStream(seed: u64, stream: u64) -> pcg32 {
        var r: pcg32 = { state: 0, inc: (stream << 1) | 1 }
        var skip: u64 = r.next()
        r.state = r.state + seed
        skip = r.next()
        return r
    }

    // 常用形状：固定流（54 是 PCG 例子里的默认流号，跟官方参考实现能逐位对上 ✓）
    fn seeded(seed: u64) -> pcg32 {
        return pcg32::withStream(seed, 54)
    }

    // 0 .. bound-1，**没有取模偏置**（拒绝采样：先丢掉会让分布偏掉的那一小段）
    fn nextBounded(self: mut ref pcg32, bound: u64) -> u64 {
        if bound == 0 { return 0 }
        var threshold: u64 = (0 - bound) % bound
        var x: u64 = self.next()
        while x < threshold {
            x = self.next()
        }
        return x % bound
    }
}

// 0.0 .. 1.0（前 53 位，双精度够用）—— 现在有显式转换了 ✓
fn nextFloat(r: mut ref pcg32) -> f64 {
    var hi: u64 = r.next()
    var lo: u64 = r.next()
    var x: u64 = ((hi << 32) | lo) >> 11          // 53 位
    return f64(x) * (1.0 / 9007199254740992.0)    // / 2^53
}

// Fisher-Yates：洗一个 i32 视图（五子棋洗候选点用得上 ✓）
fn shuffleI32(r: mut ref pcg32, a: mut slice<i32>) {
    var i: i64 = a.len - 1
    while i > 0 {
        var j: i64 = i64(r.nextBounded(u64(i + 1)))
        var t: i32 = a[i]
        a[i] = a[j]
        a[j] = t
        i = i - 1
    }
}

// ---------------------------------------------------------------------------
// varArray<T> —— **能增长的数组**（对标 `std::vector` 的基础部分 ✓）
//
//     var v: varArray<i32> = varArray<i32>::withCap(4)
//     v.push(7)                       // 满了自己扩（倍增）
//     println(v.size(), " ", v.get(0) ?? -1)
//
// 三条设计决定（跟 extC 的内存模型缝在一起）：
//   · **不带自己的 arena** —— 扩容时 `new T[cap*2]` 分配到**拥有 `self` 的那只 arena**
//     （A3 第三半那条规则 ✓）⇒ 容器活得多久，存储就活多久 ✓ 不用像 C++ 那样塞个 Alloc ✓
//   · **不能 free** ⇒ `clear()` 只把 `len` 归零（内存不动）、**没有 `shrink_to_fit`**
//     （缩不回内存 ⇒ 有也比没有好：假装能缩是骗人 ✓）
//   · 读值用 `?T`（「可能没有」✓），越界由**下标检查 trap（带源码位置）**承担 ✓
//
// ⚠️ 已知限制（跟 `std::vector` 一样，但这里**没有任何缓解**）：
//   **扩容会让指向元素的引用失效** —— `var p: mut ref i32 = ref v[0]` 之后 `v.push(..)`
//   换了新 buffer，`p` 还指着**旧 buffer**（arena 保证旧内存没被回收 ⇒ 不崩，
//   但写进去就是**静默写丢** ✗）⇒ 别长期持有元素引用；要改就用 `set(i, v)` ✓
// ⚠️ `set(i, v)` 只在 `i` 超出 **cap** 时 trap；`i` 落在 `[len, cap)` 之间会写进未使用区
//   （跟 C++ 的 `operator[]` 同款）⇒ 想安全读就 `get(i)` ✓
// ---------------------------------------------------------------------------

struct varArray<T> {
    buf: mut slice<T>
    len: i64
    cap: i64

    fn withCap(cap: i64) -> varArray<T> {
        if cap < 0 { cap = 0 }
        var v: varArray<T> = { buf: new T[cap], len: 0, cap: cap }
        return v
    }

    fn size(self: ref varArray<T>) -> i64 { return self.len }
    fn isEmpty(self: ref varArray<T>) -> bool { return self.len == 0 }

    // 满了就**倍增**（0 ⇒ 先给 4）；新 buffer 进"拥有 self 的那只 arena" ✓
    fn grow(self: mut ref varArray<T>) {
        var ncap: i64 = self.cap * 2
        if ncap < 4 { ncap = 4 }
        var nb: mut slice<T> = new T[ncap]
        var i: i64 = 0
        while i < self.len {
            nb[i] = self.buf[i]
            i = i + 1
        }
        self.buf = nb
        self.cap = ncap
    }

    fn push(self: mut ref varArray<T>, v: T) {
        if self.len == self.cap { self.grow() }
        self.buf[self.len] = v
        self.len = self.len + 1
    }

    // 空 ⇒ none（**不 trap**：调用点用 `??` 或 match ✓）
    fn pop(self: mut ref varArray<T>) -> ?T {
        if self.len == 0 { return none }
        self.len = self.len - 1
        return some(self.buf[self.len])
    }

    fn get(self: ref varArray<T>, i: i64) -> ?T {
        if i < 0 || i >= self.len { return none }
        return some(self.buf[i])
    }

    fn set(self: mut ref varArray<T>, i: i64, v: T) {
        self.buf[i] = v
    }

    // 只归零（**内存不动** —— arena 不能 free ✓）
    fn clear(self: mut ref varArray<T>) { self.len = 0 }
}

struct slice<T> {
    data: ref T
    len: i64

    fn isEmpty(self: ref slice<T>) -> bool {
        return self.len == 0
    }

    fn hasAt(self: ref slice<T>, i: i64) -> bool {
        return i >= 0 && i < self.len
    }

    // 读第 i 个。越界会 **trap**（带位置）—— 想优雅处理就先查 hasAt。
    // 注意库里**没有一行指针算术，也没有一行手工边界检查**：`self[i]` 那一条语法
    // 会让编译器生成带检查的索引原语。
    fn get(self: ref slice<T>, i: i64) -> T {
        return self[i]
    }

    // 按内容比较。`!=` 是它的取反（语言自动派生）。
    // 元素能不能比，**推迟到实例化**才检查 —— 这是「不引入 trait」的代价。
    fn ==(self: ref slice<T>, other: slice<T>) -> bool {
        if self.len != other.len {
            return false
        }
        var i: i64 = 0
        while i < self.len {
            if self[i] != other[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    // 找子串。找不到返回 -1（等 `option` 到位会改成 `option<i64>`）。
    // 词法分析器的核心就是它。
    fn find(self: ref slice<T>, needle: slice<T>) -> i64 {
        if needle.len > self.len {
            return -1
        }
        var i: i64 = 0
        while i + needle.len <= self.len {
            var j: i64 = 0
            var same: bool = true
            while j < needle.len {
                if self[i + j] != needle[j] {
                    same = false
                    break
                }
                j = j + 1
            }
            if same {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn startsWith(self: ref slice<T>, prefix: slice<T>) -> bool {
        if prefix.len > self.len {
            return false
        }
        var i: i64 = 0
        while i < prefix.len {
            if self[i] != prefix[i] {
                return false
            }
            i = i + 1
        }
        return true
    }
}
