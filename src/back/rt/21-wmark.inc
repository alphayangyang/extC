    "/* ---- Cross-region edge bitmap for large slots [rt:wmark] ----\n",
    " * Releasing a slot that holds cross-region references must undo each of those edges at the source: the released object stops being a\n",
    " * source for them. When the type descriptor is EXTC_RC_CONSERVATIVE (more reference fields than the descriptor cap, or fields at offsets\n",
    " * the compiler could not enumerate) that undo scans **every word of the slot**, so the cost follows the slot stride: an 8 MiB payload that\n",
    " * holds a handful of references costs a million word probes inside one step, and a step is indivisible -- the batch, chunk and deadline\n",
    " * bounds cannot cut unlinkChildren in half.\n",
    " * The bitmap records, per 64-byte group of a slot, that a cross-region value was stored into this group at least once. It is written by the\n",
    " * same branch that registers the edge, so it is a superset of the true set (a same-region store never clears a group), and it is read only\n",
    " * on the release path: the 8 words of a group whose bit is clear cannot hold a cross-region value and are skipped.\n",
    " * Cost per release is (number of set groups x 8 probes) plus one pass over the bitmap (stride/4096 words), i.e. O(stride/512) bytes\n",
    " * instead of O(stride) words. EXTC_RC_WMARK_MIN_BYTES is the stride below which the full scan is cheap enough to keep.\n",
    " * Soundness rests on the registration rule itself: an edge that was never registered is an edge the target does not know about, which is\n",
    " * an error before this bitmap exists. When a store registers an edge but cannot name the owning slot (extc_rc_storeRefOwnedReg, the\n",
    " * whole-value copy entries), it marks its region wmUnsafe and that region falls back to the full scan.\n",
    " */\n",
    "#ifndef EXTC_RC_WMARK\n",
    "#define EXTC_RC_WMARK 1                /* 0 = never allocate the bitmap: the pre-bitmap behaviour, for A/B */\n",
    "#endif\n",
    "#ifndef EXTC_RC_WMARK_MIN_BYTES\n",
    "#define EXTC_RC_WMARK_MIN_BYTES 4096   /* strides below this are scanned whole anyway: 4 KiB is 512 words, about 0.4 us */\n",
    "#endif\n",
    "struct ExtcRcSlab {\n",
    "    ExtcRcSlab   *next;      /* this region's slab chain */\n",
    "    ExtcRcSlab   *prev;      /* previous slab in the region chain: lets a dead slab be unlinked in O(1) (see extc_rc_slabShrink) */\n",
    "    ExtcRcRegion *region;    /* back pointer: a count reaching zero updates the region's occupied bytes */\n",
    "    uint64_t     *occ;       /* occupancy bitmap */\n",
    "    uint64_t     *mark;      /* mark bitmap (holds only this round's bits before and after each sweep of the region) */\n",
    "    uint64_t     *rsbit;     /* cross-region registration bitmap: this slab's slots are pointed at from another region */\n",
    "    uint16_t     *hold;      /* per slot: exact holder count */\n",
    "    uint16_t     *rscnt;     /* per slot: cross-region **in-edge** count (accounted on the source side). The bitmap cell is\n",
    "                              * a cache of at-least-one-live-edge-from-another-region: 0 to 1 sets the bit, 1 to 0 clears it;\n",
    "                              * when the source object dies or its region is dropped the edge is withdrawn at the source, so the bit does not stay\n",
    "                              * sticky (a sticky bit would make every round's new objects permanent seeds, so memory grows linearly). */\n",
    "    uint16_t     *tid;       /* per slot: type number (0 = no descriptor; 1 = fallback; >=2 = ttab index) */\n",
    "    const ExtcRcType **ttab; /* this slab's type table: number to descriptor, deduplicated by pointer equality, grows on demand */\n",
    "    uint32_t      ttabN, ttabCap;\n",
    "    uint16_t     *thash;     /* type-number hash index: descriptor pointer to ttab index (0 = empty). A slab with few\n",
    "                              * descriptors does not build it (a linear scan is faster); it is built past EXTC_RC_TTAB_LINEAR_MAX. */\n",
    "    uint32_t      thashCap;  /* index capacity (a power of two; 0 = not built) */\n",
    "    const ExtcRcType *lastTd; /* the last descriptor that landed in this slab: consecutive allocations of one type on one slab are the norm,\n",
    "                              * and a hit skips the type table lookup (hash probe included). Filled only after this slab's table insert succeeds. */\n",
    "    uint16_t      lastTid;   /* type number paired with lastTd */\n",
    "    char         *data;      /* start of the slot payload: in the slab's own block normally, separately malloc'd for a huge block */\n",
    "    int           big;       /* 1 = huge block: the payload is not in the slab and there is only 1 slot (see extc_rc_slabNew) */\n",
    "    int64_t       freelist;  /* head of the **reuse** chain (holds only released slots): a slot number, -1 = empty.\n",
    "                              * The chain's next slot number lives in each slot's tid[] (slot number + 1, 0 = end), not in the payload --\n",
    "                              * a released slot is cold, and writing an 8-byte header pointer into the payload pulls in the whole cache line (RFO).\n",
    "                              * See extc_rc_freeSlot. */\n",
    "    uint32_t      bump;      /* cursor over never-issued slots: [0, bump) issued, [bump, nslots) not yet */\n",
    "    size_t        ss;        /* slot stride (a multiple of 8, not a power of two): slot lookup from a pointer uses it */\n",
    "    uint64_t      rcp;       /* reciprocal of the slot stride (extc_rc_rcpOf): multiply and shift divides exactly */\n",
    "    uint32_t      nslots, nwords;\n",
    "    uint32_t      swEpoch;   /* the sweep round that last finished this slab (= the region's swId):\n",
    "                              * marking an allocation black only considers positions the cursor has not reached, and this decides it. */\n",
    "    ExtcRcSlab   *availNext; /* next block on this size class's has-a-free-slot chain (valid when avail=1); the head is in r->clsBkt */\n",
    "    ExtcRcSlab   *availPrev; /* previous block on the size class chain (same reason: O(1) unlink) */\n",
    "    int           avail;     /* 1 = already on this size class's chain (stops the same block being pushed twice, see extc_rc_classPush) */\n",
    "    uint32_t      nLive;     /* occupied slots (occ bitmap popcount), maintained incrementally so the whole-slab reset reads it in O(1);\n",
    "                              * it is the byte count of the block and therefore only ever changes on allocate and on release. */\n",
    "    uint32_t      nMark;     /* roll-up of marked slots in this round (= popcount of the mark bitmap for this slab). Zero means no\n",
    "                              * reachable object lies in the block, which is the O(1) test the whole-slab reset uses; it is maintained\n",
    "                              * wherever a mark bit is set or cleared (allocation while marking or sweeping, the shade barrier, the\n",
    "                              * mark scan, the sweep word clear, the narrowed release and the bulk reset). */\n",
    "    uint32_t      nfree;     /* EXTC_RC_LAZY_FREE holes: slots whose occupancy bit is clear that are not necessarily on the reuse\n",
    "                              * chain. It gates reuse of never-issued slots and is overwritten from the occupancy bitmap by the rebuild. */\n",
    "    int64_t       pgLive;     /* nLive at the last page pass: an unchanged block has no new empty page to release, so the pass skips it */\n",
    "    int32_t       pgNext;     /* resume page of a pass the budget cut short; -1 = no pass in progress */\n",
    "    uint32_t      deadA;      /* allocN at the closing that last saw this block empty; 0 = alive at that closing */\n",
    "    uint8_t       deadN;      /* empty closings in a row with no reuse since: bounded by EXTC_RC_SHRINK_GRACE */\n",

    "    uint32_t      allocN;     /* allocations issued from this block (monotone): tells the page pass whether the block is still busy */\n",
    "    uint32_t      pgAllocN;   /* allocN at the last finished pass: a block that has taken many slots since is not worth a pass */\n",
    "    uint64_t     *wmark;     /* [rt:wmark] per slot, one bit per 64-byte group: a cross-region value was stored into this group.\n",
    "                              * NULL when the stride is below EXTC_RC_WMARK_MIN_BYTES. The release pass reads it and zeroes it, so a\n",
    "                              * reused slot starts clean. */\n",
    "    uint32_t      wmW;       /* bitmap words per slot (= ceil(stride/4096)): one bit per 64-byte group */\n",
    "};\n",
    "\n",
    "/* Hash bucket node for the size-class to has-a-free-slot slab chain. The allocation path uses it to get the next usable block in O(1):\n",
    " * a linear search of the r->slabs chain for a same-size slab with a free slot degrades with the live block count -- 32 million allocations\n",
    " * over about 8000 blocks made every allocation O(live slabs), quadratic overall.\n",
    " * Entries are only added, never removed (the whole batch is freed when the region is destroyed), so no tombstones. */\n",
    "typedef struct ExtcRcClass {\n",
    "    size_t             ss;    /* slot stride (the key) */\n",
    "    ExtcRcSlab        *head;  /* chain of this class's slabs that may still have a free slot; full blocks stay on it (lazy pop) */\n",
    "    struct ExtcRcClass *next; /* next size class in the same hash bucket */\n",
    "} ExtcRcClass;\n",
    "\n",
    "struct ExtcRcRegion {\n",
    "    ExtcRcSlab *slabs;\n",
    "    ExtcRcSlab *bumpSlab;    /* parse region: the slab bump is currently in */\n",
    "    ExtcRcSlab *allocHot[32]; /* caches the most recent allocatable slab by size class (slot stride / 8); a miss goes to clsBkt */\n",
    "    ExtcRcClass *clsBkt[EXTC_RC_CLS_BUCKETS]; /* size class to has-a-free-slot slab chain (see extc_rc_classSlot) */\n",
    "    char       *bump, *bump_end;\n",
    "    int64_t     bytes;       /* occupied payload bytes, accounted in O(1) */\n",
    "    int64_t     allocBytes;  /* **monotonic** allocated bytes: the credit base for the full traversal */\n",
    "    int64_t     visitedBytes;/* allocBytes at the last O(live set) traversal */\n",
    "    int64_t     roundVisitedBytes;/* round-start credit: consumed only at round start/end, untouched by targeted frees */\n",
    "    int64_t     live;        /* live bytes after the last sweep: the trigger uses twice this */\n",
    "    int64_t     thr;         /* cached pressure threshold: `max(2 * live, floor) * scale` */\n",
    "    int64_t     maxReq;      /* admission by request size: biggest single request (slot stride) ever seen; the trigger line reserves it */\n",
    "    int64_t     floor;       /* lower bound of memory pressure */\n",
    "    int64_t     scale;       /* self-learned: multiplier from consecutive empty sweeps; 0 = not learned */\n",
    "    size_t      sweeps, freedSlots;\n",
    "    /* Stepped (interruptible) sweep cursor: which slab and word it reached; how many slots this round freed. */\n",
    "    int32_t     sweeping;\n",
    "    int32_t     swPad_;\n",
    "    ExtcRcSlab *swSlab;\n",
    "    uint32_t    swWord;\n",
    "    uint32_t    swId;        /* sweep round number: incremented by every sweepBegin */\n",
    "    size_t      swFreed;\n",
    "    int32_t     swFirst;     /* pause attribution: the next sweep step is the first of its round (cold-page first-touch proxy) */\n",
    "    int64_t     capBytes;   /* payload capacity of every block in the chain: the page pass runs only when capacity clearly exceeds occupancy */\n",
    "    ExtcRcSlab *trimCur;     /* page pass cursor: next block to consider (NULL = the pass over this chain is done) */\n",
    "    int32_t     marking;     /* incremental marking in flight (the barrier is on and the sweep yields) */\n",
    "    int32_t     markDone;    /* diagnostic: the mark stack was empty when marking completed (no reader; kept for probes) */\n",
    "    unsigned long long markWork; /* cumulative mark work units (pops + scanned words + segmented words): the byte quota reads a per-region delta, not a file-level static */\n",
    "    int64_t     markedBytes;  /* payload marked this round: written into live when marking completes */\n",
    "    int32_t     markTick;     /* batched progress: one step every N allocations */\n",
    "    int64_t     markStartAlloc;\n",
    "    size_t      wbDebt;      /* new gray objects shaded this round: the allocation site repays with interest (assist) */\n",
    "    ExtcRcSlab *seedSlab;   /* seed scan cursor: pushes in steps (mark start does not scan the whole region at once) */\n",
    "    uint32_t    seedWord;\n",
    "    uint64_t    seedBits;    /* unified budget: bits of the current word **not yet pushed**; the cursor stays on the same word (0 while W=0) */\n",
    "    int32_t     seedsDone;\n",
    "    int32_t     seedAny;     /* whether any bit of `rsbit` in this region was ever set (a seed was registered), so the cursor is worth walking;\n",
    "                              * with no bit ever set the whole rsbit scan is skipped (the 1024 words of an empty slab would be wasted work) */\n",
    "    int32_t     foreign;    /* whether any slot of this region was ever written a **cross-region** value (a foreign pointer). If none,\n",
    "                              * the old value read by an overwrite can only be null or same-region, so the old-value registration lookup can be skipped (the new value still must be looked up).\n",
    "                              * Set monotonically, never cleared: better to look up too often than to miss a withdrawal. */\n",
    "    int32_t     rid;\n",
    "    int32_t     noSweep;     /* a cross-region in-edge whose host cannot be traced, so this region is exempt from sweeping (rather collect less) */\n",
    "    int32_t     wmUnsafe;    /* [rt:wmark] a cross-region edge was registered here without naming the owning slot, so no slot of this\n",
    "                              * region may trust its bitmap: the release falls back to the full source scan. Set monotonically. */\n",
    "    int32_t     part;        /* this region **took part in rc** (it allocated an object or hosted an assignment) */\n",
    "    int32_t     owe;         /* an inner frame allocated into this region after the pressure line was crossed, so **the frame that owns it**\n",
    "                              * owes one sweep (subset B). Settled in extc_rc_checkOwed. */\n",
    "    void      **mstk;        /* mark stack (region-private, not global) */\n",
    "    size_t      msp, mscap;\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "    void      **cstk;        /* work list for the count-zero cascade: pairs of (slab, slot), drained in place after a count reaches zero */\n",
    "    size_t      csp, cscap;  /* number of pairs on the list and its capacity in pairs */\n",
    "#endif\n",
    "    /* Cursor for **segmented scanning** of a large object: the object being scanned + how far it got (descriptor index / conservative word index).\n",
    "     * It does not live on the mark stack: the write barrier pushes new force entries onto the stack between two steps, and a cursor entry on the stack would be\n",
    "     * buried or popped as the wrong object (not even safety survives that). Resuming therefore sits at the entry of `extc_rc_markStep`, and one step walks one segment;\n",
    "     * every stack-empty-means-marking-complete test (finish, the alloc drain guard,\n",
    "     * the various drain loops, settle's progress test) **must also read scanObj**. */\n",
    "    void       *scanObj;\n",
    "    uint32_t    scanOff;\n",
    "    int32_t     scanDesc;   /* cursor kind: 0 = conservative word index, 1 = descriptor field index (set by the split guards in MARK_SCAN, read by markResume) */\n",
    "    int32_t     dead;        /* region dropped: its slots have ceased to be live, but its slabs are still on this thread's closing queue.\n",
    "                              * owns() answers 0 for the whole region, so a write through a stale pointer cannot resurrect a slot; the\n",
    "                              * memory itself stays valid until the drain reaches it (the same window ownDel -> free had before). */\n",
    "    int32_t     cqPad_;\n",
    "    ExtcRcRegion *cqNext;    /* next dropped region on this thread's closing queue (extc_rc_cqHead) */\n",

    "    uint32_t    scanPad_;\n",
    "};\n",
    "\n",
    "#define EXTC_RC_SLAB_SIZE ((size_t)1 << EXTC_RC_SLAB_BITS)\n",
    "#define EXTC_RC_SLAB_HDR  ((sizeof(ExtcRcSlab) + 63) & ~(size_t)63)\n",
    "/* A slab's **issued capacity** is its whole block: the block is filled with slots down to the header, so no size class leaves a hole at the\n",
    " * tail of its block (a 48 B slot fits 10,922). EXTC_RC_SLAB_CHUNK_MIN therefore **is** the block size; the\n",
    " * doubling loop in extc_rc_slabNew only matters for a configuration that lowers it.\n",
    " * See extc_rc_slabNew for details. */\n",
    "#define EXTC_RC_SLAB_CHUNK_MIN EXTC_RC_SLAB_SIZE\n",
    "#define EXTC_RC_SLAB_SLOTS_MIN ((size_t)1024)\n",
    "/* The reuse chain's next slot number is encoded in each slot's tid[] (uint16: slot number + 1, 0 = end), so a slot number must be below this\n",
    " * bound. A whole 512 KiB block of 16 B slots asks for 32,766, so the invariant is written as a criterion against configuration drift (the guard is in slabNew). */\n",
    "#define EXTC_RC_REUSE_MAX_SLOT 0xFFFEu\n",
    "/* Start of the slot payload. A normal slab's payload is in its own EXTC_RC_SLAB_SIZE block (alignment means finding the slab from an object pointer is one\n",
    " * bitwise AND, and the block is the alignment unit); a **huge block**'s payload is malloc'd separately and its start is recorded in the slab header. Both share one macro, so\n",
    " * bitmaps / counts / registration / descriptors / marking / sweeping all have a single code path. */\n",
    "#define EXTC_RC_SLAB_DATA(s) ((s)->data)\n",
    "\n",
