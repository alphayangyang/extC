    "/* ---- Shading cache: one record of {pointer -> already black} [rt:shade-cache] ----------------\n",
    " *\n",
    " * Most barrier calls are just \"this object is already black, ask again\": over one whole-region reclaim the shade hit rate is\n",
    " * close to 72%, and every hit costs ownSlab + slotOf + two bitmap reads. On a hit the only lawful answer is\n",
    " * \"do nothing\", so it can be remembered.\n",
    " *\n",
    " * Invalidation uses a **generation number**, but the number does not take a second word: it is **rotated into the hash cell index**. The cell index is\n",
    " * (address >> 3) + extc_rc_shadeGen, so the same pointer lands in a **different cell in a different generation**, hence one cell holding\n",
    " * one pointer (8 bytes) is enough: \"same cell, same pointer\" can only come from the same generation, so a hit is **exact**. The generation number\n",
    " * wraps every 2048 generations: `extc_rc_shadeNextGen` clears the whole table before the wrap, so old records are gone after it.\n",
    " *\n",
    " * The invalidation contract is unchanged: every path in the core that clears a mark bit calls `extc_rc_shadeNextGen()` (round start, sweep start,\n",
    " * the whole-span clear of a narrowing sweep, whole-region release). The invariant is still \"within one generation a slot's mark bit only goes 0 to 1\" --\n",
    " * a hit means that cell was black **in this generation**, so it is still black: skipping the barrier and the slow path (including ownSlab) does not change\n",
    " * the reachable set. Slot release (freeSlot) does not clear the mark bit, so it does not break this invariant either.\n",
    " *\n",
    " * Cost: 2048 x 8 B of static memory + one hash and store per slow path + a 16 KB clear every 2048 generations\n",
    " *(8 bytes amortized per generation). The hash takes high address bits (slots are 8-byte aligned, so the low 3 bits are always 0), direct-mapped,\n",
    " * collision overwrite is fine: this is a **hint**, not a cache, and a miss just takes the slow path again. */\n",
    "typedef struct ExtcRcShadeCell { uintptr_t v; } ExtcRcShadeCell;\n",
    "static uint64_t extc_rc_shadeGen = 1;\n",
    "static ExtcRcShadeCell extc_rc_shadeCache[2048];\n",
    "static inline size_t extc_rc_shadeHash(void *v) {\n",
    "    return (size_t)((((uintptr_t)v >> 3) + (uintptr_t)extc_rc_shadeGen) & 2047u);\n",
    "}\n",
    "static inline int extc_rc_shadeKnown(void *v) {\n",
    "    return extc_rc_shadeCache[extc_rc_shadeHash(v)].v == (uintptr_t)v;\n",
    "}\n",
    "static inline void extc_rc_shadeRemember(void *v) {\n",
    "    extc_rc_shadeCache[extc_rc_shadeHash(v)].v = (uintptr_t)v;\n",
    "}\n",
    "/* Advance the generation number by one; clear the table before wrapping (see above). All four mark-clearing paths call only this, no hand-written gen++. */\n",
    "static inline void extc_rc_shadeNextGen(void) {\n",
    "    if ((++extc_rc_shadeGen & 2047u) == 0u) memset(extc_rc_shadeCache, 0, sizeof extc_rc_shadeCache);\n",
    "}\n",
    "/* Cache self-check (off by default, -DEXTC_RC_SHADE_GUARD=1 enables): on a hit, redo the slow path's \"really still black\" test,\n",
    " * count bad when it is not black. It verifies exactly the invalidation contract \"every path that clears a mark bit bumps the generation\" -- miss one and\n",
    " * the cache treats a white object as black and skips reachable objects (the next sweep frees them). */\n",
    "#ifndef EXTC_RC_SHADE_GUARD\n",
    "#define EXTC_RC_SHADE_GUARD 0\n",
    "#endif\n",
    "#if EXTC_RC_SHADE_GUARD\n",
    "static long long extc_rc_sgHits, extc_rc_sgBad;\n",
    "static void extc_rc_sgDump(void) {\n",
    "    fprintf(stderr, \"[sg] hits=%lld bad=%lld\\n\", extc_rc_sgHits, extc_rc_sgBad);\n",
    "}\n",
    "static void extc_rc_sgArm(void) {\n",
    "    static int _a;\n",
    "    if (!_a) { _a = 1; atexit(extc_rc_sgDump); }\n",
    "}\n",
    "static void extc_rc_sgVerify(void *v) {\n",
    "    extc_rc_sgArm();\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(v);\n",
    "    int ok = 0;\n",
    "    if (s && s->region) {\n",
    "        size_t i = extc_rc_slotOf(s, v);\n",
    "        ok = (s->mark[extc_rc_word(i)] & extc_rc_bit(i)) != 0;\n",
    "    }\n",
    "    extc_rc_sgHits++;\n",
    "    if (!ok) extc_rc_sgBad++;\n",
    "}\n",
    "#endif\n",
    "__attribute__((unused, noinline)) static void extc_rc_shadeSlow(void *v) {   /* cold half: never inline -- the inline decision tilts as runtime code grows; it can wobble by 1.6% Ir */\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(v);\n",
    "    /* `!extc_rc_wb` is already screened above, so `wb > 0` implies \"at least one region is marking\". With **exactly one** participating region\n",
    "     * that region is it, so `s->region->marking` is always true and this dependent read is redundant; only with several regions is a per-region test needed. */\n",
    "    if (!s || !s->region || (extc_rc_partN > 1 && !s->region->marking)) return;   /* skip:shade-outside */\n",
    "    size_t i = extc_rc_slotOf(s, v);\n",
    "    uint64_t bit = extc_rc_bit(i);\n",
    "    /* Ask first \"is it already black\": the vast majority of calls exit here, saving one `occ` bitmap read. Swapping the order does not change the result\n",
    "     * (with `occ == 0` both orders return), it is a pure ordering change. */\n",
    "    if (s->mark[extc_rc_word(i)] & bit) { extc_rc_shadeRemember(v); return; }   /* skip:shade-black */\n",
    "    if (!(s->occ[extc_rc_word(i)] & bit)) return;   /* skip:shade-free */\n",
    "    s->mark[extc_rc_word(i)] |= bit;\n",
    "    s->nMark++;   /* roll-up: the block now holds one more reachable slot */\n",
    "    extc_rc_shadeRemember(v);   /* just marked black: the next barrier on the same pointer skips the whole section */\n",
    "    s->region->wbDebt++;   /* record debt: this step is marking work created by the mutator */\n",
    "    extc_rc_markPushForce(s->region, v);   /* a shaded object must be scanned once */\n",
    "}\n",
    "/* Barrier wrapper: inlined into every assignment point -- when no mark is in flight (the common case) two tests and out, without even a call;\n",
    " * only an in-flight mark pays one more call into the cold half. */\n",
    "__attribute__((unused)) static inline void extc_rc_shade(void *v) {\n",
    "    if (!extc_rc_wb || !v) return;   /* skip:shade-off */\n",
    "#if EXTC_RC_SHADE_GUARD\n",
    "    if (extc_rc_shadeKnown(v)) { extc_rc_sgVerify(v); return; }   /* skip:shade-known */\n",
    "#else\n",
    "    if (extc_rc_shadeKnown(v)) return;   /* skip:shade-known */\n",
    "#endif\n",
    "    extc_rc_shadeSlow(v);\n",
    "}\n",
    "/* Delete barrier (no-count tier only): in the no-count tier a **local slot** is not shaded (see initRef / initRefNoHold /\n",
    " * storeRefLocal); protection moves to the overwritten **old edge** -- shade the old value before overwriting a heap slot. Without it,\n",
    " * \"read a white object from a not-yet-scanned object, that edge is then deleted on the heap, and the white object is left with the local slot as its only source\"\n",
    " * would be judged dead when marking finishes.\n",
    " * When no mark is in flight (wb == 0) it costs one predicted-taken branch: not even *slot is read. */\n",
    "__attribute__((unused)) static inline void extc_rc_shadeOld(void *const *slot) {\n",
    "#if EXTC_RC_NOCOUNT\n",
    "    if (!extc_rc_wb || !slot) return;   /* skip:old-off */\n",
    "    extc_rc_shade(*slot);\n",
    "#else\n",
    "    (void)slot;\n",
    "#endif\n",
    "}\n",
    "/* Once per object initialization: -O1 does not inline across call sites, so every init point pays one more call+return.\n",
    " * Forced inline puts `*slot = v` and inc at the call site; a constant self-assignment point like `initRef(&p, p)` is folded away too. */\n",
    "__attribute__((unused)) static inline __attribute__((always_inline)) void extc_rc_initRef(void **slot, void *v) {\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "    extc_rc_shade(v);   /* no-count tier: local slots carry no barrier (shadeOld shades the deleted old edge instead) */\n",
    "#endif\n",
    "    *slot = v;\n",
    "    extc_rc_inc(v);\n",
    "}\n",
    "/* `...NoHold`: only store the slot, no increment. Call sites are chosen by the \"this frame will not settle\" analysis result (`planRcNoDec`) --\n",
    " * that function's dynamic range contains no `dec`, so omitting this `+1` never leaves an object one settle short. */\n",
    "__attribute__((unused)) static inline __attribute__((always_inline)) void extc_rc_initRefNoHold(void **slot, void *v) {\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "    extc_rc_shade(v);   /* no-count tier: local slots carry no barrier */\n",
    "#endif\n",
    "    *slot = v;\n",
    "}\n",
    "\n",
    "/* Overwrite an old value: read old + write + target increment + old decrement. Assigning the same value takes this path too, net change zero. */\n",
    "__attribute__((unused)) static void extc_rc_storeRef(void **slot, void *v) {\n",
    "    if (!slot) return;   /* skip:slot-null: no slot to update */\n",
    "    extc_rc_shade(v);\n",
    "    void *old = *slot;\n",
    "    extc_rc_shadeOld(slot);   /* delete barrier: an overwrite deletes the old edge */\n",
    "    *slot = v;\n",
    "    extc_rc_inc(v);\n",
    "    extc_rc_dec(old);\n",
    "}\n",
    "/* Assignment whose host region is **given statically by the caller**: saves the `ownSlab(owner)` lookup.\n",
    " *\n",
    " * Call sites: the host is a local object `new`'d in this function that is never reassigned (codegen's `rcFresh*` table).\n",
    " * The region is that allocation point's `regionOf` result -- byte-for-byte the same as the runtime lookup, just without the lookup.\n",
    " * Logic identical to `storeRefOwned` point by point (old decrement, new increment, cross-region registration). */\n",
    "/* Assignment where value and host are **in the same region** (proved at compile time), so this edge cannot cross regions:\n",
    " * registration, region comparison and two `ownSlab` lookups are all unnecessary. Only the write plus (in the count tier) the holder count.\n",
    " * Emitted and called in the no-count tier only: with counting on, `storeRefOwnedReg` still needs those two lookups for the holder count. */\n",
    "#if EXTC_RC_NOCOUNT\n",
    "__attribute__((unused)) static inline void extc_rc_storeRefSameRegion(void **slot, void *v) {   /* skip:same-region */\n",
    "    if (!slot) return;   /* skip:slot-null: no slot to update */\n",
    "    extc_rc_shadeOld(slot);\n",
    "    extc_rc_shade(v);\n",
    "    *slot = v;\n",
    "}\n",
    "#endif\n",
    "__attribute__((unused)) static inline void extc_rc_storeRefOwnedReg(void **slot, void *v,\n",
    "                                                                   ExtcRcRegion *host) {\n",
    "    extc_rc_shade(v);\n",
    "    EXTC_RC_TICK(1);   /* per-component timing (`EXTC_RC_TIME=1`) */\n",
    "    extc_rc_shadeOld(slot);   /* delete barrier: local slots have no barrier, so the old edge must be shaded at the delete point */\n",
    "    if (slot) {\n",
    "#if EXTC_RC_NOCOUNT\n",
    "        /* **Only one region participates in rc**, so cross-region edges are impossible (see the note in `notePart`), and on the assignment\n",
    "         * path the two `ownSlab` lookups and the region comparison are all skipped -- that was the most expensive stretch of the assignment path.\n",
    "         * The host's participation is **not recorded on the assignment side**: every rc slot's region recorded participation unconditionally\n",
    "         * when it was born (`extc_rc_alloc`); looking the region up again here would just pay another `ownSlab` (invariants R2/R3,\n",
    "         * see `tools/check_note_part.py`). */\n",
    "        if (extc_rc_partN > 1) {\n",
    "            ExtcRcSlab *sv = v ? extc_rc_ownSlab(v) : (ExtcRcSlab *)0;\n",
    "            /* Cross-region guard: **the new value must still be looked up** (the first cross-region write is what sets foreign);\n",
    "             * the old value can have a registration to undo only if \"a foreign pointer has appeared in this region\", so otherwise skip that lookup. */\n",
    "            if (host && sv && sv->region != host) { extc_rc_rsIncSlab(sv, v, slot); host->foreign = 1; }   /* [rt:wmark] the source slot names the group */\n",
    "            if (host && host->foreign) { void *old = *slot; ExtcRcSlab *sold = old ? extc_rc_ownSlab(old) : (ExtcRcSlab *)0; if (sold && sold->region != host) extc_rc_rsDecSlab(sold, old); }\n",
    "#if EXTC_RC_FOREIGN_GUARD\n",
    "            if (host && !host->foreign) { void *old = *slot; if (old) { extc_rc_fgChecks++; { ExtcRcSlab *_gs = extc_rc_ownSlab(old); if (_gs && _gs->region != host) extc_rc_fgBad++; } } }\n",
    "#endif\n",
    "        }\n",
    "#else\n",
    "        void       *old  = *slot;\n",
    "        ExtcRcSlab *sold = old ? extc_rc_ownSlab(old) : (ExtcRcSlab *)0;\n",
    "        ExtcRcSlab *sv   = v   ? extc_rc_ownSlab(v)   : (ExtcRcSlab *)0;\n",
    "        if (host) {\n",
    "            if (sv && sv->region != host) { extc_rc_rsIncSlab(sv, v, slot); host->foreign = 1; }   /* [rt:wmark] the source slot names the group */\n",
    "            if (host->foreign && sold && sold->region != host) extc_rc_rsDecSlab(sold, old);\n",
    "        }\n",
    "#endif\n",
    "        *slot = v;\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "        if (sv)   extc_rc_holdUpdSlab(sv, v, +1);\n",
    "        if (sold) extc_rc_holdUpdSlab(sold, old, -1);\n",
    "#endif\n",
    "        return;\n",
    "    }\n",
    "    /* NULL slot: there is no slot to update. */\n",
    "}\n",
    "\n",
