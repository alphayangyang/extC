    "/* ---- Small helpers on the hot path: always `static inline` [rt:helpers] ----\n",
    " *\n",
    " * They sit in every inc/dec/register/mark call, and `ownSlab` is a step every ownership proof walks:\n",
    " * one extra call/return is itself a measurable cost.\n",
    " *\n",
    " * `inline` only, not `always_inline`: forcing inlining expands the same batch of call sites, and on allocation-heavy shapes the\n",
    " * code grows and the instruction cache gets worse; leave it to the compiler's cost model -- flatten what should be flattened, keep what should be kept. */\n",
    "/* Finding the slab from an object pointer: slabs are EXTC_RC_SLAB_SIZE-aligned, so one bitwise AND. */\n",
    "__attribute__((unused)) static inline ExtcRcSlab *extc_rc_slabOf(void *p) {\n",
    "    return (ExtcRcSlab *)((uintptr_t)p & ~(uintptr_t)(EXTC_RC_SLAB_SIZE - 1));\n",
    "}\n",
    "/* Slot index from an object pointer: not a shift -- the slot stride ss rounds to 8 bytes and is not a power of two\n",
    " * (an 80-byte object takes an 80-byte slot, avoiding the internal fragmentation of power-of-two rounding). This divides with **reciprocal multiply and shift**:\n",
    " * rcp = 2^42/ss + 1 gives a quotient error < 2^-22; off and ss are both multiples of 8, so the smallest nonzero fractional part is\n",
    " * 8/ss >= 2^-17, so the floor is always exact. Exhaustive in-domain criterion: tests/reclaim-perf/slotindex.c (wired into gate.sh),\n",
    " * which uses these two **emitted** functions directly instead of a second copy. */\n",
    "#define EXTC_RC_RCP_SHIFT 42\n",
    "__attribute__((unused)) static inline uint64_t extc_rc_rcpOf(size_t ss) {\n",
    "    return ((uint64_t)1 << EXTC_RC_RCP_SHIFT) / ss + 1;\n",
    "}\n",
    "/* Offset from a pointer to the payload start: **slot-head validation and indexing share one source** (computing it twice drifts). */\n",
    "__attribute__((unused)) static inline size_t extc_rc_offOf(const ExtcRcSlab *s, const void *p) {\n",
    "    return (size_t)((const char *)p - EXTC_RC_SLAB_DATA(s));\n",
    "}\n",
    "__attribute__((unused)) static inline size_t extc_rc_slotOfOff(const ExtcRcSlab *s, size_t off) {\n",
    "    return (size_t)(((uint64_t)off * s->rcp) >> EXTC_RC_RCP_SHIFT);\n",
    "}\n",
    "__attribute__((unused)) static inline size_t extc_rc_slotOf(ExtcRcSlab *s, void *p) {\n",
    "    return extc_rc_slotOfOff(s, extc_rc_offOf(s, p));\n",
    "}\n",
    "__attribute__((unused)) static inline uint64_t extc_rc_bit(size_t i) { return (uint64_t)1 << (i & 63); }\n",
    "__attribute__((unused)) static inline size_t extc_rc_word(size_t i) { return i >> 6; }\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_oops(const char *why) {\n",
    "    fprintf(stderr, \"trap: reclaim: %s\\n\", why);\n",
    "    exit(1);\n",
    "}\n",
