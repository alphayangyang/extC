    "/* ---- Extent substrate [rt:extent] ----\n",
    " * An oversized payload is a page range, and until now each one was an allocation of its own: one mmap-class call (~1.9 us), its own\n",
    " * page tables, and an address that cannot come back. Measured (tools/probe/vaarena.c): carving a 2 MiB aligned range out of one\n",
    " * reservation costs 7 ns, 270 times less, and the MADV_DONTNEED the drop chain already does leaves the pages gone, so the range is\n",
    " * reusable for free. So oversized payloads are carved here instead.\n",
    " *\n",
    " * Shape: a buddy allocator over EXTC_RC_EXT_QSHIFT-sized quanta, inside reservations of EXTC_RC_EXT_ORD quanta each (64 GiB of\n",
    " * address space). The reservation is PROT_READ|PROT_WRITE, MAP_NORESERVE: address space and page tables are what it costs, and no\n",
    " * page is resident until a writer touches it. On Linux the whole reservation is MADV_HUGEPAGE, which is measured to make a drop 2.7\n",
    " * ns/KB and a re-touch 99 ns/KB, against 19 and 260 without huge pages (tools/probe/thpdrop.c).\n",
    " *\n",
    " * One byte per quantum records the state: bit 7 set means the quantum starts a free block and the low bits are its order, 0xFF means\n",
    " * the quantum is the interior of a block, and a block start that is allocated records its order without bit 7. A free list per order\n",
    " * chains block starts through nextQ. Coalescing is the buddy rule: a block returns to its order only when its twin is free at that\n",
    " * order, so fragmentation is bounded by the buddy structure and not by history.\n",
    " *\n",
    " * Contract:\n",
    " *  1. A range is carved for the bytes the caller may ever write (max) and only those pages are reserved; no page below the requested\n",
    " *     commit is touched here, which is what keeps RSS following occupancy. com is rounded up to a page (the drop chain drops page\n",
    " *     ranges).\n",
    " *  2. A range that does not fit an arena (or on a platform without mmap) is not carved: the caller falls back to its own allocation,\n",
    " *     and release decides by address, never by a flag.\n",
    " *  3. Pages must be dropped before the range goes back into the arena, because a reused range must read as zero.\n",
    " *  4. Release is once per carved range: the drop chain owns that, since it frees the record exactly when the last chunk is dropped.\n",
    " */\n",
    "#ifndef EXTC_RC_EXT\n",
    "#define EXTC_RC_EXT 1   /* 0 turns the substrate off: every payload goes back to aligned_alloc, the pre-R2 behaviour, for an A/B arm */\n",
    "#endif\n",
    "#ifndef EXTC_RC_EXT_QSHIFT\n",
    "#define EXTC_RC_EXT_QSHIFT 21   /* 2 MiB quanta: the huge-page size, so every carved range is aligned for huge pages */\n",
    "#endif\n",
    "#ifndef EXTC_RC_EXT_ORD\n",
    "#define EXTC_RC_EXT_ORD 15   /* 32768 quanta = 64 GiB of address space per arena */\n",
    "#endif\n",
    "#ifndef EXTC_RC_EXT_HUGE\n",
    "#define EXTC_RC_EXT_HUGE 1   /* madvise(MADV_HUGEPAGE) the whole reservation: measured to make a drop 2.7 ns/KB and a re-touch 99 ns/KB, against 19 and 260 without. Set 0 for an arm without huge pages. */\n",
    "#ifndef EXTC_RC_EXT_HUGE_MIN\n",
    "#define EXTC_RC_EXT_HUGE_MIN (4 << 20)   /* only a range this large is advised to use huge pages: below it a huge page wastes RSS (a 512 KiB payload touched once comes with 2 MiB resident) for too little gain. Measured: with the advice on every range, promote RSS 5.7 to 7.4 MB; with the threshold, back to 5.8 MB. */\n",
    "#endif\n",
    "#endif\n",
    "#ifndef EXTC_RC_EXT_ARENAS\n",
    "#define EXTC_RC_EXT_ARENAS 8   /* 512 GiB of address space in total, allocated lazily one arena at a time */\n",
    "#endif\n",
    "#if (EXTC_RC_EXT > 0) && (defined(__linux__) || defined(__APPLE__))\n",
    "#define EXTC_RC_EXT_OK 1\n",
    "#else\n",
    "#define EXTC_RC_EXT_OK 0\n",
    "#endif\n",
    "#if EXTC_RC_EXT_OK\n",
    "#ifndef PROT_READ\n",
    "#define PROT_READ 0x1\n",
    "#endif\n",
    "#ifndef PROT_WRITE\n",
    "#define PROT_WRITE 0x2\n",
    "#endif\n",
    "#ifndef MAP_PRIVATE\n",
    "#define MAP_PRIVATE 0x02\n",
    "#endif\n",
    "#ifndef MAP_ANONYMOUS\n",
    "#define MAP_ANONYMOUS 0x20\n",
    "#endif\n",
    "#ifndef MAP_NORESERVE\n",
    "#define MAP_NORESERVE 0x4000\n",
    "#endif\n",
    "#ifndef MADV_HUGEPAGE\n",
    "#define MADV_HUGEPAGE 14\n",
    "#endif\n",
    "/* <sys/mman.h> is not included on purpose: it declares mmap(void *), and the language stdlib declares its own mmap for plates. The\n",
    " * declaration below is the one the stdlib emits (see stdlib/std/sys/heap.extc), so the two agree when a program uses both. */\n",
    "extern uint8_t *mmap(void *, uint64_t, int32_t, int32_t, int32_t, int64_t);   /* the declaration the stdlib emits for plates (stdlib/std/sys/heap.extc): the return type is uint8_t*, so match it or a program using both fails to compile */\n",
    "__attribute__((unused)) static char *extc_rc_extMmap(size_t len) {\n",
    "    return (char *)mmap((void *)0, (uint64_t)len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, (int64_t)0);\n",
    "}\n",
    "extern int madvise(void *, size_t, int);\n",
    "typedef struct ExtcRcExtArena {\n",
    "    char           *base;\n",
    "    int32_t         fl[EXTC_RC_EXT_ORD + 1];\n",
    "    int32_t        *nextQ;\n",
    "    uint8_t        *ordQ;\n",
    "} ExtcRcExtArena;\n",
    "static ExtcRcExtArena extc_rc_extArena[EXTC_RC_EXT_ARENAS];\n",
    "static int extc_rc_extNArena;\n",
    "static long long extc_rc_extVaBytes, extc_rc_extLive, extc_rc_extCalls, extc_rc_extFails;\n",
    "\n",
    "__attribute__((unused)) static int extc_rc_extArenaNew(void) {\n",
    "    size_t q = (size_t)1 << EXTC_RC_EXT_QSHIFT;\n",
    "    size_t nq = (size_t)1 << EXTC_RC_EXT_ORD;\n",
    "    size_t span = nq << EXTC_RC_EXT_QSHIFT;\n",
    "    char *raw = extc_rc_extMmap(span + q);\n",
    "    if (!raw || raw == (char *)-1) return 0;   /* skip:ext-no-mmap */\n",
    "    char *base = (char *)(((uintptr_t)raw + (q - 1)) & ~(uintptr_t)(q - 1));   /* the head of the unaligned mapping stays leaked: at most 2 MiB */\n",
    "    ExtcRcExtArena *a = &extc_rc_extArena[extc_rc_extNArena];\n",
    "    a->nextQ = (int32_t *)calloc(nq, sizeof(int32_t));\n",
    "    a->ordQ = (uint8_t *)calloc(nq, sizeof(uint8_t));\n",
    "    if (!a->nextQ || !a->ordQ) {\n",
    "        free(a->nextQ);\n",
    "        free(a->ordQ);\n",
    "        a->nextQ = (int32_t *)0;\n",
    "        a->ordQ = (uint8_t *)0;\n",
    "        return 0;\n",
    "    }\n",
    "    a->base = base;\n",
    "    for (int i = 0; i <= EXTC_RC_EXT_ORD; i++) a->fl[i] = -1;\n",
    "    a->fl[EXTC_RC_EXT_ORD] = 0;\n",
    "    a->ordQ[0] = (uint8_t)(EXTC_RC_EXT_ORD | 0x80);\n",
    "    extc_rc_extNArena++;\n",
    "    extc_rc_extVaBytes += (long long)span;\n",
    "    return 1;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static char *extc_rc_extCarve(size_t com, size_t max, size_t *outCom) {\n",
    "    size_t q = (size_t)1 << EXTC_RC_EXT_QSHIFT;\n",
    "    size_t need = max > com ? max : com;\n",
    "    size_t nq = (need + q - 1) >> EXTC_RC_EXT_QSHIFT;\n",
    "    if (outCom) *outCom = (com + 4095) & ~(size_t)4095;\n",
    "    if (nq == 0) nq = 1;\n",
    "    extc_rc_extCalls++;\n",
    "    if (nq > ((size_t)1 << EXTC_RC_EXT_ORD)) {   /* larger than an arena: the caller allocates it itself */\n",
    "        extc_rc_extFails++;\n",
    "        return (char *)0;\n",
    "    }\n",
    "    int ord = 0;\n",
    "    while ((((size_t)1 << ord) < nq) && ord < EXTC_RC_EXT_ORD) ord++;\n",
    "    for (int attempt = 0; attempt < 2; attempt++) {\n",
    "        for (int i = 0; i < extc_rc_extNArena; i++) {\n",
    "            ExtcRcExtArena *a = &extc_rc_extArena[i];\n",
    "            int k = ord;\n",
    "            while (k <= EXTC_RC_EXT_ORD && a->fl[k] < 0) k++;\n",
    "            if (k > EXTC_RC_EXT_ORD) continue;\n",
    "            int32_t b = a->fl[k];\n",
    "            a->fl[k] = a->nextQ[b];\n",
    "            while (k > ord) {   /* split down to the requested order */\n",
    "                k--;\n",
    "                int32_t half = b + ((int32_t)1 << k);\n",
    "                a->nextQ[half] = a->fl[k];\n",
    "                a->fl[k] = half;\n",
    "                a->ordQ[half] = (uint8_t)(k | 0x80);\n",
    "            }\n",
    "            for (int32_t t = b; t < b + ((int32_t)1 << k); t++) a->ordQ[t] = 0xFF;\n",
    "            a->ordQ[b] = (uint8_t)k;   /* allocated: order, no free bit */\n",
    "#if defined(__linux__) && (EXTC_RC_EXT_HUGE > 0)\n",
    "            if (((size_t)1 << k) << EXTC_RC_EXT_QSHIFT >= (size_t)EXTC_RC_EXT_HUGE_MIN) (void)madvise((void *)(a->base + ((size_t)b << EXTC_RC_EXT_QSHIFT)), ((size_t)1 << k) << EXTC_RC_EXT_QSHIFT, MADV_HUGEPAGE);   /* advise the carved range, not the arena: 1.7 us against page work proportional to the range */\n",
    "#endif\n",
    "            extc_rc_extLive += (long long)((size_t)1 << k) << EXTC_RC_EXT_QSHIFT;\n",
    "            return a->base + ((size_t)b << EXTC_RC_EXT_QSHIFT);\n",
    "        }\n",
    "        if (extc_rc_extNArena < EXTC_RC_EXT_ARENAS && extc_rc_extArenaNew()) continue;\n",
    "        break;\n",
    "    }\n",
    "    extc_rc_extFails++;\n",
    "    return (char *)0;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static int extc_rc_extGive(char *p) {\n",
    "    size_t span = ((size_t)1 << EXTC_RC_EXT_ORD) << EXTC_RC_EXT_QSHIFT;\n",
    "    for (int i = 0; i < extc_rc_extNArena; i++) {\n",
    "        ExtcRcExtArena *a = &extc_rc_extArena[i];\n",
    "        if (p < a->base || p >= a->base + span) continue;\n",
    "        size_t off = (size_t)(p - a->base);\n",
    "        int32_t b = (int32_t)(off >> EXTC_RC_EXT_QSHIFT);\n",
    "        if ((off & (((size_t)1 << EXTC_RC_EXT_QSHIFT) - 1)) != 0) return 0;   /* skip:ext-not-base: not a range we carved, the caller frees it */\n",
    "        if ((a->ordQ[b] & 0x80) || (a->ordQ[b] & 0x7F) > EXTC_RC_EXT_ORD) return 0;   /* skip:ext-not-block: not a live block start */\n",
    "        int k = (int)(a->ordQ[b] & 0x7F);\n",
    "        extc_rc_extLive -= (long long)((size_t)1 << k) << EXTC_RC_EXT_QSHIFT;\n",
    "        for (;;) {\n",
    "            if (k >= EXTC_RC_EXT_ORD) break;\n",
    "            int32_t buddy = b ^ ((int32_t)1 << k);\n",
    "            if (a->ordQ[buddy] != (uint8_t)(k | 0x80)) break;\n",
    "            int32_t *pp = &a->fl[k];\n",
    "            while (*pp >= 0 && *pp != buddy) pp = &a->nextQ[*pp];\n",
    "            if (*pp < 0) break;\n",
    "            *pp = a->nextQ[buddy];   /* the twin leaves the free list */\n",
    "            if (buddy < b) b = buddy;\n",
    "            k++;\n",
    "            a->ordQ[b] = (uint8_t)(k | 0x80);\n",
    "            for (int32_t t = b + 1; t < b + ((int32_t)1 << k); t++) a->ordQ[t] = 0xFF;\n",
    "        }\n",
    "        a->ordQ[b] = (uint8_t)(k | 0x80);\n",
    "        a->nextQ[b] = a->fl[k];\n",
    "        a->fl[k] = b;\n",
    "        return 1;\n",
    "    }\n",
    "    return 0;\n",
    "}\n",
    "/* Parallel safety: the arena is global (a payload may be released by a thread other than the one that carved it), so carve and give are serialized. The lock is held across the carve and the advice: a big allocation is rare next to a slot allocation, and the advice is 1.7 us. */\n",
    "static int extc_rc_extLock;\n",
    "__attribute__((unused)) static void extc_rc_extLockAcq(void) { while (__atomic_exchange_n(&extc_rc_extLock, 1, __ATOMIC_ACQUIRE)) { } }\n",
    "__attribute__((unused)) static void extc_rc_extLockRel(void) { __atomic_store_n(&extc_rc_extLock, 0, __ATOMIC_RELEASE); }\n",
    "__attribute__((unused)) static char *extc_rc_extAlloc(size_t com, size_t max, size_t *outCom) {\n",
    "    extc_rc_extLockAcq();\n",
    "    char *p = extc_rc_extCarve(com, max, outCom);\n",
    "    extc_rc_extLockRel();\n",
    "    return p;\n",
    "}\n",
    "__attribute__((unused)) static int extc_rc_extRelease(char *p) {\n",
    "    extc_rc_extLockAcq();\n",
    "    int ok = extc_rc_extGive(p);\n",
    "    extc_rc_extLockRel();\n",
    "    return ok;\n",
    "}\n",
    "#else   /* EXTC_RC_EXT_OK */\n",
    "/* The substrate is off or the platform has no mmap: the counters stay zero and the two entry points refuse, so the payload path falls back to a mapping of its own. */\n",
    "static long long extc_rc_extVaBytes, extc_rc_extLive, extc_rc_extCalls, extc_rc_extFails;\n",
    "__attribute__((unused)) static char *extc_rc_extAlloc(size_t com, size_t max, size_t *outCom) {\n",
    "    (void)max;\n",
    "    if (outCom) *outCom = com;\n",
    "    return (char *)0;\n",
    "}\n",
    "__attribute__((unused)) static int extc_rc_extRelease(char *p) {\n",
    "    (void)p;\n",
    "    return 0;\n",
    "}\n",
    "#endif   /* EXTC_RC_EXT_OK */\n",
