    "/* ---- Huge payload drop [rt:hugefree] ----\n",
    " * A huge object's payload is an allocation of its own, so returning it to the OS is one page-table teardown whose cost follows the\n",
    " * resident size of the object and not the heap: 8 MiB costs 118 us, 32 MiB 584-901 us. That is the one step component a program's\n",
    " * own object size can push into the millisecond range, and the only step whose work is proportional to the request rather than to the\n",
    " * program's history. So the payload is handed back in page chunks across steps: each step drops at most EXTC_RC_BIG_DROP_BYTES of dead\n",
    " * payload with madvise(MADV_DONTNEED) (cost follows the pages it drops: 6.7 us per 512 KiB), and free() runs only after the mapping\n",
    " * has no resident page left (2 us: a pure munmap of page tables). The payload is allocated page-aligned so every chunk boundary is a\n",
    " * page boundary, and the drop record lives in the payload's own first two words, so the queue needs no allocation and no fixed\n",
    " * capacity. Contract: one step drops at most EXTC_RC_BIG_DROP_BYTES of huge payload, and a payload is returned one step after its last\n",
    " * chunk. At a huge allocation the budget is the slot size of the request itself (see extc_rc_slabNew): page work is\n",
    " * proportional to the request, so it is charged to the allocation that made the heap grow, and it is reported as the [chan] bigdrop\n",
    " * channel. */\n",
    "#ifndef EXTC_RC_BIG_DROP_BYTES\n",
    "#define EXTC_RC_BIG_DROP_BYTES (512 * 1024)   /* per-step chunk of a dead huge payload: ~6.7 us of page-table work on the reference machine */\n",
    "#endif\n",
    "#if defined(__linux__) || defined(__APPLE__)\n",
    "#ifndef EXTC_RC_BIG_DROP_OK\n",
    "#define EXTC_RC_BIG_DROP_OK 1\n",
    "#endif\n",
    "#ifndef MADV_DONTNEED\n",
    "#define MADV_DONTNEED 4   /* the page pass below carries the same two lines: <sys/mman.h> is not included on purpose, because it\n",
    "                           * declares mmap(void *) and the language stdlib declares its own mmap for plates */\n",
    "#endif\n",
    "extern int madvise(void *, size_t, int);\n",
    "#else\n",
    "#define EXTC_RC_BIG_DROP_OK 0\n",
    "#endif\n",
    "typedef struct ExtcRcBigDrop { struct ExtcRcBigDrop *next; size_t left; } ExtcRcBigDrop;\n",
    "static _Thread_local ExtcRcBigDrop *extc_rc_bdHead;\n",
    "static _Thread_local long long extc_rc_bdBytes, extc_rc_bdChunks;\n",
    "__attribute__((unused)) static size_t extc_rc_bigRound(size_t n) { return (n + 4095) & ~(size_t)4095; }\n",
    "__attribute__((unused)) static char *extc_rc_bigPayloadAlloc(size_t n) {\n",
    "#if EXTC_RC_BIG_DROP_OK\n",
    "    size_t m = extc_rc_bigRound(n), com = 0;\n",
    "    char *p = extc_rc_extAlloc(m, m, &com);   /* [rt:extent] carve from the reserved arena: 7 ns instead of 1897, and the range is reusable */\n",
    "    if (!p) p = (char *)aligned_alloc(4096, m);   /* arena exhausted, or no mmap on this platform: a mapping of its own, dropped by the same chain */\n",
    "    if (!p) extc_rc_oops(\"oversized slot allocation failed\");\n",
    "    return p;\n",
    "#else\n",
    "    char *p = (char *)malloc(n);\n",
    "    if (!p) extc_rc_oops(\"oversized slot allocation failed\");\n",
    "    return p;\n",
    "#endif\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_bigPayloadRelease(char *p, size_t n) {\n",
    "#if EXTC_RC_BIG_DROP_OK\n",
    "    if (p) {\n",
    "        ExtcRcBigDrop *d = (ExtcRcBigDrop *)p;\n",
    "        d->left = extc_rc_bigRound(n);\n",
    "        d->next = extc_rc_bdHead;\n",
    "        extc_rc_bdHead = d;\n",
    "        extc_rc_bdBytes += (long long)d->left;\n",
    "    }\n",
    "#else\n",
    "    (void)n;\n",
    "    free(p);\n",
    "#endif\n",
    "}\n",
    "__attribute__((unused)) static long long extc_rc_bigTrimStep(size_t budget) {\n",
    "#if EXTC_RC_BIG_DROP_OK\n",
    "    long long chunks = 0;\n",
    "    while (extc_rc_bdHead && budget > 0) {\n",
    "        ExtcRcBigDrop *d = extc_rc_bdHead;\n",
    "        size_t len = d->left;\n",
    "        size_t c = len < budget ? len : budget;\n",
    "        if (c >= len) {                 /* last chunk: read the record out first, the drop destroys it */\n",
    "            extc_rc_bdHead = d->next;\n",
    "            extc_rc_bdBytes -= (long long)len;\n",
    "            budget -= len;\n",
    "            (void)madvise((void *)d, len, MADV_DONTNEED);\n",
    "            { int kept = extc_rc_extRelease((char *)d); if (!kept) free(d); }   /* [rt:extent] pages are gone: hand the range back to the arena, or free a mapping that was not carved from it */\n",
    "        } else {\n",
    "            (void)madvise((char *)d + (len - c), c, MADV_DONTNEED);\n",
    "            d->left = len - c;\n",
    "            extc_rc_bdBytes -= (long long)c;\n",
    "            budget -= c;\n",
    "        }\n",
    "        chunks++;\n",
    "    }\n",
    "    extc_rc_bdChunks += chunks;\n",
    "    return chunks;\n",
    "#else\n",
    "    (void)budget;\n",
    "    return 0;\n",
    "#endif\n",
    "}\n",

    "__attribute__((unused)) static ExtcRcSlab *extc_rc_slabNew(ExtcRcRegion *r, size_t slotSize) {\n",
    "    EXTC_RC_TICK(4);   /* per-component timing (`EXTC_RC_TIME=1`) */\n",
    "    extc_rc_fqDrainAuto();   /* free queued slabs before carving a new one: the queue is dead RSS, so pay it before asking the OS for memory */\n",
    "    size_t chunk = EXTC_RC_SLAB_CHUNK_MIN;\n",
    "    /* Configuration may set the block size below CHUNK_MIN (EXTC_RC_SLAB_BITS < 16): clamp the start into the block first,\n",
    "     * otherwise chunk can be no smaller than the block size and cap would compute more slots than the block holds, writing out of bounds. */\n",
    "    if (chunk > EXTC_RC_SLAB_SIZE) chunk = EXTC_RC_SLAB_SIZE;\n",
    "    while (chunk < EXTC_RC_SLAB_SIZE && chunk / slotSize < EXTC_RC_SLAB_SLOTS_MIN)\n",
    "        chunk <<= 1;   /* cold path, at most 4 times; compare by division to avoid overflow in the slotSize product */\n",
    "    size_t cap = (chunk - EXTC_RC_SLAB_HDR) / slotSize;\n",
    "    int big = (cap < 2);   /* fewer than two fit, so the payload is malloc'd separately and the slab holds 1 slot */\n",
    "    ExtcRcSlab *s;\n",
    "    size_t nslots;\n",
    "    if (big) {\n",
    "        s = (ExtcRcSlab *)calloc(1, sizeof(ExtcRcSlab));\n",
    "        if (!s) extc_rc_oops(\"oversized slot header allocation failed\");\n",
    "        if (extc_rc_bdHead) {   /* [rt:hugefree] this block is one request this big, so drop one request's worth of dead payload:\n",
    "                                 * the drop rate then keeps up with the allocation rate, which is what the growth-by-copy shape needs. A fixed\n",
    "                                 * per-step budget cannot keep up (its backlog grows with the number of live generations), and the whole\n",
    "                                 * cost is page work proportional to the request, charged to the allocation that made the heap grow. */\n",
    "            long long _bd0 = extc_rc_chanClock();\n",
    "            long long _bdw = extc_rc_bdBytes;\n",
    "            extc_rc_bigTrimStep(slotSize);\n",
    "            extc_rc_chanNote(3, extc_rc_chanClock() - _bd0, _bdw - extc_rc_bdBytes);\n",
    "        }\n",

    "        s->data = extc_rc_bigPayloadAlloc(slotSize);\n",
    "        if (!s->data) extc_rc_oops(\"oversized slot allocation failed\");\n",
    "        nslots = 1;\n",
    "    } else {\n",
    "        s = (ExtcRcSlab *)aligned_alloc(EXTC_RC_SLAB_SIZE, EXTC_RC_SLAB_SIZE);\n",
    "        if (!s) extc_rc_oops(\"slab allocation failed\");\n",
    "        memset(s, 0, EXTC_RC_SLAB_HDR);\n",
    "        s->data = (char *)s + EXTC_RC_SLAB_HDR;\n",
    "        nslots = cap;\n",
    "    }\n",
    "    s->region = r;\n",
    "    s->big = big;\n",
    "    s->ss = slotSize;\n",
    "    if ((int64_t)slotSize > r->maxReq) r->maxReq = (int64_t)slotSize;   /* admission by request size: reserve room for one request this big (slow path, so 0 Ir per allocation) */\n",
    "    s->rcp = extc_rc_rcpOf(slotSize);\n",
    "    s->nslots = (uint32_t)nslots;\n",
    "    r->capBytes += (int64_t)nslots * (int64_t)slotSize;   /* capacity, not occupancy: both release passes compare it against r->bytes */\n",
    "    if (s->nslots > EXTC_RC_REUSE_MAX_SLOT)\n",
    "        extc_rc_oops(\"slab slot count exceeds the reuse-chain encoding limit\");\n",
    "    s->nwords = (uint32_t)((nslots + 63) / 64);\n",
    "#if EXTC_RC_WMARK\n",
    "    /* [rt:wmark] Large strides only. One bit per 64-byte group is stride/4096 words per slot, and a block holds 512 KiB / stride\n",
    "     * slots, so the whole block's bitmap is about 128 words (1 KiB) whatever the stride is: the metadata does not grow with the object. */\n",
    "    if (slotSize >= (size_t)EXTC_RC_WMARK_MIN_BYTES) {\n",
    "        s->wmW = (uint32_t)(slotSize / 4096u + ((slotSize % 4096u) ? 1u : 0u));\n",
    "        s->wmark = (uint64_t *)calloc((size_t)nslots * (size_t)s->wmW, sizeof(uint64_t));\n",
    "        if (!s->wmark) extc_rc_oops(\"slot bitmap allocation failed\");\n",
    "    }\n",
    "#endif\n",
    "/* The three bitmaps are **traversed in order as a whole** (mark / sweep / whole-region drop), so they must be cleared wholesale: calloc.\n",
    " * The two 16-bit per-slot arrays are the opposite: **only occupied slots are read** (every accessor checks occ first), so malloc them and\n",
    " * clear per slot at allocation time -- calloc clears the whole span eagerly, and when it lands on the heap (only a large mapping goes through mmap lazily)\n",
    " * those hundreds of KB in small shapes become RSS at once. */\n",
    "    s->occ   = (uint64_t *)calloc(s->nwords, sizeof(uint64_t));\n",
    "    s->mark  = (uint64_t *)calloc(s->nwords, sizeof(uint64_t));\n",
    "    s->rsbit = (uint64_t *)calloc(s->nwords, sizeof(uint64_t));\n",
    "/* `hold` (the 2-byte per-slot holder count) is needed only **with counting on**; with counting off it is pure overhead\n",
    " * (~29k instructions on a slab of 16 B slots). When off, not even the pointer is allocated. */\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "    s->hold  = (uint16_t *)malloc(nslots * sizeof(uint16_t));\n",
    "#endif\n",
    "    s->tid   = (uint16_t *)malloc(nslots * sizeof(uint16_t));\n",
    "    s->ttabCap = 8;\n",
    "    s->ttabN = 2;\n",
    "    s->ttab  = (const ExtcRcType **)calloc(s->ttabCap, sizeof(ExtcRcType *));\n",
    "    if (s->ttab) s->ttab[1] = EXTC_RC_CONSERVATIVE;   /* number 1 is fixed: the fallback descriptor */\n",
    "#if EXTC_RC_NOCOUNT\n",
    "    if (!s->occ || !s->mark || !s->rsbit || !s->tid || !s->ttab)\n",
    "#else\n",
    "    if (!s->occ || !s->mark || !s->rsbit || !s->hold || !s->tid || !s->ttab)\n",
    "#endif\n",
    "        extc_rc_oops(\"slab metadata allocation failed\");\n",
    "/* **Not** pre-chaining the whole block into the free list: a slab can have many slots, and chaining costs more than a whole round of\n",
    " * allocation for most programs -- a small load would pay a huge fixed cost per slab creation.\n",
    " * Instead \"never-issued slots go through bump, only released slots enter freelist\": the chain is maintained only on real reuse.\n",
    " *\n",
    " * Chunked refill (push `EXTC_RC_CHUNK` slots when the chain empties) is the alternative: it saves a few pointer hops on heavy shapes,\n",
    " * but both judged metrics are slightly worse, so under the ratchet rule (tighten only) this version stays. */\n",
    "    s->freelist = -1;   /* empty head: the chain's next slot number lives in each slot's tid[] (see extc_rc_freeSlot) */\n",
    "    s->bump = 0;\n",
    "    s->nLive = 0;\n",
    "    s->nMark = 0;\n",
    "    s->nfree = 0;   /* EXTC_RC_LAZY_FREE: no hole pending yet */\n",
    "    s->pgNext = -1;   /* no page pass in progress */\n",
    "/* A slab created **while a sweep is in flight** is prepended at the head of the slab list, i.e. *behind* the cursor, so this round never\n",
    " * reaches it. Declaring it part of the swept set (swEpoch = swId) keeps the allocation-time rule in extc_rc_alloc from marking its slots\n",
    " * black: no sweep pass would ever clear such a bit (mark rounds do not clear the bitmap), and the next mark round would treat a reachable\n",
    " * object as already scanned, skip its subtree, and the sweep after that would free live objects. */\n",
    "    if (r->sweeping) s->swEpoch = r->swId;\n",
    "    extc_rc_ownAdd(s);        /* from this moment the slab's slots may be counted/marked */\n",
    "    return s;\n",
    "}\n",
    "\n",
    "/* Size-class hash: the key is ss / 8, multiplied by the Knuth constant, taking the **high 5 bits** as the bucket. The low bits\n",
    " * (ss/8 = 2,4,6...) distribute poorly for consecutive small keys, so they are not used. */\n",
    "__attribute__((unused)) static size_t extc_rc_classBucket(size_t ss) {\n",
    "    return (size_t)(((uint64_t)(ss >> 3) * 0x9E3779B97F4A7C15ull) >> 59);\n",
    "}\n",
    "/* Look up a size class; create one on the spot when none was allocated (cold path, one malloc per size class). */\n",
    "__attribute__((unused)) static ExtcRcClass *extc_rc_classNeed(ExtcRcRegion *r, size_t ss) {\n",
    "    size_t b = extc_rc_classBucket(ss);\n",
    "    ExtcRcClass *c = r->clsBkt[b];\n",
    "    while (c && c->ss != ss) c = c->next;\n",
    "    if (!c) {\n",
    "        c = (ExtcRcClass *)calloc(1, sizeof(ExtcRcClass));\n",
    "        if (!c) extc_rc_oops(\"size-class entry allocation failed\");\n",
    "        c->ss = ss;\n",
    "        c->next = r->clsBkt[b];\n",
    "        r->clsBkt[b] = c;\n",
    "    }\n",
    "    return c;\n",
    "}\n",
    "/* Look up without creating: the allocation fallback uses it. NULL means this size class has no block yet. */\n",
    "__attribute__((unused)) static ExtcRcClass *extc_rc_classSlot(const ExtcRcRegion *r, size_t ss) {\n",
    "    ExtcRcClass *c = r->clsBkt[extc_rc_classBucket(ss)];\n",
    "    while (c && c->ss != ss) c = c->next;\n",
    "    return c;\n",
    "}\n",
    "/* Push a slab with a free slot onto the size class's chain head. Called only when !avail, so a block on the chain never enters twice. */\n",
    "__attribute__((unused)) static void extc_rc_classPush(ExtcRcRegion *r, ExtcRcSlab *s) {\n",
    "    ExtcRcClass *c = extc_rc_classNeed(r, s->ss);\n",
    "    s->availPrev = (ExtcRcSlab *)0; if (c->head) c->head->availPrev = s; s->availNext = c->head;\n",
    "    c->head = s;\n",
    "    s->avail = 1;\n",
    "}\n",
    "\n",
    "/* Number of regions that have participated in rc. Monotonic: once a second region participates, the assignment fast path is off for good. */\n",
    "__attribute__((unused)) static size_t extc_rc_partN;\n",
    "\n",
    "/* Record that \"this region has participated in rc\". Criterion: with **only one region participating**, every rc object is inside it and\n",
    " * the assignment host must be it too, so no cross-region edge is possible and the whole lookup+registration on the assignment path can be skipped.\n",
    " * Unlike \"was anything registered\", this flag is maintained **unconditionally** by allocation and assignment, so the fast path cannot starve it. */\n",
    "__attribute__((unused)) static inline void extc_rc_notePart(ExtcRcRegion *r) {\n",
    "    if (r && !r->part) { r->part = 1; extc_rc_partN++; }\n",
    "}\n",
    "/* Memory-wall contract (EXTC_RC_M_MAX, bytes; unset = implicit 3 x live): the trigger threshold is capped so that live + garbage stays near the\n",

    " * wall, and near the wall the per-step budget grows instead of the trigger frequency. EXTC_RC_M_MAX=0 selects the implicit wall; -1 only means\n",

    " * Mutual exclusion with the old self-learning contract (tests/reclaim/driver.c:838-839): an unbounded trigger threshold keeps the sweep count a\n",

    " * small constant as the live set grows 100x, but pays with unbounded resident memory -- live + garbage is not bounded. Capping the threshold\n",

    " * trades that for a logarithmic sweep count: with thr <= 2.75 x live one sweep retires one live set, so the live set must grow ~2.75x to reach the\n",

    " * next trigger and the sweep count is O(log N) -- the price of a bounded peak (memory is exchanged for work). The two assertions are updated to\n",

    " * \"sweep count grows logarithmically, peak residency <= M_max + buffer\". */\n",


    "__attribute__((unused)) static long long extc_rc_mmax = -1;\n",

    "__attribute__((unused)) static long long extc_rc_thrMax, extc_rc_scaleMax, extc_rc_pressureN, extc_rc_wallWarned;\n",
    "/* Values the [work] line exposes for the memory-wall gate (G4): M_max is the explicit EXTC_RC_M_MAX when set, otherwise the largest implicit 3 x live\n",

    " * wall used by any thrUpd; M_max_now is the last one; thr is the trigger line from the last thrUpd. The implicit form is reported because it is what\n",

    " * actually bounded the run. */\n",

    "__attribute__((unused)) static long long extc_rc_mmaxNow, extc_rc_mmaxUsed, extc_rc_thrNow;\n",
    "    __attribute__((unused)) static long long extc_rc_maxReqNow, extc_rc_resNow;\n",
    "__attribute__((unused)) static long long extc_rc_quotaDeadlineHits, extc_rc_quotaChecks, extc_rc_quotaHitsRound, extc_rc_quotaChecksRound;   /* [quota]: deadline stops / deadline loops / per-round counters (the sweepBegin line publishes and resets them) */\n",

    "__attribute__((unused)) static int extc_rc_pressLast;\n",


    "__attribute__((unused)) static void extc_rc_mmaxArm(void) {\n",

    "    if (extc_rc_mmax < 0) {\n",

    "        const char *_mz = getenv(\"EXTC_RC_M_MAX\");\n",

    "        extc_rc_mmax = (_mz && *_mz) ? atoll(_mz) : 0;\n",

    "        if (extc_rc_mmax < 0) extc_rc_mmax = 0;\n",

    "    }\n",

    "}\n",

    "__attribute__((unused)) static inline int64_t extc_rc_mmaxEff(const ExtcRcRegion *r) {\n",

    "    extc_rc_mmaxArm();\n",

    "    if (extc_rc_mmax > 0) return extc_rc_mmax;   /* skip:m-max-explicit */\n",

    "    return r->live > 0 ? r->live * 3 : 0;   /* implicit 3 x live: 0 while unswept, i.e. no cap before the first round */\n",

    "}\n",

    "/* Pressure = near the memory wall. The trigger line already sits below the wall; this flag decides how much work one step may do. */\n",

    "__attribute__((unused)) static inline int extc_rc_pressure(const ExtcRcRegion *r) {\n",

    "    int64_t m = extc_rc_mmaxEff(r);\n",

    "    if (m <= 0) return 0;   /* skip:no-wall */\n",

    "    if ((int64_t)r->bytes >= m - m / 8) { extc_rc_pressLast = 1; return 1; }   /* >= 7/8 of the wall */\n",


    "    if (r->thr > 0 && r->thr < INT64_MAX / 4 && (int64_t)r->bytes > r->thr * 4) { extc_rc_pressLast = 1; return 1; }\n",


    "    return 0;\n",

    "}\n",

    "/* Stepped sweep: the allocation path needs it, but the sweep body is defined later. Each step sweeps at most 8 words (64 slots/word). */\n",
    "#ifndef EXTC_RC_SWEEP_BUDGET\n",
    "#define EXTC_RC_SWEEP_BUDGET 8\n",
    "#endif\n",
    "/* P0-P quota pacing: the sweep and mark work one allocation triggers grows with the requested bytes, so a program made of a few huge\n",
    " * allocations cannot starve reclamation (pacing by allocation events alone lets memory grow with total allocation, not the live set).\n",
    " * This is the structural premise of the memory bound M <= M_max + buffer.\n",
    " *   - sweep: budget = the fixed per-step budget (times the pressure multiplier) + max(1, min(ceil(cursor_slab->nslots / 64), SWEEP_FINISH_MAX)),\n",
    " *     i.e. the words needed to finish the slab the cursor sits on (a one-slot huge block needs exactly one);\n",
    " *   - mark: quota = min(request_bytes >> QUOTA_SHIFT_MARK, QUOTA_MAX_MARK) work units; 1 unit = 1 popped slot, 1 scanned bitmap word,\n",
    " *     or 1 pointer word walked by a segmented resume (the three cost different amounts; the unit only paces, it is not a time).\n",
    " * Closed form: W_s = 8*pm + max(1, min(ceil(cursor_slab->nslots/64), SWEEP_FINISH_MAX)) swept words; the second term is capped\n",
    " * by SWEEP_FINISH_MAX (64) because the block geometry does not bound the slots a single step can release;\n",
    " * W_m = min(request_bytes >> QUOTA_SHIFT_MARK, QUOTA_MAX_MARK) mark work units; one markAdvance budget is min((64*8+debt)*pm, 256*pm) = 256*pm,\n",
    " * and a pending large-object scan pays one whole segment (<= SCAN_CHUNK words) in that advance.\n",
    " * The same allocation pays the sweep first and then the mark, so the two costs add: P_step <= w1*W_s + c_u*W_m + c_a (w1 per swept word,\n",
    " * c_u per mark unit, c_a the fixed step cost); the caps above bound this chain.\n",
    " * Quoted anchors (object shape matters: pd_bigobj is a few 8 MiB **sparse** objects; a dense pointer array is 8-25x slower per word):\n",
    " * 16 B allocation <= 0.4 us; 512 KiB 78-98 us; 8 MiB sparse without a resume 0.22-0.26 ms, with a resume 0.35-0.5 ms.\n",
    " * EXTC_RC_QUOTA_DEADLINE_US adds a physical ceiling to the mark quota loop: the quota is the byte-earned reclamation credit, the deadline\n",
    " * is the last-resort bound on one step (checked at segment granularity, so a step stops at deadline + 2 segments). The memory bound then\n",
    " * holds as long as deadline hits do not keep growing (observable as the [quota] hit count); a hit count that keeps growing means the\n",
    " * deadline, not the quota, is pacing reclamation.\n",
    " * This is a new channel, stated separately from the 5 us step gate. The theoretical pointer-dense worst case QUOTA_MAX_MARK * ~17.5 ns ~= 18 ms is\n",
    " * an UNTESTED risk (the allocation would have to request bytes with a dense pointer array and keep them live; a later round must measure that shape,\n",
    " * not report 18 ms as observed). */\n",
    "#ifndef EXTC_RC_QUOTA_SHIFT_MARK\n",
    "#define EXTC_RC_QUOTA_SHIFT_MARK 3         /* one mark work unit per 8 requested bytes: one pointer word per 8 bytes of payload */\n",
    "#endif\n",
    "#ifndef EXTC_RC_QUOTA_MAX_WORDS\n",
    "#define EXTC_RC_QUOTA_MAX_WORDS 8192      /* hard cap on the extra sweep words one allocation may request: 8192 words is 78-98 us at 9.5-12 ns/word. */\n",
    "/* For a legal slab (at most 32766 slots: 512 KiB / the 16-byte minimum slot) ceil(nslots/64) <= 512, so this cap only defends against a corrupt or oversized nslots. */\n",
    "#endif\n",
    "#ifndef EXTC_RC_SWEEP_FINISH_MAX\n",
    "#define EXTC_RC_SWEEP_FINISH_MAX 64       /* cap on the slab-finish credit, in words (64 words = 1024 slots of 16 B): one allocation may finish at most\n",
    "                                           * this much of the cursor slab. The credit has to be capped because the block geometry does not bound\n",
    "                                           * it: a 512 KiB block of 16 B slots has 512 words, so an uncapped credit releases 32766 slots in ONE\n",
    "                                           * allocation step (194 us on the cross-region shape, 4x the pause envelope). Capping only delays\n",
    "                                           * finishing a big slab by a few allocations. */\n",
    "#endif\n",
    "#ifndef EXTC_RC_QUOTA_MAX_MARK\n",
    "#define EXTC_RC_QUOTA_MAX_MARK (1 << 20)  /* memory-first default: enough for one 8 MiB pointer-dense big to be scanned in one allocation.\n",
    "                                           * Pause-first alternative: 8192 (one segment; pd_bigobj then peaks at 34,328 kB instead of 26,264 kB).\n",
    "                                           * Per-step pause is still one SCAN_CHUNK segment (~0.1 ms); the aggregate allocation stall grows. */\n",
    "#endif\n",
    "/* Physical per-step ceiling for the mark quota loop, in microseconds (0 = off). The quota above is byte-earned credit; this deadline bounds\n",
    " * one step even while a dense pointer array is walked. It is checked once per segment-sized batch of work, so a step stops at\n",
    " * deadline + 2 segments (the first advance and the in-flight advance that trips the deadline; one segment is <= SCAN_CHUNK words). The [quota] line reports the hit count: the memory bound stays valid while the hits do\n",
    " * not keep growing.\n",
    " *\n",
    " * Default 800: a cut inside a drain carries a memory cost. On tests/gc-p0/src/pd_bigobj.extc (200 rounds) a 250 us ceiling hits\n",
    " * 99-143 times and peaks at 34,524 kB, while 800 us hits 0-1 times and holds 26,460 kB, the same peak as with the ceiling off, because an\n",
    " * interrupted drain delays the sweep past the next 8 MiB allocation. One step is therefore bounded at 800 us + 2 segments (about 0.96-1.0 ms),\n",
    " * under the 1 ms histogram edge; 250 us remains selectable with -DEXTC_RC_QUOTA_DEADLINE_US=250 for pause-first builds. */\n",
    "#ifndef EXTC_RC_QUOTA_DEADLINE_US\n",
    "#define EXTC_RC_QUOTA_DEADLINE_US 800\n",
    "#endif\n",
    "#ifndef EXTC_RC_LAZY_FREE\n",
    "/* 1 = the sweep counts the holes it frees instead of linking every one of them into the reuse chain; the allocator then rebuilds\n",
    " * the chain from the occupancy bitmap once per visit. 0 = every hole is linked on release. Default 0: the rebuild adds about 19.5M\n",
    " * instructions on the sizeratio shape and the wall-clock gain of the lazy variant is inside run-to-run noise. */\n",
    "#define EXTC_RC_LAZY_FREE 0\n",
    "#endif\n",
    "#ifndef EXTC_RC_ELIDE_VERIFY\n",
    "/* 1 = before the O(1) whole-slab reset, re-scan occ/mark/rsbit and count a mismatch instead of resetting; a drifting roll-up would\n",
    " * otherwise reset a slab that still holds live objects. Default 0: off. */\n",
    "#define EXTC_RC_ELIDE_VERIFY 0\n",
    "#endif\n",
    "/* Budget for one targeted release (`extc_rc_releaseOld`): the call marks the live set from the other roots and then descends from the old value.\n",
    " * Both phases draw on this one budget, in slot units: the mark phase is charged one unit per popped slot and one segment (EXTC_RC_SCAN_CHUNK/8)\n",
    " * per resumed large-object scan, the descent one unit per popped slot plus one per candidate pointer it examines. An unfinished mark means\n",
    " * \"unmarked\" does not prove a slot dead, so the whole release is abandoned (nothing freed, marks cleared); an unfinished descent simply stops,\n",
    " * and unvisited children keep their counts for the sweep. Both outcomes reclaim less, never unsafe.\n",
    " *\n",
    " * Default 2048: at the calibrated ~17.5 ns per popped slot the worst single release pause is ~36 us, under the 50 us step target. */\n",
    "#ifndef EXTC_RC_RELEASE_BUDGET\n",
    "#define EXTC_RC_RELEASE_BUDGET 2048\n",
    "#endif\n",
    "/* Pressure multiplier for the per-step budgets (EXTC_RC_M_MAX / memory wall): near the wall one step advances this many times more work, so the\n",

    " * wall is approached by more work per step, not by more frequent steps (frequency cannot bound memory). Each step stays bounded: 8 x 16 sweep\n",

    " * words and 256 x 16 mark objects is the hard ceiling; the default 4 keeps a step well under the 50 us target at the calibrated costs. */\n",

    "#ifndef EXTC_RC_SWEEP_PRESSURE_MUL\n",

    "#define EXTC_RC_SWEEP_PRESSURE_MUL 4\n",

    "#endif\n",

    "#if EXTC_RC_SWEEP_PRESSURE_MUL < 1 || EXTC_RC_SWEEP_PRESSURE_MUL > 16\n",

    "#error \"EXTC_RC_SWEEP_PRESSURE_MUL outside 1..16\"\n",

    "#endif\n",

    "static int extc_rc_sweepStep(ExtcRcRegion *r, uint32_t budget);\n",
    "static void extc_rc_settle(ExtcRcRegion *r);\n",
    "/* Each macro gets its own `#ifndef`: tuning one (`cc -D...`) must not drag in the others -- a single\n",
    " * `#ifndef EXTC_RC_MARK_STEP` around four macros skips the other three whenever any one is defined. */\n",
    "#ifndef EXTC_RC_SEED_PUSHES\n",
    "#define EXTC_RC_SEED_PUSHES 256  /* how many **seed slots** one step pushes at most */\n",
    "#endif\n",
    "#ifndef EXTC_RC_SEED_WORDS\n",
    "#define EXTC_RC_SEED_WORDS 512  /* how many rsbit words one step **scans** at most (a separate seed-scan budget: word scanning must not stretch a step; too large and step time drifts with the slab, too small and a long slab is not scanned in one round) */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_EVERY\n",
    "#define EXTC_RC_MARK_EVERY 64        /* every how many allocations marking advances */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_WINDOW\n",
    "#define EXTC_RC_MARK_WINDOW (2 << 20)  /* window cap: past this many bytes of drift, boost (x8) */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_STEP\n",
    "#define EXTC_RC_MARK_STEP 8       /* base step: every allocation point advances at least this many objects */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_BATCH_MAX\n",
    "#define EXTC_RC_MARK_BATCH_MAX 256   /* **ceiling** on one `markAdvance` budget (the last window bound; larger lengthens a step's pause, smaller breaks the prefetch batch) */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_STEP_POP_MAX\n",
    "#define EXTC_RC_MARK_STEP_POP_MAX 512  /* pops one bounded step may take: the compile-time half of the pause contract */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_PUSH_STEP\n",
    "#define EXTC_RC_MARK_PUSH_STEP 2048   /* children one bounded step may push: charged per batch, so the cost is 2 Ir per ~200 pops */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_COLD_BYTES\n",
    "#define EXTC_RC_MARK_COLD_BYTES (16 << 20)   /* live-set threshold where a pop stops being a cache hit;\n",
    "                                    * past it the per-pop cost is memory latency, so the same pause target needs fewer pops per step */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_COLD_BATCH\n",
    "#define EXTC_RC_MARK_COLD_BATCH 32   /* per-step pop ceiling once live bytes exceed EXTC_RC_MARK_COLD_BYTES;\n",
    "                                    * a cold pop is a memory miss: on a 24-130 MB live set a pop costs about 1 us, so 32 pops keep the\n",
    "                                    * dense shape inside one 50 us budget, while the warm tier keeps its 1024 (a pop there is a hit) */\n",
    "#endif\n",
    "#if EXTC_RC_MARK_COLD_BATCH > EXTC_RC_MARK_BATCH_MAX\n",
    "#error \"EXTC_RC_MARK_COLD_BATCH exceeds EXTC_RC_MARK_BATCH_MAX\"\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_STACK_SOFT\n",
    "#define EXTC_RC_MARK_STACK_SOFT 8192   /* soft cap on the mark stack, in entries: above it a step **drains** instead of resuming a\n",
    "                                       * long-object cursor. The resumed segment pushes one chunk at most, so a cursor cannot\n",
    "                                       * grow the stack to the size of the reachable frontier (a 1M-child object grows it to 1M entries\n",
    "                                       * = 8 MB and pays the doubling realloc copy). The stack now stays at a few tens of KiB. */\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_BATCH_POP\n",
    "#define EXTC_RC_MARK_BATCH_POP 200  /* pop this many objects first, prefetch them together, then scan one by one (breaks the LIFO serial pointer chain);\n",
    "                                    * the batch width also **steers traversal order**: step boundaries move with it, so collects and peak RSS move too;\n",
    "                                    * the trade-off: wall clock / step total / peak RSS pull against each other */\n",
    "#endif\n",
    "#if EXTC_RC_MARK_BATCH_POP > EXTC_RC_MARK_BATCH_MAX\n",
    "#error \"EXTC_RC_MARK_BATCH_POP exceeds EXTC_RC_MARK_BATCH_MAX\"\n",
    "#endif\n",
    "static int extc_rc_wb;   /* gate screen: count of participants in an in-flight mark (>0 keeps it on). The write side uses __atomic_fetch_add/sub: with several threads each region begins/finishes separately, and a plain ++/-- drops updates (parallel workers did occasionally underflow and crash).\n",
    "                         * Kept a plain int: _Atomic turns every hot-path read of if (!extc_rc_wb ...) into a compiler barrier, costing 33.8M Ir more (+8.8%) for chase at -O2 under callgrind; a plain aligned word read is one load on x86,\n",
    "                         * so the gate is only an optimization (the real decision is the object's own region's marking); briefly reading a stale 0 costs at most one extra scan. */\n",
    "/* Count add/sub go through noinline cold functions: the lock prefix + memory barrier of __atomic_fetch_add\n",
    " * would make GCC treat extc_rc_wb as \"may change at any time\", forcing the hot path to reload on every if (!extc_rc_wb ...) --\n",
    " * owed_home shows +2.56M Ir (+1.76%) at -O2 callgrind. Wrapping them noinline moves the barrier\n",
    " * into the cold function: owed_home is back to 146.58M (still +1.1%, same source as the registry generation change). */\n",
    "__attribute__((unused, noinline)) static int extc_rc_wbAdd(int d) {\n",
    "    return __atomic_fetch_add(&extc_rc_wb, d, __ATOMIC_RELAXED);\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_finish(ExtcRcRegion *r);   /* the allocation path's finish needs it */\n",
    "static size_t extc_rc_markStep(ExtcRcRegion *r, size_t budget);\n",
    "/* Slice pause accounting: the cost of each `markStep` / `sweepStep` (active while `EXTC_RC_PAUSE=1`).\n",
    " * `max_us` has a **long tail** (preemption/scheduling makes two runs of the same build differ by several times), so a window criterion uses\n",
    " * **over-threshold step count / quantile proxy** (the threshold buckets below); `max` is reference only, or a fallback upper bound. */\n",
    "/* Per-microsecond histogram of resumed-segment step durations: a gate has to resolve count(>B_seg) at 0.1% precision, but B_seg (49.07 us on\n",
    " * pd_bigobj) falls between the 32 us and 64 us coarse bucket edges, so the coarse counters only bracket it over two decades. Only seg>0 steps\n",
    " * pay for it (a few 1e4 per run). `[segsteps]` prints the nonzero buckets from 16 us up as `us<n>=<count>`. */\n",
    "#ifndef EXTC_RC_SEG_FINE_US\n",
    "#define EXTC_RC_SEG_FINE_US 256\n",
    "#endif\n",
    "static long long extc_rc_stepMax, extc_rc_stepTotal, extc_rc_stepN;\n",
    "static long long extc_rc_stepGt10, extc_rc_stepGt50, extc_rc_stepGt64;   /* exact counts strictly above 10/50/64 us: those are the decision lines, and the log2 bucket edges fall elsewhere, so bucket sums can only bound them */\n",
    "static long long extc_rc_markColdN;   /* bounded steps whose budget the cold tier cut (live set past the cache) */\n",
    "#define EXTC_RC_STEP_NB 15   /* step duration buckets: upper edges 1/2/4/8/16/32/64/128/256/512 us, then 1/4/16/64 ms, and > 64 ms; a bucket name is its **upper bound** */\n",
    "static long long extc_rc_stepB[EXTC_RC_STEP_NB];\n",
    "static long long extc_rc_segN, extc_rc_segPops, extc_rc_segMax, extc_rc_segB[EXTC_RC_STEP_NB];   /* resumed-segment steps (seg>0): count, pops sum, max ns, same 15 duration buckets as [histo] */\n",
    "static long long extc_rc_segGt10, extc_rc_segGt50, extc_rc_segGt64;   /* same exact over-threshold counts for resumed-segment steps */\n",
    "static long long extc_rc_segFine[EXTC_RC_SEG_FINE_US + 1];   /* seg-step durations by whole microsecond; last bucket = overflow (>= 256 us) */\n",
    "static const char *const extc_rc_stepBNames[EXTC_RC_STEP_NB] = { \"b1us\", \"b2us\", \"b4us\", \"b8us\", \"b16us\", \"b32us\", \"b64us\", \"b128us\", \"b256us\", \"b512us\", \"b1ms\", \"b4ms\", \"b16ms\", \"b64ms\", \"bge64ms\" };\n",
    "static long long extc_rc_pauseNow(void);\n",
    "static long long extc_rc_cpuNow(void);\n",
    "static void extc_rc_pauseArm(void);   /* arming is lazy; regionFree/collect time themselves only after it ran */\n",
    "static int extc_rc_pauseOn;\n",
    "static int extc_rc_stepCpu;   /* EXTC_RC_STEP_CPU: time each step with the thread CPU clock (GC work, not scheduler noise) */\n",
    "static int extc_rc_cpuOk = -1;   /* CPU-clock probe: -1 = not probed, 1 = usable, 0 = unavailable (strict ISO C hides the POSIX clock ids) */\n",
    "static int extc_rc_cpuReq;        /* EXTC_RC_STEP_CPU was requested, for the [clock] line */\n",
    "__attribute__((unused)) static int extc_rc_cpuClock(void) {   /* 1 when the thread CPU clock can be used as a time source */\n",
    "    if (extc_rc_cpuOk < 0) extc_rc_cpuOk = extc_rc_cpuNow() >= 0 ? 1 : 0;\n",
    "    return extc_rc_cpuOk;\n",
    "}\n",
    "/* Per-step **work** (deterministic, independent of scheduling): objects walked / `rsbit` words scanned / seeds pushed.\n",
    " * Counts only **bounded hot-path steps**: `budget <= EXTC_RC_MARK_BATCH_MAX * EXTC_RC_SWEEP_PRESSURE_MUL` -- the pressure\n",
    " * multiplier is part of the admitted step size (it is the policy, not an unbounded drain), so those steps stay in this\n",
    " * population and are bounded by `walk_cap`; contract drains (budget=inf) are unlimited by design.\n",
    " * `walk_max/scan_max/push_max` plus the `>16/>64/>256` threshold buckets give the distribution; `walk_gtcap` counts steps\n",
    " * above the admitted cap (a bounded run keeps it at 0). */\n",
    "static long long extc_rc_wN, extc_rc_wWalkMax, extc_rc_wScanMax, extc_rc_wPushMax, extc_rc_wSegMax;\n",
    "static long long extc_rc_wWalkO16, extc_rc_wWalkO64, extc_rc_wWalkO256, extc_rc_wWalkGtCap;\n",
    "static long long extc_rc_wScanO16, extc_rc_wScanO64, extc_rc_wScanO256;\n",
    "static long long extc_rc_wPushO16, extc_rc_wPushO64, extc_rc_wPushO256;\n",
    "/* **Per-part attribution of the worst step** (`EXTC_RC_PAUSE=1`): records the entry/budget/counters of the step that took longest.\n",
    " * Purpose: decide whether the worst slice is \"walk/scan/push stacked\" or \"one part hitting its budget\"; `why` names the entry\n",
    " * (`step` hot path / `settle` settling / `collect` contract / `release` targeted release / `finish` finish /\n",
    " * `alloc` allocation point) -- an unbounded drain (budget=inf) appeared only as one timing line under `[step]`, hiding who triggered it. */\n",
    "__attribute__((unused)) static const char *extc_rc_why = \"?\";\n",
    "static long long extc_rc_worstNs, extc_rc_worstBudget, extc_rc_worstPops, extc_rc_worstMarked;\n",
    "static long long extc_rc_worstWords, extc_rc_worstPushes, extc_rc_worstSwWords, extc_rc_worstSwFreed;\n",
    "static long long extc_rc_worstSeg;   /* worst mark step: words walked by resumed large-object segments (0 for sweep steps) */\n",
    "static const char *extc_rc_worstWhy = \"-\";\n",
    "static const char *extc_rc_worstKind = \"-\";\n",
    "/* **Unbounded steps** (mark: budget > BATCH_MAX; sweep: drain path) are listed separately: they are not bounded by work, but must\n",
    " * be visible in `[work]`, otherwise \"unbounded\" reads as \"this step did no work\". */\n",
    "static long long extc_rc_wUbN, extc_rc_wUbWalkMax, extc_rc_wUbScanMax, extc_rc_wUbPushMax, extc_rc_wUbSegMax;\n",
    "static long long extc_rc_wUbSwN, extc_rc_wUbSwWordsMax, extc_rc_wUbSwFreedMax;\n",
    "/* Unbounded mark drains are counted by **entry**: `settle`/`collect`/`release`/other. The criterion asks\n",
    " * \"who triggered an unbounded drain inside a hot loop\", so the entry dimension matters more than the total. */\n",
    "static long long extc_rc_ubSettleN, extc_rc_ubCollectN, extc_rc_ubReleaseN, extc_rc_ubOtherN;\n",
    "/* Per-step **total** (walk+scan+push, the observed form of the unified budget) and the **assist share** (how much of this budget\n",
    " * the `wbDebt` debt boost took). `extc_rc_stepAssist` is written by the allocation/settle entries before calling `markStep`. */\n",
    "static long long extc_rc_wTotMax, extc_rc_wAssistMax;\n",
    "static long long extc_rc_slowUs = -1;   /* `EXTC_RC_SLOWSTEP=<us>`: log every slow step (-1 = not probed) */\n",
    "/* `EXTC_RC_SLOWSTEP_RING=1`: at a low threshold the one-line-per-step output is what makes the probe\n",
    " * unusable -- stderr I/O slows the run being timed and invalidates its own timing. In this mode slow-step\n",
    " * durations go into a fixed ring instead, and one distribution is printed at exit (bounded memory, no\n",
    " * per-step I/O). Without the variable the per-step lines are unchanged. */\n",
    "#define EXTC_RC_SLOW_RING 4096\n",
    "static long long extc_rc_slowRing[EXTC_RC_SLOW_RING];\n",
    "static long long extc_rc_slowRingN, extc_rc_slowRingOver;\n",
    "static int extc_rc_slowRingOn;\n",
    "static int extc_rc_slowCmp(const void *_a, const void *_b) {\n",
    "    long long _x = *(const long long *)_a, _y = *(const long long *)_b;\n",
    "    return (_x > _y) - (_x < _y);\n",
    "}\n",
    "/* **Mark stack high-water mark** (deterministic): `mscap` only grows, so a sample is the peak. When shading by `wbDebt` outpaces draining,\n",
    " * the stack grows without bound (`markPush`'s `realloc` runs inside `markStep`, so a \"bounded step\" of 16 objects can\n",
    " * spend 16 ms), so walk/scan/push alone would misjudge it as \"bounded\". This line is the criterion for that failure mode. */\n",
    "static long long extc_rc_mscapMax, extc_rc_mspMax;\n",
    "/* **Inline scan allowance** high-water mark (deterministic): the number of conservative words one bounded step scanned inline, always\n",
    " * <= EXTC_RC_SCAN_CHUNK. A shape with many large reference arrays scans one inline once per pop, so this count is what makes\n",
    " * the bound checkable without a clock. */\n",
    "static long long extc_rc_wConsMax;\n",
    "/* Step **pop / push** high-water marks over all bounded steps (hot and cold alike) and the pop total: the clock-free\n",
    " * form of the pause bound. pops is capped by EXTC_RC_MARK_STEP_POP_MAX (and by the cold batch); pushes are capped by\n",
    " * EXTC_RC_MARK_PUSH_STEP plus at most one batch of descriptor fan-out. pops_tot is the denominator of the de-noised\n",
    " * per-pop cost (total step time / total pops), which does not divide one host stall by the pop count of a small step. */\n",
    "static long long extc_rc_popMax, extc_rc_pushMax, extc_rc_popsTot;\n",
    "__attribute__((unused)) static size_t extc_rc_stepAssist;\n",
    "__attribute__((unused)) static inline void extc_rc_workNote(size_t walk, size_t scan, size_t push, size_t seg, size_t cons) {\n",
    "    extc_rc_wN++;\n",
    "    if ((long long)seg > extc_rc_wSegMax) extc_rc_wSegMax = (long long)seg;\n",
    "    if ((long long)walk > extc_rc_wWalkMax) extc_rc_wWalkMax = (long long)walk;\n",
    "    if ((long long)scan > extc_rc_wScanMax) extc_rc_wScanMax = (long long)scan;\n",
    "    if ((long long)push > extc_rc_wPushMax) extc_rc_wPushMax = (long long)push;\n",
    "    if ((long long)cons > extc_rc_wConsMax) extc_rc_wConsMax = (long long)cons;   /* deterministic: a count, not a time */\n",
    "    if ((long long)(walk + scan + push) > extc_rc_wTotMax) extc_rc_wTotMax = (long long)(walk + scan + push);\n",
    "    if ((long long)extc_rc_stepAssist > extc_rc_wAssistMax) extc_rc_wAssistMax = (long long)extc_rc_stepAssist;\n",
    "    if (walk > 16) extc_rc_wWalkO16++;\n",
    "    if (walk > 64) extc_rc_wWalkO64++;\n",
    "    if (walk > 256) extc_rc_wWalkO256++;\n",
    "    if ((long long)walk > (long long)EXTC_RC_MARK_BATCH_MAX * (long long)EXTC_RC_SWEEP_PRESSURE_MUL) extc_rc_wWalkGtCap++;\n",
    "    if (scan > 16) extc_rc_wScanO16++;\n",
    "    if (scan > 64) extc_rc_wScanO64++;\n",
    "    if (scan > 256) extc_rc_wScanO256++;\n",
    "    if (push > 16) extc_rc_wPushO16++;\n",
    "    if (push > 64) extc_rc_wPushO64++;\n",
    "    if (push > 256) extc_rc_wPushO256++;\n",
    "}\n",
    "static inline int extc_rc_stepBucket(long long d) {   /* ns -> bucket: bucket i means d <= edges[i]; 15 log2-spaced buckets resolve the 16-64 us range and the 1-64 ms tail */\n",
    "    static const long long edges[EXTC_RC_STEP_NB - 1] = {   /* bucket upper bounds in ns, strictly increasing; the last bucket is the > 64 ms overflow */\n",
    "        1000, 2000, 4000, 8000, 16000, 32000, 64000, 128000, 256000, 512000, 1000000, 4000000, 16000000, 64000000\n",
    "    };\n",
    "    int i = 0;\n",
    "    while (i < EXTC_RC_STEP_NB - 1 && d > edges[i]) i++;\n",
    "    return i;\n",
    "}\n",
    "static inline long long extc_rc_stepSumFrom(int from) {   /* number of steps in bucket from or above */\n",
    "    long long s = 0; int i;\n",
    "    for (i = from; i < EXTC_RC_STEP_NB; i++) s += extc_rc_stepB[i];\n",
    "    return s;\n",
    "}\n",
    "__attribute__((unused)) static inline void extc_rc_stepNote(long long d) {\n",
    "    extc_rc_stepTotal += d; extc_rc_stepN++;\n",
    "    if (d > extc_rc_stepMax) extc_rc_stepMax = d;\n",
    "    extc_rc_stepB[extc_rc_stepBucket(d)]++;\n",
    "    if (d > 10000) extc_rc_stepGt10++;\n",
    "    if (d > 50000) extc_rc_stepGt50++;\n",
    "    if (d > 64000) extc_rc_stepGt64++;\n",
    "}\n",
    "/* Independent duration histograms for the three coarse channels (`regionFree` / targeted `releaseOld` / the step taken at a trigger).\n",
    " * Each has its own buckets: the step histogram mixes mark/sweep hot-path slices, so the effect of the region-drop and\n",
    " * release budgets cannot be read off it. Channels use the same clock as steps (see extc_rc_chanClock): CPU time when EXTC_RC_STEP_CPU is on and the CPU clock exists, the wall clock otherwise. */\n",
    "#define EXTC_RC_CHAN_N 4\n",
