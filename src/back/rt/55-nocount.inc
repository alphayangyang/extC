    "/* ---- `EXTC_RC_NOCOUNT=1`: the counting entries become no-ops [rt:nocount] ----------------------\n",
    " *\n",
    " * Marking/sweeping **do not depend on counts** -- `extc_rc_mark` starts from root slots and registered cross-region seeds and descends via each slot's type\n",
    " * descriptor, `extc_rc_sweep` releases unmarked occupied slots; the only role of counting is \"reclaim as soon as the count hits zero\".\n",
    " * With counting off, garbage-dense shapes are still swept within a fixed number of rounds, peak memory does not grow and semantics are unchanged, while the hot path\n",
    " * loses a whole set of ever-increasing reference-count bookkeeping. **`EXTC_RC_NOCOUNT=1` is the default: the counting entries are compiled out entirely** --\n",
    " * reclamation relies on region sweeping alone; only `EXTC_RC_NOCOUNT=0` restores \"counting + early reclaim\". */\n",
    "#if EXTC_RC_NOCOUNT\n",
    "__attribute__((unused)) static void extc_rc_holdUpdSlab(ExtcRcSlab *s, void *p, int delta) {\n",
    "    (void)s; (void)p; (void)delta;\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_holdUpd(void *p, int delta) {\n",
    "    (void)p; (void)delta;\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_inc(void *p) { (void)p; }\n",
    "__attribute__((unused)) static void extc_rc_dec(void *p) { (void)p; }\n",
    "#else\n",
    "/* Holder count for an already-resolved slab: `extc_rc_holdUpd` without the \"find the slab\" step.\n",
    " * Obligations identical to `holdUpd` point by point (occupied bit, saturation sticks, reclaim on the spot when it hits zero). */\n",
    "__attribute__((unused)) static void extc_rc_holdUpdSlab(ExtcRcSlab *s, void *p, int delta) {\n",
    "    size_t i = extc_rc_slotOf(s, p);\n",
    "    if (!(s->occ[extc_rc_word(i)] & extc_rc_bit(i))) return;   /* free slot: not a live object */   /* skip:occ-free */\n",
    "    if (delta > 0) {\n",
    "        if (s->hold[i] != EXTC_RC_HOLD_SAT) s->hold[i]++;\n",
    "        return;\n",
    "    }\n",
    "    if (s->hold[i] == 0 || s->hold[i] == EXTC_RC_HOLD_SAT) return;   /* skip:hold-zero */\n",
    "    s->hold[i]--;\n",
    "    if (s->hold[i] == 0) extc_rc_freeSlotCascade(s, i);\n",
    "}\n",
    "\n",
    "/* Counting recognises **only rc slots allocated by this runtime that are still occupied**. Pointers from the board/pool/stack/C are not such slots and\n",
    " * are skipped entirely here -- that is the guard (when the origin of the pointer is unknown, not one byte is touched). */\n",
    "__attribute__((unused)) static void extc_rc_holdUpd(void *p, int delta) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    if (!s) return;   /* skip:not-own */\n",
    "    size_t i = extc_rc_slotOf(s, p);\n",
    "    if (!(s->occ[extc_rc_word(i)] & extc_rc_bit(i))) return;   /* free slot: not a live object */   /* skip:occ-free */\n",
    "    if (delta > 0) {\n",
    "        if (s->hold[i] != EXTC_RC_HOLD_SAT) s->hold[i]++;   /* obligation 3: stick at the ceiling */\n",
    "        return;\n",
    "    }\n",
    "    if (s->hold[i] == 0 || s->hold[i] == EXTC_RC_HOLD_SAT) return;  /* saturated value is never decremented */   /* skip:hold-zero */\n",
    "    s->hold[i]--;\n",
    "    if (s->hold[i] == 0) extc_rc_freeSlotCascade(s, i);     /* reclaim on the spot when it hits zero */\n",
    "}\n",
    "\n",
    "/* Counting hooks only pointer assignments: data-field stores do not go through these two. */\n",
    "__attribute__((unused)) static void extc_rc_inc(void *p) { extc_rc_holdUpd(p, +1); }\n",
    "__attribute__((unused)) static void extc_rc_dec(void *p) { extc_rc_holdUpd(p, -1); }\n",
    "#endif\n",
    "\n",
