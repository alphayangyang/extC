    "/* ---- Source-side bookkeeping entries for cross-region edges + counting statistics [rt:xentry] ----\n",
    " *\n",
    " * `owner` is **the object that holds this slot** (`a->f = v` passes `a`, `*p = v` passes `p`); for something that is not a slot of this\n",
    " * runtime (a local variable, a board/pool/stack pointer) it passes null and registration does not apply -- references there are covered by the trigger point's root table.\n",
    " * Only **cross-region** edges move counters: the same edge inside one region is reached by that region's own marking, so no seed is needed.\n",
    " * The statistic `rs_live = rsInc - rsDec` is the current number of live cross-region edges; with `EXTC_RC_STATS=1` one line is printed\n",
    " * at process exit, to show it does not grow without bound with the number of rounds. */\n",
    "static size_t extc_rc_pinN, extc_rc_pinCap;   /* [rt:pin] declared before the dump that reports them */\n",
    "__attribute__((unused)) static void extc_rc_statsDump(void) {\n",
    "    fprintf(stderr, \"extc_rc_stats rs_inc=%lld rs_dec=%lld rs_live=%lld rs_hwm=%lld\"\n",
    "                    \" releases=%lld release_slots=%lld\\n\",\n",
    "            (long long)extc_rc_rsIncN, (long long)extc_rc_rsDecN,\n",
    "            (long long)(extc_rc_rsIncN - extc_rc_rsDecN), (long long)extc_rc_rsHwm,\n",
    "            (long long)extc_rc_relN, (long long)extc_rc_relSlots);\n",
    "    fprintf(stderr, \"[pin] n=%zu cap=%zu\\n\", extc_rc_pinN, extc_rc_pinCap);\n",
    "    fprintf(stderr, \"[quota] deadline_us=%d hits_total=%lld hits_round=%lld\\n\", EXTC_RC_QUOTA_DEADLINE_US, extc_rc_quotaDeadlineHits, extc_rc_quotaHitsRound);\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_statsArm(void) {\n",
    "#if EXTC_RC_FOREIGN_GUARD\n",
    "    extc_rc_fgArm();\n",
    "#endif\n",
    "    static int armed;\n",
    "    if (armed) return;   /* skip:armed */\n",
    "    armed = 1;\n",
    "    if (getenv(\"EXTC_RC_STATS\")) atexit(extc_rc_statsDump);\n",
    "}\n",
    "\n",
    "/* Forced inline: with the cache lookup added, `-O1` decides **not** to inline this function (it becomes a 25.9 M Ir\n",
    " * separate function on its own and total instruction count grows 8% instead) -- it is the hot path of every assignment point and must be inlined; a bigger wrapper should not change that decision. */\n",
    "__attribute__((always_inline)) __attribute__((unused)) static inline void extc_rc_storeRefOwned(void **slot, void *v, void *owner) {\n",
    "    extc_rc_shade(v);\n",
    "    EXTC_RC_TICK(2);   /* per-component timing (`EXTC_RC_TIME=1`) */\n",
    "    extc_rc_shadeOld(slot);   /* delete barrier: local slots have no barrier, so the old edge must be shaded at the delete point */\n",
    "    if (slot) {\n",
    "        /* Look up the registration table once per distinct pointer: owner / old value / new value, one each; afterwards all bookkeeping goes through\n",
    "         * the `*Slab` variants. The three chains could look up the same pointers up to 7 times (once each + rsInc/rsDec\n",
    "         * + again inside inc/dec), and the lookup itself became the most expensive thing on the assignment path. */\n",
    "#if EXTC_RC_NOCOUNT\n",
    "        if (extc_rc_partN > 1) {\n",
    "            ExtcRcSlab *so   = owner ? extc_rc_ownSlab(owner) : (ExtcRcSlab *)0;\n",
    "            ExtcRcSlab *sv   = v     ? extc_rc_ownSlab(v)     : (ExtcRcSlab *)0;\n",
    "            if (so) {\n",
    "                ExtcRcRegion *r = so->region;\n",
    "                if (sv && sv->region != r) { extc_rc_rsIncSlab(sv, v, slot); r->foreign = 1; }   /* [rt:wmark] the source slot names the group */\n",
    "                if (r->foreign) { void *old = *slot; ExtcRcSlab *sold = old ? extc_rc_ownSlab(old) : (ExtcRcSlab *)0; if (sold && sold->region != r) extc_rc_rsDecSlab(sold, old); }\n",
    "#if EXTC_RC_FOREIGN_GUARD\n",
    "                if (!r->foreign) { void *old = *slot; if (old) { extc_rc_fgChecks++; { ExtcRcSlab *_gs = extc_rc_ownSlab(old); if (_gs && _gs->region != r) extc_rc_fgBad++; } } }\n",
    "#endif\n",
    "            }\n",
    "        }\n",
    "#else\n",
    "        ExtcRcSlab *so   = owner ? extc_rc_ownSlab(owner) : (ExtcRcSlab *)0;\n",
    "        void       *old  = *slot;                    /* must be read before the write */\n",
    "        ExtcRcSlab *sold = old ? extc_rc_ownSlab(old) : (ExtcRcSlab *)0;\n",
    "        ExtcRcSlab *sv   = v   ? extc_rc_ownSlab(v)   : (ExtcRcSlab *)0;\n",
    "        if (so) {\n",
    "            ExtcRcRegion *r = so->region;\n",
    "            if (sv && sv->region != r) { extc_rc_rsIncSlab(sv, v, slot); r->foreign = 1; }   /* [rt:wmark] the source slot names the group */\n",
    "            if (r->foreign && sold && sold->region != r) extc_rc_rsDecSlab(sold, old);\n",
    "        }\n",
    "#endif\n",
    "        *slot = v;\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "        /* When `sold`/`sv` is null this count has no effect (the first line of holdUpd is the same lookup). */\n",
    "        if (sv)   extc_rc_holdUpdSlab(sv, v, +1);\n",
    "        if (sold) extc_rc_holdUpdSlab(sold, old, -1);\n",
    "#endif\n",
    "        return;\n",
    "    }\n",
    "    /* NULL slot: there is no slot to update. */\n",
    "}\n",
    "\n",
        "/* ---- Slots whose host cannot be proven: pin the value itself as a root [rt:pin] ---------------------------------------\n",
    " *\n",
    " * The **host** of a view element (`v[0].kids[0] = r`) or of a pool buffer slot cannot be traced at compile time, but the value stored in the slot is\n",
    " * an rc object. The old scheme put the whole **target region** into noSweep (permanently out of sweeping, relying on count-to-zero). Instead, pin the value as\n",
    " * a root: during marking the pinned value is a seed and the target region is swept as usual; on overwrite the old value's pin is removed. Granularity therefore moves from\n",
    " * \"region\" down to \"pointed-to object\" -- garbage in the same region that no such slot points to is still collected.\n",
    " *\n",
    " * Structure: an **open-addressed hash table** (key = value pointer, load <= 1/2, deletion by Knuth backward shift). In a shape the pin table\n",
    " * can grow to hundreds of thousands of entries (one new object per view element), so a linear scan would make \"register n\" O(n^2); each entry\n",
    " * also stores an `rg` (computed once by ownSlab at registration), so round start / region death only compares region pointers, no per-entry lookup.\n",
    " *\n",
    " * Direction: only when pinning is impossible (allocation failure) fall back to noSweep -- better to collect less than to free live objects with an incomplete seed set.\n",
    " * Threads: the pin table is process-wide (a region may be swept by another worker), so insert/remove and round start take the lock; only the cold\n",
    " * unknown-host assignment path and the start of a whole mark round touch it, the hot paths (ordinary reference assignments, allocation) never look at it. */\n",
    "typedef struct ExtcRcPin { void *v; ExtcRcRegion *rg; size_t n; } ExtcRcPin;\n",
    "static ExtcRcPin *extc_rc_pins;\n",
    "/* pinN/pinCap are declared above the stats dump (they are counters, not part of the table's type). */\n",
    "static int    extc_rc_pinLock;\n",
    "static inline void extc_rc_pinLockAcq(void) {\n",
    "    while (__atomic_exchange_n(&extc_rc_pinLock, 1, __ATOMIC_ACQUIRE)) { }\n",
    "}\n",
    "static inline void extc_rc_pinUnlock(void) {\n",
    "    __atomic_store_n(&extc_rc_pinLock, 0, __ATOMIC_RELEASE);\n",
    "}\n",
    "static inline size_t extc_rc_pinHashOf(void *v) {\n",
    "    return (size_t)((((uintptr_t)v >> 3) * (uintptr_t)0x9E3779B97F4A7C15ull) >> 32);\n",
    "}\n",
    "/* Delete cell i: Knuth backward shift, keeping the probe chain intact (same method as the block registry). */\n",
    "static __attribute__((unused)) void extc_rc_pinEraseAt(size_t i) {\n",
    "    size_t cap = extc_rc_pinCap, mask = cap - 1, hole = i, j = i;\n",
    "    for (;;) {\n",
    "        j = (j + 1) & mask;   /* scan position advances independently; hole is the cell to fill */\n",
    "        if (!extc_rc_pins[j].v) break;\n",
    "        size_t k = extc_rc_pinHashOf(extc_rc_pins[j].v) & (cap - 1);\n",
    "        /* Only the probe chain matters: if k falls in (hole, j], moving it would break its probe chain */\n",
    "        int inRange = (hole <= j) ? (k > hole && k <= j) : (k > hole || k <= j);\n",
    "        if (!inRange) { extc_rc_pins[hole] = extc_rc_pins[j]; hole = j; }\n",
    "    }\n",
    "    extc_rc_pins[hole].v = (void *)0; extc_rc_pins[hole].rg = (ExtcRcRegion *)0;\n",
    "    extc_rc_pins[hole].n = 0; extc_rc_pinN--;\n",
    "}\n",
    "/* Double the capacity and rehash (returns 0 on failure; the caller falls back to noSweep). */\n",
    "static __attribute__((unused)) int extc_rc_pinGrow(void) {\n",
    "    size_t cap = extc_rc_pinCap ? extc_rc_pinCap * 2 : 128, mask = cap - 1;\n",
    "    ExtcRcPin *p = (ExtcRcPin *)calloc(cap, sizeof *p);\n",
    "    if (!p) return 0;   /* skip:pin-oom */\n",
    "    for (size_t i = 0; i < extc_rc_pinCap; i++) {\n",
    "        if (!extc_rc_pins[i].v) continue;\n",
    "        size_t h = extc_rc_pinHashOf(extc_rc_pins[i].v) & mask;\n",
    "        while (p[h].v) h = (h + 1) & mask;\n",
    "        p[h] = extc_rc_pins[i];\n",
    "    }\n",
    "    free(extc_rc_pins);\n",
    "    extc_rc_pins = p; extc_rc_pinCap = cap;\n",
    "    return 1;\n",
    "}\n",
    "/* Returns 0 = cannot pin (out of memory). The caller must fall back to the conservative direction. */\n",
    "__attribute__((unused)) static int extc_rc_pinAdd(void *v) {\n",
    "    if (!v || !extc_rc_owns(v)) return 1;   /* not a live slot of this runtime, so not a reference and nothing to pin */   /* skip:pin-not-obj */\n",
    "    extc_rc_pinLockAcq();\n",
    "    if ((extc_rc_pinN + 1) * 2 > extc_rc_pinCap && !extc_rc_pinGrow()) {\n",
    "        extc_rc_pinUnlock();\n",
    "        return 0;\n",
    "    }\n",
    "    size_t mask = extc_rc_pinCap - 1;\n",
    "    size_t h = extc_rc_pinHashOf(v) & mask;\n",
    "    while (extc_rc_pins[h].v && extc_rc_pins[h].v != v) h = (h + 1) & mask;\n",
    "    if (extc_rc_pins[h].v) {\n",
    "        extc_rc_pins[h].n++;\n",
    "    } else {\n",
    "        ExtcRcSlab *ps = extc_rc_ownSlab(v);\n",
    "        extc_rc_pins[h].v = v;\n",
    "        extc_rc_pins[h].rg = ps ? ps->region : (ExtcRcRegion *)0;\n",
    "        extc_rc_pins[h].n = 1;\n",
    "        extc_rc_pinN++;\n",
    "    }\n",
    "    extc_rc_pinUnlock();\n",
    "    return 1;\n",
    "}\n",
    "static __attribute__((unused)) void extc_rc_pinSub(void *v) {\n",
    "    if (!v) return;   /* skip:pin-null */\n",
    "    extc_rc_pinLockAcq();\n",
    "    if (extc_rc_pinN) {\n",
    "        size_t mask = extc_rc_pinCap - 1;\n",
    "        size_t h = extc_rc_pinHashOf(v) & mask;\n",
    "        while (extc_rc_pins[h].v && extc_rc_pins[h].v != v) h = (h + 1) & mask;\n",
    "        if (extc_rc_pins[h].v) {\n",
    "            if (extc_rc_pins[h].n > 1) extc_rc_pins[h].n--;\n",
    "            else extc_rc_pinEraseAt(h);\n",
    "        }\n",
    "    }\n",
    "    extc_rc_pinUnlock();\n",
    "}\n",
    "/* Region is dying: objects it owns need no pinning (leaving the entries would only make marking walk dead values). */\n",
    "static __attribute__((unused)) void extc_rc_pinDropRegion(ExtcRcRegion *r) {\n",
    "    if (__atomic_load_n(&extc_rc_pinN, __ATOMIC_ACQUIRE) == 0) return;   /* skip:pin-empty */\n",
    "    extc_rc_pinLockAcq();\n",
    "    size_t i = 0;\n",
    "    while (i < extc_rc_pinCap) {\n",
    "        if (!extc_rc_pins[i].v) { i++; continue; }   /* skip:pin-hole */\n",
    "        if (extc_rc_pins[i].rg == r) { extc_rc_pinEraseAt(i); continue; }   /* skip:pin-dead */\n",
    "        i++;\n",
    "    }\n",
    "    extc_rc_pinUnlock();\n",
    "}\n",
    "/* Round start: pinned values are **roots** -- they are references stored in other slots, only the slots themselves are not in an rc slab.\n",
    " * Push only objects of this region; objects of other regions are handled by their own round. */\n",
    "/* An empty table is **the common case** (the vast majority of programs have no host-less slot at all): this line reads pinN once atomically and returns.\n",
     " * Why not inline it into markBegin: inline makes markBegin longer, and GCC's inlining and scheduling of the whole mark/allocation chain change\n",
     " * with it -- owed_home pays +2 Ir per allocation (145,022,121 -> 147,581,549, +1.76%),\n",
     " * while the pin table is **never used** in that shape. With noinline it returns to the baseline bit for bit (145,022,214). */\n",
     "static __attribute__((unused)) __attribute__((noinline)) void extc_rc_pinSeed(ExtcRcRegion *r) {\n",
    "    if (__atomic_load_n(&extc_rc_pinN, __ATOMIC_ACQUIRE) == 0) return;   /* skip:pin-empty */\n",
    "    extc_rc_pinLockAcq();\n",
    "    for (size_t i = 0; i < extc_rc_pinCap; i++) {\n",
    "        if (!extc_rc_pins[i].v) continue;   /* skip:pin-hole */\n",
    "        if (extc_rc_pins[i].rg == r) extc_rc_markPush(r, extc_rc_pins[i].v);\n",
    "    }\n",
    "    extc_rc_pinUnlock();\n",
    "}\n",
"/* Reference assignment whose host cannot be proven (`f()->f = v`, view element `a[i] = v`, ...): the registration site is unknown (the source object\n",
    " * is not known), and the static root table has no such slot either. Pin the value as a root (see above); only when pinning fails, make **the region the target lives in**\n",
    " * leave sweeping entirely: better to collect less than to free objects that are still pointed to while the seed set is incomplete. */\n",
    "__attribute__((unused)) static void extc_rc_storeRefUnknown(void **slot, void *v) {\n",
    "    if (!slot) return;   /* skip:slot-null: no slot to update */\n",
    "    extc_rc_shade(v);\n",
    "    void *old = *slot;\n",
    "    if (old) extc_rc_pinSub(old);   /* overwrite deletes the old edge: no slot points at the old value any more */\n",
    "    if (!extc_rc_pinAdd(v)) {\n",
    "        ExtcRcRegion *r = extc_rc_regionOfOwn(v);\n",
    "        if (r) r->noSweep = 1;\n",
    "    }\n",
    "    extc_rc_storeRef(slot, v);\n",
    "}\n",
    "\n",
    "/* Slot-address reverse lookup: which registered rc slab's data area contains this **arbitrary byte address**.\n",
    " *\n",
    " * ownSlab only accepts a slot start (it answers \"is this some object's slot\", verifying `k * ss == off`); when the host expression\n",
    " * cannot be proven (`(*id(s)).kids[0] = v`) the question is the weaker \"which region owns this memory\" --\n",
    " * a slab's data area belongs entirely to one region, so no slot start is needed. Huge blocks (payload not in an aligned block) cannot be located by mask\n",
    " * so return 0 and let the caller fall back to the conservative path. */\n",
    "__attribute__((unused)) static ExtcRcSlab *extc_rc_slabOfInterior(void *p) {\n",
    "    void *base = (void *)((uintptr_t)p & ~(uintptr_t)(EXTC_RC_SLAB_SIZE - 1));\n",
    "    ExtcRcSlab *s = extc_rc_ownHot;\n",
    "    if (s && (void *)s != base) s = (ExtcRcSlab *)0;\n",
    "    if (!s) {\n",
    "        s = extc_rc_ownMap[extc_rc_ownHashOf(base)];\n",
    "        if (!s || (void *)s != base) {\n",
    "            s = extc_rc_ownProbeFast(base, 0);\n",
    "        }\n",
    "    }\n",
    "    if (s && extc_rc_offOf(s, p) < (size_t)s->nslots * s->ss) return s;   /* skip:host-slab-mask */\n",
    "    /* [rt:extent-own] The payload of a huge block is a carved range, not inside an aligned block, so the mask above cannot name it.\n",
    "     * The extent arena can: it records the block per quantum, so any address inside the payload resolves to its region. */\n",
    "    s = extc_rc_extLookup(p);\n",
    "    if (s && extc_rc_offOf(s, p) < (size_t)s->nslots * s->ss) return s;   /* skip:host-slab-ext */\n",
    "    return (ExtcRcSlab *)0;   /* skip:host-slab */\n",
    "}\n",
    "\n",
    "/* The host expression cannot be proven, but **the slot address itself** falls inside an rc slot (`(*id(s)).kids[0] = v`): the slab the slot\n",
    " * belongs to tells us the region that holds it, so this edge is bookkept as \"host known\" as usual (cross-region registration, old-value undo),\n",
    " * without making the target region leave sweeping entirely. Only when the slot is not in an rc slab either (view data, C/pool buffers) does it fall back\n",
    " * to the conservative direction of `storeRefUnknown`. Cost is the same order as the fallback path: that path looks up `ownSlab` anyway. */\n",
    "__attribute__((unused)) static inline void extc_rc_storeRefSlot(void **slot, void *v) {\n",
    "    if (!slot) return;   /* skip:slot-null: no slot to update */\n",
    "    ExtcRcSlab *ss = (slot ? extc_rc_slabOfInterior((void *)slot) : (ExtcRcSlab *)0);\n",
    "    if (ss && ss->region) { extc_rc_storeRefOwnedReg(slot, v, ss->region); return; }\n",
    "    extc_rc_storeRefUnknown(slot, v);\n",
    "}\n",
    "\n",
    "/* Entry for bookkeeping of whole-value stores (struct / fixed-size array **copied by value**) that carry reference leaves, when the leaves **cannot be enumerated**\n",
    " * (an enumerated payload, a generic argument carrying references): the whole block is already copied, so here every word in the target that \"is a live slot\"\n",
    " * is treated as a candidate reference -- **increment only, never decrement** + register cross-region edges (when the host is unprovable, instead let those target regions leave\n",
    " * sweeping). The direction matches the marking of `EXTC_RC_CONSERVATIVE`: misreading one word must cost \"keep it longer\",\n",
    " * never \"count one fewer reference\" (one fewer means freeing early). The old value is therefore not decremented -- better reclaimed late.\n",
    " *\n",
    " * Enumerable whole-value stores do not come here: codegen emits `initRef` / `storeRefOwned` /\n",
    " * `storeRefUnknown` per leaf, the same path as a direct reference-slot assignment (decrement the old, increment the new). */\n",
    "__attribute__((unused)) static void extc_rc_storeStructCons(void *dst, size_t size,\n",
    "                                                            void *owner, int hostKnown) {\n",
    "    ExtcRcRegion *r = hostKnown ? extc_rc_regionOfOwn(owner) : (ExtcRcRegion *)0;\n",
    "    extc_rc_notePart(r);   /* this path also registers cross-region edges, so the host must be counted in the participating-region number\n",
    "                            * (rule R1 of `tools/check_note_part.py` guards exactly this) */\n",
    "    size_t words = size / sizeof(void *);\n",
    "    for (size_t i = 0; i < words; i++) {\n",
    "        void *nw = ((void **)dst)[i];\n",
    "        extc_rc_shade(nw);   /* a struct copy also writes references: shade leaf by leaf, otherwise incremental marking misses them */\n",
    "        if (!extc_rc_owns(nw)) continue;          /* not a live slot of this runtime, so not a reference */\n",
    "        ExtcRcRegion *rv = extc_rc_regionOfOwn(nw);\n",
    "        /* Guard aligned word for word with storeRefOwned / storeRefUnknown: register only when the host **really proves a region**\n",
    "         * (`r == 0` = local/static slot, a registration bit there could never be undone; the root table is its seed); when unprovable, make the target region\n",
    "         * leave sweeping. Without the `r` test, a conservative store into a local would leave a registration bit that is never undone. */\n",
    "        if (hostKnown) { if (r && rv && rv != r) { extc_rc_rsInc(nw); r->foreign = 1; r->wmUnsafe = 1; } }   /* [rt:wmark] layout copy: no owning slot */\n",
    "        else if (rv) rv->noSweep = 1;\n",
    "        extc_rc_inc(nw);\n",
    "    }\n",
    "}\n",
    "/* Entry for a whole-value copy into a struct whose base address is provable rc storage (d.data is an interior pointer of the host slot,\n",

    " * found by slabOfInterior): the host region is known, so this takes the host-known direction -- every reference word is shaded and, when it\n",

    " * targets another region, registered as a cross-region edge (rsbit + foreign). Unlike the conservative entry it never sets noSweep: the host\n",

    " * is provable, so the target regions stay sweepable. It is still inc-only (overwritten old values are not decremented): conservative direction,\n",

    " * keep too much rather than too little. A base outside rc storage (a stack or pool view) falls back to storeStructCons with hostKnown = 0. */\n",

    "__attribute__((unused)) static void extc_rc_storeStructCopy(void *dst, size_t size, void *base) {\n",

    "    ExtcRcSlab *bs = base ? extc_rc_slabOfInterior(base) : (ExtcRcSlab *)0;\n",

    "    ExtcRcRegion *r = (bs && bs->region) ? bs->region : (ExtcRcRegion *)0;\n",

    "    extc_rc_notePart(r);\n",

    "    if (!r) { extc_rc_storeStructCons(dst, size, (void *)0, 0); return; }   /* base outside rc storage: old conservative direction */\n",

    "    size_t words = size / sizeof(void *);\n",

    "    for (size_t i = 0; i < words; i++) {\n",

    "        void *nw = ((void **)dst)[i];\n",

    "        extc_rc_shade(nw);\n",

    "        if (!extc_rc_owns(nw)) continue;\n",

    "        ExtcRcRegion *rv = extc_rc_regionOfOwn(nw);\n",

    "        if (rv && rv != r) { extc_rc_rsInc(nw); r->foreign = 1; r->wmUnsafe = 1; }   /* [rt:wmark] layout copy: no owning slot */\n",

    "        extc_rc_inc(nw);\n",

    "    }\n",

    "}\n",

    "\n",
    "/* Entry for a whole-value store into a **local variable registered in the root table** (`var m: maybe = ...`): the leaves cannot be enumerated\n",
    " * (an enumerated payload), but their references are all in this value's own words. Treat each word as a candidate reference and increment only -- the only difference from\n",
    " * `extc_rc_storeStructCons`'s `hostKnown = 0` path is that the target region is **not** made to leave\n",
    " * sweeping: the caller has already registered this value's reference leaves as roots, statically expanded for **every** enum variant (the TY_ENUM branch\n",
    " * of `rcRootLeaves`), so the references are claimed by both \"counting\" and \"root-table seeds\" and the region is swept as usual.\n",
    " *\n",
    " * No cross-region edges registered: the host is a local on the stack, with no registration bit to undo; cross-region reachability is covered by the root-table seed\n",
    " * (the same reason as the conservative side of `extc_rc_storeStructCons`). */\n",
    "__attribute__((unused)) static void extc_rc_storeStructRooted(void *dst, size_t size) {\n",
    "    size_t words = size / sizeof(void *);\n",
    "    for (size_t i = 0; i < words; i++) {\n",
    "        void *nw = ((void **)dst)[i];\n",
    "        extc_rc_shade(nw);   /* a struct copy also writes references: shade leaf by leaf, otherwise incremental marking misses them */\n",
    "        if (!extc_rc_owns(nw)) continue;          /* not a live slot of this runtime, so not a reference */\n",
    "        extc_rc_inc(nw);\n",
    "    }\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static uint16_t extc_rc_hold(void *p) {\n",
    "#if EXTC_RC_NOCOUNT\n",
    "    (void)p;\n",
    "    return 0;   /* no-count tier: the `hold` array does not exist (nothing allocates it since the sixteenth cut) */\n",
    "#else\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    if (!s) return 0;   /* skip:not-own */\n",
    "    size_t i = extc_rc_slotOf(s, p);\n",
    "    if (!(s->occ[extc_rc_word(i)] & extc_rc_bit(i))) return 0;   /* skip:occ-free */\n",
    "    return s->hold[i];\n",
    "#endif\n",
    "}\n",
    "\n",
    "/* Read-only accessor for the cross-region in-edge count (`rscnt`): the criterion uses it to check the \"sticks at the ceiling\" guard --\n",
    " * a count wrapping to 0 would make \"there are still live in-edges\" false, and the target could be swept while it still has in-edges. */\n",
    "__attribute__((unused)) static uint16_t extc_rc_rsCount(void *p) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    if (!s) return 0;   /* skip:not-own */\n",
    "    size_t i = extc_rc_slotOf(s, p);\n",
    "    if (!(s->occ[extc_rc_word(i)] & extc_rc_bit(i))) return 0;   /* skip:occ-free */\n",
    "    if (!s->rscnt) return 0;   /* skip:rscnt-none */\n",
    "    return s->rscnt[i];\n",
    "}\n",
    "\n",
    "/* Cross-region registration: set a bit in the **target slot's** registration bitmap. Dedup means repeated registration costs nothing;\n",
    " * the bit is cleared by extc_rc_freeSlot when the slot is released, so no stale entry (obligations 2, 5). */\n",
    "__attribute__((unused)) static void extc_rc_register(void *p) {\n",
    "    if (!extc_rc_owns(p)) return;    /* not a live slot of this runtime, so registration does not apply */   /* skip:not-own */\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    size_t i = extc_rc_slotOf(s, p);\n",
    "    if (s->rsbit[extc_rc_word(i)] & extc_rc_bit(i)) return;   /* skip:reg-dup */\n",
    "    s->rsbit[extc_rc_word(i)] |= extc_rc_bit(i); s->region->seedAny = 1;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static int extc_rc_isRegistered(void *p) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    if (!s) return 0;   /* skip:not-own */\n",
    "    size_t i = extc_rc_slotOf(s, p);\n",
    "    return (s->rsbit[extc_rc_word(i)] >> (i & 63)) & 1;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static int extc_rc_isLive(void *p) {\n",
    "    return extc_rc_owns(p);\n",
    "}\n",
    "\n",
    "/* Resolution region: bump allocation, O(1); reset moves the pointer back and returns the whole span. A bump object is not a slab slot,\n",
    " * so it cannot enter inc/dec/register and does not count toward region occupied bytes (the span goes back on reset). */\n",
    "__attribute__((unused)) static void *extc_rc_bump(ExtcRcRegion *r, size_t n) {\n",
    "    /* `notePart` is **not** recorded here: bump slots never set the occupied bit, and `rsIncSlab`/`rsDecSlab` always\n",
    "     * return early for them, so per-slot registration does not apply to bump objects anyway (their reclamation is a whole-span reset). Since registration\n",
    "     * can never happen on a bump slot, the gate skipping it for them is equivalent -- recording it would only disable the fast path for nothing. */\n",    "    size_t ss = extc_rc_slotSize(n);\n",
    "    if (!r->bump || (size_t)(r->bump_end - r->bump) < ss) {\n",
    "        ExtcRcSlab *s = extc_rc_slabNew(r, ss);\n",
    "        s->prev = (ExtcRcSlab *)0; if (r->slabs) r->slabs->prev = s; s->next = r->slabs;\n",
    "        r->slabs = s;\n",
    "        r->bumpSlab = s;\n",
    "        r->bump = EXTC_RC_SLAB_DATA(s);\n",
    "        r->bump_end = r->bump + (size_t)s->nslots * s->ss;\n",
    "    }\n",
    "    void *p = r->bump;\n",
    "    r->bump += ss;\n",
    "    memset(p, 0, ss);\n",
    "    return p;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_bumpReset(ExtcRcRegion *r) {\n",
    "    if (!r->bumpSlab) return;   /* skip:no-bumpslab */\n",
    "    r->bump = EXTC_RC_SLAB_DATA(r->bumpSlab);\n",
    "    r->bump_end = r->bump + (size_t)r->bumpSlab->nslots * r->bumpSlab->ss;\n",
    "}\n",
    "\n",
    "/* Region: the type descriptor goes to the runtime with the slot, so here only a number is claimed. */\n",
    "static void extc_rc_thrUpd(ExtcRcRegion *r);   /* threshold recompute: defined in the shouldSweep section */\n",
    "__attribute__((unused)) static ExtcRcRegion *extc_rc_regionNew(int32_t rid) {\n",
    "    EXTC_RC_TICK(6);   /* per-component timing (`EXTC_RC_TIME=1`) */\n",
    "    ExtcRcRegion *r = (ExtcRcRegion *)calloc(1, sizeof(ExtcRcRegion));\n",
    "    if (!r) extc_rc_oops(\"region allocation failed\");\n",
    "    r->rid = rid;\n",
    "    r->floor = EXTC_RC_FLOOR;\n",
    "    extc_rc_thrUpd(r);\n",
    "    extc_rc_statsArm();   /* with EXTC_RC_STATS=1 print cross-region registration statistics at process exit */\n",
    "    return r;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_regionFloor(ExtcRcRegion *r, int64_t bytes) {\n",
    "    r->floor = bytes > 0 ? bytes : 1;\n",
    "    extc_rc_thrUpd(r);\n",
    "}\n",
    "\n",
    "/* One O(live set) traversal (region sweep **or** targeted release on overwrite) must be paid for by \"new allocations since the last traversal\".\n",
    " * Without this, targeted release means \"one reference assignment costs one full live-set mark\", so N assignments = O(N^2).\n",
    " * Sweeping already satisfies it (the trigger line `thr = max(2*live, floor)*scale >= need`), the only breach is release.\n",
    " * `live` is the live bytes after the previous sweep; when a region has never been swept live = 0, and the lower bound `floor` takes over.\n",
    " * Failure direction: with too little credit, collect **less** (garbage lingers, memory grows), never a dangling pointer. */\n",
    "__attribute__((unused)) static int extc_rc_budgetOk(const ExtcRcRegion *r) {\n",
    "    int64_t need = r->live > r->floor ? r->live : r->floor;\n",
    "    return r->allocBytes - r->visitedBytes >= need;\n",
    "}\n",
    "\n",
    "/** @brief When a region is dying, **cancel** the round in flight (mark + sweep), do not drain.\n",
    " *\n",
    " * Why cancellation is allowed: `regionFree` frees all of this region's slabs right afterwards, so\n",
    " * every object in the region **has ceased to exist** and \"finished marking / finished sweeping\" changes no observable fact:\n",
    " *   - `mstk` is a **work list**, not a root: its entries (including objects of other regions) hold no ownership,\n",
    " *     they can vanish with `free(r->mstk)`; other regions' mark stacks are unaffected.\n",
    " *   - mark bits and the sweep cursor live in this region's slabs and are freed with them.\n",
    " *   - cross-region registrations (`rsbit`/`rscnt`) are undone via `occ` + `unlinkChildren`, which **do not read mark bits**, so\n",
    " *     cancelling marking does not affect the bulk undo below.\n",
    " *   - the accounts (`sweeps`/`freedSlots`/`live`) have only this region as reader, and `r` is freed right after.\n",
    " * The one thing that must be preserved is the **global barrier participant count** `extc_rc_wb` (R3): it is +1 in `extc_rc_begin` and\n",
    " * -1 by `extc_rc_finish` when leaving marking. Cancelling must -1 too, otherwise the barrier (`shade`'s first branch)\n",
    " * stays open forever, so every later assignment pays one more `ownSlab` lookup. The direction is **performance**, not safety, but it is a real\n",
    " * invariant, so this function's **paired self-check** guards it: `r->marking` true means this region contributed a +1,\n",
    " * so the **old value** of the atomic decrement must be >= 1: the old value is the count seen before decrementing, 0 means no +1 was contributed or the update was lost (underflow).\n",
    " * Note the criterion **cannot** be \"wb == 0 on exit\": a program need not `regionDrop` (digraph has no drop point,\n",
    " * regions go back to the OS when the process ends), and then wb > 0 is legal -- the invariant is **pairing**, not zero. */\n",
    "__attribute__((unused)) static void extc_rc_abort(ExtcRcRegion *r) {\n",
    "    if (r->marking) {\n",
    "        int _wb0;\n",
    "        r->marking = 0;\n",
    "        r->markDone = 0;\n",
    "        _wb0 = extc_rc_wbAdd(-1);\n",
    "        if (_wb0 < 1) extc_rc_oops(\"R4: barrier participant underflow on region drop\");\n",
    "    }\n",
    "    r->sweeping = 0;   /* the sweep cursor vanishes with the slabs */\n",
    "}\n",
    "/* Cost probe for one drop: free() calls and slab count of the worst single regionFree (only while EXTC_RC_PAUSE is on).\n",
    " * Bounded by construction: 9 frees per normal slab (occ/mark/rsbit/hold/rscnt/tid/ttab/thash/slab), 10 for a huge block\n",
    " * (+ its separately malloc'd payload), one per ExtcRcClass, plus 2 for mstk and the region (3 in the counted tier: cstk).\n",
    " * So one call issues at most #free <= 10 * #slabs + #classes + 3; it is O(#slabs), and the probe reports the exact count.\n",
    " *\n",
    " * This is a **synchronous bulk free**, not a reclamation round: it does not walk the live-object graph (abort only cancels the round in flight\n",
    " * and leaves the slots to the free()), so its cost is free() count x per-free cost, not O(live set). The free()-count bound is not a **time**\n",
    " * bound: freeing a huge block's payload unmaps its pages, so page-table teardown dominates (on an 8 MiB payload, about 17 us per free).\n",
    " * A drop is bounded per call by the formula above but can still be a long pause at frame exit; the channel histogram in [chan] regionfree\n",
    " * reports it separately from the collect/release channels. */\n",
    "static long long extc_rc_rfN, extc_rc_rfFreesMax, extc_rc_rfSlabsMax;\n",
    "__attribute__((unused)) static void extc_rc_regionFree(ExtcRcRegion *r) {\n",
    "    long long _frees = 0, _slabs = 0;   /* exact free() calls of this drop, see the bound above */\n",
    "    long long _syncus = 0;   /* time before the queue drain (deferred mode) / before the channel note (sync mode) */\n",
    "    if (!r) return;   /* skip:no-region */\n",
    "    extc_rc_pauseArm();\n",
    "    long long _c0 = extc_rc_pauseOn > 0 ? extc_rc_chanClock() : 0;   /* regionFree channel: one bounded bulk free, no live-graph scan */\n",
    "    extc_rc_shadeNextGen();   /* slab payload goes back to malloc: the address may be reused by another object, so black records are void */\n",
    "    /* R3: a **run-time guard** on the participating-region number (cold path; one predictable branch while `part` is true).\n",
    "     * `part == 0` yet there are still occupied slots means some path that \"hands out an rc slot\" did not record participation, and the single-region\n",
    "     * fast path would be wrongly disabled while cross-region in-edges exist; the failure direction is **unsafe**. Slots can only come from\n",
    "     * `extc_rc_alloc`, so this guard has the same source as static rule R2 (see check_note_part.py). */\n",
    "#if !EXTC_RC_FREE_DEFER   /* sync build only: deferred mode runs the same check per slab in cqDrainCore, inside the budget */\n",
    "    if (!r->part) {\n",
    "        ExtcRcSlab *q = r->slabs;\n",
    "        while (q) {\n",
    "            for (size_t _w = 0; _w < q->nwords; _w++)\n",
    "                if (q->occ[_w]) extc_rc_oops(\"R3: occupied slot in a region with part == 0\");\n",
    "            q = q->next;\n",
    "        }\n",
    "    }\n",
    "#endif   /* !EXTC_RC_FREE_DEFER */\n",
    "    extc_rc_abort(r);   /* region is dying: cancel the round in flight, do not drain (see extc_rc_abort) */\n",
    "    extc_rc_pinDropRegion(r);   /* region is dying: objects of it in the pin table are not needed */\n",
    "#if EXTC_RC_FREE_DEFER\n",
    "    /* O(1) drop (closing queue): mark the region dead and queue it. dead is what keeps the semantics identical while the work is\n",
    "     * deferred -- owns() answers 0 at once, so a slot of this region cannot be registered, marked or counted again, and the payload\n",
    "     * stays owned by this thread's queue until the drain reaches it (nothing reads it after the free).\n",
    "     * The per-drop free() bound is now: this call issues *no* slab free at all; the drain issues at most one budget per step. */\n",
    "    r->dead = 1;\n",
    "    r->cqNext = 0;\n",
    "    if (extc_rc_cqTail) extc_rc_cqTail->cqNext = r; else extc_rc_cqHead = r;\n",
    "    extc_rc_cqTail = r;\n",
    "    extc_rc_cqN++;\n",
    "    if (extc_rc_pauseOn > 0) { _syncus = extc_rc_chanClock() - _c0; if (_syncus > extc_rc_rfSyncMax) extc_rc_rfSyncMax = _syncus; }\n",
    "    /* Keep the backlog bounded: past EXTC_RC_CQ_MAX_REGIONS pending drops, take one bounded step here (not the old unbounded loop). */\n",
    "    if (extc_rc_cqN > EXTC_RC_CQ_MAX_REGIONS)\n",
    "        extc_rc_cqDrainCore(EXTC_RC_FREE_BUDGET_SLABS, EXTC_RC_FREE_DEADLINE_US);\n",
    "#else\n",
    "    ExtcRcSlab *s = r->slabs;\n",
    "    while (s) {\n",
    "        ExtcRcSlab *n = s->next;\n",
    "        _slabs++;\n",
    "#if !EXTC_RC_FREE_DEFER\n",
    "        _frees += 9 + (s->big ? 1 : 0);   /* the 9 metadata frees below, +1 for a huge block's payload */\n",
    "#endif\n",
    "        /* Bulk undo of the cross-region edges held by objects still alive in the region: the bits do not stick, so the next sweep\n",
    "         * of another region will not keep these targets as seeds. Slots already dead in the count (occ=0) are skipped.\n",
    "         *\n",
    "         * `extc_rc_rsIncN == 0` means **no cross-region registration ever happened** in this process, so there are no edges to undo and\n",
    "         * the whole walk is busywork (on a pure read-traversal shape this is a fixed per-object cost). */\n",
    "        if (extc_rc_rsIncN) for (uint32_t w = 0; w < s->nwords; w++) {\n",
    "            uint64_t bits = s->occ[w];\n",
    "            while (bits) {\n",
    "                uint32_t b = (uint32_t)__builtin_ctzll(bits);\n",
    "                bits &= bits - 1;\n",
    "                extc_rc_unlinkChildren(s, (size_t)w * 64 + b);\n",
    "            }\n",
    "        }\n",
    "        extc_rc_ownDel(s);   /* take it out of the registry first: this memory is about to stop being a slab */\n",
    "#if !EXTC_RC_FREE_DEFER\n",
    "        free(s->occ); free(s->mark); free(s->rsbit); free(s->hold); free(s->rscnt); free(s->wmark);\n",
    "        free(s->tid); free(s->ttab); free(s->thash);\n",
    "        if (s->big) extc_rc_bigPayloadRelease(s->data, s->ss);   /* a huge block's payload is a separate allocation, returned along with the region drop */\n",
    "        free(s);\n",
    "#endif\n",
    "        s = n;\n",
    "    }\n",
    "#endif   /* EXTC_RC_FREE_DEFER: the per-slab work is on the closing queue */\n",
    "#if !EXTC_RC_FREE_DEFER\n",
    "    for (uint32_t b = 0; b < EXTC_RC_CLS_BUCKETS; b++) {\n",
    "        while (r->clsBkt[b]) {\n",
    "            ExtcRcClass *c = r->clsBkt[b];\n",
    "            r->clsBkt[b] = c->next;\n",
    "            free(c);\n",
    "            _frees++;\n",
    "        }\n",
    "    }\n",
    "    free(r->mstk);\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "    free(r->cstk);\n",
    "    _frees++;\n",
    "#endif\n",
    "    free(r);\n",
    "    _frees += 2;   /* mstk + region */\n",
    "#endif   /* !EXTC_RC_FREE_DEFER */\n",
    "    extc_rc_rfSyncFrees = _frees;   /* synchronous free() calls of this drop: a queued slab is not in it */\n",
    "    extc_rc_rfSyncSlabs = _slabs;\n",
    "    if (extc_rc_pauseOn > 0) {\n",
    "        extc_rc_rfN++;\n",
    "        if (_frees > extc_rc_rfFreesMax) extc_rc_rfFreesMax = _frees;\n",
    "        if (_slabs > extc_rc_rfSlabsMax) extc_rc_rfSlabsMax = _slabs;\n",
    "        extc_rc_chanNote(0, extc_rc_chanClock() - _c0, _frees);\n",
    "    }\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_markPush(ExtcRcRegion *r, void *o) {\n",
    "    if (r->msp == r->mscap) {\n",
    "        size_t want = r->mscap ? r->mscap * 2 : 1024;\n",
    "        void **grown = (void **)realloc(r->mstk, want * sizeof(void *));\n",
    "        if (!grown) extc_rc_oops(\"mark stack allocation failed\");\n",
    "        r->mstk = grown;\n",
    "        r->mscap = want;\n",
    "    }\n",
    "    r->mstk[r->msp++] = o;\n",
    "}\n",
    "/* Push fast path: when `mstk` still has room, push directly (removes \"capacity check + call\" from every child object). */\n",
    "__attribute__((unused)) static inline void extc_rc_markPushFast(ExtcRcRegion *r, void *o) {\n",
    "    __builtin_prefetch(o, 0, 1);\n",
    "    if (r->msp < r->mscap) r->mstk[r->msp++] = o;\n",
    "    else extc_rc_markPush(r, o);\n",
    "}\n",
    "/* Forced push: set the low bit. The pop side (`markStep`) sees the low bit and skips the \"already marked so continue\" dedup,\n",
    " * so **an object shaded by the barrier is also scanned once**, and its white children are not missed; the push volume is unchanged, so\n",
    " * `wbDebt` and the shade dedup semantics are unchanged word for word from good-17. */\n",
    "__attribute__((unused)) static void extc_rc_markPushForce(ExtcRcRegion *r, void *o) {\n",
    "    extc_rc_markPush(r, (void *)((uintptr_t)o | (uintptr_t)1));\n",
    "}\n",
    "\n",
