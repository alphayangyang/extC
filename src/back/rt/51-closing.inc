    "/* ---- Closing queue: O(1) region drop (EXTC_RC_FREE_DEFER) ----\n",
    " * The old extc_rc_regionFree walked every slab of the dropping region in one call: undo its cross-region edges, remove it from the\n",
    " * ownership registry, hand it to the free queue -- 24,510 slabs ~ 13-14 ms of single-step pause on pb 100M (1,365 us on the dense\n",
    " * shape), the last known breach of the pause contract. The queue makes the drop O(1) and moves that work into the same bounded drain\n",
    " * the free queue already uses. */\n",
    "/* Queue one slab (already unlinked from the registry and detached from its region chain). O(1): unlike fqPushChain it does not walk a\n",
    " * chain to add up bytes. */\n",
    "__attribute__((unused)) static void extc_rc_fqPushOne(ExtcRcSlab *s) {\n",
    "    int64_t b = extc_rc_fqSlabBytes(s);\n",
    "    s->next = extc_rc_fqHead;\n",
    "    extc_rc_fqHead = s;\n",
    "    extc_rc_fqSlabs++;\n",
    "    extc_rc_fqBytes += b;\n",
    "    if (extc_rc_fqSlabs > extc_rc_fqMaxSlabs) extc_rc_fqMaxSlabs = extc_rc_fqSlabs;\n",
    "    if (extc_rc_fqBytes > extc_rc_fqMaxBytes) extc_rc_fqMaxBytes = extc_rc_fqBytes;\n",
    "}\n",
