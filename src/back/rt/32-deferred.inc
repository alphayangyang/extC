    "/* ---- Deferred free of dropped regions (EXTC_RC_FREE_DEFER) ----\n",
    " * A drop is O(1): extc_rc_regionFree marks the region dead (every slot of it stops being live at once -- owns() answers 0) and pushes\n",
    " * it on a thread-local **closing queue**. The per-slab work -- undo the cross-region edges, leave the ownership registry, hand the slab\n",
    " * to the free queue -- happens later in **bounded** steps (extc_rc_cqDrainCore), at the points that already drain: before a new slab is\n",
    " * carved (so allocation pressure paces the drain), in settle, and unbounded at thread exit via extc_rc_freeQueueDrainAll.\n",
    " * Before the closing queue that work was one unbounded synchronous loop inside the drop: 24,510 slabs ~ 13-14 ms on pb 100M and\n",
    " * 1,365 us on the dense shape -- the last known breach of the pause contract (G3b).\n",
    " * Both queues hold only **dead** payload (invisible RSS waiting for free()), so their size is bounded: above\n",
    " * EXTC_RC_FREE_QUEUE_BYTES the free queue switches to the hard deadline, and a closing backlog deeper than EXTC_RC_CQ_MAX_REGIONS\n",
    " * regions makes the drop itself take one bounded step. Thread-local because a region is dropped and drained by the same thread;\n",
    " * the cross-thread totals ([freequeue], [closing]) are atomic. */\n",
    "#ifndef EXTC_RC_FREE_DEFER\n",
    "#define EXTC_RC_FREE_DEFER 1              /* 1 = queue a dropped region's slabs and free them under a budget; 0 = free synchronously (old behaviour) */\n",
    "#endif\n",
    "#ifndef EXTC_RC_FREE_BUDGET_SLABS\n",
    "#define EXTC_RC_FREE_BUDGET_SLABS 8       /* normal drain: at most this many slabs per pass */\n",
    "#endif\n",
    "#ifndef EXTC_RC_FREE_DEADLINE_US\n",
    "#define EXTC_RC_FREE_DEADLINE_US 40       /* normal drain also stops after this long (whichever comes first). Sized as a **pause**,\n",
    "                                          * not for throughput: the queue is drained again at the next allocation or round close, so a\n",
    "                                          * shorter pass only lets the queue run longer, it does not lose work */\n",
    "#endif\n",
    "#ifndef EXTC_RC_FREE_QUEUE_BYTES\n",
    "#define EXTC_RC_FREE_QUEUE_BYTES (8 << 20)  /* queue byte limit; above it the drain uses the hard deadline until it falls back */\n",
    "#endif\n",
    "#ifndef EXTC_RC_FREE_HARD_DEADLINE_US\n",
    "#define EXTC_RC_FREE_HARD_DEADLINE_US 50  /* forced drain bound (queue over EXTC_RC_FREE_QUEUE_BYTES): one pass stops after this long;\n",
    "                                            * a drain pass is itself a pause and the sweep close calls this drain, so a millisecond here\n",
    "                                            * would land inside a mutator step. The bound matches the ordinary free-deadline class */\n",
    "#endif\n",
    "#ifndef EXTC_RC_CQ_MAX_REGIONS\n",
    "#define EXTC_RC_CQ_MAX_REGIONS 32         /* pending drops before regionFree takes one bounded inline step (the backlog stays bounded) */\n",
    "#endif\n",
    "__attribute__((unused)) static _Thread_local ExtcRcSlab *extc_rc_fqHead;   /* slabs of this thread waiting for free() */\n",
    "__attribute__((unused)) static _Thread_local long long extc_rc_fqSlabs, extc_rc_fqMaxSlabs;\n",
    "__attribute__((unused)) static _Thread_local int64_t extc_rc_fqBytes, extc_rc_fqMaxBytes;\n",
    "__attribute__((unused)) static _Thread_local ExtcRcRegion *extc_rc_cqHead, *extc_rc_cqTail;   /* dropped regions whose slabs are not undone yet */\n",
    "__attribute__((unused)) static _Thread_local long long extc_rc_cqN, extc_rc_cqSlabs;          /* regions pending / slabs handed to the free queue so far */\n",
    "__attribute__((unused)) static long long extc_rc_fqDrained, extc_rc_fqForced;   /* cross-thread totals: __atomic_* on increment */\n",
    "__attribute__((unused)) static long long extc_rc_rfSyncFrees, extc_rc_rfSyncSlabs, extc_rc_rfSyncMax, extc_rc_rfQueueMax;\n",
    "__attribute__((unused)) static long long extc_rc_elideMismatch;   /* [sweepelide] mis= / [elide] verify-mode mismatches */\n",
    "__attribute__((unused)) static void extc_rc_fqDrainAuto(void);\n",
    "__attribute__((unused)) static inline long long extc_rc_chanClock(void);\n",
    "__attribute__((unused)) static inline void extc_rc_chanNote(int ch, long long d, long long work);\n",
    "__attribute__((unused)) static long long extc_rc_cqDrainCore(long long maxSlabs, long long deadlineUs);\n",
