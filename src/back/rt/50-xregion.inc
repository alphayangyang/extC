    "/* ---- Source-side bookkeeping: counting and undoing cross-region in-edges [rt:xregion] ----\n",
    " *\n",
    " * `rsbit` is a **cache** of \"this target slot has live in-edges from another region\", maintained by each slot's `rscnt`: 0 to 1\n",
    " * sets the bit, 1 to 0 clears it, and the saturated value (\"many edges\") sticks and is never decremented -- the same soundness rule as the holder count.\n",
    " *\n",
    " * The count is transferred in three places:\n",
    " *   1. `extc_rc_storeRefOwned`: one assignment replaces one edge (old value decremented, new value incremented), for **cross-region** edges only;\n",
    " *   2. `extc_rc_freeSlot`: freeing an object drops the cross-region edges it holds (the object is gone, so are the edges);\n",
    " *   3. `extc_rc_regionFree`: dropping a whole region decrements in bulk the cross-region edges held by objects in that region **that are still live**.\n",
    " * So the number of registered bits equals the current number of live cross-region edges, decoupled from the number of rounds (a scheme that only sets bits and never clears them would let seeds build up to every object).\n",
    " * The cost is a pass over the pointer fields of the region's slots when the region is dropped (O(live slots of this region)), without scanning the whole table and without touching other regions. */\n",
    "/* Registration/undo counters: `rs_live = inc - dec` is the current number of live cross-region edges; `rs_hwm` is its high-water mark.\n",
    " * The criterion looks at the **high-water mark**: when undo keeps up, it is bounded only by the sweep trigger threshold (memory pressure), independent of the number of rounds.\n",
    " * With EXTC_RC_STATS=1 these numbers are printed at process exit. */\n",
    "__attribute__((unused)) static int64_t extc_rc_rsIncN, extc_rc_rsDecN, extc_rc_rsHwm;\n",
    "/* Count and slot count of targeted release on overwrite (`extc_rc_storeRefOwnedRelease`). Statistics only: the criterion must show that\n",
    " * release **really frees something** (a no-op has to be visible too). Printed by `EXTC_RC_STATS=1` like the `rs_*` numbers. */\n",
    "__attribute__((unused)) static int64_t extc_rc_relN, extc_rc_relSlots;\n",


    "\n",
    "__attribute__((unused)) static ExtcRcRegion *extc_rc_regionOfOwn(void *p) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    return s ? s->region : (ExtcRcRegion *)0;\n",
    "}\n",
    "\n",
    "/* Run-time guard for the cross-region old-value invariant (**compile-time** switch, off by default so the default build pays nothing):\n",
    " * at the points that skip the old-value lookup because \"this region has no foreign pointers\", recompute the old value's region and count it;\n",
    " * if \"the old value is a foreign pointer that was never registered\" really occurs, the foreign invariant is broken, so the count is non-zero (the gate turns red).\n",
    " * The criterion requires checks>0 and bad==0: **not reaching the guard (checks==0) must also fail**, it may not masquerade as green. */\n",
    "#ifndef EXTC_RC_FOREIGN_GUARD\n",
    "#define EXTC_RC_FOREIGN_GUARD 0\n",
    "#endif\n",
    "#if EXTC_RC_FOREIGN_GUARD\n",
    "static long long extc_rc_fgChecks, extc_rc_fgBad;\n",
    "static void extc_rc_fgDump(void) { fprintf(stderr, \"[fg] checks=%lld bad=%lld\\n\", extc_rc_fgChecks, extc_rc_fgBad); }\n",
    "static void extc_rc_fgArm(void) { static int _a; if (!_a) { _a = 1; atexit(extc_rc_fgDump); } }\n",
    "#endif\n",
    "/* `rscnt` (per-slot cross-region in-edge count) is **lazily allocated**: a slab that never sees a registration never builds the table\n",
    " * so a shape that never crosses regions saves the whole table (2 B per slot). */\n",
    "static void extc_rc_rsAlloc(ExtcRcSlab *s) {\n",
    "    if (s->rscnt) return;   /* skip:rscnt-have */\n",
    "    s->rscnt = (uint16_t *)calloc((size_t)s->nslots, sizeof(uint16_t));\n",
    "    if (!s->rscnt) extc_rc_oops(\"rscnt allocation failed\");\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_rsInc(void *t) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(t);\n",
    "    if (!s) return;   /* skip:not-own */\n",
    "    size_t i = extc_rc_slotOf(s, t);\n",
    "    if (!(s->occ[extc_rc_word(i)] & extc_rc_bit(i))) return;   /* skip:occ-free */\n",
    "    extc_rc_rsAlloc(s);\n",
    "    if (s->rscnt[i] == EXTC_RC_HOLD_SAT) return;          /* saturated: sticks, never wrongly decremented to zero */   /* skip:sat-inc */\n",
    "    if (s->rscnt[i]++ == 0) { s->rsbit[extc_rc_word(i)] |= extc_rc_bit(i); s->region->seedAny = 1; }\n",
    "    extc_rc_rsIncN++;\n",
    "    if (extc_rc_rsIncN - extc_rc_rsDecN > extc_rc_rsHwm) extc_rc_rsHwm = extc_rc_rsIncN - extc_rc_rsDecN;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_rsDec(void *t) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(t);\n",
    "    if (!s) return;   /* skip:not-own */\n",
    "    size_t i = extc_rc_slotOf(s, t);\n",
    "    if (!(s->occ[extc_rc_word(i)] & extc_rc_bit(i))) return;   /* skip:occ-free */\n",
    "    if (!s->rscnt || s->rscnt[i] == 0 || s->rscnt[i] == EXTC_RC_HOLD_SAT) return;   /* skip:sat-dec */\n",
    "    if (--s->rscnt[i] == 0) s->rsbit[extc_rc_word(i)] &= ~extc_rc_bit(i);\n",
    "    extc_rc_rsDecN++;\n",
    "}\n",
    "\n",
    /* [rt:wmark] Record that a cross-region value was stored into the 64-byte group that holds `slot`, so the release path of that
     * slot only has to look at the marked groups. Called from `extc_rc_rsIncSlab` -- the one place that registers the edge --
     * with the source slot, so the two can never disagree. The bitmap may be a superset of the true edge set: the release path
     * re-reads the slots itself and only trusts the bitmap to skip whole groups. */
    "__attribute__((unused)) static void extc_rc_wmarkSlot(void **slot) {\n",
    "    if (!slot) return;   /* skip:wmark-noslot */\n",
    "    ExtcRcSlab *so = extc_rc_ownSlab((void *)slot);\n",
    "    if (!so) so = extc_rc_extLookup((void *)slot);   /* [rt:extent-own] a field inside a huge payload: the carved range names the block */\n",
    "    if (!so || !so->wmark) return;   /* skip:wmark-noslab -- stride below the threshold, or the slot lives outside a managed slab */\n",
    "    size_t i = extc_rc_slotOf(so, (void *)slot);\n",
    "    char  *base = EXTC_RC_SLAB_DATA(so) + i * so->ss;\n",
    "    long  off = (long)((char *)slot - base);\n",
    "    if (off < 0 || (size_t)off >= so->ss) { so->region->wmUnsafe = 1; return; }\n",
    "    size_t g = (size_t)off >> 6;\n",
    "    so->wmark[i * so->wmW + (g >> 6)] |= (uint64_t)1 << (g & 63);\n",
    "}\n",

    "/* Cross-region bookkeeping for an already-resolved slab: saves the repeated `ownSlab` lookup in each entry.\n",
    " * Criterion identical to `extc_rc_rsInc`/`rsDec` point by point (occupied bit, saturation sticks, bitmap maintenance),\n",
    " * except that \"find the slab\" is left to the caller -- the caller already looked up the same pointer anyway. */\n",
    "__attribute__((unused)) static void extc_rc_rsIncSlab(ExtcRcSlab *s, void *t, void **srcSlot) {\n",
    "    if (srcSlot) extc_rc_wmarkSlot(srcSlot);   /* the source slot: its bitmap records which 64-byte groups to look at */\n",
    "    size_t i = extc_rc_slotOf(s, t);\n",
    "    if (!(s->occ[extc_rc_word(i)] & extc_rc_bit(i))) return;   /* skip:occ-free */\n",
    "    extc_rc_rsAlloc(s);\n",
    "    if (s->rscnt[i] == EXTC_RC_HOLD_SAT) return;   /* skip:sat-inc */\n",
    "    if (s->rscnt[i]++ == 0) { s->rsbit[extc_rc_word(i)] |= extc_rc_bit(i); s->region->seedAny = 1; }\n",
    "    extc_rc_rsIncN++;\n",
    "    if (extc_rc_rsIncN - extc_rc_rsDecN > extc_rc_rsHwm) extc_rc_rsHwm = extc_rc_rsIncN - extc_rc_rsDecN;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_rsDecSlab(ExtcRcSlab *s, void *t) {\n",
    "    size_t i = extc_rc_slotOf(s, t);\n",
    "    if (!(s->occ[extc_rc_word(i)] & extc_rc_bit(i))) return;   /* skip:occ-free */\n",
    "    if (!s->rscnt || s->rscnt[i] == 0 || s->rscnt[i] == EXTC_RC_HOLD_SAT) return;   /* skip:sat-dec */\n",
    "    if (--s->rscnt[i] == 0) s->rsbit[extc_rc_word(i)] &= ~extc_rc_bit(i);\n",
    "    extc_rc_rsDecN++;\n",
    "}\n",
    "\n",
    "/* A slot that is **about to stop being an object**: undo by source the edges it holds into other regions. Fields and type descriptor\n",
    " * must still be intact when reading, so every call site runs before the free-chain store and the descriptor clear. */\n",
    "__attribute__((unused)) static void extc_rc_unlinkChildren(ExtcRcSlab *s, size_t i) {\n",
    "    char *p = EXTC_RC_SLAB_DATA(s) + i * s->ss;\n",
    "    const ExtcRcType *t = extc_rc_typeOf(s, i);\n",
    "    if (t == EXTC_RC_CONSERVATIVE) {\n",
    "        size_t words = s->ss / sizeof(void *);\n",
    "        if (s->wmark && !s->region->wmUnsafe) {   /* [rt:wmark]: only the 64-byte groups that were ever stored a cross-region value */\n",
    "            uint64_t *wm = s->wmark + (size_t)i * (size_t)s->wmW;\n",
    "            size_t gbase = 0;\n",
    "            for (uint32_t k = 0; k < s->wmW; k++, gbase += 64) {\n",
    "                uint64_t bits = wm[k];\n",
    "                if (!bits) continue;\n",
    "                wm[k] = 0;   /* the slot is going away: a reused slot starts with an empty bitmap */\n",
    "                while (bits) {\n",
    "                    uint32_t b = (uint32_t)__builtin_ctzll(bits);\n",
    "                    bits &= bits - 1;\n",
    "                    size_t w0 = (gbase + (size_t)b) * 8;   /* the 8 words of a set group are the only candidates */\n",
    "                    for (size_t q = 0; q < 8 && w0 + q < words; q++) {\n",
    "                        void *c = ((void **)p)[w0 + q];\n",
    "                        if (c) { ExtcRcSlab *cs = extc_rc_ownSlab(c); if (cs && cs->region != s->region) extc_rc_rsDecSlab(cs, c); }\n",
    "                    }\n",
    "                }\n",
    "            }\n",
    "            return;\n",
    "        }\n",
    "        for (size_t w = 0; w < words; w++) {\n",
    "            void *c = ((void **)p)[w];\n",
    "            if (c) { ExtcRcSlab *cs = extc_rc_ownSlab(c); if (cs && cs->region != s->region) extc_rc_rsDecSlab(cs, c); }\n",
    "        }\n",
    "        return;\n",
    "    }\n",
    "    if (!t) return;   /* skip:no-desc */\n",
    "    for (uint32_t k = 0; k < t->nptr; k++) {\n",
    "        void *c = *(void **)(p + t->off[k]);\n",
    "        if (c) { ExtcRcSlab *cs = extc_rc_ownSlab(c); if (cs && cs->region != s->region) extc_rc_rsDecSlab(cs, c); }\n",
    "    }\n",
    "}\n",
