    "/* ---- Marking: start from roots and this region's registration bitmap, walk the region in steps [rt:mark] --------------------------------\n",
    " *\n",
    " * Walk only objects inside the region: stop at the region boundary and do not write the other region's mark bits -- leaving objects of another region marked would make it\n",
    " * skip them in its next sweep and free things that are still live; anything outside the region is treated as live.\n",
    " *\n",
    " * A pointer must pass owns before slabOf: roots and fields can both hold board/pool/stack/C pointers, and applying the mask\n",
    " * directly would read unrelated memory. */\n",
    "/** @brief Start a mark round: clear the stack, push roots, push cross-region seeds. */\n",
    "__attribute__((unused)) static void extc_rc_markBegin(ExtcRcRegion *r, void *const *roots, size_t nroots) {\n",
    "    r->msp = 0;\n",
    "    r->scanObj = (void *)0; r->scanOff = 0; r->scanDesc = 0;   /* new round: the previous round's segment cursor does not carry over */\n",
    "    for (size_t i = 0; i < nroots; i++)\n",
    "        if (roots[i] && extc_rc_owns(roots[i])) extc_rc_markPush(r, roots[i]);\n",
    "    extc_rc_pinSeed(r);\n",    "    /* Frame-root chain seeding is switched on in **step 3**: step 2 only pushes the chain and trigger points still use the old root table; reading the chain here now\n",
    "     * would change semantics as soon as step 2 pushes (the design doc puts \"the chain really takes effect\" in step 3 and requires scan completeness to be accepted only then). */\n",
    "    r->seedSlab = r->slabs;   /* seeds are now pushed **in steps**: here only the cursor is set */\n",
    "    r->seedWord = 0;\n",
    "    r->seedBits = 0;   /* \"remaining bits of the current word\" for the unified budget: cleared at round start */\n",
    "    r->seedsDone = (r->slabs == NULL) || !r->seedAny;   /* no seed ever registered, so there is nothing to push and the whole scan is skipped */\n",
    "}\n",
    "/** @brief Stepped marking: scan at most budget objects; returns how many were scanned this round (empty stack = marking done). */\n",
    /* Same-slab dedupe of a sub-object looks only at the **mark bit** of the slot containing
       the address; it does not validate the slot start and does not check occ. A set mark means
       the slot was already blackened this round (walked, or blackened by alloc when allocated
       during marking), and the pop side rejects it on the same mark bit, so the early continue
       loses no reachability. Skipping the occ check is sound as well: with an empty slot whose
       mark is set, the push would be dropped by the pop side's occ check anyway, so the
       reachable set is the same. A non-slot-start pointer is judged a non-object by ownSlab on
       the pop side (skipped as out of region); deduping it early leaves the reachable set
       unchanged and saves the multiply-check per same-slab sub-object. */
    "/* The object-processing body is a macro: the batch path (deep stack) and the shallow fast path share one body. Batching (arrays, up to four, take the min,\n",
    " * fill loop, scan-batch loop) only amortizes well when the stack holds enough objects; when stack depth does not exceed\n",
    " * EXTC_RC_MARK_SHALLOW it is pure fixed cost, so a shallow stack pops and scans one directly. The macro takes no part in performance decisions,\n",
    " * it only lets both expansions share one body (two hand copies drift).\n",
    " *\n",
    " * Threshold choice: the shallow path processes one at a time and scans **immediately**, children are marked black and pushed on the spot, so duplicate pushes are deduped at the source;\n",
    " * batching defers \"mark black\" until the whole batch is popped, so duplicate pushes increase. A larger threshold makes dedup effective sooner, but with a mid-depth stack\n",
    " * it also gives up batch prefetch lead time -- it is a trade-off of \"dedup gain vs prefetch gain\", tuned per shape\n",
    " * (cyclic_pressure: 8 -> 88,852,305; 32 -> 87,922,567; 64 -> 87,823,666; 128 -> 87,910,790;\n",
    " * (256 -> 87,901,977 Ir, so 64 is best; deep-stack shapes like P5 almost always take the batch path and D1mr/DLmr are unchanged bit for bit). */\n",
    "#ifndef EXTC_RC_MARK_SHALLOW\n",
    "#define EXTC_RC_MARK_SHALLOW 64\n",
    "#endif\n",
    "#ifndef EXTC_RC_MARK_SHALLOW_WARM_ONLY\n",
    "#define EXTC_RC_MARK_SHALLOW_WARM_ONLY 1   /* the shallow fast path is a warm-tier optimization: when a pop is a cache hit, the batch fixed cost and the deferred-dedup pushes are pure loss. Once the live set is past EXTC_RC_MARK_COLD_BYTES a pop is a DRAM miss, and batching is what overlaps those misses (same instruction count: 86-91 ns/pop shallow vs 20.5 ns/pop batched). 0 restores the depth-only rule, for A/B and for machines whose cache is much larger than this one. */\n",
    "#endif\n",
    "/* Segment the scan of large objects: when one object holds very many pointers (a large array field, or a struct whose length is only known at run time),\n",
    " * scanning it is **single-step indivisible** work -- the single-step pause is proportional to object length. Segment it by EXTC_RC_SCAN_CHUNK:\n",
    " * this step walks one segment, records the position in the region cursor, and the next full step continues with another segment.\n",
    " *\n",
    " * Only **conservative scans** are segmented: a descriptor scan's length is the number of pointer fields in the struct (a compile-time constant, on the order of a few to a few thousand),\n",
    " * and the segmentation gain does not pay for one more comparison per object; large arrays / unknown shapes use the conservative scan (word-wise over the whole slot), which is the path where the pause\n",
    " * grows linearly with object length.\n",
    " *\n",
    " * Granularity is 8192 pointers: this scan is bandwidth-bound, about 1.1 ns per pointer here, so the single-step bound is about 9 us, 125 times lower than the 1126 us\n",
    " * for a 1M-pointer chase array without segmentation. Smaller segments pay a fixed pop/locate/account cost per segment\n",
    " * (promote: 65536 -> +0.20%, 16384 -> +0.59%, 8192 -> +0.99%, 1024 -> +3.6%); to get a tighter\n",
    " * bound, lower it at compile time and pay according to the table. The criterion is the driver's t_scanChunk (deterministic cursor assertion); the red self-test\n",
    " * raises the bound to a billion so the step scans everything at once and no cursor appears.\n",
    " *\n",
    " * Step bound model: a resumed segment walks min(EXTC_RC_SCAN_CHUNK, remaining) pointer words, or keeps walking until it has spent\n",
    " * EXTC_RC_SEG_DEADLINE_US of wall time (checked every EXTC_RC_SEG_CHECK_WORDS words, so at most one check interval overshoots), whichever\n",
    " * comes first. Hence P_step <= min(C_scan * EXTC_RC_SCAN_CHUNK, deadline + C_scan * EXTC_RC_SEG_CHECK_WORDS) + fixed step cost: the word\n",
    " * bound is the old one, and the time bound is what makes an 8192-word segment (78-98 us, 9.5-12 ns/word) yield at ~40 us. The 3.4 ns/word\n",
    " * figure is a 65536-word-slice extrapolation on the same shape and must not be rescaled to another segment size. Both pd shapes report\n",
    " * seg-step p99.9 = 58.5 us / 99.2 us at the pure word bound, ~44-46 us with the default time bound.\n",
    " * A resumed segment's words are reported as seg (in [top]/[worst]) and seg_max (in [work]/[ubwork]), so the model is checkable from one run;\n",
    " * before that the seed scan's words++ was the only scan counter and a segment was invisible to every work bound.\n",
    " *\n",
    " * TODO(open, unverified): at the same allocated volume, SCAN_CHUNK=65536 triggered 3.6x more collects than 8192 (25 vs 7) and 6.4x the total\n",
    " * step time on pd. Hypothesis: a larger per-step segment changes how fast a round advances, and that feeds back into trigger frequency (see\n",
    " * P1-2 budget coupling in the plan). The mechanism is not pinned down, so this stays an open question, not an explanation.\n",
    " *\n",
    " * Chunk trade-off sweep (200x8 MiB pd shape, EXTC_RC_PAUSE=1 EXTC_RC_STEP_CPU=1, [segsteps]): resumed-segment p99.9 is 1.65/1.84 us at 128/256 words and 34-87 us at 8192,\n",
    " * while the >10 us tail (max 58-871 us) is 1e-4..1e-3 of steps at every chunk and does not shrink with the chunk -- it is not segment length.\n",
    " * Memory is where the chunk pays: with EXTC_RC_QUOTA_DEADLINE_US=800 a 128/256-word segment cannot spend one 8 MiB allocation's quota inside a deadline window,\n",
    " * so pd peaks at 215-240 MB / 126-134 MB against 26.6 MB; with the deadline off the peak stays 26.6 MB and the four v2 shapes stay within +2.1% wall and +4% RSS.\n",
    " * Defaulting below 8192 therefore needs a resume that amortizes the fixed per-step cost over several segments first, so a smaller chunk buys the tail without multiplying the steps.\n",
    " * The ~9 us bound above is the pointer-chase array case; an 8192-word pd segment walks at 6-13 us and the [segsteps] probe reports it directly.\n",
    " */\n",
    "#ifndef EXTC_RC_SCAN_CHUNK\n",
    "#define EXTC_RC_SCAN_CHUNK 8192\n",
    "#endif\n",
    "#if EXTC_RC_SCAN_CHUNK < 1\n",
    "#error \"EXTC_RC_SCAN_CHUNK must be >= 1\"\n",
    "#endif\n",
    "/* Sub-chunk time cap (G1-ii-b): a resumed segment yields after EXTC_RC_SEG_DEADLINE_US of wall time, checked every\n",
    " * EXTC_RC_SEG_CHECK_WORDS words, instead of always walking a full EXTC_RC_SCAN_CHUNK. This bounds one mark step at the deadline plus the\n",
    " * check quantisation (3-6 us at 6-12 ns/word) while the per-step fixed cost stays amortised over a near-full chunk: cutting the chunk itself\n",
    " * to 128/256 words multiplied the steps and drove the pd peak to 215-240 MB (see the chunk trade-off note above). 0 disables the cap. */\n",
    "#ifndef EXTC_RC_SEG_DEADLINE_US\n",
    "#define EXTC_RC_SEG_DEADLINE_US 40\n",
    "#endif\n",
    "#ifndef EXTC_RC_SEG_CHECK_WORDS\n",
    "#define EXTC_RC_SEG_CHECK_WORDS 512\n",
    "#endif\n",
    "#if EXTC_RC_SEG_CHECK_WORDS < 1\n",
    "#error \"EXTC_RC_SEG_CHECK_WORDS must be >= 1\"\n",
    "#endif\n",
    "#define EXTC_RC_MARK_CHILD(_child) do { \\\n",
    "    void *child = (_child); \\\n",
    "    if (child) { \\\n",
    "        int _dup = 0; \\\n",
    "        uintptr_t _cb = (uintptr_t)child & ~(uintptr_t)(EXTC_RC_SLAB_SIZE - 1); \\\n",
    "        if (_cb == (uintptr_t)s) {   /* same block: jump by the dedup bit of \"the slot containing this address\" */ \\\n",
    "            size_t _off = extc_rc_offOf(s, child); \\\n",
    "            size_t _ci = extc_rc_slotOfOff(s, _off); \\\n",
    "            if (_ci < s->nslots) { \\\n",
    "                size_t _cw = extc_rc_word(_ci); \\\n",
    "                _dup = (int)((s->mark[_cw] & extc_rc_bit(_ci)) != 0);   /* dedup only looks at the mark bit */ \\\n",
    "            } \\\n",
    "        } \\\n",
    "        if (!_dup) extc_rc_markPushFast(r, child);   /* already black: the pop side is also blocked by the same bit */ \\\n",
    "    } \\\n",
    "} while (0)\n",

    "#define EXTC_RC_MARK_SCAN(_rawIn) do { \\\n",
    "    uintptr_t _raw = (_rawIn); \\\n",
    "        void *o = (void *)(_raw & ~(uintptr_t)1);   /* low bit = \"must scan\" tag set by the barrier */ \\\n",
    "        int _force = (int)(_raw & (uintptr_t)1); \\\n",
    "        ExtcRcSlab *s = (lastS && ((uintptr_t)o & ~(uintptr_t)(EXTC_RC_SLAB_SIZE - 1)) == (uintptr_t)lastS) \\\n",
    "                          ? lastS : (ExtcRcSlab *)0; \\\n",
    "        size_t i = 0; \\\n",
    "        int _haveK = 0;   /* the same-block check already computed the slot number, so do not compute it again below */ \\\n",
    "        if (s) { \\\n",
    "            size_t _off = extc_rc_offOf(s, o); \\\n",
    "            size_t _k = extc_rc_slotOfOff(s, _off); \\\n",
    "            if (_k < s->nslots && _k * s->ss == _off) { i = _k; _haveK = 1; } \\\n",
    "            else s = (ExtcRcSlab *)0; \\\n",
    "        } \\\n",
    "        if (!s) s = extc_rc_ownSlabMark(o); \\\n",
    "        if (s) lastS = s; \\\n",
    "        if (!s || s->region != r) continue;        /* outside the region / not rc: treat as live and stop */ \\\n",
    "        if (!_haveK) i = extc_rc_slotOf(s, o); \\\n",
    "        uint64_t bit = extc_rc_bit(i); \\\n",
    "        size_t wi = extc_rc_word(i);   /* occ and mark share a word: compute the coordinate once (every object is scanned once) */ \\\n",
    "        if (!_force && (s->mark[wi] & bit)) continue;   /* forced entries are still scanned */ \\\n",
    "        if (!(s->occ[wi] & bit)) continue;   /* a free slot is not an object */ \\\n",
    "        if (!_force) { s->mark[wi] |= bit; s->nMark++; }   /* the shader counted a forced entry when it queued it: count the bit once */ \\\n",
    "        marked++; \\\n",
    "        r->markedBytes += (int64_t)s->ss; \\\n",
    "        const ExtcRcType *t = extc_rc_typeOf(s, i); \\\n",
    "        if (t == EXTC_RC_CONSERVATIVE) {           /* fallback: treat every word in the slot as a candidate pointer */ \\\n",
    "            size_t words = s->ss / sizeof(void *); \\\n",
    "            /* Charged against the step **scan allowance** (_scanLeft), not only against the object length: a slot that is large but \\\n",
    "             * below the chunk (a 2-64 KiB array of references) is scanned inline once per pop, so one step could scan \\\n",
    "             * budget x words words. Now the total inline words in a step is <= EXTC_RC_SCAN_CHUNK whatever the shape, and the \\\n",
    "             * cursor carries the rest. */ \\\n",
    "            if (words > _scanLeft) {   /* over the allowance: record the cursor, the next step walks one segment */ \\\n",
    "                r->scanObj = o; r->scanOff = 0; r->scanDesc = 0; _split = 1; \\\n",
    "                continue; \\\n",
    "            } \\\n",
    "            _scanLeft -= words; \\\n",
    "            for (size_t w2 = 0; w2 < words; w2++) { \\\n",
    "                void *child = ((void **)o)[w2]; \\\n",
    "        if (child) { \\\n",
    "            uintptr_t _cb = (uintptr_t)child & ~(uintptr_t)(EXTC_RC_SLAB_SIZE - 1); \\\n",
    "            if (_cb == (uintptr_t)s) {   /* same block: jump by the dedup bit of \"the slot containing this address\" */ \\\n",
    "                size_t _off = extc_rc_offOf(s, child); \\\n",
    "                size_t _ci = extc_rc_slotOfOff(s, _off); \\\n",
    "                if (_ci < s->nslots) { \\\n",
    "                    uint64_t _cbit = extc_rc_bit(_ci); \\\n",
    "                    size_t _cw = extc_rc_word(_ci);   /* dedup only looks at the mark bit */ \\\n",
    "                    if (s->mark[_cw] & _cbit) continue;   /* already black: the pop side is also blocked by the same bit */ \\\n",
    "                } \\\n",
    "            } \\\n",
    "            extc_rc_markPushFast(r, child); \\\n",
    "        } \\\n",
    "            } \\\n",
    "            continue; \\\n",
    "        } \\\n",
    "        if (!t) continue;                          /* no reference fields, so no pointers to walk */ \\\n",
    "        const uint32_t *_op = t->off; const uint32_t *_oend = _op + t->nptr;   /* obligation 4: walk by the object's own descriptor */ \\\n",
    "        for (; _op < _oend; ++_op) { \\\n",
    "            void *child = *(void **)((char *)o + *_op); \\\n",
    "        if (child) { \\\n",
    "            uintptr_t _cb = (uintptr_t)child & ~(uintptr_t)(EXTC_RC_SLAB_SIZE - 1); \\\n",
    "            if (_cb == (uintptr_t)s) {   /* same block: jump by the dedup bit of \"the slot containing this address\" */ \\\n",
    "                size_t _off = extc_rc_offOf(s, child); \\\n",
    "                size_t _ci = extc_rc_slotOfOff(s, _off); \\\n",
    "                if (_ci < s->nslots) { \\\n",
    "                    uint64_t _cbit = extc_rc_bit(_ci); \\\n",
    "                    size_t _cw = extc_rc_word(_ci);   /* dedup only looks at the mark bit */ \\\n",
    "                    if (s->mark[_cw] & _cbit) continue;   /* already black: the pop side is also blocked by the same bit */ \\\n",
    "                } \\\n",
    "            } \\\n",
    "            extc_rc_markPushFast(r, child); \\\n",
    "        } \\\n",
    "        } \\\n",
    "} while (0)\n",
    "\n",
    "__attribute__((unused)) static size_t extc_rc_markResume(ExtcRcRegion *r) {\n",
    "    /* Continuation of a split object: the previous step left a cursor (scanObj/scanOff) and scanDesc says which index the cursor is.\n",
    "     * One step walks at most EXTC_RC_SCAN_CHUNK units and pushes at most one slot per walked unit, so single-step work follows neither the object\n",
    "     * length nor its fan-out: a 1M-reference array would push a whole 8192-word segment inside one step (multi-hundred-microsecond\n",
    "     * steps). The cursor takes **no stack space** (see the region struct comment) and a resumed segment never pops.\n",
    "     * Walked units: pointer words for scanDesc 0, descriptor fields for scanDesc 1. The count is returned (and already stored in the cursor),\n",
    "     * so a resumed segment shows up as work (seg in [top]/[worst], seg_max in [work]). */\n",
    "    void *o = r->scanObj;\n",
    "    ExtcRcSlab *s = extc_rc_ownSlabMark(o);\n",
    "    if (!s || s->region != r) { r->scanObj = (void *)0; r->scanDesc = 0; return 0; }\n",
    "    size_t walked = 0;\n",
    "    size_t _off = extc_rc_offOf(s, o);\n",
    "    size_t _i = extc_rc_slotOfOff(s, _off);\n",
    "    const ExtcRcType *t = _i < s->nslots ? extc_rc_typeOf(s, _i) : (const ExtcRcType *)0;\n",
    "    if (r->scanDesc) {   /* descriptor scan: the cursor is a field number in the object own offset array */\n",
    "        if (!t || t == EXTC_RC_CONSERVATIVE) { r->scanObj = (void *)0; r->scanDesc = 0; return 0; }\n",
    "        size_t en = (size_t)t->nptr, st = (size_t)r->scanOff;\n",
    "        if (st > en) st = en;\n",
    "        for (size_t k = st; k < en; k++) {\n",
    "            EXTC_RC_MARK_CHILD(*(void **)((char *)o + t->off[k]));\n",
    "            walked++;\n",
    "        }\n",
    "        if (st + walked < en) { r->scanObj = o; r->scanOff = (uint32_t)(st + walked); }\n",
    "        else { r->scanObj = (void *)0; r->scanDesc = 0; }\n",
    "        return walked;\n",
    "    }\n",
    "    size_t words = s->ss / sizeof(void *);\n",
    "    size_t st = (size_t)r->scanOff;\n",
    "    size_t en = st + (size_t)EXTC_RC_SCAN_CHUNK;\n",
    "    if (en > words) en = words;\n",
    "#if EXTC_RC_SEG_DEADLINE_US > 0\n",
    "    long long _segt0 = extc_rc_pauseNow();\n",
    "    for (size_t w2 = st; w2 < en; w2++) {\n",
    "        if (w2 != st && (w2 - st) % (size_t)EXTC_RC_SEG_CHECK_WORDS == 0\n",
    "            && extc_rc_pauseNow() - _segt0 >= (long long)EXTC_RC_SEG_DEADLINE_US * 1000) break;\n",
    "        EXTC_RC_MARK_CHILD(((void **)o)[w2]);\n",
    "        walked++;\n",
    "    }\n",
    "#else\n",
    "    for (size_t w2 = st; w2 < en; w2++) {\n",
    "        EXTC_RC_MARK_CHILD(((void **)o)[w2]); walked++;\n",
    "    }\n",
    "#endif\n",
    "    en = st + walked;   /* a capped segment carries the exact walked word count in the cursor and the return value */\n",
    "    if (en < words) { r->scanObj = o; r->scanOff = (uint32_t)en; }\n",
    "    else r->scanObj = (void *)0;\n",
    "    return walked;\n",
    "}\n",
    "__attribute__((unused)) static size_t extc_rc_markStep(ExtcRcRegion *r, size_t budget) {\n",
    "    long long _mf0 = extc_rc_pauseOn > 1 ? extc_rc_minflt() : -1;   /* PAUSE=2: fault baseline, read before the clock starts */\n",
    "    int _usecpu = extc_rc_stepCpu && extc_rc_pauseOn > 0 && extc_rc_cpuClock();   /* EXTC_RC_STEP_CPU: CPU clock only when the probe says it exists */\n",
    "    long long _c0 = (_usecpu || extc_rc_pauseOn > 1) ? extc_rc_cpuNow() : -1;   /* CPU-time baseline (also wall - CPU = preemption at PAUSE=2) */\n",
    "    long long _mt0 = 0; int _hot = 0;   /* diagnostics: slice timing + whether this step is a **bounded hot-path** step */\n",
    "    if (extc_rc_pauseOn > 0) { _mt0 = extc_rc_pauseNow(); _hot = budget <= (size_t)EXTC_RC_MARK_BATCH_MAX * (size_t)EXTC_RC_SWEEP_PRESSURE_MUL; }   /* wall baseline always: the CPU channel takes min(CPU, wall), see extc_rc_stepSpan */\n",
    "        /* Hard per-step pop cap: pressure raises the budget, but a step that pops 1024 cold objects is 100 us of dependent misses. */ \\\n",
    "        if (budget < (size_t)0xffffffff && budget > (size_t)EXTC_RC_MARK_STEP_POP_MAX) budget = (size_t)EXTC_RC_MARK_STEP_POP_MAX; \\\n",
    "    size_t _b0 = budget;   /* the budget as given (a drain is 0xffffffff, and after `budget--` it cannot be restored) */\n",
    "    size_t marked = 0, pops = 0;   /* `marked` really-marked count; `pops` popped count (including duplicates/early exits) */\n",
    "    size_t pushes = 0, seedPushes = 0, words = 0, seg = 0;   /* work done: slots pushed (seed vs all) + rsbit words scanned + pointer words walked by a resumed segment */\n",
    "    size_t _scanLeft = (size_t)EXTC_RC_SCAN_CHUNK;   /* this step inline scan allowance: conservative word scans charge it, and a\n",
    "                                                     * scan that would exceed it leaves a cursor instead, so one step inline scanning is\n",
    "                                                     * <= EXTC_RC_SCAN_CHUNK words whatever the shape */\n",
    "    /* Continuation: the previous step left a cursor on a large object (scanObj/scanOff). This whole step walks one segment, so single-step work is\n",
    "     * independent of object length. After walking it (or a segment) budget is zero and neither seeding nor walking runs -- this step's budget\n",
    "     * is that segment. The cursor is not on the stack, so this **does not pop** (the stack top may be a force entry just pushed by the write barrier). */\n",
    "    /* A pending cursor does **not** get the step while the stack is above EXTC_RC_MARK_STACK_SOFT: that step drains instead,\n",
    "     * so the stack cannot grow with the cursor (the resumed segment pushes at most one chunk per step). */\n",
    "    if (r->scanObj && (size_t)r->msp <= (size_t)EXTC_RC_MARK_STACK_SOFT) {\n",
    "seg = extc_rc_markResume(r);   /* one segment: <= EXTC_RC_SCAN_CHUNK units walked, pushes bounded by that */\\\n",
    "        pops++;\n",
    "        budget = 0;\n",
    "        _b0 = 0;\n",
    "    }\n",
    "#if EXTC_RC_WORK_BUDGET > 0\n",
    "    /* Unified total: seed scanning/pushing and walking all deduct from this one counter, so this step's total work <= W (guaranteed by construction). */\n",
    "    size_t wleft = _b0 < (size_t)EXTC_RC_WORK_BUDGET ? _b0 : (size_t)EXTC_RC_WORK_BUDGET;\n",
    "#define EXTC_RC_MS_SEED (r->seedSlab && wleft > 0)\n",
    "#define EXTC_RC_MS_WALK (r->msp && wleft > 0)\n",
    "#else\n",
    "#define EXTC_RC_MS_SEED (r->seedSlab)\n",
    "#define EXTC_RC_MS_WALK (r->msp)\n",
    "#endif\n",
    "    ExtcRcSlab *lastS = (ExtcRcSlab *)0;   /* local same-slab cache */\n",
    "    int _split = 0;   /* this step saw a large-object segment, so end the step now (see the end of the MARK_SCAN section) */\n",
    "    if (!r->seedsDone) {   /* stepped seed push: each step pushes at most SEED_PUSHES slots and scans at most SEED_WORDS words */\n",
    "#if EXTC_RC_WORK_BUDGET > 0\n",
    "        /* Unified budget: the bits of the current word **not yet pushed** stay in `seedBits`, and the cursor **stops on this word**\n",
    "         * (`seedSlab`/`seedWord` unchanged), so pushing can recompute the slot address and a word is never dropped halfway\n",
    "         * (dropping bits = incomplete seeds = unsafe), and completeness is not bought with a `+63` overshoot either, so the step total is exactly <= W. */\n",
    "        while (pushes < EXTC_RC_SEED_PUSHES && words < EXTC_RC_SEED_WORDS && EXTC_RC_MS_SEED) {\n",
    "            ExtcRcSlab *ss = r->seedSlab;\n",
    "            if (!r->seedBits) {   /* entering this word: scanning counts as 1 unit, then take a bit */\n",
    "                r->seedBits = ss->rsbit[r->seedWord] & ss->occ[r->seedWord];\n",
    "                words++;\n",
    "                wleft--;\n",
    "            }\n",
    "            while (r->seedBits && wleft > 0 && pushes < EXTC_RC_SEED_PUSHES) {\n",
    "                uint32_t b = (uint32_t)__builtin_ctzll(r->seedBits);\n",
    "                r->seedBits &= r->seedBits - 1;\n",
    "                extc_rc_markPush(r, EXTC_RC_SLAB_DATA(ss) + ((size_t)r->seedWord * 64 + b) * ss->ss);\n",
    "                pushes++;\n",
    "                wleft--;\n",
    "            }\n",
    "            if (r->seedBits) break;   /* total/slot quota used up with bits left, so stop on this word and continue pushing next step */\n",
    "            r->seedWord++;            /* advance the cursor only after this word is fully pushed */\n",
    "            if (r->seedWord >= ss->nwords) { r->seedSlab = ss->next; r->seedWord = 0; }\n",
    "        }\n",
    "#else\n",
    "        while (pushes < EXTC_RC_SEED_PUSHES && words < EXTC_RC_SEED_WORDS && EXTC_RC_MS_SEED) {\n",
    "            ExtcRcSlab *ss = r->seedSlab;\n",
    "            uint64_t sb = ss->rsbit[r->seedWord] & ss->occ[r->seedWord];\n",
    "            while (sb) {\n",
    "                uint32_t b = (uint32_t)__builtin_ctzll(sb);\n",
    "                sb &= sb - 1;\n",
    "                extc_rc_markPush(r, EXTC_RC_SLAB_DATA(ss) + ((size_t)r->seedWord * 64 + b) * ss->ss);\n",
    "                pushes++;\n",
    "            }\n",
    "            r->seedWord++;\n",
    "            if (r->seedWord >= ss->nwords) { r->seedSlab = ss->next; r->seedWord = 0; }\n",
    "            words++;\n",
    "        }\n",
    "#endif\n",
    "        if (!r->seedSlab) r->seedsDone = 1;\n",
    "        seedPushes = pushes;   /* the seed phase is over: its push count is the bound [work] reports (no per-slot counter needed) */\n",
    "    }\n",
    "    /* Pop at most EXTC_RC_MARK_BATCH_POP objects first, prefetch them together, then scan one by one.\n",
    "     * Why: popping one at a time LIFO is a **serial pointer chain** -- the next object depends on the previous step's payload read,\n",
    "     * so a whole cache-miss latency lands on one object; collecting a batch first lets this batch's payload misses\n",
    "     * overlap in flight, so latency is amortized. The **pop order is unchanged** (first popped is scanned first); only the scan is deferred until the batch is popped. */\n",
    "    while (EXTC_RC_MS_WALK && budget > 0 && !_split) {\n",
    /* Shallow stack: no batching, and the shallow stack is drained in one pass. The fixed cost
     * of batching (array, four-way min, fill, batch scan) is pure loss at stack depth about 1;
     * batching exists to give payload misses prefetch lead time, which only pays off once enough
     * objects accumulate. Draining in the loop also avoids re-evaluating the while and
     * shallow-stack conditions in the outer loop after every pop. */
    "        if ((size_t)r->msp <= (size_t)EXTC_RC_MARK_SHALLOW && budget > 0\n",
    "#if EXTC_RC_MARK_SHALLOW_WARM_ONLY\n",
    "            && (int64_t)r->live <= (int64_t)EXTC_RC_MARK_COLD_BYTES   /* roof picks the path: a warm pop is a cache hit (batch fixed cost is pure loss), a cold pop is a DRAM miss (batching overlaps it) */\n",
    "#endif\n",
    "#if EXTC_RC_WORK_BUDGET > 0\n",
    "            && wleft > 0\n",
    "#endif\n",
    "           ) {\n",
    "size_t _spS = r->msp;   /* the shallow pass is bounded by the stack soft depth; its pushes are counted for the work report */\n",
    "            do {\n",
    "                void *_one = r->mstk[--r->msp];\n",
    "                budget--; pops++;\n",
    "#if EXTC_RC_WORK_BUDGET > 0\n",
    "                wleft--;\n",
    "#endif\n",
    "                EXTC_RC_MARK_SCAN((uintptr_t)_one);\n",
    "            } while (r->msp > 0 && (size_t)r->msp <= (size_t)EXTC_RC_MARK_SHALLOW && budget > 0 && !_split\n",
    "#if EXTC_RC_WORK_BUDGET > 0\n",
    "                     && wleft > 0\n",
    "#endif\n",
    "                    );\n",
    "if (r->msp > _spS) pushes += (size_t)(r->msp - _spS);\n",
    "            continue;\n",
    "        }\n",
    "        uintptr_t _batch[EXTC_RC_MARK_BATCH_POP]; size_t _nb = 0;\n",
    "        /* Compute this batch's limit once, then pop: a batch averages fewer than 2 objects, and re-testing\n",
    "         * four conditions and decrementing budget and quota per pop does not amortize the fixed cost; the limit is the min of four quantities,\n",
    "         * computed once. Budget/quota are deducted once by _nb after the whole batch is popped. */\n",
    "        size_t _lim = EXTC_RC_MARK_BATCH_POP;\n",
    "        if (budget < _lim) _lim = budget;\n",
    "#if EXTC_RC_WORK_BUDGET > 0\n",
    "        if (wleft < _lim) _lim = wleft;\n",
    "#endif\n",
    "        void **_stk = r->mstk; size_t _sp = r->msp;   /* hoist the stack head into a local: the pop loop does not keep re-reading r */\n",
    "        if (_sp < _lim) _lim = _sp;\n",
    "        while (_nb < _lim) {\n",
    "            _batch[_nb] = (uintptr_t)_stk[--_sp];\n",
    "            __builtin_prefetch((void *)(_batch[_nb] & ~(uintptr_t)1), 0, 1);   /* prefetch while collecting: saves one loop pass */\n",
    "            _nb++;\n",
    "        }\n",
    "        r->msp = _sp;   /* put it back: scanning this batch pushes children and changes r->msp */\n",
    "        budget -= _nb; pops += _nb;\n",
    "#if EXTC_RC_WORK_BUDGET > 0\n",
    "        wleft -= _nb;   /* 1 popped object = 1 unit (the children it pushes count inside this one object) */\n",
    "#endif\n",
    "        size_t _b = 0;\n",
    "        for (; _b < _nb && !_split; _b++) {\n",
    "            EXTC_RC_MARK_SCAN(_batch[_b]);\n",
    "        }\n",
    "if (r->msp > _sp) pushes += (size_t)(r->msp - _sp);   /* fan-out of this batch counts against the step push cap (one compare per ~200 pops) */\n",
    "if (pushes > (size_t)EXTC_RC_MARK_PUSH_STEP) _split = 1;   /* the step stops by push volume too, not only by pop volume: one object with many reference fields cannot push unboundedly */\n",
    "        if (_split) {   /* segmentation cut the step short: stack entries in this batch **not yet scanned** must be pushed back (they were already popped from the mark stack;\n",
    "                         * dropping them would miss reachable objects). The cursor entry is not on the stack, so there is no\n",
    "                         * \"continuation entry buried\" problem -- just push back and the next step's entry continues from the cursor. */\n",
    "            while (_nb > _b) {\n",
    "                --_nb;\n",
    "                uintptr_t _raw = _batch[_nb];\n",
    "                if (_raw & (uintptr_t)1) extc_rc_markPushForce(r, (void *)(_raw & ~(uintptr_t)1));\n",
    "                else extc_rc_markPush(r, (void *)(_raw & ~(uintptr_t)1));\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "    if (extc_rc_pauseOn > 0) {\n",
    "        long long _d = extc_rc_stepSpan(_c0, _mt0);   /* min(CPU, wall) on the CPU channel; wall alone otherwise */\n",
    "        extc_rc_stepNote(_d);\n",
    "if (seg > 0) {   /* resumed-segment step: its duration is the chunk acceptance criterion */\n",
    "    extc_rc_segN++; extc_rc_segPops += (long long)pops; if (_d > extc_rc_segMax) extc_rc_segMax = _d;\n",
    "    extc_rc_segB[extc_rc_stepBucket(_d)]++;\n",
    "    if (_d > 10000) extc_rc_segGt10++;\n",
    "    if (_d > 50000) extc_rc_segGt50++;\n",
    "    if (_d > 64000) extc_rc_segGt64++;\n",
    "    { size_t _u = (size_t)(_d / 1000); extc_rc_segFine[_u < (size_t)EXTC_RC_SEG_FINE_US ? _u : (size_t)EXTC_RC_SEG_FINE_US]++; }\n",
    "}\n",
    "        extc_rc_topNote(0, extc_rc_why, _d, -1, (long long)words, (long long)seg, (long long)pops, 0, 0,\n",

    "                        extc_rc_pauseOn > 1 ? extc_rc_minflt() - _mf0 : -1,\n",

    "                        (long long)r->thr, (long long)extc_rc_mmaxEff(r), (long long)(r->scale > 0 ? r->scale : 1), extc_rc_pressure(r),\n",

    "                        _usecpu ? _d : ((extc_rc_pauseOn > 1 && extc_rc_cpuClock()) ? extc_rc_cpuNow() - _c0 : -1));\n",

    "        /* `EXTC_RC_SLOWSTEP=<us>`: print **every** slow step above the threshold with its components, so a long tail can be told apart in one run\n",
    "         * as \"outside interference\" (components at the cap, time 10-800x) or \"a genuinely heavy object/allocation\" (components large too).\n",
    "         * Off by default. */\n",
    "        if (extc_rc_slowUs > 0 && _d > extc_rc_slowUs) {\n",
    "            long long _wraw = _mt0 ? extc_rc_pauseNow() - _mt0 : 0;   /* raw wall and raw CPU separately: min(cpu,wall) hides which one was inflated (preemption vs accounting) */\n",
    "            long long _craw = _c0 >= 0 ? extc_rc_cpuNow() - _c0 : -1;\n",
    "            if (extc_rc_slowRingOn) {\n",
    "                if (extc_rc_slowRingN < EXTC_RC_SLOW_RING) extc_rc_slowRing[extc_rc_slowRingN++] = _d;\n",
    "                else extc_rc_slowRingOver++;\n",
    "            } else\n",
    "            fprintf(stderr, \"[slow] step_n=%lld kind=mark why=%s dur_us=%.1f wall_us=%.1f cpu_us=%.1f pops=%lld marked=%lld words=%lld seg=%lld pushes=%lld mscap=%lld msp=%lld budget=%lld\\n\",\n",
    "                    extc_rc_stepN, extc_rc_why, _d / 1000.0, _wraw / 1000.0, _craw / 1000.0, (long long)pops, (long long)marked, (long long)words, (long long)seg,\n",
    "                    (long long)pushes, (long long)r->mscap, (long long)r->msp, (long long)_b0);\n",
    "        }\n",
    "        if (_d > extc_rc_worstNs) {   /* worst step: keep every field (kind/why/budget/walk/scan/push) */\n",
    "            extc_rc_worstNs = _d; extc_rc_worstKind = \"mark\"; extc_rc_worstWhy = extc_rc_why;\n",
    "            extc_rc_worstBudget = (long long)_b0; extc_rc_worstPops = (long long)pops;\n",
    "            extc_rc_worstMarked = (long long)marked; extc_rc_worstWords = (long long)words;\n",
    "            extc_rc_worstSeg = (long long)seg;\n",
    "            extc_rc_worstPushes = (long long)pushes;\n",
    "            extc_rc_worstSwWords = -1; extc_rc_worstSwFreed = -1;\n",
    "        }\n",
    "        if (!_hot) {   /* unbounded step: listed separately, it does not enter the bounded `[work]` bounds */\n",
    "            extc_rc_wUbN++;\n",
    "            if (strcmp(extc_rc_why, \"settle\") == 0) extc_rc_ubSettleN++;\n",
    "            else if (strcmp(extc_rc_why, \"collect\") == 0) extc_rc_ubCollectN++;\n",
    "            else if (strcmp(extc_rc_why, \"release\") == 0) extc_rc_ubReleaseN++;\n",
    "            else extc_rc_ubOtherN++;\n",
    "            /* `EXTC_RC_TRACE_UB=1`: print every unbounded drain together with **the step number at the time**, so \"once per round inside a hot loop\"\n",
    "             * and \"once at process exit\" can be told apart directly by step number (not by reasoning). */\n",
    "            if (getenv(\"EXTC_RC_TRACE_UB\"))\n",
    "                fprintf(stderr, \"[ubtrace] step_n=%lld kind=mark why=%s walk=%lld scan=%lld push=%lld budget=%lld\\n\",\n",
    "                        extc_rc_stepN, extc_rc_why, (long long)marked, (long long)words,\n",
    "                        (long long)pushes, (long long)_b0);\n",
    "            if ((long long)marked > extc_rc_wUbWalkMax) extc_rc_wUbWalkMax = (long long)marked;\n",
    "            if ((long long)words > extc_rc_wUbScanMax) extc_rc_wUbScanMax = (long long)words;\n",
    "            if ((long long)pushes > extc_rc_wUbPushMax) extc_rc_wUbPushMax = (long long)pushes;\n",
    "            if ((long long)seg > extc_rc_wUbSegMax) extc_rc_wUbSegMax = (long long)seg;\n",
    "        }\n",
    "    }\n",
    "    if (_hot) extc_rc_workNote(marked, words, seedPushes, seg, (size_t)EXTC_RC_SCAN_CHUNK - _scanLeft);   /* push_max is the **seed** bound; the whole-step total is in [wbudget] push_max */\n",
    "    if (extc_rc_pauseOn > 0) {   /* mark stack high-water mark: `mscap` only grows, so a sample is the peak */\n",
    "        if ((long long)r->mscap > extc_rc_mscapMax) extc_rc_mscapMax = (long long)r->mscap;\n",
    "        if ((long long)r->msp > extc_rc_mspMax) extc_rc_mspMax = (long long)r->msp;\n",
    "        if ((long long)pops > extc_rc_popMax) extc_rc_popMax = (long long)pops;   /* clock-free: a count of objects, not a time */\n",
    "        if ((long long)pushes > extc_rc_pushMax) extc_rc_pushMax = (long long)pushes;   /* clock-free: children pushed in one step */\n",
    "        extc_rc_popsTot += (long long)pops;\n",
    "    }\n",
    "    r->markWork += (unsigned long long)(pops + words + seg);   /* P0-P: per-region work accounting (bounded by the step budget) */\n",
    "    return marked;\n",
    "}\n",
    "/** @brief Single-pass full marking (callers such as `releaseOld` keep their existing semantics). */\n",
    "__attribute__((unused)) static size_t extc_rc_mark(ExtcRcRegion *r, void *const *roots, size_t nroots) {\n",
    "    extc_rc_markBegin(r, roots, nroots);\n",
    "    size_t marked = 0;\n",
    "    while (!r->seedsDone || r->msp || r->scanObj) marked += extc_rc_markStep(r, 0xffffffffu);\n",
    "    return marked;\n",
    "}\n",
    "\n",
