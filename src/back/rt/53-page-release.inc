    "/* ---- Page-level release: a sparse block's capacity follows the pages its live slots use ----\n",
    " * A block with no live slot is returned whole by extc_rc_slabShrink, but one long-lived survivor pins the whole EXTC_RC_SLAB_SIZE block, and that is\n",
    " * the sparse case the shrink pass cannot touch. This pass gives back the 4 KiB pages of such a block that hold no occupied slot, so its resident\n",
    " * capacity follows the live set (live + 4 KiB per page that holds a live slot) instead of its block size.\n",
    " * Mechanism: MADV_DONTNEED over the block's own pages. No write barrier is added and no object moves: the occupancy bitmap already says which slots\n",
    " * are live, and a released page is only written again by extc_rc_zeroSmall when a slot in it is handed out, which zeroes the slot anyway -- so the\n",
    " * language promise (a fresh allocation reads as zero) is unchanged. Every piece of metadata (occ/mark/rsbit/hold/tid/ttab) lives outside the block,\n",
    " * and the reuse chain keeps its next slot number in tid[], so no page the collector reads is ever released.\n",
    " * Bounds: one call visits at most EXTC_RC_PAGE_TRIM_VISIT_MAX blocks and releases at most EXTC_RC_PAGE_TRIM_BYTES, and a run of empty pages is\n",
    " * released with one call however long it is. The call sits at the closing step of a sweep round, i.e. inside the step the pause distribution sees, so its cost lands in\n",
    " * the pause distribution instead of hiding outside it.\n",
    " * Only a sparse block is trimmed (nslots >= EXTC_RC_PAGE_TRIM_DENSE * nLive): a dense block has few empty pages, so a page pass there would cost\n",
    " * more than it returns. */\n",
    "#ifndef EXTC_RC_PAGE_TRIM\n",
    "#define EXTC_RC_PAGE_TRIM 1                     /* 0 = the emitted text carries no page pass at all */\n",
    "#endif\n",
    "#ifndef EXTC_RC_PAGE_TRIM_BYTES\n",
    "#define EXTC_RC_PAGE_TRIM_BYTES (256 << 10)     /* bytes released per closing step (64 pages: about 4 us at the 14 ns/KB the pass costs) */\n",
    "#endif\n",
    "#ifndef EXTC_RC_PAGE_TRIM_VISIT_MAX\n",
    "#define EXTC_RC_PAGE_TRIM_VISIT_MAX 16          /* blocks inspected per call: bounds the pass when nothing is trimmable */\n",
    "#endif\n",
    "#ifndef EXTC_RC_PAGE_TRIM_MIN_SLACK\n",
    "#define EXTC_RC_PAGE_TRIM_MIN_SLACK (8 << 20)   /* run the pass only when capacity exceeds occupancy by this much: below it the\n",
    "                                                 * returned pages are a small fraction of the heap and the drop/fault churn wins (sizeratio 56% slower). */\n",
    "#endif\n",
    "#ifndef EXTC_RC_PAGE_TRIM_DENSE\n",
    "#define EXTC_RC_PAGE_TRIM_DENSE 8               /* trim only when nslots >= 8 * nLive (at most 12.5% occupied) */\n",
    "#ifndef EXTC_RC_PAGE_TRIM_ACTIVE\n",
    "#define EXTC_RC_PAGE_TRIM_ACTIVE 64            /* skip a block that took more than this many slots since its last pass: a\n",
    "                                                 * dropped page would be reused at once, i.e. dropped and faulted back. */\n",
    "#endif\n",
    "#endif\n",
    "#if EXTC_RC_SLAB_BITS > 19\n",
    "#error \"page pass: a block above 512 KiB needs a wider live-page summary (livepg[] is two 64-bit words)\"\n",
    "#endif\n",
    "#if EXTC_RC_PAGE_TRIM && (defined(__linux__) || defined(__unix__) || defined(__APPLE__))\n",
    "#ifndef MADV_DONTNEED\n",
    "#define MADV_DONTNEED 4   /* Linux and Darwin both number it 4; <sys/mman.h> is not included on purpose: it declares mmap(void *),\n",
    "                            * and the language stdlib declares its own mmap for plates, so including the header conflicts with it. */\n",
    "#endif\n",
    "#if defined(__linux__) || defined(__APPLE__)\n",
    "extern int madvise(void *, size_t, int);   /* same story: BSD entry point, not a POSIX name */\n",
    "#endif\n",
    "#define EXTC_RC_PAGE_TRIM_OK 1\n",
    "#else\n",
    "#define EXTC_RC_PAGE_TRIM_OK 0\n",
    "#endif\n",
    "static long long extc_rc_pageRel __attribute__((unused));     /* bytes given back to the OS by the page pass */\n",
    "static long long extc_rc_pageTrimN __attribute__((unused));   /* blocks visited by the page pass */\n",
    "#if EXTC_RC_PAGE_TRIM_OK\n",
    "/** @brief Release the payload pages of one sparse block that hold no occupied slot; returns the bytes released (<= budget). */\n",
    "__attribute__((unused)) static int64_t extc_rc_pageTrimSlab(ExtcRcSlab *s, int64_t budget) {\n",
    "    uint64_t livepg[2], cand[2];\n",
    "    size_t first, last, p;\n",
    "    uint32_t w;\n",
    "    int64_t rel = 0;\n",
    "    livepg[0] = 1u; livepg[1] = 0u;   /* page 0 carries the block header: never released */\n",
    "    first = (EXTC_RC_SLAB_HDR + 4095) >> 12;   /* first page fully inside the payload */\n",
    "    last = (EXTC_RC_SLAB_HDR + (size_t)s->nslots * s->ss) >> 12;   /* exclusive end: [first, last) is all payload */\n",
    "    for (w = 0; w < s->nwords; w++) {\n",
    "        uint64_t m = s->occ[w];\n",
    "        while (m) {\n",
    "            unsigned b = (unsigned)__builtin_ctzll(m);\n",
    "            size_t off = EXTC_RC_SLAB_HDR + ((size_t)w * 64 + b) * s->ss;\n",
    "            size_t p1 = (off + s->ss - 1) >> 12;   /* a slot may straddle a page boundary: mark both */\n",
    "            m &= m - 1;\n",
    "            for (p = off >> 12; p <= p1; p++) livepg[p >> 6] |= (uint64_t)1 << (p & 63);\n",
    "        }\n",
    "    }\n",
    "    /* Candidate = empty and not already dropped. The page bit is the whole idempotence argument: a page is handed to the OS at most once\n",
    "     * per residency, and only an allocation (which faults it back in) makes it a candidate again. */\n",
    "    cand[0] = ~livepg[0];   /* empty pages: the pass runs only when the occupancy picture changed (pgLive / quiet gate) */\n",
    "    cand[1] = ~livepg[1];\n",
    "    for (p = 0; p < first; p++) cand[p >> 6] &= ~((uint64_t)1 << (p & 63));\n",
    "    for (p = last; p < 128; p++) cand[p >> 6] &= ~((uint64_t)1 << (p & 63));\n",
    "    p = (s->pgNext >= 0) ? (size_t)s->pgNext : first;   /* resume where the budget cut the previous pass */\n",
    "    while (p < last && rel < budget) {\n",
    "        size_t q, pages, bytes;\n",
    "        if (!(cand[p >> 6] & ((uint64_t)1 << (p & 63)))) { p++; continue; }\n",
    "        q = p;\n",
    "        while (q < last && (cand[q >> 6] & ((uint64_t)1 << (q & 63)))) q++;\n",
    "        pages = q - p;\n",
    "        bytes = pages * 4096;\n",
    "        if ((int64_t)bytes > budget - rel) { pages = (size_t)((budget - rel) >> 12); bytes = pages * 4096; }\n",
    "        if (bytes && madvise((char *)s + p * 4096, bytes, MADV_DONTNEED) == 0) {\n",
    "            rel += (int64_t)bytes;\n",
    "        }\n",
    "        p += pages ? pages : 1;\n",
    "    }\n",
    "    if (p >= last) { s->pgNext = -1; s->pgLive = (int64_t)s->nLive; s->pgAllocN = s->allocN; }   /* the pass finished: only a change in nLive can make it worth another */\n",
    "    else s->pgNext = (int32_t)p;   /* out of budget: resume here at the next closing step */\n",
    "    extc_rc_pageRel += rel;\n",
    "    extc_rc_pageTrimN++;\n",
    "    return rel;\n",
    "}\n",
    "#endif\n",
    "/** @brief One bounded step of the page pass: walk the region chain from the cursor, trim sparse blocks, stop at the byte budget. */\n",
    "__attribute__((unused)) static void extc_rc_pageTrimStep(ExtcRcRegion *r, int64_t budget) {\n",
    "    if (r->capBytes - (int64_t)r->bytes < (int64_t)EXTC_RC_PAGE_TRIM_MIN_SLACK) return;   /* skip:pagtrim-slack */\n",
    "    int visits = 0;\n",
    "    if (!r->trimCur) r->trimCur = r->slabs;   /* the previous pass ran to the end: start over at the head */\n",
    "    if (!r->trimCur) return;   /* empty chain */   /* skip:pagtrim-null */\n",
    "    while (r->trimCur && budget > 0 && visits < EXTC_RC_PAGE_TRIM_VISIT_MAX) {\n",
    "        ExtcRcSlab *s = r->trimCur;\n",
    "        r->trimCur = s->next;\n",
    "        if (!r->trimCur) r->trimCur = r->slabs;   /* wrap: one pass is a round-robin over the chain */\n",
    "        visits++;\n",
    "        if (s->big || s == r->bumpSlab) continue;   /* the payload is not in the block, or the bump slab is still being handed out */\n",
    "        if (s->nLive == 0) continue;   /* no live slot: the shrink pass returns the whole block, pages included */\n",
    "        if ((uint64_t)s->nLive * EXTC_RC_PAGE_TRIM_DENSE > (uint64_t)s->nslots) continue;   /* dense: a page pass costs more than it returns */\n",
    "        if (s->pgNext < 0 && s->pgLive == (int64_t)s->nLive && (uint32_t)(s->allocN - s->pgAllocN) <= EXTC_RC_PAGE_TRIM_ACTIVE) continue;   /* unchanged and quiet: no new empty page */\n",
    "        if (s->pgNext < 0 && (uint32_t)(s->allocN - s->pgAllocN) > EXTC_RC_PAGE_TRIM_ACTIVE) { s->pgAllocN = s->allocN; continue; }   /* busy block: restart the quiet clock and keep its pages */\n",
    "#if EXTC_RC_PAGE_TRIM_OK\n",
    "        budget -= extc_rc_pageTrimSlab(s, budget);\n",
    "#endif\n",
    "    }\n",
    "}\n",
    "/* One bounded step of the closing drain: take at most maxSlabs slabs (or stop at deadlineUs) from the pending regions and move them\n",
    " * towards free(). Order inside a slab: undo the cross-region edges while the fields are intact, leave the registry, then queue the slab\n",
    " * -- free() itself stays in extc_rc_fqDrainCore, so a slab still pays exactly one free path. A region's own bookkeeping (class chains,\n",
    " * mark stack, counted-tier stack, region) is freed when its slab chain runs empty: O(#classes) per region, never per slab. */\n",
    "__attribute__((unused)) static long long extc_rc_cqDrainCore(long long maxSlabs, long long deadlineUs) {\n",
    "    long long done = 0;\n",
    "    long long t0 = deadlineUs > 0 ? extc_rc_pauseNow() : 0;\n",
    "    while (extc_rc_cqHead) {\n",
    "        if (maxSlabs > 0 && done >= maxSlabs) break;\n",
    "        if (deadlineUs > 0 && extc_rc_pauseNow() - t0 >= deadlineUs * 1000) break;\n",
    "        ExtcRcRegion *r = extc_rc_cqHead;\n",
    "        ExtcRcSlab *s = r->slabs;\n",
    "        if (s) {\n",
    "            r->slabs = s->next; if (r->slabs) r->slabs->prev = (ExtcRcSlab *)0;\n",
    "            s->next = 0;\n",
    "            if (!r->part) {\n",
    "                for (uint32_t w = 0; w < s->nwords; w++)\n",
    "                    if (s->occ[w]) extc_rc_oops(\"R3: occupied slot in a region with part == 0\");\n",
    "            }\n",
    "            if (extc_rc_rsIncN) for (uint32_t w = 0; w < s->nwords; w++) {\n",
    "                uint64_t bits = s->occ[w];\n",
    "                while (bits) {\n",
    "                    uint32_t b = (uint32_t)__builtin_ctzll(bits);\n",
    "                    bits &= bits - 1;\n",
    "                    extc_rc_unlinkChildren(s, (size_t)w * 64 + b);\n",
    "                }\n",
    "            }\n",
    "            extc_rc_ownDel(s);\n",
    "            extc_rc_fqPushOne(s);\n",
    "            extc_rc_cqSlabs++;\n",
    "            done++;\n",
    "        }\n",
    "        if (!r->slabs) {\n",
    "            extc_rc_cqHead = r->cqNext;\n",
    "            if (!extc_rc_cqHead) extc_rc_cqTail = 0;\n",
    "            for (uint32_t b = 0; b < EXTC_RC_CLS_BUCKETS; b++) {\n",
    "                while (r->clsBkt[b]) { ExtcRcClass *c = r->clsBkt[b]; r->clsBkt[b] = c->next; free(c); }\n",
    "            }\n",
    "            free(r->mstk);\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "            free(r->cstk);\n",
    "#endif\n",
    "            free(r);\n",
    "            extc_rc_cqN--;\n",
    "        }\n",
    "    }\n",
    "    return done;\n",
    "}\n",

    "/* Head insertion on the free chain is the only step on the release path that **must be per slot** (each slot's link value differs); the sweep's bulk free\n",
    " * (extc_rc_freeSlotWord) reuses this section too. See the freeSlot comment below: the link value goes into tid[], not the payload. */\n",
    "__attribute__((unused)) static void extc_rc_freeSlotLink(ExtcRcSlab *s, size_t i) {\n",
    "    if (extc_rc_rsIncN) extc_rc_unlinkChildren(s, i);   /* undo its cross-region edges first (the fields are still intact);\n",
    "                                                         * with no registration ever made there is nothing to undo */\n",
    "    s->tid[i] = (uint16_t)(s->freelist + 1);   /* head insertion: store the old slot number (0 = end of chain) */\n",
    "    s->freelist = (int64_t)i;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_freeSlot(ExtcRcSlab *s, size_t i) {\n",
    "    EXTC_RC_TICK(5);   /* per-component timing (`EXTC_RC_TIME=1`) */\n",
    "    extc_rc_freeSlotLink(s, i);   /* head insertion. The link value goes into tid[] rather than the payload: a freed slot is cold, and writing those 8\n",
    "                                   * payload bytes pulls the whole cache line in (RFO) -- the sweep then pays one more last-level store miss\n",
    "                                   * per slot freed; tid[] is a dense 2-byte-per-slot metadata array, so writing it\n",
    "                                   * touches no extra memory (this entry is written below anyway).\n",
    "                                   * Encoding: slot number + 1 (0 = end of chain); limit in EXTC_RC_REUSE_MAX_SLOT. */\n",
    "    size_t wi = extc_rc_word(i);   /* occupancy and registration bit share one word: compute the coordinate once */\n",
    "    uint64_t bi = extc_rc_bit(i);\n",
    "    s->occ[wi]   &= ~bi;\n",
    "    s->rsbit[wi] &= ~bi;   /* obligation 5: leave no stale entry */\n",
    "    s->nLive--;\n",
    "    if (s->mark[wi] & bi) s->nMark--;   /* roll-up: a released slot may still be marked (targeted release) */\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "    s->hold[i] = 0;\n",
    "#endif\n",    "    if (s->rscnt) s->rscnt[i] = 0;\n",
    "#if EXTC_RC_LAZY_FREE\n",
    "    s->nfree++;   /* this hole is linked above by freeSlotLink; the counter also gates reuse of never-issued slots */\n",
    "#endif\n",

    "    s->region->bytes -= (int64_t)s->ss;\n",
    "    s->region->freedSlots++;   /* definition: **every** freeSlot counts (counting only at sweep end would miss\n",
    " * the count-to-zero releases on the hot path, so the accessor would report 0) */\n",
    "    if (!s->avail) extc_rc_classPush(s->region, s);   /* a free slot again: push back onto the size-class chain (see extc_rc_alloc) */\n",
    "}\n",
    "\n",
    "/* Word-wise bulk free during sweep: all slots in a dead word are released together. Of the per-slot steps only \"head insertion\" differs per slot\n",
    " * (the link value differs); occupancy bit, registration bit, byte accounting, freedSlots and the size-class push happen once per word --\n",
    " * during sweep there is no allocation and no reader of these fields, so doing them per slot would just repeat the same work 64 times.\n",
    " * unlinkChildren still runs per slot (it reads the slot's fields), but the \"no registration ever made\" branch is hoisted out of the word loop:\n",
    " * in the default build rsIncN is always 0, so that whole section never runs. Returns the number of released slots. */\n",
    "__attribute__((unused)) static size_t extc_rc_freeSlotWord(ExtcRcSlab *s, size_t w, uint64_t dead) {\n",
    "    size_t base = w * 64;\n",
    "    uint64_t bits = dead;\n",
    "    if (extc_rc_rsIncN) {\n",
    "        uint64_t _u = dead;\n",
    "        while (_u) {\n",
    "            uint32_t b = (uint32_t)__builtin_ctzll(_u);\n",
    "            _u &= _u - 1;\n",
    "            extc_rc_unlinkChildren(s, base + b);\n",
    "        }\n",
    "    }\n",
    "#if !EXTC_RC_NOCOUNT\n",
    "    /* only the holder counts differ per slot; the sweep clears them in the same pass */\n",
    "    {\n",
    "        uint64_t _h = dead;\n",
    "        while (_h) {\n",
    "            uint32_t b = (uint32_t)__builtin_ctzll(_h);\n",
    "            _h &= _h - 1;\n",
    "            s->hold[base + b] = 0;\n",
    "        }\n",
    "    }\n",
    "#endif\n",
    "    if (s->rscnt) {\n",
    "        uint64_t _r = dead;\n",
    "        while (_r) {\n",
    "            uint32_t b = (uint32_t)__builtin_ctzll(_r);\n",
    "            _r &= _r - 1;\n",
    "            s->rscnt[base + b] = 0;\n",
    "        }\n",
    "    }\n",
    "    s->occ[w] &= ~bits;\n",
    "    s->rsbit[w] &= ~bits;   /* obligation 5: leave no stale entry */\n",
    "    size_t n = (size_t)__builtin_popcountll(bits);\n",
    "#if EXTC_RC_LAZY_FREE\n",
    "    /* Lazy reuse (EXTC_RC_LAZY_FREE): count the holes and leave the chain empty; the allocator rebuilds the chain from the occupancy\n",
    "     * bitmap when it needs a slot in this block. None can be counted twice: a slot released on the hot path already has occ = 0, so\n",
    "     * the sweep never sees it as dead again, and a rebuild only runs while the chain is empty. */\n",
    "    s->nfree += (uint32_t)n;\n",
    "#else\n",
    "    /* P0-B: link each dead slot into the reuse chain (the link value lives in tid[], so the payload stays cold), then count\n",
    "     * the holes (a slot freed on the hot path links itself, and the sweep never sees it again as dead: its occupancy bit\n",
    "     * is already clear). */\n",
    "    {\n",
    "        uint64_t _l = dead;\n",
    "        while (_l) {\n",
    "            uint32_t b = (uint32_t)__builtin_ctzll(_l);\n",
    "            _l &= _l - 1;\n",
    "            size_t idx = base + (size_t)b;\n",
    "            s->tid[idx] = (uint16_t)(s->freelist + 1);\n",
    "            s->freelist = (int64_t)idx;\n",
    "        }\n",
    "    }\n",
    "#endif\n",
    "    s->nLive -= (uint32_t)n;\n",
    "    s->region->bytes -= (int64_t)n * (int64_t)s->ss;\n",
    "    s->region->freedSlots += n;\n",
    "    if (!s->avail) extc_rc_classPush(s->region, s);\n",
    "    return n;\n",
    "}\n",
    "\n",
    "#if !EXTC_RC_NOCOUNT\n",
