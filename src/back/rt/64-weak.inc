    "/* ---- Weak references: a handle carries address, slot version and slab serial [rt:weak] ----\n",
    " * A weak reference reads identity back; nothing is registered and nothing runs when the target dies.\n",
    " *\n",
    " * A handle is three words: the address, the version of the slot within its slab, and the serial of that slab.\n",
    " * Taking one validates the target and allocates the slab's version table on first use; it pushes no entry onto any list.\n",
    " * Dropping one is a no-op, so a collection cannot lengthen by the number of weak references that point into the region it\n",
    " * is sweeping -- there is nothing to unlink.\n",
    " *\n",
    " * \"Is it still the same object\" reads five things and writes none: the slab table lookup (a returned block is gone from it),\n",
    " * the slab serial (a freed block is handed back at the same address, so the address alone does not say which slab it is),\n",
    " * the region's dead flag, the occupancy bit, and the slot version (bumped whenever the slot is released, so the next object\n",
    " * to occupy it is a different object to every reference taken earlier).\n",
    " */\n",
    "__attribute__((unused)) static uint64_t extc_rc_weakTag(void *p) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    if (!s) extc_rc_oops(\"weak reference of an object outside every reclaimed region\");   /* skip:weak-notslot */\n",
    "    ExtcRcRegion *r = s->region;\n",
    "    if (r->dead) extc_rc_oops(\"weak reference of an object in a dropped region\");         /* skip:weak-dead */\n",
    "    size_t k = extc_rc_slotOf(s, p);\n",
    "    if (k >= s->nslots || (s->occ[extc_rc_word(k)] & extc_rc_bit(k)) == 0)\n",
    "        extc_rc_oops(\"weak reference of an object that is not a live reclaimed slot\");     /* skip:weak-vacant */\n",
    "    if (!s->ver) {\n",
    "        s->ver = (uint32_t *)calloc((size_t)s->nslots, sizeof(uint32_t));\n",
    "        if (!s->ver) extc_rc_oops(\"out of memory for the weak version table\");\n",
    "    }\n",
    "    extc_rc_weakOf++;\n",
    "    return (uint64_t)s->ver[k];\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static uint64_t extc_rc_weakGen(void *p) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    return s ? s->wgen : (uint64_t)0;   /* skip:weak-gen: not a slot => 0, which no slab serial takes, so the pair can never match */\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void *extc_rc_weakGet(void *p, uint64_t tag, uint64_t gen) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    if (!s) { extc_rc_weakMiss++; return (void *)0; }                                  /* skip:weak-no-slab */\n",
    "    if (s->wgen != gen) { extc_rc_weakMiss++; return (void *)0; }                       /* skip:weak-slab-reused */\n",
    "    ExtcRcRegion *r = s->region;\n",
    "    if (r->dead) { extc_rc_weakMiss++; return (void *)0; }                             /* skip:weak-region-dead */\n",
    "    size_t k = extc_rc_slotOf(s, p);\n",
    "    if (k >= s->nslots || (s->occ[extc_rc_word(k)] & extc_rc_bit(k)) == 0) { extc_rc_weakMiss++; return (void *)0; }   /* skip:weak-slot-vacant */\n",
    "    if (!s->ver || s->ver[k] != (uint32_t)tag) { extc_rc_weakMiss++; return (void *)0; }  /* skip:weak-slot-reused */\n",
    "    extc_rc_weakHit++;\n",
    "    return p;\n",
    "}\n",
