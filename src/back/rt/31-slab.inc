    "/* ---- rc slab registry: only slots touched by extc_rc_alloc may be counted/marked [rt:slab] ----\n",
    " *\n",
    " * The language allows storing a pointer returned by a plate/pool/stack/C function into a reference slot (ref h.c, plate[..].data, the result of dl::sym).\n",
    " * Those pointers live in no slab; after slabOf's bitwise AND the read lands in unrelated memory (the plate's 4 GiB reservation\n",
    " * is not even committed), which segfaults outright.\n",
    " *\n",
    " * So every slab is entered into this table at creation and removed at release; counting and registration ask owns first.\n",
    " * The table is an open-addressing hash (linear probing, no tombstones): the key is the slab base (slabs are aligned to EXTC_RC_SLAB_SIZE,\n",
    " * so after dropping the low SLAB_BITS bits the bases cannot collide), and the cells hold slab pointers directly.\n",
    " * Add and remove are both O(1) amortized -- a sorted array would shift the upper half, and the shifted amount grows linearly with live blocks, so a whole-region release\n",
    " * would cost the square of the block count in total; the hash table has no such segment.\n",
    " * The common tier still goes through the direct-mapped hit cache below first (hit = take it, miss = probe).\n",
    " * Bump slabs are registered too: whether they qualify is decided by the occ bit (bump allocation does not set occ), so bump objects\n",
    " * are naturally excluded by owns. */\n",
    "/* Parallel safety: the registry is published per **generation**. The write side (slab create/release) is serialized under extc_rc_regLock;\n",
    " * readers (ownSlab / ownBig / slabOfInterior) are lock-free -- a reader atomically reads the current-generation pointer once, and the\n",
    " * (tab, cap, n) it obtained is always self-consistent. Growth = build a new generation then publish it; **old generations are never freed** (under parallelism another thread may\n",
    " * still be probing it; together, a few generations stay under twice the final table). After a probe misses, compare extc_rc_regSeq: if unchanged\n",
    " * the key really is not in the table; if changed, the read saw an old generation or an insert not yet published, so retry (see extc_rc_ownFind).\n",
    " * The write-side lock is touched only at slab create/release, never per allocation. */\n",
    "typedef struct ExtcRcReg { ExtcRcSlab **tab; size_t cap; size_t n; } ExtcRcReg;\n",
    "__attribute__((unused)) static ExtcRcReg extc_rc_ownReg0, extc_rc_bigReg0;      /* generation 0 (static) */\n",
    "__attribute__((unused)) static ExtcRcReg *extc_rc_ownCur = &extc_rc_ownReg0;    /* current generation: published pointer */\n",
    "static ExtcRcSlab **extc_rc_ownMirTab;   /* hot-path mirror: the current generation's tab (a hint only; a miss falls back to ownFind) */\n",
    "static size_t extc_rc_ownMirCap;         /* the current generation's cap; stored with RELEASE and read with ACQUIRE, so seeing the new cap implies seeing the new tab */\n",
    "__attribute__((unused)) static ExtcRcReg *extc_rc_bigCur = &extc_rc_bigReg0;\n",
    "__attribute__((unused)) static uint32_t extc_rc_regSeq;   /* incremented on every add/remove/generation change: readers use it to detect retries */\n",
    "__attribute__((unused)) static int extc_rc_regLock;\n",
    "__attribute__((unused)) static inline void extc_rc_regLockAcq(void) {\n",
    "    while (__atomic_exchange_n(&extc_rc_regLock, 1, __ATOMIC_ACQUIRE)) { }\n",
    "}\n",
    "__attribute__((unused)) static inline void extc_rc_regUnlock(void) {\n",
    "    __atomic_store_n(&extc_rc_regLock, 0, __ATOMIC_RELEASE);\n",
    "}\n",
    "/* The registry's **hit cache** (direct-mapped, fixed capacity): a cell is a hit when it holds exactly a slab base.\n",
    " *\n",
    " * Why it exists: `ownSlab` is on the hot path of inc/dec/register/marking, and those shapes have only a\n",
    " * few slabs, so every probe recomputes on the same few addresses. The hit cache turns the \"common\" tier into one array read;\n",
    " * misses and collisions always fall back to registry probing, so **the result is word-for-word the same as with no cache** (the cache affects speed only, never the decision).\n",
    " *\n",
    " * Covers normal slabs only: a huge block's payload is malloc'd separately and located through the huge-block table, unrelated to this.\n",
    " * A cell stores the slab pointer itself; deletion clears only a cell that still holds exactly this slab,\n",
    " * so a cell overwritten by a later slab never wipes someone else's entry, and no cell keeps a released slab. */\n",
    "#define EXTC_RC_OWNMAP_BITS 12\n",
    "#define EXTC_RC_OWNMAP_SIZE (1u << EXTC_RC_OWNMAP_BITS)\n",
    "__attribute__((unused)) static ExtcRcSlab *extc_rc_ownMap[EXTC_RC_OWNMAP_SIZE];\n",
    "/* One \"last block\" cache: `ownMap`'s hit path still hashes and indexes (on real shapes that is the\n",
    " * bulk of the cache misses). This reuses the last verified slab by **base equality** -- semantically identical to no cache: a hit still passes\n",
    " * slot-boundary validation, and a failed check still falls back to `ownBig`. It must be cleared when a slab is released (see `ownDel`). */\n",
    "/* Last-block cache: **thread-local**. Parallel workers each have their own slab set; sharing it would let one thread\n",
    " * treat another thread's region object as a slab of this thread (a wrong decision across the region boundary). */\n",
    "static _Thread_local ExtcRcSlab *extc_rc_ownHot;\n",
    "__attribute__((unused)) static size_t extc_rc_ownHashOf(const void *base) {\n",
    "    return (size_t)(((uintptr_t)base >> EXTC_RC_SLAB_BITS) * 2654435761u)\n",
    "           & (EXTC_RC_OWNMAP_SIZE - 1);\n",
    "}\n",
    "\n",
    "/* Table key: the base address itself for a normal slab; the payload address (s->data) for a huge block. */\n",
    "__attribute__((unused)) static const void *extc_rc_ownKeyOf(const ExtcRcSlab *s) {\n",
    "    return s->big ? (const void *)s->data : (const void *)s;\n",
    "}\n",
    "/* Probe start cell: a normal slab's key is SLAB_BITS-aligned, a huge block's key is 16-byte aligned by malloc;\n",
    " * the two alignments are shifted accordingly, multiplied by the Knuth constant, and the low log2(cap) bits taken (capacity is a power of two). */\n",
    "__attribute__((unused)) static size_t extc_rc_ownProbeOf(const void *key, int big, size_t cap) {\n",
    "    uintptr_t h = big ? ((uintptr_t)key >> 4) : ((uintptr_t)key >> EXTC_RC_SLAB_BITS);\n",
    "    return (size_t)(h * 2654435761u) & (cap - 1);\n",
    "}\n",
    "/* Probe: returns the address of \"the cell holding this key\" or \"the empty cell it should occupy when inserted\". Load factor <= 1/2, so a probe\n",
    " * always meets an empty cell and never wraps a whole lap. */\n",
    "__attribute__((unused)) static ExtcRcSlab **extc_rc_ownSlotOf(ExtcRcSlab **tab, size_t cap,\n",
    "                                                              const void *key, int big) {\n",
    "    size_t i = extc_rc_ownProbeOf(key, big, cap);\n",
    "    while (tab[i] && extc_rc_ownKeyOf(tab[i]) != key) i = (i + 1) & (cap - 1);\n",
    "    return &tab[i];\n",
    "}\n",
    "/* Rehash: double the capacity (an empty table starts at 64 / 16) and re-probe the current generation's entries into the new table under the new mask.\n",
    " * Old generations are **never freed**: under parallelism another thread may still be probing one (a published pointer read before growth).\n",
    " * Publishing is done by the caller under the lock (see ownAdd / ownDel); this only builds the new generation. */\n",
    "__attribute__((unused)) static ExtcRcReg *extc_rc_ownNextReg(ExtcRcReg *cur, int big) {\n",
    "    size_t oc = cur->cap, nc = oc ? oc * 2 : (big ? 16u : 64u);\n",
    "    ExtcRcReg *nr = (ExtcRcReg *)calloc(1, sizeof *nr);\n",
    "    ExtcRcSlab **nt = (ExtcRcSlab **)calloc(nc, sizeof *nt);\n",
    "    if (!nr || !nt) extc_rc_oops(\"slab registry allocation failed\");\n",
    "    for (size_t i = 0; i < oc; i++) {\n",
    "        if (!cur->tab[i]) continue;\n",
    "        size_t j = extc_rc_ownProbeOf(extc_rc_ownKeyOf(cur->tab[i]), big, nc);\n",
    "        while (nt[j]) j = (j + 1) & (nc - 1);\n",
    "        nt[j] = cur->tab[i];\n",
    "    }\n",
    "    nr->tab = nt; nr->cap = nc; nr->n = cur->n;\n",
    "    return nr;\n",
    "}\n",
    "/* Backshift after deletion: linear probing has no tombstones, so deleting a cell means moving the later entries of the probe chain back,\n",
    " * otherwise a lookup stops early at the hole. Move condition (Knuth): the entry's start cell is not on the circular\n",
    " * run from \"hole i to its position j\", so a lookup starting from its start cell would still meet i first. */\n",
    "__attribute__((unused)) static void extc_rc_ownErase(ExtcRcSlab **tab, size_t cap,\n",
    "                                                     size_t i, int big) {\n",
    "    size_t j = i;\n",
    "    for (;;) {\n",
    "        j = (j + 1) & (cap - 1);\n",
    "        if (!tab[j]) break;\n",
    "        size_t h = extc_rc_ownProbeOf(extc_rc_ownKeyOf(tab[j]), big, cap);\n",
    "        int move = (i <= j) ? (h <= i || h > j) : (h <= i && h > j);\n",
    "        if (move) { tab[i] = tab[j]; i = j; }\n",
    "    }\n",
    "    tab[i] = (ExtcRcSlab *)0;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_ownAdd(ExtcRcSlab *s) {\n",
    "    extc_rc_regLockAcq();\n",
    "    if (s->big) {   /* huge blocks are registered by payload address in the second table */\n",
    "        ExtcRcReg *rg = extc_rc_bigCur;\n",
    "        if (!rg->cap || (rg->n + 1) * 2 > rg->cap) {\n",
    "            rg = extc_rc_ownNextReg(rg, 1);\n",
    "            __atomic_store_n(&extc_rc_bigCur, rg, __ATOMIC_RELEASE);\n",
    "        }\n",
    "        *extc_rc_ownSlotOf(rg->tab, rg->cap, s->data, 1) = s;\n",
    "        rg->n++;\n",
    "        __atomic_fetch_add(&extc_rc_regSeq, 1, __ATOMIC_RELEASE);\n",
    "        extc_rc_regUnlock();\n",
    "        return;\n",
    "    }\n",
    "    ExtcRcReg *rg = extc_rc_ownCur;\n",
    "    if (!rg->cap || (rg->n + 1) * 2 > rg->cap) {\n",
    "        rg = extc_rc_ownNextReg(rg, 0);\n",
    "        __atomic_store_n(&extc_rc_ownCur, rg, __ATOMIC_RELEASE);\n",
    "        __atomic_store_n(&extc_rc_ownMirTab, rg->tab, __ATOMIC_RELAXED);\n",
    "        __atomic_store_n(&extc_rc_ownMirCap, rg->cap, __ATOMIC_RELEASE);\n",
    "    }\n",
    "    *extc_rc_ownSlotOf(rg->tab, rg->cap, s, 0) = s;\n",
    "    rg->n++;\n",
    "    extc_rc_ownMap[extc_rc_ownHashOf(s)] = s;   /* hit cache: overwrites a colliding entry, but does not affect the decision */\n",
    "    __atomic_fetch_add(&extc_rc_regSeq, 1, __ATOMIC_RELEASE);\n",
    "    extc_rc_regUnlock();\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_ownDel(ExtcRcSlab *s) {\n",
    "    extc_rc_regLockAcq();\n",
    "    if (s->big) {\n",
    "        ExtcRcReg *rg = extc_rc_bigCur;\n",
    "        if (rg->cap) {\n",
    "            ExtcRcSlab **slot = extc_rc_ownSlotOf(rg->tab, rg->cap, s->data, 1);\n",
    "            if (*slot == s) {\n",
    "                extc_rc_ownErase(rg->tab, rg->cap, (size_t)(slot - rg->tab), 1);\n",
    "                rg->n--;\n",
    "            }\n",
    "        }\n",
    "        __atomic_fetch_add(&extc_rc_regSeq, 1, __ATOMIC_RELEASE);\n",
    "        extc_rc_regUnlock();\n",
    "        return;\n",
    "    }\n",
    "    if (extc_rc_ownHot == s) extc_rc_ownHot = (ExtcRcSlab *)0;\n",
    "    ExtcRcReg *rg = extc_rc_ownCur;\n",
    "    if (rg->cap) {\n",
    "        ExtcRcSlab **slot = extc_rc_ownSlotOf(rg->tab, rg->cap, s, 0);\n",
    "        if (*slot == s) {\n",
    "            extc_rc_ownErase(rg->tab, rg->cap, (size_t)(slot - rg->tab), 0);\n",
    "            rg->n--;\n",
    "        }\n",
    "    }\n",
    "    if (extc_rc_ownMap[extc_rc_ownHashOf(s)] == s)\n",
    "        extc_rc_ownMap[extc_rc_ownHashOf(s)] = (ExtcRcSlab *)0;\n",
    "    __atomic_fetch_add(&extc_rc_regSeq, 1, __ATOMIC_RELEASE);\n",
    "    extc_rc_regUnlock();\n",
    "}\n",
    "\n",
    "/* Look up a key in the registry: **lock-free reader**. The write side may be rehashing or inserting, so after a probe misses, check extc_rc_regSeq:\n",
    " * unchanged means this is the current generation and the key really is not in the table; changed means the read saw an old generation or an insert not yet published\n",
    " * so retry. The (tab, cap) obtained from one published-pointer read is always self-consistent, so a \"new table with old capacity\" out-of-bounds access cannot happen.\n",
    " * After the retry bound, take the lock and check once more: only a few dozen races with the write side ever get there. */\n",
    "/* Cold path (reached only on a fast-probe miss or a concurrent generation change): marked noinline -- inlining it into the three hot paths would bloat them; chase is 1.6% more Ir. */\n",
    "__attribute__((unused, noinline)) static ExtcRcSlab *extc_rc_ownFind(const void *key, int big) {\n",
    "    for (int tries = 0;; tries++) {\n",
    "        uint32_t seq = __atomic_load_n(&extc_rc_regSeq, __ATOMIC_ACQUIRE);\n",
    "        ExtcRcReg *rg = __atomic_load_n(big ? &extc_rc_bigCur : &extc_rc_ownCur, __ATOMIC_ACQUIRE);\n",
    "        if (rg->cap) {\n",
    "            ExtcRcSlab *s = *extc_rc_ownSlotOf(rg->tab, rg->cap, key, big);\n",
    "            if (s) return s;   /* skip:reg-hit */\n",
    "        }\n",
    "        if (seq == __atomic_load_n(&extc_rc_regSeq, __ATOMIC_ACQUIRE)) return (ExtcRcSlab *)0;   /* skip:reg-settled */\n",
    "        if (tries >= 32) break;   /* skip:reg-race */\n",
    "    }\n",
    "    extc_rc_regLockAcq();\n",
    "    ExtcRcReg *rg = __atomic_load_n(big ? &extc_rc_bigCur : &extc_rc_ownCur, __ATOMIC_ACQUIRE);\n",
    "    ExtcRcSlab *s = rg->cap ? *extc_rc_ownSlotOf(rg->tab, rg->cap, key, big) : (ExtcRcSlab *)0;\n",
    "    extc_rc_regUnlock();\n",
    "    return s;\n",
    "}\n",
    "/* Hot-path mirror: the current generation's (tab, cap) exposed as two globals. A fast probe then needs only two global reads (same as before the concurrency rework),\n",
    " * instead of reading the generation pointer and dereferencing it twice. Publication order is tab before cap (cap stored with RELEASE), readers read cap with ACQUIRE,\n",
    " * so \"seeing the new cap\" always means seeing the new tab; on the old cap both the old and new tab fit (a generation only grows), so no out-of-bounds.\n",
    " * The mirror is only a **hint**: a probe miss always falls back to extc_rc_ownFind's seq protocol, and reading a stale one never mistakes \"not in the table\". */\n",
    "/* Lock-free fast probe: the hot path comes here first. On a miss, use seq to tell \"authoritatively absent\" from \"the write side just moved\"; only the latter calls ownFind. */\n",
    "__attribute__((unused)) static inline ExtcRcSlab *extc_rc_ownProbeFast(const void *key, int big) {\n",
    "    if (big) {\n",
    "        ExtcRcReg *rg = __atomic_load_n(&extc_rc_bigCur, __ATOMIC_ACQUIRE);\n",
    "        if (!rg->cap) return (ExtcRcSlab *)0;   /* skip:lookup-probe */\n",
    "        return *extc_rc_ownSlotOf(rg->tab, rg->cap, key, 1);\n",
    "    }\n",
    "    /* Hot path: two global reads probe one cell (equivalent to before the concurrency rework).\n",
    "     * A miss has two causes: really not an rc slot (the common case: an arena pointer in a conservative scan), or the write side just inserted/rehashed and was not seen yet.\n",
    "     * extc_rc_regSeq distinguishes them: unchanged before and after the probe means the miss is authoritative, return 0 directly (no function call);\n",
    "     * changed, fall back to extc_rc_ownFind's seq retry protocol. */\n",
    "    uint32_t s0 = __atomic_load_n(&extc_rc_regSeq, __ATOMIC_ACQUIRE);\n",
    "    size_t cap = extc_rc_ownMirCap;\n",
    "    ExtcRcSlab *s = cap ? *extc_rc_ownSlotOf(extc_rc_ownMirTab, cap, key, 0) : (ExtcRcSlab *)0;\n",
    "    if (s || __atomic_load_n(&extc_rc_regSeq, __ATOMIC_ACQUIRE) == s0) return s;   /* skip:lookup-probe */\n",
    "    return extc_rc_ownFind(key, 0);\n",
    "}\n",
    "\n",
    "/* If this pointer lands in a **registered rc slab** and is exactly a slot head, return that slab, else 0.\n",
    " *\n",
    " * A normal slab uses its own alignment relation (one bitwise AND + one registry probe), so this path has the same instruction count as\n",
    " * without huge blocks; only huge blocks (payload not in an aligned block) fall to exact matching in the second table; they have\n",
    " * one slot and accept only the slot head. Both paths accept only slot heads: a pointer into an object always returns 0 (the next soundness obligation). */\n",
    "__attribute__((unused)) static ExtcRcSlab *extc_rc_ownBig(void *p) {\n",
    "    ExtcRcReg *rg = __atomic_load_n(&extc_rc_bigCur, __ATOMIC_ACQUIRE);\n",
    "    if (!rg->cap) return (ExtcRcSlab *)0;   /* skip:lookup-probe */\n",
    "    /* Same protocol as the normal table's fast probe: read seq, probe a cell, read seq again on a miss -- unchanged means\n",
    "     * \"authoritatively absent\" (really not a huge block); changed means the write side just inserted/rehashed, so use ownFind's retry.\n",
    "     * Without this check, under parallelism a **just-registered** huge block could be treated as \"not in the table\", hence as outside the region\n",
    "     * (the conservative direction: retain more, never miss a collection), but that is an accidental behavior difference, not the design. */\n",
    "    uint32_t s0 = __atomic_load_n(&extc_rc_regSeq, __ATOMIC_ACQUIRE);\n",
    "    ExtcRcSlab *s = *extc_rc_ownSlotOf(rg->tab, rg->cap, p, 1);\n",
    "    if (!s && __atomic_load_n(&extc_rc_regSeq, __ATOMIC_ACQUIRE) != s0) s = extc_rc_ownFind(p, 1);\n",
    "    if (!s) return (ExtcRcSlab *)0;   /* skip:lookup-probe */\n",
    "    return (uintptr_t)s->data == (uintptr_t)p ? s : (ExtcRcSlab *)0;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static inline ExtcRcSlab *extc_rc_ownSlab(void *p) {\n",
    "    /* A null pointer is not checked separately: p == 0 means base == 0, and no key 0 exists in the map cell, registry or huge-block table\n",
    "     * (neither a slab base nor a huge-block payload address can be 0), so every probe level misses and ownBig returns 0 too;\n",
    "     * the result is identical byte for byte to an explicit check, minus one comparison per call (2 Ir on the hot path). */\n",
    "    void *base = (void *)((uintptr_t)p & ~(uintptr_t)(EXTC_RC_SLAB_SIZE - 1));\n",
    "    ExtcRcSlab *hot = extc_rc_ownHot;\n",
    "    if (hot && (void *)hot == base) {          /* skip:own-hot */\n",
    "        size_t off = extc_rc_offOf(hot, p);\n",
    "        size_t k = extc_rc_slotOfOff(hot, off);\n",
    "        if (k < hot->nslots && k * hot->ss == off) return hot; /* skip:own-hot */\n",
    "        return extc_rc_ownBig(p);\n",
    "    }\n",
    "    ExtcRcSlab *s = extc_rc_ownMap[extc_rc_ownHashOf(base)];\n",
    "    /* `s` must be nonzero: `base` can be 0 (a small non-pointer integer sitting in a field, which `unlinkChildren` reads\n",
    "     * as a candidate reference) -- the empty map cell is 0 too, so \"equal\" is not \"hit\". */\n",
    "    if (s && (void *)s == base) {            /* hit: s is exactly slabOf(p) */\n",
    "        size_t off = extc_rc_offOf(s, p);\n",
    "        size_t k = extc_rc_slotOfOff(s, off);\n",
    "        if (k < s->nslots && k * s->ss == off) { extc_rc_ownHot = s; return s; }   /* skip:lookup-probe */\n",
    "        return extc_rc_ownBig(p);\n",
    "    }\n",
    "    {   /* miss/collision: probe the registry (open addressing), semantics identical to \"take the candidate then validate\" */\n",
    "        s = extc_rc_ownProbeFast(base, 0);\n",
    "        if (s) {\n",
    "            size_t off = extc_rc_offOf(s, p);\n",
    "            size_t k = extc_rc_slotOfOff(s, off);\n",
    "            if (k < s->nslots && k * s->ss == off) { extc_rc_ownHot = s; return s; }   /* skip:lookup-probe */\n",
    "        }\n",
    "    }\n",
    "    return extc_rc_ownBig(p);\n",
    "}\n",
    "/* A slab-of copy dedicated to the marking step: the body is **word-for-word the same** as the other one, only forced inline.\n",
    " *\n",
    " * Why copy instead of marking the other one always_inline: that path would inline it at **every** call site,\n",
    " * and shapes like cross_region lose two tenths when bloated elsewhere (register pressure); see the\n",
    " * corresponding devlog/changelog entry. The marking step is the hottest call site in the runtime, so it alone gets a copy.\n",
    " *\n",
    " * The two bodies must stay word-for-word identical: tools/check_ownslab_body.py compares them after normalizing the function name,\n",
    " * so changing one and forgetting the other turns the battery red. */\n",
    "__attribute__((unused)) static inline __attribute__((always_inline)) ExtcRcSlab *extc_rc_ownSlabMark(void *p) {\n",
    "    /* A null pointer is not checked separately: p == 0 means base == 0, and no key 0 exists in the map cell, registry or huge-block table\n",
    "     * (neither a slab base nor a huge-block payload address can be 0), so every probe level misses and ownBig returns 0 too;\n",
    "     * the result is identical byte for byte to an explicit check, minus one comparison per call (2 Ir on the hot path). */\n",
    "    void *base = (void *)((uintptr_t)p & ~(uintptr_t)(EXTC_RC_SLAB_SIZE - 1));\n",
    "    ExtcRcSlab *hot = extc_rc_ownHot;\n",
    "    if (hot && (void *)hot == base) {          /* skip:own-hot */\n",
    "        size_t off = extc_rc_offOf(hot, p);\n",
    "        size_t k = extc_rc_slotOfOff(hot, off);\n",
    "        if (k < hot->nslots && k * hot->ss == off) return hot; /* skip:own-hot */\n",
    "        return extc_rc_ownBig(p);\n",
    "    }\n",
    "    ExtcRcSlab *s = extc_rc_ownMap[extc_rc_ownHashOf(base)];\n",
    "    /* `s` must be nonzero: `base` can be 0 (a small non-pointer integer sitting in a field, which `unlinkChildren` reads\n",
    "     * as a candidate reference) -- the empty map cell is 0 too, so \"equal\" is not \"hit\". */\n",
    "    if (s && (void *)s == base) {            /* hit: s is exactly slabOf(p) */\n",
    "        size_t off = extc_rc_offOf(s, p);\n",
    "        size_t k = extc_rc_slotOfOff(s, off);\n",
    "        if (k < s->nslots && k * s->ss == off) { extc_rc_ownHot = s; return s; }   /* skip:lookup-probe */\n",
    "        return extc_rc_ownBig(p);\n",
    "    }\n",
    "    {   /* miss/collision: probe the registry (open addressing), semantics identical to \"take the candidate then validate\" */\n",
    "        s = extc_rc_ownProbeFast(base, 0);\n",
    "        if (s) {\n",
    "            size_t off = extc_rc_offOf(s, p);\n",
    "            size_t k = extc_rc_slotOfOff(s, off);\n",
    "            if (k < s->nslots && k * s->ss == off) { extc_rc_ownHot = s; return s; }   /* skip:lookup-probe */\n",
    "        }\n",
    "    }\n",
    "    return extc_rc_ownBig(p);\n",
    "}\n",
    "\n",
    "/* An rc-allocated slot that is **still occupied** is the only thing allowed to be counted/registered/marked. */\n",
    "__attribute__((unused)) static int extc_rc_owns(void *p) {\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(p);\n",
    "    if (!s) return 0;   /* skip:not-own */\n",
    "    if (s->region->dead) return 0;   /* skip:dead-region: the slots of a dropped region stop being live at the drop, not at the free */\n",
    "    size_t k = extc_rc_slotOf(s, p);\n",
    "    return (s->occ[extc_rc_word(k)] & extc_rc_bit(k)) != 0;\n",
    "}\n",
    "\n",
    "/* Slot size: round up in **8-byte** units, at least enough for the 8-byte slot head of the free chain.\n",
    " * Not a power of two: power-of-two rounding makes an 80-byte object take a 128-byte slot (+60% internal fragmentation);\n",
    " * rounding by 8 means a batch of payloads leaves no remainder per stride (a 24-byte object takes 24 bytes, not 8 more).\n"
    " * 8 is **sufficient** granularity: the largest natural alignment in the language is 8 -- the builtin types are only i8..i64 / u8..u64 / f32 / f64 / bool\n"
    " * (BUILTIN_NAMES in src/types/types.c), and structs / enums / arrays / references / function pointers / dyn are all built from them\n"
    " * (there are no vector or 128-bit kinds in TypeKind in src/ast/ast.h), so no payload needs a larger alignment;\n"
    " * slot indexing uses reciprocal multiply and shift (see extc_rc_rcpOf), which does not require a power-of-two stride anyway. */\n",
    "/* Why force inline: an allocation site often has a constant n (sizeof a type); after inlining the slot stride here is a constant, so\n",
    " * `memset(p, 0, ss)` can expand into fixed-length inline stores instead of a libc call per allocation;\n",
    " * dynamic-n call sites also save a call/return (criterion: check_slot_unit pins the signature and the slot-size rule). */\n",
    "__attribute__((unused)) static inline __attribute__((always_inline)) size_t extc_rc_slotSize(size_t n) {\n",
    "    size_t s = (n + 7) & ~(size_t)7;\n",
    "    if (s <= 16 && n > 16) extc_rc_oops(\"slot size overflow\");   /* only possible if n itself overflowed */\n",
    "    return s > 16 ? s : 16;\n",
    "}\n",
    "\n",
    "/* Type number: register a descriptor into this slab's small type table and return the per-slot number (see ExtcRcSlab's tid).\n",
    " * Deduplicated by **pointer equality** -- a descriptor is a block-scope static const emitted by the allocation site, unique for the whole process\n",
    " * and never moves, so one comparison suffices. If the table is full (65k distinct descriptors crammed into one slab) it traps: silently falling back to 0\n",
    " * would make marking skip this object's reference fields, hence free it early -- an **unsafe** direction; better to fail loudly on the spot.\n",
    " *\n",
    " * Deduplicated lookup has two paths: a slab with few descriptors (the common case: one size class usually gets one or two allocation sites) scans linearly;\n",
    " * past EXTC_RC_TTAB_LINEAR_MAX a 16-bit open-addressing index is built (descriptor pointer to ttab index),\n",
    " * after which every allocation is O(1) and independent of the number of types this slab has seen -- when generic monomorphization crams a thousand allocation sites into\n",
    " * one size class, the linear scan becomes dozens of instructions per allocation. */\n",
    "#define EXTC_RC_TTAB_LINEAR_MAX 8u\n",
    "__attribute__((unused)) static size_t extc_rc_ttabProbeOf(const ExtcRcType *td, size_t cap) {\n",
    "    return (size_t)(((uintptr_t)td >> 3) * 2654435761u) & (cap - 1);\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_ttabIndexBuild(ExtcRcSlab *s, size_t cap) {\n",
    "    uint16_t *nt = (uint16_t *)calloc(cap, sizeof *nt);\n",
    "    if (!nt) extc_rc_oops(\"slab type index allocation failed\");\n",
    "    for (uint32_t k = 2; k < s->ttabN; k++) {\n",
    "        size_t i = extc_rc_ttabProbeOf(s->ttab[k], cap);\n",
    "        while (nt[i]) i = (i + 1) & (cap - 1);\n",
    "        nt[i] = (uint16_t)k;\n",
    "    }\n",
    "    free(s->thash);\n",
    "    s->thash = nt;\n",
    "    s->thashCap = (uint32_t)cap;\n",
    "}\n",
    "__attribute__((unused)) static uint16_t extc_rc_typeIdxSlow(ExtcRcSlab *s, const ExtcRcType *td) {\n",
    "    if (s->thash) {   /* index built: one probe (load factor <= 1/2, so an empty cell exists) */\n",
    "        size_t i = extc_rc_ttabProbeOf(td, s->thashCap);\n",
    "        while (s->thash[i]) {\n",
    "            uint16_t k = s->thash[i];\n",
    "            if (s->ttab[k] == td) return k;   /* skip:ttab-hit */\n",
    "            i = (i + 1) & (s->thashCap - 1);\n",
    "        }\n",
    "    } else {\n",
    "        for (uint32_t k = 2; k < s->ttabN; k++) if (s->ttab[k] == td) return (uint16_t)k;\n",
    "    }\n",
    "    if (s->ttabN == 0xFFFFu) extc_rc_oops(\"slab type table overflow\");\n",
    "    if (s->ttabN == s->ttabCap) {\n",
    "        uint32_t nc = s->ttabCap * 2;\n",
    "        const ExtcRcType **nt = (const ExtcRcType **)realloc(s->ttab, nc * sizeof *nt);\n",
    "        if (!nt) extc_rc_oops(\"slab type table allocation failed\");\n",
    "        s->ttab = nt;\n",
    "        s->ttabCap = nc;\n",
    "    }\n",
    "    uint16_t k = (uint16_t)s->ttabN;\n",
    "    s->ttab[k] = td;\n",
    "    s->ttabN++;\n",
    "    if (!s->thash) {\n",
    "        if (s->ttabN - 2u > EXTC_RC_TTAB_LINEAR_MAX) extc_rc_ttabIndexBuild(s, 32u);\n",
    "    } else if (s->ttabN - 2u > s->thashCap / 2u) {\n",
    "        extc_rc_ttabIndexBuild(s, (size_t)s->thashCap * 2u);\n",
    "    } else {\n",
    "        size_t i = extc_rc_ttabProbeOf(td, s->thashCap);\n",
    "        while (s->thash[i]) i = (i + 1) & (s->thashCap - 1);\n",
    "        s->thash[i] = k;\n",
    "    }\n",
    "    return k;\n",
    "}\n",
    "__attribute__((unused)) static inline uint16_t extc_rc_typeIdx(ExtcRcSlab *s, const ExtcRcType *td) {\n",
    "    if (!td) return 0;   /* data object: no reference fields to walk */   /* skip:no-desc */\n",
    "    if (td == s->lastTd) return s->lastTid;   /* skip:type-hot */\n",
    "    /* Number 1 is always the fallback descriptor, bypassing the table lookup. */\n",
    "    uint16_t k = (uint16_t)(td == EXTC_RC_CONSERVATIVE ? 1u : (uint32_t)extc_rc_typeIdxSlow(s, td));\n",
    "    s->lastTd = td;   /* filled after the table insert succeeds: consecutive same-type allocations on one slab look up only the first */\n",
    "    s->lastTid = k;\n",
    "    return k;\n",
    "}\n",
    "/* Number to descriptor. Number 0 is null (no reference fields). Each slot stores only 2 bytes, at the cost of one extra table read here;\n",
    " * the table usually has one or two entries, and the mark/release paths walk the pointer fields by descriptor anyway. */\n",
    "__attribute__((unused)) static inline const ExtcRcType *extc_rc_typeOf(const ExtcRcSlab *s, size_t i) {\n",
    "    uint16_t k = s->tid[i];\n",
    "    return k ? s->ttab[k] : (const ExtcRcType *)0;\n",
    "}\n",
    "\n",
    "/* Allocate a slab.\n",
    " *\n",
    " * Slots round to 8 bytes. A slab's **issued capacity** (cap x slot size) is its whole block: the slots run from the header to the end of the\n",
    " * block, so a class leaves no hole at the tail (a chunk smaller than the block would hand out only part of it). Alignment and \"finding the slab\n",
    " * from a pointer is one bitwise AND\" still hold, and EXTC_RC_SLAB_CHUNK_MIN is that block size; it doubles up to EXTC_RC_SLAB_SIZE only for a\n",
    " * configuration that lowers it. When a slot is too big for one slab\n",

    " * to hold two (slot > (EXTC_RC_SLAB_SIZE - header)/2 ~ 64 KiB) it does **not** trap: the header stays, the payload is malloc'd\n",
    " * separately and nslots = 1 -- call it a **huge block**. It is not a second reclaim path: bitmaps, per-slot type descriptor,\n",
    " * holder count, cross-region registration, marking and sweeping all go through the functions above; the only difference is **where the payload is**\n",
    " * (`EXTC_RC_SLAB_DATA`). So a huge block is neither swept as garbage nor missed. */\n",
