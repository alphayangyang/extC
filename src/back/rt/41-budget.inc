    "/* ---- Unified work budget (`EXTC_RC_WORK_BUDGET`, default 0 = off) [rt:budget] ----\n",
    " *\n",
    " * off (0): the three budgets are **independent** -- walk (`MARK_BATCH_MAX`), seed word scan (`SEED_WORDS`),\n",
    " * seed pushes (`SEED_PUSHES`) -- and the three **stack in one step**; the `wbDebt` boost is counted separately.\n",
    " * on (W>0): the three plus assist share **one total** `W` (walk 1 object = 1, scan 1 word = 1,\n",
    " * push 1 slot = 1), deducted from one counter `wleft` in `markStep`; it stops at 0 (the seed phase deducts too).\n",
    " * So one step's total work is **bounded by construction to <= W**, independent of scheduling and checkable verbatim by the gate.\n",
    " *\n",
    " * `EXTC_RC_WORK_BUDGET` comes from a C compile-time `-D` (the generated file has an `#ifndef` fallback), so scanning W does not need\n",
    " * rebuilding the compiler. */\n",
    "#ifndef EXTC_RC_WORK_BUDGET\n",
    "#define EXTC_RC_WORK_BUDGET 0   /* 0 = off: three separate budgets; >0 = one total W per step */\n",
    "#endif\n",
    "/** @brief Budget of this step: base step + debt, **capped** (the window-bound guarantee). */\n",
    "__attribute__((unused)) static size_t extc_rc_stepBudget(const ExtcRcRegion *r) {\n",
    "    size_t d = r->wbDebt > 64 ? 64 : r->wbDebt;   /* at most 64 debts repaid per allocation (shading ~1-2/allocation, so drain>=shade still holds) */\n",
    "    extc_rc_stepAssist = d;   /* assist share: the debt boost (counted in the same total under the unified budget) */\n",
    "    return EXTC_RC_MARK_STEP + d;\n",
    "}\n",
    "/* Batched advance + window cap: one step every EXTC_RC_MARK_EVERY allocations; past the window it boosts. */\n",
    "/* Inline: every dispatch point on the allocation path goes through here, and -O1 does not inline across call sites, so each pass adds a call/return;\n",
    " * the body is only a counter decrement and a capped computation, so inlining it into the allocation body barely grows. */\n",
    "__attribute__((unused)) static inline __attribute__((always_inline)) size_t extc_rc_markAdvance(ExtcRcRegion *r) {\n",
    "if (--r->markTick > 0) return 0;   /* skip:mark-tick */\n",
    "    extc_rc_why = \"advance\";\n",
    "    r->markTick = EXTC_RC_MARK_EVERY;\n",
    "    int _pm = extc_rc_pressure(r) ? EXTC_RC_SWEEP_PRESSURE_MUL : 1;   /* pressure grows the step budget, not the tick spacing */\n",

    "    if (_pm > 1) extc_rc_pressureN++;\n",

    "    size_t _debt = r->wbDebt > EXTC_RC_ASSIST_CAP ? EXTC_RC_ASSIST_CAP : r->wbDebt;\n",

    "    size_t b = ((size_t)EXTC_RC_MARK_EVERY * EXTC_RC_MARK_STEP + _debt) * (size_t)_pm;   /* debt cap (the purpose of ASSIST_CAP) */\n",

    "    extc_rc_stepAssist = _debt;   /* assist share (counted in the same total under the unified budget) */\n",
    "    if (r->allocBytes - r->markStartAlloc > EXTC_RC_MARK_WINDOW) b *= 8;\n",
    "    if (b > (size_t)EXTC_RC_MARK_BATCH_MAX * (size_t)_pm) b = (size_t)EXTC_RC_MARK_BATCH_MAX * (size_t)_pm;   /* last window bound: never unlimited (multiplier capped at 16) */\n",
    "    if (r->live > (int64_t)EXTC_RC_MARK_COLD_BYTES && b > (size_t)EXTC_RC_MARK_COLD_BATCH) { b = (size_t)EXTC_RC_MARK_COLD_BATCH; extc_rc_markColdN++; }   /* cold tier: a pop is a memory miss, so hold the same pause with fewer pops */\n",

    "#if EXTC_RC_WORK_BUDGET > 0\n",
    "    if (b > EXTC_RC_WORK_BUDGET) b = EXTC_RC_WORK_BUDGET;   /* under the unified budget the walk budget may not exceed the total either */\n",
    "#endif\n",
    "    unsigned long long _w0 = r->markWork;\n",
    "    extc_rc_markStep(r, b);\n",
    "    r->wbDebt = 0;\n",
    "    if (r->seedsDone && !r->msp && !r->scanObj) r->markDone = 1;\n",
    "    return (size_t)(r->markWork - _w0);   /* P0-P: work units this advance consumed (pops + words + seg), for the byte quota */\n",
    "}\n",
    "/* Allocation-point expansion: the allocation body is only a few dozen instructions, and **every allocation point** calls it once. Without expansion each allocation pays\n",
    " * a call plus frame push/pop (-O1: about 13.5 Ir per allocation, close to a third of the allocation cost); with expansion the compiler can also fold the constant\n",
    " * n (size class, zeroing length become immediates). The cost is one copy of the allocation body per allocation point (about 2.7 KB of\n",
    " * machine code): a program with unusually many allocation points can pass -DEXTC_RC_ALLOC_INLINE=0 to trade back size (that variant is declared noinline\n",
    " * so only one function body remains and each allocation pays one more call/return), word-for-word identical semantics.\n",
    " * Attributes go through a macro and the signature exists once: two signatures would give the same function two opening braces, and the structural gate that splits function bodies by brace balance\n",
    " * (check_foreign_skip) would then count the following bodies as part of it.\n",
    " * Criterion: check_alloc_hot pins this switch, the attribute macro and the noinline exit (removing either turns it red). */\n",
    "#ifndef EXTC_RC_ALLOC_INLINE\n",
    "#define EXTC_RC_ALLOC_INLINE 1\n",
    "#endif\n",
    "/* Account the memory a queued slab holds: payload (a huge block's payload is a separate malloc) + bitmaps + per-slot arrays + header. */\n",
    "__attribute__((unused)) static int64_t extc_rc_fqSlabBytes(const ExtcRcSlab *s) {\n",
    "    int64_t b;\n",
    "    if (s->big) b = (int64_t)sizeof(ExtcRcSlab) + (int64_t)s->ss;   /* header struct + separately malloc'd payload */\n",
    "    else b = (int64_t)EXTC_RC_SLAB_SIZE;                             /* the whole aligned block (header + payload) */\n",
    "    b += (int64_t)s->nwords * 8 * 3;                                 /* occ / mark / rsbit */\n",
    "    if (s->hold) b += (int64_t)s->nslots * 2;\n",
    "    if (s->rscnt) b += (int64_t)s->nslots * 2;\n",
    "    b += (int64_t)s->nslots * 2;                                     /* tid[] */\n",
    "    if (s->ttab) b += (int64_t)s->ttabCap * 2;\n",
    "    return b;\n",
    "}\n",
    "/* Queue a whole slab chain (already unlinked from the registry). Returns the bytes now queued by this chain. */\n",
    "__attribute__((unused)) static int64_t extc_rc_fqPushChain(ExtcRcSlab *h) {\n",
    "    if (!h) return 0;   /* skip:freeq-none */\n",
    "    int64_t bytes = 0;\n",
    "    long long n = 0;\n",
    "    ExtcRcSlab *s = h;\n",
    "    ExtcRcSlab *tail = h;\n",
    "    while (s) { bytes += extc_rc_fqSlabBytes(s); n++; tail = s; s = s->next; }\n",
    "    tail->next = extc_rc_fqHead;\n",
    "    extc_rc_fqHead = h;\n",
    "    extc_rc_fqSlabs += n;\n",
    "    extc_rc_fqBytes += bytes;\n",
    "    if (extc_rc_fqSlabs > extc_rc_fqMaxSlabs) extc_rc_fqMaxSlabs = extc_rc_fqSlabs;\n",
    "    if (extc_rc_fqBytes > extc_rc_fqMaxBytes) extc_rc_fqMaxBytes = extc_rc_fqBytes;\n",
    "    return bytes;\n",
    "}\n",
    "/* Drain queued slabs. maxSlabs <= 0 means no slab limit, deadlineUs <= 0 means no time limit; whichever limit comes first stops the pass. */\n",
    "__attribute__((unused)) static long long extc_rc_fqDrainCore(long long maxSlabs, long long deadlineUs) {\n",
    "    long long done = 0;\n",
    "    long long t0 = deadlineUs > 0 ? extc_rc_pauseNow() : 0;\n",
    "    while (extc_rc_fqHead) {\n",
    "        if (maxSlabs > 0 && done >= maxSlabs) break;   /* skip:freeq-budget */\n",
    "        if (deadlineUs > 0 && extc_rc_pauseNow() - t0 >= deadlineUs * 1000) break;   /* skip:freeq-deadline */\n",
    "        ExtcRcSlab *s = extc_rc_fqHead;\n",
    "        extc_rc_fqHead = s->next;\n",
    "        extc_rc_fqSlabs--;\n",
    "        extc_rc_fqBytes -= extc_rc_fqSlabBytes(s);\n",
    "        free(s->occ); free(s->mark); free(s->rsbit); free(s->hold); free(s->rscnt); free(s->wmark);\n",
    "        free(s->tid); free(s->ttab); free(s->thash);\n",
    "        if (s->big) extc_rc_bigPayloadRelease(s->data, s->ss);\n",
    "        free(s);\n",
    "        done++;\n",
    "    }\n",
    "    if (done > 0) __atomic_fetch_add(&extc_rc_fqDrained, done, __ATOMIC_RELAXED);\n",
    "    return done;\n",
    "}\n",
    "/* Bounded drain at an allocation/settle point: normal budget, or the hard deadline while the queued bytes are over the limit. */\n",
    "__attribute__((unused)) static void extc_rc_fqDrainAuto(void) {\n",
    "    /* Closing queue first: it is the precondition for the free queue (a dropped region's slabs must be unlinked from the\n",
    "     * registry and their cross-region edges undone before their memory goes), and it is budgeted the same way. */\n",
    "    if (extc_rc_cqHead) extc_rc_cqDrainCore(EXTC_RC_FREE_BUDGET_SLABS, EXTC_RC_FREE_DEADLINE_US);   /* skip:closing-empty */\n",
    "    if (extc_rc_bdHead) extc_rc_bigTrimStep((size_t)EXTC_RC_BIG_DROP_BYTES);   /* huge payload drop: one budgeted chunk, independent of the free queue */\n",
    "    if (!extc_rc_fqHead) return;   /* skip:freeq-empty */\n",
    "    if (extc_rc_fqBytes > (int64_t)EXTC_RC_FREE_QUEUE_BYTES) {\n",
    "        __atomic_fetch_add(&extc_rc_fqForced, 1, __ATOMIC_RELAXED);\n",
    "        extc_rc_fqDrainCore(0, EXTC_RC_FREE_HARD_DEADLINE_US);\n",
    "        return;\n",
    "    }\n",
    "    extc_rc_fqDrainCore(EXTC_RC_FREE_BUDGET_SLABS, EXTC_RC_FREE_DEADLINE_US);\n",
    "}\n",
    "/* Full drain: the only unbounded entry. Called by a worker/task at exit (and by the driver); the process exit path may leave the queue,\n",
    " * in which case the OS reclaims it and [freequeue] reports the leftover. */\n",
    "__attribute__((unused)) static void extc_rc_freeQueueDrainAll(void) {\n",
    "    while (extc_rc_cqHead) extc_rc_cqDrainCore(0, 0);   /* the closing queue must become empty too: its regions are dead */\n",
    "    if (extc_rc_bdHead) extc_rc_bigTrimStep((size_t)1 << 30);   /* the only unbounded drop: the exit path returns every pending payload */\n",
    "    if (!extc_rc_fqHead) return;   /* skip:freeq-empty */\n",
    "    extc_rc_fqDrainCore(0, 0);\n",
    "}\n",
    "#if EXTC_RC_ALLOC_INLINE\n",
    "#define EXTC_RC_ALLOC_DECL __attribute__((always_inline)) inline\n",
    "#else\n",
    "#define EXTC_RC_ALLOC_DECL __attribute__((noinline))\n",
    "#endif\n",
    "/* Zero a fresh slot with fixed-length stores instead of a library call.\n",
    " * memset(p, 0, ss) stays a call even at a constant stride: the fortified glibc headers (a default in the distro build)\n",
    " * map it to __memset_chk, whose destination-size check cannot be folded away, so a 32-byte object still pays call +\n",
    " * check + library tail instead of the two stores it needs. A switch on the stride -- always a multiple of 8, and <= 128\n",
    " * for the sizes that carry the allocation traffic -- is a jump table plus at most sixteen 8-byte stores; larger strides\n",
    " * keep the library call. The language promise (a fresh allocation reads as zero) is unchanged.\n",
    " * Criterion: the allocation fast path keeps a single zeroing site, and the wall time of a pure-churn shape drops without\n",
    " * touching the bytes handed out (the slot data is 64-byte aligned, so the 8-byte stores are aligned). */\n",
    "__attribute__((unused)) static inline void extc_rc_zeroSmall(void *p, size_t n) {\n",
    "    uint64_t *q = (uint64_t *)p;\n",
    "    switch (n >> 3) {\n",
    "    case 16: q[15] = 0; /* fallthrough */\n",
    "    case 15: q[14] = 0; /* fallthrough */\n",
    "    case 14: q[13] = 0; /* fallthrough */\n",
    "    case 13: q[12] = 0; /* fallthrough */\n",
    "    case 12: q[11] = 0; /* fallthrough */\n",
    "    case 11: q[10] = 0; /* fallthrough */\n",
    "    case 10: q[9] = 0; /* fallthrough */\n",
    "    case 9: q[8] = 0; /* fallthrough */\n",
    "    case 8: q[7] = 0; /* fallthrough */\n",
    "    case 7: q[6] = 0; /* fallthrough */\n",
    "    case 6: q[5] = 0; /* fallthrough */\n",
    "    case 5: q[4] = 0; /* fallthrough */\n",
    "    case 4: q[3] = 0; /* fallthrough */\n",
    "    case 3: q[2] = 0; /* fallthrough */\n",
    "    case 2: q[1] = 0; /* fallthrough */\n",
    "    case 1: q[0] = 0; break;\n",
    "    default: memset(p, 0, n); break;\n",
    "    }\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static EXTC_RC_ALLOC_DECL void *extc_rc_alloc(ExtcRcRegion *r, size_t n, const ExtcRcType *td) {\n",
    "    EXTC_RC_TICK(0);   /* per-component timing (`EXTC_RC_TIME=1`) */\n",
    "    extc_rc_notePart(r);\n",
    "    /* Stepped continuation sweep; obligation 7: a dropped region is never scanned again (not one byte). */\n",
    "    if (r->sweeping) {\n",
    "        extc_rc_why = \"alloc\";   /* slow-step attribution: only this branch advances the sweep on an allocation's behalf; mark advance writes\n",
    "                                    * \"advance\" itself and finish/collect write their own, so there is no unconditional store at entry\n",
    "                                    * (one store saved per allocation; the `why` in `[step]`/`[worst]` logs is unchanged word for word). */\n",
    "        if (r->noSweep) r->sweeping = 0;   /* skip:nosweep-abandon */\n",
    "else {\n",
    "uint32_t _b = EXTC_RC_SWEEP_BUDGET * (uint32_t)(extc_rc_pressure(r) ? EXTC_RC_SWEEP_PRESSURE_MUL : 1);\n",
    "ExtcRcSlab *_cs = r->swSlab;\n",
    "uint32_t _q = _cs ? (uint32_t)(((uint32_t)_cs->nslots + 63u) >> 6) : 1u;   /* words to finish the slab at the cursor */\n",
    "if (_q < 1u) _q = 1u;\n",
    "if (_q > EXTC_RC_SWEEP_FINISH_MAX) _q = EXTC_RC_SWEEP_FINISH_MAX;   /* the credit does not scale with the block: a 512 KiB block of 16 B slots would otherwise free 32k slots here */\n",
    "_b += _q;   /* P0-P: one allocation funds finishing the slab under the cursor, at most SWEEP_FINISH_MAX words of it */\n",
    "extc_rc_sweepStep(r, _b);\n",
    "        }\n",

    "    }\n",
    "    if (r->marking) {\n",
    "if (r->msp != 0 || !r->seedsDone || r->scanObj) {\n",
    "    size_t _quota = (size_t)(n >> EXTC_RC_QUOTA_SHIFT_MARK);\n",
    "    if (_quota > (size_t)EXTC_RC_QUOTA_MAX_MARK) { _quota = (size_t)EXTC_RC_QUOTA_MAX_MARK; }\n",
    "    size_t _used = 0;\n",
    "#if EXTC_RC_QUOTA_DEADLINE_US > 0\n",
    "    /* Checked only for quotas big enough to overrun the ceiling, so the clock never lands on the small-allocation path. The\n",
    "     * clock is read after **every** advance: a descriptor field scan (one pop can walk up to nptr fields) does not show up in\n",
    "     * the work units, so a work-unit tick would miss it. Bound: D + 2 segments (the first advance and the in-flight advance\n",
    "     * that trips the deadline; one segment is <= SCAN_CHUNK words). */\n",
    "    long long _dl0 = _quota >= 4096 ? extc_rc_pauseNow() : -1;\n",
    "#endif\n",
    "    for (;;) {\n",
    "        _used += extc_rc_markAdvance(r);\n",
    "#if EXTC_RC_QUOTA_DEADLINE_US > 0\n",
    "        if (_dl0 >= 0) {\n",
    "            extc_rc_quotaChecks++;\n",
    "            extc_rc_quotaChecksRound++;\n",
    "            if (extc_rc_pauseNow() - _dl0 >= (long long)EXTC_RC_QUOTA_DEADLINE_US * 1000) {\n",
    "                extc_rc_quotaDeadlineHits++;\n",
    "                extc_rc_quotaHitsRound++;\n",
    "                break;\n",
    "            }\n",
    "        }\n",
    "#endif\n",
    "        if (_used >= _quota) break;\n",
    "        if (!(r->msp != 0 || !r->seedsDone || r->scanObj)) break;\n",
    "    }\n",
    "}\n",
    "        /* The finish guard is hoisted to the call site: the first line of finish is exactly this test (here inside the marking branch,\n",
    "         * only seedsDone/msp differ), and most allocation-point calls are just call + return + early exit\n",
    "         * (once per allocation while marking). Testing in place saves that call; the guard inside finish stays as\n",
    "         * defence in depth (other entries do not come through here). */\n",
    "        if (r->seedsDone && r->msp == 0 && !r->scanObj) extc_rc_finish(r);   /* once done, **close the barrier on the spot**: otherwise this round would idle for tens of thousands of allocations */\n",
    "    }\n",
    "    size_t ss = extc_rc_slotSize(n);\n",
    "    size_t ac = ss / 8;   /* size class = slot stride / 8 (the slot stride is guaranteed to be a multiple of 8) */\n",
    "    ExtcRcSlab **hot = ac < 32 ? &r->allocHot[ac] : (ExtcRcSlab **)0;\n",
    "    ExtcRcSlab *s = hot ? *hot : (ExtcRcSlab *)0;\n",
    "    /* Do not verify s->ss == ss: allocHot is written only by this function (the only write is *hot = s below), and s can only\n",
    "     * come from classSlot(r, ss) or slabNew(r, ss) -- both bind the same size class, and a block's slot stride never changes in its life\n",
    "     * so a cached block belongs to the same size class. Saves one comparison per allocation (criterion: check_alloc_hot pins \"no repeated size check\"). */\n",
    "#if EXTC_RC_LAZY_FREE\n",
    "    if (!s || (s->bump >= s->nslots && s->nfree == 0)) {\n",
    "#else\n",
    "    if (!s || (s->freelist < 0 && s->bump >= s->nslots)) {\n",
    "#endif\n",
    "        /* A block is full when every slot was issued and no hole is pending; otherwise the reuse chain or the bump cursor has one.\n",
    "         * EXTC_RC_LAZY_FREE counts the holes instead of linking each one, and the test keeps the same shape in both branches. */\n",
    "        ExtcRcClass *c = extc_rc_classSlot(r, ss);\n",
    "        s = c ? c->head : (ExtcRcSlab *)0;\n",
    "#if EXTC_RC_LAZY_FREE\n",
    "        while (s && s->bump >= s->nslots && s->nfree == 0) {\n",
    "#else\n",
    "        while (s && s->freelist < 0 && s->bump >= s->nslots) {\n",
    "#endif\n",
    "            c->head = s->availNext; if (c->head) c->head->availPrev = (ExtcRcSlab *)0;\n",
    "            s->avail = 0;   /* off the chain */\n",
    "            s = c->head;\n",
    "        }\n",
    "    }\n",
    "    if (!s) {\n",
    "        s = extc_rc_slabNew(r, ss);\n",
    "        s->prev = (ExtcRcSlab *)0; if (r->slabs) r->slabs->prev = s; s->next = r->slabs;\n",
    "        r->slabs = s;\n",
    "        extc_rc_classPush(r, s);   /* new block onto the size-class chain: later fetch is O(1) */\n",
    "    }\n",
    "    if (hot) *hot = s;\n",
    "    size_t i;\n",
    "#if EXTC_RC_LAZY_FREE\n",
    "    if (s->freelist >= 0) {                   /* a slot released earlier (hot path or sweep): pop it */\n",
    "        i = (size_t)s->freelist;\n",
    "        s->freelist = (int64_t)s->tid[i] - 1;\n",
    "        s->nfree--;\n",
    "    } else if (s->bump < s->nslots) {\n",
    "        i = (size_t)s->bump++;                /* never issued yet: advance the cursor */\n",
    "        if (s->rscnt) s->rscnt[i] = 0;\n",
    "    } else {\n",
    "        /* Every slot was issued and the sweep left holes behind: rebuild the reuse chain from the occupancy bitmap once per visit,\n",
    "         * then pop from it. The sweep pays nothing per slot. */\n",
    "        size_t chained = 0;\n",
    "        uint32_t _w;\n",
    "        for (_w = 0; _w < s->nwords; _w++) {\n",
    "            uint64_t valid = (_w + 1 == s->nwords)\n",
    "                ? ((s->nslots - (size_t)_w * 64 >= 64) ? ~(uint64_t)0 : (((uint64_t)1 << (s->nslots - (size_t)_w * 64)) - 1))\n",
    "                : ~(uint64_t)0;\n",
    "            uint64_t h = valid & ~s->occ[_w];\n",
    "            while (h) {\n",
    "                uint32_t b = (uint32_t)__builtin_ctzll(h);\n",
    "                h &= h - 1;\n",
    "                size_t idx = (size_t)_w * 64 + (size_t)b;\n",
    "                s->tid[idx] = (uint16_t)(s->freelist + 1);\n",
    "                s->freelist = (int64_t)idx;\n",
    "                chained++;\n",
    "            }\n",
    "        }\n",
    "        s->nfree = (uint32_t)chained;        /* trust the occupancy bitmap, not the incremental count */\n",
    "        if (s->freelist >= 0) {\n",
    "            i = (size_t)s->freelist;\n",
    "            s->freelist = (int64_t)s->tid[i] - 1;\n",
    "            s->nfree--;\n",
    "        } else {\n",
    "            s->nfree = 0;                    /* the bitmap was stale: really full, take a fresh block */\n",
    "            s = extc_rc_slabNew(r, ss);\n",
    "            s->prev = (ExtcRcSlab *)0; if (r->slabs) r->slabs->prev = s; s->next = r->slabs;\n",
    "            r->slabs = s;\n",
    "            extc_rc_classPush(r, s);\n",
    "            if (hot) *hot = s;\n",
    "            i = (size_t)s->bump++;\n",
    "            if (s->rscnt) s->rscnt[i] = 0;\n",
    "        }\n",
    "    }\n",
    "#else\n",
    "    if (s->freelist >= 0) {                   /* a slot released earlier (hot path or sweep): pop it */\n",
    "        i = (size_t)s->freelist;\n",
    "        s->freelist = (int64_t)s->tid[i] - 1;\n",
    "    } else {\n",
    "        i = (size_t)s->bump++;                /* never issued yet: advance the cursor (the block cannot be full here) */\n",
    "        if (s->rscnt) s->rscnt[i] = 0;\n",
    "    }\n",
    "#endif\n",
    "    char *p = EXTC_RC_SLAB_DATA(s) + i * s->ss;\n",
    "    extc_rc_zeroSmall(p, ss);                  /* a fresh allocation reads as 0: language promise, and a precondition for marking */\n",
    "    size_t wi = extc_rc_word(i);   /* compute the word coordinate once: occupancy/mark/sweep all need it */\n",
    "    uint64_t bi = extc_rc_bit(i);\n",
    "    s->occ[wi] |= bi;\n",
    "#if EXTC_RC_PAGE_TRIM\n",
    "    s->allocN++;\n",
    "#endif\n",
    "    s->nLive++;\n",
