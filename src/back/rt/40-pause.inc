    "/* ---- Pause attribution (`EXTC_RC_PAUSE`): the top-K slowest steps with their context [rt:pause] ----\n",
    " *\n",
    " * `max_us` alone cannot say **why** a step was slow: a 200 us sweep step that freed 64 slots and a 200 us mark step that popped 256\n",
    " * slots look the same in `[worst]`. This table keeps the eight slowest steps of the run (O(K) update, only while the switch is on)\n",
    " * together with the work they did and, at `EXTC_RC_PAUSE=2`, that step's minor-fault delta (/proc/self/stat field 10, read before and\n",
    " * after; PAUSE=1 never reads it, so the measurement does not add fault pressure). `first` marks the first sweep step of a round --\n",
    " * the one that touches slabs' cold pages first. `coll` counts collect triggers so far, `step` is the global step number: who, when and\n",
    " * how much in one grep-able line. */\n",
    "#ifndef EXTC_RC_TOP_K\n",
    "#define EXTC_RC_TOP_K 8\n",
    "#endif\n",
    "static struct ExtcRcTopStep {\n",
    "    long long   ns;\n",
    "    long long   freed;\n",
    "    long long   words;\n",
    "    long long   seg;     /* words walked by the resumed large-object segment (the pre-seg accounting blind spot: words++ only ran in the seed scan) */\n",
    "    long long   pops;\n",
    "    long long   coll;\n",
    "    long long   step;\n",
    "    long long   minflt;\n",
    "    long long   thr;     /* trigger line in force at this step (bytes) */\n",

    "    long long   mmax;    /* effective memory wall at this step (bytes, 0 = no cap yet) */\n",

    "    long long   scale;   /* learned sweep scale at this step */\n",

    "    int         pressure;/* 1 = the step ran under EXTC_RC_SWEEP_PRESSURE_MUL */\n",

    "    long long   cpu;     /* thread CPU time of the step: wall minus CPU is preemption/IO, not GC work */\n",
    "    const char *why;\n",
    "    int         kind;    /* 0 = mark, 1 = sweep */\n",
    "    int         first;   /* first sweep step of its round */\n",
    "    int         trans;   /* sweep only: how many slab boundaries this step crossed (cold metadata pages) */\n",
    "} extc_rc_top[EXTC_RC_TOP_K];\n",
    "static int extc_rc_topN;\n",
    "static long long extc_rc_pauseN;   /* number of collect triggers so far (defined with the pause counters below) */\n",
    "/** @brief Minor faults so far (`/proc/self/stat` field 10); -1 when unavailable. Read only while `EXTC_RC_PAUSE=2`. */\n",
    "static long long extc_rc_minflt(void) {\n",
    "    long long v = -1;\n",
    "    FILE *f = fopen(\"/proc/self/stat\", \"r\");\n",
    "    if (!f) return -1;   /* skip:no-proc-stat */\n",
    "    char buf[512];\n",
    "    size_t n = fread(buf, 1, sizeof(buf) - 1, f);\n",
    "    fclose(f);\n",
    "    buf[n] = 0;\n",
    "    char *p = strrchr(buf, ')');   /* comm may contain spaces/parens: start after the last ')' */\n",
    "    if (!p) return -1;   /* skip:no-proc-comm */\n",
    "    p++;\n",
    "    int field = 2;   /* the next token is field 3 (state); minflt is field 10 */\n",
    "    while (*p && field < 10) {\n",
    "        while (*p == ' ') p++;\n",
    "        if (!*p) break;\n",
    "        field++;\n",
    "        if (field == 10) { v = atoll(p); break; }\n",
    "        while (*p && *p != ' ') p++;\n",
    "    }\n",
    "    return v;\n",
    "}\n",
    "/** @brief Record one step in the top-K table (only called while `EXTC_RC_PAUSE` is on). */\n",
    "static void extc_rc_topNote(int kind, const char *why, long long ns, long long freed, long long words, long long seg, long long pops,\n",

    "                            int first, int trans, long long minflt, long long thr, long long mmax, long long scale, int pressure, long long cpu) {\n",

    "    int pos;\n",
    "    if (extc_rc_topN < EXTC_RC_TOP_K) {\n",
    "        pos = extc_rc_topN++;\n",
    "    } else {\n",
    "        int mi = 0;\n",
    "        for (int i = 1; i < EXTC_RC_TOP_K; i++) if (extc_rc_top[i].ns < extc_rc_top[mi].ns) mi = i;\n",
    "        if (ns <= extc_rc_top[mi].ns) return;   /* skip:top-not-slower */\n",
    "        pos = mi;\n",
    "    }\n",
    "    extc_rc_top[pos].ns = ns; extc_rc_top[pos].freed = freed; extc_rc_top[pos].words = words;\n",
    "    extc_rc_top[pos].seg = seg;\n",
    "    extc_rc_top[pos].pops = pops; extc_rc_top[pos].coll = extc_rc_pauseN; extc_rc_top[pos].step = extc_rc_stepN;\n",
    "    extc_rc_top[pos].minflt = minflt; extc_rc_top[pos].cpu = cpu; extc_rc_top[pos].why = why;\n",
    "    extc_rc_top[pos].thr = thr; extc_rc_top[pos].mmax = mmax; extc_rc_top[pos].scale = scale; extc_rc_top[pos].pressure = pressure;\n",

    "    extc_rc_top[pos].kind = kind; extc_rc_top[pos].first = first; extc_rc_top[pos].trans = trans;\n",
    "}\n",
    "#ifndef EXTC_RC_ASSIST_CAP\n",
    "#define EXTC_RC_ASSIST_CAP 512   /* per-step assist cap: however much debt there is, a step must not become a full mark */\n",
    "#endif\n",
