    "/* ---- Debt flag (subset B): an inner frame allocates into an outer region [rt:owe] ----\n",
    " *\n",
    " * The inner frame's static root table is incomplete for a region **owned by an outer frame** (live references from other frames on the call stack are not in the table),\n",
    " * so it cannot sweep that region; but it can record \"one collection owed\" on the region. The one that acts is **the frame that owns it**,\n",
    " * and it happens **before that frame's next call** -- at that moment it has no active callee subtree, and its own\n",
    " * static root table (this frame's locals + parameters + globals) is the complete seed set. Therefore frame-level \"roots unreliable\"\n",
    " * flags are **not needed**: those are only required for the whole runtime root stack.\n",
    " *\n",
    " * Under multiple threads this record needs no thread-local storage: it is only recorded and settled on call chains where `parTls` is false\n",
    " * (TLS ownership is ambiguous, so no debt is issued there), and those frames all sit on the main thread's single call chain.\n",
    " *\n",
    " * Better too little than wrong: if the owner frame never calls again (`main` calls a callee only once) the debt stays forever and the\n",
    " * region waits until the frame is destroyed -- a relaxed upper bound, not a dangling pointer. */\n",
    "__attribute__((unused)) static void extc_rc_owe(ExtcRcRegion *r) { r->owe = 1; }\n",
    "__attribute__((unused)) static int extc_rc_owed(const ExtcRcRegion *r) { return r->owe; }\n",
    "/* Owner-side settling point: collect once and clear the flag. `noSweep` regions are reclaimed by counting only (obligation 7),\n",
    " * and not one byte may be swept. */\n",
    "__attribute__((unused)) static int extc_rc_checkOwed(ExtcRcRegion *r, void *const *roots, size_t nroots) {\n",
    "    extc_rc_why = \"owed\";\n",
    "    /* The settling point is the **only** settlement point of the frame owning this region: the round in flight must **finish** here,\n",
    "     * otherwise after settling there may be no more allocations and the home region would never finish sweeping. Obligation 7 regions are abandoned and report -1. */\n",
    "    if (r->sweeping) {\n",
    "        if (r->noSweep) { r->sweeping = 0; return -1; }   /* skip:nosweep-abandon */\n",
    "        return (int)extc_rc_sweepStep(r, EXTC_RC_SWEEP_BUDGET * (uint32_t)(extc_rc_pressure(r) ? EXTC_RC_SWEEP_PRESSURE_MUL : 1));   /* skip:sweeping-resume */\n",

    "    }\n",
    "    if (!r->owe) return -1;   /* skip:no-owe */\n",
    "    if (r->noSweep) { r->owe = 0; return -1; }   /* skip:nosweep */\n",
    "    if (r->marking) {   /* in flight: advance in batches (the debt counts as paid), no separate pause recorded */\n",
    "        r->owe = 0;\n",
    "        extc_rc_markAdvance(r);\n",
    "        return 0;   /* skip:marking-resume */\n",
    "    }\n",
    "    if (r->roundVisitedBytes != 0 && !extc_rc_roundOk(r)) return -1;   /* skip:owe-credit */   /* settling point: the first round is paid unconditionally */\n",
    "    r->owe = 0;\n",
    "    long long _p0 = 0, _p1 = 0, _pc0 = 0;\n",
    "    int _pcr;\n",
    "    extc_rc_pauseArm();\n",
    "    if (extc_rc_pauseOn) { _p0 = extc_rc_pauseNow(); _pc0 = extc_rc_chanClock(); }\n",
    "    _pcr = (int)extc_rc_step(r, roots, nroots);   /* settling point: advance; settlement relies on the hot path/settle as a backstop */\n",
    "    if (extc_rc_pauseOn) {\n",
    "        _p1 = extc_rc_pauseNow();\n",
    "        extc_rc_pauseTotal += _p1 - _p0;\n",
    "        if (_p1 - _p0 > extc_rc_pauseMax) { extc_rc_pauseMax = _p1 - _p0; }\n",
    "        extc_rc_pauseN++;\n",
    "        extc_rc_chanNote(2, extc_rc_chanClock() - _pc0, _pcr > 0 ? (long long)_pcr : 0);\n",
    "    }\n",
    "    return _pcr;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static int64_t extc_rc_bytes(const ExtcRcRegion *r) { extc_rc_settle((ExtcRcRegion *)r); return r->bytes; }\n",
    "__attribute__((unused)) static int64_t extc_rc_live(const ExtcRcRegion *r) { extc_rc_settle((ExtcRcRegion *)r); return r->live; }\n",
    "__attribute__((unused)) static int64_t extc_rc_scale(const ExtcRcRegion *r) { extc_rc_settle((ExtcRcRegion *)r); return r->scale; }\n",
    "__attribute__((unused)) static size_t extc_rc_sweeps(const ExtcRcRegion *r) { extc_rc_settle((ExtcRcRegion *)r); return r->sweeps; }\n",
    "__attribute__((unused)) static size_t extc_rc_freedSlots(const ExtcRcRegion *r) { extc_rc_settle((ExtcRcRegion *)r); return r->freedSlots; }\n",
    "/* **Hint** used by the trigger path to pick \"which piece has the most garbage\": `bytes - live`, with **no settle**.\n",
    " * Why it must be separate: the contract of `extc_rc_bytes/live` is \"accounts are final when observed\", so settle first, and that would do an\n",
    " * **unbounded drain** of the round in flight. Segmented triggering evaluates every piece on each trigger, and this path sits in the mutator hot loop, so\n",
    " * every trigger would pay an O(round in flight) pause.\n",
    " * A trigger only needs an **order**: `live` from the last completed round is enough. Direction: an older `live` overestimates garbage,\n",
    " * so it triggers sooner and reclaims sooner (conservative), never later. */\n",
    "__attribute__((unused)) static int64_t extc_rc_garbageHint(const ExtcRcRegion *r) {\n",
    "    return r->bytes - r->live;\n",
    "}\n",
    "__attribute__((unused)) static size_t extc_rc_slabCount(const ExtcRcRegion *r) {\n",
    "    size_t n = 0;\n",
    "    for (ExtcRcSlab *s = r->slabs; s; s = s->next) n++;\n",
    "    return n;\n",
    "}\n",
