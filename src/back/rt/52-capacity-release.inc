    "/* ---- Capacity release: one watermark, one bounded pass ----\n",
    " * Capacity (capBytes) is what the region has carved, not what its live set needs: a block is half a megabyte however few slots are live in it, and it\n",
    " * stays carved until something hands it back. Two mechanisms used to answer \"what is surplus\", each with its own guess: extc_rc_slabShrink unlinked\n",
    " * empty blocks (behind a minimum slack, a per-block reuse grace counted in allocations, and a capacity budget as a multiple of the live set), and\n",
    " * extc_rc_pageTrimStep gave the payload pages of a sparse block back to the OS (behind its own slack, a density test and a quiet-clock guess).\n",
    " * Four numbers and two guesses for one question. The question has one answer: carved capacity above the watermark is surplus. A dead generation\n",
    " * survives at most EXTC_RC_CAP_MULT times the live bytes, which is one generation of reuse -- what a growth step (copy to a bigger buffer) needs --\n",
    " * and nothing more. Above the watermark the same pass hands back both kinds of surplus:\n",
    " *   - a block with no live slot: unlink it from the region chain and from the size-class chain and queue it for the bounded free queue (O(1);\n",
    " *     the payload is not touched here, and a huge block's payload takes its own bounded drop chain);\n",
    " *   - a sparse block (it holds a live slot, so it cannot be unlinked): give the payload pages that hold no occupied slot back to the OS with\n",
    " *     MADV_DONTNEED. No write barrier is added and no object moves: the occupancy bitmap already says which slots are live, and a released page is\n",
    " *     written again only by extc_rc_zeroSmall when a slot in it is handed out, which zeroes the slot anyway -- so the language promise (a fresh\n",
    " *     allocation reads as zero) is unchanged. Every piece of metadata (occ/mark/rsbit/hold/tid/ttab) lives outside the block, and the reuse chain\n",
    " *     keeps its next slot number in tid[], so no page the collector reads is ever released.\n",
    " * The page release is idempotent by state, not by a clock: pgLive records the live count the last finished pass saw, so a block whose nLive did not\n",
    " * change has no new empty page and is skipped; pgNext resumes a pass the budget cut short.\n",
    " * Bounds: one step inspects at most EXTC_RC_RETURN_VISIT_MAX blocks, unlinks at most EXTC_RC_RETURN_SLAB_MAX of them (each O(1), so the count is the\n",
    " * bound) and releases at most EXTC_RC_RETURN_BYTES of pages from at most EXTC_RC_RETURN_PAGE_MAX blocks. The free itself happens in\n",
    " * extc_rc_fqDrainCore, which already carries a budget and a deadline, and the step sits at the closing point of a sweep round, i.e. inside the step\n",
    " * the pause distribution sees.\n",
    " * Safety: only a block with nLive == 0 is unlinked (no live object can be in it), the bump block of a parse region is never taken, a block whose\n",
    " * cross-region in-edge bits are set is left to the bulk reset path, and the block leaves the ownership registry before it is queued. */\n",
    "#ifndef EXTC_RC_CAP_MULT\n",
    "#define EXTC_RC_CAP_MULT 2   /* capacity above this multiple of the live bytes is surplus and is handed back; 0 disables the pass.\n",
    "                              * 2 is one dead generation, i.e. the reuse a growth step needs before it asks the OS. */\n",
    "#endif\n",
    "#ifndef EXTC_RC_RETURN_BYTES\n",
    "#define EXTC_RC_RETURN_BYTES (256 << 10)   /* payload bytes released per closing step (64 pages: about 4 us at the 14 ns/KB the pass costs) */\n",
    "#endif\n",
    "#ifndef EXTC_RC_RETURN_VISIT_MAX\n",
    "#define EXTC_RC_RETURN_VISIT_MAX 256   /* blocks inspected per closing step: bounds the pass when nothing is surplus */\n",
    "#endif\n",
    "#ifndef EXTC_RC_RETURN_SLAB_MAX\n",
    "#define EXTC_RC_RETURN_SLAB_MAX 16     /* blocks unlinked per closing step: each is O(1), this is the pause bound */\n",
    "#endif\n",
    "#ifndef EXTC_RC_RETURN_PAGE_MAX\n",
    "#define EXTC_RC_RETURN_PAGE_MAX 8      /* blocks whose pages one closing step may inspect: bounds the occupancy scan */\n",
    "#endif\n",
    "#ifndef EXTC_RC_RETURN_FLOOR\n",
    "#define EXTC_RC_RETURN_FLOOR (16 << 20)   /* reuse stock: capacity up to this many bytes above the watermark stays carved, so a shape that churns one\n",
    "                                          * large buffer does not pay a page fault per round for capacity it is about to ask for again; 0 lets the\n",
    "                                          * watermark alone decide. The stock is a constant, so M = live + O(#block) + floor still holds. */\n",
    "#endif\n",
    "#if EXTC_RC_SLAB_BITS > 19\n",
    "#error \"capacity pass: a block above 512 KiB needs a wider live-page summary (livepg[] is two 64-bit words)\"\n",
    "#endif\n",
    "#if defined(__linux__) || defined(__unix__) || defined(__APPLE__)\n",
    "#ifndef MADV_DONTNEED\n",
    "#define MADV_DONTNEED 4   /* Linux and Darwin both number it 4; <sys/mman.h> is not included on purpose: it declares mmap(void *),\n",
    "                            * and the language stdlib declares its own mmap for plates, so including the header conflicts with it. */\n",
    "#endif\n",
    "#if defined(__linux__) || defined(__APPLE__)\n",
    "extern int madvise(void *, size_t, int);   /* same story: a BSD entry point, not a POSIX name */\n",
    "#endif\n",
    "#define EXTC_RC_MADVISE_OK 1\n",
    "#else\n",
    "#define EXTC_RC_MADVISE_OK 0\n",
    "#endif\n",
    "static long long extc_rc_slabRel __attribute__((unused));     /* blocks handed to the free queue by the capacity pass */\n",
    "static long long extc_rc_retN __attribute__((unused));        /* closing steps that found capacity surplus */\n",
    "static long long extc_rc_pageRel __attribute__((unused));     /* bytes given back to the OS by the capacity pass */\n",
    "static long long extc_rc_pageTrimN __attribute__((unused));   /* blocks whose pages the pass inspected */\n",
    "static long long extc_rc_capMax __attribute__((unused));       /* high-water of carved capacity (the [return] line) */\n",
    "static long long extc_rc_capLiveMax __attribute__((unused));   /* high-water of the live bytes seen next to it */\n",

    "/** @brief The policy, in one predicate: is carved capacity above the watermark the live set sets? */\n",
    "__attribute__((unused)) static int extc_rc_surplus(ExtcRcRegion *r) {\n",
    "    return EXTC_RC_CAP_MULT > 0 && r->capBytes > r->bytes * (int64_t)EXTC_RC_CAP_MULT + (int64_t)EXTC_RC_RETURN_FLOOR;   /* skip:return-watermark */\n",
    "}\n",

    "/** @brief Can this block hold an empty page at all? Arithmetic, not a payoff guess: a live slot covers at most one page per 4 KiB of slot plus one,\n",
    " *  so when that union bound already reaches the page count, the pass would read the whole bitmap to find nothing. */\n",
    "__attribute__((unused)) static int extc_rc_pageWorth(ExtcRcSlab *s) {\n",
    "    int64_t per = 1 + ((int64_t)s->ss >> 12);   /* pages one live slot can cover (it straddles at most one boundary) */\n",
    "    return (int64_t)s->nLive * per < ((int64_t)s->nslots * (int64_t)s->ss) >> 12;\n",
    "}\n",

    "#if EXTC_RC_MADVISE_OK\n",
    "/** @brief Give the payload pages of one block that hold no occupied slot back to the OS; returns the bytes released (<= budget). */\n",
    "__attribute__((unused)) static int64_t extc_rc_pageTrimSlab(ExtcRcSlab *s, int64_t budget) {\n",
    "    uint64_t livepg[2], cand[2];\n",
    "    size_t first, last, p;\n",
    "    uint32_t w;\n",
    "    int64_t rel = 0;\n",
    "    livepg[0] = 1u; livepg[1] = 0u;   /* page 0 carries the block header: never released */\n",
    "    first = (EXTC_RC_SLAB_HDR + 4095) >> 12;   /* first page fully inside the payload */\n",
    "    last = (EXTC_RC_SLAB_HDR + (size_t)s->nslots * s->ss) >> 12;   /* exclusive end: [first, last) is all payload */\n",
    "    for (w = 0; w < s->nwords; w++) {\n",
    "        uint64_t m = s->occ[w];\n",
    "        while (m) {\n",
    "            unsigned b = (unsigned)__builtin_ctzll(m);\n",
    "            size_t off = EXTC_RC_SLAB_HDR + ((size_t)w * 64 + b) * s->ss;\n",
    "            size_t p1 = (off + s->ss - 1) >> 12;   /* a slot may cross a page boundary: mark both pages */\n",
    "            m &= m - 1;\n",
    "            for (p = off >> 12; p <= p1; p++) livepg[p >> 6] |= (uint64_t)1 << (p & 63);\n",
    "        }\n",
    "    }\n",
    "    /* Candidate = empty and inside the payload. The page bit is the whole idempotence argument: a page goes to the OS at most once per\n",
    "     * residency, and only an allocation (which faults it back in) makes it a candidate again. */\n",
    "    cand[0] = ~livepg[0];\n",
    "    cand[1] = ~livepg[1];\n",
    "    for (p = 0; p < first; p++) cand[p >> 6] &= ~((uint64_t)1 << (p & 63));\n",
    "    for (p = last; p < 128; p++) cand[p >> 6] &= ~((uint64_t)1 << (p & 63));\n",
    "    p = (s->pgNext >= 0) ? (size_t)s->pgNext : first;   /* resume where the budget cut the previous pass */\n",
    "    while (p < last && rel < budget) {\n",
    "        size_t q, pages, bytes;\n",
    "        if (!(cand[p >> 6] & ((uint64_t)1 << (p & 63)))) { p++; continue; }\n",
    "        q = p;\n",
    "        while (q < last && (cand[q >> 6] & ((uint64_t)1 << (q & 63)))) q++;\n",
    "        pages = q - p;\n",
    "        bytes = pages * 4096;\n",
    "        if ((int64_t)bytes > budget - rel) { pages = (size_t)((budget - rel) >> 12); bytes = pages * 4096; }\n",
    "        if (bytes && madvise((char *)s + p * 4096, bytes, MADV_DONTNEED) == 0) {\n",
    "            rel += (int64_t)bytes;\n",
    "        }\n",
    "        p += pages ? pages : 1;\n",
    "    }\n",
    "    if (p >= last) { s->pgNext = -1; s->pgLive = (int64_t)s->nLive; }   /* finished: only a change in nLive can make it worth another */\n",
    "    else s->pgNext = (int32_t)p;   /* out of budget: resume here at the next closing step */\n",
    "    extc_rc_pageRel += rel;\n",
    "    extc_rc_pageTrimN++;\n",
    "    return rel;\n",
    "}\n",
    "#endif\n",

    "/** @brief Unlink a block that holds no live slot and queue it: capacity leaves the chain, the payload goes to the free queue. */\n",
    "__attribute__((unused)) static void extc_rc_slabUnlink(ExtcRcRegion *r, ExtcRcSlab *s) {\n",
    "    if (s->prev) s->prev->next = s->next; else r->slabs = s->next;\n",
    "    if (s->next) s->next->prev = s->prev;\n",
    "    if (s->avail) {\n",
    "        if (s->availPrev) s->availPrev->availNext = s->availNext;\n",
    "        else {\n",
    "            ExtcRcClass *c = extc_rc_classSlot(r, s->ss);\n",
    "            if (c && c->head == s) c->head = s->availNext;\n",
    "        }\n",
    "        if (s->availNext) s->availNext->availPrev = s->availPrev;\n",
    "        s->avail = 0;\n",
    "    }\n",
    "    s->prev = (ExtcRcSlab *)0;\n",
    "    s->availNext = (ExtcRcSlab *)0;\n",
    "    s->availPrev = (ExtcRcSlab *)0;\n",
    "    r->capBytes -= (int64_t)s->nslots * (int64_t)s->ss;   /* the block leaves the chain: capacity leaves with it */\n",
    "    extc_rc_ownDel(s);\n",
    "    extc_rc_fqPushOne(s);\n",
    "}\n",

    "/** @brief One bounded step of the capacity pass: while capacity is above the watermark, hand back dead blocks and dead pages. */\n",
    "__attribute__((unused)) static long long extc_rc_returnStep(ExtcRcRegion *r) {\n",
    "    if (!r) return 0;   /* skip:return-null */\n",
    "    if (r->capBytes > extc_rc_capMax) extc_rc_capMax = r->capBytes;\n",
    "    if (r->bytes > extc_rc_capLiveMax) extc_rc_capLiveMax = r->bytes;\n",
    "    if (!extc_rc_surplus(r)) return 0;   /* skip:return-quiet */\n",
    "    if (!r->trimCur) r->trimCur = r->slabs;   /* the previous step ran to the end of the chain: start over at the head */\n",
    "    if (!r->trimCur) return 0;   /* no block at all */   /* skip:return-empty */\n",
    "    long long rel = 0;\n",
    "    int64_t pages = 0;\n",
    "    int visits = 0, paged = 0;\n",
    "    ExtcRcSlab *s = r->trimCur;\n",
    "    extc_rc_retN++;\n",
    "    while (s && visits < EXTC_RC_RETURN_VISIT_MAX && rel < EXTC_RC_RETURN_SLAB_MAX) {\n",
    "        ExtcRcSlab *n = s->next;   /* read before the unlink: the cursor must survive it */\n",
    "        visits++;\n",
    "        if (s == r->bumpSlab) { s = n; continue; }   /* still being handed out */\n",
    "        if (s->nLive == 0) {\n",
    "            if (extc_rc_rsIncN) {   /* cross-region in-edges: the bulk reset path undoes them, this pass does not */\n",
    "                uint32_t w;\n",
    "                int held = 0;\n",
    "                for (w = 0; w < s->nwords; w++) if (s->rsbit[w]) { held = 1; break; }\n",
    "                if (held) { s = n; continue; }\n",
    "            }\n",
    "            extc_rc_slabUnlink(r, s);\n",
    "            rel++;\n",
    "            s = n;\n",
    "            if (!extc_rc_surplus(r)) break;   /* the watermark is met: stop handing blocks back */\n",
    "            continue;\n",
    "        }\n",
    "#if EXTC_RC_MADVISE_OK\n",
    "        if (!s->big && paged < EXTC_RC_RETURN_PAGE_MAX && pages < EXTC_RC_RETURN_BYTES && s->pgNext < 0\n",
    "            && s->pgLive != (int64_t)s->nLive && extc_rc_pageWorth(s)) {\n",
    "            pages += extc_rc_pageTrimSlab(s, EXTC_RC_RETURN_BYTES - pages);\n",
    "            paged++;\n",
    "        }\n",
    "#endif\n",
    "        s = n;\n",
    "    }\n",
    "    r->trimCur = s;\n",
    "    if (rel) { memset(r->allocHot, 0, sizeof(r->allocHot)); extc_rc_slabRel += rel; }\n",
    "    return rel;\n",
    "}\n",
