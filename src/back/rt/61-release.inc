    "/* ---- Targeted release at overwrite: \"overwriting this slot\" itself proves the old value's tree dead [rt:release] ----------------\n",
    " *\n",
    " * The caller (`extc_rc_storeRefOwnedRelease`) has already checked: the old value is in a region **owned by this frame** and\n",
    " * that region is sweepable (no `noSweep` / no debt). What happens here is a **narrowed sweep**:\n",
    " *\n",
    " *   1. first mark from the **other roots** (the root table with the overwritten cell removed) + this region's cross-region seeds -- the same\n",
    " *      seed set as `extc_rc_collect`, so \"live\" is decided identically, word for word;\n",
    " *   2. then walk from the old value along the **type descriptors**, releasing only slots that are reachable and unmarked. Stop at a marked\n",
    " *      object: another root/seed points to it, so it is live, and everything below it was already marked in step 1.\n",
    " *\n",
    " * Safety argument (the whole basis of this mechanism): the released set is a **subset** of what `collect` would release at the **same point with the same seed set** --\n",
    " * so even if the static criterion \"no other live holder right now\" is wrong, an object pointed to by another live root/seed\n",
    " * is not freed (the lightweight form of a trial deletion). The criterion only decides \"is this pass worth it\".\n",
    " *\n",
    " * Direction: releasing less (a wrong criterion means something that should be freed is not) is conservative; releasing more can only come from **incomplete roots/seeds**,\n",
    " * and that is exactly the precondition of `collect`, guarded by the caller with `noSweep`/`owe`/frame ownership.\n",
    " *\n",
    " * Mark bits must be cleared before returning: `extc_rc_sweep` is the only place that clears them, so neither sweeping nor clearing here would leave\n",
    " * marks for the next `collect` (those slots would be taken as live, so objects are not reclaimed). */\n",
    "__attribute__((unused)) static size_t extc_rc_releaseOld(ExtcRcRegion *r, void *old,\n",
    "                                                         void *const *roots, size_t nroots) {\n",
    "    if (!r || !old) return 0;   /* skip:no-pointer */\n",
    "    extc_rc_why = \"release\";\n",
    "    extc_rc_pauseArm();\n",
    "    long long _c0 = extc_rc_pauseOn > 0 ? extc_rc_chanClock() : 0;   /* release channel: one overwrite's bounded release */\n",
    "    /* Phase 1 marks the live set from the other roots; phase 2 descends from the old value. Both draw on one budget so a single overwrite has a\n",
    "     * bounded pause. \"Unmarked\" only proves death while phase 1 has drained, so an unfinished phase 1 abandons the whole release (nothing is\n",
    "     * freed and the mark span is cleared below) and the tree waits for the incremental sweep; an unfinished phase 2 stops early and the\n",
    "     * unvisited children keep their counts for the sweep. Both outcomes reclaim less, never unsafe. */\n",
    "    extc_rc_markBegin(r, roots, nroots);\n",
    "    uint32_t budget = EXTC_RC_RELEASE_BUDGET;\n",
    "    while (!r->seedsDone || r->msp || r->scanObj) {\n",
    "        size_t step = budget < (uint32_t)EXTC_RC_MARK_BATCH_MAX ? (size_t)budget : (size_t)EXTC_RC_MARK_BATCH_MAX;\n",
    "        if (step == 0) break;   /* abandon: the seed set is incomplete, so \"unmarked\" does not prove death */\n",
    "        uint32_t charge = (uint32_t)step;\n",
    "        if (r->scanObj) charge += (uint32_t)(EXTC_RC_SCAN_CHUNK / 8);   /* this step resumes one large-object segment */\n",
    "        extc_rc_markStep(r, step);\n",
    "        budget = charge >= budget ? 0 : budget - charge;   /* `step` is an upper bound on this step's pops */\n",
    "    }\n",
    "    size_t freed = 0;\n",
    "    if (!r->seedsDone || r->msp || r->scanObj) {\n",
    "        r->msp = 0; r->scanObj = (void *)0; r->scanDesc = 0;   /* abandon: drop partial candidates and the continuation cursor */\n",
    "        r->thr = 0;   /* the abandoned tree must not wait for a pressure line that grows with it: the next allocation point starts a round */\n",
    "        r->roundVisitedBytes = 0;   /* the abandoned release is pressure evidence: the round credit must not delay the sweep that finishes the job */\n",
    "    } else {\n",
    "        r->scanObj = (void *)0;   /* phase 1 drained; the cursor does not carry across this release */\n",
    "        r->msp = 0;\n",
    "        extc_rc_markPush(r, old);\n",
    "        while (r->msp) {\n",
    "            if (budget == 0) break;   /* descent budget spent: the rest keeps its counts for the sweep */\n",
    "            budget--;\n",
    "            void *o = r->mstk[--r->msp];\n",
    "            ExtcRcSlab *s = extc_rc_ownSlab(o);\n",
    "            if (!s || s->region != r) continue;   /* outside the region / not rc: treat as live and stop */\n",
    "            size_t i = extc_rc_slotOf(s, o);\n",
    "            uint64_t bit = extc_rc_bit(i);\n",
    "            if (!(s->occ[extc_rc_word(i)] & bit)) continue;   /* a free slot is not an object */\n",
    "            if (s->mark[extc_rc_word(i)] & bit) continue;   /* reachable from another root/seed, so live: stop */\n",
    "            const ExtcRcType *t = extc_rc_typeOf(s, i);\n",
    "            /* Push the children before releasing this cell: descriptor and fields are still intact (`freeSlot` overwrites the payload head). */\n",
    "            if (t == EXTC_RC_CONSERVATIVE) {\n",
    "                size_t words = s->ss / sizeof(void *);\n",
    "                for (size_t w = 0; w < words && budget > 0; w++) {\n",
    "                    budget--;\n",
    "                    void *c = ((void **)o)[w];\n",
    "                    if (c) extc_rc_markPush(r, c);\n",
    "                }\n",
    "            } else if (t) {   /* no reference fields, so there are no children to walk */\n",
    "                for (uint32_t k = 0; k < t->nptr && budget > 0; k++) {\n",
    "                    budget--;\n",
    "                    void *c = *(void **)((char *)o + t->off[k]);\n",
    "                    if (c) extc_rc_markPush(r, c);\n",
    "                }\n",
    "            }\n",
    "            extc_rc_freeSlot(s, i);\n",
    "            freed++;\n",
    "        }\n",
    "        if (r->msp) {   /* budget cut the descent: the rest waits for the sweep, so ask for one at the next allocation point */\n",
    "            r->msp = 0;\n",
    "            r->thr = 0;\n",
    "            r->roundVisitedBytes = 0;   /* pressure evidence: do not let the round credit delay the sweep */\n",
    "        }\n",
    "    }\n",
    "    extc_rc_shadeNextGen();   /* the narrowed sweep clears the whole mark span below: black records are void */\n",
    "    for (ExtcRcSlab *s = r->slabs; s; s = s->next)\n",
    "        { memset(s->mark, 0, (size_t)s->nwords * sizeof(uint64_t)); s->nMark = 0;\n",
    "          if (s->wmark) memset(s->wmark, 0, (size_t)s->nslots * (size_t)s->wmW * sizeof(uint64_t)); }   /* [rt:wmark] every slot is recycled */\n",
    "    extc_rc_relN++;\n",
    "    extc_rc_relSlots += (int64_t)freed;\n",
    "    if (extc_rc_pauseOn > 0) extc_rc_chanNote(1, extc_rc_chanClock() - _c0, (long long)freed);\n",
    "    return freed;\n",
    "}\n",
    "\n",
    "/* Reference-slot overwrite with one **targeted release**: when the old value's whole tree is proven dead at the overwrite point, there is no need to wait for the region sweep.\n",
    " *\n",
    " * The `home` given by the caller (codegen) is **the region the new object being stored into this slot lives in**, and it is guaranteed to be the one this frame\n",
    " * owns (`rcFrameOwnsArena`). If the old value is not in `home` the whole section is skipped -- then there is no static basis for \"this frame's root table is complete for that\n",
    " * \"region\", so better not to release (conservative direction).\n",
    " *\n",
    " * Three static guards are required before the call, and one dynamic guard is checked inside it:\n",
    " *   - `noSweep`: this region has in-edges whose host cannot be traced, so seeds are incomplete and the region may not be swept at all;\n",
    " *   - `owe`: an inner frame has allocated into this region, so its root table may not be complete at this moment (same reason as `checkOwed`);\n",
    " *   - `sold->region != home`: the old value is not in the statically given region (for instance it was just moved by another path).\n",
    " *   - `home->sweeping`: a sweep is in flight and owns this round mark bitmap; `releaseOld` ends by clearing every mark bit, which would erase the black bits protecting objects allocated during the sweep, so this call returns and the sweep collects the old tree itself.\n",
    " *\n",
    " * After releasing, the ordinary `storeRefOwned` runs: the old value slot it reads is already free, and `rsDecSlab`/`holdUpdSlab`\n",
    " * both return at the occupied-bit line, so nothing is settled twice, and writing the new value plus its increment happens as usual. */\n",
    "__attribute__((unused)) static void extc_rc_releaseDead(ExtcRcRegion *home, void *old,\n",
    "                                                        void *const *roots, size_t nroots) {\n",
    "    if (!home || !old) return;   /* skip:no-pointer */\n",
    "    if (home->noSweep || home->owe) return;   /* skip:nosweep */\n",
    "    if (home->sweeping) return;   /* skip:release-sweeping */\n",
    "    ExtcRcSlab *s = extc_rc_ownSlab(old);\n",
    "    /* the old value is not in the statically given region (for instance it was just moved by another path), so do not release (conservative). */\n",
    "    if (s && s->region == home) {\n",
    "        if (!extc_rc_budgetOk(home)) return;   /* skip:release-budget */\n",
    "        extc_rc_releaseOld(home, old, roots, nroots);\n",
    "        home->visitedBytes = home->allocBytes;   /* account for the traversal */\n",
    "    }\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_storeRefOwnedRelease(void **slot, void *v, void *owner,\n",
    "                                                                 ExtcRcRegion *home,\n",
    "                                                                 void *const *roots, size_t nroots) {\n",
    "    extc_rc_shade(v);\n",
    "    if (slot) extc_rc_releaseDead(home, *slot, roots, nroots);\n",
    "    extc_rc_storeRefOwned(slot, v, owner);\n",
    "}\n",
    "\n",

    "/* Sweep: dead slot = occupied & ~marked. Walk 64-bit words in order, chase no pointers, free nothing individually; clear the mark bitmap sequentially over the whole span.\n",
    " * Releasing does not go back and fix other objects' counts: a released object is unreachable this round, references to it are released too, and other counts can only be too high\n",
    " * so better reclaimed late than freed early. */\n",
