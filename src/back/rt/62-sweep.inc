    "/* ---- Stepped (interruptible) sweep: one word (64 slots) per step, cursor kept in the region [rt:sweep] ----\n",
    " *\n",
    " * Sweeping a whole region in one go makes the pause proportional to the region's contents. Here it is cut into \"N words per step\":\n",
    " *   - `sweepBegin` sets the cursor and bumps the round number; `sweepWord` sweeps one word (releases unmarked objects,\n",
    " *     clears that word's mark bits, and stamps a slab with this round's number once it is fully swept);\n",
    " *   - `sweepStep(budget)` sweeps at most budget words; only on reaching the end does it settle the accounts (self-tuning multiplier, `live`,\n",
    " *     threshold, `sweeps++`);\n",
    " *   - objects **allocated during sweep are marked black at the allocation point**, only at positions the cursor has not reached (see `extc_rc_alloc`);\n",
    " *   - while a sweep is unfinished, trigger points only continue it and never start a new mark (marking relies on \"the mark bitmap is clear\");\n",
    " *   - obligation 7 (`noSweep`) regions are **abandoned**: the round in flight is voided on the spot and not one byte is swept afterwards;\n",
    " *   - account queries (`extc_rc_bytes` etc.) and the debt-settling points first \"settle\": they push the round in flight to the end,\n",
    " *     so that \"the accounts of one collection\" are final when observed.\n",
    " *\n",
    " * The final accounts do not recompute occupied payload: `bytes` is maintained incrementally by `extc_rc_alloc` (+ss) and `extc_rc_freeSlot`\n",
    " * (-ss), so recomputing is pure waste. */\n",
    "/* Slab-level bulk reset: a slab in which **not one slot is marked** holds no reachable object at all, so its whole payload is garbage.\n",
    " * One pass over the occupancy bitmap decides it; when the test holds, the slab is reset in O(1) instead of releasing slot by slot (extc_rc_sweepWord).\n",
    " * Preconditions checked here: the no-count tier (this text is not emitted for the counting tier, where hold/rscnt need per-slot maintenance),\n",
    " * extc_rc_rsIncN == 0 (with registered cross-region in-edges every live slot has to withdraw its out-edges one by one), and no huge block\n",
    " * (payload outside the slab, a single slot: extc_rc_freeSlot is the only correct path).\n",
    " * Invariant that makes the reset sound: every pinned value was seeded black at the start of the round (extc_rc_pinSeed), so a slab whose\n",
    " * occ & mark is empty everywhere cannot hold one; in the counting tier a holder count above 0 implies the same. -DEXTC_RC_SHADE_GUARD=1 checks the pin half.\n",
    " * Cost: O(nwords) bitmap reads with an early exit at the first marked slot; a dead slab pays the full pass and saves one release per slot. */\n",
    "static long long extc_rc_seBulkReset, extc_rc_seBulkSlots, extc_rc_seSwept;\n",
    "#if EXTC_RC_NOCOUNT\n",
    "__attribute__((unused)) static int extc_rc_sweepElide(ExtcRcRegion *r) {\n",
    "    ExtcRcSlab *s = r->swSlab;\n",
    "    if (!s) return 0;                     /* skip:elide-no-slab */\n",
    "    if (s->big) return 0;                 /* skip:elide-big */\n",
    "    if (r->foreign) return 0;             /* skip:elide-foreign */\n",
    "    if (s->nMark != 0) return 0;          /* skip:elide-reachable */\n",
    "    /* Every slot is unreachable: count the occupied ones, paid only on a slab that is about to be reset wholesale. */\n",
    "    for (uint32_t w = 0; w < s->nwords; w++) if (s->rsbit[w]) return 0;   /* skip:elide-xregion */\n",
    "    size_t live = (size_t)s->nLive;   /* roll-up: no bitmap scan is needed here */\n",
    "#if EXTC_RC_SHADE_GUARD\n",
    "    /* Invariant self-check: no pinned value may live in a slab whose occupancy has no marked slot (see the comment above). */\n",
    "    if (extc_rc_pinN) {\n",
    "        for (size_t pi = 0; pi < extc_rc_pinCap; pi++) {\n",
    "            ExtcRcPin *pp = &extc_rc_pins[pi];\n",
    "            if (pp->n && pp->rg == r && (uintptr_t)extc_rc_slabOf(pp->v) == (uintptr_t)s) extc_rc_sgBad++;\n",
    "        }\n",
    "    }\n",
    "#endif\n",
    "    /* Whole slab dead: clear both bitmaps in bulk and hand the slab back to the bump path. The byte count tracks occupied payload only;\n",
    "     * rsbit stays clear because rsIncN == 0 means no cross-region in-edge can ever have been registered. */\n",
    "#if EXTC_RC_ELIDE_VERIFY\n",
    "    /* Bitmap cross-check: the roll-up is the only reason the reset may run, so prove the bitmaps agree before retiring the block. */\n",
    "    {\n",
    "        uint32_t _w;\n",
    "        uint32_t _occ = 0;\n",
    "        for (_w = 0; _w < s->nwords; _w++) {\n",
    "            if (s->mark[_w] || s->rsbit[_w]) { extc_rc_elideMismatch++; return 0; }   /* skip:elide-verify-mismatch */\n",
    "            _occ += (uint32_t)__builtin_popcountll(s->occ[_w]);\n",
    "        }\n",
    "        if (_occ != s->nLive) { extc_rc_elideMismatch++; return 0; }   /* skip:elide-verify-nlive */\n",
    "    }\n",
    "#endif\n",
    "    r->bytes -= (int64_t)live * (int64_t)s->ss;\n",
    "    r->freedSlots += (int64_t)live;\n",
    "    r->swFreed += (int64_t)live;\n",
    "    s->bump = 0;\n",
    "    s->freelist = -1;\n",
    "    memset(s->occ, 0, (size_t)s->nwords * sizeof(uint64_t));\n",
    "    memset(s->mark, 0, (size_t)s->nwords * sizeof(uint64_t));\n",
    "    if (s->wmark) memset(s->wmark, 0, (size_t)s->nslots * (size_t)s->wmW * sizeof(uint64_t));   /* [rt:wmark]: back to never-issued */\n",
    "    s->nLive = 0;\n",
    "    s->nMark = 0;\n",
    "    s->nfree = 0;   /* EXTC_RC_LAZY_FREE: the block is back to never-issued state */\n",
    "    if (!s->avail) extc_rc_classPush(r, s);   /* empty again: back on its size-class chain (see extc_rc_alloc) */\n",
    "    s->swEpoch = r->swId;                     /* done in this round; sweep end leaves every mark bit clear */\n",
    "    r->swSlab = s->next;\n",
    "    r->swWord = 0;\n",
    "    extc_rc_seBulkReset++;\n",
    "    extc_rc_seBulkSlots += (long long)live;\n",
    "    return 1;\n",
    "}\n",
    "#else\n",
    "__attribute__((unused)) static int extc_rc_sweepElide(ExtcRcRegion *r) {\n",
    "    (void)r;\n",
    "    return 0;   /* skip:elide-counting */\n",
    "}\n",
    "#endif\n",
    "/** @brief Start a stepped sweep round: the cursor points at the first slab and the round number is bumped. */\n",
    "__attribute__((unused)) static void extc_rc_sweepBegin(ExtcRcRegion *r) {\n",
    "    extc_rc_shadeNextGen();   /* the sweep clears mark bits slab by slab: the shading cache is void */\n",
    "    r->sweeping = 1;\n",
    "    r->swId++;\n",
    "    r->swSlab = r->slabs;\n",
    "    r->swWord = 0;\n",
    "    r->swFreed = 0;\n",
    "    r->swFirst = 1;\n",
    "if (extc_rc_pauseOn > 0) {   /* per-round quota observability: the G18 judgement is \"hits do not keep growing\", which a process total cannot show */\n",
    "    fprintf(stderr, \"[quota] round=%lld round_hits=%lld round_checks=%lld\\n\", (long long)r->swId, extc_rc_quotaHitsRound, extc_rc_quotaChecksRound);\n",
    "    extc_rc_quotaHitsRound = 0;\n",
    "    extc_rc_quotaChecksRound = 0;\n",
    "}\n",
    "}\n",
    "/** @brief Sweep **one word** at the cursor; returns 1 when the whole region has been swept. */\n",
    "__attribute__((unused)) static int extc_rc_sweepWord(ExtcRcRegion *r) {\n",
    "    ExtcRcSlab *s = r->swSlab;\n",
    "    uint32_t w = r->swWord;\n",
    "    uint64_t dead = s->occ[w] & ~s->mark[w];\n",
    "    if (dead) {   /* word-wise bulk release (see extc_rc_freeSlotWord): per slot only the head insertion, the rest once per word */\n",
    "        r->swFreed += (int64_t)extc_rc_freeSlotWord(s, (size_t)w, dead);\n",
    "    }\n",
    "    s->nMark -= (uint32_t)__builtin_popcountll(s->mark[w]);   /* roll-up: the word is about to be cleared */\n",
    "    s->mark[w] = 0;\n",
    "    if (++r->swWord >= s->nwords) { s->swEpoch = r->swId; r->swSlab = s->next; r->swWord = 0; extc_rc_seSwept++; }\n",
    "    return r->swSlab == NULL;\n",
    "}\n",
    "/* Per-step pause (printed when `EXTC_RC_PAUSE=1`), to gauge the effect of the step granularity;\n",
    " * the counters and threshold buckets are declared before `markStep` (they are recorded there too). */\n",
    "/** @brief Stepped sweep: sweep at most budget words; on reaching the end settle the accounts and return 1, otherwise 0. */\n",
    "__attribute__((unused)) static int extc_rc_sweepStep(ExtcRcRegion *r, uint32_t budget) {\n",
    "    if (!r->sweeping) return 0;   /* skip:not-sweeping */\n",
    "    long long _mf0 = extc_rc_pauseOn > 1 ? extc_rc_minflt() : -1;   /* PAUSE=2: fault baseline, read before the clock starts */\n",
    "    int _usecpu = extc_rc_stepCpu && extc_rc_pauseOn > 0 && extc_rc_cpuClock();   /* EXTC_RC_STEP_CPU: CPU clock only when the probe says it exists */\n",
    "    long long _c0 = (_usecpu || extc_rc_pauseOn > 1) ? extc_rc_cpuNow() : -1;\n",
    "    long long _t0 = extc_rc_pauseOn > 0 ? extc_rc_pauseNow() : 0;   /* wall baseline always (CPU channel = min(CPU, wall)); only when the switch is off is the call skipped */\n",
    "    uint32_t _b0 = budget, _left = budget;\n",
    "    long long _f0 = (long long)r->swFreed;\n",
    "    int _trans = 0;   /* slab boundaries crossed by this step (a new slab's bitmap pages are cold) */\n",
    "    while (_left > 0 && r->swSlab) {\n",
    "        if (r->swWord == 0 && extc_rc_sweepElide(r)) { _left--; _trans++; continue; }   /* entire slab garbage: one decision instead of a free per slot */\n",
    "        _left--;\n",
    "        if (extc_rc_sweepWord(r)) break;\n",
    "        if (r->swWord == 0) _trans++;\n",
    "    }\n",
    "    if (extc_rc_pauseOn > 0) {   /* sweep components: how many words this step swept, how many slots it released */\n",
    "        long long _d = extc_rc_stepSpan(_c0, _t0);\n",
    "        long long _sw = (long long)_b0 - (long long)_left, _fr = (long long)r->swFreed - _f0;\n",
    "        extc_rc_stepNote(_d);\n",
    "        {\n",
    "            int _first = r->swFirst;   /* only the first step of a round touches new slab pages */\n",
    "            r->swFirst = 0;\n",
    "            extc_rc_topNote(1, extc_rc_why, _d, _fr, _sw, 0, -1, _first, _trans,\n",

    "                            extc_rc_pauseOn > 1 ? extc_rc_minflt() - _mf0 : -1,\n",

    "                            (long long)r->thr, (long long)extc_rc_mmaxEff(r), (long long)(r->scale > 0 ? r->scale : 1), extc_rc_pressure(r),\n",

    "                        _usecpu ? _d : ((extc_rc_pauseOn > 1 && extc_rc_cpuClock()) ? extc_rc_cpuNow() - _c0 : -1));\n",

    "        }\n",
    "        if (extc_rc_slowUs > 0 && _d > extc_rc_slowUs) {\n",
    "            if (extc_rc_slowRingOn) {\n",
    "                if (extc_rc_slowRingN < EXTC_RC_SLOW_RING) extc_rc_slowRing[extc_rc_slowRingN++] = _d;\n",
    "                else extc_rc_slowRingOver++;\n",
    "            } else\n",
    "            fprintf(stderr, \"[slow] kind=sweep why=%s dur_us=%.1f sw_words=%lld freed=%lld budget=%lld\\n\",\n",
    "                    extc_rc_why, _d / 1000.0, _sw, _fr, (long long)_b0);\n",
    "        }\n",
    "        if (_d > extc_rc_worstNs) {\n",
    "            extc_rc_worstNs = _d; extc_rc_worstKind = \"sweep\"; extc_rc_worstWhy = extc_rc_why;\n",
    "            extc_rc_worstBudget = (long long)_b0; extc_rc_worstPops = -1; extc_rc_worstMarked = -1;\n",
    "            extc_rc_worstWords = -1; extc_rc_worstPushes = -1;\n",
    "            extc_rc_worstSwWords = _sw; extc_rc_worstSwFreed = _fr;\n",
    "            extc_rc_worstSeg = -1;   /* sweep steps have no resumed mark segment */\n",
    "        }\n",
    "        if (_b0 > EXTC_RC_MARK_BATCH_MAX) {   /* whole-round drain (the sweep tail of settle/finish) is listed separately */\n",
    "            extc_rc_wUbSwN++;\n",
    "            if (_sw > extc_rc_wUbSwWordsMax) extc_rc_wUbSwWordsMax = _sw;\n",
    "            if (_fr > extc_rc_wUbSwFreedMax) extc_rc_wUbSwFreedMax = _fr;\n",
    "            if (getenv(\"EXTC_RC_TRACE_UB\"))\n",
    "                fprintf(stderr, \"[ubtrace] step_n=%lld kind=sweep why=%s words=%lld freed=%lld budget=%u\\n\",\n",
    "                        extc_rc_stepN, extc_rc_why, _sw, _fr, _b0);\n",
    "        }\n",
    "    }\n",
    "    if (r->swSlab) return 0;   /* skip:sweep-continue */\n",
    "    r->sweeping = 0;\n",
    "    if (r->swFreed == 0) {\n",
    "        r->scale = (r->scale > 0 ? r->scale : 1) * EXTC_RC_SCALE_MUL;\n",
    "        if (r->scale > EXTC_RC_SCALE_MAX) r->scale = EXTC_RC_SCALE_MAX;\n",
    "    } else {\n",
    "        r->scale = 0;\n",
    "    }\n",
    "    /* live was fixed when marking completed; sweep completion only closes the round */\n",
    "    extc_rc_thrUpd(r);\n",
    "    r->sweeps++;\n",
    "    /* the round is closed and the sweep cursor is done: the capacity pass runs here, so the mutator path hands capacity back too */\n",
    "    extc_rc_returnStep(r);   /* bounded: RETURN_VISIT_MAX blocks visited, RETURN_SLAB_MAX unlinked, RETURN_BYTES of pages; inside the closing step, so the pause distribution sees the cost */\n",
    "    extc_rc_fqDrainAuto();   /* free one bounded batch of the queue inside the step: dead RSS must not wait for an explicit settle */\n",
    "    return 1;\n",
    "}\n",
    "/** @brief Push the round of stepped sweep in flight to the end: used by account queries and settling points (not on the hot path).\n",
    " *  A region under obligation 7 is voided on the spot (abandoned) and not one byte is swept further. */\n",
    "__attribute__((unused)) static void extc_rc_settle(ExtcRcRegion *r) {\n",
    "    if (!r) return;   /* skip:no-region */\n",
    "    extc_rc_why = \"settle\";\n",
    "    if (r->marking && !r->noSweep) {   /* a round in flight must be closed too: query and destroy sites are the last backstop */\n",
    "        while (!r->seedsDone || r->msp || r->scanObj) extc_rc_markStep(r, 0xffffffffu);\n",
    "        extc_rc_finish(r);\n",
    "    }\n",
    "    if (!r->sweeping) return;   /* skip:not-sweeping */\n",
    "    if (r->noSweep) { r->sweeping = 0; return; }   /* skip:nosweep-abandon */\n",
    "    while (!extc_rc_sweepStep(r, 0xffffffffu)) { }\n",
    "    extc_rc_fqDrainAuto();   /* bounded: settle drains one batch of the free queue, never the whole thing */\n",
    "}\n",
    "/** @brief Sweep everything in one pass (budget is infinite): a reference entry equivalent to the stepped sweep. */\n",
    "__attribute__((unused)) static size_t extc_rc_sweep(ExtcRcRegion *r) {\n",
    "    extc_rc_sweepBegin(r);\n",
    "    extc_rc_settle(r);\n",
    "    return r->swFreed;\n",
    "}\n",
    "\n",
    "/* Trigger: memory pressure, with a self-tuning retreat. Counting already reclaims everything that is not a cycle, so occupancy ~= live, hence\n",
    " * \"occupancy > max(2 x live after the last sweep, floor) x multiplier\" holds only when cycles really pile up.\n",
    " * A sweep that finds nothing multiplies the multiplier by EXTC_RC_SCALE_MUL (learning \"no cycles here\"); a real find resets it. */\n",
    "/* The threshold only moves when live / floor / scale change (see the three call sites of `thrUpd`), so cache it;\n",
    " * every allocation then does one `bytes > thr` comparison. The overflow case is expressed as `thr = 0` (= sweep as soon as anything was allocated). */\n",
    "__attribute__((unused)) static void extc_rc_thrUpd(ExtcRcRegion *r) {\n",
    "    int64_t scale = r->scale > 0 ? r->scale : 1;\n",

    "    int64_t thr = r->live * 2;\n",

    "    if (thr < r->floor) thr = r->floor;\n",

    "    if (scale > 1 && thr > INT64_MAX / scale) { r->thr = 0; return; }\n",

    "    thr *= scale;\n",

    "    /* Memory-wall contract: live + garbage <= M_max, so the trigger line is also capped at M_max - max(64*L/b, R_max) (b = 256 => L/4; R_max = the biggest single request, so one such request always still fits under the wall).\n",
    "     * The R_max reserve binds **only under an explicit wall** (EXTC_RC_M_MAX set): with the implicit 3*L wall the promise cannot be kept anyway (L grows), and binding it there lowers the trigger line in the early phase (while live/4 < R_max) and inflates the self-learned scale multiplier (up to 64x), which raises the peak:\n",
    "     * pd_pointer_dense goes 112,092 -> 142,620 kB (+27.3%). Default memory behaviour must not pay for a guarantee that only means something under an explicit wall.\n",

    "     * An implicit (unset) M_max is 3*L; a wall below floor cannot be met -- use floor and report once, never trap. */\n",

    "    int64_t _wall = extc_rc_mmaxEff(r);\n",
    "    int64_t _res = 0;   /* heap kept free above the trigger line (admission reserve) */\n",

    "    if (_wall > 0) {\n",

    "        _res = r->live / 4;   /* b = 256 => L/4: the biggest batch one scan step leaves behind */\n",
    "        if (extc_rc_mmax > 0 && r->maxReq > _res) {   /* admission by request size: reserve one biggest-request-worth of heap, explicit wall only (see above) */\n",
    "            _res = r->maxReq;\n",
    "            if (_res > r->live) _res = r->live;   /* never push the trigger line below the live set: that would collect on every allocation */\n",
    "        }\n",
    "        int64_t _cap = _wall - _res;\n",

    "        if (_cap < r->floor) {\n",

    "            _cap = r->floor;\n",

    "            if (!extc_rc_wallWarned) {   /* report once, and only when the wall was asked for explicitly or a diagnostic switch is on: a bench run keeps stderr empty */\n",
    "                extc_rc_wallWarned = 1;\n",
    "                if (extc_rc_mmax > 0 || extc_rc_pauseOn > 0 || getenv(\"EXTC_RC_STATS\") || getenv(\"EXTC_RC_TIME\"))\n",
    "                    fprintf(stderr, \"[mmax] memory wall unreachable: M_max=%lld floor=%lld; using floor\\n\", (long long)_wall, (long long)r->floor);\n",
    "            }\n",

    "        }\n",

    "        if (thr > _cap) thr = _cap;\n",

    "    }\n",

    "    r->thr = thr;\n",

    "    if (thr > extc_rc_thrMax) extc_rc_thrMax = thr;\n",

    "    if (scale > extc_rc_scaleMax) extc_rc_scaleMax = scale;\n",
    "    extc_rc_thrNow = thr;\n",
    "    extc_rc_maxReqNow = r->maxReq; extc_rc_resNow = _res;\n",

    "    extc_rc_mmaxNow = _wall;\n",

    "    if (_wall > extc_rc_mmaxUsed) extc_rc_mmaxUsed = _wall;\n",


    "}\n",
    "/* Round credit: separate from the targeted-release credit -- release spends visitedBytes every time, so sharing one counter would starve round start. */\n",
    "/* Both are asked once per op (targeted-release points in generated code), so `inline` lets the call site flatten them\n",
    " * and saves a call/return; no `always_inline`, the compiler decides stack depth per call site. */\n",
    "__attribute__((unused)) static inline int extc_rc_roundOk(const ExtcRcRegion *r) {\n",
    "    int64_t need = r->live > r->floor ? r->live : r->floor;\n",

    "    if (extc_rc_pressure(r)) need /= EXTC_RC_SWEEP_PRESSURE_MUL;   /* pressure relaxes the pace only: earlier round start, same soundness conditions */\n",

    "    return r->allocBytes - r->roundVisitedBytes >= need;\n",

    "}\n",
    "__attribute__((unused)) static inline int extc_rc_shouldSweep(const ExtcRcRegion *r) {\n",
    "    if (r->noSweep) return 0;   /* an in-edge whose host cannot be traced: this region is reclaimed by counting only */   /* skip:nosweep */\n",
    "#if EXTC_RC_SWEEP_FREE\n",
    "    /* The whole program is proven **acyclic**: every unreachable object is eventually released on the spot when its count hits zero, so a sweep has nothing to do, so\n",
    "     * do not sweep. Erring this way means \"should have swept but did not\", so memory grows (not a dangling pointer). */\n",
    "    return 0;   /* skip:sweepfree */\n",
    "#else\n",
    "    /* Triggering looks only at pressure: credit is not a trigger, it only decides whether targeted release should do one O(live set) walk */\n",
    "    return r->bytes > r->thr && extc_rc_roundOk(r);   /* round credit: a separate counter, targeted release does not spend it */\n",
    "#endif\n",
    "}\n",
    "\n",
    "#include <time.h>\n",
    "/* EXTC_RC_PAUSE=1: accumulate the duration of every **real sweep** (coarse: take the clock before and after), printed at process exit.\n",
    " * The accounting matches the prototype/reclaim/sim.c pauses (max + total + count). If the platform exposes a monotonic clock use\n",
    " * it, otherwise fall back to ISO C `clock()` (CPU time, which underestimates time blocked on page faults/IO). Off by default. */\n",
    "static long long extc_rc_pauseMax, extc_rc_pauseTotal, extc_rc_pauseN;\n",
    "static int extc_rc_pauseOn = -1;\n",
    "#if defined(CLOCK_MONOTONIC)\n",
    "#define EXTC_RC_PAUSE_CLK \"wall\"   /* pauseNow uses CLOCK_MONOTONIC */\n",
    "#else\n",
    "#define EXTC_RC_PAUSE_CLK \"clock\"   /* pauseNow fell back to ISO C clock(): process CPU time, microsecond granularity */\n",
    "#endif\n",
    "static long long extc_rc_pauseNow(void) {\n",
    "#if defined(CLOCK_MONOTONIC)\n",
    "    struct timespec t;\n",
    "    t.tv_sec = 0; t.tv_nsec = 0;\n",
    "    (void)clock_gettime(CLOCK_MONOTONIC, &t);   /* on failure leave 0: the reading is 0 rather than skipped */\n",
    "    return (long long)t.tv_sec * 1000000000LL + t.tv_nsec;\n",
    "#else\n",
    "    return (long long)clock() * 1000000000LL / (CLOCKS_PER_SEC ? CLOCKS_PER_SEC : 1);\n",
    "#endif\n",
    "}\n",
    "/* Thread CPU time (read only while EXTC_RC_PAUSE=2): wall time minus this is preemption/IO, not GC work. -1 when unavailable. */\n",
    "static long long extc_rc_cpuNow(void) {\n",
    "#if defined(CLOCK_THREAD_CPUTIME_ID)\n",
    "    struct timespec t;\n",
    "    t.tv_sec = 0; t.tv_nsec = 0;\n",
    "    (void)clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);   /* on failure leave 0: the reading is 0 rather than skipped */\n",
    "    return (long long)t.tv_sec * 1000000000LL + t.tv_nsec;\n",
    "#else\n",
    "    return -1;   /* no thread CPU clock: the field stays -1 (unknown) rather than being faked by wall time */\n",
    "#endif\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_pauseDump(void) {\n",
