    "__attribute__((unused)) static void extc_rc_pauseArm(void) {\n",
    "    if (extc_rc_pauseOn < 0) {\n",
    "        {   /* 1 = timing/counters; 2 = also read minor faults for the top-K attribution dump */\n",
    "            const char *_pz = getenv(\"EXTC_RC_PAUSE\");\n",
    "            extc_rc_pauseOn = _pz ? (atoi(_pz) >= 2 ? 2 : 1) : 0;\n",
    "        }\n",
    "        {   /* EXTC_RC_STEP_CPU=1: step/histogram/top/channel durations use the thread CPU clock; default is the wall clock */\n",
    "            const char *_sc = getenv(\"EXTC_RC_STEP_CPU\");\n",
    "            extc_rc_stepCpu = (_sc && _sc[0] && _sc[0] != '0') ? 1 : 0;\n",
    "            extc_rc_cpuReq = extc_rc_stepCpu;\n",
    "            (void)extc_rc_cpuClock();   /* probe once: without the CPU clock the durations stay wall/clock, never 0 */\n",
    "            if (!extc_rc_cpuOk) extc_rc_stepCpu = 0;\n",
    "        }\n",
    "        {   /* slow-step threshold (us); unset => -1 (off). Validate before converting:\n",
    "             * atof(\"abc\") is 0 and 1e300*1000 falls outside long long (that conversion is undefined),\n",
    "             * so anything that is not a finite positive number of microseconds turns the probe off. */\n",
    "            const char *_ss = getenv(\"EXTC_RC_SLOWSTEP\");\n",
    "            double _sv = (_ss && *_ss) ? atof(_ss) : -1.0;\n",
    "            if (_sv > 0.0 && _sv <= 1e15) extc_rc_slowUs = (long long)(_sv * 1000.0);\n",
    "            else {\n",
    "                extc_rc_slowUs = -1;\n",
    "                if (_ss && *_ss) fprintf(stderr, \"[slow] ignored EXTC_RC_SLOWSTEP=%s (want 0 < us <= 1e15)\\n\", _ss);\n",
    "            }\n",
    "        }\n",
    "        {   /* EXTC_RC_SLOWSTEP_RING=1: aggregate slow steps instead of printing one line each */\n",
    "            const char *_sr = getenv(\"EXTC_RC_SLOWSTEP_RING\");\n",
    "            extc_rc_slowRingOn = (_sr && _sr[0] && _sr[0] != '0') ? 1 : 0;\n",
    "        }\n",
    "        if (extc_rc_pauseOn) atexit(extc_rc_pauseDump);\n",
    "    }\n",
    "}\n",
    "/* Finish: marking is done but the round is still open, so close the barrier now and start a (stepped) sweep.\n",
    " * Only finish, **do not start a new round** -- going through collect would start a new round and immediately fill the space just reclaimed. */\n",
    "__attribute__((unused)) static void extc_rc_finish(ExtcRcRegion *r) {\n",
    "    if (!r->marking || !r->seedsDone || r->msp != 0 || r->scanObj) return;   /* skip:finish-early */\n",
    "    extc_rc_why = \"finish\";\n",
    "    r->marking = 0;\n",
    "    r->live = r->markedBytes > 0 ? r->markedBytes : r->live;\n",
    "    extc_rc_thrUpd(r);\n",
    "    r->markDone = 0;\n",
    "    {   /* R4 pairing self-check: a region marked true contributed +1; the **old value** of the atomic decrement must be >= 1.\n",
    "         * Old value 0 means underflow: this region never contributed +1, or its count lost an update to another thread's plain ++/--. */\n",
    "        int _wb0 = extc_rc_wbAdd(-1);\n",
    "        if (_wb0 < 1) extc_rc_oops(\"R4: barrier participant underflow on finish\");\n",
    "    }\n",
    "    r->visitedBytes = r->allocBytes;\n",
    "    r->roundVisitedBytes = r->allocBytes;\n",
    "    extc_rc_sweepBegin(r);\n",
    "    extc_rc_sweepStep(r, EXTC_RC_SWEEP_BUDGET * (uint32_t)(extc_rc_pressure(r) ? EXTC_RC_SWEEP_PRESSURE_MUL : 1));\n",

    "}\n",
    "/* Start a round: set \"in flight\", record round credit, push seeds. Shared by step / collect so the two cannot drift apart. */\n",
    "__attribute__((unused)) static void extc_rc_begin(ExtcRcRegion *r, void *const *roots, size_t nroots) {\n",
    "#if EXTC_RC_ELIDE_VERIFY\n",
    "    /* Verify-mode invariant: a new round starts with every slab's nMark and every mark word at zero. The O(1) slab reset trusts nMark == 0;\n",
    "     * a stale roll-up would let it reset a slab that still holds live objects. A mismatch is reported and counted, never repaired silently. */\n",
    "    {\n",
    "        int _shown = 0;\n",
    "        ExtcRcSlab *_vs = r->slabs;\n",
    "        while (_vs) {\n",
    "            unsigned long long _pop = 0;\n",
    "            for (uint32_t _vw = 0; _vw < _vs->nwords; _vw++) _pop += (unsigned long long)__builtin_popcountll(_vs->mark[_vw]);\n",
    "            if (_vs->nMark != 0 || _pop != 0) {\n",
    "                extc_rc_elideMismatch++;\n",
    "                if (_shown < 3) { _shown++; fprintf(stderr, \"[elide] markbegin-mismatch slab=%p nMark=%u pop=%llu\\n\", (void *)_vs, _vs->nMark, _pop); }\n",
    "            }\n",
    "            _vs = _vs->next;\n",
    "        }\n",
    "    }\n",
    "#endif\n",
    "    extc_rc_shadeNextGen();   /* a new mark generation starts: all black records of the previous generation are void */\n",
    "    r->marking = 1;\n",
    "    r->visitedBytes = r->allocBytes;   /* starting a round spends the credit (otherwise credit would never run out when sweeps do not complete) */\n",
    "    r->roundVisitedBytes = r->allocBytes;\n",
    "    r->markedBytes = 0;\n",
    "    r->markTick = EXTC_RC_MARK_EVERY;\n",
    "    r->markStartAlloc = r->allocBytes;\n",
    "    extc_rc_wbAdd(1);   /* R3: participant count (multiple regions, possibly several threads marking at once) */\n",
    "    extc_rc_markBegin(r, roots, nroots);\n",
    "}\n",
    "/* Hot-path entry: **advance one step only**; finish on the spot once this round is done. The us window relies on this. */\n",
    "__attribute__((unused)) static size_t extc_rc_step(ExtcRcRegion *r, void *const *roots, size_t nroots) {\n",
    "    extc_rc_why = \"step\";\n",
    "    if (!r->marking) extc_rc_begin(r, roots, nroots);\n",
    "    extc_rc_markStep(r, extc_rc_stepBudget(r));\n",
    "    r->wbDebt = 0;\n",
    "    extc_rc_finish(r);\n",
    "    return r->swFreed;\n",
    "}\n",
    "/* Contract entry (API / unit tests / settle / account queries): **finish one round within the call**. */\n",
    "__attribute__((unused)) static size_t extc_rc_collect(ExtcRcRegion *r, void *const *roots, size_t nroots) {\n",
    "    EXTC_RC_TICK(3);   /* per-part timing (`EXTC_RC_TIME=1`) */\n",
    "    extc_rc_why = \"collect\";\n",
    "    if (!r->marking) extc_rc_begin(r, roots, nroots);\n",
    "    while (!r->seedsDone || r->msp || r->scanObj) extc_rc_markStep(r, 0xffffffffu);   /* drain marking */\n",
    "    r->wbDebt = 0;\n",
    "    extc_rc_finish(r);\n",
    "    extc_rc_settle(r);   /* go on until the sweep is done too: the contract is one full round */\n",
    "    return r->swFreed;\n",
    "}\n",
    "\n",
    "/* Collect only when pressure is reached: return the number of slots reclaimed; return -1 below the pressure line and touch nothing. */\n",
    "__attribute__((unused)) static int extc_rc_maybeCollect(ExtcRcRegion *r, void *const *roots, size_t nroots) {\n",
    "    extc_rc_why = \"maybe\";\n",
    "    if (r->marking && (r->msp != 0 || !r->seedsDone || r->scanObj)) {   /* advance; when done let it through so collect can finish with the root table */\n",
    "        extc_rc_markAdvance(r);   /* advance in batches */\n",
    "    }\n",
