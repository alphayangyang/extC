    "/* ---- Frame-root chain: replace the static value table with a chain maintained on the stack [rt:chain] ------------------------------\n",
    " *\n",
    " * Problem: roots are now materialized on the spot by codegen on every trigger path as a value table (copying the value of every reference slot in the current scope\n",
    " * into an array). Copying is itself a traversal, and the copies may already be out of step with the slots. The chain registers\n",
    " * slot addresses instead of values: every live reference slot is pushed together with its host frame, marking dereferences along the chain and reads the value at the moment it is used --\n",
    " * reassignments in the frame are visible automatically, and no table has to be generated per trigger path.\n",
    " *\n",
    " * Only the data structure goes into the emitted text for now; no emitter pushes onto the chain yet (see the frameRoots parameter of reclaimEmitRuntime),\n",
    " * so the chain is always empty and marking still uses only the static value table, word for word the same behavior as without this code. Wiring changes the emitter.\n",
    " *\n",
    " * bad = this frame's slot enumeration is incomplete (coroutine frames / ext frames / pool elements / view elements / match bindings, where the compiler cannot obtain\n",
    " * the complete slot list), so seeds would be missing and the whole chain refuses to sweep; nobody sets it yet, it will be set when wired. */\n",
    "typedef void **ExtcRcSlot;   /* address of one reference slot (addr[k] is the slot, *addr[k] is the value) */\n",
    "typedef struct ExtcRcFrameRoot {\n",
    "    ExtcRcSlot *addr;    /* array of slot addresses */\n",
    "    size_t  n;\n",
    "    struct ExtcRcFrameRoot *parent;\n",
    "    int     bad;\n",
    "} ExtcRcFrameRoot;\n",
    "static _Thread_local ExtcRcFrameRoot *extc_rc_chainTop;\n",
    "__attribute__((unused)) static void extc_rc_framePush(ExtcRcFrameRoot *fr, ExtcRcSlot *addr, size_t n) {\n",
    "    fr->addr = addr; fr->n = n; fr->bad = 0; fr->parent = extc_rc_chainTop;\n",
    "    extc_rc_chainTop = fr;\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_framePop(void) {\n",
    "    if (extc_rc_chainTop) extc_rc_chainTop = extc_rc_chainTop->parent;\n",
    "}\n",
    "__attribute__((unused)) static void extc_rc_frameBad(void) {\n",
    "    if (extc_rc_chainTop) extc_rc_chainTop->bad = 1;\n",
    "}\n",
    "/* whether the chain has a frame whose enumeration is incomplete, so seeds are incomplete and sweeping is refused (same decision as noSweep). */\n",
    "__attribute__((unused)) static int extc_rc_chainBad(void) {\n",
    "    for (ExtcRcFrameRoot *fr = extc_rc_chainTop; fr; fr = fr->parent)\n",
    "        if (fr->bad) return 1;   /* skip:chain-bad */\n",
    "    return 0;\n",
    "}\n",
