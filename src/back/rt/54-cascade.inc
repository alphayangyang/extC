    "/* ---- Count-zero cascade: dropping a slot drops the counts of the objects its pointer fields point at [rt:cascade] ----------------\n",
    " *\n",
    " * In the counted tier every reference field of an object that has a type descriptor was incremented when the write happened\n",
    " * (`initRef` / `storeRefOwned*` / `storeStructCons` -- the last one only increments), so releasing the object withdraws each of\n",
    " * those edges once: a child whose count reaches zero is released in the same step, and so on down the subtree. Without that, a\n",
    " * parent released by count leaves its whole subtree at a positive count that nothing decrements again, and the memory waits for\n",
    " * the region drop. The balance argument holds only if every counted write of such a slot increments once: a counted build must\n",
    " * not emit the no-increment store (`initRefNoHold`) for a slot whose object can be released here.\n",
    " *\n",
    " * Two cases are left to the sweep on purpose (collect late, never early): a slot with no descriptor is a data object with no\n",
    " * reference field; a `EXTC_RC_CONSERVATIVE` slot (`alloc<T>(n)`: the element count is dynamic) cannot be walked statically,\n",
    " * so its fields keep their counts.\n",
    " *\n",
    " * Cross-region children: the work list belongs to the region that started the drain, but a child may live in another region. It\n",
    " * is pushed onto the same list and its later freeSlot accounts to its own region; freeSlot itself never starts a cascade (only a\n",
    " * count reaching zero does), so a drain cannot nest. If freeSlot ever becomes cascading, the inner drain must first skip while csp\n",
    " * is non-empty, so one region has at most one drain in flight.\n",
    " *\n",
    " * No C recursion -- chain-shaped heaps are millions of links deep. The work list is a region-owned array of (slab, slot)\n",
    " * pairs; a slot is pushed only at the moment its count reaches zero, so a slot is never pushed twice, and `freeSlot` clears\n",
    " * the occupied bit, so a cycle cannot visit a slot a second time (the pop of a released slot is skipped). Children are\n",
    " * counted down **before** the object is released: its descriptor and fields are still intact at that point. If the list\n",
    " * cannot grow, the child keeps its count and is left for the sweep, the same safe direction.\n",
    " * `-DEXTC_RC_CASCADE_DEBUG=1` (a compile-time macro, not a run-time environment variable) counts the released slots and checks the invariants above. */\n",
    "#ifndef EXTC_RC_CASCADE_DEBUG\n",
    "#define EXTC_RC_CASCADE_DEBUG 0\n",
    "#endif\n",
    "#if EXTC_RC_CASCADE_DEBUG\n",
    "static long long extc_rc_cascRuns, extc_rc_cascFreed, extc_rc_cascMaxStack, extc_rc_cascBad;\n",
    "static void extc_rc_cascDump(void) {\n",
    "    fprintf(stderr, \"[cascade] runs=%lld freed=%lld max_stack=%lld bad=%lld\\n\",\n",
    "            extc_rc_cascRuns, extc_rc_cascFreed, extc_rc_cascMaxStack, extc_rc_cascBad);\n",
    "}\n",
    "static void extc_rc_cascArm(void) {\n",
    "    static int armed;\n",
    "    if (!armed) { armed = 1; atexit(extc_rc_cascDump); }\n",
    "}\n",
    "#endif\n",
    "__attribute__((unused)) static int extc_rc_cascadePush(ExtcRcRegion *r, ExtcRcSlab *s, size_t i) {\n",
    "    if (r->csp == r->cscap) {\n",
    "        size_t nc = r->cscap ? r->cscap * 2 : 256;\n",
    "        void **ns = (void **)realloc(r->cstk, nc * 2 * sizeof(void *));\n",
    "        if (!ns) return 0;   /* skip:cascade-oom: out of memory: the child keeps its count and the sweep collects it */\n",
    "        r->cstk = ns;\n",
    "        r->cscap = nc;\n",
    "    }\n",
    "    r->cstk[2 * r->csp] = s;\n",
    "    r->cstk[2 * r->csp + 1] = (void *)(uintptr_t)i;\n",
    "    r->csp++;\n",
    "    return 1;\n",
    "}\n",
    "\n",
    "__attribute__((unused)) static void extc_rc_freeSlotCascade(ExtcRcSlab *s, size_t i) {\n",
    "    ExtcRcRegion *r = s->region;\n",
    "    if (!r || !extc_rc_cascadePush(r, s, i)) { extc_rc_freeSlot(s, i); return; }\n",
    "#if EXTC_RC_CASCADE_DEBUG\n",
    "    extc_rc_cascArm();\n",
    "    if (r->csp > extc_rc_cascMaxStack) extc_rc_cascMaxStack = r->csp;\n",
    "#endif\n",
    "    while (r->csp) {\n",
    "        r->csp--;\n",
    "        ExtcRcSlab *cs = (ExtcRcSlab *)r->cstk[2 * r->csp];\n",
    "        size_t ci = (size_t)(uintptr_t)r->cstk[2 * r->csp + 1];\n",
    "        if (ci >= cs->nslots) {\n",
    "#if EXTC_RC_CASCADE_DEBUG\n",
    "            extc_rc_cascBad++;\n",
    "#endif\n",
    "            continue;\n",
    "        }\n",
    "        if (!(cs->occ[extc_rc_word(ci)] & extc_rc_bit(ci))) continue;   /* released through a cycle: nothing left to do */\n",
    "        if (cs->hold[ci] != 0) {\n",
    "#if EXTC_RC_CASCADE_DEBUG\n",
    "            extc_rc_cascBad++;\n",
    "#endif\n",
    "            continue;   /* the count was raised again: still held */\n",
    "        }\n",
    "        const ExtcRcType *t = extc_rc_typeOf(cs, ci);\n",
    "        char *p = EXTC_RC_SLAB_DATA(cs) + ci * cs->ss;\n",
    "        if (t && t != EXTC_RC_CONSERVATIVE) {\n",
    "            for (uint32_t k = 0; k < t->nptr; k++) {\n",
    "                void *ch = *(void **)(p + t->off[k]);\n",
    "                if (!ch) continue;\n",
    "                ExtcRcSlab *chs = extc_rc_ownSlab(ch);\n",
    "                if (!chs) continue;   /* not a slot of this runtime: no count was added for it */\n",
    "                size_t chi = extc_rc_slotOf(chs, ch);\n",
    "                if (!(chs->occ[extc_rc_word(chi)] & extc_rc_bit(chi))) continue;   /* free slot: not a live object */\n",
    "                if (chs->hold[chi] == 0 || chs->hold[chi] == EXTC_RC_HOLD_SAT) continue;\n",
    "                chs->hold[chi]--;\n",
    "                if (chs->hold[chi] == 0) (void)extc_rc_cascadePush(r, chs, chi);\n",
    "            }\n",
    "        }\n",
    "        extc_rc_freeSlot(cs, ci);\n",
    "#if EXTC_RC_CASCADE_DEBUG\n",
    "        extc_rc_cascFreed++;\n",
    "#endif\n",
    "    }\n",
    "#if EXTC_RC_CASCADE_DEBUG\n",
    "    extc_rc_cascRuns++;\n",
    "#endif\n",
    "}\n",
    "#endif\n",
