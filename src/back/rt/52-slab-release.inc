    "/* ---- Dead-slab release ----\n",
    " * The sweep can skip only a slab that holds no reachable object; a slab that keeps one long-lived object must be scanned word by word every\n",
    " * round, so the work is proportional to region capacity rather than to the live set, and capacity is a high-water mark that never comes down.\n",
    " * The sparse pattern (a few survivors in every block, round after round) is where this bites: the survivor forces the whole block to be swept.\n",
    " * This pass unlinks slabs that hold no occupied slot at all and queues them for the existing bounded free queue, so capacity follows the live\n",
    " * set instead of the peak. Bounds: at most EXTC_RC_SHRINK_VISIT_MAX chain visits and EXTC_RC_SHRINK_REL_MAX queued slabs per closing point (the tail of extc_rc_sweepStep);\n",
    " * the free itself happens in extc_rc_fqDrainCore, which already carries a budget and a deadline.\n",
    " * Safety: only a slab with nLive == 0 is taken (no live object can be in it), the bump slab of a parse region is never taken, a slab whose\n",
    " * cross-region in-edge bits are set is left to the bulk reset path, and the slab leaves the ownership registry before it is queued. A\n",
    " * huge slab (one slot, payload of its own) qualifies like any other: an empty one is unlinked, and its payload goes to the drop\n",
    " * chain, which carries its own bounded drain -- that is what keeps capacity from following the sum of dead generations. */\n",
    "#ifndef EXTC_RC_SLAB_KEEP\n",
    "#define EXTC_RC_SLAB_KEEP 0            /* empty small slabs kept per region for reuse; 0 = hand every empty one back */\n",
    "#endif\n",
    "#ifndef EXTC_RC_SLAB_KEEP_BIG\n",
    "#define EXTC_RC_SLAB_KEEP_BIG 0x7fffffff   /* cap on how many empty huge slabs one closing may keep: the count is not the bound, the\n",
    "                                         * reuse test is (a block survives while it keeps being reused, see deadA/deadN in\n",
    "                                         * extc_rc_slabShrink), so the cap only makes a bounded cache sayable; 0 turns the cache off for A/B. */\n",
    "#endif\n",
    "#ifndef EXTC_RC_SHRINK_GRACE\n",
    "#define EXTC_RC_SHRINK_GRACE 1       /* closings an empty huge block may sit unreused before it is surplus: one spare cycle is what\n",
    "                                       * a growth step needs (the block is reused one closing after the one that first saw it empty), and\n",
    "                                       * more than one lets a growing shape keep its dead generations. */\n",
    "#endif\n",
    "#ifndef EXTC_RC_SHRINK_CAP_LIVE\n",
    "#define EXTC_RC_SHRINK_CAP_LIVE 3    /* capacity budget as a multiple of the live set: above it a closing hands empty blocks back,\n",
    "                                       * so the reuse cache is bounded even when a churn keeps asking for blocks. 0 = no budget. */\n",
    "#endif\n",
    "#ifndef EXTC_RC_SHRINK_VISIT_MAX\n",
    "#define EXTC_RC_SHRINK_VISIT_MAX 256   /* chain visits per closing point: bounds the pass, not the queued count */\n",
    "#endif\n",
    "#ifndef EXTC_RC_SHRINK_REL_MAX\n",
    "#define EXTC_RC_SHRINK_REL_MAX 16      /* slabs queued per closing point */\n",
    "#endif\n",
    "#ifndef EXTC_RC_SHRINK_MIN_SLACK\n",
    "#define EXTC_RC_SHRINK_MIN_SLACK (8 << 20)   /* release dead blocks only when capacity exceeds occupancy by this much: no release/re-carve churn */\n",
    "#endif\n",
    "static long long extc_rc_slabRel __attribute__((unused));\n",
    "__attribute__((unused)) static long long extc_rc_slabShrink(ExtcRcRegion *r) {\n",
    "    if (!r) return 0;   /* skip:shrink-null */\n",
    "    if (r->capBytes - (int64_t)r->bytes < (int64_t)EXTC_RC_SHRINK_MIN_SLACK) return 0;   /* skip:shrink-slack */\n",
    "    if (EXTC_RC_SHRINK_CAP_LIVE > 0 && r->capBytes <= r->bytes * (int64_t)EXTC_RC_SHRINK_CAP_LIVE) return 0;   /* skip:shrink-budget */\n",
    "    long long keep = EXTC_RC_SLAB_KEEP, keepBig = EXTC_RC_SLAB_KEEP_BIG, rel = 0, seen = 0;\n",
    "    /* Reuse cache with a grace window: an empty huge block is kept while it keeps being reused (deadA holds allocN + 1 at the last\n",
    "     * empty closing, 0 = alive), and one spare closing after that (deadN counts them). A block nothing came back for is surplus and goes\n",
    "     * back -- the difference between a churn (capacity follows a generation or two) and a growing shape (the sum of them). */\n",
    "    ExtcRcSlab *s = r->slabs;\n",
    "    while (s && seen < EXTC_RC_SHRINK_VISIT_MAX && rel < EXTC_RC_SHRINK_REL_MAX) {\n",
    "        ExtcRcSlab *n = s->next;\n",
    "        seen++;\n",
    "        if (s->nLive != 0 || s == r->bumpSlab) { s->deadA = 0; s->deadN = 0; s = n; continue; }   /* alive: no empty history */\n",
    "        if (s->big) {   /* grace: keep the block while it comes back for another round */\n",
    "            if (s->deadA == 0 || s->deadA != s->allocN + 1) { s->deadA = s->allocN + 1; s->deadN = 0; keepBig--; s = n; continue; }\n",
    "            if (s->deadN < (uint8_t)EXTC_RC_SHRINK_GRACE) { s->deadN++; keepBig--; s = n; continue; }\n",
    "        }\n",
    "        else if (keep > 0) { keep--; s = n; continue; }\n",
    "        if (extc_rc_rsIncN) {\n",
    "            uint32_t w;\n",
    "            int held = 0;\n",
    "            for (w = 0; w < s->nwords; w++) if (s->rsbit[w]) { held = 1; break; }\n",
    "            if (held) { s = n; continue; }\n",
    "        }\n",
    "        if (r->trimCur == s) r->trimCur = s->next;   /* the page pass must not keep a block that leaves the chain */\n",
    "        if (s->prev) s->prev->next = s->next; else r->slabs = s->next;\n",
    "        if (s->next) s->next->prev = s->prev;\n",
    "        if (s->avail) {\n",
    "            if (s->availPrev) s->availPrev->availNext = s->availNext;\n",
    "            else {\n",
    "                ExtcRcClass *c = extc_rc_classSlot(r, s->ss);\n",
    "                if (c && c->head == s) c->head = s->availNext;\n",
    "            }\n",
    "            if (s->availNext) s->availNext->availPrev = s->availPrev;\n",
    "            s->avail = 0;\n",
    "        }\n",
    "        s->prev = (ExtcRcSlab *)0;\n",
    "        s->availNext = (ExtcRcSlab *)0;\n",
    "        s->availPrev = (ExtcRcSlab *)0;\n",
    "        r->capBytes -= (int64_t)s->nslots * (int64_t)s->ss;   /* the block leaves the chain: capacity leaves with it */\n",
    "        extc_rc_ownDel(s);\n",
    "        extc_rc_fqPushOne(s);\n",
    "        rel++;\n",
    "        s = n;\n",
    "    }\n",
    "    if (rel) { memset(r->allocHot, 0, sizeof(r->allocHot)); extc_rc_slabRel += rel; }\n",
    "    return rel;\n",
    "}\n",
