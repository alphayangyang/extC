/* `??` —— **可能没有就兜底**（`?` 那一族的第三个记号）

 *   `opt ?? 兜底`    有值就给值，没有就给兜底
 *   `r ?? 兜底`      成功给值，失败给兜底
 *   `p ?? q`（?ref） null 就给另一个引用
 *
 * 语义 = `match 主体 { 有(v) => v  _ => 兜底 }`，但**只算一边** ✓
 * （生成的是 C 的三元运算符 ⇒ 有值时兜底那侧根本不求值 —— 副作用不会白跑）
 *
 * 主体是**调用**（`f() ?? -1`）也可以：编译器会先算一次装进临时变量，
 * 再把三元写在那上面 ⇒ **f() 只跑一次** ✓
 *    生成的 C 是两句：
 *        option_i64 __extc_c0 = f();
 *        ... (__extc_c0.tag == option_i64_some ? __extc_c0.u.some._0 : -1) ...
 *    主体本来就是变量时（`opt ?? -1`）**不生成临时变量**，直接三元 ✓
 *
 * ⚠️ 两个位置吐不出临时变量，编译器直接报错（不是不管）：
 *    · **`while` 的条件** —— 吐出来就变成"进循环前算一次"，而不是每轮算 ✗ **语义就错了**
 *      ⇒ 写成语句形式：`while true { let r = f()  if ... break }`
 *    · **全局初始化式** —— 没有语句可挂
 */

struct node {
    value: i64
    next: ?ref node
}

fn find(head: ?ref node, want: i64) -> ?ref node {
    var cur: ?ref node = head
    while cur != null {
        if cur.value == want { return cur }
        cur = cur.next
    }
    return null
}

fn half(n: i64) -> ?i64 {
    if n % 2 != 0 { return none }
    return some(n / 2)
}

fn checked(n: i64) -> result<i64, i32> {
    if n < 0 { return failure(7) }
    return success(n * 2)
}

fn shout() -> i64 {
    println("（兜底那侧被求值了）")
    return -1
}

fn main() {
    /* ① option：一行代替昨天那个五行小函数 `orElse` ✓ */
    var ten = half(10)
    var seven = half(7)
    println("half(10) ?? -1 = ", ten ?? -1)
    println("half(7)  ?? -1 = ", seven ?? -1)

    /* ② result：失败就给兜底 */
    var good = checked(3)
    var bad = checked(-3)
    println("checked(3)  ?? -1 = ", good ?? -1)
    println("checked(-3) ?? -1 = ", bad ?? -1)

    /* ③ `?ref`：null 就换成另一个引用（考场上"找不到就用哨兵"的写法）*/
    var c: node = { value: 3, next: null }
    var b: node = { value: 2, next: ref c }
    var hit  = find(ref b, 2)
    var miss = find(ref b, 99)
    var p: ?ref node = miss ?? hit
    println("兜底后的值 = ", p!.value)

    /* ④ 主体可以是字段/下标（纯的 ✓） */
    var table: [4]i64 = [10, 20, 30, 40]
    var opt: ?i64 = some(99)
    println("字段 = ", opt ?? table[2])

    /* ⑤ **数组里的 option**：`[4]?i64` —— 第三刀（option 变枚举）之后才合法 ✓
     * （零槽位就是 `none` ⇒ "哈希表的空位"白送）*/
    var slots: [4]?i64
    slots[0] = some(11)
    slots[3] = some(44)
    println("空槽位 = ", slots[1] ?? -1, " 有值的 = ", slots[3] ?? -1)

    /* ⑥ 右结合：`a ?? b ?? c` = `a ?? (b ?? c)` */
    println("链式 = ", seven ?? ten ?? -1)

    /* ⑦ **只算一边**：主体有值时，兜底那侧（带副作用的函数）根本不会跑 ✓ */
    println("有值时   = ", ten ?? shout())
    println("没有时   = ", seven ?? shout())

    /* ⑧ 主体是调用 ⇒ **直接写就行**（编译器自己引一个临时变量，只算一次 ✓）*/
    println("主体是调用 = ", find(ref b, 3) ?? hit, " / ", half(9) ?? -1)

    /* ⑨ 主体本来就是变量 ⇒ **不生成任何临时变量**，就是纯三元 ✓ */
    println("主体是变量 = ", seven ?? -1)
}
