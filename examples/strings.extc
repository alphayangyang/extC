// 字符串 = slice<u8>（零分配零拷贝），内容比较 / 查找全部**用 extC 写在 prelude 里**

fn main() -> i32 {
    let s = "hello world"

    println(s)                       // hello world
    println(s.len)                   // 11  —— len 是普通字段
    println(s.isEmpty())             // false
    println(s[0])                    // 104 —— 索引（越界会 trap，带位置）
    println(s.get(1))                // 101

    println(s == "hello world")      // true  —— **按内容比较**
    println(s == "hello worle")      // false
    println(s != "nope")             // true

    println(s.find("world"))         // 6     —— 词法分析器的核心
    println(s.find("xyz"))           // -1
    println(s.startsWith("hello"))   // true
    println(s.startsWith("world"))   // false

    println("")                      // 空串合法：长度 0 的字节视图
    return 0
}
