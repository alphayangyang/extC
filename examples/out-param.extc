/* 出参的**能跑形状**：往调用者的容器里塞东西（`varArray<T>` 就是这个形状）*/
struct buf {
    data: mut slice<i32>
    len: i64
}

fn append(b: mut ref buf, v: i32) {
    b.data[b.len] = v          // 写进调用者的容器
    b.len = b.len + 1
}

/* 带分配的出参：新东西进"容器所在的那只 arena" ✓ */
struct boxes {
    store: mut slice<i32>
    n: i64
}

fn makeAndStore(b: mut ref boxes) {
    var p: mut ref i32 = new i32        // 分配
    *p = 99
    b.store[b.n] = *p                   // 存进调用者的容器（出参）
    b.n = b.n + 1
}

fn main() {
    var storage: mut slice<i32> = new i32[8]
    var b: buf = { data: storage, len: 0 }
    append(ref b, 7)
    append(ref b, 8)
    println("buffer = ", storage, " len = ", b.len)

    var s2: mut slice<i32> = new i32[4]
    var bx: boxes = { store: s2, n: 0 }
    makeAndStore(ref bx)
    makeAndStore(ref bx)
    println("store = ", s2, " n = ", bx.n)

    listDemo()
}

/* ---- A3 第三半之后：**链表出参**也能写了 ✓ ----
 * 靠两件事一起：① 调用点保证"实参活得 ≥ 家 arena"（规则 ④）
 *              ② 于是 callee 里"参数来的引用"可以存进那只家 arena（ARENA.md §7）✓ */
struct node {
    value: i64
    next: ?ref node
}
struct list {
    head: ?ref node
    count: i64
}

fn push(l: mut ref list, v: i64) {
    var cell: mut ref node = new node
    cell.value = v
    cell.next = l.head        // ← 以前这行报"借来的值不许存进活得更久的地方" ✗
    l.head = cell
    l.count = l.count + 1
}

fn sumNodes(head: ?ref node) -> i64 {
    var t: i64 = 0
    var c: ?ref node = head
    while c != null {
        t = t + c.value
        c = c.next
    }
    return t
}

fn listDemo() {
    var l: list
    push(ref l, 1)
    push(ref l, 2)
    push(ref l, 3)
    println("linked = ", l.count, " 求和 = ", sumNodes(l.head))
}
