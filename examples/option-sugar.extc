/* `?T` —— `option<T>` 的语法糖（定案 ㊻）
 *
 *   `?i64`  ≡ `option<i64>`      `?ref node` 是**另一回事**（可空引用，见 nullable-ref.extc）
 *
 * 两个写法都认：类型位置的 `?T`，和**类型已知时**的裸构造器
 * （`none` / `some(x)` / `success(x)` / `failure(e)`）——
 * 返回位置、带标注的 `var`、赋值、实参位置都算"类型已知" ✓
 */

struct config {
    retries: ?i32
    limit: ?i32
}

/* 一半：偶数返回它的一半，奇数"没有" */
fn half(n: i64) -> ?i64 {
    if n % 2 != 0 { return none }
    return some(n / 2)          // 返回位置：类型从 `-> ?i64` 来 ✓
}

/* 两个里挑一个"有"的 */
fn pick(a: ?i64, b: ?i64) -> ?i64 {
    if a.has { return a }
    return b
}

fn main() {
    /* 带标注的 var：裸构造器也认 ✓ */
    var r: ?i64 = some(21)
    println("r = ", r.valueOr(-1))

    /* 实参位置：类型从参数来 ✓ */
    println("pick = ", pick(none, some(9)).valueOr(-1))
    println("pick = ", pick(some(4), none).valueOr(-1))

    println("half(10) = ", half(10).valueOr(-1))
    println("half(7)  = ", half(7).valueOr(-1))

    /* 结构体字段是 `?i32` ⇒ 零值是"没有"（option 本身有零值）✓ */
    var c: config
    println("默认 = ", c.retries.has, " / ", c.limit.has)
    c.retries = some(3)          // 赋值位置：类型从目标来 ✓
    if c.retries.has { println("retries = ", c.retries.value) }

    /* 显式写全类型也永远可以（不靠上下文猜）✓ */
    var full: ?i64 = option<i64>::some(5)
    println("full = ", full.valueOr(-1))
}
