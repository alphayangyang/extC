// expect: indexOf(30) = 2 显式下标 = 4 换过之后 = 50 10
/* ⭐ PLAN #47：**泛型自由函数**（`fn f<T>(…)`）—— 库的根 ✓
 *
 * 为什么库立刻需要它：`sort` / `map` / `max` / `indexOf` 这类函数**没法挂在 struct 上** ✗
 *
 * v1 支持三种写法：
 *   ① 从实参**推导**类型：`indexOf(nums[..], 30)` ✓
 *   ② **显式**实参：`indexOf<i32>(…)`（`T` 只出现在返回类型时必须这么写 ✓）
 *   ③ `T` 上的 `==` / `!=`：**推迟到实例化**再查"这个 T 有没有 `fn ==`" ✓
 *
 * ⚠️ v1 不支持：泛型体里再调用泛型函数（调用点只解析一次 ⇒ 那个 `T` 还不具体 ✗）
 *    —— 报错会说清原因，修法与 #44（摘要按实例算）同族 ✓
 */
fn indexOf<T>(a: slice<T>, x: T) -> i64 {
    var i: i64 = 0
    while i < a.len {
        if a[i] == x { return i }
        i = i + 1
    }
    return 0 - 1
}

fn swapAt<T>(a: mut slice<T>, i: i64, j: i64) {
    let t: T = a[i]
    a[i] = a[j]
    a[j] = t
}

/* ⚠️ `T` 上的 `<` **还不支持** —— 它要"给 T 一个比较协议"（函数值/协议，6a 那一步）✗
 * 现在只能对**具体类型**写：`fn maxI32(a: i32, b: i32) -> i32` ✓
 * （`==` / `!=` 已经可以了 —— 它走"推迟到实例化"那条路 ✓）*/

fn main() -> i32 {
    var nums: [5]i32 = [10, 20, 30, 40, 50]
    /* ⚠️ examples 的 `// expect:` 规矩是"**一整行**必须出现在输出里" ⇒ 这里打成一行 ✓ */
    var k: i64 = indexOf(nums[..], 30)
    var j: i64 = indexOf<i32>(nums[..], 50)
    swapAt(nums[..], 0, 4)
    println("indexOf(30) = ", k, " 显式下标 = ", j, " 换过之后 = ", nums[0], " ", nums[4])
    return 0
}
