// 下标边界的**正向**判据（PLAN #4 的另一半）：能证明**合法**的不许误报。
//
// `tests/errors/literal_index_oob.extc` 钉住"越界必须编译期报错"；
// 这一份钉住反面 —— 三角形三条边都验过才算修好：
//   ① 字面量越界        ⇒ 编译错误
//   ② 字面量**合法边界** ⇒ 必须放行（`0` 和 `n-1`，最容易写成 `<= n` 而误伤）
//   ③ 运行时下标        ⇒ 不报编译错，留给运行时 trap
fn main() -> i32 {
    var b: [4]i32 = [10, 20, 30, 40]

    println(b[0])          // 下界 ✓
    println(b[3])          // 上界 n-1 ✓

    var i: i32 = 2
    println(b[i])          // 运行时下标 ⇒ 证明不了，放行 ✓

    var m: [2][3]i32 = [[1, 2, 3], [4, 5, 6]]
    println(m[1][2])       // 多维：每一维各自的长度都要用对 ✓
    println(m[0][0])

    let s = "hello"
    println(s[1])          // 字符串字面量是 slice，不受这条影响 ✓
    return 0
}
// expect: 10
// expect: 40
// expect: 30
// expect: 6
// expect: 1
// expect: 101
