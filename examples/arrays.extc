// 固定数组：长度是类型的一部分（`[3]i32` 和 `[4]i32` 是两个类型）
//
// 数组 = 「装着一个裸数组的结构体」—— 这就是值语义的来源：
// C 的数组不能赋值、不能返回，套上 struct 就都能了（`std::array` 同理）。

struct board {
    cell: [15][15]i32
    moves: i32
}

fn main() -> i32 {
    var b: board                    // 零初始化：整个棋盘清零

    b.cell[7][7] = 1                // 索引（带边界检查，越界 trap 并报位置）
    println(b.cell[7][7])           // 1
    println(b.moves)                // 0

    // 嵌套字面量：类型从声明来
    let dirs: [4][2]i32 = [[1, 0], [0, 1], [1, 1], [1, -1]]
    println(dirs[2][0], ",", dirs[2][1])   // 1,1
    println(dirs)                          // [1, 0] [0, 1] [1, 1] [1, -1]

    // 末尾 `...` = 剩下的按零值补
    let part: [5]i32 = [1, 2, ...]
    println(part)                          // [1, 2, 0, 0, 0]

    // 数组是值：可赋值、可整体比较（`==` 由编译器派生，元素必须能比）
    var a: [3]i32 = [1, 2, 3]
    var c: [3]i32 = [1, 2, 3]
    println(a == c)                        // true
    c = [1, 2, 4]
    println(a == c)                        // false
    a = c                                  // 整体赋值 = 拷贝
    println(a == c)                        // true

    // 数组的索引也带检查
    var i: i32 = 100
    println(dirs[0][0])
    return 0
}
