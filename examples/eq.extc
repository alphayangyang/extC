// `==` 是显式定义的：在 struct 里写 `fn ==(...)`（不需要 trait）

struct point {
    x: i32
    y: i32

    fn ==(self: ref point, other: point) -> bool {
        return self.x == other.x && self.y == other.y
    }
}

struct tag {
    id: i32          // 故意不定义 ==
}

// 泛型里也能用 ==：推迟到实例化再检查
struct wrapper<T> {
    value: T

    fn same(self: ref wrapper<T>, other: wrapper<T>) -> bool {
        return self.value == other.value      // T 是类型参数 → 推迟
    }
}

fn main() -> i32 {
    let a: point = { x: 1, y: 2 }
    let b: point = { x: 1, y: 2 }
    let c: point = { x: 9, y: 9 }

    println(a == b)      // true
    println(a == c)      // false
    println(a != c)      // true

    var wa: wrapper<i32> = { value: 7 }        // i32 是内建 → 天生能比
    var wb: wrapper<i32> = { value: 7 }
    println(wa.same(wb))                       // true

    var pa: wrapper<point> = { value: a }      // point 有 eq → 也能比
    var pb: wrapper<point> = { value: b }
    println(pa.same(pb))                       // true

    // ⭐ 数组的 `==`：数组类型用户写不出来 ⇒ 编译器派生 ✓
    // 元素是内建就直接比；元素是 struct 就调它的 `fn ==`
    //（第④步之后一律走通用 `extc_eq(&a, &b, &arr_desc)` + 描述表 ✓）
    var ra: [3]i32 = [1, 2, 3]
    var rb: [3]i32 = [1, 2, 3]
    var rc: [3]i32 = [1, 2, 9]
    println(ra == rb)                          // true
    println(ra != rc)                          // true

    var ap: [2]point = [a, c]
    var bp: [2]point = [b, c]
    println(ap == bp)                          // true（元素走 point 的 fn ==）

    // 嵌套数组也递归 ✓
    let m1: [2][2]i32 = [[1, 2], [3, 4]]
    let m2: [2][2]i32 = [[1, 2], [3, 4]]
    println(m1 == m2)                          // true
    return 0
}
