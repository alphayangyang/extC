// 全局变量 / 常量（顶层 `let` / `var`）
//
// **全局 = 深度 0** —— 它活得比谁都长。这条不是新规则，而是
// 「引用不能活得比被指对象长」的直接推论：`0 ≥ 1` 为假 ⇒ 局部的东西存不进全局。
//
// 定长的全局**不需要 arena**：它就是 C 的静态对象（C 自动清零，跟定案 8 一致）。

let BOARD_SIZE: i64 = 15 * 15        // 常量（常量表达式，C 会折叠）
let VERSION = "extC 0.1"             // 字符串常量 = 指向静态数据的只读视图
let NEG: i32 = -1

var gomokuGames: i64                 // 零初始化：C 的静态存储期自动清零
var lastWinner: i32 = -1

type color = | empty | black | white

let DEFAULT_COLOR: color = color.empty   // 枚举常量也行

// **结构体字面量，只要每个字段都是常量，也算常量**（PLAN #65 修好之后 ✓）
// 它不需要"在函数里算"：C 里就是静态初始化 `static pt ORIGIN = { .x = 0, .y = 0 };`
// 这一条正是「库里怎么给用户一个现成的流对象」的门槛（`let cout: out = out { fd: 1 }`）✓
struct pt { x: i64  y: i64 }
let ORIGIN: pt = pt { x: 0, y: 0 }
let SCALED: pt = pt { x: 15 * 15, y: -1 }       // 字段可以是**常量表达式**（字面量的算术）✓
let HALF: pt = pt { x: 7 }                       // 省略的字段 = 零值 ✓
// ⚠️ 边界：字段**不能是别的全局**（`pt { x: BOARD_SIZE }` 编不过 ✗）——
// 那不是 extC 小气：C 里 `const int A` **不是**常量表达式，静态初始化式不许引用它
// ⇒ 要支持就得先有常量折叠（引用处把值内联进来），而"没有常量折叠器"是明说的设计 ✓
struct seg { a: pt  b: pt }
let UNIT: seg = seg { a: pt { x: 0, y: 0 }, b: pt { x: 1, y: 1 } }   // 嵌套字面量 ✓
struct cfg { name: slice<u8>  n: i64 }
let CFG: cfg = cfg { name: "extc", n: 3 }        // 字符串常量当 slice 字段 ✓

fn recordWin(winner: color) {
    gomokuGames = gomokuGames + 1
    if winner == color.black {
        lastWinner = 1
    }
}

fn main() -> i32 {
    println("棋盘格数 = ", BOARD_SIZE)        // 225
    println("版本     = ", VERSION)           // extC 0.1
    println("负数常量 = ", NEG)               // -1

    println("一开始   = ", gomokuGames, " 局，赢家 ", lastWinner)   // 0 局，赢家 -1
    recordWin(color.black)
    recordWin(color.white)
    println("两局之后 = ", gomokuGames, " 局，赢家 ", lastWinner)   // 2 局，赢家 -1
    println("默认颜色 = ", DEFAULT_COLOR)     // empty
    println("原点     = ", ORIGIN.x, ",", ORIGIN.y)     // 0,0
    println("缩放后   = ", SCALED.x, ",", SCALED.y)     // 225,-1
    println("省略字段 = ", HALF.x, ",", HALF.y)         // 7,0
    println("嵌套     = ", UNIT.b.x, ",", UNIT.b.y)     // 1,1
    println("字符串字段 = ", CFG.name, " n=", CFG.n)    // extc n=3

    // 下面这些**编不过**：
    //   BOARD_SIZE = 1          // ✗ let 的全局不能写
    //   let A = 1 + work()      // ✗ 全局初始化式必须是常量（还没有常量求值器）
    //   var s: slice<i32>       // ✗ 含引用的全局不能零初始化（没有东西可借）
    //   let P: pt = mkPt()      // ✗ 调用不是常量 —— 见 tests/errors/global_not_const.extc
    return 0
}
