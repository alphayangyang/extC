// `option<T>` / `result<T, E>` —— 把「可能没有」「可能失败」写进**类型**
//
// 以前只能靠魔法数字：
//     fn find(...) -> i32        // 返回 -1 表示「没找到」
// -1 分不清「没找到」和「下标恰好是 -1」，而且**从签名上完全看不出来**。
// 现在这两种情况都是类型的一部分，调用点必须处理（P′：不能证明的，语法上看得见）。
//
// ⭐ 第三刀（2026-09-20）：这两个类型现在是**普通泛型枚举**（`stdlib/prelude.extc`）：
//     type option<T>    = | none | some(T)
//     type result<T, E> = | failure(E) | success(T)
// 零值分别是 `none` / `failure`（tag 0）—— 跟以前一致，但**没有隐藏字段**了。

type gameError = | outOfRange | occupied

struct board {
    cell: [15][15]i32
}

// 「可能没有」：越界就没有值
fn at(b: ref board, x: i32, y: i32) -> option<i32> {
    if x < 0 || x >= 15 || y < 0 || y >= 15 {
        return none
    }
    return some(b.cell[y][x])
}

// 「可能失败」：失败了还要说清**为什么**（枚举，不是字符串）
fn place(b: mut ref board, x: i32, y: i32, p: i32) -> result<unit, gameError> {
    if x < 0 || x >= 15 || y < 0 || y >= 15 {
        return failure(gameError.outOfRange)
    }
    if b.cell[y][x] != 0 {
        return failure(gameError.occupied)
    }
    b.cell[y][x] = p
    return success(unit {})
}

// 在一行里找第一个空位 —— 「找不到」是正常结果，不是错误
fn firstEmpty(row: slice<i32>) -> option<i64> {
    var i: i64 = 0
    while i < row.len {
        if row[i] == 0 {
            return some(i)
        }
        i = i + 1
    }
    return none
}

fn describe(e: gameError) -> slice<u8> {
    if e == gameError.outOfRange {
        return "出界了"
    }
    return "那格已经有子了"
}

// `?` —— 失败就顺着往上抛，不用一层层写 `if 失败 { return ... }`。
//
// 四个合法位置（都是**整个语句**能重写的地方，因为要展开成语句）：
//     place(b, x, y, p)?        一步必须成功，否则整串失败
//     let v = e?                取出载荷
//     v = e?                    同上，赋给已有的地方
//     return e?                 把载荷装回外层类型
//
// 载荷类型可以不同（里层 unit、外层也是 unit；换成 i64 → point 也行），
// 但**错误类型必须一样** —— `?` 是原样转发，不做转换。
fn placeLine(b: mut ref board, y: i32, from: i32, to: i32, p: i32) -> result<unit, gameError> {
    var x: i32 = from
    while x <= to {
        place(b, x, y, p)?        // 中间撞车 ⇒ 整行失败（失败之前的已经落下）
        x = x + 1
    }
    return success(unit {})
}

fn main() -> i32 {
    var b: board

    // ① result：`match` 一次就把「成没成 + 值/为什么」都读出来（穷尽检查 ✓）
    match place(ref b, 7, 7, 1) {
        success(u) => { println("落子成功？   true") }
        failure(e) => { println("落子成功？   false —— ", describe(e)) }
    }

    match place(ref b, 7, 7, 2) {
        success(u) => { println("重复落子？   true") }
        failure(e) => { println("重复落子？   false —— ", describe(e)) }   // 那格已经有子了
    }

    match place(ref b, 99, 0, 1) {
        success(u) => { println("出界？       true") }
        failure(e) => { println("出界？       false —— ", describe(e)) }   // 出界了
    }

    // ② option：有值 / 没值
    match at(ref b, 7, 7) {
        some(v) => { println("(7,7) 有值？ true，里面是 ", v) }
        none    => { println("(7,7) 有值？ false") }
    }

    match at(ref b, 99, 0) {
        some(v) => { println("(99,0) 有值？true，里面是 ", v) }
        none    => { println("(99,0) 有值？false") }
    }

    // ③ 「找不到」是正常结果 —— 第 3 行全满 ⇒ 没有空位
    var full: [3]i32 = [1, 2, 1]
    match firstEmpty(full[..]) {
        some(i) => { println("满行里找空位：", i) }
        none    => { println("满行里找空位：没有") }
    }

    // ④ result<unit, E>：成功了也没什么值给你 —— 用 unit 而不是开 void 的特例
    let u = result<unit, gameError>::success(unit {})
    match u {
        success(x) => { println("unit 也成功？ true") }
        failure(e) => { println("unit 也成功？ false") }
    }

    // ⑤ `?`：一整行落子，任何一步失败就整行失败
    var b2: board
    match placeLine(ref b2, 5, 2, 6, 2) {
        success(u) => { println("一整行白子？ true") }
        failure(e) => { println("一整行白子？ false") }
    }
    println("落了几格？   ", b2.cell[5][2], b2.cell[5][6])   // 22

    match placeLine(ref b2, 5, 0, 3, 1) {        // 0、1 落得下，到 2 撞车 ⇒ 中途失败
        success(u) => { println("撞车那一行？ true") }
        failure(e) => { println("撞车那一行？ false —— ", describe(e)) }   // 那格已经有子了
    }
    println("失败前落的   ", b2.cell[5][0], b2.cell[5][1])   // 11 —— 失败**之前**的保留
    println("失败处没动   ", b2.cell[5][2])                  // 2 —— 失败之后一步都没走

    return 0
}
