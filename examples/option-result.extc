// T5a：`option<T>` / `result<T, E>` —— 把「可能没有」「可能失败」写进**类型**
//
// 以前只能靠魔法数字：
//     fn find(...) -> i32        // 返回 -1 表示「没找到」
// -1 分不清「没找到」和「下标恰好是 -1」，而且**从签名上完全看不出来**。
// 现在这两种情况都是类型的一部分，调用点必须处理（P′：不能证明的，语法上看得见）。

type gameError = | outOfRange | occupied

struct board {
    cell: [15][15]i32
}

// 「可能没有」：越界就没有值
fn at(b: ref board, x: i32, y: i32) -> option<i32> {
    if x < 0 || x >= 15 || y < 0 || y >= 15 {
        return option<i32>::none()
    }
    return option<i32>::some(b.cell[y][x])
}

// 「可能失败」：失败了还要说清**为什么**（枚举，不是字符串）
fn place(b: mut ref board, x: i32, y: i32, p: i32) -> result<unit, gameError> {
    if x < 0 || x >= 15 || y < 0 || y >= 15 {
        return result<unit, gameError>::failure(gameError.outOfRange)
    }
    if b.cell[y][x] != 0 {
        return result<unit, gameError>::failure(gameError.occupied)
    }
    b.cell[y][x] = p
    return result<unit, gameError>::success(unit {})
}

// 在一行里找第一个空位 —— 「找不到」是正常结果，不是错误
fn firstEmpty(row: slice<i32>) -> option<i64> {
    var i: i64 = 0
    while i < row.len {
        if row[i] == 0 {
            return option<i64>::some(i)
        }
        i = i + 1
    }
    return option<i64>::none()
}

fn describe(e: gameError) -> slice<u8> {
    if e == gameError.outOfRange {
        return "出界了"
    }
    return "那格已经有子了"
}

// `?` —— 失败就顺着往上抛，不用一层层写 `if 失败 { return ... }`。
//
// 四个合法位置（都是**整个语句**能重写的地方，因为要展开成语句）：
//     place(b, x, y, p)?        一步必须成功，否则整串失败
//     let v = e?                取出载荷
//     v = e?                    同上，赋给已有的地方
//     return e?                 把载荷装回外层类型
//
// 载荷类型可以不同（里层 unit、外层也是 unit；换成 i64 → point 也行），
// 但**错误类型必须一样** —— `?` 是原样转发，不做转换。
fn placeLine(b: mut ref board, y: i32, from: i32, to: i32, p: i32) -> result<unit, gameError> {
    var x: i32 = from
    while x <= to {
        place(b, x, y, p)?        // 中间撞车 ⇒ 整行失败（失败之前的已经落下）
        x = x + 1
    }
    return result<unit, gameError>::success(unit {})
}

fn main() -> i32 {
    var b: board

    // ① result：成功 / 两种失败，各自能读出来
    let r1 = place(ref b, 7, 7, 1)
    println("落子成功？  ", r1.ok)                 // true

    let r2 = place(ref b, 7, 7, 2)
    println("重复落子？  ", r2.ok)                 // false
    println("为什么？    ", describe(r2.err))      // 那格已经有子了

    let r3 = place(ref b, 99, 0, 1)
    println("出界？      ", r3.ok)                 // false
    println("为什么？    ", describe(r3.err))      // 出界了

    // ② option：有值 / 没值
    let c = at(ref b, 7, 7)
    println("(7,7) 有值？ ", c.has)                // true
    println("里面是      ", c.value)               // 1

    let oob = at(ref b, 99, 0)
    println("(99,0) 有值？", oob.has)              // false
    println("兜底值      ", oob.valueOr(-1))       // -1

    // ③ 「找不到」是正常结果 —— 第 3 行全满，第 4 行第一个空位是 0
    var full: [3]i32 = [1, 2, 1]
    println("满行里找空位", firstEmpty(full[..]).has)        // false
    println("用兜底值    ", firstEmpty(full[..]).valueOr(-1)) // -1

    // ④ result<unit, E>：成功了也没什么值给你 —— 用 unit 而不是开 void 的特例
    let u = result<unit, gameError>::success(unit {})
    println("unit 也 ok？ ", u.ok)                 // true

    // ⑤ `?`：一整行落子，任何一步失败就整行失败
    var b2: board
    let line = placeLine(ref b2, 5, 2, 6, 2)
    println("一整行白子？", line.ok)               // true
    println("落了几格？  ", b2.cell[5][2], b2.cell[5][6])   // 22

    let again = placeLine(ref b2, 5, 0, 3, 1)      // 0、1 落得下，到 2 撞车 ⇒ 中途失败
    println("撞车那一行？", again.ok)              // false
    println("为什么？    ", describe(again.err))   // 那格已经有子了
    println("失败前落的  ", b2.cell[5][0], b2.cell[5][1])   // 11 —— 失败**之前**的保留
    println("失败处没动  ", b2.cell[5][2])         // 2 —— 失败之后一步都没走

    return 0
}
