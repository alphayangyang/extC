// **嵌套视图**：`mut slice<mut slice<T>>` —— 二维的东西（棋盘、矩阵、AST 的子节点表）
//
// 2026-09-18 修好的一处：以前**只读降级只剥一层**，
//     slice<mut slice<i32>>  传到  slice<slice<i32>> 参数     ✗ 报错
// 而 `mut` 是**权限不是布局** —— C 里两种写法是**同一个结构体**（`slice_slice_i32`），
// 所以「去掉 mut」永远是安全的（任何一层都可以去，反方向永远不行）✓
//
// 规矩一句话：**只许去掉 `mut`，不许加。**
// 嵌套可写视图：`mut slice<mut slice<i32>>` —— 两级都写得进去吗？
fn fillAll(g: mut slice<mut slice<i32>>, v: i32) {
    var i: i64 = 0
    while i < g.len {
        var j: i64 = 0
        while j < g[i].len {
            g[i][j] = v          // 两级写穿
            j = j + 1
        }
        i = i + 1
    }
}

fn total(g: slice<slice<i32>>) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < g.len {
        var j: i64 = 0
        while j < g[i].len { s = s + g[i][j]  j = j + 1 }
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    var a: [2][3]i32 = [[1, 2, 3], [4, 5, 6]]
    var rows: [2]mut slice<i32> = [a[0][..], a[1][..]]

    println("先看看   ", rows[0], " ", rows[1])
    fillAll(rows[..], 9)
    println("填 9 之后 ", rows[0], " ", rows[1])
    println("原数组   ", a[0], " ", a[1])      // 真的写进去了吗
    println("求和     ", total(rows[..]))
    return 0
}
