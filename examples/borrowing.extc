// 借用规则的两条：**调用结果跟着实参走** + **借来的东西不能存进长寿的地方**
//
// 这两条一起管住「参数把寿命洗白了」那个洞：
//     fn identity(r: ref i32) -> ref i32 { return r }   // 转发本身合法 ✓
//     fn bad() -> ref i32 { var x: i32 = 5  return identity(ref x) }
//     // ✗ identity 的结果可能指着 x ⇒ 跟着实参算 ⇒ 深度 1 ⇒ 返回要求 0 ⇒ 报错 ✓
//
// 判据只有一句：**被调函数能返回的引用只有两种来源** ——
// 全局/静态（深度 0），或者**实参**（深度 ≤ max(实参)）。它返回不了自己的局部 ✓

fn pickFirst(a: ref i32, b: ref i32) -> ref i32 {
    return a                        // 返回「第一个参数」（也可以按情况返回 b）
}

struct holder {
    inner: mut ref i32
    tag: i32
}

fn bind(h: mut ref holder, target: mut ref i32) {
    h.inner = target                // 换指向：把「借来的」存进**本帧**的 h ✓ 合法
}

fn main() -> i32 {
    var outer: i32 = 100
    var other: i32 = 200

    // ✓ 存进本帧的局部：实参深度 ≤ 本帧 ⇒ 合法
    let r = pickFirst(ref outer, ref other)
    println("挑出来的值 = ", r)          // 100

    // ✓ 视图整体赋值（换绑）是合法的 —— 它只动那两个词，不写别人的内存
    var a: [4]i32 = [1, 2, 3, 4]
    var s: slice<i32> = a[..]
    s = a[1..3]                          // 换个视图 ✓
    println("换个视图之后 = ", s)         // [2, 3]

    // ✓ 全局是静态的，谁都存得下它（跟「借来的」不同）
    println("全局常量 = ", BOARD)

    // 下面这些**编不过**（见 tests/errors/escape_*.extc）：
    //   fn bad() -> ref i32 { var x: i32 = 5  return pickFirst(ref x, ref x) }
    //   // ✗ 返回值的深度 = 1 > 0
    //   fn stash(s: slice<u8>) { G = s }
    //   // ✗ cannot store a borrowed value into something that outlives this call
    return 0
}

let BOARD: i64 = 225
