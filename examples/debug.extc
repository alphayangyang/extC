// 自动调试打印：编译器为每个类型生成一份**描述表**（`<Type>_desc`，
// 字段偏移由 offsetof 填），`println` 交给全程序**一份**通用打印器
// `extc_print(&x, &x_desc)` 递归打印 ⇒ 不是"每类型一份代码" ✓

type color = | red | green | blue

struct point {
    x: i32
    y: i32
}

struct player {
    name: slice<u8>       // 字符串字面量的类型就是它（T4c）
    score: i64
    alive: bool
    pos: point            // 嵌套 struct 会递归打印
    color: color          // 枚举打印名字
}

fn main() -> i32 {
    var p: point = { x: 3, y: 4 }
    println(p)                       // point { x: 3, y: 4 }

    var pl: player = {
        name: "naixi",               // 字面量就是 slice<u8>，打印时按文本
        score: 100,
        alive: true,
        pos: p,
        color: color.green,
    }
    println(pl)

    // ⚠️ 含 ref 的字段必须显式给（ref 没有零值）—— name 就是这种
    var blank: player = {
        name: "",                    // 空串是合法的：指向一个长度 0 的字节视图
        score: 0,
        alive: false,
        pos: { x: 0, y: 0 },
        color: color.red,
    }
    println(blank)
    return 0
}
