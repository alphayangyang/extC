/* ④ impl：给类型体之外挂方法，给运算符写重载，给内建标量加能力 */
use std::io

struct vec { x: i64  y: i64 }

impl vec {
    fn +(self: ref vec, o: vec) -> vec { return vec { x: self.x + o.x, y: self.y + o.y } }
    fn norm2(self: ref vec) -> i64 { return self.x * self.x + self.y * self.y }
}

impl i64 {
    fn doubled(self: ref i64) -> i64 { return *self * i64(2) }
}

fn main() -> i32 {
    let a = vec { x: i64(1), y: i64(2) }
    let b = vec { x: i64(10), y: i64(20) }
    let c = a + b                       /* 运算符就是方法，按右操作数类型匹配 */
    io::cout << "c=(" << c.x << "," << c.y << ") norm2=" << c.norm2() << "\n"
    io::cout << "i64::doubled=" << i64(21).doubled() << "\n"
    return 0
}
