// expect: 第 0 行第 0 个 = 7
/* **动态二维表**（定案 67，2026-09-22 修）

 * `vector<vector<i32>>` 以前**写不出来** ✗ —— 因为"借来的值不可外存"那条规则
 * 在**被调者**里一律拒（被调者一次编译，不知道调用者传来的是长寿还是短命 ✗）

 * 现在：被调者只**发布**约束（"我要求：你给我的那份数据活得 ≥ 你给我的容器"），
 * **调用点**拿具体深度求解 ✓ ⇒ 这个形状自然能写了 ✓
 *
 * 读法要沿视图走：`adj.view()[i]` 借出内层容器、再 `.view()[j]` 借出元素 ——
 * 直接 `adj.get(i)` 会要求把 `vector` 按值拷出来，而它是 `@noCopy` ✓
 *
 * ⚠️ 与它成对的反例：`tests/errors/stash_view_from_deeper.extc`（把更深块里的视图
 *    塞进外层容器 ⇒ **仍然被挡** ✓ —— 那条是真悬垂）
 */
use std::data::vector
fn main() {
    var adj: vector<vector<i32>> = vector<vector<i32>>::withCap(2)
    var row: vector<i32> = vector<i32>::withCap(2)
    row.push(7)
    adj.push(row)
    println("第 0 行第 0 个 = ", adj.view()[0].view()[0])
}
