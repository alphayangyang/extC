// 窄整数（i8/i16/u8/u16）的算术按**声明宽度**回绕（审计 P0-18）。
//
// 回归前：检查器把 `a + a`（`a: i8`）的类型定为 `i8`，而生成的 C 在 `int` 宽度上算且不回截 ⇒
// 值 200、存进 `i8` 是 -56、`a + a == x` 为 **false**（类型系统与实际值互相矛盾）。
// 现在发射时按表达式自身类型回截（`((int8_t)((a + a)))`）——与 32/64 位由 `-fwrapv`
// 得到的"回绕"同一条规则，转换本身在 C 里是零成本的。
// expect: add=-56 u8=44 i16=-5536 neg=-128 shl=32768 div=-128
use std::io

fn main() -> i32 {
    var a: i8 = i8(100) + i8(100)                 /* 200 回绕成 -56 */
    var b: u8 = u8(200) + u8(100)                 /* 300 回绕成 44 */
    var c: i16 = i16(30000) + i16(30000)          /* 60000 回绕成 -5536 */
    var d: i8 = i8(-128)
    var e: i8 = -d                                /* 128 回绕成 -128 */
    var f: u16 = u16(1) << u16(15)                /* 32768：u16 装得下 */
    var g: i8 = i8(-128) / i8(-1)                 /* 128 回绕成 -128 */
    io::cout << "add=" << i64(a) << " u8=" << i64(b) << " i16=" << i64(c) << " neg=" << i64(e) << " shl=" << i64(f) << " div=" << i64(g) << "\n"
    return 0
}
