// **`let` 是命名，不是存储。**
//
// 所以同一层里可以再 `let` 一次同名 —— 第二个 `let` 只是**重新给这个名字一个含义**，
// 不是写进原来那个地方。老的那个绑定连同它的存储一起留在原地，谁指着它谁还指着它。
//
// 生成的 C 里第二个以后的名字改叫 `a__2`（C 不允许同一个块里重名），
// 但 **extC 源码里的名字一个字都不改** —— 改名是编译器内部的事。
//
// 反过来：**`var` 声明的是存储**，同一层两个 `var` 同名几乎肯定是想写 `a = ...`，
// 所以那是编译错误（见 tests/errors/redeclare_var.extc）。

fn main() -> i32 {
    // ① 反复 `let`：每一步都是新的名字
    let a: i32 = 1
    let a: i32 = a + 1          // 右边的 `a` 是上一个
    let a: i32 = a * 10
    println("a = ", a)          // 20

    // ② 遮蔽之后引用**仍然指着老的那个** —— 这是「命名不是存储」最硬的证据
    var x: i32 = 7
    var r = ref x
    let x: i32 = 99             // 新名字，新存储
    println("新 x = ", x)        // 99
    println("老 x（透过 r）= ", r) // 7
    r = 100                     // 写穿到老的那个
    println("写穿之后 = ", r)     // 100
    println("新 x 没被动 = ", x)  // 99

    // ③ 遮蔽可以**换类型** —— 赋值做不到这件事，正好说明它是新绑定
    let v: i32 = 1
    let v: slice<u8> = "现在是一段字节了"
    println("v = ", v)

    // ④ 遮蔽参数（参数和函数体同一层）
    println("addOne(5) = ", addOne(5))       // 6

    // ⑤ 名字撞上 **C 的关键字**也没关系：
    //    extC 里 `double` 不是关键字（浮点叫 f64），所以这只是个普通名字。
    //    生成的 C 里它改叫 `double__c`，照样能编过、能调用。
    let double: i32 = 7
    println("double = ", double)             // 7
    println("double(21) = ", double(21))     // 42（函数还是调得到的）
    return 0
}

fn addOne(n: i32) -> i32 {
    let n: i32 = n + 1          // 遮蔽参数：合法
    return n
}

fn double(n: i32) -> i32 { return n * 2 }
