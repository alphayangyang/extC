/* 逃逸提升（A3）—— **在函数里建好东西、交给调用者** ✓

 * 以前 `fn build() -> mut ref node { ... new node ... }` 是**编译错误**：
 * `new` 出来的东西活到当前块结束，返回它就是悬垂 ✗
 *
 * 现在：**函数体里有分配 + 返回类型含引用/视图** ⇒ 这个函数多收一只隐藏参数
 * `extc_arena *__extc_home`，里面的 `new` 分配到**调用者选的那只** arena ✓
 * 调用点自己选：
 *   · 调用者也有家 ⇒ 传它自己的家（祖先那只，最稳）
 *   · 调用者没有家（比如返回 `i32` 的函数）⇒ 传**当前块**那只（更紧 ✓）
 *
 * ⭐ 一个必须保住的性质：**返回 `i32` 的函数不要家** ⇒ 它循环里的 `new`/`alloc`
 *    仍然分配到块 arena ⇒ **循环不涨内存（A2 的保证）不丢** ✓
 *    （`main` 就是这种函数 —— 所以下面 ⑤ 那个循环是紧的 ✓）
 *
 * 生成的 C 长这样：
 *     node * build(int64_t n, extc_arena *__extc_home);
 *     ...
 *     node * list = build(4, __extc_home);      // main 的家 = 它自己函数体的 arena
 */

struct node {
    value: i64
    next: ?ref node
}

/* ⭐ `build` 里分配的东西**交给调用者**（A3 逃逸提升）*/
fn build(n: i64) -> mut ref node {
    var head: mut ref node = new node
    head.value = 0
    var cur: mut ref node = head
    var i: i64 = 1
    while i <= n {
        var cell: mut ref node = new node
        cell.value = i
        cur.next = cell
        cur = cell
        i = i + 1
    }
    return head
}

fn sumList(head: ?ref node) -> i64 {
    var t: i64 = 0
    var c: ?ref node = head
    while c != null {
        t = t + c.value
        c = c.next
    }
    return t
}

fn main() {
    var list: mut ref node = build(4)      // ← 以前这里编不过
    println("求和 = ", sumList(list))
    var list2: mut ref node = build(10)
    println("再来一条 = ", sumList(list2))
}
