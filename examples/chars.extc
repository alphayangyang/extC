// 字符字面量：`'a'` 就是一个 `u8` 类型的整数常量（手册的口径 —— 没有 `char`，类型名一律带位宽）。
// 转义：\n \t \r \0 \\ \' \" \a \b \f \v \xHH（一到两位十六进制）。
// 一个字面量**恰好一个字节**：多字节文本（UTF-8）请用字符串字面量。
//
// 顺带两个已知缺口（都由下面显式绕开）：`io::ostream` 的 `<<` 只有 i64 / f64 / bool /
// slice<u8>（所以打印小整数要写 `i64(...)`），`bool` 也不能转成整数（直接打就好）。
//
// expect: 反斜杠=92 十六进制=65
use std::io

fn isLower(c: u8) -> bool { return c >= 'a' && c <= 'z' }

fn main() -> i32 {
    io::cout << "A=" << i64('A') << " 换行=" << i64('\n') << " 引号=" << i64('\'') << "\n"
    io::cout << "反斜杠=" << i64('\\') << " 十六进制=" << i64('\x41') << "\n"
    io::cout << "小写=" << isLower('z') << " 列="

    /* 把列号变成字母再当**文本**打出去：'A' + 2 = 'C'。 */
    var col: [1]u8
    col[0] = u8('A' + i64(2))
    io::cout << col[..] << "\n"
    return 0
}
