/* `!` —— **我签字**（定案 1.3、㊻）

 * 编译器证不出来的事，用户可以签字负责 —— 签完这行**一行运行时检查都没有** ✓
 *
 * 三个用途：
 *   `opt!` / `r!`   ⇒ 直接给我载荷（编译期不判 tag）
 *   `p!`（`?ref T`）⇒ 我知道非空，给我 `ref T`（定案 ㊻ 留的逃生舱）
 *
 * ⚠️ 签字的定义就是"**错了算我的**"：真没有值/真是 null，行为是未定义的。
 *    跟"越界会 trap"是两回事 —— trap 是编译器**替**你查（有位置、有消息）；
 *    签字是你**替**编译器担保（零成本）。想要 trap 就自己写：
 *        match o { some(v) => { ... }  none => { panic(...) } }
 *
 * 什么时候该签：
 *   · 刚在 `if p != null` 里查过、但中间隔了一次函数调用（收窄不作数了）
 *   · 数据来源在别处已经保证过（比如解析器已经校验过）
 * 什么时候**不该**签：图省事。那就老老实实 `match` ✓
 */

struct node {
    value: i64
    next: ?ref node
}

fn find(head: ?ref node, want: i64) -> ?ref node {
    var cur: ?ref node = head
    while cur != null {
        if cur.value == want { return cur }
        cur = cur.next
    }
    return null
}

fn half(n: i64) -> ?i64 {
    if n % 2 != 0 { return none }
    return some(n / 2)
}

fn checked(n: i64) -> result<i64, i32> {
    if n < 0 { return failure(7) }      // 7 = "不能是负数"
    return success(n * 2)
}

struct box {
    head: ?ref node
    /* 这个指针是构造函数保证非空的，但类型上说不出来 ——
     * 于是每次都要 `self.head!`，而 `!` 是**零成本**的 ✓ */
}

fn main() {
    var a: node = { value: 1, next: null }
    var b: node = { value: 2, next: ref a }

    /* ① `p!`：我知道非空 —— C 里就是那个指针，一个字都不多生成 ✓
     * （`find(...)!.value` 是"成员选择导航"，直接读字段）*/
    println("找 2 = ", find(ref b, 2)!.value)

    /* ② `opt!`：直接取载荷 */
    println("half(10)! = ", half(10)!)

    /* ③ `r!`：同上（失败的时候就是你说错了）*/
    println("checked(3)! = ", checked(3)!)

    /* ④ 用在**任何位置**都行 —— 它是纯值运算，不需要"前缀"机制 ✓ */
    println("相加 = ", half(10)! + half(4)!, " 乘 = ", half(10)! * 3)

    /* ⑤ 跟收窄对比：`!` 是"我不查、我说了算"，收窄是"编译器替你查、也不生成代码"
     *    —— 两者都零成本，但**谁能证明**不一样 ✓ */
    var bx: box = { head: ref b }
    /* 收窄只认**绑定名**（`p.next` 这种路径不追）⇒ 先绑一个名字 */
    var h: ?ref node = bx.head
    if h != null {
        println("收窄过 = ", h.value)             // 编译器证明的 ✓
    }
    println("签字的   = ", bx.head!.value)        // 我担保的 ✓

    /* ⑥ 老老实实的写法永远都在（而且更值得推荐）*/
    match half(7) {
        some(v) => { println("half(7) = ", v) }
        none    => { println("half(7) = 没有") }
    }
}
