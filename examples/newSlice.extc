// ⭐ PLAN #9：**`new T[n] -> mut slice<T>`** —— 长度**运行时才知道**的 buffer。
//
// 以前只有 `alloc<T>(n)`，它返回 `mut ref T`（指向**一个** T）⇒ 不能索引、不能切片 ✗
// ⇒ "读未知大小的文件"、"`reader` 自动要 64KB"这类形状**根本写不出来** ✗
//
// ⭐ 清零是**分配器**的事，不是这个语法的事：`extc_arena_alloc` 每一次分配都 memset
//   ⇒ `new T[n]` / `new [N]T` / `alloc<T>(n)` **拿到的永远是零**，`SPEC.md` §0.6 那条承诺
//   「**过期读到的字节永远是初始化过的**」因此成立 ✓
//   （曾经另有一个原语 `allocSlice<T>(n)` 专门讲这件事 —— 它和 `new T[n]` 一模一样，
//     还多跑一遍 memset ⇒ 2026-09-24 **删掉**了，见定案 81 与 `docs/PLAN.md` §0.4 #9）
//
// 逃逸语义跟 `alloc` **完全一致**（都是"活到当前块结束"）：
//   返回它 / 循环里分配到循环外 ⇒ 都被挡（见 tests/arena-promoted/ 那两条）✓
fn fill(n: i64) -> i32 {
    var buf = new u8[n]                  // ← 长度来自参数（运行时才知道）
    var i: i64 = 0
    while i < n { buf[i] = u8(65 + i)  i = i + 1 }

    var total: i32 = 0
    i = 0
    while i < n { total = total + i32(buf[i])  i = i + 1 }
    return total
}

fn main() -> i32 {
    println("sum = ", fill(4))            // 65+66+67+68 = 266

    var s = new i32[4]
    s[0] = 7
    s[3] = 9
    println("s[0] = ", s[0], " s[3] = ", s[3], " len = ", s.len)

    let v = s[0..2]                       // 视图还能再切 ✓
    println("v.len = ", v.len, " v[0] = ", v[0])

    var z = new i32[3]                    // 没写过 ⇒ **应该全是 0**（清零的承诺）
    println("零值 = ", z[0], " ", z[1], " ", z[2])
    return 0
}
// expect: sum = 266
// expect: 零值 = 0   0   0
