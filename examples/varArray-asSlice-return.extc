// expect: 拿到的 = [7, 8]
/* 「把容器里那块存储**当视图借出去**（返回 `slice<T>`）」—— 安全形状 ✓
 * 扩容过的容器也能返回：因为扩容的存储跟着"逃逸需求"落在了调用者的家 arena 里 ✓ */
fn build() -> slice<i32> {
    var v: varArray<i32> = varArray<i32>::withCap(0)   // 会扩容 ✓
    v.push(7)
    v.push(8)
    return v.asSlice()
}

fn churn() {
    var k: i32 = 0
    while k < 8 {
        var w: varArray<i32> = varArray<i32>::withCap(500)
        w.push(k)
        k = k + 1
    }
}

fn main() {
    var s: slice<i32> = build()
    churn()
    println("拿到的 = ", s)
}
