/* `?ref T` —— **可空引用**（定案 ㊻）
 *
 * extC 里 `ref T` 永远非空（那正是它的意义），所以链表/树/图需要一个
 * "可能没有"的引用 —— 那就是 `?ref T`：
 *
 *   · 它的**零值就是 `null`** ⇒ `struct node { next: ?ref node }` 终于有零值了，
 *     于是 `var n: node` 合法、`[16]?ref node` 合法 ✓
 *   · 它**不能直接解**（`p.value` / `*p` 都是编译错误：P′，不能证明的语法上必须看得见）
 *   · 必须先证明非空 —— 唯一的证明方式是在 `if` / `while` 里跟 `null` 比过：
 *         `if p != null { p.value }`        then 分支里证明成立
 *         `if p == null { ... } else { p.value }`   else 分支里成立
 *         `if p == null { return }`（护栏） 后面都成立
 *         `while cur != null { cur.value }` 循环体里成立
 *         `p != null && p.value == 1`       `&&` 右边成立
 *   · 证明过之后**一行运行时检查都不生成** —— 编译期能证明的，运行时不留痕迹（P）✓
 *
 * 收窄只认**绑定名**（`p`），不认 `p.next` 这种路径：链上往下走就绑一个名字
 * （`var nxt: ?ref node = p.next`）—— 显式是对的，而且免得去想别名。
 */

struct node {
    value: i64
    next: ?ref node
}

/* 求和：`cur = cur.next` 会让下一次循环重新证明 ——
 * 跟 C 里 `while (p) { p = p->next; }` 的写法一模一样 ✓ */
fn sumFrom(p: ?ref node) -> i64 {
    var total: i64 = 0
    var cur: ?ref node = p
    while cur != null {
        total = total + cur.value
        cur = cur.next
    }
    return total
}

/* 护栏形态：条件成立就离开 ⇒ 走到后面 ⟺ p 非空 */
fn label(p: ?ref node) -> i64 {
    if p == null { return -1 }
    return p.value * 10
}

/* 递归 —— 空链是递归的**终点**，`null` 让这个终点写得出来 ✓ */
fn count(p: ?ref node) -> i64 {
    if p == null { return 0 }
    return 1 + count(p.next)
}

fn main() {
    var c: node = { value: 3, next: null }
    var b: node = { value: 2, next: ref c }
    var a: node = { value: 1, next: ref b }

    println("求和 = ", sumFrom(ref a))
    println("空链 = ", sumFrom(null))
    println("label = ", label(ref a), " / ", label(null))
    println("链长 = ", count(ref a))

    /* 注意：**跨函数**接线（在别人帧里挂一个新节点）现在还不合法 ——
     * 那需要先有 `new`（从 arena 里分配，寿命按作用域算）。见 PLAN.md §6。*/
    /* 数组里的可空引用：零值就是 null，不用初始化 ✓ */
    var table: [4]?ref node
    table[2] = ref c
    println("table[0] == null ? ", table[0] == null)
    /* 收窄只认绑定名 ⇒ 想解 `table[2]` 就先绑一个名字（一行，零开销 ✓）*/
    var three: ?ref node = table[2]
    if three != null { println(" table[2].value = ", three.value) }
}
