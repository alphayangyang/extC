// 带载荷枚举**能打印**（打变体名）✓；数组、结构体里也一样 ✓
type st = | empty | holding(i32)
struct box { s: st  n: i64 }
fn main() {
    var a: st = st.holding(3)
    var arr: [2]st = [st.empty, st.holding(9)]
    var b: box = { s: st.empty, n: 5 }
    println("枚举 = ", a)
    println("数组 = ", arr)
    println("结构体 = ", b)
    var o: ?i64 = some(42)
    println("option = ", o)
}
