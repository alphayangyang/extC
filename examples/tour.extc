// ============================================================================
// extC 一页游览 —— 这个语言现在的样子（每个小节都真能跑）
// ============================================================================

// ---- ① 枚举：无载荷（只是名字）和带载荷（名字 + 数据）---------------------
type color  = | red | green | blue
type shape  = | circle(f64) | rect(f64, f64) | dot

// `match` 穷尽检查：漏一个变体就**编不过**
fn chromaticity(c: color) -> f64 {
    match c {
        red   => { return 1.0 }
        green => { return 0.5 }
        blue  => { return 0.2 }
    }
}

// 带载荷的变体：**想拿载荷，必须先 match 它**
fn area(s: shape) -> f64 {
    match s {
        circle(r)  => { return 3.14159 * r * r }
        rect(w, h) => { return w * h }
        dot        => { return 0.0 }
    }
}

// ---- ② 结构体是值语义；数组定长且长度是类型的一部分 ----------------------
struct board {
    cell: [4][4]color
    moves: i64
}

fn put(b: mut ref board, x: i32, y: i32, c: color) {
    b.cell[y][x] = c
    b.moves = b.moves + 1
}

// ---- ③ 视图：只读 / 可写；嵌套视图；可写性**从来源继承** ----------------
fn sum(v: slice<i32>) -> i64 {                 // 只要读 → 谁来都行
    var s: i64 = 0
    var i: i64 = 0
    while i < v.len { s = s + v[i]  i = i + 1 }
    return s
}

fn fill(v: mut slice<i32>, x: i32) {           // 要写 → 签名上写清楚
    var i: i64 = 0
    while i < v.len { v[i] = x  i = i + 1 }
}

fn clearAll(g: mut slice<mut slice<i32>>) {    // 嵌套：两级都写得进去
    var i: i64 = 0
    while i < g.len {
        fill(g[i], 0)
        i = i + 1
    }
}

// ---- ④ 引用：**显式**解引用（`*p` 取值 / `*p = v` 写穿 / `p = q` 换指向）----
fn swap(a: mut ref i32, b: mut ref i32) {
    let t = *a         // 取值：必须写 `*`
    *a = *b            // 写穿：也必须写 `*`
    *b = t             // `a = b` 那种写法现在是**换指向**，不是交换 ✓
}

// ---- ⑤ 泛型：struct / 枚举都能带类型参数（单态化，没有间接调用）---------
type maybe<T> = | nothing | just(T)

struct pair<A, B> { first: A  second: B }

fn unwrapOr(m: maybe<i64>, fallback: i64) -> i64 {
    match m {
        nothing => { return fallback }
        just(v) => { return v }
    }
}

// ---- ⑥ result / option：失败和「没有」都是**类型**的一部分 ---------------
type gameError = | occupied | outOfRange

fn place(b: mut ref board, x: i32, y: i32, c: color) -> result<unit, gameError> {
    if x < 0 || x >= 4 || y < 0 || y >= 4 { return failure(gameError.outOfRange) }
    if b.cell[y][x] != color.red          { return failure(gameError.occupied) }
    put(b, x, y, c)
    return success(unit {})
}

fn find(v: slice<i32>, want: i32) -> option<i64> {
    var i: i64 = 0
    while i < v.len {
        if v[i] == want { return some(i) }
        i = i + 1
    }
    return none()
}

// ---- ⑦ `?`：失败就顺着往上抛（编译期展开成语句，没有栈展开）-------------
fn placeTwo(b: mut ref board) -> result<unit, gameError> {
    place(b, 0, 0, color.green)?      // 失败 ⇒ 整个函数失败
    place(b, 1, 1, color.blue)?
    return success(unit {})
}

// ---- ⑧ `let` 是**命名**，不是存储：同一层可以再 let 一次 -----------------
fn shadowDemo() -> i32 {
    let n: i32 = 1
    let n: i32 = n + 1        // 新名字，新值；上一个 n 还在（谁指着它谁还指着）
    let n: i32 = n * 10
    return n                  // 20
}

fn main() -> i32 {
    println("① 枚举+match   ", chromaticity(color.green), " 面积 ", area(shape.rect(3.0, 4.0)), " ", area(shape.circle(1.0)))

    var b: board
    put(ref b, 2, 2, color.blue)
    println("② 结构体/数组  ", b.cell[2][2], " 手数 ", b.moves)

    var a: [6]i32 = [1, 2, 3, 4, 5, 6]
    fill(a[1..4], 9)                       // 可写视图：真的改到 a
    println("③ 视图         ", a, " 求和 ", sum(a[..]))
    var rows: [2]mut slice<i32> = [a[0..3], a[3..6]]
    clearAll(rows[..])                     // 嵌套视图，两级写穿
    println("   嵌套视图     ", a)

    var x: i32 = 1
    var y: i32 = 2
    swap(ref x, ref y)
    println("④ 引用         ", x, " ", y)   // 2 1

    println("⑤ 泛型枚举     ", unwrapOr(maybe<i64>::just(42), -1), " ", unwrapOr(maybe<i64>::nothing, -1))
    let p: pair<i32, slice<u8>> = { first: 7, second: "hi" }
    println("   泛型 struct  ", p.first, " ", p.second)

    let r = place(ref b, 2, 2, color.red)
    println("⑥ result       ", r.ok, " 错误 ", r.err == gameError.occupied)
    println("   option       ", find(a[..], 0).valueOr(-1), " / 找 99 有没有 ", find(a[..], 99).has)
    println("⑦ `?`          ", placeTwo(ref b).ok, " 手数 ", b.moves)

    println("⑧ let 遮蔽     ", shadowDemo())
    return 0
}
