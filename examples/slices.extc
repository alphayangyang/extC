// 切片视图 `a[lo..hi]` —— T5a-3
//
// `slice<T>` 早就有了（它就是字符串的类型），这里补的是**从数组切出来**的语法。
// 视图 = 一个指针 + 一个长度，**不拷贝数据**（`slice<T>` 里的 `data` 就是 `ref T`，
// 而 `ref` 在 extC 里永远是显式的）。

struct cell {
    color: i32
    marks: i32

    fn ==(self: ref cell, other: cell) -> bool {
        return self.color == other.color && self.marks == other.marks
    }
}

// 视图能当普通容器用 —— 这一条是「库能用 extC 写」的关键
fn sum(v: slice<i32>) -> i32 {
    var s: i32 = 0
    var i: i64 = 0
    while i < v.len {
        s = s + v[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    var a: [8]i32 = [10, 20, 30, 40, 50, 60, 70, 80]

    // ① 四种写法：两端 / 到尾 / 从头 / 全部
    var mid = a[2..5]                // var：打算透过它写
    println(mid)                    // [30, 40, 50]
    println(mid.len)                // 3
    let tailOnly = a[6..]            // let：只读
    println(tailOnly)                // [70, 80]
    println(a[..3])                 // [10, 20, 30]
    println(a[..].len)              // 8

    // ② 视图是「同一块内存」—— 透过它改，原数组跟着变
    //    注意 `let` 的视图**写不进去**（编译期就报错）：
    //        let v = a[1..3]
    //        v[0] = 9     // error: cannot write through `v`, which is a `let`
    //    这就是 `let` / `var` 的分工 —— 视图本身没有第二套「只读视图」类型。
    mid[0] = 999
    println(a[2])                   // 999
    a[3] = 41
    println(mid[1])                 // 41

    // ③ 视图能传参、能返回 —— 它就是普通的值类型
    println(sum(a[1..4]))           // 20 + 999 + 41 = 1060

    // ④ 切视图本身（字符串上最常用）
    let s = "hello world"
    println(s[0..5])                // hello
    println(s[6..])                 // world
    println(s[2..2].len)            // 0  —— 空视图，data 仍指向 s 的第 2 个字节
    println("abcdef"[1..3])         // bc

    // ⑤ 编译期能证明的，运行时不留痕迹
    //    a[0..3] 两个界都是字面量 ⇒ 生成的 C 就是 `&a.data[0]` / `.len = 3`，
    //    **一个边界检查都没有**。（界是变量时才走带检查的 helper。）
    var lo = 1
    var hi = 4
    let dyn = a[lo..hi]             // 界是变量 ⇒ 运行时检查
    println(dyn.len)                // 3

    // ⑥ 多维只切**最后一段**：先取一行（那是 [8]i32，不是视图），再切这一行
    var b: [3][8]i32
    b[1][2] = 7
    b[1][3] = 8
    println(b[1][2..4])             // [7, 8]
    println(b[1][0..8].len)         // 8

    // ⑦ 元素是 struct 也能切；视图元素能读、能取地址比较、也能写回
    var cells: [5]cell
    cells[1].color = 3
    cells[2].color = 4
    cells[2].marks = 9
    var vs = cells[0..3]            // var ⇒ 可以透过视图写
    println(vs[1].color)            // 3
    vs[0].color = 1
    println(cells[0].color)         // 1
    println(vs[2] == cell { color: 4, marks: 9 })   // true

    return 0
}
