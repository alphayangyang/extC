import viperbuild as vb
import stdio
import stdlib
import memhub

proj = vb.Project("sizevp", "0.0.1")
proj.config(source=".", includes=["/tmp/viper/V_L64/includes"], compiler=["llc"], linker=["/tmp/viper/linkwrap"])
proj.build(triple="x86_64-pc-linux-gnu", datalayout="e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128", run=False)

define MASK = 4611686018427387903

class rng():
    s: int64

def nxt(st: rng*) -> int64:
    st.s = (st.s * 1103515245 + 12345) & 2147483647
    return st.s

def pick(st: rng*, k: int64) -> int64:
    return (nxt(st) / 1024) % k

def main() -> int:
    n: int64 = 2000000
    arena: rawptr = stdlib.malloc(1073741824)
    mp: memhub.MemPool* = memhub.NewMemPool(arena, 1073741824)
    st: rng* = rng*(mp.alloc(rng.__sizeof__()))
    st.s = 20261013
    tbl: uint64* = uint64*(mp.alloc(32768))
    b: int64 = 0
    while b < 4096:
        tbl[b] = 0
        b = b + 1
    sum: int64 = 0
    kept: int64 = 0
    livebytes: int64 = 0
    i: int64 = 0
    while i < n:
        cls: int64 = pick(st, 4)
        size: int64 = 32 + cls * 32
        o: rawptr = mp.alloc(size)
        kp: int64* = int64*(o)
        kp[0] = i
        sum = (sum + i) & MASK
        if i % 8 == 0:
            slot: int64 = (i / 8) % 1024
            idx: int64 = cls * 1024 + slot
            if tbl[idx] != 0:
                livebytes = livebytes - size
            else:
                kept = kept + 1
            tbl[idx] = uint64(o)
            livebytes = livebytes + size
        i = i + 1
    stdio.printf("ops=%lld kept=%lld livebytes=%lld sum=%lld\n", n, kept, livebytes, sum)
    stdio.printf("classes=4 sizes=32..128 slots=1024\n")
    return 0
