import viperbuild as vb
import stdio
import stdlib
import memhub

proj = vb.Project("chasevp", "0.0.1")
proj.config(source=".", includes=["/tmp/viper/V_L64/includes"], compiler=["llc"], linker=["/tmp/viper/linkwrap"])
proj.build(triple="x86_64-pc-linux-gnu", datalayout="e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128", run=False)

define CAP = 1048576
define OUTDEG = 4
define CHURN_EVERY = 256
define CHURN = 4
define MASK = 4611686018427387903

class node():
    k: int64
    v: int64
    o0: node*
    o1: node*
    o2: node*
    o3: node*

class rng():
    s: int64

def nxt(st: rng*) -> int64:
    st.s = (st.s * 1103515245 + 12345) & 2147483647
    return st.s

def pick(st: rng*, k: int64) -> int64:
    return (nxt(st) / 1024) % k

def main() -> int:
    m: int64 = CAP
    w: int64 = 4000000
    arena: rawptr = stdlib.malloc(402653184)
    mp: memhub.MemPool* = memhub.NewMemPool(arena, 402653184)
    st: rng* = rng*(mp.alloc(rng.__sizeof__()))
    st.s = 20261013
    gt: node** = node**(mp.alloc(m * 8))
    i: int64 = 0
    while i < m:
        x: node* = node*(mp.alloc(node.__sizeof__()))
        x.k = i
        x.v = nxt(st) % 1000
        gt[i] = x
        i = i + 1
    i = 0
    while i < m:
        src: node* = gt[i]
        base: node** = &src.o0
        j: int64 = 0
        while j < OUTDEG:
            t: int64 = nxt(st) % m
            base[j] = gt[t]
            j = j + 1
        i = i + 1
    cur: node* = gt[0]
    sum: int64 = 0
    churn: int64 = 0
    tailv: int64 = 0
    step: int64 = 0
    while step < w:
        sum = (sum + cur.v) & MASK
        r: int64 = pick(st, 4)
        ebase: node** = &cur.o0
        cur = ebase[r]
        if step % CHURN_EVERY == 0:
            h: node* = None
            j: int64 = 0
            while j < CHURN:
                s: node* = node*(mp.alloc(node.__sizeof__()))
                s.k = step
                s.v = nxt(st) % 1000
                s.o0 = h
                h = s
                j = j + 1
            tailv = h.v
            churn = churn + CHURN
        step = step + 1
    stdio.printf("nodes=%lld edges=%lld walk=%lld churn=%lld sum=%lld tailv=%lld\n", m, m * OUTDEG, w, churn, sum, tailv)
    stdio.printf("outdeg=4 cap=1048576 churn_every=256 churn=4\n")
    return 0
