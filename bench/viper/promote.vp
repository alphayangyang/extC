import viperbuild as vb
import stdio
import stdlib
import memhub

proj = vb.Project("promotevp", "0.0.1")
proj.config(source=".", includes=["/tmp/viper/V_L64/includes"], compiler=["llc"], linker=["/tmp/viper/linkwrap"])
proj.build(triple="x86_64-pc-linux-gnu", datalayout="e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128", run=False)

define MASK = 4611686018427387903

class node():
    k: int64
    v: int64
    next: node*

class rng():
    s: int64

def nxt(st: rng*) -> int64:
    st.s = (st.s * 1103515245 + 12345) & 2147483647
    return st.s

def pick(st: rng*, k: int64) -> int64:
    return (nxt(st) / 1024) % k

def main() -> int:
    n: int64 = 500000
    arena: rawptr = stdlib.malloc(805306368)
    mp: memhub.MemPool* = memhub.NewMemPool(arena, 805306368)
    st: rng* = rng*(mp.alloc(rng.__sizeof__()))
    st.s = 20261013
    t: node** = node**(mp.alloc(65536 * 8))
    b: int64 = 0
    while b < 65536:
        t[b] = None
        b = b + 1
    sum: int64 = 0
    walksum: int64 = 0
    live: int64 = 0
    tailv: int64 = 0
    i: int64 = 0
    while i < n:
        head: node* = None
        j: int64 = 0
        while j < 9:
            s: node* = node*(mp.alloc(node.__sizeof__()))
            s.k = i * 9 + j
            s.v = nxt(st) % 1000
            s.next = head
            head = s
            sum = (sum + s.v) & MASK
            j = j + 1
        if head != None:
            tailv = head.v
        if i % 10 == 0:
            p: node* = node*(mp.alloc(node.__sizeof__()))
            p.k = i
            p.v = nxt(st) % 1000
            bidx: int64 = i % 65536
            p.next = t[bidx]
            t[bidx] = p
            live = live + 1
        b2: int64 = (i * 40503) % 65536
        c: node* = t[b2]
        cnt: int64 = 0
        while c != None:
            if cnt >= 8:
                break
            walksum = (walksum + c.v) & MASK
            c = c.next
            cnt = cnt + 1
        i = i + 1
    stdio.printf("rounds=%lld promoted=%lld walksum=%lld sum=%lld tailv=%lld\n", n, live, walksum, sum, tailv)
    stdio.printf("table=65536 short=9 every=10 walkcap=8\n")
    return 0
