use std::io
fn mul(n: i64, a: slice<f32>, b: slice<f32>, c: mut slice<f32>) -> i32 {
  var i: i64 = 0
  while i < n {
    var k: i64 = 0
    while k < n {
      let aik = a[i * n + k]
      var j: i64 = 0
      while j < n {
        c[i * n + j] = c[i * n + j] + aik * b[k * n + j]
        j = j + i64(1)
      }
      k = k + i64(1)
    }
    i = i + i64(1)
  }
  return 0
}
fn main() -> i32 {
  let n: i64 = 768
  var a: mut slice<f32> = new f32[n * n]
  var b: mut slice<f32> = new f32[n * n]
  var c: mut slice<f32> = new f32[n * n]
  var i: i64 = 0
  while i < n * n {
    a[i] = f32(i % 7) * 0.125
    b[i] = f32(i % 5) * 0.25
    c[i] = 0.0
    i = i + i64(1)
  }
  mul(n, a[..], b[..], c)
  io::cout << "c0=" << f64(c[0]) << " clast=" << f64(c[n * n - 1]) << "\n"
  return 0
}
