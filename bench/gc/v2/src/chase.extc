use std::io
var gstate: i64 = 1
fn nxt() -> i64 { gstate = (gstate * 1103515245 + 12345) & 2147483647  return gstate }
fn pick(k: i64) -> i64 { return (nxt() / 1024) % k }
fn parseI64(s: slice<u8>) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len { var c: u8 = s[i]  if c < u8(48) { break }  if c > u8(57) { break }  v = v * 10 + i64(c) - 48  i = i + 1 }
    return v
}

// G3 chase：大活集（CAP 个节点、每节点 4 条出边）随机游走 W 步；每 256 步顺手分配 4 个即抛节点制造 GC 压力。
struct node { k: i64  v: i64  o: [4]?mut ref node }
struct graph { n: [1048576]?mut ref node }
fn main(args: slice<slice<u8>>) -> i32 {
    var m: i64 = 1048576
    if args.len > 1 { m = parseI64(args[1]) }
    var sd: i64 = 20261013
    if args.len > 2 { sd = parseI64(args[2]) }
    var w: i64 = 4000000
    if args.len > 3 { w = parseI64(args[3]) }
    gstate = sd & 2147483647
    var g: mut ref graph = new graph
    var i: i64 = 0
    while i < m {
        var x: mut ref node = new node
        x.k = i  x.v = nxt() % 1000
        g.n[i] = x
        i = i + 1
    }
    i = 0
    while i < m {
        var src: ?mut ref node = g.n[i]
        if src != null {
            var j: i64 = 0
            while j < 4 { var t: i64 = nxt() % m  src.o[j] = g.n[t]  j = j + 1 }
        }
        i = i + 1
    }
    var cur: ?mut ref node = g.n[0]
    var sum: i64 = 0  var churn: i64 = 0  var tailv: i64 = 0
    var step: i64 = 0
    while step < w {
        if cur != null { sum = (sum + cur.v) & 4611686018427387903 }
        var r: i64 = pick(4)
        if cur != null { cur = cur.o[r] }
        if step % 256 == 0 {
            var h: ?mut ref node = null
            var j: i64 = 0
            while j < 4 { var s: mut ref node = new node  s.k = step  s.v = nxt() % 1000  s.o[0] = h  h = s  j = j + 1 }
            if h != null { tailv = h.v }
            churn = churn + 4
        }
        step = step + 1
    }
    io::cout << "nodes=" << m << " edges=" << m * 4 << " walk=" << w << " churn=" << churn << " sum=" << sum << " tailv=" << tailv << "\n"
    io::cout << "outdeg=4 cap=1048576 churn_every=256 churn=4\n"
    return 0
}