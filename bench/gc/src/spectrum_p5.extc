// P5 滑动窗口环形缓冲（引用）+ 长命索引（偶发插入）：写密集、活集稳定。与 .go 同输出。
use std::io
struct ent { k: i64  v: i64  next: ?mut ref ent }
struct idx { buckets: [1024]?mut ref ent  n: i64  hit: i64  ins: i64 }
struct win { slots: [256]?mut ref ent }
var gstate: i64 = 1
fn nxt() -> i64 { gstate = (gstate * 1103515245 + 12345) & 2147483647  return gstate }
fn parseI64(s: slice<u8>) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len { var c: u8 = s[i]  if c < u8(48) { break }  if c > u8(57) { break }  v = v * 10 + i64(c) - 48  i = i + 1 }
    return v
}
fn idxPut(x: mut ref idx, k: i64, v: i64) {
    var h: i64 = (k * 2654435761) & 1023
    var e: mut ref ent = new ent
    e.k = k  e.v = v  e.next = x.buckets[h]
    x.buckets[h] = e  x.n = x.n + 1  x.ins = x.ins + 1
}
fn idxGet(x: mut ref idx, k: i64) -> i64 {
    var h: i64 = (k * 2654435761) & 1023
    var c: ?mut ref ent = x.buckets[h]
    while c != null { if c.k == k { x.hit = x.hit + 1  return c.v }  c = c.next }
    return i64(-1)
}
fn main(args: slice<slice<u8>>) -> i32 {
    var ops: i64 = 300000
    if args.len > 1 { ops = parseI64(args[1]) }
    var sd: i64 = 20261013
    if args.len > 2 { sd = parseI64(args[2]) }
    gstate = sd & 2147483647
    var x: mut ref idx = new idx
    x.n = 0  x.hit = 0  x.ins = 0
    var w: mut ref win = new win
    var sum: i64 = 0
    var i: i64 = 0
    while i < ops {
        var k: i64 = nxt() % 4096
        var e: mut ref ent = new ent
        e.k = k  e.v = i % 1000  e.next = null
        w.slots[i % 256] = e
        if i % 8 == 0 { idxPut(x, k, e.v) }
        var g: i64 = idxGet(x, k)
        if g >= 0 { sum = (sum + g) & 4611686018427387903 }
        var s: i64 = 0
        var j: i64 = 0
        while j < 4 { var q: i64 = (i + j) % 256  var t: ?mut ref ent = w.slots[q]  if t != null { s = s + t.k }  j = j + 1 }
        sum = (sum + s) & 4611686018427387903
        i = i + 1
    }
    io::cout << "ops=" << ops << " idx=" << x.n << " sum=" << sum << "\n"
    io::cout << "ins=" << x.ins << " hit=" << x.hit << " win=" << 256 << "\n"
    return 0
}
