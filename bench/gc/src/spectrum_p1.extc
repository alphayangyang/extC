// P1 纯短命分配、**无引用**：分配-用完-丢（arena 型、无图）。与 spectrum_p1.go 逐字节同输出。
use std::io
struct buf { p: [64]i64 }
var gstate: i64 = 1
fn nxt() -> i64 { gstate = (gstate * 1103515245 + 12345) & 2147483647  return gstate }
fn parseI64(s: slice<u8>) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len { var c: u8 = s[i]  if c < u8(48) { break }  if c > u8(57) { break }  v = v * 10 + i64(c) - 48  i = i + 1 }
    return v
}
fn main(args: slice<slice<u8>>) -> i32 {
    var n: i64 = 200000
    if args.len > 1 { n = parseI64(args[1]) }
    var sd: i64 = 20261013
    if args.len > 2 { sd = parseI64(args[2]) }
    gstate = sd & 2147483647
    var sum: i64 = 0
    var i: i64 = 0
    while i < n {
        var b: mut ref buf = new buf
        var j: i64 = 0
        while j < 64 { b.p[j] = nxt() % 1000  sum = (sum + b.p[j] * (j + 1)) & 4611686018427387903  j = j + 1 }
        i = i + 1
    }
    io::cout << "n=" << n << " sum=" << sum << "\n"
    io::cout << "allocs=" << n << " per=" << 64 << "\n"
    return 0
}
