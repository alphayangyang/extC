// P3 每轮建一条链表、轮末整片丢（无跨轮引用）。与 .go 同输出。
use std::io

use std::time
var USN: i64 = 0
var US: [1000002]i64
fn us() { if USN < 1000002 { US[USN] = time::now()  USN = USN + 1 } }
fn usDump() {
    io::cerr << "USMETA n=" << USN << "\n"
    var usk: i64 = 0
    while usk < USN { io::cerr << "US " << US[usk] << "\n"  usk = usk + 1 }
    io::cerr << "USEND\n"
}
struct node { v: i64  next: ?mut ref node }
var gstate: i64 = 1
fn nxt() -> i64 { gstate = (gstate * 1103515245 + 12345) & 2147483647  return gstate }
fn parseI64(s: slice<u8>) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len { var c: u8 = s[i]  if c < u8(48) { break }  if c > u8(57) { break }  v = v * 10 + i64(c) - 48  i = i + 1 }
    return v
}
fn main(args: slice<slice<u8>>) -> i32 {
    var rounds: i64 = 5000
    if args.len > 1 { rounds = parseI64(args[1]) }
    var sd: i64 = 20261013
    if args.len > 2 { sd = parseI64(args[2]) }
    gstate = sd & 2147483647
    var sum: i64 = 0
    var total: i64 = 0
    var r: i64 = 0
    while r < rounds {
        us()
        var head: ?mut ref node = null
        var k: i64 = 40 + nxt() % 40
        var i: i64 = 0
        while i < k { var p: mut ref node = new node  p.v = nxt() % 1000  p.next = head  head = p  i = i + 1 }
        var cur: ?mut ref node = head
        while cur != null { sum = (sum + cur.v) & 4611686018427387903  cur = cur.next }
        total = total + k
        r = r + 1
    }
    us()
    usDump()
    io::cout << "rounds=" << rounds << " nodes=" << total << " sum=" << sum << "\n"
    io::cout << "drops=" << rounds << " per_round_min=" << 40 << "\n"
    return 0
}
