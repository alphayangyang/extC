/* 深度 1：main 直接驱动 tick */
fn lcg(s: i64, i: i64) -> i64 { return s * i64(6364136223846793005) + i }
fn tick(n: i64) -> coroutine<i64> {
    var i: i64 = 0
    var s: i64 = 1
    while i < n { s = lcg(s, i)  yield s  i = i + 1 }
}
fn main() -> i32 {
    var acc: i64 = 0
    var c = tick(i64(5000))
    while c.next() { acc = acc + c.value() }
    return i32(acc & i64(2147483647))
}
