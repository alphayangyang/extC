var composite: [10000001]bool
fn main() -> i32 {
    let n: i64 = 10000000
    var cnt: i64 = 0
    var i: i64 = 2
    while i <= n {
        if !composite[i] {
            cnt = cnt + 1
            var j: i64 = i * i
            while j <= n { composite[j] = true  j = j + i }
        }
        i = i + 1
    }
    println("pi = ", cnt)
    return 0
}
