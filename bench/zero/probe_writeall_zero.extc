// 账单：**清零之后用户还要把整块写一遍** —— 那这一遍清零是不是白花的？
//
// 形状：拿一块 10 万 i32（400 KB）的板块，然后**把每一个元素都写一遍**（用户真会这么干：
// `withCap` 之后逐个 push / 填表）。2000 轮。
//
// 对照：清零那扇门（poolSlice）vs 不清零那扇门（poolSliceRaw）。两者最后都被整片写满，
// 所以差值就是"先清零再覆写"那一遍的净浪费。
use std::io
use std::sys::pool as syspool

fn main() -> i32 {
    var acc: i64 = 0
    var r: i64 = 0
    while r < i64(2000) {
        let rid = syspool::extc_pool_new(i64(-1))
        var s: mut slice<i32> = poolSlice<i32>(rid, i64(100000))
        var i: i64 = 0
        while i < i64(100000) {
            s[i] = i32(i)
            i = i + i64(1)
        }
        acc = acc + i64(s[i64(99999)])
        syspool::extc_pool_drop(rid)
        r = r + i64(1)
    }
    io::cout << "zero acc=" << acc << "\n"
    return 0
}
