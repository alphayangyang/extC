use std::io
use std::sys::pool as syspool

/* `args[1]` 当十进制数读 */
fn toInt(s: slice<u8>, dflt: i64) -> i64 {
    if s.len == i64(0) { return dflt }
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let b = i64(s[i])
        if b < i64(48) || b > i64(57) { return dflt }
        v = v * i64(10) + (b - i64(48))
        i = i + i64(1)
    }
    return v
}

/* 保留池的收益形状：循环里建池 → 拿一块**够大**的 raw 板块（不清零那条路）→ 丢池。
 * 轮数从命令行给（默认 200000），块大小也从命令行给（默认 400000 个 i64 ≈ 3.2 MB）。
 * 判据在 run.sh 里：同一轮数下，保留池命中之后时间必须明显下降；keepBytes 不许无限涨。 */
fn main(args: slice<slice<u8>>) -> i32 {
    var rounds: i64 = i64(200000)
    if args.len > i64(1) { rounds = toInt(args[1], rounds) }
    var n: i64 = i64(100000)
    if args.len > i64(2) { n = toInt(args[2], n) }
    var r: i64 = 0
    var sink: i64 = 0
    while r < rounds {
        let rid = syspool::extc_pool_new(i64(-1))
        var s: mut slice<i64> = poolSliceRaw<i64>(rid, n)
        s[0] = i64(1)
        sink = sink + s[i64(0)]
        syspool::extc_pool_drop(rid)
        r = r + i64(1)
    }
    let keep = syspool::extc_pool_keep_bytes()
    let live = syspool::extc_pool_bytesLive()
    io::cout << "n=" << n << " rounds=" << rounds << " sink=" << sink << " keep=" << keep << " live=" << live << "\n"
    return 0
}
