use std::io
use std::sys::pool as syspool

/* `args[i]` 当十进制数读 */
fn toInt(s: slice<u8>, dflt: i64) -> i64 {
    if s.len == i64(0) { return dflt }
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let b = i64(s[i])
        if b < i64(48) || b > i64(57) { return dflt }
        v = v * i64(10) + (b - i64(48))
        i = i + i64(1)
    }
    return v
}

/* 拆 B 与 C 的差（19 ns 里那 7.85 ns 是谁）：
 *
 *   m=0  只做 new/drop（不拿板块、不碰数据）—— 池记录那一层自己的代价
 *   m=1  只做 new + 拿板块 + drop（板块**超上限**，不进保留池 ⇒ 每次都真 malloc）
 *   m=2  只做 new + 拿板块 + drop（板块**在保留区间**，走保留池 ⇒ 复用）
 *   m=3  new + 拿板块 + reset（B：池记录与板块都复用）
 */
fn main(args: slice<slice<u8>>) -> i32 {
    var rounds: i64 = i64(2000000)
    if args.len > i64(1) { rounds = toInt(args[1], rounds) }
    var m: i64 = i64(0)
    if args.len > i64(2) { m = toInt(args[2], m) }

    var sink: i64 = 0
    if m == i64(0) {
        var r: i64 = 0
        while r < rounds {
            let rid = syspool::extc_pool_new(i64(-1))
            syspool::extc_pool_drop(rid)
            r = r + i64(1)
        }
    } else {
        if m == i64(3) {
            var rid = syspool::extc_pool_new(i64(-1))
            var s: mut slice<i32> = poolSliceRaw<i32>(rid, i64(4096))
            var r: i64 = 0
            while r < rounds {
                s[0] = i32(1)
                sink = sink + i64(s[0])
                syspool::extc_pool_reset(rid)
                r = r + i64(1)
            }
        } else {
            var n: i64 = i64(4096)
            if m == i64(1) { n = i64(8192) }      /* 64 KB > 256 KB？不：4096 个 i32 = 16 KB，在区间内 */
            if m == i64(1) { n = i64(65536) }     /* 256 KB 整——正好在上限，换成 512 KB 才是"超" */
            if m == i64(1) { n = i64(200000) }    /* 800 KB：超单块上限 ⇒ 每次真 malloc */
            var r: i64 = 0
            while r < rounds {
                let rid = syspool::extc_pool_new(i64(-1))
                var s: mut slice<i32> = poolSliceRaw<i32>(rid, n)
                s[0] = i32(1)
                sink = sink + i64(s[0])
                syspool::extc_pool_drop(rid)
                r = r + i64(1)
            }
        }
    }
    var live = syspool::extc_pool_bytesLive()
    var keep = syspool::extc_pool_keep_bytes()
    io::cout << "m=" << m << " rounds=" << rounds << " sink=" << sink << " live=" << live << " keep=" << keep << "\n"
    return 0
}
