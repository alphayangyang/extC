/* 静态区间第 k 小（主席树 / 可持久化线段树）—— **extC 指针式版：每节点 `new`**
 *
 * 跟 `p3834.extc`（索引式 + arena 池子）**同一个算法**，区别只在**节点怎么放**：
 *   · 索引式：一个 252MB 的 `new [POOL]pnode` 数组 + i32 下标（12 字节/节点）
 *   · 这里：**每个节点一次 `new pnode`**（`ref` 指针相连，20→24 字节/节点）
 *
 * ⭐ 这一版是**"用足 arena"的极端**：全程序**没有一处 free、没有一个池子大小** ——
 *   节点按需从 arena 撞指针拿，程序结束自动全没 ✓
 *   （C 里同样形状要么每节点 `malloc`（21M 次 + 结束时逐个 free），要么自己写池子；
 *     Rust 里要么 `Box::new` 每节点一次（≈ malloc），要么自己写 arena ✓）
 *
 * 写法上的三个 extC 味道（前两个是好处，第三个是**真实约束**）：
 *   · **哨兵节点**：空子树就是它 ⇒ 全程**没有一处 null 判断**，
 *     字段类型写成 `ref pnode`（**非可空**只读引用）⇒ 类型层面就抹掉了空指针 ✓
 *   · 哨兵是 arena 里的一个普通节点（`new pnode` + `(*z).l = ref *z`），
 *     当参数传下去 —— extC 里"一个对象 + 它的句柄"就是这么走的 ✓
 *   · ⚠️ 一百万个"版本根"**不能当全局数组** —— 全局是深度 0，含引用的类型
 *     没有零值可借 ⇒ `error: cannot zero-initialize the global` ✗
 *     （P′ 的体现：非空引用不可能凭空为零。C 里 `Node *root[N];` 全局是常规写法 ✓）
 *     ⇒ 自然出路就是**放进 arena**：`new [N]?ref pnode`（可空 ⇒ 零值是 null ✓），
 *       进树那一处用 `!` **签字非空**（零成本），"根永远非空"由 `(*root)[0] = ref *z` 立住 ✓
 */
struct pnode {
    l: ref pnode
    r: ref pnode
    sum: i32
}

let N: i64 = 1000000
let Q: i64 = 1000000
let V: i64 = 1000000

var A: [1000001]i32
var NP: i32 = 1                     /* 1 = 哨兵算 0 号节点（跟索引式版本对齐 ✓）*/

/* ---------------- 可持久化线段树 ---------------- */
fn update(z: ref pnode, prev: ref pnode, lo: i32, hi: i32, pos: i32) -> mut ref pnode {
    var n: mut ref pnode = new pnode
    NP = NP + 1
    n.l = prev.l
    n.r = prev.r
    n.sum = prev.sum + 1
    if lo < hi {
        let mid: i32 = lo + (hi - lo) / 2
        if pos <= mid {
            n.l = update(ref *z, prev.l, lo, mid, pos)
        } else {
            n.r = update(ref *z, prev.r, mid + 1, hi, pos)
        }
    }
    return n
}

fn query(u: ref pnode, v: ref pnode, lo: i32, hi: i32, k: i32) -> i32 {
    if lo == hi { return lo }
    let mid: i32 = lo + (hi - lo) / 2
    let leftCount: i32 = v.l.sum - u.l.sum
    if k <= leftCount {
        return query(u.l, v.l, lo, mid, k)
    }
    return query(u.r, v.r, mid + 1, hi, k - leftCount)
}

fn main() -> i32 {
    var rng: pcg32 = pcg32::seeded(u64(20260922))

    /* 哨兵：全零的节点，两个儿子都指向自己 ⇒ 空子树的"叶子"就是它 ✓ */
    var z: mut ref pnode = new pnode
    (*z).l = ref *z
    (*z).r = ref *z
    (*z).sum = 0

    /* 一百万个"版本根"也放 arena（零值 = null ✓）；0 号是哨兵 */
    var root: mut ref [1000001]?ref pnode = new [1000001]?ref pnode
    (*root)[0] = ref *z

    var i: i64 = 1
    while i <= N {
        A[i] = i32(rng.nextBounded(u64(V))) + 1
        i = i + 1
    }

    var inSum: u64 = 0
    i = 1
    while i <= N {
        inSum = inSum * 1000003 + u64(A[i])
        i = i + 1
    }

    i = 1
    while i <= N {
        (*root)[i] = update(ref *z, (*root)[i - 1]!, 1, i32(V), A[i])
        i = i + 1
    }

    var ansSum: u64 = 0
    var j: i64 = 0
    while j < Q {
        let l: i64 = 1 + i64(rng.nextBounded(u64(N)))
        let r: i64 = l + i64(rng.nextBounded(u64(N - l + 1)))
        let k: i64 = 1 + i64(rng.nextBounded(u64(r - l + 1)))
        let ans: i32 = query((*root)[l - 1]!, (*root)[r]!, 1, i32(V), i32(k))
        ansSum = ansSum * 1000009 + u64(ans)
        j = j + 1
    }

    println("in    = ", inSum)
    println("n     = ", N)
    println("q     = ", Q)
    println("nodes = ", NP)
    println("ans   = ", ansSum)
    return 0
}
