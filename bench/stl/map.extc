// map<i64,i32>（B+ 树）：100 万次插入 / 100 万次查找 / 有序遍历 / 50 万次删除
use std::io
use stl::map

let N: i64 = 1000000

fn main() -> i32 {
    var m: map<i64, i32> = map<i64, i32>::withCap(i64(16))   // std::map 没有容量提示，两边都从零长
    var u: u64 = u64(12345)
    var i: i64 = 0
    var sum: i64 = 0
    while i < N {
        u = u * u64(6364136223846793005) + u64(1442695040888963407)
        let k = i64(u & u64(2147483647))
        m.put(k, i32(k))
        i = i + i64(1)
    }
    u = u64(12345)
    i = i64(0)
    while i < N {
        u = u * u64(6364136223846793005) + u64(1442695040888963407)
        let k = i64(u & u64(2147483647))
        let v: i32 = m.get(k) ?? i32(-1)
        sum = sum + i64(v)
        i = i + i64(1)
    }
    i = i64(0)
    while i < m.len() {
        sum = sum + m.keyAt(i) % i64(1000)
        i = i + i64(1)
    }
    u = u64(12345)
    i = i64(0)
    var removed: i64 = 0
    while i < N {
        u = u * u64(6364136223846793005) + u64(1442695040888963407)
        let k = i64(u & u64(2147483647))
        if i % i64(2) == i64(0) {
            if m.remove(k) { removed = removed + i64(1) }
        }
        i = i + i64(1)
    }
    io::cout << "len=" << m.len() << " sum=" << sum << " removed=" << removed << "\n"
    return 0
}
