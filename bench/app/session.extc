// bench/app/session.extc —— **场景 A：会话/连接表**（串行阻塞服务的核心数据结构）
//
// 模拟一个服务端：每个"连接"有 id、用户、状态、字节数、最后活动时间。
// 负载是三件事的混合 —— 查找（60%）、建立/更新（20%）、断开（20%）——
// 这正是 `hashMap` 要扛的形状：**高频写 + 高频删 + 少量读**，而且键是 i64（连接 id）。
//
// 与 `bench/stl` 的区别：那里量单个操作；这里量**混在一起之后**的真实代价
// （miss 的键也要查、删掉的键要能立刻被别人复用、容量要跟着活跃数走）。
//
// 用法：session.extc <轮数>（默认 2000000）
use std::io
use std::sys::pool as syspool
use stl::hashMap

struct session {
    user: i64
    state: i32
    bytes: i64
    last: i64
}

fn toInt(s: slice<u8>, dflt: i64) -> i64 {
    if s.len == i64(0) { return dflt }
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let b = i64(s[i])
        if b < i64(48) || b > i64(57) { return dflt }
        v = v * i64(10) + (b - i64(48))
        i = i + i64(1)
    }
    return v
}

fn main(args: slice<slice<u8>>) -> i32 {
    var n: i64 = i64(2000000)
    if args.len > i64(1) { n = toInt(args[1], n) }

    var live: hashMapI64<session> = hashMapI64<session>::withCap(i64(4096))
    var acc: i64 = 0
    var hits: i64 = 0
    /* ⚠️ 下标与周期**必须互质**，否则负载会退化成一串"建了就删、查时全 miss"。
     * 第一版：`k = i % 65536` 配 `op = i % 5` —— 同一个 key 固定在 `i%5` 的同一个相位上
     * （建、删、再查时光看相位就知道已经被删了）⇒ 命中率恒为 0，量出来的是"全 miss"的
     * 形状（实测：n=800000 要 6.1 s，每轮平均探测十万个桶）。
     * 现在：key 走 65536 的循环、相位走 977 的循环（互质）⇒ 每个 key 的一生里
     * 查询/更新/删除会按不同相位交错，命中率与真实会话表同量级。 */
    var i: i64 = 0
    while i < n {
        let k = i % i64(65536)                    /* 活跃集：65536 个连接 id */
        let op = i % i64(977)                     /* 与 65536 互质 ⇒ 相位逐轮错开 */
        let ph = op % i64(5)                      /* 0,1,2 = 查；3 = 建/更；4 = 删 */
        /* ⚠️ 顺序有讲究：**先查后动**。第一版写成"先删后查"（同一个 key 在 i%5==3 建、
         * i%5==4 删、等 i%5∈{0,1,2} 来查时早被删了）⇒ 命中率恒为 0，测出来的是
         * "全部 miss"的负载，与设想的"会话表"完全不是一回事。 */
        if ph < i64(3) {
            /* `get` 给 `?session`；`??` 取不出来就给零值。命中与否用 bytes 是否为 0 判
             * （这个负载里 bytes = i + k 恒 > 0 ⇒ 零值只可能来自 miss）。 */
            let s = live.get(k) ?? session { user: i64(0), state: i32(0), bytes: i64(0), last: i64(0) }
            acc = acc + s.bytes
            if s.bytes > i64(0) { hits = hits + i64(1) }
        } else {
            if ph == i64(3) {
                let s = session { user: k % i64(1024), state: i32(1), bytes: i + k, last: i }
                live.put(k, s)
            } else {
                if live.remove(k) { acc = acc + i64(1) }
            }
        }
        i = i + i64(1)
    }
    io::cout << "n=" << n << " len=" << live.len() << " hits=" << hits << " acc=" << (acc % i64(1000000007))
    io::cout << " live=" << syspool::extc_pool_bytesLive() << "\n"
    return 0
}
