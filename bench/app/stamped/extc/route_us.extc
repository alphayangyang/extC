// bench/app/route.extc —— **场景 B：路由表**（前缀查找 + 区间扫描）
//
// 模拟一个转发表：键是 /24 前缀（32 位地址的低 8 位清零），值是下一跳 id。
// 四个阶段覆盖有序表的四种用法：
//   ① 插入/更新 ops 条路由   ② **前驱查找**（最长前缀匹配的实质：最后一个 ≤ q 的前缀）
//   ③ **区间扫描** ops/4 次（数一个 /16 段里有多少条路由）  ④ 删除 ops/2 条
//
// 用法：route <ops>          （默认 2000000）
// 输出（三种语言必须逐字相同）：
//   b.ins=<新插入条数> b.lkp=<前驱查找校验和> b.scan=<区间计数和> b.del=<删除条数> b.len=<最终条数>
//
// 对照：extC `stl::map`（B+ 树）· C++ `std::map`（红黑树）· Go `map` + 排序切片（二分）。
// 三种都做**同一件事**，只是各自语言里最自然的那个有序结构。
use std::io
use stl::map

use std::time
use std::sys::io as sysio

/* ================ 应用侧逐单位时间戳（USER-STALL / bench/app） ================
 * 只写**戳文件**（路径来自 argv 最后一项）；stdout 一个字节都不动。
 * 40 字节头 + (nstamps-1) 个 unsigned-LEB128 增量（小端）。
 * 戳数 = 单位数 + 1：第一次 us() 记 t0，其后每次记一个增量，循环后补最后一次。
 * ============================================================================ */
let US_CAP: i64 = 27500104
var USB: [27500104]u8
var USBL: i64 = 40
var USN: i64 = 0
var UST0: i64 = 0
var USPREV: i64 = 0
var USNEG: i64 = 0
var USOVF: i64 = 0
var USSTART: bool = false
var USPB: [512]u8
var USPL: i64 = 0

fn usByte(b: u8) {
    if USBL < US_CAP { USB[USBL] = b  USBL = USBL + i64(1) } else { USOVF = USOVF + i64(1) }
}

fn usSet64(off: i64, v: u64) {
    var k: i64 = 0
    while k < i64(8) { USB[off + k] = u8(v & u64(255))  v = v >> u64(8)  k = k + i64(1) }
}

fn us() {
    let t = time::now()
    if !USSTART {
        USSTART = true
        UST0 = t
        USPREV = t
        USN = i64(1)
        return
    }
    var d: i64 = t - USPREV
    if d < i64(0) { USNEG = USNEG + i64(1)  d = i64(0) }
    USPREV = t
    USN = USN + i64(1)
    var v: u64 = u64(d)
    while v >= u64(128) {
        usByte(u8((v & u64(127)) | u64(128)))
        v = v >> u64(7)
    }
    usByte(u8(v))
}

fn usSetPath(p: slice<u8>) {
    var k: i64 = 0
    while k < p.len && k < i64(511) { USPB[k] = p[k]  k = k + i64(1) }
    USPL = k
    USPB[k] = u8(0)
}

fn usDump() {
    USB[0] = u8(85)  USB[1] = u8(83)  USB[2] = u8(65)  USB[3] = u8(80)
    USB[4] = u8(80)  USB[5] = u8(83)  USB[6] = u8(84)  USB[7] = u8(49)
    usSet64(i64(8), u64(USN))
    usSet64(i64(16), u64(UST0))
    usSet64(i64(24), u64(USNEG))
    usSet64(i64(32), u64(USOVF))
    if USPL == i64(0) { return }
    let fd = sysio::open(USPB[..USPL].data, sysio::O_WRONLY | sysio::O_CREAT | sysio::O_TRUNC, i32(420))
    if fd < i32(0) { io::cerr << "USAPP: open stamp file failed\n"  return }
    var done: i64 = 0
    while done < USBL {
        let n = sysio::write(fd, USB[done..].data, USBL - done)
        if n <= i64(0) { break }
        done = done + n
    }
    sysio::close(fd)
}

fn toInt(s: slice<u8>, dflt: i64) -> i64 {
    if s.len == i64(0) { return dflt }
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let b = i64(s[i])
        if b < i64(48) || b > i64(57) { return dflt }
        v = v * i64(10) + (b - i64(48))
        i = i + i64(1)
    }
    return v
}

fn main(args: slice<slice<u8>>) -> i32 {
    var ops: i64 = i64(2000000)
    if args.len > i64(1) { ops = toInt(args[1], ops) }
    if args.len > i64(2) { usSetPath(args[2]) }

    var routes: map<i64, i32> = map<i64, i32>::withCap(i64(16))
    var u: u64 = u64(12345)
    var i: i64 = 0
    var ins: i64 = 0
    var lkp: i64 = 0
    var scan: i64 = 0
    var del: i64 = 0

    /* ① 插入 / 更新：键是 /24 前缀（低 8 位清零），值与键有关以便校验。 */
    while i < ops {
        u = u * u64(6364136223846793005) + u64(1442695040888963407)
        let key = i64(u & u64(4294967040))
        us()
        if !routes.put(key, i32(key % i64(1024))) { ins = ins + i64(1) }
        i = i + i64(1)
    }

    /* ② 前驱查找：`lowerBound(q+1) - 1` 是"最后一个 ≤ q 的前缀"的名次。
     * 找不到（q 比所有前缀都小）记 -1。 */
    u = u64(12345)
    i = i64(0)
    while i < ops {
        u = u * u64(6364136223846793005) + u64(1442695040888963407)
        let q = i64(u & u64(4294967295))
        us()
        let rank = routes.lowerBound(q + i64(1)) - i64(1)
        if rank >= i64(0) { lkp = lkp + i64(routes.valAt(rank)) } else { lkp = lkp - i64(1) }
        i = i + i64(1)
    }

    /* ③ 区间扫描：数 [lo, lo+65536) 里有多少条路由（两次名次查询之差，O(log n)）。 */
    u = u64(12345)
    i = i64(0)
    while i < ops / i64(4) {
        us()
        u = u * u64(6364136223846793005) + u64(1442695040888963407)
        let lo = i64(u & u64(4294901760))
        let hi = lo + i64(65536)
        scan = scan + (routes.lowerBound(hi) - routes.lowerBound(lo))
        i = i + i64(1)
    }

    /* ④ 删除一半。 */
    u = u64(12345)
    i = i64(0)
    while i < ops / i64(2) {
        us()
        u = u * u64(6364136223846793005) + u64(1442695040888963407)
        let key = i64(u & u64(4294967040))
        if routes.remove(key) { del = del + i64(1) }
        i = i + i64(1)
    }

    us()
    usDump()
    io::cout << "b.ins=" << ins << " b.lkp=" << (lkp % i64(1000000007)) << " b.scan=" << scan << " b.del=" << del << " b.len=" << routes.len() << "\n"
    return 0
}
