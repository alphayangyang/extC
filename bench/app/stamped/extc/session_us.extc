// bench/app/session.extc —— **场景 A：会话 / 连接表**（串行阻塞服务的核心数据结构）
//
// 模拟一个服务端：每个"连接"有 id、用户、状态、字节数、最后活动时间。
// 负载是三件事的混合 —— 查找（60%）、建立/更新（20%）、断开（20%）——
// 这正是 `hashMap` 要扛的形状：**高频写 + 高频删 + 少量读**，键是 i64（连接 id）。
//
// 用法：session <ops> <active>      （默认 2000000 / 65536）
// 输出（三种语言必须逐字相同）：a.len=<活跃条目> a.hits=<命中查询数> a.acc=<校验和>
//
// ⚠️ 写负载时**下标与周期必须互质**：`k = i % active`、相位 `op = i % 977`（977 是素数，
// 与 2 的幂互质）⇒ 同一个 key 的一生里查询/更新/删除会按不同相位交错。第一版拿 `i % 5`
// 当相位，同一个 key 固定在同一个相位上（建了就删、查时全 miss）⇒ 命中率恒为 0，
// 量出来的是"全 miss"的形状，与真实会话表完全不是一回事。
use std::io
use stl::hashMap

use std::time
use std::sys::io as sysio

/* ================ 应用侧逐单位时间戳（USER-STALL / bench/app） ================
 * 只写**戳文件**（路径来自 argv 最后一项）；stdout 一个字节都不动。
 * 40 字节头 + (nstamps-1) 个 unsigned-LEB128 增量（小端）。
 * 戳数 = 单位数 + 1：第一次 us() 记 t0，其后每次记一个增量，循环后补最后一次。
 * ============================================================================ */
let US_CAP: i64 = 10000114
var USB: [10000114]u8
var USBL: i64 = 40
var USN: i64 = 0
var UST0: i64 = 0
var USPREV: i64 = 0
var USNEG: i64 = 0
var USOVF: i64 = 0
var USSTART: bool = false
var USPB: [512]u8
var USPL: i64 = 0

fn usByte(b: u8) {
    if USBL < US_CAP { USB[USBL] = b  USBL = USBL + i64(1) } else { USOVF = USOVF + i64(1) }
}

fn usSet64(off: i64, v: u64) {
    var k: i64 = 0
    while k < i64(8) { USB[off + k] = u8(v & u64(255))  v = v >> u64(8)  k = k + i64(1) }
}

fn us() {
    let t = time::now()
    if !USSTART {
        USSTART = true
        UST0 = t
        USPREV = t
        USN = i64(1)
        return
    }
    var d: i64 = t - USPREV
    if d < i64(0) { USNEG = USNEG + i64(1)  d = i64(0) }
    USPREV = t
    USN = USN + i64(1)
    var v: u64 = u64(d)
    while v >= u64(128) {
        usByte(u8((v & u64(127)) | u64(128)))
        v = v >> u64(7)
    }
    usByte(u8(v))
}

fn usSetPath(p: slice<u8>) {
    var k: i64 = 0
    while k < p.len && k < i64(511) { USPB[k] = p[k]  k = k + i64(1) }
    USPL = k
    USPB[k] = u8(0)
}

fn usDump() {
    USB[0] = u8(85)  USB[1] = u8(83)  USB[2] = u8(65)  USB[3] = u8(80)
    USB[4] = u8(80)  USB[5] = u8(83)  USB[6] = u8(84)  USB[7] = u8(49)
    usSet64(i64(8), u64(USN))
    usSet64(i64(16), u64(UST0))
    usSet64(i64(24), u64(USNEG))
    usSet64(i64(32), u64(USOVF))
    if USPL == i64(0) { return }
    let fd = sysio::open(USPB[..USPL].data, sysio::O_WRONLY | sysio::O_CREAT | sysio::O_TRUNC, i32(420))
    if fd < i32(0) { io::cerr << "USAPP: open stamp file failed\n"  return }
    var done: i64 = 0
    while done < USBL {
        let n = sysio::write(fd, USB[done..].data, USBL - done)
        if n <= i64(0) { break }
        done = done + n
    }
    sysio::close(fd)
}

struct session {
    user: i64
    state: i32
    bytes: i64
    last: i64
}

fn toInt(s: slice<u8>, dflt: i64) -> i64 {
    if s.len == i64(0) { return dflt }
    var v: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let b = i64(s[i])
        if b < i64(48) || b > i64(57) { return dflt }
        v = v * i64(10) + (b - i64(48))
        i = i + i64(1)
    }
    return v
}

fn main(args: slice<slice<u8>>) -> i32 {
    var ops: i64 = i64(2000000)
    var active: i64 = i64(65536)
    if args.len > i64(1) { ops = toInt(args[1], ops) }
    if args.len > i64(2) { active = toInt(args[2], active) }
    if args.len > i64(3) { usSetPath(args[3]) }

    var live: hashMapI64<session> = hashMapI64<session>::withCap(active)
    var acc: i64 = 0
    var hits: i64 = 0
    var i: i64 = 0
    while i < ops {
        us()
        let k = i % active                           /* 活跃集：active 个连接 id */
        let op = i % i64(977)                        /* 与 2 的幂互质 ⇒ 相位逐轮错开 */
        let ph = op % i64(5)                         /* 0,1,2 = 查；3 = 建/更；4 = 删 */
        if ph < i64(3) {
            /* `get` 给 `?session`；`??` 取不出来就给零值。命中与否用 bytes 是否为 0 判
             * （这个负载里 bytes = i + k 恒 > 0 ⇒ 零值只可能来自 miss）。 */
            let s = live.get(k) ?? session { user: i64(0), state: i32(0), bytes: i64(0), last: i64(0) }
            acc = acc + s.bytes
            if s.bytes > i64(0) { hits = hits + i64(1) }
        } else {
            if ph == i64(3) {
                let s = session { user: k % i64(1024), state: i32(1), bytes: i + k, last: i }
                live.put(k, s)
            } else {
                if live.remove(k) { acc = acc + i64(1) }
            }
        }
        i = i + i64(1)
    }
    us()
    usDump()
    io::cout << "a.len=" << live.len() << " a.hits=" << hits << " a.acc=" << (acc % i64(1000000007)) << "\n"
    return 0
}
