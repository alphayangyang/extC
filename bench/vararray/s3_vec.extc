use std::io
use stl::vector
fn main() -> i32 {
    var sum: i64 = 0
    var r: i64 = 0
    while r < 2000 {
        var a = vector<i64>::withCap(4)
        var i: i64 = 0
        while i < 4096 { a.push(i)  i = i + 1 }
        sum = sum + a.get(4095)!
        r = r + 1
    }
    io::cout << "sum=" << sum << "\n"
    return 0
}
