use std::io
use stl::vector
fn main() -> i32 {
    var sum: i64 = 0
    var r: i64 = 0
    while r < i64(2000000) {
        var a = vector<i32>::withCap(i64(4))
        a.push(i32(1))
        a.push(i32(2))
        a.push(i32(3))
        a.push(i32(4))
        sum = sum + i64(a.get(i64(3)) ?? i32(-1))
        r = r + i64(1)
    }
    io::cout << "sum=" << sum << "\n"
    return 0
}
