use std::io
use std::data::vector
fn main() -> i32 {
    var sum: i64 = 0
    var r: i64 = 0
    while r < 20000000 {
        var a = vector<i32>::withCap(4)
        a.push(i32(1))
        a.push(i32(2))
        a.push(i32(3))
        a.push(i32(4))
        sum = sum + i64(a.get(3) ?? i32(-1))
        r = r + 1
    }
    io::cout << "sum=" << sum << "\n"
    return 0
}
