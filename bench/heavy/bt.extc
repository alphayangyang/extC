/* binary-trees（Computer Language Benchmarks Game 的经典项）：分配 + 递归 */
struct tree {
    left: ?ref tree
    right: ?ref tree
}

fn bottomUp(depth: i32) -> mut ref tree {
    var t: mut ref tree = new tree
    if depth > 0 {
        t.left = bottomUp(depth - 1)
        t.right = bottomUp(depth - 1)
    }
    return t
}

fn check(t: ref tree) -> i64 {
    var l: ?ref tree = t.left
    if l == null { return 1 }
    return 1 + check(l) + check(t.right!)
}

fn main() {
    var total: i64 = 0
    var d: i32 = 4
    while d <= 16 {                       // 逐层加深：每轮建一棵整树
        var t: mut ref tree = bottomUp(d)
        total = total + check(t)
        d = d + 1
    }
    var big: mut ref tree = bottomUp(18)
    var i: i64 = 0
    while i < 500 { total = total + check(big)  i = i + 1 }
    println("trees = ", total)
}
