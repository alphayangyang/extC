// 形状 H4：插入 2e6 条之后做两遍全表遍历（值一遍、键一遍，都走桶位）。
// 考的是遍历成本：extC 顺着一张桶数组走（装载 <= 0.85 ⇒ 空桶占比小），C++ 是沿桶链走。
use std::io
use std::data::hashMap

const SEED0: u64 = 0x2545F4914F6CDD1D
const N: i64 = 2000000
const SPACE: u64 = 1000000007

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var m: hashMapI64<i64> = hashMapI64<i64>::withCap(N)
    var r: rng = { s: SEED0 }
    var i: i64 = 0
    while i < N {
        let k: i64 = i64(next(ref r) % SPACE)
        let _had: bool = m.put(k, k * i64(3) + i64(1))
        i = i + 1
    }
    var vsum: i64 = 0
    let dn: i64 = m.len()
    let cap: i64 = m.capacity()
    var d: i64 = 0
    while d < cap {
        if m.liveAt(d) { vsum = vsum + m.valAt(d) }
        d = d + 1
    }
    var ksum: i64 = 0
    var b: i64 = 0
    while b < cap {
        if m.liveAt(b) { ksum = ksum + m.keyAt(b) }
        b = b + 1
    }
    println("n=", m.len(), " dn=", dn, " vsum=", vsum, " ksum=", ksum)
    return 0
}
