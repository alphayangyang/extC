// 形状 HS2：hashSetI64 在 1e6 个键上做 8e6 次插入/删除/查询（墓碑与 swap-remove 路径）。
use std::io
use std::data::hashMap

const SEED0: u64 = 0x2545F4914F6CDD1D
const OPS: i64 = 8000000
const SPACE: u64 = 1000000

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var s: hashSetI64 = hashSetI64::withCap(i64(16))
    var r: rng = { s: SEED0 }
    var added: i64 = 0
    var rem: i64 = 0
    var hits: i64 = 0
    var i: i64 = 0
    while i < OPS {
        let k: i64 = i64(next(ref r) % SPACE)
        let op: i64 = i % i64(3)
        if op == i64(0) {
            if s.put(k) { added = added + 1 }
        }
        if op == i64(1) {
            if s.remove(k) { rem = rem + 1 }
        }
        if op == i64(2) {
            if s.contains(k) { hits = hits + 1 }
        }
        i = i + 1
    }
    println("n=", s.len(), " added=", added, " rem=", rem, " hits=", hits)
    return 0
}
