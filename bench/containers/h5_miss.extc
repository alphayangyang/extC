// 形状 H5：插入 4e6 条之后做 8e6 次**不命中**查询（键不在表里）。
// 考的是未命中路径：线性探测要一直走到 EMPTY 才停，链式表要遍历整条链。
use std::io
use std::data::hashMap

const SEED0: u64 = 0x2545F4914F6CDD1D
const N: i64 = 4000000
const SPACE: u64 = 1000000007

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var m: hashMapI64<i64> = hashMapI64<i64>::withCap(N)
    var r: rng = { s: SEED0 }
    var i: i64 = 0
    while i < N {
        let k: i64 = i64(next(ref r) % SPACE)
        let _had: bool = m.put(k, k * i64(3) + i64(1))
        i = i + 1
    }
    var r2: rng = { s: SEED0 ^ u64(0x5DEECE66D) }
    var misses: i64 = 0
    var sum: i64 = 0
    i = 0
    while i < N * i64(2) {
        let k: i64 = i64(next(ref r2) % SPACE)
        let v: i64 = m.get(k) ?? i64(-1)
        if v == i64(-1) { misses = misses + i64(1) } else { sum = sum + v }
        i = i + 1
    }
    println("n=", m.len(), " misses=", misses, " sum=", sum)
    return 0
}
