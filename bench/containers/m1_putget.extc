// 形状 M1：有序 map<i64,i64> 一次给够容量插入 1e6 条，再做 1e6 次查询。
use std::io
use std::data::map

let SEED0: u64 = 0x2545F4914F6CDD1D
let N: i64 = 1000000
let SPACE: u64 = 1000000007

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var m: map<i64, i64> = map<i64, i64>::withCap(N)
    var r: rng = { s: SEED0 }
    var added: i64 = 0
    var i: i64 = 0
    while i < N {
        let k: i64 = i64(next(ref r) % SPACE)
        let had: bool = m.put(k, k * i64(3) + i64(1))
            if !had { added = added + 1 }
        i = i + 1
    }
    var r2: rng = { s: SEED0 }
    var sum: i64 = 0
    var hits: i64 = 0
    i = 0
    while i < N {
        let k: i64 = i64(next(ref r2) % SPACE)
        let v: i64 = m.get(k) ?? i64(0)
        if v != i64(0) { hits = hits + 1 }
        sum = sum + v
        i = i + 1
    }
    println("n=", m.len(), " added=", added, " hits=", hits, " sum=", sum)
    return 0
}
