// 形状 S2：长串增长 —— 16 条 4 MiB 字符串，每条用 64 字节块 append 65536 次（共 1,048,576 次 append）。
// 池版本按 1.5 倍原地长（旧块当场还回去），buf 版本在预留内推长度、撞到上限才搬一次家。
use std::io
use std::text::string

fn main() -> i32 {
    var sum: i64 = 0
    var k: i64 = 0
    while k < 16 {
        var s: string
        var chunk: [64]u8
        var j: i64 = 0
        while j < 64 { chunk[j] = u8(65 + j % 26)  j = j + 1 }
        var r: i64 = 0
        while r < 65536 { s.append(chunk[..])  r = r + 1 }
        sum = sum + s.len()
        k = k + 1
    }
    println("n=", sum, " cap=", 1)
    return 0
}
