// 形状 H1：容量一次给够（`withCap(N)`）建 4e6 条 i64 → i64，再按同一序列做命中查询。
// 考的是「插入 + 命中查询」的绝对成本；容量预先给够，所以量到的是探测与写入，不是增长。
use std::io
use std::data::hashMap

const SEED0: u64 = 0x2545F4914F6CDD1D
const N: i64 = 4000000
const SPACE: u64 = 1000000007

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var m: hashMapI64<i64> = hashMapI64<i64>::withCap(N)
    var r: rng = { s: SEED0 }
    var i: i64 = 0
    while i < N {
        let k: i64 = i64(next(ref r) % SPACE)
        let _had: bool = m.put(k, k * i64(3) + i64(1))
        i = i + 1
    }
    var r2: rng = { s: SEED0 }
    var sum: i64 = 0
    var hits: i64 = 0
    i = 0
    while i < N {
        let k: i64 = i64(next(ref r2) % SPACE)
        let v: i64 = m.get(k) ?? i64(0)
        if v != i64(0) { hits = hits + i64(1) }
        sum = sum + v
        i = i + 1
    }
    println("n=", m.len(), " hits=", hits, " sum=", sum)
    return 0
}
