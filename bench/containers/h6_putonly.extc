// 形状 H6：只做插入，不做查询 —— 把 H1 的耗时拆成「插入」与「查询」两半。
//
// H1 与 h_flat 的差距集中在插入侧（每次插入要向五条列各写一次：键、标签、稠密行号、
// 行号->桶反查、值列三件套），这个形状单独量插入，用来证明差距不是探测循环造成的。
// 输出与 h_flat 的 p1 形状逐字相同。
use std::io
use std::data::hashMap

const SEED0: u64 = 0x2545F4914F6CDD1D
const N: i64 = 4000000
const SPACE: u64 = 1000000007

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var m: hashMapI64<i64> = hashMapI64<i64>::withCap(N)
    var r: rng = { s: SEED0 }
    var i: i64 = 0
    while i < N {
        let k: i64 = i64(next(ref r) % SPACE)
        let _had: bool = m.put(k, k * i64(3) + i64(1))
        i = i + 1
    }
    println("n=", m.len())
    return 0
}
