// 形状 LM1：linMap 插入 1024 条 i64 键，再做 20 万次查询（线性扫描，一半命中）。
// 规模故意小：linMap 的 find 是逐项 == 扫描，这是它的定义而不是退化。
use std::io
use std::data::map

const SEED0: u64 = 0x2545F4914F6CDD1D
const N: i64 = 1024
const Q: i64 = 1000000
const SPACE: u64 = 2048

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var m: linMap<i64, i64> = linMap<i64, i64>::withCap(N)
    var r: rng = { s: SEED0 }
    var i: i64 = 0
    while i < N {
        let k: i64 = i64(next(ref r) % SPACE)
        let ok: bool = m.put(k, k * i64(3) + i64(1))
        i = i + 1
    }
    var r2: rng = { s: SEED0 }
    var sum: i64 = 0
    var hits: i64 = 0
    i = 0
    while i < Q {
        let k: i64 = i64(next(ref r2) % SPACE)
        let v: i64 = m.get(k) ?? i64(0)
        if v != i64(0) { hits = hits + 1 }
        sum = sum + v
        i = i + 1
    }
    println("n=", m.len(), " hits=", hits, " sum=", sum)
    return 0
}
