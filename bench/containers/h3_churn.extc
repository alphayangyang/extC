// 形状 H3：混合负载 —— 8e6 次动作（插入 / 查询 / 删除）在 1e6 个键的空间上随机交错。
// 考的是真实工作负载：墓碑、装载率、swap-remove 搬值，以及「插入与删除比愈合」。
use std::io
use std::data::hashMap

const SEED0: u64 = 0x2545F4914F6CDD1D
const OPS: i64 = 8000000
const SPACE: u64 = 1000000

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var m: hashMapI64<i64> = hashMapI64<i64>::withCap(i64(1024))
    var r: rng = { s: SEED0 }
    var sum: i64 = 0
    var hits: i64 = 0
    var removed: i64 = 0
    var repl: i64 = 0
    var i: i64 = 0
    while i < OPS {
        let x: u64 = next(ref r)
        let k: i64 = i64(x % SPACE)
        let op: u64 = (x >> u64(40)) % u64(4)
        if op < u64(2) {
            if m.put(k, i64(x % u64(1000003))) { repl = repl + i64(1) }
        } else if op == u64(2) {
            let v: i64 = m.get(k) ?? i64(-1)
            if v != i64(-1) { hits = hits + i64(1) }
            sum = sum + v
        } else {
            if m.remove(k) { removed = removed + i64(1) }
        }
        i = i + 1
    }
    println("n=", m.len(), " hits=", hits, " removed=", removed, " repl=", repl, " sum=", sum)
    return 0
}
