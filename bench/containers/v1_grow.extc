// 形状 V1：从 4 个元素的容量 push 到 8e6 个 i64，再整段求和。
// 增长路径：池版本每次都换板块（旧代变垃圾），buf 版本在预留内推长度、撞到上限才搬一次家。
use std::io
use std::data::vector

fn main() -> i32 {
    var v: vector<i64> = vector<i64>::withCap(4)
    var i: i64 = 0
    while i < 8000000 { v.push(i)  i = i + 1 }
    var s: i64 = 0
    for x in v.view() { s = s + x }
    println("n=", v.len(), " sum=", s)
    return 0
}