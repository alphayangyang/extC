// 形状 LS1：linSet 插入 1024 个 i64 成员，再做 20 万次成员查询。
use std::io
use std::data::map

let SEED0: u64 = 0x2545F4914F6CDD1D
let N: i64 = 1024
let Q: i64 = 1000000
let SPACE: u64 = 2048

struct rng {
    s: u64
}

fn next(r: mut ref rng) -> u64 {
    var x: u64 = r.s
    x = x ^ (x << u64(13))
    x = x ^ (x >> u64(7))
    x = x ^ (x << u64(17))
    r.s = x
    return x
}

fn main() -> i32 {
    var s: linSet<i64> = linSet<i64>::withCap(N)
    var r: rng = { s: SEED0 }
    var added: i64 = 0
    var i: i64 = 0
    while i < N {
        let k: i64 = i64(next(ref r) % SPACE)
        if s.add(k) { added = added + 1 }
        i = i + 1
    }
    var r2: rng = { s: SEED0 }
    var hits: i64 = 0
    i = 0
    while i < Q {
        let k: i64 = i64(next(ref r2) % SPACE)
        if s.contains(k) { hits = hits + 1 }
        i = i + 1
    }
    println("n=", s.len(), " added=", added, " hits=", hits)
    return 0
}
