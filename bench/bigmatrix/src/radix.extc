// Shape 1: radix -- extC (LSD radix sort, 4 passes x 8 bits, n u32 from stdin).
use std::io

fn go() -> result<unit, io::ioError> {
    var r = io::readerOf(io::STDIN_FD)
    let n = r.nextInt()?
    var a: mut slice<u32> = new u32[n]
    var b: mut slice<u32> = new u32[n]
    var i: i64 = 0
    while i < n {
        let v = r.nextInt()?
        a[i] = u32(v)
        i = i + 1
    }

    var pass: i64 = 0
    while pass < 4 {
        var cnt: mut slice<i64> = new i64[256]
        var k: i64 = 0
        while k < 256 { cnt[k] = i64(0)  k = k + 1 }
        i = 0
        while i < n {
            let d = i64((u64(a[i]) >> u64(pass * 8)) & u64(255))
            cnt[d] = cnt[d] + i64(1)
            i = i + 1
        }
        var sum: i64 = 0
        k = 0
        while k < 256 { let c = cnt[k]  cnt[k] = sum  sum = sum + c  k = k + 1 }
        i = 0
        while i < n {
            let d = i64((u64(a[i]) >> u64(pass * 8)) & u64(255))
            b[cnt[d]] = a[i]
            cnt[d] = cnt[d] + i64(1)
            i = i + 1
        }
        i = 0
        while i < n { a[i] = b[i]  i = i + 1 }
        pass = pass + 1
    }

    var ok: i32 = 1
    i = 1
    while i < n { if a[i - 1] > a[i] { ok = 0  break }  i = i + 1 }
    print("sorted=", ok, " first=", a[0], " last=", a[n - 1], "\n")
    return success(unit {})
}

fn main() -> i32 {
    match go() {
        success(u) => { return 0 }
        failure(e) => { return 1 }
    }
}
