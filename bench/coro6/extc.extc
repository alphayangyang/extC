use std::io
fn gen(id: i64, n: i64, salt: i64) -> coroutine<i64> {
  var i: i64 = 0
  while i < n {
    yield (i % 65536) * 65521 + id * 40503 + salt
    i = i + 1 } }
fn run(k: i64, m: i64, salt: i64) -> i64 {
  var sum: i64 = 0
  var id: i64 = 0
  while id < k {
    var c = gen(id, m, salt)
    while c.next() { sum = sum + c.value() }
    id = id + 1 }
  return sum }
fn main() -> i32 {
  var total: i64 = run(8, 2000, 0)
  var r: i64 = 0
  while r < i64(R_ROUNDS) { total = total + run(512, 20000, r)  r = r + 1 }
  io::cout << total << "\n"
  return 0 }
