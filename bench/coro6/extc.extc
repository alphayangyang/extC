use std::io
fn gen(id: i64, n: i64, salt: i64) -> coroutine<i64> {
  var i: i64 = 0
  while i < n {
    yield (i % i64(65536)) * i64(65521) + id * i64(40503) + salt
    i = i + i64(1) } }
fn run(k: i64, m: i64, salt: i64) -> i64 {
  var sum: i64 = 0
  var id: i64 = 0
  while id < k {
    var c = gen(id, m, salt)
    while c.next() { sum = sum + c.value() }
    id = id + i64(1) }
  return sum }
fn main() -> i32 {
  var total: i64 = run(i64(8), i64(2000), i64(0))
  var r: i64 = 0
  while r < i64(R_ROUNDS) { total = total + run(i64(512), i64(20000), r)  r = r + i64(1) }
  io::cout << total << "\n"
  return 0 }
