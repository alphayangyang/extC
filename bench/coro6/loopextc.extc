use std::io
fn run(k: i64, m: i64) -> i64 {
  var sum: i64 = 0
  var id: i64 = 0
  while id < k {
    var i: i64 = 0
    while i < m { sum = sum + (i % 65536) * 65521 + id * 40503  i = i + 1 }
    id = id + 1 }
  return sum }
fn main() -> i32 {
  var total: i64 = run(8, 2000)
  var r: i64 = 0
  while r < 1 { total = total + run(512, 20000)  r = r + 1 }
  io::cout << total << "\n"
  return 0 }
