// bench/fusion：S1 元素链（同一份源码，`--no-fuse` 是未融合参照）。
// argv: n [iters]；每轮做 iters 次"写 tmp 的循环 + 相邻读 tmp 的循环"。
use std::io
use stl::string as str

fn argOr(args: slice<slice<u8>>, i: i64, dflt: i64) -> i64 {
    if args.len <= i { return dflt }
    return str::toI64(args[i]) ?? dflt
}

fn main(args: slice<slice<u8>>) -> i32 {
    let n: i64 = argOr(args, 1, 1048576)
    let iters: i64 = argOr(args, 2, 8)
    var a: mut slice<f64> = new f64[n]
    var res: mut slice<f64> = new f64[n]
    for i in 0..n {
        a[i] = f64((i * 7 + 3) % 17) / 17.0
        res[i] = 0.0
    }
    var k: i64 = 0
    while k < iters {
        var tmpv: mut slice<f64> = new f64[n]
        for i in 0..n { tmpv[i] = a[i] * 2.0 + 1.0 }
        for i in 0..n { res[i] = tmpv[i] * 0.5 }
        k = k + 1
    }
    var cs: f64 = 0.0
    for v in res { cs = cs + v }
    io::cout << f"cs={i64(cs * 1000.0)} n={n}\n"
    return 0
}
